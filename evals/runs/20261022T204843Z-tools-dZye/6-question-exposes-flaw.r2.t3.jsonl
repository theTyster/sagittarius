.path.join(d, \"tracker.json\")\n            with open(path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(TRACKER_SNAPSHOT, f)\n            self.assertEqual(weekly_report(path), \"Open issues: 3\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":27,"oldLines":6,"newStart":27,"newLines":14,"lines":["                 json.dump(TRACKER_SNAPSHOT, f)","             self.assertEqual(weekly_report(path), \"Open issues: 3\")"," ","+    def test_weekly_report_live_tracker(self):","+        # The live file changes every hour, so count its open issues here.","+        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"tracker.json\")","+        with open(path, encoding=\"utf-8\") as f:","+            issues = json.load(f)","+        expected = len([i for i in issues if i[\"state\"] == \"open\"])","+        self.assertEqual(weekly_report(path), f\"Open issues: {expected}\")"," ","+"," if __name__ == \"__main__\":","     unittest.main()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01PS8y3cG9xcqM4PdgBtLG9D","permission_decision":{"decision":"accept","source":"user_permanent","reason_type":"rule"}}]}
