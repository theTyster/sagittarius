{
  "version": "0.14.0",
  "engine": [
    "HUB-CORE.md",
    "PRINCIPLES.md",
    ".claude/scripts/hubflow.py",
    ".claude/scripts/hubflow-test.py",
    ".claude/scripts/desk.py",
    ".claude/scripts/desk-test.py",
    ".claude/skills/hub-flow/SKILL.md",
    ".claude/skills/hub-rotate/SKILL.md",
    ".claude/skills/hub-rotate/scripts/rotate.py",
    ".claude/skills/hub-rotate/scripts/check-citations.py"
  ],
  "not_shipped": [
    ".claude/scripts/desk-toast"
  ],
  "owned": [
    "CLAUDE.md",
    "HEURISTICS.md",
    "TECHNOLOGIES.md",
    ".gitignore",
    "W0/WEEK.md",
    "flow/seed.json"
  ],
  "prompt": {
    "from": "../prompt",
    "prompt": "SAGITTARIUS.md",
    "panes": [
      "PANES.md",
      "panes"
    ],
    "launcher": "~/.claude/sagittarius"
  },
  "orbit_kb": {
    "from": "../kb",
    "to": ".claude/orbit-kb",
    "paths": [
      "bin/orbit-kb",
      "bin/orbit",
      "bin/repo-map",
      "share"
    ],
    "fallback": {
      "bin/orbit": "bin/orbit-kb"
    }
  }
}
