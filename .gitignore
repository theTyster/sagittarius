# Machine-local overrides (CLAUDE.local.md, .claude/settings.local.json).
.env
*.local.*

# This repo TRACKS thoughts/ (design notes, records, the discovery-orbit work).
# The global ~/.gitignore_global ignores `thoughts/*`; these lines override it.
# The .lake/ and *.olean rules below still win inside thoughts/.
!thoughts/
!thoughts/**

# Lean build artifacts (regenerable; never commit)
.lake/
lake-packages/
*.olean

# Temp. Logs and tmp/ dirs are not ignored: fixtures and evidence carry them on purpose.
/tmp/
/temp/

# Python
__pycache__/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
