# Machine-local overrides (CLAUDE.local.md, .claude/settings.local.json).
.env
*.local.*

# Lean build artifacts (regenerable; never commit)
.lake/
lake-packages/
*.olean

# Temp. Logs and tmp/ dirs are not ignored: fixtures and evidence carry them on purpose.
/tmp/
/temp/

# Python
__pycache__/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# System 1 hook: real names to redact stay on this machine (see s1/redact.example.txt)
s1/redact.txt
