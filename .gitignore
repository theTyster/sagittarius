# Machine-local overrides (CLAUDE.local.md, .claude/settings.local.json).
.env
*.local.*

# Lean build artifacts (regenerable; never commit)
.lake/
lake-packages/
*.olean

# Temp. Logs and tmp/ dirs are not ignored: fixtures and evidence carry them on purpose.
/tmp/
/temp/

# Python
__pycache__/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# System 1 hook: the name list of the old redaction (removed in T43). An old copy may hold real
# names, so it stays ignored and is never committed.
s1/redact.txt
