"  withdraw NAME/ARITY [--by human|agent]      remove a kind that a typo declared (lint E19)",
"  model-run MODEL [--timeout S] [--spec F] [--cfg F] [--with F]   run the solver or TLC of a model; keep the log; write model_run",
"  repo-map ARGS                               run the repo-map beside this tool (orbit repo-map --facts KB_PL --containers CONTAINERS_PL)",
"  strike X --why TEXT [--disclose TEXT]       a record no longer counts; it stays in kb.pl, struck",
"  replace X 'NEW' [--why TEXT] [--disclose T] NEW takes the place of X (supersedes; an attachment is struck)",
"  erase X --why TEXT [--disclose TEXT]        a record added by mistake leaves kb.pl; one line says who and why",
"  shift DIR --request-file F [--goal T [--goal-by human|agent]] --hypothesis T [--defeating-case T] (--no-premises|--premise T ...) --claim T --example T --check ID --checks-that T",
"  add 'FACT' ... [--by human|agent] [--doc TEXT]",
"  subject ID PATH",
"  attest TYPE SUBJECT 'PREDICATE' [--by human|agent] [--id ID] [--rests-on RUN,...]",
