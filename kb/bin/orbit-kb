#!/usr/bin/env swipl
% orbit-kb: a helper CLI for Prolog knowledge bases (KBs) with default
% negation (not p).
%
% Run `orbit-kb help` for usage. The contract for this tool is
% kb/CONTRACT.md in the sagittarius repository.
%
% SWI-Prolog, in this process, answers every query. Until 2026-11-02 a
% second engine, s(CASP), gave the explanations and cross-checked each
% answer; it never found a fault in a KB, only in the tools (CONTRACT
% D20). The explanations of why and whynot now come from the same
% clauses (see "Explanations").

:- initialization(main, main).

% ---------------------------------------------------------------------
% Fast start
% ---------------------------------------------------------------------
% Loading this script and its libraries takes about 80 ms. A saved state
% (swipl -o STATE -c SCRIPT) starts in about 15 ms. Measured on a whole
% call of `orbit-kb help` (2026-10-30, median of 10, three runs): about
% 40 ms from the state, 57 ms with ORBIT_KB_NO_CACHE=1. The state lives in
% ${XDG_CACHE_HOME:-~/.cache}/orbit-kb/ under a digest of the script
% text, the script path, and the SWI-Prolog version and executable. So
% an edit of the script, or a new SWI-Prolog, gives a new state.
%
% The directive below runs while this file loads, before the rest of
% the file is compiled. If the state for this script exists, it
% replaces this process with "swipl -x STATE -- ARGS" (exec, the same
% process id, the same streams). If not, the file loads as usual, the
% command runs, and at the end main/0 builds the state for the next
% call (about 0.3 s, once per script version).
%
% Every problem falls back to the normal load: no cache directory, an
% unwritable directory, no library(unix), a failed build (it leaves a
% .failed marker, so the build is not tried again). ORBIT_KB_NO_CACHE=1
% turns the state off.

:- dynamic orbit_state_wanted/2.

orbit_boot :-
    (   getenv('ORBIT_KB_STATE_BUILD', _)       % building the state now
    ->  true
    ;   catch(orbit_boot_, _, true)
    ->  true
    ;   true
    ).

orbit_boot_ :-
    \+ ( getenv('ORBIT_KB_NO_CACHE', V), V \== '', V \== '0' ),
    prolog_load_context(file, Script),
    orbit_state_path(Script, State),
    (   orbit_state_link(State, Priv)
    ->  (   orbit_state_valid(State, Priv)
        ->  current_prolog_flag(argv, Argv),
            current_prolog_flag(executable, Exe),
            use_module(library(unix), [exec/1]),
            Cmd =.. [Exe, '-x', Priv, '--'|Argv],
            exec(Cmd)
        ;   % A bad state is removed. This call loads the script as
            % usual; the next call builds a new state.
            catch(delete_file(Priv), _, true),
            orbit_state_drop_bad(State)
        )
    ;   exists_file(State)
    ->  true                % no link (no hard links here): load as usual
    ;   atom_concat(State, '.failed', Failed),
        \+ exists_file(Failed)
    ->  assertz(orbit_state_wanted(State, Script))
    ;   true
    ).

% The cache race (2026-11-09, model m3 of the cache-race KB). Other calls
% delete the shared STATE at any time: drop_bad, the 60 s rule,
% prune_states after a script edit, a builder that renames a new state
% over it. A call that checked STATE and then ran "swipl -x STATE"
% aborted when STATE went away in between ("Could not open resource
% database"). So each call makes a hard link of STATE to a private name,
% STATE.PID-TIME.priv, checks the bytes of that link against STATE.ok,
% and starts the link. No other call deletes the link while this process
% lives (prune_states/2 keeps it), and a delete of the shared name leaves
% the bytes of the link in place. The started state deletes its own link
% first thing (state_flags/0). A link cannot be opened and passed on: SWI
% opens files close-on-exec, so swipl -x /proc/self/fd/N fails.
%
% link_file/3 is foreign code of library(filesex). Loading the whole
% library costs about 20 ms (it loads library(predicate_options)), more
% than the fast start saves. So only its foreign part is loaded here,
% into the module of the library, as library(filesex) itself does; the
% library loads later as usual. Any failure: no fast start.
orbit_state_link(State, Priv) :-
    (   current_predicate(files_ex:link_file/3)
    ->  true
    ;   files_ex:use_foreign_library(foreign(files))
    ),
    current_prolog_flag(pid, Pid),
    get_time(Now),
    T is truncate(Now),
    format(atom(Priv), "~w.~w-~w.priv", [State, Pid, T]),
    catch(files_ex:link_file(State, Priv, hard), _, fail).

% A state is used only if its sidecar STATE.ok exists and records the
% size and the SHA-1 of the file (the private link) that is started.
% The builder writes the sidecar (atomically) after the state is
% complete. So a truncated, overwritten, or half-written state is never
% started: swipl -x would abort on it before any fallback could run.
orbit_state_valid(State, File) :-
    atom_concat(State, '.ok', Ok),
    catch(setup_call_cleanup(open(Ok, read, S), read_term(S, T, []), close(S)), _, fail),
    T = state_ok(Size, Hash),
    size_file(File, Size),
    orbit_file_sha(File, Hash).

orbit_file_sha(File, Hash) :-
    setup_call_cleanup(open(File, read, S, [type(binary)]),
                       read_string(S, _, Bytes),
                       close(S)),
    variant_sha1(Bytes, Hash).

% Delete a bad state and its sidecar. A state without a sidecar may be
% one that a builder renamed a moment ago, so it is deleted only when
% it is older than one minute.
orbit_state_drop_bad(State) :-
    atom_concat(State, '.ok', Ok),
    (   exists_file(Ok)
    ->  catch(delete_file(State), _, true),
        catch(delete_file(Ok), _, true)
    ;   catch(time_file(State, T), _, fail),
        get_time(Now),
        Now - T > 60
    ->  catch(delete_file(State), _, true)
    ;   true
    ).

orbit_cache_root(Root) :-
    (   getenv('XDG_CACHE_HOME', X), X \== '', is_absolute_file_name(X)
    ->  Base = X
    ;   getenv('HOME', H), H \== ''
    ->  atom_concat(H, '/.cache', Base)
    ),
    atom_concat(Base, '/orbit-kb', Root).

orbit_state_path(Script, State) :-
    setup_call_cleanup(open(Script, read, S, [type(binary)]),
                       read_string(S, _, Text),
                       close(S)),
    current_prolog_flag(version, V),
    current_prolog_flag(executable, Exe),
    current_prolog_flag(home, Home),
    variant_sha1(state(Text, Script, V, Exe, Home), Hash),
    % The name starts with a digest of the script path, so pruning can
    % find the old states of this script (prune_states/2).
    variant_sha1(path(Script), PH),
    sub_atom(PH, 0, 12, _, P),
    orbit_cache_root(Root),
    atomic_list_concat([Root, '/state-', P, '-', Hash, '.qs'], State).

:- orbit_boot.

% Libraries. Those that only some commands need load on first use.
:- use_module(library(lists)).
:- use_module(library(apply)).
:- autoload(library(readutil), [read_file_to_string/3, read_line_to_string/2]).
:- autoload(library(process), [process_create/3, process_wait/2, process_kill/2]).
:- autoload(library(filesex), [directory_file_path/3, make_directory_path/1, link_file/3, delete_directory_and_contents/1]).
:- autoload(library(http/json), [json_read_dict/2, json_read_dict/3]).
:- autoload(library(time), [call_with_time_limit/2]).
:- autoload(library(ugraphs), [vertices_edges_to_ugraph/3, transitive_closure/2]).

:- dynamic orbit_script/1, orbit_tmp/1.

:- prolog_load_context(file, F), assertz(orbit_script(F)).

% library(crypto) loads on first use (sha256_file/2).
have_crypto :-
    catch(use_module(library(crypto)), _, fail),
    current_predicate(crypto:crypto_file_hash/3).

% ---------------------------------------------------------------------
% Entry point
% ---------------------------------------------------------------------

main :-
    state_flags,
    % Remove temp files also when a signal halts the process.
    at_halt(cleanup_tmp),
    catch(set_stream(user_output, encoding(utf8)), _, true),
    catch(set_stream(user_error, encoding(utf8)), _, true),
    setup_ops,
    current_prolog_flag(argv, Argv),
    catch(top(Argv, Code), E, top_error(E, Code)),
    cleanup_tmp,
    catch(( flush_output(user_output), flush_output(user_error) ), E2, true),
    (   nonvar(E2), broken_pipe(E2)
    ->  quiet_streams
    ;   nonvar(E2)
    ->  throw(E2)
    ;   true
    ),
    build_state,
    exit_now(Code).

% exit_now(+Code): end the process with exit status Code. halt/1 runs the
% halt hooks of the foreign libraries. One of them can deadlock: in the
% D10 follow-up (2026-10-20), about 1 in 2800 calls of query hung after
% the answer was printed, with the main thread in a mutex wait in a
% cleanup hook under PL_halt (eu-stack: cleanup <- run_on_halt <-
% PL_cleanup <- PL_halt) and the GC thread idle. Here the output is
% flushed and the temp files are removed, so no hook has work left. The process replaces itself with
% "sh -c 'exit Code'", which runs no hook. Any problem falls back to
% halt/1.
exit_now(Code) :-
    % D23: a takeover that the command did not use is undone (see claim_writer/3).
    (   nb_current(orbit_settle, G), G \== none -> nb_setval(orbit_settle, none), catch(G, _, true) ; true ),
    (   integer(Code), Code >= 0, Code =< 255,
        catch(use_module(library(unix), [exec/1]), _, fail),
        absolute_file_name(path(sh), Sh, [access(execute), file_errors(fail)])
    ->  format(atom(Arg), "exit ~d", [Code]),
        Cmd =.. [Sh, '-c', Arg],
        catch(exec(Cmd), _, true)
    ;   true
    ),
    halt(Code).

% A saved state starts with other defaults than "swipl SCRIPT". Set the
% flags that differ back to the values of a script run.
state_flags :-
    (   current_prolog_flag(saved_program, true)
    ->  drop_own_link,
        set_prolog_flag(autoload, true),
        set_prolog_flag(on_error, print),
        set_prolog_flag(on_warning, print),
        set_prolog_flag(verbose, normal),
        set_prolog_flag(encoding, text)
    ;   true
    ).

% A state started from a private link (orbit_state_link/2) deletes the
% link: the process keeps the state open, so the bytes stay.
drop_own_link :-
    (   current_prolog_flag(os_argv, OsArgv),
        append(_, ['-x', Priv|_], OsArgv),
        file_name_extension(_, priv, Priv)
    ->  catch(delete_file(Priv), _, true)
    ;   true
    ).

% Build the saved state for the next call (see "Fast start"). The output
% of the command is already flushed. Any failure leaves a .failed
% marker, and the CLI keeps working from the script.
build_state :-
    (   retract(orbit_state_wanted(State, Script))
    ->  catch(build_state(State, Script), _, true)
    ;   true
    ).

build_state(State, Script) :-
    file_directory_name(State, Dir),
    make_directory_path(Dir),
    access_file(Dir, write),
    current_prolog_flag(executable, Exe),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w.~w-~w.tmp", [State, Pid, R]),
    (   catch(( process_create(Exe, ['-q', '-o', Tmp, '-c', Script],
                               [ stdin(null), stdout(null), stderr(null),
                                 environment(['ORBIT_KB_STATE_BUILD'='1']),
                                 process(P1) ]),
                process_wait(P1, exit(0)),
                exists_file(Tmp),
                % The script must not have changed since this process
                % read it, or the state would not match its name.
                orbit_state_path(Script, State),
                % The new state must run before it is used.
                process_create(Exe, ['-x', Tmp, '--', help],
                               [ stdin(null), stdout(null), stderr(null),
                                 environment(['ORBIT_KB_STATE_BUILD'='1']),
                                 process(P2) ]),
                process_wait(P2, exit(0)) ),
              _, fail)
    ->  rename_file(Tmp, State),
        size_file(State, Size),
        orbit_file_sha(State, Hash),
        format(string(OkText), "~q.~n", [state_ok(Size, Hash)]),
        atom_concat(State, '.ok', Ok),
        write_atomic(Ok, OkText),
        prune_states(Dir, State)
    ;   catch(delete_file(Tmp), _, true),
        atom_concat(State, '.failed', Failed),
        catch(( open(Failed, write, S), close(S) ), _, true)
    ).

% Delete the files of older states of this script (same path digest,
% other key): state, sidecar, and .failed marker. States of other
% script paths are deleted when they are older than 7 days.
prune_states(Dir, Keep) :-
    file_base_name(Keep, KeepBase),
    file_name_extension(KeepStem, qs, KeepBase),
    atomic_list_concat([state, P|_], '-', KeepStem),
    directory_files(Dir, Fs),
    get_time(Now),
    forall(( member(F, Fs),
             atomic_list_concat([state|Parts], '-', F),
             atomic_list_concat([Dir, '/', F], Path),
             (   file_name_extension(_, priv, F)
             ->  priv_link_stale(F, Now)
             ;   \+ sub_atom(F, 0, _, _, KeepStem),
                 catch(time_file(Path, T), _, fail),
                 Age is Now - T,
                 prune_by_age(F, Parts, P, Age)
             ) ),
           catch(delete_file(Path), _, true)).

% A private link (orbit_state_link/2) is deleted only when it is over one
% hour old (the time in its name; a hard link has the time of the state)
% and its process is gone. A call that has not yet started its link
% lives, so no prune deletes the link that it is about to start. A pid
% that cannot be checked counts as alive.
priv_link_stale(F, Now) :-
    file_name_extension(Base, priv, F),
    file_name_extension(_, PidTime, Base),
    atomic_list_concat([PidA, TA], '-', PidTime),
    atom_number(PidA, Pid), integer(Pid),
    atom_number(TA, T), Now - T > 3600,
    \+ pid_alive(Pid).

pid_alive(Pid) :-
    (   exists_directory('/proc/self')
    ->  format(atom(D), "/proc/~d", [Pid]),
        exists_directory(D)
    ;   format(atom(PidA), "~d", [Pid]),
        \+ catch(( process_create(path(kill), ['-0', PidA],
                                   [stdin(null), stdout(null), stderr(null), process(K)]),
                    process_wait(K, exit(Code)), Code \== 0 ),
                  _, fail)
    ).

prune_by_age(F, Parts, P, Age) :-
    (   file_name_extension(_, tmp, F)
    ->  Age > 3600                      % a build may still run
    ;   Parts = [_]
    ->  true                            % the old name format
    ;   Parts = [P|_]
    ->  true                            % this script, other key
    ;   Age > 7*24*3600                 % another script path
    ).

% The reader closed the pipe (for example `orbit-kb ... | head`). Exit
% quietly: no message, no trace. Point the standard streams at a null
% stream, so halt/1 does not try to flush into the closed pipe again.
broken_pipe(error(io_error(write, _), _)).

quiet_streams :-
    open_null_stream(N1),
    catch(set_stream(N1, alias(user_output)), _, true),
    open_null_stream(N2),
    catch(set_stream(N2, alias(user_error)), _, true).

top_error(E, 141) :- broken_pipe(E), !,
    quiet_streams.
top_error(orbit_error(Code, Lines), Code) :- !,
    print_lines(user_error, Lines).
top_error(E, 2) :-
    err_text(E, T),
    format(user_error, "orbit-kb: internal error: ~w~n", [T]),
    format(user_error, "This is a bug in orbit-kb. Report it with the command line.~n", []).

die(Code, Fmt, Args) :-
    format(string(S), Fmt, Args),
    throw(orbit_error(Code, [S])).
die(Code, Lines0) :-
    ( nonvar(Lines0), Lines0 = (L >> _) -> true ; L = Lines0 ),
    die_fix_lines(L, Lines),
    throw(orbit_error(Code, Lines)).

usage_error(Fmt, Args) :-
    format(string(S), Fmt, Args),
    throw(orbit_error(2, [S, "Run `orbit-kb help` for usage."])).

print_lines(S, Lines) :-
    forall(member(L, Lines), format(S, "~w~n", [L])).

fmt(S, Fmt, Args) :- format(string(S), Fmt, Args).

err_text(E, S) :-
    (   catch(phrase('$messages':translate_message(E), L), _, fail)
    ->  with_output_to(string(S0), print_message_lines(current_output, '', L)),
        split_string(S0, "\n", " \t", Parts0),
        exclude(==(""), Parts0, Parts),
        atomic_list_concat(Parts, ' ', A),
        atom_string(A, S)
    ;   fmt(S, "~q", [E])
    ).

% ---------------------------------------------------------------------
% Operators for reading sources. They live in the module orbit_ops only,
% so they do not change how this script itself is read. Only not is part
% of the KB language. The others read the syntax of s(CASP), so that lint
% can name such a line (E17) instead of a bare syntax error.
% ---------------------------------------------------------------------

kb_op(900, fy, not).
kb_op(950, xfx, ::).
kb_op(1200, fx, #).
kb_op(1150, fx, [table, show, pred]).
kb_op(350, fx, [include, compute, abducible]).
kb_op(700, xfx, ['#=', '#<>', '#<', '#>', '#=<', '#>=']).

setup_ops :-
    forall(kb_op(P, T, N), op(P, T, orbit_ops:N)).

% Write a term with quotes and the KB operators. Variables print as
% their source names, or as _ when they have no name.
term_text(T, S) :- term_text(T, [], S).
term_text(T, VN, S) :-
    copy_term(T-VN, T2-VN2),
    maplist(bind_vn, VN2),
    term_variables(T2, Vs),
    maplist(=('$VAR'('_')), Vs),
    wtext(T2, S).

bind_vn(N=V) :- ( var(V) -> V = '$VAR'(N) ; true ).

wtext(T, S) :-
    with_output_to(string(S),
                   write_term(T, [quoted(true), module(orbit_ops),
                                  numbervars(true), spacing(next_argument)])).

% A clause or fact as one line of source text, with the full stop.
clause_line(T, VN, Line) :-
    term_text(T, VN, S),
    (   sub_string(S, _, 1, 0, Last),
        sub_atom('#$&*+-./:<=>?@^~\\', _, 1, _, Last)
    ->  string_concat(S, " .", Line)
    ;   string_concat(S, ".", Line)
    ).

% ---------------------------------------------------------------------
% Temporary files
% ---------------------------------------------------------------------

% tmp_stream(+Ext, -Path, -Stream): a new temporary file, created with
% an unpredictable name and opened for writing (tmp_file_stream/3).
tmp_stream(Ext, Path, S) :-
    tmp_file_stream(Path, S, [extension(Ext), encoding(utf8)]),
    assertz(orbit_tmp(Path)).

cleanup_tmp :-
    forall(retract(orbit_tmp(P)), catch(delete_file(P), _, true)).

% ---------------------------------------------------------------------
% Argument parsing
% ---------------------------------------------------------------------

% parse_opts(+Args, +Spec, -Positional, -Opts)
% Spec is a list of Name-value or Name-flag. An argument that starts
% with a single dash and is not a known option is positional, so goals
% such as '-world(x)' work.
parse_opts([], _, [], []).
parse_opts([A|As], Spec, Pos, Opts) :-
    (   A == '--'
    ->  Pos = ['--'|As], Opts = []
    ;   sub_atom(A, 0, 2, _, '--'), sub_atom(A, B, 1, _, '='), B > 2
    ->  sub_atom(A, 0, B, _, Name),
        B1 is B + 1, sub_atom(A, B1, _, 0, Val),
        (   memberchk(Name-value, Spec)
        ->  Opts = [Name-Val|Os], parse_opts(As, Spec, Pos, Os)
        ;   usage_error("Unknown option ~w.", [Name])
        )
    ;   memberchk(A-Kind, Spec)
    ->  (   Kind == flag
        ->  Opts = [A-true|Os], parse_opts(As, Spec, Pos, Os)
        ;   As = [V|As1]
        ->  Opts = [A-V|Os], parse_opts(As1, Spec, Pos, Os)
        ;   usage_error("The option ~w needs a value.", [A])
        )
    ;   sub_atom(A, 0, 2, _, '--')
    ->  usage_error("Unknown option ~w.", [A])
    ;   Pos = [A|Ps], parse_opts(As, Spec, Ps, Opts)
    ).

opt(Opts, Name, Default, V) :-
    ( memberchk(Name-V0, Opts) -> V = V0 ; V = Default ).

% Remove --dir DIR (anywhere before --) from the argument list.
take_dir([], none, []).
take_dir(['--'|As], none, ['--'|As]) :- !.
take_dir(['--dir', D|As], some(D), Rest) :- !, take_dir(As, _, Rest).
take_dir(['--dir'], _, _) :- !, usage_error("The option --dir needs a directory.", []).
take_dir([A|As], Dir, Rest) :-
    sub_atom(A, 0, _, _, '--dir='), !,
    sub_atom(A, 6, _, 0, D),
    take_dir(As, Dir0, Rest),
    ( Dir0 = some(_) -> Dir = Dir0 ; Dir = some(D) ).
take_dir([A|As], Dir, [A|Rest]) :- take_dir(As, Dir, Rest).

% ---------------------------------------------------------------------
% Dispatch
% ---------------------------------------------------------------------

kb_command(add).
kb_command(subject).
kb_command(attest).
kb_command(run).
kb_command(prove).
kb_command(lint).
kb_command(query).
kb_command(why).
kb_command(whynot).
kb_command(show).
kb_command(report).
kb_command(draft).
kb_command('pin-item').
kb_command('pin-question').
kb_command('pin-answer').
kb_command('pin-request').
kb_command('apply-pending').
kb_command(review).
kb_command(withdraw).

top(Argv0, Code) :-
    take_dirs(Argv0, Dirs, [view|ViewArgs]), !,
    (   member(Arg, ViewArgs), memberchk(Arg, ['--help', '-h'])
    ->  cmd_help([view], Code)
    ;   cmd_view(Dirs, ViewArgs, Code)
    ).
top(Argv0, Code) :-
    take_dirs(Argv0, Dirs, [serve|ServeArgs]), !,
    (   member(Arg, ServeArgs), memberchk(Arg, ['--help', '-h'])
    ->  cmd_help([serve], Code)
    ;   cmd_serve(Dirs, ServeArgs, Code)
    ).
top(Argv0, Code) :-
    take_dir(Argv0, DirOpt, Argv),
    (   Argv == []
    ->  help_lines(general, Ls), print_lines(user_error, Ls), Code = 2
    ;   Argv = [Cmd|Args],
        (   memberchk(Cmd, [help, '--help', '-h'])
        ->  cmd_help(Args, Code)
        ;   memberchk(Cmd, [version, '--version'])
        ->  cmd_version(Args, Code)
        ;   Cmd == init
        ->  cmd_init(Args, Code)
        ;   Cmd == shift
        ->  (   memberchk(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([shift], Code)
            ;   cmd_shift(Args, Code)
            )
        ;   Cmd == doctor
        ->  cmd_doctor(Args, Code)
        ;   Cmd == uses
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([uses], Code)
            ;   resolve_kb(DirOpt, Dir),
                take_role(Args, ArgsR),
                writer_gate(Dir, ArgsR, Args1),
                apply_pending(Dir),
                with_kb_lock(Dir, cmd_uses(Dir, Args1, Code))
            )
        ;   Cmd == release
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([release], Code)
            ;   Args == []
            ->  resolve_kb(DirOpt, Dir),
                with_kb_lock(Dir, cmd_release(Dir, Code))
            ;   usage_error("release takes no arguments.", [])
            )
        ;   Cmd == project
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([project], Code)
            ;   cmd_project(DirOpt, Args, Code)
            )
        ;   Cmd == migrate
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([migrate], Code)
            ;   cmd_migrate(DirOpt, Args, Code)
            )
        ;   Cmd == signature
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([signature], Code)
            ;   cmd_signature(Args, Code)
            )
        ;   Cmd == pin
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([pin], Code)
            ;   resolve_kb(DirOpt, Dir),
                cmd_pin(Dir, Args, Code)
            )
        ;   kb_command(Cmd)
        ->  (   memberchk(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([Cmd], Code)
            ;   lib_dir(Lib),
                resolve_kb(DirOpt, Dir),
                (   lock_command(Cmd)
                ->  take_role(Args, ArgsR), writer_gate(Dir, ArgsR, Args1), apply_pending(Dir)
                ;   Args1 = Args
                ),
                (   writer_command(Cmd)
                ->  with_kb_lock(Dir, ( load_kb(Dir, Lib, KB),
                                        kb_cmd(Cmd, KB, Args1, Code) ))
                ;   load_kb(Dir, Lib, KB),
                    kb_cmd(Cmd, KB, Args1, Code)
                )
            )
        ;   Cmd == declare
        ->  die(2, ["Unknown command declare. It was removed (T26). Describe a new kind with orbit-kb add 'FACT' --doc TEXT, on its first use."])
        ;   atom(Cmd), \+ sub_atom(Cmd, 0, _, _, '-')
        ->  usage_error("Unknown command ~w. If ~w is a query, run it with query: orbit-kb query '~w(X)', or orbit-kb query '~w' when it has no arguments.", [Cmd, Cmd, Cmd, Cmd])
        ;   usage_error("Unknown command ~w.", [Cmd])
        )
    ).

% Commands that write to the KB. They hold the KB lock for the whole
% cycle: read the KB, choose the id or the run number, write, append.
writer_command(add).
writer_command('pin-item').
writer_command('pin-question').
writer_command('pin-answer').
writer_command('pin-request').
writer_command('apply-pending').
writer_command(review).
writer_command(subject).
writer_command(attest).
writer_command(withdraw).
% run and prove take the lock themselves, only to record the result
% (see cmd_run/3 and cmd_prove/3).

% ---------------------------------------------------------------------
% The writer lock of a KB (D23 P7; T27: every KB, and a lease)
% ---------------------------------------------------------------------
% Every KB has the file writer.lock with one line, WRITER TIME, while a
% writer holds it. TIME is the time of the holder's last write. The writer
% is the first of $ORBIT_KB_WRITER, $CLAUDE_CODE_SESSION_ID,
% $CLAUDE_SESSION_ID, $HUB_SESSION. With none, there is no writer: no
% lock is taken and none is checked. A command that writes first claims
% the lock: a free lock is taken, the holder goes on (and renews the
% lease), and another writer gets exit 2 with the holder named. The lock
% is a lease: after $ORBIT_KB_LEASE minutes (default 30) with no write by
% the holder, the next writer takes it, and writer_takeover/3 records it.
% --take replaces the holder at once and records writer_takeover/3 too.
% The lock is a record, not a guard: nothing stops a hand edit of kb.pl.

lock_command(C) :- memberchk(C, [add, subject, attest, run, prove, uses, withdraw, 'pin-item',
                                 'pin-question', 'pin-answer', 'pin-request', 'apply-pending', review]).

writer_name(W) :-
    member(V, ['ORBIT_KB_WRITER', 'CLAUDE_CODE_SESSION_ID', 'CLAUDE_SESSION_ID', 'HUB_SESSION']),
    getenv(V, W0), W0 \== '',
    !,
    W = W0.

% ---------------------------------------------------------------------
% The actor of a record (D28, T25)
% ---------------------------------------------------------------------
% Each attestation (attest, run, prove, and add of an attest/6 fact) and
% each change (add of a change/2 fact) gets actor(ID, ROLE, SESSION) right
% after it. ROLE is --as ROLE of the write command, else $ORBIT_KB_ROLE,
% else unknown. SESSION is the writer of the KB (writer_name/1, T27),
% else unknown. The role is self-reported: the tools catch mistakes, not
% cheating.

% take_role(+Args0, -Args): remove --as ROLE from the arguments of a write
% command, and keep ROLE for actor_role/1. For run, only the part before
% -- counts: after --, the arguments belong to the command.
take_role(Args0, Args) :-
    (   append(Pre0, ['--'|Post], Args0) -> Sep = ['--'|Post] ; Pre0 = Args0, Sep = [] ),
    take_role_pre(Pre0, Pre),
    append(Pre, Sep, Args).

take_role_pre(Pre0, Pre) :-
    (   append(B, [AsEq|A], Pre0), atom(AsEq), sub_atom(AsEq, 0, _, R, '--as='), R > 0
    ->  sub_atom(AsEq, 5, _, 0, Role),
        nb_setval(orbit_role, Role),
        append(B, A, Pre1),
        take_role_pre(Pre1, Pre)
    ;   append(B, ['--as'|Rest], Pre0)
    ->  (   Rest = [R|A], R \== '', \+ sub_atom(R, 0, _, _, '--')
        ->  nb_setval(orbit_role, R),
            append(B, A, Pre1),
            take_role_pre(Pre1, Pre)            % a second --as: the later one wins
        ;   usage_error("--as needs a role, such as --as review.", [])
        )
    ;   Pre = Pre0
    ).

actor_role(R) :-
    (   nb_current(orbit_role, R0), atom(R0), R0 \== [] -> R = R0
    ;   getenv('ORBIT_KB_ROLE', R0), R0 \== '' -> R = R0
    ;   R = unknown
    ).

actor_session(S) :-
    ( writer_name(S0) -> S = S0 ; S = unknown ).

% actor_line(+Id, -Line): the actor/3 line of a new record.
actor_line(Id, Line) :-
    actor_role(R), actor_session(S),
    clause_line(actor(Id, R, S), [], Line).

% lease_seconds(-S): $ORBIT_KB_LEASE minutes (a whole number, 0 or more), default 30.
lease_seconds(S) :-
    (   getenv('ORBIT_KB_LEASE', L0), L0 \== ''
    ->  (   atom_number(L0, M), integer(M), M >= 0 -> S is M * 60
        ;   die(2, ["ORBIT_KB_LEASE must be a whole number of minutes, 0 or more. It is " + L0 + ".",
                    "Nothing was written.", "Fix: unset it (the lease is 30 minutes) or give a number."] >> fix_lines)
        )
    ;   S is 30 * 60
    ).

% lease_lapsed(+Since): the holder's last write was ORBIT_KB_LEASE minutes ago or more.
lease_lapsed(Since) :-
    lease_seconds(L),
    catch(parse_time(Since, iso_8601, T0), _, fail),
    get_time(Now),
    Now - T0 >= L.

kb_uses_project(Dir) :-
    directory_file_path(Dir, 'kb.pl', F),
    exists_file(F),
    read_source_file(kb, F, Items),
    items_uses(Items, Us),
    memberchk(project, Us).

writer_gate(Dir, Args0, Args) :-
    directory_file_path(Dir, 'kb.pl', KbF),
    (   exists_file(KbF)
    ->  (   selectchk('--take', Args0, _) -> Take = true ; Take = false ),
        exclude(==('--take'), Args0, Args),
        (   writer_name(W)
        ->  lease_seconds(_),                            % a bad ORBIT_KB_LEASE is exit 2 at once
            with_kb_lock(Dir, claim_writer(Dir, W, Take))
        ;   true
        )
    ;   Args = Args0
    ).

% lock_state(+Dir, -State): none (no lock file), or held(Holder, Since), or
% bad(Why) for an empty or malformed lock. The line is NAME TIME. NAME is
% written with ~q, so a name with a space is quoted.
lock_state(Dir, State) :-
    directory_file_path(Dir, 'writer.lock', LF),
    (   exists_file(LF)
    ->  read_file_to_string(LF, S, [encoding(utf8)]),
        split_string(S, "\n", "", [L1|_]),
        split_string(L1, "", " \t\r", [L2]),
        (   L2 == ""
        ->  State = bad("The file is empty.")
        ;   sub_string(L2, B, 1, A, " "), \+ ( sub_string(L2, B2, 1, _, " "), B2 > B )
        ->  sub_string(L2, 0, B, _, NameS), sub_string(L2, _, A, 0, TimeS),
            atom_string(Since, TimeS),
            (   is_time(Since),
                (   sub_string(NameS, 0, 1, _, "'")
                ->  catch(term_string(Name, NameS), _, fail), atomic(Name)
                ;   \+ sub_string(NameS, _, 1, _, " "), atom_string(Name, NameS)
                )
            ->  ( atom(Name) -> Holder = Name ; format(atom(Holder), "~w", [Name]) ),
                State = held(Holder, Since)
            ;   State = bad("The line is not NAME TIME.")
            )
        ;   State = bad("The line is not NAME TIME.")
        )
    ;   State = none
    ).

% writer_text(+Writer, -Text): the name as the lock file holds it: bare when it is
% made of plain characters, else quoted.
writer_text(W, T) :-
    atom_codes(W, Cs),
    (   Cs \== [], forall(member(C, Cs), ( code_type(C, alnum) ; memberchk(C, `_-.@:/`) ))
    ->  atom_string(W, T)
    ;   format(string(T), "~q", [W])
    ).

lock_bad(Dir, Why) :-
    directory_file_path(Dir, 'writer.lock', LF),
    fmt(M1, "The writer lock ~w cannot be read. ~w", [LF, Why]),
    die(2, [M1, "Nothing was written.",
            "Fix: if no writer is active, delete writer.lock. Or take the lock with --take."] >> fix_lines).

claim_writer(Dir, W, Take) :-
    directory_file_path(Dir, 'writer.lock', LF),
    utc_now(Now),
    writer_text(W, WT),
    fmt(Text, "~w ~w~n", [WT, Now]),
    lock_state(Dir, State),
    (   State = held(Holder, Since)
    ->  (   Holder == W
        ->  write_atomic(LF, Text)                      % the holder renews the lease
        ;   (   Take == true
            ->  true
            ;   lease_lapsed(Since)
            ->  format(user_error, "The lease of ~w lapsed (its last write was at ~w). ~w takes the writer lock; writer_takeover records it.~n", [Holder, Since, W])
            )
        ->  directory_file_path(Dir, 'kb.pl', KbFile),
            read_file_to_string(LF, LockBefore, [encoding(utf8)]),
            write_atomic(LF, Text),
            fmt(Fact, "writer_takeover(~q, ~q, ~q).~n", [Holder, W, Now]),
            append_fact_text(KbFile, Fact),
            read_file_to_string(KbFile, After, [encoding(utf8)]),
            % D23 review: the lock moves only if the command writes. At exit, a
            % command that wrote nothing (a rejected add) gives the lock back.
            nb_setval(orbit_settle, settle_takeover(Dir, LF, LockBefore, KbFile, Fact, After))
        ;   fmt(M1, "The KB is locked. It is held by ~w since ~w.", [Holder, Since]),
            lease_seconds(LS), LM is LS // 60,
            fmt(M2, "The lease lapses ~w minutes after the holder's last write (ORBIT_KB_LEASE).", [LM]),
            die(2, [M1, "Nothing was written.", M2,
                    "Fix: ask the holder to run orbit-kb release, or take the lock with --take. A takeover is recorded in kb.pl."] >> fix_lines)
        )
    ;   State = bad(Why)
    ->  (   Take == true
        ->  write_atomic(LF, Text)
        ;   lock_bad(Dir, Why)
        )
    ;   write_atomic(LF, Text)
    ).

% recheck_writer(+Dir) (T37 c2): a command that runs long (run, prove) claims the lock again right
% before it writes, under the KB lock. If another writer took the lock meanwhile (a lapsed
% lease), the old holder is refused as at the start: exit 2, nothing written.
recheck_writer(Dir) :-
    (   writer_name(W) -> claim_writer(Dir, W, false) ; true ).

settle_takeover(Dir, LF, LockBefore, KbFile, Fact, After) :-
    catch(( with_kb_lock(Dir,
              ( read_file_to_string(KbFile, Now, [encoding(utf8)]),
                (   Now == After
                ->  string_concat(Pre, Fact, After),
                    write_atomic(KbFile, Pre),
                    write_atomic(LF, LockBefore)
                ;   true
                ) )) ), _, true).

append_fact_text(File, Text) :-
    read_file_to_string(File, S, [encoding(utf8)]),
    (   ( S == "" ; sub_string(S, _, 1, 0, "\n") ) -> Pre = "" ; Pre = "\n" ),
    setup_call_cleanup(open(File, append, O, [encoding(utf8)]),
                       format(O, "~w~w", [Pre, Text]),
                       close(O)).

cmd_release(Dir, Code) :-
    directory_file_path(Dir, 'writer.lock', LF),
    lock_state(Dir, State),
    (   State = held(Holder, Since)
    ->  (   writer_name(W), W == Holder
        ->  delete_file(LF),
            format("Released the writer lock of ~w.~n", [Holder]), Code = 0
        ;   fmt(M1, "The KB is locked. It is held by ~w since ~w. Only the holder can release it.", [Holder, Since]),
            die(2, [M1, "Fix: ask the holder, or take the lock with --take on a write."] >> fix_lines)
        )
    ;   State = bad(Why)
    ->  lock_bad(Dir, Why)
    ;   format("There is no writer lock.~n", []), Code = 0
    ).

% ---------------------------------------------------------------------
% Answers that wait (T27 c4): answers.pending
% ---------------------------------------------------------------------
% The question server never waits on an agent: it appends each answer at once to
% answers.pending next to kb.pl, one line per answer, the term
% pending(TIME, DIGEST, FACTS) (DIGEST: the sha256 of TIME and FACTS). The file is
% append-only. Every write command applies the lines that are not applied yet, before its
% own facts, as orbit-kb add --by human would write them; answers.applied records each
% one (DIGEST TIME applied|refused). So the lease holder, or the next writer, applies them.

pending_file(Dir, F) :- directory_file_path(Dir, 'answers.pending', F).
applied_file(Dir, F) :- directory_file_path(Dir, 'answers.applied', F).

pending_entries(Dir, Es) :-
    pending_file(Dir, F),
    (   exists_file(F)
    ->  catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]),
                                 pending_read(S, Es),
                                 close(S)), _, Es = [])
    ;   Es = []
    ).

pending_read(S, Es) :-
    catch(read_term(S, T, [module(orbit_ops)]), _, T = '$bad'),
    (   T == end_of_file -> Es = []
    ;   T = pending(Tm, D, Fs), atom(D), is_list(Fs), ground(Fs) -> Es = [pending(Tm, D, Fs)|Es1], pending_read(S, Es1)
    ;   T == '$bad' -> Es = [bad('a line that cannot be read, and the lines after it')]
    ;   format(string(TT1), "~q", [T]), string_length(TT1, TL), ( TL > 80 -> sub_string(TT1, 0, 80, _, TT) ; TT = TT1 ),
        Es = [bad(TT)|Es1], pending_read(S, Es1)       % T37 c1: reported, never skipped silently
    ).

applied_digests(Dir, Ds) :-
    applied_file(Dir, F),
    (   exists_file(F)
    ->  read_file_to_string(F, S, [encoding(utf8)]),
        split_string(S, "\n", " \t\r", Ls),
        findall(D, ( member(L, Ls), L \== "", split_string(L, " ", "", [DS|_]), atom_string(D, DS) ), Ds)
    ;   Ds = []
    ).

% applied_results(+Dir, -Pairs): DIGEST-applied|refused for each line of answers.applied.
applied_results(Dir, Rs) :-
    applied_file(Dir, F),
    (   exists_file(F)
    ->  read_file_to_string(F, S, [encoding(utf8)]),
        split_string(S, "\n", " \t\r", Ls),
        findall(D-R, ( member(L, Ls), L \== "", split_string(L, " ", "", [DS, _, RS]), atom_string(D, DS), atom_string(R, RS) ), Rs)
    ;   Rs = []
    ).

% pending_open(+Dir, -Entries): the lines of answers.pending that no write applied yet.
pending_open(Dir, Ps) :-
    pending_entries(Dir, Es0),
    include([E]>>( E = pending(_, _, _) ), Es0, Es),
    (   Es == [] -> Ps = []
    ;   applied_digests(Dir, Ds),
        exclude([pending(_, D, _)]>>memberchk(D, Ds), Es, Ps)
    ).

% pending_bad(+Dir, -Texts): the lines of answers.pending that are not pending(TIME, DIGEST, FACTS)
% with a list of ground facts (T37 c1). Such a line is never applied.
pending_bad(Dir, Ts) :-
    pending_entries(Dir, Es),
    findall(T, member(bad(T), Es), Ts).

pending_questions(Facts, QAs) :-
    findall(Q-A, member(answer(Q, A, _), Facts), QAs).

% queue_pending(+Dir, +Facts): append one line to answers.pending (under the KB lock).
queue_pending(Dir, Facts) :-
    utc_now(T),
    term_text(Facts, FT),
    format(string(Body), "~w ~w", [T, FT]),
    sha256_text(Body, D),
    clause_line(pending(T, D, Facts), [], Line),
    pending_file(Dir, F),
    with_kb_lock(Dir, append_lines(F, [Line])).

% apply_pending(+Dir): apply each open line of answers.pending, in order, before a write.
apply_pending(Dir) :-
    nb_setval(orbit_applied, []),
    pending_file(Dir, F),
    (   exists_file(F)
    ->  with_kb_lock(Dir, apply_pending_(Dir))
    ;   true
    ).

apply_pending_(Dir) :-
    pending_bad(Dir, Bs),
    forall(member(B, Bs),
           format(user_error, "A line in answers.pending is not applied: it is not pending(TIME, DIGEST, FACTS) with ground facts: ~w~n", [B])),
    pending_open(Dir, Ps),
    lib_dir(Lib),
    forall(member(pending(T, D, Facts), Ps), apply_one_pending(Dir, Lib, T, D, Facts)).

apply_one_pending(Dir, Lib, T, D, Facts) :-
    findall(A, ( member(Fa, Facts), term_text(Fa, S0), atom_string(A, S0) ), FAs),
    append(FAs, ['--by', human], Args),
    catch(( load_kb(Dir, Lib, KB), with_output_to(string(_), cmd_add(KB, Args, _)) ), E, true),
    utc_now(Now),
    (   var(E)
    ->  Res = applied,
        format(user_error, "Applied an answer that waited in answers.pending (queued ~w).~n", [T])
    ;   Res = refused,
        serve_err_text(E, M),
        format(user_error, "An answer in answers.pending (queued ~w) was refused, and it is not applied: ~w~n", [T, M])
    ),
    applied_file(Dir, AF),
    format(string(L), "~w ~w ~w", [D, Now, Res]),
    append_lines(AF, [L]),
    nb_getval(orbit_applied, Acc), nb_setval(orbit_applied, [Res|Acc]).

% apply-pending: a write that only applies the waiting answers (the question server runs it).
cmd_apply_pending(_, Args, Code) :-
    (   Args == [] -> true ; usage_error("apply-pending takes no arguments.", []) ),
    ( nb_current(orbit_applied, Rs) -> true ; Rs = [] ),
    include(==(applied), Rs, Ap), length(Ap, NA),
    include(==(refused), Rs, Rf), length(Rf, NR),
    format("Applied ~w waiting answer(s); ~w refused.~n", [NA, NR]),
    ( NR > 0 -> Code = 1 ; Code = 0 ).

% ---------------------------------------------------------------------
% Who owns a question (T27 c5): the ledger, the tracker, or the spec KB
% ---------------------------------------------------------------------

cmd_pin_question(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos = [Q, Kind, Ref], memberchk(Kind, [ledger, tracker]) -> true
    ;   usage_error("pin-question Q ledger|tracker REF: the ledger ask or the tracker item that owns question Q.", [])
    ),
    kb_items(KB, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = question(Q, _, QT)
    ->  true
    ;   die(1, ["There is no question " + Q + " in the KB. Nothing was written."] >> fix_lines)
    ),
    plain_text(QT, QS), sha256_text(QS, D), utc_now(Now),
    term_text(question_pin(Q, Kind, Ref, D, Now), FT), atom_string(FA, FT),
    cmd_add(KB, [FA], Code).

cmd_pin_answer(KB, Args, Code) :-
    parse_opts(Args, ['--hub'-value, '--text-file'-value, '--by'-value], Pos, Opts),
    (   Pos = [Q, Ref] -> true
    ;   usage_error("pin-answer Q REF [--hub DIR | --text-file F --by NAME]: copy the answer of question Q from its owner REF.", [])
    ),
    kb_items(KB, Items),
    (   findall(K, ( member(it(kb, _, _, T, _, _), Items), nonvar(T), T = question_pin(Q, K, Ref, _, _) ), Ks), last(Ks, Kind)
    ->  true
    ;   die(1, ["Question " + Q + " has no pin to " + Ref + ". Nothing was written.",
                "Fix: record its owner first: orbit-kb pin-question Q ledger|tracker REF."] >> fix_lines)
    ),
    (   Kind == ledger
    ->  (   memberchk('--hub'-H0, Opts) -> true
        ;   getenv('HUBFLOW_HUB', H0), H0 \== '' -> true
        ;   usage_error("pin-answer of a ledger question needs the hub: --hub DIR.", [])
        ),
        hub_root(H0, Hub),
        hub_ask(Hub, Ref, Ask),
        (   Ask == null
        ->  die(1, ["The ledger has no ask " + Ref + ". Nothing was written."] >> fix_lines)
        ;   Ask.answer == null
        ->  fmt(M1, "The ask ~w has no answer yet (status ~w). Nothing was written.", [Ref, Ask.status]),
            die(1, [M1, "Fix: the owner answers the ask in the hub (hubflow close ID --by human --note ANSWER), then run pin-answer again."] >> fix_lines)
        ;   atom_string(Text, Ask.answer),
            ( Ask.owner == null -> Name = me ; atom_string(Name, Ask.owner) )
        )
    ;   (   memberchk('--text-file'-F, Opts), memberchk('--by'-Name, Opts) -> true
        ;   usage_error("pin-answer of a tracker question needs --text-file F (the answer as the item holds it) and --by NAME (who answered).", [])
        ),
        (   exists_file(F) -> true ; die(2, ["The answer file " + F + " does not exist."] >> fix_lines) ),
        read_file_to_string(F, S0, [encoding(utf8)]),
        split_string(S0, "", " \t\r\n", [S1]),
        (   S1 == "" -> die(1, ["The answer file " + F + " is empty. Nothing was written."] >> fix_lines) ; true ),
        atom_string(Text, S1)
    ),
    sha256_text(Text, D), utc_now(Now),
    % T37 c5: Text that is the text of the default (or of an agent's answer) is written as that term
    (   member(it(kb, _, _, TA, _, _), Items), nonvar(TA), TA = assumed(Q, Def), plain_text(Def, DefT), atom_string(Text, TextS), DefT == TextS
    ->  AnsT = Def
    ;   answer_text_term(Text, AnsT)             % T38 c12: a number stays a number
    ),
    maplist([Fa, A]>>( term_text(Fa, S), atom_string(A, S) ),
            [answer(Q, AnsT, human:Name), answer_pin(Q, Ref, D, Now)], FAs),
    append(FAs, ['--by', human], AddArgs),
    cmd_add(KB, AddArgs, Code).

% hub_root(+Dir, -Abs): a hub root that holds flow/flow.db.
hub_root(H0, Hub) :-
    (   exists_directory(H0) -> absolute_file_name(H0, Hub) ; usage_error("The hub ~w is not a directory.", [H0]) ),
    hub_db(Hub, Db),
    (   exists_file(Db) -> true ; usage_error("The hub ~w has no ledger: ~w does not exist.", [H0, Db]) ).

hub_db(Hub, Db) :- directory_file_path(Hub, 'flow/flow.db', Db).

% The ledger is read directly from flow.db, read only (sqlite mode=ro), by python3.
hub_reader('import json, sqlite3, sys, datetime
from urllib.parse import quote
mode, db = sys.argv[1], sys.argv[2]
c = sqlite3.connect("file:" + quote(db) + "?mode=ro", uri=True, timeout=30)
c.row_factory = sqlite3.Row
def owner():
    r = c.execute("SELECT value FROM meta WHERE key = \'owner_person\'").fetchone()
    if r: return r[0]
    r = c.execute("SELECT key FROM person WHERE key = \'me\'").fetchone()
    return r[0] if r else None
now = datetime.datetime.now(datetime.timezone.utc)
def age(r):
    try:
        t = datetime.datetime.strptime(r["renewed_at"] or r["opened_at"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
        return max(0, (now - t).days)
    except Exception:
        return 0
if mode == "asks":
    def reserved(i):
        x = c.execute("SELECT new FROM event WHERE item_id = ? AND verb = \'reserved\' ORDER BY seq DESC LIMIT 1", (i,)).fetchone()
        return x[0] if x else None
    def notes(i):
        return [dict(at=x[0], by=x[1], by_session=x[2], note=x[3]) for x in c.execute("SELECT at, by, by_session, note FROM event WHERE item_id = ? AND verb IN (\'opened\', \'note\') AND note IS NOT NULL ORDER BY seq", (i,))]  # c13: add ask --note is on the opened event
    def refs(i):
        return [x[0] + ":" + x[1] for x in c.execute("SELECT kind, ref FROM item_ref WHERE item_id = ? ORDER BY kind, ref", (i,))]
    def links(i):
        return [dict(src=x[0], dst=x[1], kind=x[2]) for x in c.execute("SELECT from_id, to_id, kind FROM item_link WHERE from_id = ? OR to_id = ? ORDER BY from_id, to_id", (i, i))]
    def asked_by(i):
        x = c.execute("SELECT by_session, by FROM event WHERE item_id = ? AND verb = \'opened\' ORDER BY seq LIMIT 1", (i,)).fetchone()
        return (x[0] or x[1]) if x else None
    def triage(i):
        # hubflow: an open item comes due for triage after 28 idle days (LAPSE_DAYS)
        try:
            x = c.execute("SELECT idle_days FROM v_open WHERE id = ?", (i,)).fetchone()
            d = datetime.date.fromisoformat(c.execute("SELECT date(now) FROM clock").fetchone()[0])
            return (d + datetime.timedelta(days=28 - int(x[0]))).isoformat() if x else None
        except Exception:
            return None
    def col(r, k, d=None):
        return r[k] if k in r.keys() else d
    clock = c.execute("SELECT now FROM clock").fetchone()[0]
    def parked(r):
        # c37: hubflow parks a date D through that day (DT24:00:00Z); a time (skip-waived) is its own end
        pu = col(r, "parked_until")
        return bool(pu) and (pu + "T24:00:00Z" if len(pu) == 10 else pu) > clock
    rows = [dict(id=r["id"], kind=r["kind"], title=r["title"], status=r["status"], waits_on=r["waits_on"], age_days=age(r), reserved=reserved(r["id"]),
                 owner_session=r["owner_session"], opened_at=r["opened_at"], notes=notes(r["id"]), refs=refs(r["id"]), links=links(r["id"]),
                 due=col(r, "due"), no_kb=bool(col(r, "no_kb", 0)), asked_by=asked_by(r["id"]), triage_due=triage(r["id"]),
                 parked_until=col(r, "parked_until"), parked=parked(r))
            for r in c.execute("SELECT * FROM item WHERE kind = \'ask\' AND status IN (\'open\', \'waiting\') ORDER BY id")]
    # c36, c37 (review H-0063): the park of every open item, read here from the ledger, so that a
    # mindhole whose desk.py is older (no parked field in its inbox rows) still shows its parks
    # c41: with the asker\'s --due date (only that one, not the triage date), for the order of the Parked group
    parks = {r["id"]: {"until": r["parked_until"], "due": col(r, "due")} for r in c.execute("SELECT * FROM item WHERE status IN (\'open\', \'waiting\') AND parked_until IS NOT NULL") if parked(r)}
    print(json.dumps({"owner": owner(), "asks": rows, "parks": parks}))
elif mode == "titles":
    print(json.dumps([dict(id=r["id"], title=r["title"], status=r["status"], kb=[x[0] for x in c.execute("SELECT ref FROM item_ref WHERE item_id = ? AND kind = \'kb\'", (r["id"],))],
                           notes=[x[0] for x in c.execute("SELECT note FROM event WHERE item_id = ? AND verb = \'note\' AND note IS NOT NULL ORDER BY seq", (r["id"],))])
                      for r in c.execute("SELECT id, title, status FROM item ORDER BY id")]))
else:
    r = c.execute("SELECT * FROM item WHERE id = ?", (sys.argv[3],)).fetchone()
    if r is None:
        print("null")
    else:
        e = c.execute("SELECT note FROM event WHERE item_id = ? AND verb = \'closed\' AND new = \'done\' AND by = \'human\' ORDER BY seq DESC LIMIT 1", (r["id"],)).fetchone()
        print(json.dumps({"id": r["id"], "status": r["status"], "waits_on": r["waits_on"], "title": r["title"],
                          "answer": e[0] if e and r["status"] == "done" else None, "owner": owner()}))
').

hub_read(Hub, Args, J) :-
    use_module(library(http/json)),
    hub_reader(Py), hub_db(Hub, Db),
    (   absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]) -> true
    ;   die(2, ["Reading the ledger needs python3 on PATH."])
    ),
    append(['-I', '-c', Py], Args, A0), A0 = [_, _, _, Mode|Rest],
    catch(( process_create(Exe, ['-I', '-c', Py, Mode, Db|Rest],
                           [stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(P)]),
            set_stream(O, encoding(utf8)),
            read_string(O, _, Out), read_string(E, _, Err), close(O), close(E),
            process_wait(P, St) ), X, ( err_text(X, XM), die(2, ["Cannot read the ledger " + Db + ": " + XM]) )),
    (   St == exit(0), catch(atom_json_dict(Out, J, [value_string_as(string), null(null)]), _, fail)
    ->  true
    ;   split_string(Err, "", " \n", [E1]),
        die(2, ["Cannot read the ledger " + Db + ": " + E1])
    ).

hub_asks(Hub, Owner, Rows) :-
    hub_read(Hub, [asks], J),
    ( J.owner == null -> Owner = "me" ; Owner = J.owner ),
    Rows = J.asks.

hub_ask(Hub, Id, Ask) :-
    hub_read(Hub, [ask, Id], Ask).

% hub_close(+Hub, +Ask, +Text, -R): the owner's answer closes the ask in the ledger, by
% hubflow itself (run from the hub root, as a human: --session human --by human).
hub_close(Hub, Ask, Text, R) :-
    directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf),
    (   absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]), exists_file(Hf)
    ->  catch(( process_create(Exe, [Hf, '--hub', Hub, '--by', human, close, Ask, '--reason', done, '--note', Text, '--session', human],
                               [cwd(Hub), stdin(null), stdout(null), stderr(pipe(E)), process(P)]),
                read_string(E, _, Err), close(E), process_wait(P, St) ), X, ( err_text(X, Err), St = exit(2) )),
        (   St == exit(0) -> R = ok
        ;   split_string(Err, "", " \n", [E1]),
            format(string(M), "The ledger did not take the answer, and nothing was written. hubflow said: ~w", [E1]),
            R = refused(409, M)
        )
    ;   format(string(M), "The hub ~w has no .claude/scripts/hubflow.py (or python3 is missing). Nothing was written.", [Hub]),
        R = refused(409, M)
    ).

% draft questions (T27 c5): the questions for the tracker, as Markdown for a human to post.
% Each question that is to ask and not owned by the ledger, and each question pinned to a
% tracker item that has no human answer, with its case, default, options and effects.
draft_questions(KB) :-
    kb_dir(KB, Dir), answer_gate(KB), kb_engine(KB, Eng),
    directory_file_path(Dir, 'kb.pl', KbFile), sha256_file(KbFile, Digest),
    say("## Questions for the tracker", []), nl,
    say("Stamp: spec-kb@~w", [Digest]), nl,
    say("A human posts each question as a tracker item, then records it: orbit-kb pin-question Q tracker REF. The answer comes back with orbit-kb pin-answer Q REF --text-file F --by NAME.", []), nl,
    eng_all(Eng, [Q, C, T], question(Q, C, T), Qs0),
    findall(Q-C-T, ( member([Q, C, T], Qs0),
                     \+ eng_true(Eng, question_pin(Q, ledger, _, _, _)),
                     (   eng_true(Eng, to_ask(Q))
                     ;   eng_true(Eng, question_pin(Q, tracker, _, _, _)), \+ eng_true(Eng, answered(Q))
                     ) ), Qs),
    (   Qs == [] -> say("- No question waits on the tracker.", [])
    ;   forall(member(Q-C-T, Qs), draft_question(Eng, Q, C, T))
    ).

draft_question(Eng, Q, C, T) :-
    txt(T, TT), md_escape(TT, TE), md_inline(Q, Qm), say("### ~w: ~w", [Qm, TE]), nl,
    (   eng_all(Eng, [Ref], question_pin(Q, tracker, Ref, _, _), Rs), last(Rs, R1) -> md_say("- Tracker item: ", R1, "") ; say("- Tracker item: not posted yet", []) ),
    (   eng_all(Eng, [CT], claim(C, _, CT), [CT1|_]) -> txt(CT1, CTT), md_say("- Case (claim): ", CTT, "")
    ;   eng_all(Eng, [HT], hypothesis(C, _, HT), [HT1|_]) -> txt(HT1, HTT), md_say("- Case (hypothesis): ", HTT, "")
    ;   true ),
    eng_all(Eng, [Ci], cites(C, Ci), Cis), forall(member(X1, Cis), ( txt(X1, Y1), md_say("- Cites: ", Y1, "") )),
    eng_all(Eng, [N], note(Q, N), Ns), forall(member(X2, Ns), ( txt(X2, Y2), md_say("- Note: ", Y2, "") )),
    eng_all(Eng, [N2], note(C, N2), N2s), forall(member(X3, N2s), ( txt(X3, Y3), md_say("- Note on the claim: ", Y3, "") )),
    eng_all(Eng, [Ex], example(C, Ex), Exs), forall(member(X4, Exs), ( txt(X4, Y4), md_say("- Example: ", Y4, "") )),
    (   eng_all(Eng, [A], assumed(Q, A), [A1|_]) -> plain_text(A1, AT), md_say("- Default: ", AT, "") ; true ),
    eng_all(Eng, [OT, OE], option(Q, OT, OE), Os),
    forall(member([OT1, OE1], Os),
           ( plain_text(OT1, OTT), plain_text(OE1, OET), format(string(OL), "~w: ~w", [OTT, OET]), md_say("- Option ", OL, "") )),
    (   eng_all(Eng, [Du], due(Q, Du), [Du1|_]) -> md_say("- Due: ", Du1, "") ; true ),
    nl.
% ---------------------------------------------------------------------
% The KB lock (D7)
% ---------------------------------------------------------------------
% with_kb_lock(+Dir, :Goal): run Goal with an exclusive flock(2) on
% Dir/kb.lock. flock(1) from util-linux takes the lock and keeps it
% while a child cat(1) reads a pipe from this process. The lock goes
% away when this process closes the pipe, and also when this process
% dies for any reason, so a stale lock cannot occur. If flock(1) is not
% on PATH (for example on macOS), the lock is an fcntl(2) lock that SWI
% takes on the same file. It has the same release rules.

with_kb_lock(Dir, Goal) :-
    directory_file_path(Dir, 'kb.lock', LockFile),
    setup_call_cleanup(kb_lock(LockFile, Lock),
                       once(Goal),
                       kb_unlock(Lock)).

kb_lock(LockFile, Lock) :-
    (   absolute_file_name(path(flock), Flock, [access(execute), file_errors(fail)])
    ->  catch(process_create(Flock, ['-x', LockFile, '-c', 'echo locked; exec cat'],
                             [stdin(pipe(In)), stdout(pipe(Out)), stderr(null), process(P)]),
              E, true),
        (   nonvar(E)
        ->  err_text(E, ET),
            die(2, ["Could not take the KB lock " + LockFile + ": " + ET] >> fix_lines)
        ;   read_line_to_string(Out, Line),
            close(Out),
            (   Line == "locked"
            ->  Lock = flock(P, In)
            ;   catch(close(In), _, true),
                catch(process_wait(P, _), _, true),
                die(2, ["Could not take the KB lock " + LockFile + ".",
                        "Fix: check that the KB directory is writable."] >> fix_lines)
            )
        )
    ;   catch(open(LockFile, append, S, [lock(write)]), E, true),
        (   nonvar(E)
        ->  err_text(E, ET),
            die(2, ["Could not take the KB lock " + LockFile + ": " + ET] >> fix_lines)
        ;   Lock = fcntl(S)
        )
    ).

kb_unlock(flock(P, In)) :-
    catch(close(In), _, true),
    catch(process_wait(P, _), _, true).
kb_unlock(fcntl(S)) :-
    catch(close(S), _, true).

kb_cmd(add, KB, Args, Code) :- cmd_add(KB, Args, Code).
kb_cmd(subject, KB, Args, Code) :- cmd_subject(KB, Args, Code).
kb_cmd(attest, KB, Args, Code) :- cmd_attest(KB, Args, Code).
kb_cmd(run, KB, Args, Code) :- cmd_run(KB, Args, Code).
kb_cmd(prove, KB, Args, Code) :- cmd_prove(KB, Args, Code).
kb_cmd(lint, KB, Args, Code) :- cmd_lint(KB, Args, Code).
kb_cmd(query, KB, Args, Code) :- cmd_query(KB, Args, false, Code).
kb_cmd(why, KB, Args, Code) :- cmd_query(KB, Args, true, Code).
kb_cmd(whynot, KB, Args, Code) :- cmd_whynot(KB, Args, Code).
kb_cmd(show, KB, Args, Code) :- cmd_show(KB, Args, Code).
kb_cmd(report, KB, Args, Code) :- cmd_report(KB, Args, Code).
kb_cmd(draft, KB, Args, Code) :- cmd_draft(KB, Args, Code).
kb_cmd('pin-item', KB, Args, Code) :- cmd_pin_item(KB, Args, Code).
kb_cmd('pin-question', KB, Args, Code) :- cmd_pin_question(KB, Args, Code).
kb_cmd('pin-answer', KB, Args, Code) :- cmd_pin_answer(KB, Args, Code).
kb_cmd('pin-request', KB, Args, Code) :- cmd_pin_request(KB, Args, Code).
kb_cmd('apply-pending', KB, Args, Code) :- cmd_apply_pending(KB, Args, Code).
kb_cmd(review, KB, Args, Code) :- cmd_review(KB, Args, Code).
kb_cmd(withdraw, KB, Args, Code) :- cmd_withdraw(KB, Args, Code).

% ---------------------------------------------------------------------
% Library and KB location
% ---------------------------------------------------------------------

lib_dir(Lib) :-
    lib_dir_candidate(Lib0, How),
    absolute_file_name(Lib0, Lib),
    directory_file_path(Lib, 'core.pl', Core),
    (   exists_file(Core)
    ->  true
    ;   die(2, [ "The orbit-kb library is missing.",
                 "No core.pl found in the library directory.",
                 "Library directory: " + Lib,
                 How,
                 "Fix: set ORBIT_KB_LIB to the directory that holds core.pl, or run ./install.py in the sagittarius repository."
               ] >> fix_lines)
    ).

lib_dir_candidate(Lib, "It comes from ORBIT_KB_LIB.") :-
    getenv('ORBIT_KB_LIB', Lib), Lib \== '', !.
lib_dir_candidate(Lib, "It is ../share/orbit-kb next to the real path of the orbit-kb script.") :-
    orbit_script(F),
    real_file(F, R),
    file_directory_name(R, D),
    file_directory_name(D, P),
    directory_file_path(P, 'share/orbit-kb', Lib).

% ---------------------------------------------------------------------
% The version of the tool (D34, 0.3.0 V-A)
% ---------------------------------------------------------------------
% The one source is the file VERSION at the root of the Sagittarius
% repository. The library holds VERSION too: in the repository it is a
% link to ../../../VERSION, so an installed link of the CLI reads the
% root file through it. A copy of kb/bin and kb/share (a hub's
% .claude/orbit-kb; hubkit.py follows links) holds the number of the
% kit that it came from. No file, or no X.Y.Z in it: the version is
% unknown, and orbit-kb version exits 2. The tool never guesses one.

tool_version(V) :-
    catch(lib_dir_quiet(Lib), _, fail),
    directory_file_path(Lib, 'VERSION', F),
    exists_file(F),
    catch(read_file_to_string(F, S0, [encoding(utf8)]), _, fail),
    split_string(S0, "", " \t\r\n", [S]),
    split_string(S, ".", "", Ps),
    length(Ps, 3),
    forall(member(P, Ps), ( P \== "", string_codes(P, Cs), forall(member(C, Cs), code_type(C, digit)) )),
    atom_string(V, S).

% lib_dir/1 without the message: the version must not stop a help screen.
lib_dir_quiet(Lib) :-
    lib_dir_candidate(Lib0, _), !,
    absolute_file_name(Lib0, Lib).

tool_version_text(V) :- ( tool_version(V0) -> V = V0 ; V = '(version unknown)' ).

cmd_version([], Code) :- !,
    (   tool_version(V)
    ->  format("orbit-kb ~w~n", [V]), Code = 0
    ;   ( catch(lib_dir_quiet(Lib), _, fail) -> true ; Lib = '?' ),
        directory_file_path(Lib, 'VERSION', F),
        die(2, [ "The version of orbit-kb is unknown.",
                 "No X.Y.Z in " + F + ".",
                 "In the Sagittarius repository it is a link to the file VERSION at the root; a copy of kb/share holds the number itself.",
                 "Fix: run ./install.py in the sagittarius repository, or upgrade the hub's copy (hubkit.py upgrade)."
               ] >> fix_lines)
    ).
cmd_version(_, _) :-
    usage_error("version takes no arguments: orbit-kb version.", []).

% Turn a list that may hold "a" + B items into strings.
die_fix_lines(Ls0, Ls) :- maplist(fix_line, Ls0, Ls).
fix_line(A + B, S) :- !, fix_line(A, SA), fix_line(B, SB), string_concat(SA, SB, S).
fix_line(A, S) :- atom(A), !, atom_string(A, S).
fix_line(N, S) :- number(N), !, number_string(N, S).
fix_line(S, S).


real_file(F, R) :- real_file(F, 40, R).
real_file(F, N, R) :-
    N > 0,
    catch(read_link(F, _, T), _, fail),
    T \== F, !,
    N1 is N - 1,
    real_file(T, N1, R).
real_file(F, _, A) :- absolute_file_name(F, A).

resolve_kb(some(D), Dir) :- !,
    kb_dir_given(D, "--dir", Dir).
resolve_kb(none, Dir) :-
    getenv('ORBIT_KB', D), D \== '', !,
    kb_dir_given(D, "ORBIT_KB", Dir).
resolve_kb(none, Dir) :-
    working_directory(W, W),
    absolute_file_name(W, W0),
    ( W0 \== '/', atom_concat(W1, '/', W0) -> true ; W1 = W0 ),
    (   find_up(W1, Dir)
    ->  true
    ;   findall(L, ( find_down(W1, 2, Rel),
                     format(string(L), "A KB is below this directory, in ~w. To use it: orbit-kb --dir ~w COMMAND.", [Rel, Rel]) ),
                Below),
        append([ "No knowledge base found.",
                 "orbit-kb looks for a KB in this order:",
                 "1. the --dir DIR option;",
                 "2. the ORBIT_KB environment variable;",
                 "3. the nearest directory, from here upward, with a kb.pl that starts with uses([...])."
               ], Below, Ls0),
        (   hub_root(W1)
        ->  (   informal_hub(W1)
            ->  Hub = ["This is an informal hub: it has no KB. Its open work is in the ledger: python3 .claude/scripts/hubflow.py view open."]
            ;   Hub = ["This is a hub root. A spec KB is at specs/<slug>/: hubflow where SLUG prints the path, then orbit-kb --dir PATH show open."]
            )
        ;   Hub = []
        ),
        append(Ls0, ["Fix: give --dir DIR, set ORBIT_KB, or create a KB with orbit-kb init DIR --request TEXT."|Hub], Ls),
        die(2, Ls)
    ).

% hub_root(+Dir): Dir looks like a hub root: flow/seed.json, and a specs directory or the
% manifest .hub-template.json that hubkit.py install writes (T32 c8). Only for the hint.
hub_root(Dir) :-
    directory_file_path(Dir, 'flow/seed.json', F), exists_file(F),
    (   directory_file_path(Dir, specs, S), exists_directory(S)
    ->  true
    ;   directory_file_path(Dir, '.hub-template.json', M), exists_file(M)
    ).

% informal_hub(+Dir): the hub's manifest records the informal edition (hubkit.py, T32 c1).
informal_hub(Dir) :-
    directory_file_path(Dir, '.hub-template.json', M), exists_file(M),
    catch(read_file_to_string(M, Text, []), _, fail),
    sub_string(Text, _, _, _, "\"edition\": \"informal\"").

% find_down(+Dir, +Depth, -Rel): a KB in a subdirectory of Dir, at most Depth levels
% down, as a path relative to Dir. Only for the hint when no KB is found: orbit-kb
% never uses a KB below the current directory on its own.
find_down(Dir, Depth, Rel) :-
    Depth > 0,
    catch(directory_files(Dir, Es), _, fail),
    msort(Es, Sorted),
    member(E, Sorted),
    \+ sub_atom(E, 0, 1, _, '.'),
    \+ memberchk(E, [runs, node_modules, '.lake']),
    directory_file_path(Dir, E, Sub),
    exists_directory(Sub),
    (   directory_file_path(Sub, 'kb.pl', F), exists_file(F), first_term_is_uses(F)
    ->  Rel = E
    ;   D1 is Depth - 1,
        find_down(Sub, D1, R0),
        directory_file_path(E, R0, Rel)
    ).

kb_dir_given(D, From, Dir) :-
    absolute_file_name(D, Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    (   exists_file(KbFile)
    ->  true
    ;   die(2, [ "No kb.pl in " + Dir + " (from " + From + ").",
                 "Fix: give a KB directory, or create one with orbit-kb init DIR --request TEXT."
               ] >> fix_lines)
    ).

find_up(D, D) :-
    directory_file_path(D, 'kb.pl', F),
    exists_file(F),
    first_term_is_uses(F), !.
find_up(D, R) :-
    file_directory_name(D, P),
    P \== D,
    find_up(P, R).

first_term_is_uses(F) :-
    catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]),
                             read_term(S, T, [module(orbit_ops)]),
                             close(S)),
          _, fail),
    nonvar(T), T = uses(_).

% ---------------------------------------------------------------------
% Reading sources
% ---------------------------------------------------------------------
% An item is it(Src, File, Line, Term, VarNames, From-To) or
% synerr(Src, File, Line, Message). Src is core, module(M), kb, rules,
% new (add), or test (doctor).

read_source_file(Src, File, Items) :-
    (   exists_file(File)
    ->  setup_call_cleanup(open(File, read, S, [encoding(utf8)]),
                           read_items(S, Src, File, Items),
                           close(S))
    ;   Items = []
    ).

read_source_string(Src, Name, Text, Items) :-
    setup_call_cleanup(open_string(Text, S),
                       read_items(S, Src, Name, Items),
                       close(S)).

read_items(S, Src, File, Items) :-
    character_count(S, C0),
    catch(read_term(S, T, [ module(orbit_ops), variable_names(VN),
                            term_position(P), subterm_positions(SP),
                            syntax_errors(error) ]),
          E, true),
    (   nonvar(E)
    ->  syntax_error_info(E, Line, Msg),
        Items = [synerr(Src, File, Line, Msg)|Rest],
        character_count(S, C1),
        (   ( C1 =< C0 ; at_end_of_stream(S) )
        ->  Rest = []
        ;   read_items(S, Src, File, Rest)
        )
    ;   T == end_of_file
    ->  Items = []
    ;   stream_position_data(line_count, P, Line),
        (   nonvar(SP), compound(SP)
        ->  arg(1, SP, From), arg(2, SP, To)
        ;   From = 0, To = 0
        ),
        Items = [it(Src, File, Line, T, VN, From-To)|Rest],
        read_items(S, Src, File, Rest)
    ).

syntax_error_info(error(syntax_error(M), Ctx), Line, Msg) :- !,
    (   compound(Ctx), Ctx = stream(_, L, _, _) -> Line = L
    ;   compound(Ctx), Ctx = file(_, L, _, _) -> Line = L
    ;   Line = 1
    ),
    syntax_msg(M, Msg).
syntax_error_info(E, 1, Msg) :- err_text(E, Msg).

syntax_msg(M, Msg) :-
    (   atom(M)
    ->  atomic_list_concat(Ps, '_', M), atomic_list_concat(Ps, ' ', M1)
    ;   term_string(M, M1)
    ),
    fmt(Msg, "Syntax error: ~w.", [M1]).

% Parse one term from a command-line argument. The full stop is
% optional. Result: ok(Term, VarNames) or err(Message).
parse_one(Text0, Result) :-
    atom_string(Text0, T1),
    normalize_space(string(T2), T1),
    (   T2 == ""
    ->  Result = err("The text is empty.")
    ;   (   sub_string(T2, _, 1, 0, ".")
        ->  string_concat(T2, "\n", T3)
        ;   string_concat(T2, " .\n", T3)
        ),
        catch(( open_string(T3, S),
                read_term(S, T, [module(orbit_ops), variable_names(VN), syntax_errors(error)]),
                read_term(S, T4, [module(orbit_ops), syntax_errors(error)]),
                close(S) ),
              E, true),
        (   nonvar(E)
        ->  ( E = error(syntax_error(M), _) -> syntax_msg(M, Msg) ; err_text(E, Msg) ),
            Result = err(Msg)
        ;   T == end_of_file
        ->  Result = err("The text is empty.")
        ;   T4 \== end_of_file
        ->  Result = err("The text holds more than one term. Give one term per argument.")
        ;   Result = ok(T, VN)
        )
    ).

% ---------------------------------------------------------------------
% Loading a KB
% ---------------------------------------------------------------------
% KB = kb(Dir, Lib, Uses, Items). Items are in program order: core,
% modules (in uses order), kb.pl, rules.pl.

load_kb(Dir, Lib, kb(Dir, Lib, Uses, Items)) :-
    directory_file_path(Dir, 'kb.pl', KbFile),
    read_source_file(kb, KbFile, KbItems),
    items_uses(KbItems, Uses),
    directory_file_path(Lib, 'core.pl', CoreFile),
    read_source_file(core, CoreFile, CoreItems),
    findall(MI, ( member(M, Uses),
                  module_file(Lib, M, MF),
                  exists_file(MF),
                  read_source_file(module(M), MF, MIs),
                  member(MI, MIs) ),
            ModItems),
    directory_file_path(Dir, 'rules.pl', RulesFile),
    read_source_file(rules, RulesFile, RuleItems),
    derived_items(Dir, KbItems, DerivedItems),
    rules_doc_kb(RulesFile, RuleItems, KbItems, KbItemsD),
    append([CoreItems, ModItems, KbItemsD], Prior),
    rules_decl_items(RulesFile, Prior, RuleItems, RuleDecls),
    append(Prior, RuleDecls, Prior2),
    retired_decl_items(Prior2, KbItemsD, RetiredDecls),
    append([CoreItems, ModItems, KbItemsD, RuleDecls, RetiredDecls, RuleItems, DerivedItems], Items).

% retired_decl_items(+PriorItems, +KbItems, -DeclItems) (kb-migrations c16): a retired(N/A, V, R)
% fact of kb.pl declares N/A when nothing else declares it, so a query of a retired predicate
% has no answer (the cut-fail clause hides its facts) instead of a usage error, and lint names
% its facts with WM1, not E2.
retired_decl_items(Prior, KbItems, DeclItems) :-
    items_decls(Prior, Ds),
    findall(N/A, ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T), T = retired(PI, _, _),
                   nonvar(PI), PI = N/A, atom(N), integer(A), A >= 0, \+ decl_of(Ds, N, A, _) ), PIs0),
    sort(PIs0, PIs),
    findall(it(derived, '<derived>', 0, decl(fact, H, Doc, ''), [], 0-0),
            ( member(N/A, PIs), length(Ts, A), maplist(=(term), Ts), H =.. [N|Ts],
              format(atom(Doc), "A retired predicate: ~q/~w (see retired/3 in kb.pl). Its facts are out of the model.", [N, A]) ),
            DeclItems).

% rules_doc_kb(+RulesFile, +RuleItems, +KbItems0, -KbItems) (T40 c8): a decl(rule, H, Doc, T) line
% of kb.pl (from declare in an older KB) whose Doc is empty or the W7 placeholder takes the text of
% a %% doc: line just above the first clause of H in rules.pl. kb.pl itself is not changed.
rules_doc_kb(File, RuleItems, Kb0, Kb) :-
    (   exists_file(File),
        member(it(kb, _, _, D, _, _), Kb0), nonvar(D), D = decl(rule, _, OD, _), no_description(OD)
    ->  read_file_to_string(File, Text, [encoding(utf8)]),
        split_string(Text, "\n", "", Lines),
        maplist(rules_doc_kb_item(Lines, RuleItems), Kb0, Kb)
    ;   Kb = Kb0
    ).

rules_doc_kb_item(Lines, RuleItems, I0, I) :-
    (   I0 = it(kb, F, L, D, X, Y), nonvar(D), D = decl(rule, H, OD, Tpl), no_description(OD),
        callable(H), functor(H, N, A),
        once(( member(RI, RuleItems), RI = it(rules, _, RL, T, _, _), nonvar(T),
               item_head_pi(RI, N/A) )),
        doc_above(Lines, RL, Doc), Doc \== ''
    ->  I = it(kb, F, L, decl(rule, H, Doc, Tpl), X, Y)
    ;   I = I0
    ).

% rules_decl_items(+File, +PriorItems, +RuleItems, -DeclItems) (T26): a head
% of rules.pl that no decl/4 line of the core, a module, or kb.pl declares
% is declared by its first clause, as a fact kind is by its first use. Each
% argument has the type term. The doc is the text of a line
%   %% doc: TEXT
% just above the first clause of the head, else ''. A reserved name gets no
% declaration (lint E2 reports it). The other lint checks of a head (E7,
% E16, W6) are those that an explicit declaration had.
rules_decl_items(File, Prior, RuleItems, DeclItems) :-
    items_decls(Prior, Ds),
    (   exists_file(File)
    ->  read_file_to_string(File, Text, [encoding(utf8)]),
        split_string(Text, "\n", "", Lines)
    ;   Lines = []
    ),
    rules_decls_(RuleItems, Ds, Lines, [], DeclItems).

rules_decls_([], _, _, _, []).
rules_decls_([I|Is], Ds, Lines, Seen, Out) :-
    (   I = it(rules, F, L, T, _, _), nonvar(T),
        item_head_pi(I, N/A), atom(N), \+ reserved_name(N),
        \+ memberchk(N/A, Seen), \+ decl_of(Ds, N, A, _),
        clause_parts(T, H0, _), callable(H0), H0 \= -(_)
    ->  length(Ts, A), maplist(=(term), Ts), H =.. [N|Ts],
        doc_above(Lines, L, Doc),
        Out = [it(rules, F, L, decl(rule, H, Doc, ''), [], 0-0)|Out1],
        Seen1 = [N/A|Seen]
    ;   Out = Out1, Seen1 = Seen
    ),
    rules_decls_(Is, Ds, Lines, Seen1, Out1).

doc_above(Lines, L, Doc) :-
    L1 is L - 1,
    L1 >= 1, nth1(L1, Lines, S0),
    split_string(S0, "", " \t\r", [S]),
    sub_string(S, 0, _, After, "%% doc:"), !,
    sub_string(S, _, After, 0, Rest0),
    split_string(Rest0, "", " \t", [Rest]),
    atom_string(Doc, Rest).
doc_above(_, _, '').

% derived_items(+Dir, +KbItems, -Items) (D10): facts that orbit-kb
% computes from the disk and the clock each time it reads the KB.
%   proof_changed(A)  proof A does not count: a file of the proof
%                     changed, or its log is missing or does not match.
%   waiver_lapsed(W)  the due time of waiver W is past, or it is not a
%                     valid time (D10 follow-up, F9).
%   demo_changed(S)   S is the subject of a demo/2 fact, and its file is
%                     missing or its sha256 differs from subject/3 (D21 F3b).
%   due_passed(X)     the due time of a due/2 fact is past, or it is not a
%                     valid time (D22).
% And from the supersedes/2 facts of kb.pl (D10 follow-up, S3):
%   supersedes_closure(New, Old)  New reaches Old through one or more
%                     supersedes facts.
%   supersede_cycle(C)  C reaches itself.
% Both engines see them as facts. The rules in core.pl and
% modules/build.pl read them, so no rule recurses through supersedes/2.
% An id that is not an atom still gets its fact (lint E3 reports it).
derived_items(Dir, KbItems, Items) :-
    findall(proof_changed(A),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T),
              T = attest(A, lean_proof, _, P, _, _), ground(A),
              \+ proof_state(Dir, A, P, ok) ),
            Ts1),
    utc_now(Now),
    findall(waiver_lapsed(W),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T),
              T = attest(W, waiver, _, Pred, _, _), ground(W),
              \+ ( nonvar(Pred), Pred = waive(_, Due, _), is_time(Due), \+ Due @< Now ) ),
            Ts2),
    supersede_derived(KbItems, Ts3),
    findall(demo_changed(S),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T), T = demo(S, _), atom(S),
              once(( member(it(kb, _, _, T2, _, _), KbItems), nonvar(T2), T2 = subject(S, Path, D0) )),
              atom(Path),
              ( is_absolute_file_name(Path) -> Abs = Path ; directory_file_path(Dir, Path, Abs) ),
              \+ ( exists_file(Abs), sha256_file(Abs, D1), D1 == D0 ) ),
            Ts40),
    sort(Ts40, Ts4),
    findall(due_passed(X),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T), T = due(X, Due), ground(X),
              \+ ( is_time(Due), \+ Due @< Now ) ),
            Ts50),
    sort(Ts50, Ts5),
    project_derived(Dir, KbItems, Ts6),
    request_derived(KbItems, Ts7),
    verdict_derived(KbItems, Ts8),
    reopen_derived(KbItems, Ts9),
    run_after_derived(KbItems, Ts10),
    vote_void_derived(KbItems, Ts11),
    append([Ts1, Ts2, Ts3, Ts4, Ts5, Ts6, Ts7, Ts8, Ts9, Ts10, Ts11], Ts),
    findall(it(derived, '<derived>', 0, X, [], 0-0), member(X, Ts), Items).

% verdict_derived(+KbItems, -Facts) (T38 c2): later_verdict(V) for each disproof verdict V on a
% claim C that another disproof verdict on C follows in kb.pl. In a KB that uses build only.
verdict_derived(KbItems, Facts) :-
    items_uses(KbItems, Uses), memberchk(build, Uses), !,
    findall(V-C, ( kb_term(KbItems, attest(V, disproof, _, P, _, _)), nonvar(P), P = verdict(C, _), ground(V-C) ), VCs),
    findall(later_verdict(V), ( append(_, [V-C|Rest], VCs), member(_-C2, Rest), C2 == C ), Fs0),
    sort(Fs0, Facts).
verdict_derived(_, []).

% reopen_derived(+KbItems, -Facts) (D30 H4): discovery_reopened(A) for each discovery_end(A)
% record that a back attestation follows in kb.pl. In a KB that uses discovery only.
reopen_derived(KbItems, Facts) :-
    items_uses(KbItems, Uses), memberchk(discovery, Uses), !,
    findall(T, kb_term(KbItems, T), Ts),
    findall(discovery_reopened(A),
            ( append(_, [E|Rest], Ts), nonvar(E), E = discovery_end(A), ground(A),
              once(( member(B, Rest), nonvar(B), B = attest(_, Ty, _, _, _, _), Ty == back )) ),
            Fs0),
    sort(Fs0, Facts).
reopen_derived(_, []).

% vote_void_derived(+KbItems, -Facts) (D30 H5, H8): vote_void(V) for each vote V that a back
% attestation follows in kb.pl (it belongs to an earlier orbit: after a return to discovery,
% a new round of votes is needed), and for each vote V that comes after a discovery_end(E) of a
% human approval of the ticket when no back follows E (the orbit was closed when V came).
vote_void_derived(KbItems, Facts) :-
    items_uses(KbItems, Uses), memberchk(discovery, Uses), !,
    findall(T, kb_term(KbItems, T), Ts),
    findall(S, ( member(T, Ts), nonvar(T), T = ticket(S) ), Tks),
    findall(vote_void(V),
            ( append(Before, [X|After], Ts), nonvar(X), X = attest(V, Ty, _, _, _, _), Ty == vote, ground(V),
              (   member(B, After), is_back(B)
              ->  true
              ;   append(_, [E|Mid], Before), nonvar(E), E = discovery_end(A),
                  valid_end(Ts, Tks, A),
                  \+ ( member(B2, Mid), is_back(B2) )
              ) ),
            Fs0),
    sort(Fs0, Facts).
vote_void_derived(_, []).

is_back(B) :- nonvar(B), B = attest(_, Ty, _, _, _, _), Ty == back.
valid_end(Ts, Tks, A) :-
    once(( member(T, Ts), nonvar(T), T = attest(A1, Ty, S, _, By, _), A1 == A, Ty == approval, By == human, memberchk(S, Tks) )).

% run_after_derived(+KbItems, -Facts) (D33 R3): discovery_run_after(A, H) for each failed
% test_result A that follows hypothesis(H, _, _) in kb.pl. In a KB that uses discovery only.
run_after_derived(KbItems, Facts) :-
    items_uses(KbItems, Uses), memberchk(discovery, Uses), !,
    findall(T, kb_term(KbItems, T), Ts),
    findall(discovery_run_after(A, H),
            ( append(_, [E|Rest], Ts), nonvar(E), E = hypothesis(H, _, _), ground(H),
              member(B, Rest), nonvar(B), B = attest(A, Ty, _, P, _, _), Ty == test_result, ground(A),
              nonvar(P), P = result(_, _, R), R == fail ),
            Fs0),
    sort(Fs0, Facts).
run_after_derived(_, []).

% request_derived(+KbItems, -Facts) (T27 c10): request_stale(R) for a request whose latest
% request_pin (the last one in kb.pl) has a digest that is neither the digest of the request
% text in the KB nor a digest that a human accepted (request_accepted/3).
request_derived(KbItems, Facts) :-
    findall(request_stale(R),
            ( kb_term(KbItems, request(R, Text)), atom(R),
              findall(D, ( kb_term(KbItems, request_pin(R0, _, D, _)), R0 == R ), Ds), last(Ds, Last),
              \+ ( atomic(Text), sha256_text(Text, Last) ),
              \+ ( kb_term(KbItems, request_accepted(R1, D1, _)), R1 == R, D1 == Last ) ),
            Facts0),
    sort(Facts0, Facts).

% project_derived(+Dir, +KbItems, -Facts) (D23): the facts of the project module,
% for a KB that uses it.
%   subject_now(S, D)        the file of subject S exists, and its digest now is D.
%   decision_digest(X, D)    D is the sha256 of the text of decision X.
%   project_decision_digest(X, D)   the same, for a decision of the KB at project_kb/1.
%   (T43 c3: no draft is a conflict now, so no project_conflict fact is computed.)
project_derived(Dir, KbItems, Facts) :-
    items_uses(KbItems, Uses),
    memberchk(project, Uses),
    !,
    findall(subject_now(S, D),
            ( kb_term(KbItems, subject(S, Path, _)), atom(S), atom(Path),
              ( is_absolute_file_name(Path) -> Abs = Path ; directory_file_path(Dir, Path, Abs) ),
              exists_file(Abs), sha256_file(Abs, D) ),
            F1),
    findall(decision_digest(X, D),
            ( kb_term(KbItems, decision(X, Text)), atom(X), atomic(Text), sha256_text(Text, D) ),
            F2),
    (   kb_term(KbItems, project_kb(P)), atom(P),
        \+ nb_current(orbit_project_depth, 1)
    ->  setup_call_cleanup(nb_setval(orbit_project_depth, 1),
                           ( catch(project_kb_facts(Dir, P, F3), _, fail) -> true ; F3 = [] ),
                           nb_setval(orbit_project_depth, 0))
    ;   F3 = []
    ),
    project_reason_facts(Dir, KbItems, F4),
    append([F1, F2, F3, F4], Facts).
project_derived(_, _, []).

% project_reason_facts(+Dir, +KbItems, -Facts) (D27): the computed facts of the
% relations of a project KB.
%   rests_on(X, Y)          the closure of the ground depends_on/2 facts
%   agent_who(W)            W of decided_by or ratified_by is agent, or starts with agent:
%   analysis_outside(X, M)  an analysis path of X is outside Dir; M is the WP6 text
%   spec_pin(S, C, X)       spec KB S (found under the parent of Dir) has claim C with pins of X.
%                           Not computed when this KB is read for a spec KB (no recursion).
project_reason_facts(Dir, KbItems, Facts) :-
    findall(X-Y, ( kb_term(KbItems, depends_on(X, Y)), ground(X-Y) ), E0), sort(E0, Edges),
    supersede_closure(Edges, Pairs),
    findall(rests_on(X, Y), member(X-Y, Pairs), F1),
    findall(W, ( ( kb_term(KbItems, decided_by(_, W, _)) ; kb_term(KbItems, ratified_by(_, W, _)) ),
                 atom(W), agent_atom(W) ), Ws0),
    sort(Ws0, Ws), findall(agent_who(W), member(W, Ws), F2),
    findall(analysis_outside(X, M),
            ( kb_term(KbItems, analysis(X, Path)), atom(X), atomic(Path),
              \+ path_under(Dir, Path),
              format(atom(M), "The analysis of ~w is at ~w, outside the project KB. Analyses are written in the project KB when they are made: move the file under analyses/ of the project KB, and fix the path. A week's raw report or transcript is not an analysis: pin it (pin of kind file).", [X, Path]) ),
            F3),
    (   nb_current(orbit_project_depth, 1)
    ->  F4 = []
    ;   catch(spec_pins_of(Dir, none, Ts), _, Ts = []),
        findall(spec_pin(S, C, X), member(t(S, C, X), Ts), F4)
    ),
    append([F1, F2, F3, F4], Facts).

% T34 c6: the test ignores case (Agent:review and AGENT are agents too).
agent_atom(W0) :- atom(W0), downcase_atom(W0, W),
    ( W == agent -> true ; sub_atom(W, 0, _, _, 'agent:') ).

% path_under(+Dir, +Path): Path (relative to Dir, or absolute) names a file inside Dir.
path_under(Dir, Path) :-
    atom_string(PathA, Path),
    ( is_absolute_file_name(PathA) -> Abs0 = PathA ; directory_file_path(Dir, PathA, Abs0) ),
    absolute_file_name(Abs0, Abs), absolute_file_name(Dir, DirA),
    atom_concat(DirA, '/', Prefix),
    sub_atom(Abs, 0, _, _, Prefix).

% spec_pins_of(+ProjectDir, +RootOpt, -Triples) (D27): t(SpecDir, Claim, Item) for each
% pins(Claim, project, Item, _) of each KB under the root (default: the parent directory of
% the project KB) whose project_kb/1 names ProjectDir. The walk is the walk of serve --root.
% T34 c2: and each KB of the registry spec_kbs.txt of the project KB, wherever it is.
spec_pins_of(PDir, RootOpt, Ts) :-
    absolute_file_name(PDir, PA),
    (   RootOpt = some(Root0) -> absolute_file_name(Root0, Root) ; file_directory_name(PA, Root) ),
    serve_find_kbs(Root, Dirs0),
    spec_registry_dirs(PA, RDs),
    append(Dirs0, RDs, Dirs1), sort(Dirs1, Dirs),
    findall(t(SD, C, X),
            ( member(SD0, Dirs), absolute_file_name(SD0, SD), SD \== PA,
              serve_kb_project(SD, some(PA)),
              serve_kb_items(SD, Items),
              kb_term(Items, pins(C, project, X, _)), atom(C), atom(X) ),
            Ts0),
    sort(Ts0, Ts).

% The registry of pinning spec KBs (T34 c2): spec_kbs.txt in the project KB holds one
% absolute directory per line. add writes the line when a spec KB records a project_kb or a
% pins fact that names this project KB; the walk of the root finds the rest. A line whose KB
% is gone, or no longer names this project KB, is skipped when it is read.
spec_registry_file(PA, F) :- directory_file_path(PA, 'spec_kbs.txt', F).

spec_registry_dirs(PA, Dirs) :-
    spec_registry_file(PA, F),
    (   exists_file(F)
    ->  read_file_to_string(F, S, [encoding(utf8)]),
        split_string(S, "\n", " \t\r", Ls),
        findall(D, ( member(L, Ls), L \== "", atom_string(D, L),
                     directory_file_path(D, 'kb.pl', KF), exists_file(KF) ), Dirs)
    ;   Dirs = []
    ).

% register_spec_kb(+Dir, +NewItems): Dir is a spec KB that just recorded project_kb/1 or
% pins/4; add its directory to the registry of its project KB, once.
register_spec_kb(Dir0, NewItems) :-
    once(( member(it(_, _, _, T, _, _), NewItems), nonvar(T),
           ( T = pins(_, project, _, _) ; T = project_kb(_) ) )),
    absolute_file_name(Dir0, Dir),
    serve_kb_project(Dir, some(PA)), PA \== Dir,
    directory_file_path(PA, 'kb.pl', PF), exists_file(PF),
    % T40 c3: under the KB lock of the project KB, the lock of the prune of archive, so a prune
    % never renames over a line that this add appends.
    with_kb_lock(PA, register_spec_line(PA, Dir)).

register_spec_line(PA, Dir) :-
    spec_registry_dirs(PA, Ds),
    (   memberchk(Dir, Ds) -> true
    ;   spec_registry_file(PA, F),
        setup_call_cleanup(open(F, append, S, [encoding(utf8)]), format(S, "~w~n", [Dir]), close(S))
    ).

kb_term(KbItems, T) :-
    member(it(kb, _, _, T0, _, _), KbItems), nonvar(T0), T0 = T.

% project_kb_dir(+Dir, +P, -PDir) (kb-migrations c20, Ty's q21 answer B): the directory that
% project_kb(P) of the KB at Dir names. An absolute P is itself. A relative P of a KB that lies in a
% hub (an ancestor directory that hub_root/1 accepts) is read from the hub root, with its leading
% ../ and ./ steps dropped: ../../project-kb from specs/x and ../../../../project-kb from
% W0/analyses/x/kb both name HUB/project-kb, so moving a KB inside the hub needs no write. Outside a
% hub, P is read from Dir, as before.
project_kb_dir(_, P, P) :- is_absolute_file_name(P), !.
project_kb_dir(Dir, P, PDir) :-
    (   kb_hub_root(Dir, Hub)
    ->  atomic_list_concat(Segs0, '/', P),
        drop_up_segs(Segs0, Segs),
        atomic_list_concat(Segs, '/', Rest),
        ( Rest == '' -> PDir = Hub ; directory_file_path(Hub, Rest, PDir) )
    ;   directory_file_path(Dir, P, PDir)
    ).

drop_up_segs([S|Ss], R) :- memberchk(S, ['..', '.', '']), !, drop_up_segs(Ss, R).
drop_up_segs(Ss, Ss).

% kb_hub_root(+Dir, -Hub): the nearest ancestor of Dir (not Dir itself) that is a hub root.
kb_hub_root(Dir, Hub) :-
    absolute_file_name(Dir, A), file_directory_name(A, P),
    kb_hub_up(P, Hub).
kb_hub_up(D, Hub) :-
    (   hub_root(D) -> Hub = D
    ;   file_directory_name(D, P), P \== D, kb_hub_up(P, Hub)
    ).

project_kb_facts(Dir, P, Facts) :-
    project_kb_dir(Dir, P, PDir),
    directory_file_path(PDir, 'kb.pl', PFile),
    exists_file(PFile),
    absolute_file_name(PDir, A1), absolute_file_name(Dir, A2),
    A1 \== A2,
    nb_setval(orbit_project_depth, 1),
    lib_dir(Lib),
    read_source_file(kb, PFile, PItems),
    items_uses(PItems, PUses),
    memberchk(project, PUses),
    findall(project_decision_digest(X, D),
            ( member(F, [decision, definition, rule]), G =.. [F, X, Text],
              kb_term(PItems, G), atom(X), atomic(Text), sha256_text(Text, D) ),
            F1),
    load_kb(PDir, Lib, PKB),
    kb_items(PKB, AllItems), items_decls(AllItems, Ds),
    build_engine(AllItems, Ds, Eng),
    % D27: a proposed fact (an agent made it, no human ratified it) blocks nothing.
    % D38: an excludes fact that only an agent wrote is proposed too.
    swi_raw(Eng, (contradiction(CA, CB), not(proposed(CA)), not(proposed(CB)), not(proposed(excludes(CA, CB)))), CA-CB, ResC),
    (   ResC = answers(LC, _)
    ->  findall(project_contradiction(X1, Y1), ( member(X0-Y0, LC), ( X1-Y1 = X0-Y0 ; X1-Y1 = Y0-X0 ) ), FC0),
        sort(FC0, FC)
    ;   FC = []
    ),
    swi_raw(Eng, rests_on(RZ, RY), RZ-RY, ResR),
    (   ResR = answers(LR, _) -> findall(project_rests_on(Z1, Y2), member(Z1-Y2, LR), FR) ; FR = [] ),
    (   project_unclean(PKB) -> F3 = [project_kb_unclean] ; F3 = [] ),
    append([F1, F3, FC, FR], Facts).

% The project KB does not load clean: lint finds an error in it (D23).
project_unclean(PKB) :-
    catch(( lint_diags(PKB, Diags, _, IssueErrors),
            (   IssueErrors > 0
            ;   member(diag(C, _, _, _), Diags), sub_atom(C, 0, 1, _, 'E')
            ) ), _, true),
    !.

% supersede_derived(+KbItems, -Facts): the supersedes_closure/2 and
% supersede_cycle/1 facts of the ground supersedes/2 facts.
supersede_derived(KbItems, Facts) :-
    supersede_edges(KbItems, Edges),
    supersede_closure(Edges, Pairs),
    findall(supersedes_closure(N, O), member(N-O, Pairs), F1),
    findall(supersede_cycle(C), member(C-C, Pairs), F2),
    append(F1, F2, Facts).

supersede_edges(Items, Edges) :-
    findall(N-O, ( member(it(Src, _, _, T, _, _), Items), ( Src == kb ; Src == new ),
                   nonvar(T), T = supersedes(N, O), ground(N-O) ),
            Edges0),
    sort(Edges0, Edges).

% supersede_closure(+Edges, -Pairs): the sorted pairs N-O such that a
% path of one or more edges leads from N to O. A depth-first search from
% each source, so it ends on every graph, also with cycles.
supersede_closure(Edges, Pairs) :-
    findall(N, member(N-_, Edges), Ns0),
    sort(Ns0, Ns),
    findall(N-O, ( member(N, Ns), reach_from(Edges, N, Os), member(O, Os) ), Pairs0),
    sort(Pairs0, Pairs).

reach_from(Edges, N, Os) :-
    findall(M, member(N-M, Edges), Next),
    reach_walk(Next, Edges, [], Os0),
    sort(Os0, Os).

reach_walk([], _, Seen, Seen).
reach_walk([X|Xs], Edges, Seen, Out) :-
    (   memberchk(X, Seen)
    ->  reach_walk(Xs, Edges, Seen, Out)
    ;   findall(M, member(X-M, Edges), Next),
        append(Next, Xs, Todo),
        reach_walk(Todo, Edges, [X|Seen], Out)
    ).

kb_dir(kb(D, _, _, _), D).
kb_lib(kb(_, L, _, _), L).
kb_uses(kb(_, _, U, _), U).
kb_items(kb(_, _, _, I), I).

module_file(Lib, M, F) :-
    atom(M),
    format(atom(Rel), "modules/~w.pl", [M]),
    directory_file_path(Lib, Rel, F).

lib_modules(Lib, Ms) :-
    directory_file_path(Lib, modules, MD),
    (   exists_directory(MD)
    ->  directory_files(MD, Fs),
        findall(M, ( member(F, Fs), file_name_extension(M, pl, F), M \== '' ), Ms0),
        msort(Ms0, Ms)
    ;   Ms = []
    ).

items_uses(Items, Uses) :-
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = uses(L),
        is_list(L), maplist(atom, L)
    ->  Uses = L
    ;   Uses = []
    ).

kb_file(KB, F) :- kb_dir(KB, D), directory_file_path(D, 'kb.pl', F).

% All declarations in the library (core and every module) plus the
% local ones. Used by declare to refuse names declared anywhere.
% The core and the modules in uses/1 are already in the KB items, so
% only the other modules are read here.
all_known_items(KB, Items) :-
    kb_lib(KB, Lib),
    kb_items(KB, KI),
    include(src_is(core), KI, CoreItems),
    lib_modules(Lib, Ms),
    kb_uses(KB, Uses),
    findall(MI, ( member(M, Ms),
                  (   memberchk(M, Uses)
                  ->  member(MI, KI), src_is(module(M), MI)
                  ;   module_file(Lib, M, MF),
                      read_source_file(module(M), MF, MIs), member(MI, MIs)
                  ) ),
            ModItems),
    include(src_is(kb), KI, Local),
    % kb-migrations c16: a predicate that retired/3 declares is known, so an add of its fact is no
    % first use (the cut-fail clause hides the fact; lint WM1 names it).
    findall(I, ( member(I, KI), I = it(derived, _, _, T, _, _), nonvar(T), T = decl(_, _, _, _) ), RetDecls),
    append([CoreItems, ModItems, Local, RetDecls], Items).

src_is(S, it(S, _, _, _, _, _)).

% ---------------------------------------------------------------------
% Declarations
% ---------------------------------------------------------------------
% d(Name, Arity, Kind, Types, Doc, Template, Src, File, Line)
% at(Type, Shape, Writers, Doc, Src, File, Line)

items_decls(Items, Ds) :-
    findall(d(N, A, K, Ts, Doc, Tpl, Src, F, L),
            ( member(it(Src, F, L, T, _, _), Items),
              nonvar(T), T = decl(K, H, Doc, Tpl),
              callable(H), H \= -(_),
              H =.. [N|Ts], length(Ts, A) ),
            Ds).

items_atypes(Items, As) :-
    findall(at(T, S, W, Doc, Src, F, L),
            ( member(it(Src, F, L, X, _, _), Items),
              nonvar(X), X = attest_type(T, S, W, Doc) ),
            As).

decl_of(Ds, N, A, D) :-
    D = d(N, A, _, _, _, _, _, _, _),
    memberchk(D, Ds).

atype_of(As, T, X) :-
    X = at(T, _, _, _, _, _, _),
    memberchk(X, As).

meta_term(T) :- nonvar(T), ( T = uses(_) ; T = decl(_, _, _, _) ; T = attest_type(_, _, _, _) ), !.

% Two facts in one argument parse as one ','/2 term.
undeclared_msg(_, ',', 2, M) :- !,
    M = "Two or more facts are joined with a comma in one argument. Give each fact as its own argument: orbit-kb add 'f(a)' 'g(b)'.".
undeclared_msg(Ds, N, A, M) :-
    findall(A2, ( member(d(N, A2, _, _, _, _, _, _, _), Ds), A2 \== A ), As0),
    sort(As0, As),
    (   As == []
    ->  fmt(M, "~q/~w is not declared.", [N, A])
    ;   atomic_list_concat(As, ' and ', AT),
        fmt(M, "~q/~w is not declared. ~q is declared with arity ~w.", [N, A, N, AT])
    ).

src_text(core, "the core") :- !.
src_text(module(M), S) :- !, fmt(S, "module ~w", [M]).
src_text(kb, "kb.pl") :- !.
src_text(rules, "rules.pl") :- !.
src_text(derived, "orbit-kb (computed when it reads the KB)") :- !.
src_text(S, T) :- fmt(T, "~w", [S]).

% ---------------------------------------------------------------------
% Types
% ---------------------------------------------------------------------

simple_type(T) :- memberchk(T, [id, ref, text, atom, int, time, digest, by, term, attest_predicate]).

is_type_term(T) :- atom(T), !, simple_type(T).
is_type_term(T) :- compound(T), ( T = ref(_) ; T = oneof(_) ; T = alt(_) ), !.

% type_errs(+Type, +FactNames, -Errors): Errors is a list of strings.
type_errs(T, _, ["A type is a variable."]) :- var(T), !.
type_errs(T, _, []) :- atom(T), simple_type(T), !.
type_errs(ref(Ns), K, Es) :- is_list(Ns), !,
    (   Ns \== [], maplist(atom, Ns)
    ->  findall(E, ( member(N, Ns), \+ memberchk(N, K),
                     fmt(E, "ref(~q) names ~q, which is no declared fact predicate.", [Ns, N]) ), Es)
    ;   Es = ["ref([...]) needs a list of fact names, such as ref([claim, check])."]
    ).
type_errs(ref(N), K, Es) :- !,
    (   atom(N), memberchk(N, K)
    ->  Es = []
    ;   fmt(E, "ref(~q) names no declared fact predicate.", [N]), Es = [E]
    ).
type_errs(oneof(L), _, Es) :- !,
    (   is_list(L), L \== [], maplist(atom, L)
    ->  Es = []
    ;   Es = ["oneof needs a list of atoms, such as oneof([low, high])."]
    ).
type_errs(alt(L), K, Es) :- !,
    (   is_list(L), L \== []
    ->  findall(E, ( member(S, L), entry_errs(S, K, E1), member(E, E1) ), Es)
    ;   Es = ["alt needs a list of shapes, such as alt([none, some(text)])."]
    ).
type_errs(T, _, [E]) :-
    term_text(T, S),
    fmt(E, "~w is not a known type. The known types are id, ref(Name), ref([Name, ...]), ref, oneof([...]), alt([...]), text, atom, int, time, digest, by, and term.", [S]).

entry_errs(S, _, ["A shape is a variable."]) :- var(S), !.
entry_errs(S, _, []) :- atom(S), !.
entry_errs(S, K, Es) :- compound(S), !,
    S =.. [_|Ts],
    findall(E, ( member(T, Ts), type_errs(T, K, E1), member(E, E1) ), Es).
entry_errs(S, _, [E]) :-
    term_text(S, T),
    fmt(E, "~w is not a valid shape. Use an atom or a compound whose arguments are types.", [T]).

shape_errs(S, K, Es) :-
    (   nonvar(S), is_type_term(S)
    ->  type_errs(S, K, Es)
    ;   entry_errs(S, K, Es)
    ).

% Value checks. env(Ids, FirstArgs): Ids is the sorted list of all
% id values; FirstArgs is a sorted list of Name-FirstArg.
% val_errs(+Type, +Value, +Env, -Errors): Errors is a list of Code-Text.

val_errs(_, V, _, []) :- var(V), !.
val_errs(_, V, _, ['E3'-"It is a double-quoted string. Write text in single quotes, such as 'text'."]) :-
    string(V), !.
val_errs(id, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("an id (an atom)", V, Es) ).
val_errs(text, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("text in single quotes", V, Es) ).
val_errs(atom, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("an atom", V, Es) ).
val_errs(int, V, _, Es) :- !, ( integer(V) -> Es = [] ; bad_value("an integer", V, Es) ).
val_errs(time, V, _, Es) :- !, ( is_time(V) -> Es = [] ; bad_value("a valid UTC time such as '2026-10-15T12:00:00Z' (month 01-12, a day of that month, hour 00-23, minute and second 00-59)", V, Es) ).
val_errs(digest, V, _, Es) :- !, ( is_digest(V) -> Es = [] ; bad_value("a digest 'sha256:' plus 64 lowercase hex characters", V, Es) ).
val_errs(by, V, _, Es) :- !, ( memberchk(V, [human, agent, script]) -> Es = [] ; bad_value("human, agent, or script", V, Es) ).
val_errs(term, V, _, Es) :- !,
    (   has_string(V)
    ->  Es = ['E3'-"It holds a double-quoted string. Write text in single quotes."]
    ;   Es = []
    ).
val_errs(attest_predicate, _, _, []) :- !.
val_errs(ref, V, env(_, _, IdA, _), Es) :- !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   get_assoc(V, IdA, _)
    ->  Es = []
    ;   fmt(M, "~q is not an existing id. This argument names an id that another fact defines (a claim, a question, the request); it does not create one. For example, attach a note with note(c1, '...') or note(r1, '...'). Add the fact that defines ~q first, or use an existing id.", [V, V]),
        Es = ['E4'-M]
    ).
% ref([N1, N2, ...]) (D13): the id of a fact of any one of the names.
val_errs(ref(Ns), V, env(_, _, _, FAA), Es) :- is_list(Ns), !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   member(N, Ns), get_assoc(N-V, FAA, _)
    ->  Es = []
    ;   kinds_text(Ns, KT),
        fmt(M, "~q is not the id of any ~w fact. It must be the id of a ~w. Add that fact first, or fix the id.", [V, KT, KT]),
        Es = ['E4'-M]
    ).
val_errs(ref(N), V, env(_, _, _, FAA), Es) :- !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   get_assoc(N-V, FAA, _)
    ->  Es = []
    ;   fmt(M, "~q is not the id of any ~q fact. Add the ~q fact first, or fix the id.", [V, N, N]),
        Es = ['E4'-M]
    ).
val_errs(oneof(L), V, _, Es) :- !,
    (   atom(V), memberchk(V, L)
    ->  Es = []
    ;   atomic_list_concat(L, ', ', LT),
        term_text(V, VT),
        fmt(M, "The label must be one of: ~w. It is ~w.", [LT, VT]),
        Es = ['E3'-M]
    ).
val_errs(alt(Entries), V, Env, Es) :- !,
    (   member(E, Entries), atom(E), V == E
    ->  Es = []
    ;   compound(V), compound_name_arity(V, Nm, Ar),
        member(E, Entries), compound(E), compound_name_arity(E, Nm, Ar)
    ->  E =.. [_|Ts], V =.. [_|Vs],
        args_errs(Ts, Vs, Env, Es)
    ;   maplist(term_text, Entries, ETs),
        atomic_list_concat(ETs, ', ', J),
        term_text(V, VT),
        (   bare_label_example(Entries, V, Ex)
        ->  term_text(Ex, ExT),
            fmt(M, "It must match one of: ~w. It is ~w. The label ~w takes an argument: write ~w.", [J, VT, V, ExT])
        ;   fmt(M, "It must match one of: ~w. It is ~w.", [J, VT])
        ),
        Es = ['E3'-M]
    ).
val_errs(T, _, _, ['E3'-M]) :-
    term_text(T, TT),
    fmt(M, "Its declared type ~w is unknown.", [TT]).

% bare_label_example(+Entries, +V, -Example): V is an atom that names a compound
% entry of an alt, such as refuted for refuted(text). Example is that entry with
% a sample argument in each place, such as refuted('the counterexample').
bare_label_example(Entries, V, Ex) :-
    atom(V),
    member(E, Entries), compound(E), compound_name_arity(E, V, _), !,
    E =.. [_|Ts],
    maplist(sample_arg(V), Ts, As),
    Ex =.. [V|As].

sample_arg(refuted, text, 'the counterexample') :- !.
sample_arg(_, text, 'some text') :- !.
sample_arg(_, int, 1) :- !.
sample_arg(_, ref([N|_]), N) :- !.
sample_arg(_, ref(N), N) :- !.
sample_arg(_, T, T).

% bare_label_whole(+Shape, +Pred, -Whole): Pred has a bare label where Shape wants
% an alt entry with arguments. Whole is Pred with a sample in that place.
bare_label_whole(S, V, Whole) :-
    compound(S), compound(V),
    S =.. [N|Ts], V =.. [N|Vs],
    nth1(I, Ts, alt(Entries)), nth1(I, Vs, Bare),
    bare_label_example(Entries, Bare, Ex),
    nth1(I, Vs, Bare, Rest), nth1(I, Vs2, Ex, Rest),
    Whole =.. [N|Vs2].

shape_val_errs(_, V, _, []) :- var(V), !.
shape_val_errs(S, V, Env, Es) :- is_type_term(S), !, val_errs(S, V, Env, Es).
shape_val_errs(S, V, _, Es) :- atom(S), !,
    (   V == S
    ->  Es = []
    ;   term_text(V, VT), fmt(M, "It must be ~q. It is ~w.", [S, VT]), Es = ['E3'-M]
    ).
shape_val_errs(S, V, Env, Es) :- compound(S), !,
    compound_name_arity(S, N, A),
    (   compound(V), compound_name_arity(V, N, A)
    ->  S =.. [_|Ts], V =.. [_|Vs],
        args_errs(Ts, Vs, Env, Es0),
        (   Es0 \== [], bare_label_whole(S, V, Whole)
        ->  term_text(Whole, WT),
            fmt(HM, "Write the whole predicate as ~w.", [WT]),
            append(Es0, ['E3'-HM], Es)
        ;   Es = Es0
        )
    ;   term_text(S, ST), term_text(V, VT),
        (   inner_label_whole(S, V, WT)
        ->  fmt(M, "It must have the form ~w. It is ~w. Write the whole predicate as ~w.", [ST, VT, WT])
        ;   fmt(M, "It must have the form ~w. It is ~w.", [ST, VT])
        ),
        Es = ['E3'-M]
    ).
shape_val_errs(_, _, _, ['E3'-"The attestation type has an invalid shape."]).

% inner_label_whole(+Shape, +Pred, -Text): Pred is only one entry of an alt inside Shape,
% such as tested(100) for verdict(ref(claim), alt([..., tested(int)])). Text is the whole
% predicate, with each ref argument as a placeholder: verdict(CLAIM, tested(100)).
inner_label_whole(S, V, Text) :-
    compound(S), S =.. [N|Ts],
    nth1(I, Ts, alt(Entries)), member(E, Entries), same_entry_shape(E, V), !,
    findall(A, ( nth1(J, Ts, T),
                 (   J == I -> term_text(V, A)
                 ;   T = ref(K), atom(K) -> upcase_atom(K, A)
                 ;   term_text(T, A)
                 ) ), As),
    atomic_list_concat(As, ', ', Inner),
    fmt(Text, "~w(~w)", [N, Inner]).

same_entry_shape(E, V) :- atom(E), !, E == V.
same_entry_shape(E, V) :- compound(E), compound(V),
    compound_name_arity(E, F, A), compound_name_arity(V, F, A).

args_errs(Ts, Vs, Env, Es) :-
    findall(C-M, ( nth1(I, Ts, T), nth1(I, Vs, V),
                   val_errs(T, V, Env, Es1), member(C-M0, Es1),
                   fmt(M, "In argument ~w: ~w", [I, M0]) ),
            Es).

% kinds_text(+Names, -Text): "claim, check, or question".
kinds_text([N], T) :- !, fmt(T, "~w", [N]).
kinds_text([A, B], T) :- !, fmt(T, "~w or ~w", [A, B]).
kinds_text(Ns, T) :-
    append(Init, [Last], Ns),
    atomic_list_concat(Init, ', ', IT),
    fmt(T, "~w, or ~w", [IT, Last]).

bad_value(What, V, ['E3'-M]) :-
    term_text(V, VT),
    fmt(M, "It must be ~w. It is ~w.", [What, VT]).

has_string(V) :- string(V), !.
has_string(V) :- compound(V), arg(_, V, A), has_string(A), !.

% is_time(+A): A is a UTC time YYYY-MM-DDTHH:MM:SSZ with real values:
% month 1-12, a day of that month (leap years too), hour 0-23, minute
% and second 0-59 (D10 follow-up, F10).
is_time(A) :-
    atom(A),
    atom_codes(A, Cs),
    Cs = [Y1, Y2, Y3, Y4, 0'-, M1, M2, 0'-, D1, D2, 0'T, H1, H2, 0':, I1, I2, 0':, S1, S2, 0'Z],
    maplist(is_digit_code, [Y1, Y2, Y3, Y4, M1, M2, D1, D2, H1, H2, I1, I2, S1, S2]),
    number_codes(Y, [Y1, Y2, Y3, Y4]), number_codes(Mo, [M1, M2]), number_codes(D, [D1, D2]),
    number_codes(H, [H1, H2]), number_codes(Mi, [I1, I2]), number_codes(S, [S1, S2]),
    between(1, 12, Mo),
    month_days(Y, Mo, MD), between(1, MD, D),
    between(0, 23, H), between(0, 59, Mi), between(0, 59, S).

month_days(Y, 2, D) :- !, ( leap_year(Y) -> D = 29 ; D = 28 ).
month_days(_, M, 30) :- memberchk(M, [4, 6, 9, 11]), !.
month_days(_, _, 31).

leap_year(Y) :- Y mod 4 =:= 0, ( Y mod 100 =\= 0 -> true ; Y mod 400 =:= 0 ).

is_digit_code(C) :- integer(C), C >= 0'0, C =< 0'9.

is_digest(A) :-
    atom(A),
    atom_concat('sha256:', Hex, A),
    atom_length(Hex, 64),
    atom_codes(Hex, Cs),
    forall(member(C, Cs), ( is_digit_code(C) ; ( C >= 0'a, C =< 0'f ) )).

% ---------------------------------------------------------------------
% Facts in kb.pl
% ---------------------------------------------------------------------

fact_item(it(Src, _, _, T, _, _)) :-
    ( Src == kb ; Src == new ),
    \+ meta_term(T).

pos_fact(T) :-
    nonvar(T), callable(T),
    T \= -(_), T \= (_ :- _), T \= (:- _), T \= #(_).

% env(Ids, FirstArgs, IdAssoc, FirstArgAssoc): the lists, and the same
% sets as AVL trees for O(log n) lookups.
build_env(FactItems, Ds, env(Ids, FA, IdA, FAA)) :-
    findall(V, ( member(it(_, _, _, T, _, _), FactItems), pos_fact(T),
                 id_value(T, Ds, V) ),
            Ids0),
    sort(Ids0, Ids),
    findall(N-V, ( member(it(_, _, _, T, _, _), FactItems), pos_fact(T),
                   compound(T), T =.. [N, V|_], atom(V) ),
            FA0),
    sort(FA0, FA),
    set_assoc(Ids, IdA),
    set_assoc(FA, FAA).

set_assoc(Sorted, A) :-
    findall(K-t, member(K, Sorted), Ps),
    ord_list_to_assoc(Ps, A).

id_value(T, Ds, V) :-
    functor(T, N, A),
    A > 0,
    decl_of(Ds, N, A, d(_, _, fact, Ts, _, _, _, _, _)),
    nth1(I, Ts, id),
    arg(I, T, V),
    atom(V).

% fctx(KB, Decls, AttestTypes, Env)
fact_diags(_, it(_, F, L, T, _, _), [diag('E2', F, L, "This term is a variable, not a fact.")]) :-
    var(T), !.
fact_diags(fctx(KB, _, _, _), it(_, F, L, (H :- B), _, _), Diags) :-
    cutfail_clause(H, B), !,
    kb_items(KB, Items),
    (   cutfail_problem(Items, L, H, M) -> Diags = [diag('E7', F, L, M)] ; Diags = [] ).
fact_diags(_, it(_, F, L, (_ :- _), _, _),
           [diag('E7', F, L, "This is a rule. Rules belong in rules.pl, not in kb.pl.")]) :- !.
fact_diags(_, it(_, _, _, (:- _), _, _), []) :- !.    % E17
fact_diags(_, it(_, _, _, #(_), _, _), []) :- !.       % E17
fact_diags(Ctx, it(_, F, L, T, _, _), Diags) :-
    (   T = -(P), callable(P) -> Neg = true ; P = T, Neg = false ),
    (   \+ callable(P)
    ->  Diags = [diag('E2', F, L, "This is not a fact. A fact is a name with arguments, such as claim(c1, preserve, 'Text').")]
    ;   functor(P, N, A),
        Ctx = fctx(KB, Ds, ATs, Env),
        (   \+ decl_of(Ds, N, A, _)
        ->  (   unused_module_decl(KB, N, A, Mod)
            ->  fmt(M, "~q/~w is declared in module ~w, which this KB does not use. Add the module first: orbit-kb uses ~w.", [N, A, Mod, Mod])
            ;   undeclared_msg(Ds, N, A, M0),
                fmt(M, "~w Fix the name, or add a fact of it: orbit-kb add 'NAME(...)' --doc TEXT.", [M0])
            ),
            Diags = [diag('E2', F, L, M)]
        ;   decl_of(Ds, N, A, d(_, _, Kind, Ts, _, _, _, _, _)),
            (   Kind == rule
            ->  fmt(M, "~q/~w is a rule predicate. Rules compute it, so it cannot be a fact in kb.pl. Remove the fact, or write a rule in rules.pl.", [N, A]),
                Diags = [diag('E7', F, L, M)]
            ;   ( ground(T) -> G6 = [] ;
                  G6 = [diag('E6', F, L, "The fact has variables. Every fact must be ground. Replace each variable with a value.")] ),
                findall(diag(C, F, L, M),
                        ( nth1(I, Ts, Ty), arg(I, P, V),
                          val_errs(Ty, V, Env, Es), member(C-M0, Es),
                          fmt(M, "~q/~w argument ~w: ~w", [N, A, I, M0]) ),
                        GA),
                (   N/A == attest/6, Neg == false
                ->  attest_diags(KB, ATs, Env, P, F, L, GT)
                ;   GT = []
                ),
                (   N/A == supersedes/2, Neg == false
                ->  supersedes_kind_diags(Env, P, F, L, GS)
                ;   GS = []
                ),
                ( Neg == false -> project_fact_diags(P, F, L, GP) ; GP = [] ),   % T34
                append([G6, GA, GT, GS, GP], Diags)
            )
        )
    ).

% unused_module_decl(+KB, +N, +A, -Module) (D22): N/A is declared in a
% library module that the KB does not use.
unused_module_decl(KB, N, A, M) :-
    kb_lib(KB, Lib), kb_uses(KB, Uses),
    lib_modules(Lib, Ms),
    member(M, Ms), \+ memberchk(M, Uses),
    module_file(Lib, M, MF),
    read_source_file(module(M), MF, MIs),
    items_decls(MIs, MDs),
    decl_of(MDs, N, A, _), !.

% supersedes_kind_diags(+Env, +Fact, +F, +L, -Diags) (D15): supersedes/2 has the
% type ref in core.pl, because one type cannot name every kind that it takes
% (claims, hypotheses, and the project kinds). Here each side must be a claim or a hypothesis, and both sides
% the same kind. An id that does not exist is E4 of the ref type already.
supersedes_kind_diags(env(_, _, IdA, FAA), supersedes(N, O), F, L, Diags) :-
    findall(diag('E4', F, L, M),
            ( nth1(I, [N, O], X), atom(X), get_assoc(X, IdA, _),
              \+ sup_kind(FAA, X, _),
              fmt(M, "supersedes/2 argument ~w: ~q is not the id of a claim or a hypothesis. supersedes takes two claims, two hypotheses, or two decisions, two definitions, or two rules (project module). Fix the id.", [I, X]) ),
            D1),
    (   sup_kind(FAA, N, KN), sup_kind(FAA, O, KO), KN \== KO
    ->  fmt(M2, "supersedes/2: ~q is a ~w and ~q is a ~w. Both sides must be the same kind: a claim cannot replace a hypothesis, and a decision cannot replace a definition. To reword a hypothesis, add a new hypothesis, then supersedes(NewHypothesis, ~q).", [N, KN, O, KO, O]),
        D2 = [diag('E4', F, L, M2)]
    ;   D2 = []
    ),
    append(D1, D2, Diags).

% project_fact_diags(+Fact, +F, +L, -Diags) (T34 c5, c6; D27 R10): checks of one fact of the
% project module, at add and at lint. EP2: a fact cannot depend on or exclude itself. EP1:
% an agent (any case) may not ratify.
project_fact_diags(depends_on(X, X), F, L, [diag('EP2', F, L, M)]) :- atom(X), !,
    fmt(M, "depends_on(~q, ~q): a fact cannot depend on itself. Remove the fact, or name the fact that ~q depends on.", [X, X, X]).
project_fact_diags(excludes(X, X), F, L, [diag('EP2', F, L, M)]) :- atom(X), !,
    fmt(M, "excludes(~q, ~q): a fact cannot exclude itself. To end a fact, supersede it. Remove the fact.", [X, X]).
project_fact_diags(ratified_by(X, W, _), F, L, [diag('EP1', F, L, M)]) :- atom(W), agent_atom(W), !,
    fmt(M, "ratified_by(~q, ~q, _): an agent ratified this fact. Only a human may ratify a fact that an agent made. Ask a human, and record their name.", [X, W]).
project_fact_diags(_, _, _, []).

sup_kind(FAA, X, claim) :- atom(X), get_assoc(claim-X, FAA, _), !.
sup_kind(FAA, X, hypothesis) :- atom(X), get_assoc(hypothesis-X, FAA, _), !.
sup_kind(FAA, X, K) :- atom(X), member(K, [decision, definition, rule]), get_assoc(K-X, FAA, _), !.  % D27

attest_diags(KB, ATs, Env, Fact0, F, L, Diags) :-
    Fact0 = attest(_, Type, _, Pred, By, _),
    (   \+ atom(Type)
    ->  Diags = []                       % reported as a type error already
    ;   \+ atype_of(ATs, Type, _)
    ->  fmt(M, "~q is not a declared attestation type. Use a type that orbit-kb help core or a module topic lists, or fix the type.", [Type]),
        Diags = [diag('E3', F, L, M)]
    ;   atype_of(ATs, Type, at(_, Shape, Writers, _, _, _, _)),
        shape_val_errs(Shape, Pred, Env, Es),
        findall(diag(C, F, L, M),
                ( member(C-M0, Es),
                  fmt(M, "attest/6 argument 4 (the predicate of type ~q): ~w", [Type, M0]) ),
                D1),
        (   atom(By), is_list(Writers), \+ memberchk(By, Writers)
        ->  atomic_list_concat(Writers, ', ', WT),
            (   Writers == [script]
            ->  script_cmd(Type, SC),
                fmt(M8, "Type ~q allows only the writer script. Only ~w writes it. This attestation is by ~q.", [Type, SC, By])
            ;   fmt(M8, "Type ~q allows only these writers: ~w. This attestation is by ~q. Change the writer, or use another type.", [Type, WT, By])
            ),
            D2 = [diag('E8', F, L, M8)]
        ;   D2 = []
        ),
        (   Type == test_result, nonvar(Pred), Pred = result(K, RN, R),
            atom(K), integer(RN), atom(R),
            \+ run_log_ok(KB, K, RN, R)
        ->  fmt(M9, "No run log matches this test result. Expected runs/~w-~w.log with result=~w in its first line. Only orbit-kb run writes test results.", [RN, K, R]),
            D3 = [diag('E9', F, L, M9)]
        ;   Type == lean_proof, nonvar(Pred), Pred = proof(_, _),
            arg(1, Fact0, Id), atom(Id), kb_dir(KB, Dir),
            \+ proof_log_matches(Dir, Id, Pred)
        ->  fmt(M9, "No proof log matches this lean_proof. Expected runs/proof-~w.log with the same claim and digest in its first line. Only orbit-kb prove writes proofs.", [Id]),
            D3 = [diag('E9', F, L, M9)]
        ;   D3 = []
        ),
        append([D1, D2, D3], Diags)
    ).

% script_cmd(+Type, -Command): the command that writes a script-only type.
script_cmd(lean_proof, "orbit-kb prove") :- !.
script_cmd(_, "orbit-kb run").

run_log_path(KB, K, N, P) :-
    kb_dir(KB, Dir),
    format(atom(Rel), "runs/~w-~w.log", [N, K]),
    directory_file_path(Dir, Rel, P).

run_log_ok(KB, K, N, R) :-
    run_log_path(KB, K, N, P),
    exists_file(P),
    setup_call_cleanup(open(P, read, S, [encoding(utf8)]),
                       read_line_to_string(S, Line),
                       close(S)),
    string(Line),
    split_string(Line, " ", "", Parts),
    Parts = ["%", "orbit-kb", "run", NS, CS, RS|_],
    number_string(N, NS),
    fmt(CS0, "check=~w", [K]), CS == CS0,
    fmt(RS0, "result=~w", [R]), RS == RS0.

% E15 (D10 follow-up, S2): each supersedes/2 fact on a cycle. A claim
% that replaces itself, directly or through other claims, is not
% current, so its burn would close with no proof.
e15_diags(FactItems, Diags) :-
    supersede_edges(FactItems, Edges),
    supersede_closure(Edges, Pairs),
    findall(diag('E15', F, L, M),
            ( member(it(_, F, L, T, _, _), FactItems), nonvar(T),
              T = supersedes(N, O), ground(N-O),
              ord_memberchk(O-N, Pairs),
              sup_kind_words(FactItems, N, One, Many),
              (   N == O
              ->  fmt(M, "supersedes(~q, ~q): a ~w cannot replace itself. Remove this fact. done is false while a supersede cycle exists.", [N, O, One])
              ;   fmt(M, "supersedes(~q, ~q) is part of a supersede cycle: ~q also replaces ~q, directly or through other ~w. A ~w cannot replace itself. Remove one supersedes fact of the cycle. done is false while the cycle exists.", [N, O, O, N, Many, One])
              ) ),
            Diags).

% sup_kind_words(+FactItems, +Id, -One, -Many): "hypothesis" and "hypotheses"
% when Id is a hypothesis (D15), else "claim" and "claims".
sup_kind_words(FactItems, X, "hypothesis", "hypotheses") :-
    member(it(_, _, _, T, _, _), FactItems), nonvar(T), T = hypothesis(Y, _, _), Y == X, !.
sup_kind_words(FactItems, X, One, Many) :-
    member(K-One-Many, [decision-"decision"-"decisions", definition-"definition"-"definitions", rule-"rule"-"rules"]),
    member(it(_, _, _, T, _, _), FactItems), nonvar(T), functor(T, K, 2), arg(1, T, Y), Y == X, !.
sup_kind_words(_, _, "claim", "claims").

% E5 over the facts in order. Only diagnostics at a later item.
e5_diags(FactItems, Ds, Diags) :-
    empty_assoc(Seen),
    e5_walk(FactItems, Ds, Seen, Diags).

e5_walk([], _, _, []).
e5_walk([it(Src, F, L, T, _, _)|Is], Ds, Seen, Diags) :-
    (   pos_fact(T)
    ->  findall(V, id_value(T, Ds, V), Vs)
    ;   Vs = []
    ),
    e5_vals(Vs, F, L, Seen, Seen1, D1),
    e5_walk(Is, Ds, Seen1, D2),
    _ = Src,
    append(D1, D2, Diags).

e5_vals([], _, _, S, S, []).
e5_vals([V|Vs], F, L, Seen, Seen2, Diags) :-
    (   get_assoc(V, Seen, F0:L0)
    ->  show_loc(F0, L0, LT),
        fmt(M, "The id ~q is already used at ~w. Each id must be unique. Choose a new id.", [V, LT]),
        show_loc(F, L, LT2),
        fmt(M0, "The id ~q is used again at ~w. Each id must be unique. Give one of them a new id.", [V, LT2]),
        Diags = [diag('E5', F0, L0, M0), diag('E5', F, L, M)|Ds1],
        Seen1 = Seen
    ;   Diags = Ds1,
        put_assoc(V, Seen, F:L, Seen1)
    ),
    e5_vals(Vs, F, L, Seen1, Seen2, Ds1).

:- dynamic show_base/1.
show_loc(F, L, T) :-
    show_file(F, FT),
    fmt(T, "~w:~w", [FT, L]).
show_file(F, FT) :-
    (   show_base(B), atom(F), atom_concat(B, '/', BP), atom_concat(BP, R, F)
    ->  FT = R
    ;   FT = F
    ).

% ---------------------------------------------------------------------
% Rules: E2, E7, W6, E14
% ---------------------------------------------------------------------

builtin_goal(G) :-
    callable(G),
    functor(G, N, A),
    memberchk(N/A, ['='/2, '\\='/2, '<'/2, '>'/2, '=<'/2, '>='/2, is/2,
                    true/0, false/0, forall/2,
                    '=='/2, '\\=='/2, '@<'/2, '@>'/2, '@=<'/2, '@>='/2]).

% body_goals(+Body, -Goals): the literals of a body, with not and -
% unwrapped. forall/2 stays, and its parts are added too.
body_goals(G, [G]) :- var(G), !.
body_goals((A, B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals((A ; B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals((A -> B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals(not(G), Gs) :- !, body_goals(G, Gs).
body_goals(-(G), Gs) :- callable(G), !, body_goals(G, Gs).
body_goals(forall(A, B), [forall(A, B)|Gs]) :- !,
    body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals(G, [G]).

clause_parts((H :- B), H, B) :- !.
clause_parts((:- B), none, B) :- !.
clause_parts(H, H, true).

rule_item_diags(Ds, it(Src, F, L, T, VN, _), Diags) :-
    (   var(T)
    ->  Diags = [diag('E2', F, L, "This clause is a variable.")]
    ;   meta_term(T)
    ->  Diags = []
    ;   T = #(_)
    ->  Diags = []
    ;   clause_parts(T, H, B),
        head_diags(Ds, Src, F, L, H, DH),
        body_goals(B, Gs),
        head_name(H, HN),
        findall(D, ( member(G, Gs), body_goal_diag(Ds, F, L, HN, G, D) ), DB),
        e14_diags(T, VN, F, L, D14),
        append([DH, DB, D14], Diags)
    ).

head_name(none, "a constraint") :- !.
head_name(H, S) :-
    ( H = -(H1), callable(H1) -> true ; H1 = H ),
    ( callable(H1) -> functor(H1, N, A), fmt(S, "~q/~w", [N, A]) ; S = "a clause" ).

head_diags(_, _, _, _, none, []) :- !.
head_diags(Ds, Src, F, L, H0, Diags) :-
    ( H0 = -(H), callable(H) -> true ; H = H0 ),
    (   \+ callable(H)
    ->  Diags = [diag('E2', F, L, "The head of this clause is not a predicate.")]
    ;   functor(H, N, A),
        (   \+ decl_of(Ds, N, A, _)
        ->  undeclared_msg(Ds, N, A, M0),
            fmt(M, "Head: ~w The name may be reserved. A head of rules.pl is declared by its first clause: choose another name.", [M0]),
            Diags = [diag('E2', F, L, M)]
        ;   decl_of(Ds, N, A, d(_, _, Kind, _, _, _, DSrc, _, _)),
            (   Kind == fact
            ->  fmt(M, "~q/~w is a fact predicate. Its facts belong in kb.pl only, but this clause is in ~w. Declare a rule predicate for computed values.", [N, A, F]),
                Diags = [diag('E7', F, L, M)]
            ;   Src == rules, ( DSrc == core ; DSrc = module(_) ), protected_pi(N/A)
            ->  src_text(DSrc, ST),
                fmt(M, "rules.pl adds clauses to ~q/~w from ~w. rules.pl cannot change done, the burn rules, the waiver rules, the vote rules, the blocking rules, or the facts that orbit-kb computes. The engines ignore this clause. Remove it.", [N, A, ST]),
                Diags = [diag('E16', F, L, M)]
            ;   Src == rules, ( DSrc == core ; DSrc = module(_) )
            ->  src_text(DSrc, ST),
                fmt(M, "rules.pl adds clauses to ~q/~w from ~w. This is an extension. Review it.", [N, A, ST]),
                Diags = [diag('W6', F, L, M)]
            ;   Diags = []
            )
        )
    ).

