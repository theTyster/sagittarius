#!/usr/bin/env swipl
% orbit-kb: a helper CLI for Prolog knowledge bases (KBs) with default
% negation (not p).
%
% Run `orbit-kb help` for usage. The contract for this tool is
% kb/CONTRACT.md in the sagittarius repository.
%
% SWI-Prolog, in this process, answers every query. Until 2026-11-02 a
% second engine, s(CASP), gave the explanations and cross-checked each
% answer; it never found a fault in a KB, only in the tools (CONTRACT
% D20). The explanations of why and whynot now come from the same
% clauses (see "Explanations").

:- initialization(main, main).

% ---------------------------------------------------------------------
% Fast start
% ---------------------------------------------------------------------
% Loading this script and its libraries takes about 80 ms. A saved state
% (swipl -o STATE -c SCRIPT) starts in about 15 ms. Measured on a whole
% call of `orbit-kb help` (2026-10-30, median of 10, three runs): about
% 40 ms from the state, 57 ms with ORBIT_KB_NO_CACHE=1. The state lives in
% ${XDG_CACHE_HOME:-~/.cache}/orbit-kb/ under a digest of the script
% text, the script path, and the SWI-Prolog version and executable. So
% an edit of the script, or a new SWI-Prolog, gives a new state.
%
% The directive below runs while this file loads, before the rest of
% the file is compiled. If the state for this script exists, it
% replaces this process with "swipl -x STATE -- ARGS" (exec, the same
% process id, the same streams). If not, the file loads as usual, the
% command runs, and at the end main/0 builds the state for the next
% call (about 0.3 s, once per script version).
%
% Every problem falls back to the normal load: no cache directory, an
% unwritable directory, no library(unix), a failed build (it leaves a
% .failed marker, so the build is not tried again). ORBIT_KB_NO_CACHE=1
% turns the state off.

:- dynamic orbit_state_wanted/2.

orbit_boot :-
    (   getenv('ORBIT_KB_STATE_BUILD', _)       % building the state now
    ->  true
    ;   catch(orbit_boot_, _, true)
    ->  true
    ;   true
    ).

orbit_boot_ :-
    \+ ( getenv('ORBIT_KB_NO_CACHE', V), V \== '', V \== '0' ),
    prolog_load_context(file, Script),
    orbit_state_path(Script, State),
    (   exists_file(State)
    ->  (   orbit_state_valid(State)
        ->  current_prolog_flag(argv, Argv),
            current_prolog_flag(executable, Exe),
            use_module(library(unix), [exec/1]),
            Cmd =.. [Exe, '-x', State, '--'|Argv],
            exec(Cmd)
        ;   % A bad state is removed. This call loads the script as
            % usual; the next call builds a new state.
            orbit_state_drop_bad(State)
        )
    ;   atom_concat(State, '.failed', Failed),
        \+ exists_file(Failed)
    ->  assertz(orbit_state_wanted(State, Script))
    ;   true
    ).

% A state is used only if its sidecar STATE.ok exists and records the
% size and the SHA-1 of the state file. The builder writes the sidecar
% (atomically) after the state is complete. So a truncated, overwritten,
% or half-written state is never started: swipl -x would abort on it
% before any fallback could run.
orbit_state_valid(State) :-
    atom_concat(State, '.ok', Ok),
    catch(setup_call_cleanup(open(Ok, read, S), read_term(S, T, []), close(S)), _, fail),
    T = state_ok(Size, Hash),
    size_file(State, Size),
    orbit_file_sha(State, Hash).

orbit_file_sha(File, Hash) :-
    setup_call_cleanup(open(File, read, S, [type(binary)]),
                       read_string(S, _, Bytes),
                       close(S)),
    variant_sha1(Bytes, Hash).

% Delete a bad state and its sidecar. A state without a sidecar may be
% one that a builder renamed a moment ago, so it is deleted only when
% it is older than one minute.
orbit_state_drop_bad(State) :-
    atom_concat(State, '.ok', Ok),
    (   exists_file(Ok)
    ->  catch(delete_file(State), _, true),
        catch(delete_file(Ok), _, true)
    ;   catch(time_file(State, T), _, fail),
        get_time(Now),
        Now - T > 60
    ->  catch(delete_file(State), _, true)
    ;   true
    ).

orbit_cache_root(Root) :-
    (   getenv('XDG_CACHE_HOME', X), X \== '', is_absolute_file_name(X)
    ->  Base = X
    ;   getenv('HOME', H), H \== ''
    ->  atom_concat(H, '/.cache', Base)
    ),
    atom_concat(Base, '/orbit-kb', Root).

orbit_state_path(Script, State) :-
    setup_call_cleanup(open(Script, read, S, [type(binary)]),
                       read_string(S, _, Text),
                       close(S)),
    current_prolog_flag(version, V),
    current_prolog_flag(executable, Exe),
    current_prolog_flag(home, Home),
    variant_sha1(state(Text, Script, V, Exe, Home), Hash),
    % The name starts with a digest of the script path, so pruning can
    % find the old states of this script (prune_states/2).
    variant_sha1(path(Script), PH),
    sub_atom(PH, 0, 12, _, P),
    orbit_cache_root(Root),
    atomic_list_concat([Root, '/state-', P, '-', Hash, '.qs'], State).

:- orbit_boot.

% Libraries. Those that only some commands need load on first use.
:- use_module(library(lists)).
:- use_module(library(apply)).
:- autoload(library(readutil), [read_file_to_string/3, read_line_to_string/2]).
:- autoload(library(process), [process_create/3, process_wait/2, process_kill/2]).
:- autoload(library(filesex), [directory_file_path/3, make_directory_path/1, link_file/3]).
:- autoload(library(http/json), [json_read_dict/2, json_read_dict/3]).
:- autoload(library(time), [call_with_time_limit/2]).
:- autoload(library(ugraphs), [vertices_edges_to_ugraph/3, transitive_closure/2]).

:- dynamic orbit_script/1, orbit_tmp/1.

:- prolog_load_context(file, F), assertz(orbit_script(F)).

% library(crypto) loads on first use (sha256_file/2).
have_crypto :-
    catch(use_module(library(crypto)), _, fail),
    current_predicate(crypto:crypto_file_hash/3).

% ---------------------------------------------------------------------
% Entry point
% ---------------------------------------------------------------------

main :-
    state_flags,
    % Remove temp files also when a signal halts the process.
    at_halt(cleanup_tmp),
    catch(set_stream(user_output, encoding(utf8)), _, true),
    catch(set_stream(user_error, encoding(utf8)), _, true),
    setup_ops,
    current_prolog_flag(argv, Argv),
    catch(top(Argv, Code), E, top_error(E, Code)),
    cleanup_tmp,
    catch(( flush_output(user_output), flush_output(user_error) ), E2, true),
    (   nonvar(E2), broken_pipe(E2)
    ->  quiet_streams
    ;   nonvar(E2)
    ->  throw(E2)
    ;   true
    ),
    build_state,
    exit_now(Code).

% exit_now(+Code): end the process with exit status Code. halt/1 runs the
% halt hooks of the foreign libraries. One of them can deadlock: in the
% D10 follow-up (2026-10-20), about 1 in 2800 calls of query hung after
% the answer was printed, with the main thread in a mutex wait in a
% cleanup hook under PL_halt (eu-stack: cleanup <- run_on_halt <-
% PL_cleanup <- PL_halt) and the GC thread idle. Here the output is
% flushed and the temp files are removed, so no hook has work left. The process replaces itself with
% "sh -c 'exit Code'", which runs no hook. Any problem falls back to
% halt/1.
exit_now(Code) :-
    % D23: a takeover that the command did not use is undone (see claim_writer/3).
    (   nb_current(orbit_settle, G), G \== none -> nb_setval(orbit_settle, none), catch(G, _, true) ; true ),
    (   integer(Code), Code >= 0, Code =< 255,
        catch(use_module(library(unix), [exec/1]), _, fail),
        absolute_file_name(path(sh), Sh, [access(execute), file_errors(fail)])
    ->  format(atom(Arg), "exit ~d", [Code]),
        Cmd =.. [Sh, '-c', Arg],
        catch(exec(Cmd), _, true)
    ;   true
    ),
    halt(Code).

% A saved state starts with other defaults than "swipl SCRIPT". Set the
% flags that differ back to the values of a script run.
state_flags :-
    (   current_prolog_flag(saved_program, true)
    ->  set_prolog_flag(autoload, true),
        set_prolog_flag(on_error, print),
        set_prolog_flag(on_warning, print),
        set_prolog_flag(verbose, normal),
        set_prolog_flag(encoding, text)
    ;   true
    ).

% Build the saved state for the next call (see "Fast start"). The output
% of the command is already flushed. Any failure leaves a .failed
% marker, and the CLI keeps working from the script.
build_state :-
    (   retract(orbit_state_wanted(State, Script))
    ->  catch(build_state(State, Script), _, true)
    ;   true
    ).

build_state(State, Script) :-
    file_directory_name(State, Dir),
    make_directory_path(Dir),
    access_file(Dir, write),
    current_prolog_flag(executable, Exe),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w.~w-~w.tmp", [State, Pid, R]),
    (   catch(( process_create(Exe, ['-q', '-o', Tmp, '-c', Script],
                               [ stdin(null), stdout(null), stderr(null),
                                 environment(['ORBIT_KB_STATE_BUILD'='1']),
                                 process(P1) ]),
                process_wait(P1, exit(0)),
                exists_file(Tmp),
                % The script must not have changed since this process
                % read it, or the state would not match its name.
                orbit_state_path(Script, State),
                % The new state must run before it is used.
                process_create(Exe, ['-x', Tmp, '--', help],
                               [ stdin(null), stdout(null), stderr(null),
                                 environment(['ORBIT_KB_STATE_BUILD'='1']),
                                 process(P2) ]),
                process_wait(P2, exit(0)) ),
              _, fail)
    ->  rename_file(Tmp, State),
        size_file(State, Size),
        orbit_file_sha(State, Hash),
        format(string(OkText), "~q.~n", [state_ok(Size, Hash)]),
        atom_concat(State, '.ok', Ok),
        write_atomic(Ok, OkText),
        prune_states(Dir, State)
    ;   catch(delete_file(Tmp), _, true),
        atom_concat(State, '.failed', Failed),
        catch(( open(Failed, write, S), close(S) ), _, true)
    ).

% Delete the files of older states of this script (same path digest,
% other key): state, sidecar, and .failed marker. States of other
% script paths are deleted when they are older than 7 days.
prune_states(Dir, Keep) :-
    file_base_name(Keep, KeepBase),
    file_name_extension(KeepStem, qs, KeepBase),
    atomic_list_concat([state, P|_], '-', KeepStem),
    directory_files(Dir, Fs),
    get_time(Now),
    forall(( member(F, Fs),
             atomic_list_concat([state|Parts], '-', F),
             \+ sub_atom(F, 0, _, _, KeepStem),
             atomic_list_concat([Dir, '/', F], Path),
             catch(time_file(Path, T), _, fail),
             Age is Now - T,
             (   file_name_extension(_, tmp, F)
             ->  Age > 3600                      % a build may still run
             ;   Parts = [_]
             ->  true                            % the old name format
             ;   Parts = [P|_]
             ->  true                            % this script, other key
             ;   Age > 7*24*3600                 % another script path
             ) ),
           catch(delete_file(Path), _, true)).

% The reader closed the pipe (for example `orbit-kb ... | head`). Exit
% quietly: no message, no trace. Point the standard streams at a null
% stream, so halt/1 does not try to flush into the closed pipe again.
broken_pipe(error(io_error(write, _), _)).

quiet_streams :-
    open_null_stream(N1),
    catch(set_stream(N1, alias(user_output)), _, true),
    open_null_stream(N2),
    catch(set_stream(N2, alias(user_error)), _, true).

top_error(E, 141) :- broken_pipe(E), !,
    quiet_streams.
top_error(orbit_error(Code, Lines), Code) :- !,
    print_lines(user_error, Lines).
top_error(E, 2) :-
    err_text(E, T),
    format(user_error, "orbit-kb: internal error: ~w~n", [T]),
    format(user_error, "This is a bug in orbit-kb. Report it with the command line.~n", []).

die(Code, Fmt, Args) :-
    format(string(S), Fmt, Args),
    throw(orbit_error(Code, [S])).
die(Code, Lines0) :-
    ( nonvar(Lines0), Lines0 = (L >> _) -> true ; L = Lines0 ),
    die_fix_lines(L, Lines),
    throw(orbit_error(Code, Lines)).

usage_error(Fmt, Args) :-
    format(string(S), Fmt, Args),
    throw(orbit_error(2, [S, "Run `orbit-kb help` for usage."])).

print_lines(S, Lines) :-
    forall(member(L, Lines), format(S, "~w~n", [L])).

fmt(S, Fmt, Args) :- format(string(S), Fmt, Args).

err_text(E, S) :-
    (   catch(phrase('$messages':translate_message(E), L), _, fail)
    ->  with_output_to(string(S0), print_message_lines(current_output, '', L)),
        split_string(S0, "\n", " \t", Parts0),
        exclude(==(""), Parts0, Parts),
        atomic_list_concat(Parts, ' ', A),
        atom_string(A, S)
    ;   fmt(S, "~q", [E])
    ).

% ---------------------------------------------------------------------
% Operators for reading sources. They live in the module orbit_ops only,
% so they do not change how this script itself is read. Only not is part
% of the KB language. The others read the syntax of s(CASP), so that lint
% can name such a line (E17) instead of a bare syntax error.
% ---------------------------------------------------------------------

kb_op(900, fy, not).
kb_op(950, xfx, ::).
kb_op(1200, fx, #).
kb_op(1150, fx, [table, show, pred]).
kb_op(350, fx, [include, compute, abducible]).
kb_op(700, xfx, ['#=', '#<>', '#<', '#>', '#=<', '#>=']).

setup_ops :-
    forall(kb_op(P, T, N), op(P, T, orbit_ops:N)).

% Write a term with quotes and the KB operators. Variables print as
% their source names, or as _ when they have no name.
term_text(T, S) :- term_text(T, [], S).
term_text(T, VN, S) :-
    copy_term(T-VN, T2-VN2),
    maplist(bind_vn, VN2),
    term_variables(T2, Vs),
    maplist(=('$VAR'('_')), Vs),
    wtext(T2, S).

bind_vn(N=V) :- ( var(V) -> V = '$VAR'(N) ; true ).

wtext(T, S) :-
    with_output_to(string(S),
                   write_term(T, [quoted(true), module(orbit_ops),
                                  numbervars(true), spacing(next_argument)])).

% A clause or fact as one line of source text, with the full stop.
clause_line(T, VN, Line) :-
    term_text(T, VN, S),
    (   sub_string(S, _, 1, 0, Last),
        sub_atom('#$&*+-./:<=>?@^~\\', _, 1, _, Last)
    ->  string_concat(S, " .", Line)
    ;   string_concat(S, ".", Line)
    ).

% ---------------------------------------------------------------------
% Temporary files
% ---------------------------------------------------------------------

% tmp_stream(+Ext, -Path, -Stream): a new temporary file, created with
% an unpredictable name and opened for writing (tmp_file_stream/3).
tmp_stream(Ext, Path, S) :-
    tmp_file_stream(Path, S, [extension(Ext), encoding(utf8)]),
    assertz(orbit_tmp(Path)).

cleanup_tmp :-
    forall(retract(orbit_tmp(P)), catch(delete_file(P), _, true)).

% ---------------------------------------------------------------------
% Argument parsing
% ---------------------------------------------------------------------

% parse_opts(+Args, +Spec, -Positional, -Opts)
% Spec is a list of Name-value or Name-flag. An argument that starts
% with a single dash and is not a known option is positional, so goals
% such as '-world(x)' work.
parse_opts([], _, [], []).
parse_opts([A|As], Spec, Pos, Opts) :-
    (   A == '--'
    ->  Pos = ['--'|As], Opts = []
    ;   sub_atom(A, 0, 2, _, '--'), sub_atom(A, B, 1, _, '='), B > 2
    ->  sub_atom(A, 0, B, _, Name),
        B1 is B + 1, sub_atom(A, B1, _, 0, Val),
        (   memberchk(Name-value, Spec)
        ->  Opts = [Name-Val|Os], parse_opts(As, Spec, Pos, Os)
        ;   usage_error("Unknown option ~w.", [Name])
        )
    ;   memberchk(A-Kind, Spec)
    ->  (   Kind == flag
        ->  Opts = [A-true|Os], parse_opts(As, Spec, Pos, Os)
        ;   As = [V|As1]
        ->  Opts = [A-V|Os], parse_opts(As1, Spec, Pos, Os)
        ;   usage_error("The option ~w needs a value.", [A])
        )
    ;   sub_atom(A, 0, 2, _, '--')
    ->  usage_error("Unknown option ~w.", [A])
    ;   Pos = [A|Ps], parse_opts(As, Spec, Ps, Opts)
    ).

opt(Opts, Name, Default, V) :-
    ( memberchk(Name-V0, Opts) -> V = V0 ; V = Default ).

% Remove --dir DIR (anywhere before --) from the argument list.
take_dir([], none, []).
take_dir(['--'|As], none, ['--'|As]) :- !.
take_dir(['--dir', D|As], some(D), Rest) :- !, take_dir(As, _, Rest).
take_dir(['--dir'], _, _) :- !, usage_error("The option --dir needs a directory.", []).
take_dir([A|As], Dir, Rest) :-
    sub_atom(A, 0, _, _, '--dir='), !,
    sub_atom(A, 6, _, 0, D),
    take_dir(As, Dir0, Rest),
    ( Dir0 = some(_) -> Dir = Dir0 ; Dir = some(D) ).
take_dir([A|As], Dir, [A|Rest]) :- take_dir(As, Dir, Rest).

% ---------------------------------------------------------------------
% Dispatch
% ---------------------------------------------------------------------

kb_command(add).
kb_command(declare).
kb_command(subject).
kb_command(attest).
kb_command(run).
kb_command(prove).
kb_command(lint).
kb_command(query).
kb_command(why).
kb_command(whynot).
kb_command(show).
kb_command(report).
kb_command(draft).
kb_command('pin-item').

top(Argv0, Code) :-
    take_dirs(Argv0, Dirs, [view|ViewArgs]), !,
    (   member(Arg, ViewArgs), memberchk(Arg, ['--help', '-h'])
    ->  cmd_help([view], Code)
    ;   cmd_view(Dirs, ViewArgs, Code)
    ).
top(Argv0, Code) :-
    take_dirs(Argv0, Dirs, [serve|ServeArgs]), !,
    (   member(Arg, ServeArgs), memberchk(Arg, ['--help', '-h'])
    ->  cmd_help([serve], Code)
    ;   cmd_serve(Dirs, ServeArgs, Code)
    ).
top(Argv0, Code) :-
    take_dir(Argv0, DirOpt, Argv),
    (   Argv == []
    ->  help_lines(general, Ls), print_lines(user_error, Ls), Code = 2
    ;   Argv = [Cmd|Args],
        (   memberchk(Cmd, [help, '--help', '-h'])
        ->  cmd_help(Args, Code)
        ;   Cmd == init
        ->  cmd_init(Args, Code)
        ;   Cmd == doctor
        ->  cmd_doctor(Args, Code)
        ;   Cmd == uses
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([uses], Code)
            ;   resolve_kb(DirOpt, Dir),
                writer_gate(Dir, Args, Args1),
                with_kb_lock(Dir, cmd_uses(Dir, Args1, Code))
            )
        ;   Cmd == release
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([release], Code)
            ;   Args == []
            ->  resolve_kb(DirOpt, Dir),
                with_kb_lock(Dir, cmd_release(Dir, Code))
            ;   usage_error("release takes no arguments.", [])
            )
        ;   Cmd == pin
        ->  (   member(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([pin], Code)
            ;   resolve_kb(DirOpt, Dir),
                cmd_pin(Dir, Args, Code)
            )
        ;   kb_command(Cmd)
        ->  (   memberchk(Arg, Args), memberchk(Arg, ['--help', '-h'])
            ->  cmd_help([Cmd], Code)
            ;   lib_dir(Lib),
                resolve_kb(DirOpt, Dir),
                (   lock_command(Cmd) -> writer_gate(Dir, Args, Args1) ; Args1 = Args ),
                (   writer_command(Cmd)
                ->  with_kb_lock(Dir, ( load_kb(Dir, Lib, KB),
                                        kb_cmd(Cmd, KB, Args1, Code) ))
                ;   load_kb(Dir, Lib, KB),
                    kb_cmd(Cmd, KB, Args1, Code)
                )
            )
        ;   atom(Cmd), \+ sub_atom(Cmd, 0, _, _, '-')
        ->  usage_error("Unknown command ~w. If ~w is a query, run it with query: orbit-kb query '~w(X)', or orbit-kb query '~w' when it has no arguments.", [Cmd, Cmd, Cmd, Cmd])
        ;   usage_error("Unknown command ~w.", [Cmd])
        )
    ).

% Commands that write to the KB. They hold the KB lock for the whole
% cycle: read the KB, choose the id or the run number, write, append.
writer_command(add).
writer_command('pin-item').
writer_command(declare).
writer_command(subject).
writer_command(attest).
% run and prove take the lock themselves, only to record the result
% (see cmd_run/3 and cmd_prove/3).

% ---------------------------------------------------------------------
% The writer lock of a project KB (D23 P7)
% ---------------------------------------------------------------------
% A KB that uses the project module has the file writer.lock with one line,
% WRITER TIME. The writer is $ORBIT_KB_WRITER, or else $CLAUDE_SESSION_ID. With
% neither, there is no writer: no lock is taken and none is checked. A
% command that writes first claims the lock: a free lock is taken, the
% holder goes on, and another writer gets exit 2 with the holder named.
% --take replaces the holder and records writer_takeover/3 in kb.pl. The
% lock is a record, not a guard: nothing stops a hand edit of kb.pl.

lock_command(C) :- memberchk(C, [add, declare, subject, attest, run, prove, uses, 'pin-item']).

writer_name(W) :-
    (   getenv('ORBIT_KB_WRITER', W0), W0 \== ''
    ->  W = W0
    ;   getenv('CLAUDE_SESSION_ID', W0), W0 \== ''
    ->  W = W0
    ).

kb_uses_project(Dir) :-
    directory_file_path(Dir, 'kb.pl', F),
    exists_file(F),
    read_source_file(kb, F, Items),
    items_uses(Items, Us),
    memberchk(project, Us).

writer_gate(Dir, Args0, Args) :-
    (   kb_uses_project(Dir)
    ->  (   selectchk('--take', Args0, _) -> Take = true ; Take = false ),
        exclude(==('--take'), Args0, Args),
        (   writer_name(W)
        ->  with_kb_lock(Dir, claim_writer(Dir, W, Take))
        ;   true
        )
    ;   Args = Args0
    ).

% lock_state(+Dir, -State): none (no lock file), or held(Holder, Since), or
% bad(Why) for an empty or malformed lock. The line is NAME TIME. NAME is
% written with ~q, so a name with a space is quoted.
lock_state(Dir, State) :-
    directory_file_path(Dir, 'writer.lock', LF),
    (   exists_file(LF)
    ->  read_file_to_string(LF, S, [encoding(utf8)]),
        split_string(S, "\n", "", [L1|_]),
        split_string(L1, "", " \t\r", [L2]),
        (   L2 == ""
        ->  State = bad("The file is empty.")
        ;   sub_string(L2, B, 1, A, " "), \+ ( sub_string(L2, B2, 1, _, " "), B2 > B )
        ->  sub_string(L2, 0, B, _, NameS), sub_string(L2, _, A, 0, TimeS),
            atom_string(Since, TimeS),
            (   is_time(Since),
                (   sub_string(NameS, 0, 1, _, "'")
                ->  catch(term_string(Name, NameS), _, fail), atomic(Name)
                ;   \+ sub_string(NameS, _, 1, _, " "), atom_string(Name, NameS)
                )
            ->  ( atom(Name) -> Holder = Name ; format(atom(Holder), "~w", [Name]) ),
                State = held(Holder, Since)
            ;   State = bad("The line is not NAME TIME.")
            )
        ;   State = bad("The line is not NAME TIME.")
        )
    ;   State = none
    ).

% writer_text(+Writer, -Text): the name as the lock file holds it: bare when it is
% made of plain characters, else quoted.
writer_text(W, T) :-
    atom_codes(W, Cs),
    (   Cs \== [], forall(member(C, Cs), ( code_type(C, alnum) ; memberchk(C, `_-.@:/`) ))
    ->  atom_string(W, T)
    ;   format(string(T), "~q", [W])
    ).

lock_bad(Dir, Why) :-
    directory_file_path(Dir, 'writer.lock', LF),
    fmt(M1, "The writer lock ~w cannot be read. ~w", [LF, Why]),
    die(2, [M1, "Nothing was written.",
            "Fix: if no writer is active, delete writer.lock. Or take the lock with --take."] >> fix_lines).

claim_writer(Dir, W, Take) :-
    directory_file_path(Dir, 'writer.lock', LF),
    utc_now(Now),
    writer_text(W, WT),
    fmt(Text, "~w ~w~n", [WT, Now]),
    lock_state(Dir, State),
    (   State = held(Holder, Since)
    ->  (   Holder == W
        ->  true
        ;   Take == true
        ->  directory_file_path(Dir, 'kb.pl', KbFile),
            read_file_to_string(LF, LockBefore, [encoding(utf8)]),
            write_atomic(LF, Text),
            fmt(Fact, "writer_takeover(~q, ~q, ~q).~n", [Holder, W, Now]),
            append_fact_text(KbFile, Fact),
            read_file_to_string(KbFile, After, [encoding(utf8)]),
            % D23 review: the lock moves only if the command writes. At exit, a
            % command that wrote nothing (a rejected add) gives the lock back.
            nb_setval(orbit_settle, settle_takeover(Dir, LF, LockBefore, KbFile, Fact, After))
        ;   fmt(M1, "The KB is locked. It is held by ~w since ~w.", [Holder, Since]),
            die(2, [M1, "Nothing was written.",
                    "Fix: ask the holder to run orbit-kb release, or take the lock with --take. A takeover is recorded in kb.pl."] >> fix_lines)
        )
    ;   State = bad(Why)
    ->  (   Take == true
        ->  write_atomic(LF, Text)
        ;   lock_bad(Dir, Why)
        )
    ;   write_atomic(LF, Text)
    ).

settle_takeover(Dir, LF, LockBefore, KbFile, Fact, After) :-
    catch(( with_kb_lock(Dir,
              ( read_file_to_string(KbFile, Now, [encoding(utf8)]),
                (   Now == After
                ->  string_concat(Pre, Fact, After),
                    write_atomic(KbFile, Pre),
                    write_atomic(LF, LockBefore)
                ;   true
                ) )) ), _, true).

append_fact_text(File, Text) :-
    read_file_to_string(File, S, [encoding(utf8)]),
    (   ( S == "" ; sub_string(S, _, 1, 0, "\n") ) -> Pre = "" ; Pre = "\n" ),
    setup_call_cleanup(open(File, append, O, [encoding(utf8)]),
                       format(O, "~w~w", [Pre, Text]),
                       close(O)).

cmd_release(Dir, Code) :-
    directory_file_path(Dir, 'writer.lock', LF),
    lock_state(Dir, State),
    (   State = held(Holder, Since)
    ->  (   writer_name(W), W == Holder
        ->  delete_file(LF),
            format("Released the writer lock of ~w.~n", [Holder]), Code = 0
        ;   fmt(M1, "The KB is locked. It is held by ~w since ~w. Only the holder can release it.", [Holder, Since]),
            die(2, [M1, "Fix: ask the holder, or take the lock with --take on a write."] >> fix_lines)
        )
    ;   State = bad(Why)
    ->  lock_bad(Dir, Why)
    ;   format("There is no writer lock.~n", []), Code = 0
    ).

% ---------------------------------------------------------------------
% The KB lock (D7)
% ---------------------------------------------------------------------
% with_kb_lock(+Dir, :Goal): run Goal with an exclusive flock(2) on
% Dir/kb.lock. flock(1) from util-linux takes the lock and keeps it
% while a child cat(1) reads a pipe from this process. The lock goes
% away when this process closes the pipe, and also when this process
% dies for any reason, so a stale lock cannot occur. If flock(1) is not
% on PATH (for example on macOS), the lock is an fcntl(2) lock that SWI
% takes on the same file. It has the same release rules.

with_kb_lock(Dir, Goal) :-
    directory_file_path(Dir, 'kb.lock', LockFile),
    setup_call_cleanup(kb_lock(LockFile, Lock),
                       once(Goal),
                       kb_unlock(Lock)).

kb_lock(LockFile, Lock) :-
    (   absolute_file_name(path(flock), Flock, [access(execute), file_errors(fail)])
    ->  catch(process_create(Flock, ['-x', LockFile, '-c', 'echo locked; exec cat'],
                             [stdin(pipe(In)), stdout(pipe(Out)), stderr(null), process(P)]),
              E, true),
        (   nonvar(E)
        ->  err_text(E, ET),
            die(2, ["Could not take the KB lock " + LockFile + ": " + ET] >> fix_lines)
        ;   read_line_to_string(Out, Line),
            close(Out),
            (   Line == "locked"
            ->  Lock = flock(P, In)
            ;   catch(close(In), _, true),
                catch(process_wait(P, _), _, true),
                die(2, ["Could not take the KB lock " + LockFile + ".",
                        "Fix: check that the KB directory is writable."] >> fix_lines)
            )
        )
    ;   catch(open(LockFile, append, S, [lock(write)]), E, true),
        (   nonvar(E)
        ->  err_text(E, ET),
            die(2, ["Could not take the KB lock " + LockFile + ": " + ET] >> fix_lines)
        ;   Lock = fcntl(S)
        )
    ).

kb_unlock(flock(P, In)) :-
    catch(close(In), _, true),
    catch(process_wait(P, _), _, true).
kb_unlock(fcntl(S)) :-
    catch(close(S), _, true).

kb_cmd(add, KB, Args, Code) :- cmd_add(KB, Args, Code).
kb_cmd(declare, KB, Args, Code) :- cmd_declare(KB, Args, Code).
kb_cmd(subject, KB, Args, Code) :- cmd_subject(KB, Args, Code).
kb_cmd(attest, KB, Args, Code) :- cmd_attest(KB, Args, Code).
kb_cmd(run, KB, Args, Code) :- cmd_run(KB, Args, Code).
kb_cmd(prove, KB, Args, Code) :- cmd_prove(KB, Args, Code).
kb_cmd(lint, KB, Args, Code) :- cmd_lint(KB, Args, Code).
kb_cmd(query, KB, Args, Code) :- cmd_query(KB, Args, false, Code).
kb_cmd(why, KB, Args, Code) :- cmd_query(KB, Args, true, Code).
kb_cmd(whynot, KB, Args, Code) :- cmd_whynot(KB, Args, Code).
kb_cmd(show, KB, Args, Code) :- cmd_show(KB, Args, Code).
kb_cmd(report, KB, Args, Code) :- cmd_report(KB, Args, Code).
kb_cmd(draft, KB, Args, Code) :- cmd_draft(KB, Args, Code).
kb_cmd('pin-item', KB, Args, Code) :- cmd_pin_item(KB, Args, Code).

% ---------------------------------------------------------------------
% Library and KB location
% ---------------------------------------------------------------------

lib_dir(Lib) :-
    lib_dir_candidate(Lib0, How),
    absolute_file_name(Lib0, Lib),
    directory_file_path(Lib, 'core.pl', Core),
    (   exists_file(Core)
    ->  true
    ;   die(2, [ "The orbit-kb library is missing.",
                 "No core.pl found in the library directory.",
                 "Library directory: " + Lib,
                 How,
                 "Fix: set ORBIT_KB_LIB to the directory that holds core.pl, or run ./install.py in the sagittarius repository."
               ] >> fix_lines)
    ).

lib_dir_candidate(Lib, "It comes from ORBIT_KB_LIB.") :-
    getenv('ORBIT_KB_LIB', Lib), Lib \== '', !.
lib_dir_candidate(Lib, "It is ../share/orbit-kb next to the real path of the orbit-kb script.") :-
    orbit_script(F),
    real_file(F, R),
    file_directory_name(R, D),
    file_directory_name(D, P),
    directory_file_path(P, 'share/orbit-kb', Lib).

% Turn a list that may hold "a" + B items into strings.
die_fix_lines(Ls0, Ls) :- maplist(fix_line, Ls0, Ls).
fix_line(A + B, S) :- !, fix_line(A, SA), fix_line(B, SB), string_concat(SA, SB, S).
fix_line(A, S) :- atom(A), !, atom_string(A, S).
fix_line(N, S) :- number(N), !, number_string(N, S).
fix_line(S, S).


real_file(F, R) :- real_file(F, 40, R).
real_file(F, N, R) :-
    N > 0,
    catch(read_link(F, _, T), _, fail),
    T \== F, !,
    N1 is N - 1,
    real_file(T, N1, R).
real_file(F, _, A) :- absolute_file_name(F, A).

resolve_kb(some(D), Dir) :- !,
    kb_dir_given(D, "--dir", Dir).
resolve_kb(none, Dir) :-
    getenv('ORBIT_KB', D), D \== '', !,
    kb_dir_given(D, "ORBIT_KB", Dir).
resolve_kb(none, Dir) :-
    working_directory(W, W),
    absolute_file_name(W, W0),
    ( W0 \== '/', atom_concat(W1, '/', W0) -> true ; W1 = W0 ),
    (   find_up(W1, Dir)
    ->  true
    ;   findall(L, ( find_down(W1, 2, Rel),
                     format(string(L), "A KB is below this directory, in ~w. To use it: orbit-kb --dir ~w COMMAND.", [Rel, Rel]) ),
                Below),
        append([ "No knowledge base found.",
                 "orbit-kb looks for a KB in this order:",
                 "1. the --dir DIR option;",
                 "2. the ORBIT_KB environment variable;",
                 "3. the nearest directory, from here upward, with a kb.pl that starts with uses([...])."
               ], Below, Ls0),
        append(Ls0, ["Fix: give --dir DIR, set ORBIT_KB, or create a KB with orbit-kb init DIR --request TEXT."], Ls),
        die(2, Ls)
    ).

% find_down(+Dir, +Depth, -Rel): a KB in a subdirectory of Dir, at most Depth levels
% down, as a path relative to Dir. Only for the hint when no KB is found: orbit-kb
% never uses a KB below the current directory on its own.
find_down(Dir, Depth, Rel) :-
    Depth > 0,
    catch(directory_files(Dir, Es), _, fail),
    msort(Es, Sorted),
    member(E, Sorted),
    \+ sub_atom(E, 0, 1, _, '.'),
    \+ memberchk(E, [runs, node_modules, '.lake']),
    directory_file_path(Dir, E, Sub),
    exists_directory(Sub),
    (   directory_file_path(Sub, 'kb.pl', F), exists_file(F), first_term_is_uses(F)
    ->  Rel = E
    ;   D1 is Depth - 1,
        find_down(Sub, D1, R0),
        directory_file_path(E, R0, Rel)
    ).

kb_dir_given(D, From, Dir) :-
    absolute_file_name(D, Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    (   exists_file(KbFile)
    ->  true
    ;   die(2, [ "No kb.pl in " + Dir + " (from " + From + ").",
                 "Fix: give a KB directory, or create one with orbit-kb init DIR --request TEXT."
               ] >> fix_lines)
    ).

find_up(D, D) :-
    directory_file_path(D, 'kb.pl', F),
    exists_file(F),
    first_term_is_uses(F), !.
find_up(D, R) :-
    file_directory_name(D, P),
    P \== D,
    find_up(P, R).

first_term_is_uses(F) :-
    catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]),
                             read_term(S, T, [module(orbit_ops)]),
                             close(S)),
          _, fail),
    nonvar(T), T = uses(_).

% ---------------------------------------------------------------------
% Reading sources
% ---------------------------------------------------------------------
% An item is it(Src, File, Line, Term, VarNames, From-To) or
% synerr(Src, File, Line, Message). Src is core, module(M), kb, rules,
% new (add), or test (doctor).

read_source_file(Src, File, Items) :-
    (   exists_file(File)
    ->  setup_call_cleanup(open(File, read, S, [encoding(utf8)]),
                           read_items(S, Src, File, Items),
                           close(S))
    ;   Items = []
    ).

read_source_string(Src, Name, Text, Items) :-
    setup_call_cleanup(open_string(Text, S),
                       read_items(S, Src, Name, Items),
                       close(S)).

read_items(S, Src, File, Items) :-
    character_count(S, C0),
    catch(read_term(S, T, [ module(orbit_ops), variable_names(VN),
                            term_position(P), subterm_positions(SP),
                            syntax_errors(error) ]),
          E, true),
    (   nonvar(E)
    ->  syntax_error_info(E, Line, Msg),
        Items = [synerr(Src, File, Line, Msg)|Rest],
        character_count(S, C1),
        (   ( C1 =< C0 ; at_end_of_stream(S) )
        ->  Rest = []
        ;   read_items(S, Src, File, Rest)
        )
    ;   T == end_of_file
    ->  Items = []
    ;   stream_position_data(line_count, P, Line),
        (   nonvar(SP), compound(SP)
        ->  arg(1, SP, From), arg(2, SP, To)
        ;   From = 0, To = 0
        ),
        Items = [it(Src, File, Line, T, VN, From-To)|Rest],
        read_items(S, Src, File, Rest)
    ).

syntax_error_info(error(syntax_error(M), Ctx), Line, Msg) :- !,
    (   compound(Ctx), Ctx = stream(_, L, _, _) -> Line = L
    ;   compound(Ctx), Ctx = file(_, L, _, _) -> Line = L
    ;   Line = 1
    ),
    syntax_msg(M, Msg).
syntax_error_info(E, 1, Msg) :- err_text(E, Msg).

syntax_msg(M, Msg) :-
    (   atom(M)
    ->  atomic_list_concat(Ps, '_', M), atomic_list_concat(Ps, ' ', M1)
    ;   term_string(M, M1)
    ),
    fmt(Msg, "Syntax error: ~w.", [M1]).

% Parse one term from a command-line argument. The full stop is
% optional. Result: ok(Term, VarNames) or err(Message).
parse_one(Text0, Result) :-
    atom_string(Text0, T1),
    normalize_space(string(T2), T1),
    (   T2 == ""
    ->  Result = err("The text is empty.")
    ;   (   sub_string(T2, _, 1, 0, ".")
        ->  string_concat(T2, "\n", T3)
        ;   string_concat(T2, " .\n", T3)
        ),
        catch(( open_string(T3, S),
                read_term(S, T, [module(orbit_ops), variable_names(VN), syntax_errors(error)]),
                read_term(S, T4, [module(orbit_ops), syntax_errors(error)]),
                close(S) ),
              E, true),
        (   nonvar(E)
        ->  ( E = error(syntax_error(M), _) -> syntax_msg(M, Msg) ; err_text(E, Msg) ),
            Result = err(Msg)
        ;   T == end_of_file
        ->  Result = err("The text is empty.")
        ;   T4 \== end_of_file
        ->  Result = err("The text holds more than one term. Give one term per argument.")
        ;   Result = ok(T, VN)
        )
    ).

% ---------------------------------------------------------------------
% Loading a KB
% ---------------------------------------------------------------------
% KB = kb(Dir, Lib, Uses, Items). Items are in program order: core,
% modules (in uses order), kb.pl, rules.pl.

load_kb(Dir, Lib, kb(Dir, Lib, Uses, Items)) :-
    directory_file_path(Dir, 'kb.pl', KbFile),
    read_source_file(kb, KbFile, KbItems),
    items_uses(KbItems, Uses),
    directory_file_path(Lib, 'core.pl', CoreFile),
    read_source_file(core, CoreFile, CoreItems),
    findall(MI, ( member(M, Uses),
                  module_file(Lib, M, MF),
                  exists_file(MF),
                  read_source_file(module(M), MF, MIs),
                  member(MI, MIs) ),
            ModItems),
    directory_file_path(Dir, 'rules.pl', RulesFile),
    read_source_file(rules, RulesFile, RuleItems),
    derived_items(Dir, KbItems, DerivedItems),
    append([CoreItems, ModItems, KbItems, RuleItems, DerivedItems], Items).

% derived_items(+Dir, +KbItems, -Items) (D10): facts that orbit-kb
% computes from the disk and the clock each time it reads the KB.
%   proof_changed(A)  proof A does not count: a file of the proof
%                     changed, or its log is missing or does not match.
%   waiver_lapsed(W)  the due time of waiver W is past, or it is not a
%                     valid time (D10 follow-up, F9).
%   demo_changed(S)   S is the subject of a demo/2 fact, and its file is
%                     missing or its sha256 differs from subject/3 (D21 F3b).
%   due_passed(X)     the due time of a due/2 fact is past, or it is not a
%                     valid time (D22).
% And from the supersedes/2 facts of kb.pl (D10 follow-up, S3):
%   supersedes_closure(New, Old)  New reaches Old through one or more
%                     supersedes facts.
%   supersede_cycle(C)  C reaches itself.
% Both engines see them as facts. The rules in core.pl and
% modules/build.pl read them, so no rule recurses through supersedes/2.
% An id that is not an atom still gets its fact (lint E3 reports it).
derived_items(Dir, KbItems, Items) :-
    findall(proof_changed(A),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T),
              T = attest(A, lean_proof, _, P, _, _), ground(A),
              \+ proof_state(Dir, A, P, ok) ),
            Ts1),
    utc_now(Now),
    findall(waiver_lapsed(W),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T),
              T = attest(W, waiver, _, Pred, _, _), ground(W),
              \+ ( nonvar(Pred), Pred = waive(_, Due, _), is_time(Due), \+ Due @< Now ) ),
            Ts2),
    supersede_derived(KbItems, Ts3),
    findall(demo_changed(S),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T), T = demo(S, _), atom(S),
              once(( member(it(kb, _, _, T2, _, _), KbItems), nonvar(T2), T2 = subject(S, Path, D0) )),
              atom(Path),
              ( is_absolute_file_name(Path) -> Abs = Path ; directory_file_path(Dir, Path, Abs) ),
              \+ ( exists_file(Abs), sha256_file(Abs, D1), D1 == D0 ) ),
            Ts40),
    sort(Ts40, Ts4),
    findall(due_passed(X),
            ( member(it(kb, _, _, T, _, _), KbItems), nonvar(T), T = due(X, Due), ground(X),
              \+ ( is_time(Due), \+ Due @< Now ) ),
            Ts50),
    sort(Ts50, Ts5),
    project_derived(Dir, KbItems, Ts6),
    append([Ts1, Ts2, Ts3, Ts4, Ts5, Ts6], Ts),
    findall(it(derived, '<derived>', 0, X, [], 0-0), member(X, Ts), Items).

% project_derived(+Dir, +KbItems, -Facts) (D23): the facts of the project module,
% for a KB that uses it.
%   subject_now(S, D)        the file of subject S exists, and its digest now is D.
%   decision_digest(X, D)    D is the sha256 of the text of decision X.
%   project_decision_digest(X, D)   the same, for a decision of the KB at project_kb/1.
%   project_conflict(Dr, X)  draft Dr of that KB is in conflict, and decision X
%                            rests on the pin of the draft.
project_derived(Dir, KbItems, Facts) :-
    items_uses(KbItems, Uses),
    memberchk(project, Uses),
    !,
    findall(subject_now(S, D),
            ( kb_term(KbItems, subject(S, Path, _)), atom(S), atom(Path),
              ( is_absolute_file_name(Path) -> Abs = Path ; directory_file_path(Dir, Path, Abs) ),
              exists_file(Abs), sha256_file(Abs, D) ),
            F1),
    findall(decision_digest(X, D),
            ( kb_term(KbItems, decision(X, Text)), atom(X), atomic(Text), sha256_text(Text, D) ),
            F2),
    (   kb_term(KbItems, project_kb(P)), atom(P),
        \+ nb_current(orbit_project_depth, 1)
    ->  setup_call_cleanup(nb_setval(orbit_project_depth, 1),
                           ( catch(project_kb_facts(Dir, P, F3), _, fail) -> true ; F3 = [] ),
                           nb_setval(orbit_project_depth, 0))
    ;   F3 = []
    ),
    append([F1, F2, F3], Facts).
project_derived(_, _, []).

kb_term(KbItems, T) :-
    member(it(kb, _, _, T0, _, _), KbItems), nonvar(T0), T0 = T.

project_kb_facts(Dir, P, Facts) :-
    ( is_absolute_file_name(P) -> PDir = P ; directory_file_path(Dir, P, PDir) ),
    directory_file_path(PDir, 'kb.pl', PFile),
    exists_file(PFile),
    absolute_file_name(PDir, A1), absolute_file_name(Dir, A2),
    A1 \== A2,
    nb_setval(orbit_project_depth, 1),
    lib_dir(Lib),
    read_source_file(kb, PFile, PItems),
    items_uses(PItems, PUses),
    memberchk(project, PUses),
    findall(project_decision_digest(X, D),
            ( kb_term(PItems, decision(X, Text)), atom(X), atomic(Text), sha256_text(Text, D) ),
            F1),
    load_kb(PDir, Lib, PKB),
    kb_items(PKB, AllItems), items_decls(AllItems, Ds),
    build_engine(AllItems, Ds, Eng),
    swi_raw(Eng, (conflict(Dr), draft(Dr, Pn, Tx, _), concerns(X, Pn)), t(Dr, X, Tx), Res),
    (   Res = answers(L, _)
    ->  findall(project_conflict(Dr, X), member(t(Dr, X, _), L), F2a),
        findall(project_draft_text(Dr, Tx), member(t(Dr, _, Tx), L), F2b0),
        sort(F2b0, F2b),
        append(F2a, F2b, F2)
    ;   F2 = []
    ),
    (   project_unclean(PKB) -> F3 = [project_kb_unclean] ; F3 = [] ),
    append([F1, F2, F3], Facts).

% The project KB does not load clean: lint finds an error in it (D23).
project_unclean(PKB) :-
    catch(( lint_diags(PKB, Diags, _, IssueErrors),
            (   IssueErrors > 0
            ;   member(diag(C, _, _, _), Diags), sub_atom(C, 0, 1, _, 'E')
            ) ), _, true),
    !.

% supersede_derived(+KbItems, -Facts): the supersedes_closure/2 and
% supersede_cycle/1 facts of the ground supersedes/2 facts.
supersede_derived(KbItems, Facts) :-
    supersede_edges(KbItems, Edges),
    supersede_closure(Edges, Pairs),
    findall(supersedes_closure(N, O), member(N-O, Pairs), F1),
    findall(supersede_cycle(C), member(C-C, Pairs), F2),
    append(F1, F2, Facts).

supersede_edges(Items, Edges) :-
    findall(N-O, ( member(it(Src, _, _, T, _, _), Items), ( Src == kb ; Src == new ),
                   nonvar(T), T = supersedes(N, O), ground(N-O) ),
            Edges0),
    sort(Edges0, Edges).

% supersede_closure(+Edges, -Pairs): the sorted pairs N-O such that a
% path of one or more edges leads from N to O. A depth-first search from
% each source, so it ends on every graph, also with cycles.
supersede_closure(Edges, Pairs) :-
    findall(N, member(N-_, Edges), Ns0),
    sort(Ns0, Ns),
    findall(N-O, ( member(N, Ns), reach_from(Edges, N, Os), member(O, Os) ), Pairs0),
    sort(Pairs0, Pairs).

reach_from(Edges, N, Os) :-
    findall(M, member(N-M, Edges), Next),
    reach_walk(Next, Edges, [], Os0),
    sort(Os0, Os).

reach_walk([], _, Seen, Seen).
reach_walk([X|Xs], Edges, Seen, Out) :-
    (   memberchk(X, Seen)
    ->  reach_walk(Xs, Edges, Seen, Out)
    ;   findall(M, member(X-M, Edges), Next),
        append(Next, Xs, Todo),
        reach_walk(Todo, Edges, [X|Seen], Out)
    ).

kb_dir(kb(D, _, _, _), D).
kb_lib(kb(_, L, _, _), L).
kb_uses(kb(_, _, U, _), U).
kb_items(kb(_, _, _, I), I).

module_file(Lib, M, F) :-
    atom(M),
    format(atom(Rel), "modules/~w.pl", [M]),
    directory_file_path(Lib, Rel, F).

lib_modules(Lib, Ms) :-
    directory_file_path(Lib, modules, MD),
    (   exists_directory(MD)
    ->  directory_files(MD, Fs),
        findall(M, ( member(F, Fs), file_name_extension(M, pl, F), M \== '' ), Ms0),
        msort(Ms0, Ms)
    ;   Ms = []
    ).

items_uses(Items, Uses) :-
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = uses(L),
        is_list(L), maplist(atom, L)
    ->  Uses = L
    ;   Uses = []
    ).

kb_file(KB, F) :- kb_dir(KB, D), directory_file_path(D, 'kb.pl', F).

% All declarations in the library (core and every module) plus the
% local ones. Used by declare to refuse names declared anywhere.
% The core and the modules in uses/1 are already in the KB items, so
% only the other modules are read here.
all_known_items(KB, Items) :-
    kb_lib(KB, Lib),
    kb_items(KB, KI),
    include(src_is(core), KI, CoreItems),
    lib_modules(Lib, Ms),
    kb_uses(KB, Uses),
    findall(MI, ( member(M, Ms),
                  (   memberchk(M, Uses)
                  ->  member(MI, KI), src_is(module(M), MI)
                  ;   module_file(Lib, M, MF),
                      read_source_file(module(M), MF, MIs), member(MI, MIs)
                  ) ),
            ModItems),
    include(src_is(kb), KI, Local),
    append([CoreItems, ModItems, Local], Items).

src_is(S, it(S, _, _, _, _, _)).

% ---------------------------------------------------------------------
% Declarations
% ---------------------------------------------------------------------
% d(Name, Arity, Kind, Types, Doc, Template, Src, File, Line)
% at(Type, Shape, Writers, Doc, Src, File, Line)

items_decls(Items, Ds) :-
    findall(d(N, A, K, Ts, Doc, Tpl, Src, F, L),
            ( member(it(Src, F, L, T, _, _), Items),
              nonvar(T), T = decl(K, H, Doc, Tpl),
              callable(H), H \= -(_),
              H =.. [N|Ts], length(Ts, A) ),
            Ds).

items_atypes(Items, As) :-
    findall(at(T, S, W, Doc, Src, F, L),
            ( member(it(Src, F, L, X, _, _), Items),
              nonvar(X), X = attest_type(T, S, W, Doc) ),
            As).

decl_of(Ds, N, A, D) :-
    D = d(N, A, _, _, _, _, _, _, _),
    memberchk(D, Ds).

atype_of(As, T, X) :-
    X = at(T, _, _, _, _, _, _),
    memberchk(X, As).

meta_term(T) :- nonvar(T), ( T = uses(_) ; T = decl(_, _, _, _) ; T = attest_type(_, _, _, _) ), !.

% Two facts in one argument parse as one ','/2 term.
undeclared_msg(_, ',', 2, M) :- !,
    M = "Two or more facts are joined with a comma in one argument. Give each fact as its own argument: orbit-kb add 'f(a)' 'g(b)'.".
undeclared_msg(Ds, N, A, M) :-
    findall(A2, ( member(d(N, A2, _, _, _, _, _, _, _), Ds), A2 \== A ), As0),
    sort(As0, As),
    (   As == []
    ->  fmt(M, "~q/~w is not declared.", [N, A])
    ;   atomic_list_concat(As, ' and ', AT),
        fmt(M, "~q/~w is not declared. ~q is declared with arity ~w.", [N, A, N, AT])
    ).

src_text(core, "the core") :- !.
src_text(module(M), S) :- !, fmt(S, "module ~w", [M]).
src_text(kb, "kb.pl") :- !.
src_text(rules, "rules.pl") :- !.
src_text(derived, "orbit-kb (computed when it reads the KB)") :- !.
src_text(S, T) :- fmt(T, "~w", [S]).

% ---------------------------------------------------------------------
% Types
% ---------------------------------------------------------------------

simple_type(T) :- memberchk(T, [id, ref, text, atom, int, time, digest, by, term, attest_predicate]).

is_type_term(T) :- atom(T), !, simple_type(T).
is_type_term(T) :- compound(T), ( T = ref(_) ; T = oneof(_) ; T = alt(_) ), !.

% type_errs(+Type, +FactNames, -Errors): Errors is a list of strings.
type_errs(T, _, ["A type is a variable."]) :- var(T), !.
type_errs(T, _, []) :- atom(T), simple_type(T), !.
type_errs(ref(Ns), K, Es) :- is_list(Ns), !,
    (   Ns \== [], maplist(atom, Ns)
    ->  findall(E, ( member(N, Ns), \+ memberchk(N, K),
                     fmt(E, "ref(~q) names ~q, which is no declared fact predicate.", [Ns, N]) ), Es)
    ;   Es = ["ref([...]) needs a list of fact names, such as ref([claim, check])."]
    ).
type_errs(ref(N), K, Es) :- !,
    (   atom(N), memberchk(N, K)
    ->  Es = []
    ;   fmt(E, "ref(~q) names no declared fact predicate.", [N]), Es = [E]
    ).
type_errs(oneof(L), _, Es) :- !,
    (   is_list(L), L \== [], maplist(atom, L)
    ->  Es = []
    ;   Es = ["oneof needs a list of atoms, such as oneof([low, high])."]
    ).
type_errs(alt(L), K, Es) :- !,
    (   is_list(L), L \== []
    ->  findall(E, ( member(S, L), entry_errs(S, K, E1), member(E, E1) ), Es)
    ;   Es = ["alt needs a list of shapes, such as alt([none, some(text)])."]
    ).
type_errs(T, _, [E]) :-
    term_text(T, S),
    fmt(E, "~w is not a known type. The known types are id, ref(Name), ref([Name, ...]), ref, oneof([...]), alt([...]), text, atom, int, time, digest, by, and term.", [S]).

entry_errs(S, _, ["A shape is a variable."]) :- var(S), !.
entry_errs(S, _, []) :- atom(S), !.
entry_errs(S, K, Es) :- compound(S), !,
    S =.. [_|Ts],
    findall(E, ( member(T, Ts), type_errs(T, K, E1), member(E, E1) ), Es).
entry_errs(S, _, [E]) :-
    term_text(S, T),
    fmt(E, "~w is not a valid shape. Use an atom or a compound whose arguments are types.", [T]).

shape_errs(S, K, Es) :-
    (   nonvar(S), is_type_term(S)
    ->  type_errs(S, K, Es)
    ;   entry_errs(S, K, Es)
    ).

% Value checks. env(Ids, FirstArgs): Ids is the sorted list of all
% id values; FirstArgs is a sorted list of Name-FirstArg.
% val_errs(+Type, +Value, +Env, -Errors): Errors is a list of Code-Text.

val_errs(_, V, _, []) :- var(V), !.
val_errs(_, V, _, ['E3'-"It is a double-quoted string. Write text in single quotes, such as 'text'."]) :-
    string(V), !.
val_errs(id, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("an id (an atom)", V, Es) ).
val_errs(text, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("text in single quotes", V, Es) ).
val_errs(atom, V, _, Es) :- !, ( atom(V) -> Es = [] ; bad_value("an atom", V, Es) ).
val_errs(int, V, _, Es) :- !, ( integer(V) -> Es = [] ; bad_value("an integer", V, Es) ).
val_errs(time, V, _, Es) :- !, ( is_time(V) -> Es = [] ; bad_value("a valid UTC time such as '2026-10-15T12:00:00Z' (month 01-12, a day of that month, hour 00-23, minute and second 00-59)", V, Es) ).
val_errs(digest, V, _, Es) :- !, ( is_digest(V) -> Es = [] ; bad_value("a digest 'sha256:' plus 64 lowercase hex characters", V, Es) ).
val_errs(by, V, _, Es) :- !, ( memberchk(V, [human, agent, script]) -> Es = [] ; bad_value("human, agent, or script", V, Es) ).
val_errs(term, V, _, Es) :- !,
    (   has_string(V)
    ->  Es = ['E3'-"It holds a double-quoted string. Write text in single quotes."]
    ;   Es = []
    ).
val_errs(attest_predicate, _, _, []) :- !.
val_errs(ref, V, env(_, _, IdA, _), Es) :- !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   get_assoc(V, IdA, _)
    ->  Es = []
    ;   fmt(M, "~q is not an existing id. This argument names an id that another fact defines (a claim, a question, the request); it does not create one. For example, attach a note with note(c1, '...') or note(r1, '...'). Add the fact that defines ~q first, or use an existing id.", [V, V]),
        Es = ['E4'-M]
    ).
% ref([N1, N2, ...]) (D13): the id of a fact of any one of the names.
val_errs(ref(Ns), V, env(_, _, _, FAA), Es) :- is_list(Ns), !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   member(N, Ns), get_assoc(N-V, FAA, _)
    ->  Es = []
    ;   kinds_text(Ns, KT),
        fmt(M, "~q is not the id of any ~w fact. It must be the id of a ~w. Add that fact first, or fix the id.", [V, KT, KT]),
        Es = ['E4'-M]
    ).
val_errs(ref(N), V, env(_, _, _, FAA), Es) :- !,
    (   \+ atom(V)
    ->  bad_value("an id (an atom)", V, Es)
    ;   get_assoc(N-V, FAA, _)
    ->  Es = []
    ;   fmt(M, "~q is not the id of any ~q fact. Add the ~q fact first, or fix the id.", [V, N, N]),
        Es = ['E4'-M]
    ).
val_errs(oneof(L), V, _, Es) :- !,
    (   atom(V), memberchk(V, L)
    ->  Es = []
    ;   atomic_list_concat(L, ', ', LT),
        term_text(V, VT),
        fmt(M, "The label must be one of: ~w. It is ~w.", [LT, VT]),
        Es = ['E3'-M]
    ).
val_errs(alt(Entries), V, Env, Es) :- !,
    (   member(E, Entries), atom(E), V == E
    ->  Es = []
    ;   compound(V), compound_name_arity(V, Nm, Ar),
        member(E, Entries), compound(E), compound_name_arity(E, Nm, Ar)
    ->  E =.. [_|Ts], V =.. [_|Vs],
        args_errs(Ts, Vs, Env, Es)
    ;   maplist(term_text, Entries, ETs),
        atomic_list_concat(ETs, ', ', J),
        term_text(V, VT),
        (   bare_label_example(Entries, V, Ex)
        ->  term_text(Ex, ExT),
            fmt(M, "It must match one of: ~w. It is ~w. The label ~w takes an argument: write ~w.", [J, VT, V, ExT])
        ;   fmt(M, "It must match one of: ~w. It is ~w.", [J, VT])
        ),
        Es = ['E3'-M]
    ).
val_errs(T, _, _, ['E3'-M]) :-
    term_text(T, TT),
    fmt(M, "Its declared type ~w is unknown.", [TT]).

% bare_label_example(+Entries, +V, -Example): V is an atom that names a compound
% entry of an alt, such as refuted for refuted(text). Example is that entry with
% a sample argument in each place, such as refuted('the counterexample').
bare_label_example(Entries, V, Ex) :-
    atom(V),
    member(E, Entries), compound(E), compound_name_arity(E, V, _), !,
    E =.. [_|Ts],
    maplist(sample_arg(V), Ts, As),
    Ex =.. [V|As].

sample_arg(refuted, text, 'the counterexample') :- !.
sample_arg(_, text, 'some text') :- !.
sample_arg(_, int, 1) :- !.
sample_arg(_, ref([N|_]), N) :- !.
sample_arg(_, ref(N), N) :- !.
sample_arg(_, T, T).

% bare_label_whole(+Shape, +Pred, -Whole): Pred has a bare label where Shape wants
% an alt entry with arguments. Whole is Pred with a sample in that place.
bare_label_whole(S, V, Whole) :-
    compound(S), compound(V),
    S =.. [N|Ts], V =.. [N|Vs],
    nth1(I, Ts, alt(Entries)), nth1(I, Vs, Bare),
    bare_label_example(Entries, Bare, Ex),
    nth1(I, Vs, Bare, Rest), nth1(I, Vs2, Ex, Rest),
    Whole =.. [N|Vs2].

shape_val_errs(_, V, _, []) :- var(V), !.
shape_val_errs(S, V, Env, Es) :- is_type_term(S), !, val_errs(S, V, Env, Es).
shape_val_errs(S, V, _, Es) :- atom(S), !,
    (   V == S
    ->  Es = []
    ;   term_text(V, VT), fmt(M, "It must be ~q. It is ~w.", [S, VT]), Es = ['E3'-M]
    ).
shape_val_errs(S, V, Env, Es) :- compound(S), !,
    compound_name_arity(S, N, A),
    (   compound(V), compound_name_arity(V, N, A)
    ->  S =.. [_|Ts], V =.. [_|Vs],
        args_errs(Ts, Vs, Env, Es0),
        (   Es0 \== [], bare_label_whole(S, V, Whole)
        ->  term_text(Whole, WT),
            fmt(HM, "Write the whole predicate as ~w.", [WT]),
            append(Es0, ['E3'-HM], Es)
        ;   Es = Es0
        )
    ;   term_text(S, ST), term_text(V, VT),
        (   inner_label_whole(S, V, WT)
        ->  fmt(M, "It must have the form ~w. It is ~w. Write the whole predicate as ~w.", [ST, VT, WT])
        ;   fmt(M, "It must have the form ~w. It is ~w.", [ST, VT])
        ),
        Es = ['E3'-M]
    ).
shape_val_errs(_, _, _, ['E3'-"The attestation type has an invalid shape."]).

% inner_label_whole(+Shape, +Pred, -Text): Pred is only one entry of an alt inside Shape,
% such as tested(100) for verdict(ref(claim), alt([..., tested(int)])). Text is the whole
% predicate, with each ref argument as a placeholder: verdict(CLAIM, tested(100)).
inner_label_whole(S, V, Text) :-
    compound(S), S =.. [N|Ts],
    nth1(I, Ts, alt(Entries)), member(E, Entries), same_entry_shape(E, V), !,
    findall(A, ( nth1(J, Ts, T),
                 (   J == I -> term_text(V, A)
                 ;   T = ref(K), atom(K) -> upcase_atom(K, A)
                 ;   term_text(T, A)
                 ) ), As),
    atomic_list_concat(As, ', ', Inner),
    fmt(Text, "~w(~w)", [N, Inner]).

same_entry_shape(E, V) :- atom(E), !, E == V.
same_entry_shape(E, V) :- compound(E), compound(V),
    compound_name_arity(E, F, A), compound_name_arity(V, F, A).

args_errs(Ts, Vs, Env, Es) :-
    findall(C-M, ( nth1(I, Ts, T), nth1(I, Vs, V),
                   val_errs(T, V, Env, Es1), member(C-M0, Es1),
                   fmt(M, "In argument ~w: ~w", [I, M0]) ),
            Es).

% kinds_text(+Names, -Text): "claim, check, or question".
kinds_text([N], T) :- !, fmt(T, "~w", [N]).
kinds_text([A, B], T) :- !, fmt(T, "~w or ~w", [A, B]).
kinds_text(Ns, T) :-
    append(Init, [Last], Ns),
    atomic_list_concat(Init, ', ', IT),
    fmt(T, "~w, or ~w", [IT, Last]).

bad_value(What, V, ['E3'-M]) :-
    term_text(V, VT),
    fmt(M, "It must be ~w. It is ~w.", [What, VT]).

has_string(V) :- string(V), !.
has_string(V) :- compound(V), arg(_, V, A), has_string(A), !.

% is_time(+A): A is a UTC time YYYY-MM-DDTHH:MM:SSZ with real values:
% month 1-12, a day of that month (leap years too), hour 0-23, minute
% and second 0-59 (D10 follow-up, F10).
is_time(A) :-
    atom(A),
    atom_codes(A, Cs),
    Cs = [Y1, Y2, Y3, Y4, 0'-, M1, M2, 0'-, D1, D2, 0'T, H1, H2, 0':, I1, I2, 0':, S1, S2, 0'Z],
    maplist(is_digit_code, [Y1, Y2, Y3, Y4, M1, M2, D1, D2, H1, H2, I1, I2, S1, S2]),
    number_codes(Y, [Y1, Y2, Y3, Y4]), number_codes(Mo, [M1, M2]), number_codes(D, [D1, D2]),
    number_codes(H, [H1, H2]), number_codes(Mi, [I1, I2]), number_codes(S, [S1, S2]),
    between(1, 12, Mo),
    month_days(Y, Mo, MD), between(1, MD, D),
    between(0, 23, H), between(0, 59, Mi), between(0, 59, S).

month_days(Y, 2, D) :- !, ( leap_year(Y) -> D = 29 ; D = 28 ).
month_days(_, M, 30) :- memberchk(M, [4, 6, 9, 11]), !.
month_days(_, _, 31).

leap_year(Y) :- Y mod 4 =:= 0, ( Y mod 100 =\= 0 -> true ; Y mod 400 =:= 0 ).

is_digit_code(C) :- integer(C), C >= 0'0, C =< 0'9.

is_digest(A) :-
    atom(A),
    atom_concat('sha256:', Hex, A),
    atom_length(Hex, 64),
    atom_codes(Hex, Cs),
    forall(member(C, Cs), ( is_digit_code(C) ; ( C >= 0'a, C =< 0'f ) )).

% ---------------------------------------------------------------------
% Facts in kb.pl
% ---------------------------------------------------------------------

fact_item(it(Src, _, _, T, _, _)) :-
    ( Src == kb ; Src == new ),
    \+ meta_term(T).

pos_fact(T) :-
    nonvar(T), callable(T),
    T \= -(_), T \= (_ :- _), T \= (:- _), T \= #(_).

% env(Ids, FirstArgs, IdAssoc, FirstArgAssoc): the lists, and the same
% sets as AVL trees for O(log n) lookups.
build_env(FactItems, Ds, env(Ids, FA, IdA, FAA)) :-
    findall(V, ( member(it(_, _, _, T, _, _), FactItems), pos_fact(T),
                 id_value(T, Ds, V) ),
            Ids0),
    sort(Ids0, Ids),
    findall(N-V, ( member(it(_, _, _, T, _, _), FactItems), pos_fact(T),
                   compound(T), T =.. [N, V|_], atom(V) ),
            FA0),
    sort(FA0, FA),
    set_assoc(Ids, IdA),
    set_assoc(FA, FAA).

set_assoc(Sorted, A) :-
    findall(K-t, member(K, Sorted), Ps),
    ord_list_to_assoc(Ps, A).

id_value(T, Ds, V) :-
    functor(T, N, A),
    A > 0,
    decl_of(Ds, N, A, d(_, _, fact, Ts, _, _, _, _, _)),
    nth1(I, Ts, id),
    arg(I, T, V),
    atom(V).

% fctx(KB, Decls, AttestTypes, Env)
fact_diags(_, it(_, F, L, T, _, _), [diag('E2', F, L, "This term is a variable, not a fact.")]) :-
    var(T), !.
fact_diags(_, it(_, F, L, (_ :- _), _, _),
           [diag('E7', F, L, "This is a rule. Rules belong in rules.pl, not in kb.pl.")]) :- !.
fact_diags(_, it(_, _, _, (:- _), _, _), []) :- !.    % E17
fact_diags(_, it(_, _, _, #(_), _, _), []) :- !.       % E17
fact_diags(Ctx, it(_, F, L, T, _, _), Diags) :-
    (   T = -(P), callable(P) -> Neg = true ; P = T, Neg = false ),
    (   \+ callable(P)
    ->  Diags = [diag('E2', F, L, "This is not a fact. A fact is a name with arguments, such as claim(c1, preserve, 'Text').")]
    ;   functor(P, N, A),
        Ctx = fctx(KB, Ds, ATs, Env),
        (   \+ decl_of(Ds, N, A, _)
        ->  (   unused_module_decl(KB, N, A, Mod)
            ->  fmt(M, "~q/~w is declared in module ~w, which this KB does not use. Add the module first: orbit-kb uses ~w.", [N, A, Mod, Mod])
            ;   undeclared_msg(Ds, N, A, M0),
                fmt(M, "~w Declare it with orbit-kb declare, or fix the name.", [M0])
            ),
            Diags = [diag('E2', F, L, M)]
        ;   decl_of(Ds, N, A, d(_, _, Kind, Ts, _, _, _, _, _)),
            (   Kind == rule
            ->  fmt(M, "~q/~w is a rule predicate. Rules compute it, so it cannot be a fact in kb.pl. Remove the fact, or write a rule in rules.pl.", [N, A]),
                Diags = [diag('E7', F, L, M)]
            ;   ( ground(T) -> G6 = [] ;
                  G6 = [diag('E6', F, L, "The fact has variables. Every fact must be ground. Replace each variable with a value.")] ),
                findall(diag(C, F, L, M),
                        ( nth1(I, Ts, Ty), arg(I, P, V),
                          val_errs(Ty, V, Env, Es), member(C-M0, Es),
                          fmt(M, "~q/~w argument ~w: ~w", [N, A, I, M0]) ),
                        GA),
                (   N/A == attest/6, Neg == false
                ->  attest_diags(KB, ATs, Env, P, F, L, GT)
                ;   GT = []
                ),
                (   N/A == supersedes/2, Neg == false
                ->  supersedes_kind_diags(Env, P, F, L, GS)
                ;   GS = []
                ),
                append([G6, GA, GT, GS], Diags)
            )
        )
    ).

% unused_module_decl(+KB, +N, +A, -Module) (D22): N/A is declared in a
% library module that the KB does not use.
unused_module_decl(KB, N, A, M) :-
    kb_lib(KB, Lib), kb_uses(KB, Uses),
    lib_modules(Lib, Ms),
    member(M, Ms), \+ memberchk(M, Uses),
    module_file(Lib, M, MF),
    read_source_file(module(M), MF, MIs),
    items_decls(MIs, MDs),
    decl_of(MDs, N, A, _), !.

% supersedes_kind_diags(+Env, +Fact, +F, +L, -Diags) (D15): supersedes/2 has the
% type ref in core.pl, because core.pl cannot name the discovery fact
% hypothesis/3. Here each side must be a claim or a hypothesis, and both sides
% the same kind. An id that does not exist is E4 of the ref type already.
supersedes_kind_diags(env(_, _, IdA, FAA), supersedes(N, O), F, L, Diags) :-
    findall(diag('E4', F, L, M),
            ( nth1(I, [N, O], X), atom(X), get_assoc(X, IdA, _),
              \+ sup_kind(FAA, X, _),
              fmt(M, "supersedes/2 argument ~w: ~q is not the id of a claim or a hypothesis. supersedes takes two claims, or two hypotheses (discovery module). Fix the id.", [I, X]) ),
            D1),
    (   sup_kind(FAA, N, KN), sup_kind(FAA, O, KO), KN \== KO
    ->  fmt(M2, "supersedes/2: ~q is a ~w and ~q is a ~w. A claim cannot replace a hypothesis, and a hypothesis cannot replace a claim. To reword a hypothesis, add a new hypothesis, then supersedes(NewHypothesis, ~q).", [N, KN, O, KO, O]),
        D2 = [diag('E4', F, L, M2)]
    ;   D2 = []
    ),
    append(D1, D2, Diags).

sup_kind(FAA, X, claim) :- atom(X), get_assoc(claim-X, FAA, _), !.
sup_kind(FAA, X, hypothesis) :- atom(X), get_assoc(hypothesis-X, FAA, _).

attest_diags(KB, ATs, Env, Fact0, F, L, Diags) :-
    Fact0 = attest(_, Type, _, Pred, By, _),
    (   \+ atom(Type)
    ->  Diags = []                       % reported as a type error already
    ;   \+ atype_of(ATs, Type, _)
    ->  fmt(M, "~q is not a declared attestation type. Use a type that orbit-kb help core or a module topic lists, or fix the type.", [Type]),
        Diags = [diag('E3', F, L, M)]
    ;   atype_of(ATs, Type, at(_, Shape, Writers, _, _, _, _)),
        shape_val_errs(Shape, Pred, Env, Es),
        findall(diag(C, F, L, M),
                ( member(C-M0, Es),
                  fmt(M, "attest/6 argument 4 (the predicate of type ~q): ~w", [Type, M0]) ),
                D1),
        (   atom(By), is_list(Writers), \+ memberchk(By, Writers)
        ->  atomic_list_concat(Writers, ', ', WT),
            (   Writers == [script]
            ->  script_cmd(Type, SC),
                fmt(M8, "Type ~q allows only the writer script. Only ~w writes it. This attestation is by ~q.", [Type, SC, By])
            ;   fmt(M8, "Type ~q allows only these writers: ~w. This attestation is by ~q. Change the writer, or use another type.", [Type, WT, By])
            ),
            D2 = [diag('E8', F, L, M8)]
        ;   D2 = []
        ),
        (   Type == test_result, nonvar(Pred), Pred = result(K, RN, R),
            atom(K), integer(RN), atom(R),
            \+ run_log_ok(KB, K, RN, R)
        ->  fmt(M9, "No run log matches this test result. Expected runs/~w-~w.log with result=~w in its first line. Only orbit-kb run writes test results.", [RN, K, R]),
            D3 = [diag('E9', F, L, M9)]
        ;   Type == lean_proof, nonvar(Pred), Pred = proof(_, _),
            arg(1, Fact0, Id), atom(Id), kb_dir(KB, Dir),
            \+ proof_log_matches(Dir, Id, Pred)
        ->  fmt(M9, "No proof log matches this lean_proof. Expected runs/proof-~w.log with the same claim and digest in its first line. Only orbit-kb prove writes proofs.", [Id]),
            D3 = [diag('E9', F, L, M9)]
        ;   D3 = []
        ),
        append([D1, D2, D3], Diags)
    ).

% script_cmd(+Type, -Command): the command that writes a script-only type.
script_cmd(lean_proof, "orbit-kb prove") :- !.
script_cmd(_, "orbit-kb run").

run_log_path(KB, K, N, P) :-
    kb_dir(KB, Dir),
    format(atom(Rel), "runs/~w-~w.log", [N, K]),
    directory_file_path(Dir, Rel, P).

run_log_ok(KB, K, N, R) :-
    run_log_path(KB, K, N, P),
    exists_file(P),
    setup_call_cleanup(open(P, read, S, [encoding(utf8)]),
                       read_line_to_string(S, Line),
                       close(S)),
    string(Line),
    split_string(Line, " ", "", Parts),
    Parts = ["%", "orbit-kb", "run", NS, CS, RS|_],
    number_string(N, NS),
    fmt(CS0, "check=~w", [K]), CS == CS0,
    fmt(RS0, "result=~w", [R]), RS == RS0.

% E15 (D10 follow-up, S2): each supersedes/2 fact on a cycle. A claim
% that replaces itself, directly or through other claims, is not
% current, so its burn would close with no proof.
e15_diags(FactItems, Diags) :-
    supersede_edges(FactItems, Edges),
    supersede_closure(Edges, Pairs),
    findall(diag('E15', F, L, M),
            ( member(it(_, F, L, T, _, _), FactItems), nonvar(T),
              T = supersedes(N, O), ground(N-O),
              ord_memberchk(O-N, Pairs),
              sup_kind_words(FactItems, N, One, Many),
              (   N == O
              ->  fmt(M, "supersedes(~q, ~q): a ~w cannot replace itself. Remove this fact. done is false while a supersede cycle exists.", [N, O, One])
              ;   fmt(M, "supersedes(~q, ~q) is part of a supersede cycle: ~q also replaces ~q, directly or through other ~w. A ~w cannot replace itself. Remove one supersedes fact of the cycle. done is false while the cycle exists.", [N, O, O, N, Many, One])
              ) ),
            Diags).

% sup_kind_words(+FactItems, +Id, -One, -Many): "hypothesis" and "hypotheses"
% when Id is a hypothesis (D15), else "claim" and "claims".
sup_kind_words(FactItems, X, "hypothesis", "hypotheses") :-
    member(it(_, _, _, T, _, _), FactItems), nonvar(T), T = hypothesis(Y, _, _), Y == X, !.
sup_kind_words(_, _, "claim", "claims").

% E5 over the facts in order. Only diagnostics at a later item.
e5_diags(FactItems, Ds, Diags) :-
    empty_assoc(Seen),
    e5_walk(FactItems, Ds, Seen, Diags).

e5_walk([], _, _, []).
e5_walk([it(Src, F, L, T, _, _)|Is], Ds, Seen, Diags) :-
    (   pos_fact(T)
    ->  findall(V, id_value(T, Ds, V), Vs)
    ;   Vs = []
    ),
    e5_vals(Vs, F, L, Seen, Seen1, D1),
    e5_walk(Is, Ds, Seen1, D2),
    _ = Src,
    append(D1, D2, Diags).

e5_vals([], _, _, S, S, []).
e5_vals([V|Vs], F, L, Seen, Seen2, Diags) :-
    (   get_assoc(V, Seen, F0:L0)
    ->  show_loc(F0, L0, LT),
        fmt(M, "The id ~q is already used at ~w. Each id must be unique. Choose a new id.", [V, LT]),
        show_loc(F, L, LT2),
        fmt(M0, "The id ~q is used again at ~w. Each id must be unique. Give one of them a new id.", [V, LT2]),
        Diags = [diag('E5', F0, L0, M0), diag('E5', F, L, M)|Ds1],
        Seen1 = Seen
    ;   Diags = Ds1,
        put_assoc(V, Seen, F:L, Seen1)
    ),
    e5_vals(Vs, F, L, Seen1, Seen2, Ds1).

:- dynamic show_base/1.
show_loc(F, L, T) :-
    show_file(F, FT),
    fmt(T, "~w:~w", [FT, L]).
show_file(F, FT) :-
    (   show_base(B), atom(F), atom_concat(B, '/', BP), atom_concat(BP, R, F)
    ->  FT = R
    ;   FT = F
    ).

% ---------------------------------------------------------------------
% Rules: E2, E7, W6, E14
% ---------------------------------------------------------------------

builtin_goal(G) :-
    callable(G),
    functor(G, N, A),
    memberchk(N/A, ['='/2, '\\='/2, '<'/2, '>'/2, '=<'/2, '>='/2, is/2,
                    true/0, false/0, forall/2,
                    '=='/2, '\\=='/2, '@<'/2, '@>'/2, '@=<'/2, '@>='/2]).

% body_goals(+Body, -Goals): the literals of a body, with not and -
% unwrapped. forall/2 stays, and its parts are added too.
body_goals(G, [G]) :- var(G), !.
body_goals((A, B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals((A ; B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals((A -> B), Gs) :- !, body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals(not(G), Gs) :- !, body_goals(G, Gs).
body_goals(-(G), Gs) :- callable(G), !, body_goals(G, Gs).
body_goals(forall(A, B), [forall(A, B)|Gs]) :- !,
    body_goals(A, GA), body_goals(B, GB), append(GA, GB, Gs).
body_goals(G, [G]).

clause_parts((H :- B), H, B) :- !.
clause_parts((:- B), none, B) :- !.
clause_parts(H, H, true).

rule_item_diags(Ds, it(Src, F, L, T, VN, _), Diags) :-
    (   var(T)
    ->  Diags = [diag('E2', F, L, "This clause is a variable.")]
    ;   meta_term(T)
    ->  Diags = []
    ;   T = #(_)
    ->  Diags = []
    ;   clause_parts(T, H, B),
        head_diags(Ds, Src, F, L, H, DH),
        body_goals(B, Gs),
        head_name(H, HN),
        findall(D, ( member(G, Gs), body_goal_diag(Ds, F, L, HN, G, D) ), DB),
        e14_diags(T, VN, F, L, D14),
        append([DH, DB, D14], Diags)
    ).

head_name(none, "a constraint") :- !.
head_name(H, S) :-
    ( H = -(H1), callable(H1) -> true ; H1 = H ),
    ( callable(H1) -> functor(H1, N, A), fmt(S, "~q/~w", [N, A]) ; S = "a clause" ).

head_diags(_, _, _, _, none, []) :- !.
head_diags(Ds, Src, F, L, H0, Diags) :-
    ( H0 = -(H), callable(H) -> true ; H = H0 ),
    (   \+ callable(H)
    ->  Diags = [diag('E2', F, L, "The head of this clause is not a predicate.")]
    ;   functor(H, N, A),
        (   \+ decl_of(Ds, N, A, _)
        ->  undeclared_msg(Ds, N, A, M0),
            fmt(M, "Head: ~w Declare it with orbit-kb declare --kind rule.", [M0]),
            Diags = [diag('E2', F, L, M)]
        ;   decl_of(Ds, N, A, d(_, _, Kind, _, _, _, DSrc, _, _)),
            (   Kind == fact
            ->  fmt(M, "~q/~w is a fact predicate. Its facts belong in kb.pl only, but this clause is in ~w. Declare a rule predicate for computed values.", [N, A, F]),
                Diags = [diag('E7', F, L, M)]
            ;   Src == rules, ( DSrc == core ; DSrc = module(_) ), protected_pi(N/A)
            ->  src_text(DSrc, ST),
                fmt(M, "rules.pl adds clauses to ~q/~w from ~w. rules.pl cannot change done, the burn rules, the waiver rules, the vote rules, the blocking rules, or the facts that orbit-kb computes. The engines ignore this clause. Remove it.", [N, A, ST]),
                Diags = [diag('E16', F, L, M)]
            ;   Src == rules, ( DSrc == core ; DSrc = module(_) )
            ->  src_text(DSrc, ST),
                fmt(M, "rules.pl adds clauses to ~q/~w from ~w. This is an extension. Review it.", [N, A, ST]),
                Diags = [diag('W6', F, L, M)]
            ;   Diags = []
            )
        )
    ).

% protected_pi(?PI) (D10 follow-up, F8): the library rule predicates that
% decide done and the burns, and the facts that orbit-kb computes. A
% clause for one of them in rules.pl is E16, and the engines ignore it.
protected_pi(done/0).
protected_pi(burn/1).
protected_pi(burn_reason/1).
protected_pi(burn_proved/1).
protected_pi(burn_waived/1).
protected_pi(burn_open/1).
protected_pi(any_burn_open/0).
protected_pi(flare/1).
protected_pi(flare_shown/1).
protected_pi(flare_waived/1).
protected_pi(flare_open/1).
protected_pi(any_flare_open/0).
protected_pi(demo_changed/1).
protected_pi(any_current_claim/0).
protected_pi(proof_changed/1).
protected_pi(waiver_lapsed/1).
protected_pi(check_waived/1).
protected_pi(question_waived/1).
protected_pi(supersedes_closure/2).
protected_pi(supersede_cycle/1).
protected_pi(any_supersede_cycle/0).
% D22: what blocks done, and the computed due times.
protected_pi(blocking/1).
protected_pi(item_open/1).
protected_pi(check_ran/1).
protected_pi(due_passed/1).
% D23: the project module.
protected_pi(any_project_conflict/0).
protected_pi(subject_now/2).
protected_pi(decision_digest/2).
protected_pi(project_decision_digest/2).
protected_pi(project_conflict/2).
protected_pi(project_draft_text/2).
protected_pi(project_kb_unclean/0).
% D14: the weighted vote of the discovery module.
protected_pi(vote_cast/3).
protected_pi(discovery_vote_raised/1).
protected_pi(vote_round/1).
protected_pi(human_vote/1).
protected_pi(agent_vote/1).
protected_pi(artifact_vote/1).
protected_pi(discovery_gate_agreed/0).
protected_pi(gate/1).
protected_pi(gate_split/0).

% answer_items(+Items, +Decls, -Items2) (D10 follow-up, F8): the items that
% the engines read. A clause that lint rejects and that could close a
% burn does not reach them: a rules.pl clause whose head is a fact
% predicate (E7) or a protected library predicate (E16), and a kb.pl
% fact of a protected library predicate (E7).
answer_items(Items, Ds, Items2) :-
    exclude(ignored_item(Ds), Items, Items2).

ignored_item(Ds, it(Src, _, _, T, _, _)) :-
    ( Src == rules ; Src == kb ),
    nonvar(T), \+ meta_term(T), T \= #(_), T \= (:- _),
    clause_parts(T, H0, _), nonvar(H0),
    ( H0 = -(H), callable(H) -> true ; H = H0 ),
    callable(H),
    functor(H, N, A),
    decl_of(Ds, N, A, d(_, _, Kind, _, _, _, DSrc, _, _)),
    (   protected_pi(N/A), ( DSrc == core ; DSrc = module(_) )
    ->  true
    ;   Src == rules, Kind == fact
    ).

body_goal_diag(_, F, L, HN, G, diag('E2', F, L, M)) :-
    var(G), !,
    fmt(M, "The body of ~w has a variable as a goal. Write a predicate call.", [HN]).
body_goal_diag(_, _, _, _, G, _) :- builtin_goal(G), !, fail.
body_goal_diag(_, _, _, _, G, _) :- hash_constraint(G), !, fail.   % E17
body_goal_diag(_, F, L, HN, G, diag('E2', F, L, M)) :-
    \+ callable(G), !,
    term_text(G, GT),
    fmt(M, "The body of ~w has ~w as a goal. It is not a predicate.", [HN, GT]).
body_goal_diag(Ds, F, L, HN, G, diag('E2', F, L, M)) :-
    functor(G, N, A),
    \+ memberchk(N/A, [decl/4, attest_type/4]),
    \+ decl_of(Ds, N, A, _),
    undeclared_msg(Ds, N, A, M0),
    fmt(M, "The body of ~w calls ~w Declare it, or fix the name.", [HN, M0]).

% The literals of a body, with the not literals still wrapped.
body_lits(G, [G]) :- var(G), !.
body_lits((A, B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits((A ; B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits((A -> B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits(G, [G]).

var_in(Vs, V) :- member(X, Vs), X == V, !.

% E14 (D7): unsafe negation. A not literal holds a variable that occurs
% in the head but in no positive body literal. Nothing binds that
% variable before the negation runs, so a call with that argument unbound
% gets the wrong answer (floundering).
e14_problem(T, p(G, Bad)) :-
    clause_parts(T, H, B),
    H \== none,
    body_lits(B, Lits),
    include(binding_lit, Lits, Pos),
    term_variables(Pos, PV),
    term_variables(H, HV),
    member(Lit, Lits), nonvar(Lit), Lit = not(G),
    term_variables(G, GV),
    include(unbound_head_var(HV, PV), GV, Bad),
    Bad \== [].

unbound_head_var(HV, PV, V) :- var_in(HV, V), \+ var_in(PV, V).

% A positive literal that can bind a variable. Tests such as X \= Y and
% X < Y do not bind.
binding_lit(L) :- var(L), !, fail.
binding_lit(not(_)) :- !, fail.
binding_lit(\+(_)) :- !, fail.
binding_lit(L) :-
    callable(L), functor(L, N, A),
    \+ memberchk(N/A, ['\\='/2, '<'/2, '>'/2, '=<'/2, '>='/2, true/0, false/0,
                       '=='/2, '\\=='/2, '@<'/2, '@>'/2, '@=<'/2, '@>='/2]).

e14_diags(T, VN, F, L, Diags) :-
    clause_parts(T, H, _),
    head_name(H, HN),
    findall(diag('E14', F, L, M),
            ( e14_problem(T, p(G, Bad)), e14_msg(VN, HN, G, Bad, M) ),
            Diags).

e14_msg(VN, HN, G, Bad, M) :-
    copy_term(VN-t(G, Bad), VN2-t(G2, Bad2)),
    maplist(bind_vn, VN2),
    term_variables(t(G2, Bad2), Rest),
    maplist(=('$VAR'('_')), Rest),
    wtext(not(G2), NotT),
    maplist(wtext, Bad2, BadTs), atomic_list_concat(BadTs, ', ', BadT),
    fmt(M, "In ~w, the literal `~w` uses ~w. It occurs in the head, but no positive literal in the body binds it (unsafe negation). A call with ~w unbound then gives a wrong answer. Fix: before the not literal, add a positive literal that gives ~w its values, for example a fact or a rule that lists them.",
        [HN, NotT, BadT, BadT, BadT]).

% E17: a form that only s(CASP) reads. orbit-kb runs SWI-Prolog only, so
% the engine skips such a clause (load_item/4), and query, why, whynot,
% show, and report give no answer while one is in a source (answer_gate/1).
e17_diags(it(_, F, L, T, _, _), Diags) :- !,
    (   nonvar(T), e17_form(T, M)
    ->  Diags = [diag('E17', F, L, M)]
    ;   Diags = []
    ).
e17_diags(_, []).

e17_form(T, _) :- var(T), !, fail.
e17_form(#(_), "A # line is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Remove the line. A predicate gets its text from the template of its declaration.") :- !.
e17_form((:- _), "A global constraint (:- Body) is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Write a rule whose head names the problem, such as bad(X) :- Body, and query it.") :- !.
e17_form(T, M) :-
    clause_parts(T, H, B),
    (   nonvar(H), H = -(P), callable(P)
    ->  neg_msg(P, M)
    ;   body_lits_deep(B, Ls), member(X, Ls), nonvar(X),
        (   X = -(P), callable(P), \+ number(P)
        ->  neg_msg(P, M)
        ;   callable(X), functor(X, Op, 2),
            memberchk(Op, ['#=', '#<>', '#<', '#>', '#=<', '#>='])
        ->  fmt(M, "The constraint ~w is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Use is/2 and the comparisons =, <, >, =<, >=.", [Op])
        )
    ),
    !.

hash_constraint(G) :-
    callable(G), functor(G, Op, 2),
    memberchk(Op, ['#=', '#<>', '#<', '#>', '#=<', '#>=']).

neg_msg(P, M) :-
    term_text(P, PT),
    fmt(M, "-~w is classical negation, which orbit-kb no longer reads. orbit-kb runs SWI-Prolog only, and a fact that is not recorded is false: not ~w. To record that something is not the case, write it as a positive fact, such as world(door_closed), or as a note.", [PT, PT]).

% E18 (D20): the program must be stratified: no predicate depends on
% itself through a not literal. For such a program, negation as failure
% gives one answer, and the SWI engine computes it. For p :- not q and
% q :- not p, it does not. The core and the modules are stratified, so a
% cycle always goes through a clause of rules.pl. One error for each
% clause that holds a not literal on a cycle.
e18_diags(Items0, Ds, Diags) :-
    answer_items(Items0, Ds, Items),
    findall(e(H, B, S, F, L, Src),
            ( member(it(Src, F, L, T, _, _), Items), nonvar(T),
              \+ meta_term(T), \+ e17_form(T, _),
              T = (Hd :- Body), callable(Hd), functor(Hd, HN, HA), H = HN/HA,
              dep_lits(Body, pos, Deps), member(S-Lit, Deps),
              callable(Lit), \+ builtin_goal(Lit),
              functor(Lit, BN, BA), B = BN/BA ),
            Es),
    findall(X-Y, member(e(X, Y, _, _, _, _), Es), Edges0),
    sort(Edges0, Edges),
    findall(V, ( member(X-Y, Edges), ( V = X ; V = Y ) ), Vs0), sort(Vs0, Vs),
    vertices_edges_to_ugraph(Vs, Edges, G),
    transitive_closure(G, C),
    findall(H-B-F-L,
            ( member(e(H, B, neg, F, L, _), Es),
              ( H == B -> true ; member(B-Rs, C), memberchk(H, Rs) ) ),
            Cycles),
    findall(diag('E18', F, L, M),
            ( member(H-B-F-L, Cycles),
              fmt(M, "~q depends on itself through not ~q (the rules are not stratified). Negation as failure has no single answer for such a program. Fix: break the cycle, for example with a fact that records the case.", [H, B]) ),
            Diags0),
    % A cycle through a not in the library is closed by a clause of
    % rules.pl. Name that clause too: it is the one the user can change.
    findall(diag('E18', F, L, M),
            ( member(H-B-_-_, Cycles),
              member(e(X, Y, pos, F, L, rules), Es),
              on_cycle(X, H, B, C), on_cycle(Y, H, B, C),
              fmt(M, "This clause of ~q closes a cycle through not ~q in ~q (the rules are not stratified). Fix: remove or change this clause.", [X, B, H]) ),
            Diags1),
    append(Diags0, Diags1, Diags2),
    list_to_set(Diags2, Diags).

% on_cycle(X, H, B, C): X lies on a cycle that runs H -> not B -> ... -> H.
on_cycle(X, H, B, C) :-
    ( X == B -> true ; member(B-RB, C), memberchk(X, RB) ),
    ( X == H -> true ; member(X-RX, C), memberchk(H, RX) ).

% dep_lits(+Body, +Sign, -SignLits): each literal of a body with pos or
% neg. A literal under not, or in the condition of forall, is neg.
dep_lits(V, _, []) :- var(V), !.
dep_lits((A, B), S, L) :- !, dep_lits(A, S, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits((A ; B), S, L) :- !, dep_lits(A, S, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits((A -> B), S, L) :- !, dep_lits(A, neg, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits(not(G), _, L) :- !, dep_lits(G, neg, L).
dep_lits(\+(G), _, L) :- !, dep_lits(G, neg, L).
dep_lits(forall(A, B), _, L) :- !, dep_lits(A, neg, LA), dep_lits(B, neg, LB), append(LA, LB, L).
dep_lits(G, S, [S-G]).

% The literals of a body, also inside not, forall, and the parts of ;
% and ->.
body_lits_deep(G, [G]) :- var(G), !.
body_lits_deep((A, B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep((A ; B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep((A -> B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep(not(G), L) :- !, body_lits_deep(G, L).
body_lits_deep(\+(G), L) :- !, body_lits_deep(G, L).
body_lits_deep(forall(A, B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep(G, [G]).

% ---------------------------------------------------------------------
% SWI engine
% ---------------------------------------------------------------------
% SWI-Prolog is the only engine. Every program is stratified: the core
% and the modules are, and lint keeps rules.pl inside the same fragment
% (E14 unsafe negation, E17 forms of s(CASP), E18 stratification). So negation as
% failure gives the one answer of the program.
%
% eng(Module, LoadErrs)
%   LoadErrs: list of le(File, Line, Message)

build_engine(Items0, Ds, eng(M, LoadErrs)) :-
    answer_items(Items0, Ds, Items),
    gensym(orbit_eng_, M),
    set_module(M:base(system)),
    forall(member(d(N, A, _, _, _, _, _, _, _), Ds), make_dyn(M, N, A)),
    make_dyn(M, decl, 4),
    make_dyn(M, attest_type, 4),
    foldl(load_item(M), Items, [], LE0),
    reverse(LE0, LoadErrs).

make_dyn(M, N, A) :-
    catch(dynamic(M:N/A), _, true).

load_item(_, synerr(_, _, _, _), LE, LE) :- !.
load_item(_, it(kb, _, _, T, _, _), LE, LE) :- nonvar(T), T = uses(_), !.
load_item(_, it(_, F, L, T, _, _), LE, [le(F, L, "The clause is a variable.")|LE]) :-
    var(T), !.
load_item(_, it(_, _, _, T, _, _), LE, LE) :- e17_form(T, _), !.   % lint E17 or E7
load_item(M, it(_, F, L, T, _, _), LE, LE1) :-
    swi_clause(T, T2),
    catch(assertz(M:T2), E, true),
    (   var(E)
    ->  LE1 = LE
    ;   err_text(E, ET), LE1 = [le(F, L, ET)|LE]
    ).

swi_clause((H :- B), (H :- B2)) :- !, swi_body(B, B2).
swi_clause(H, H).

% swi_body(+Body, -SwiBody) (D7): in each conjunction, the not literals
% move after all of the other literals. The other literals (builtins
% too) keep their order. In a stratified program this does not change
% the answers, and \+ then never runs on a variable that a positive
% literal binds later (floundering).
swi_body(V, call(V)) :- var(V), !.
swi_body((A, B), Body) :- !,
    conj_list((A, B), Ls),
    partition(neg_body_lit, Ls, Negs, Poss),
    append(Poss, Negs, Ordered),
    maplist(swi_lit, Ordered, Ls2),
    list_conj(Ls2, Body).
swi_body(G, G2) :- swi_lit(G, G2).

swi_lit(V, call(V)) :- var(V), !.
swi_lit((A, B), B2) :- !, swi_body((A, B), B2).
swi_lit((A ; B), (A2 ; B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit((A -> B), (A2 -> B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit(not(G), \+ G2) :- !, swi_body(G, G2).
swi_lit(\+(G), \+ G2) :- !, swi_body(G, G2).
swi_lit(forall(A, B), forall(A2, B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit(G, G).

neg_body_lit(G) :- nonvar(G), ( G = not(_) ; G = \+(_) ), !.

conj_list(G, [G]) :- var(G), !.
conj_list((A, B), L) :- !, conj_list(A, LA), conj_list(B, LB), append(LA, LB, L).
conj_list(G, [G]).

list_conj([G], G) :- !.
list_conj([G|Gs], (G, C)) :- list_conj(Gs, C).

swi_time_limit(10).
swi_answer_cap(1000).

% swi_query(+Eng, +Goal, +Template, -Result)
% Result: answers(List, Capped) | error(Message)
swi_query(Eng, G, Tpl, Res) :-
    Eng = eng(_, LoadErrs),
    (   LoadErrs = [le(F, L, Msg)|_]
    ->  show_loc(F, L, LT),
        fmt(Res0, "the SWI engine could not load the clause at ~w: ~w Run orbit-kb lint.", [LT, Msg]),
        Res = error(Res0)
    ;   swi_raw(Eng, G, Tpl, Res)
    ).

swi_raw(eng(M, _), G, Tpl, Res) :-
    swi_body(G, G2),
    swi_time_limit(TL),
    swi_answer_cap(Cap),
    catch(call_with_time_limit(TL, once(findnsols(Cap, Tpl, M:G2, L0))), E, true),
    (   var(E)
    ->  list_to_set(L0, L),
        length(L0, Len),
        ( Len >= Cap -> Capped = true ; Capped = false ),
        Res = answers(L, Capped)
    ;   E == time_limit_exceeded
    ->  fmt(Msg, "the SWI engine did not finish in ~w s. The program may loop, or it may not be stratified.", [TL]),
        Res = error(Msg)
    ;   err_text(E, Msg),
        Res = error(Msg)
    ).

% For listings (show, report): answers or exit 2.
eng_all(Eng, Tpl, G, L) :-
    swi_raw(Eng, G, Tpl, R),
    (   R = answers(L0, _)
    ->  ( Tpl = [_] -> maplist([[X], X]>>true, L0, L) ; L = L0 )
    ;   R = error(Msg)
    ->  die(2, ["SWI ERROR: " + Msg] >> fix_lines)
    ).

swi_fail_if_error(error(Msg)) :- !,
    die(2, ["SWI ERROR: " + Msg, "The SWI engine could not evaluate the goal. This is not a false answer."] >> fix_lines).
swi_fail_if_error(_).

item_head_pi(it(_, _, _, T, _, _), PI) :-
    nonvar(T),
    \+ ( T = (:- _) ), \+ ( T = #(_) ),
    clause_parts(T, H, _),
    callable(H), functor(H, N, A), PI = N/A.

% Write a file atomically: a temp file in the same directory, then
% rename. A reader sees the old file or the whole new file.
write_atomic(F, Text) :-
    file_directory_name(F, D),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w/.tmp-~w-~w", [D, Pid, R]),
    catch(( setup_call_cleanup(open(Tmp, write, S, [encoding(utf8)]),
                               write(S, Text),
                               close(S)),
            rename_file(Tmp, F) ),
          E,
          ( catch(delete_file(Tmp), _, true), throw(E) )).

% ---------------------------------------------------------------------
% Goals
% ---------------------------------------------------------------------

query_names(VN, Names, Vars) :-
    exclude([N=_]>>sub_atom(N, 0, 1, _, '_'), VN, VN1),
    findall(N, member(N=_, VN1), Names),
    maplist([_=V, V]>>true, VN1, Vars).

answer_line([], _, "true") :- !.
answer_line(Names, Tuple, Line) :-
    findall(S, ( nth1(I, Names, N), nth1(I, Tuple, V),
                 term_text(V, VT), fmt(S, "~w = ~w", [N, VT]) ),
            Ss),
    atomic_list_concat(Ss, ', ', A),
    atom_string(A, Line).

take_n(0, L, L) :- !.
take_n(N, L, T) :- length(L, Len), ( Len =< N -> T = L ; length(T, N), append(T, _, L) ).

% answer_gate(+KB) (D7, D20): query, why, whynot, show, and report do
% not answer from a broken source. A syntax error (E1) in any source
% drops the clause, an undeclared head or body predicate (E2) in
% rules.pl is hidden by a stub, the engine skips a form of s(CASP)
% (E17), and negation as failure has no single answer for a program that
% is not stratified (E18). Each would give a quiet wrong answer. Exit 2
% instead.
answer_gate(KB) :-
    kb_items(KB, Items),
    findall(D, ( member(synerr(_, F, L, M), Items), D = diag('E1', F, L, M) ), E1s),
    (   E1s == []
    ->  items_decls(Items, Ds),
        findall(D, ( member(I, Items), I = it(rules, _, _, _, _, _),
                     rule_item_diags(Ds, I, D0),
                     member(D, D0), D = diag('E2', _, _, _) ),
                E2s),
        findall(D, ( member(I, Items), e17_diags(I, D0), member(D, D0) ), E17s),
        e18_diags(Items, Ds, E18s)
    ;   E2s = [], E17s = [], E18s = []
    ),
    append([E1s, E2s, E17s, E18s], Bad),
    (   Bad == []
    ->  true
    ;   findall(S, ( member(diag(C, F, L, M), Bad), show_loc(F, L, LT),
                     fmt(S, "~w ~w: ~w", [C, LT, M]) ),
                Ls),
        (   E1s \== []
        ->  Why = "A source file has a syntax error. orbit-kb drops a clause that does not parse, so an answer could be wrong."
        ;   E2s \== []
        ->  Why = "rules.pl names a predicate that is not declared. Its clauses cannot take part, so an answer could be wrong."
        ;   E17s \== []
        ->  Why = "A source uses a form that orbit-kb does not read. The engine skips that clause, so an answer could be wrong."
        ;   Why = "The rules are not stratified, so negation as failure has no single answer."
        ),
        append([Ls, [Why,
                     "Fix: correct each line above, then run orbit-kb lint.",
                     "orbit-kb gives no answer until then. This is not a false answer."]],
               All),
        die(2, All)
    ).

check_goal(G, Ds) :-
    (   e17_form((goal :- G), M)
    ->  die(2, ["The goal uses a form that orbit-kb does not read. " + M] >> fix_lines)
    ;   true
    ),
    body_goals(G, Gs),
    forall(member(X, Gs), goal_ok(X, Ds)).

goal_ok(X, _) :- var(X), !,
    die(2, ["The goal has a variable where a predicate call must be. Write a predicate call."]).
goal_ok(X, _) :- builtin_goal(X), !.
goal_ok(X, _) :- \+ callable(X), !,
    term_text(X, XT),
    die(2, ["The goal holds " + XT + ", which is not a predicate call."] >> fix_lines).
goal_ok(X, _) :- functor(X, N, A), memberchk(N/A, [decl/4, attest_type/4]), !.
goal_ok(X, Ds) :-
    functor(X, N, A),
    (   decl_of(Ds, N, A, _)
    ->  true
    ;   N == (\+), A =:= 1
    ->  die(2, ["The goal uses \\+. Use not instead, such as not under(c1)."])
    ;   undeclared_msg(Ds, N, A, M),
        die(2, [ "Unknown predicate in the goal. " + M,
                 "Check the spelling. To add a predicate, use orbit-kb declare.",
                 "This is a usage error, not a false answer." ] >> fix_lines)
    ).

parse_goal(Text, G, VN) :-
    parse_one(Text, R),
    (   R = ok(G, VN)
    ->  true
    ;   R = err(M),
        die(2, [ "The goal does not parse. " + M,
                 "Check the brackets and quotes. Write text in single quotes.",
                 "This is a usage error, not a false answer." ] >> fix_lines)
    ).
% ---------------------------------------------------------------------
% query and why
% ---------------------------------------------------------------------

cmd_query(KB, Args, ForceWhy, Code) :-
    parse_opts(Args, ['-n'-value, '--why'-flag, '--long'-flag, '--short'-flag], Pos, Opts),
    (   Pos = [GoalText]
    ->  true
    ;   usage_error("Give exactly one goal in quotes, such as orbit-kb query 'claim(C, L, T)'.", [])
    ),
    opt(Opts, '-n', '1', NA),
    (   atom_number(NA, N), integer(N), N >= 0
    ->  true
    ;   usage_error("The option -n needs a whole number of 0 or more. 0 means all answers.", [])
    ),
    opt(Opts, '--why', false, Why0),
    ( ForceWhy == true -> Why = true ; Why = Why0 ),
    opt(Opts, '--long', false, Long),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    parse_goal(GoalText, G, VN),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    check_goal(G, Ds),
    answer_gate(KB),
    build_engine(Items, Ds, Eng),
    query_names(VN, Names, Vars),
    swi_query(Eng, G, Vars, Res),
    swi_fail_if_error(Res),
    Res = answers(L, _),
    take_n(N, L, Shown),
    (   Shown == []
    ->  format("false~n", []), Code = 1
    ;   Code = 0,
        forall(member(Tp, Shown),
               ( answer_line(Names, Tp, AL), format("~w~n", [AL]),
                 (   Why == true
                 ->  copy_term(G-Vars, G1-Tp),
                     explain_lines(Eng, Ds, holds, G1, Long, Lines),
                     format("~n", []), print_lines(user_output, Lines)
                 ;   true
                 ) ))
    ).

% ---------------------------------------------------------------------
% whynot
% ---------------------------------------------------------------------

cmd_whynot(KB, Args, Code) :-
    parse_opts(Args, ['--long'-flag, '--short'-flag], Pos, Opts),
    (   Pos = [GoalText] -> true
    ;   usage_error("Give exactly one goal in quotes, such as orbit-kb whynot 'fulfilled(c1)'.", [])
    ),
    opt(Opts, '--long', false, Long),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    parse_goal(GoalText, G, _),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    check_goal(G, Ds),
    answer_gate(KB),
    build_engine(Items, Ds, Eng),
    swi_query(Eng, G, [G], Res),
    swi_fail_if_error(Res),
    Res = answers(L, _),
    (   L = [[G1]|_]
    ->  format("holds~n", []),
        explain_lines(Eng, Ds, holds, G1, Long, Lines)
    ;   format("absent~n", []),
        explain_lines(Eng, Ds, fails, G, Long, Lines)
    ),
    format("~n", []),
    print_lines(user_output, Lines),
    Code = 0.

% ---------------------------------------------------------------------
% Explanations (why, whynot)
% ---------------------------------------------------------------------
% The SWI engine gives every verdict. An explanation reads the same
% clauses again, after the verdict:
%   - a goal that holds: one clause that proves it, and why each of its
%     body literals holds;
%   - a goal that fails: for each rule of the goal, the first body
%     literal that no answer of the literals before it gets past.
% Every program is stratified (lint E18, answer_gate/1), so these trees are
% finite. A depth limit keeps them short: 6 levels, or 30 with --long.
% An explanation never changes a verdict.

expl_depth(Long, D) :- ( Long == true -> D = 30 ; D = 6 ).
expl_time_limit(10).

% explain_lines(+Eng, +Ds, +Mode, +Goal, +Long, -Lines)
% Mode is holds (Goal has an answer; Goal is bound to it) or fails.
explain_lines(eng(M, _), Ds, Mode, G, Long, Lines) :-
    expl_depth(Long, D),
    swi_body(G, G2),
    expl_time_limit(TL),
    catch(call_with_time_limit(TL,
              ( Mode == holds -> ex_true(M, G2, D, T) ; ex_false(M, G2, D, T) )),
          E, true),
    (   var(E), nonvar(T)
    ->  phrase(ex_lines(T, Ds, 0), Lines)
    ;   E == time_limit_exceeded
    ->  fmt(L, "No explanation: it took more than ~w s. The verdict above stands.", [TL]),
        Lines = [L]
    ;   Lines = ["No explanation is available. The verdict above stands."]
    ).

% Trees:
%   fact(G)             G is a fact
%   rule(G, Kids)       G holds by a rule; Kids explain its body
%   builtin(G)          a builtin goal that holds
%   naf(P, Sub)         not P holds; Sub = none, or the tree of P failing
%   more(G)             G holds; the depth limit stops here
%   fails(G, Why)       G has no answer. Why = nothing | builtin | depth
%                       | rules(Stops), Stops = list of stop(Lit, Sub)
%   holds_neg(P, Sub)   (inside a stop) not P fails because P holds

user_pred(M, G) :-
    callable(G),
    \+ builtin_goal(G),
    functor(G, N, A),
    functor(H, N, A),
    predicate_property(M:H, dynamic).

ex_true(M, G, D, T) :-
    (   G = (_, _)
    ->  conj_list(G, Ls),
        maplist([L, K]>>once(ex_true(M, L, D, K)), Ls, Kids),
        T = all(Kids)
    ;   G = (\+ P)
    ->  ( D > 0 -> ex_false(M, P, D, Sub) ; Sub = none ),
        T = naf(P, Sub)
    ;   \+ user_pred(M, G)
    ->  once(call(M:G)), T = builtin(G)
    ;   D =< 0
    ->  once(call(M:G)), T = more(G)
    ;   once(( clause(M:G, B), call(M:B) )),
        (   B == true
        ->  T = fact(G)
        ;   D1 is D - 1,
            conj_list(B, Ls),
            maplist([L, K]>>once(ex_true(M, L, D1, K)), Ls, Kids),
            T = rule(G, Kids)
        )
    ).

ex_false(M, G, D, T) :-
    (   G = (\+ P)
    ->  once(ex_true(M, P, D, PT)), T = neg_fails(P, PT)
    ;   G = (_, _)
    ->  rule_stop(M, '$goal', G, D, S), T = fails('$goal', rules([S]))
    ;   ex_false_lit(M, G, D, T)
    ).

ex_false_lit(M, G, D, fails(G, Why)) :-
    (   \+ user_pred(M, G)
    ->  Why = builtin
    ;   D =< 0
    ->  Why = depth
    ;   findall(G-B, ( clause(M:G, B), B \== true ), Rules),
        (   Rules == []
        ->  Why = nothing
        ;   D1 is D - 1,
            findall(S, ( member(G1-B1, Rules), rule_stop(M, G1, B1, D1, S) ), Stops),
            Why = rules(Stops)
        )
    ).

% rule_stop(+M, +Head, +Body, +D, -Stop): the first body literal that no
% answer of the literals before it gets past. The literal is shown with
% the bindings of the literals before it when they have one answer.
rule_stop(M, H, B, D, stop(H, Lit, Sub)) :-
    conj_list(B, Ls),
    stop_at(M, Ls, [], Lit0, Before),
    findall(Lit0, call(M:Before), Ans0),
    sort(Ans0, Ans),
    (   Ans = [Lit]
    ->  (   Lit = (\+ P)
        ->  once(ex_true(M, P, D, PT)), Sub = holds_neg(P, PT)
        ;   ex_false(M, Lit, D, Sub)
        )
    ;   Ans == []
    ->  Lit = Lit0, Sub = first
    ;   Lit = Lit0, Sub = each
    ).

stop_at(M, [L|Ls], Acc, Lit, Before) :-
    append(Acc, [L], Acc1),
    list_conj_true(Acc1, C),
    (   \+ \+ call(M:C)
    ->  stop_at(M, Ls, Acc1, Lit, Before)
    ;   Lit = L,
        list_conj_true(Acc, Before)
    ).

list_conj_true([], true) :- !.
list_conj_true(Ls, C) :- list_conj(Ls, C).

% --- Text. Each line is indented by three spaces per level.

ex_lines(fact(G), Ds, I) --> ex_line(I, "~w", [tpl(G, Ds)]).
ex_lines(builtin(G), _, I) --> ex_line(I, "~w holds", [lit(G)]).
ex_lines(more(G), Ds, I) --> ex_line(I, "~w (--long shows more)", [tpl(G, Ds)]).
ex_lines(rule(G, Kids), Ds, I) -->
    ex_line(I, "~w, because", [tpl(G, Ds)]),
    { I1 is I + 1 },
    ex_kids(Kids, Ds, I1).
ex_lines(naf(P, none), Ds, I) --> !,
    ex_line(I, "there is no evidence that ~w", [tpl(P, Ds)]).
ex_lines(naf(_, Sub), Ds, I) --> ex_lines(Sub, Ds, I).
ex_lines(all(Kids), Ds, I) --> ex_kids(Kids, Ds, I).
ex_lines(neg_fails(P, PT), Ds, I) -->
    ex_line(I, "not ~w does not hold, because", [lit(P)]),
    { I1 is I + 1 },
    ex_lines(PT, Ds, I1).
ex_lines(fails('$goal', rules(Stops)), Ds, I) --> !,
    ex_stops(Stops, 1, 1, Ds, I).
ex_lines(fails(G, Why), Ds, I) -->
    (   { Why == nothing }
    ->  ex_line(I, "nothing records ~w: no fact or rule matches it", [lit(G)])
    ;   { Why == builtin }
    ->  ex_line(I, "~w does not hold", [lit(G)])
    ;   { Why == depth }
    ->  ex_line(I, "there is no evidence that ~w (--long shows more)", [tpl(G, Ds)])
    ;   { Why = rules(Stops) },
        ex_line(I, "there is no evidence that ~w, because", [tpl(G, Ds)]),
        { I1 is I + 1, length(Stops, NS) },
        ex_stops(Stops, NS, 1, Ds, I1)
    ).

ex_kids([], _, _) --> [].
ex_kids([K|Ks], Ds, I) --> ex_lines(K, Ds, I), ex_kids(Ks, Ds, I).

ex_stops([], _, _, _, _) --> [].
ex_stops([stop(H, Lit, Sub)|Ss], NS, K, Ds, I) -->
    { functor(H, N, A),
      (   H == '$goal'
      ->  Which = "the goal"
      ;   NS =:= 1
      ->  fmt(Which, "the rule for ~q/~w", [N, A])
      ;   fmt(Which, "rule ~w of ~w for ~q/~w", [K, NS, N, A])
      ) },
    (   { Sub == first }
    ->  ex_line(I, "~w stops at its first literal: ~w", [str(Which), lit(Lit)])
    ;   { Sub == each }
    ->  ex_line(I, "~w stops at ~w, for every answer of the literals before it", [str(Which), lit(Lit)])
    ;   ex_line(I, "~w stops at ~w:", [str(Which), lit(Lit)]),
        { I1 is I + 1 },
        (   { Sub = holds_neg(_, PT) }
        ->  ex_lines(PT, Ds, I1)
        ;   ex_lines(Sub, Ds, I1)
        )
    ),
    { K1 is K + 1 },
    ex_stops(Ss, NS, K1, Ds, I).

ex_line(I, Fmt, Args0) -->
    { maplist(ex_arg, Args0, Args),
      format(string(S0), Fmt, Args),
      Pad is I * 3,
      format(string(S), "~*c~w", [Pad, 0' , S0]) },
    [S].

ex_arg(tpl(G, Ds), S) :- !, goal_template_text(G, Ds, S).
ex_arg(lit(G), S) :- !, lit_text(G, S).
ex_arg(str(S), S).

% A literal as source text: \+ prints as not.
lit_text(G, S) :- show_not(G, G2), term_text(G2, S).

show_not(V, V) :- var(V), !.
show_not(\+ G, not(G2)) :- !, show_not(G, G2).
show_not((A, B), (A2, B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not((A ; B), (A2 ; B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not((A -> B), (A2 -> B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not(G, G).

% The template of a declaration with the arguments put in, or the goal
% as text when it has no template.
goal_template_text(G, Ds, S) :-
    (   callable(G), functor(G, N, A),
        decl_of(Ds, N, A, d(_, _, _, _, _, Tpl, _, _, _)),
        atom(Tpl), Tpl \== ''
    ->  atom_string(Tpl, T0),
        G =.. [_|Args],
        foldl(tpl_put, Args, 1-T0, _-S)
    ;   lit_text(G, S0),
        fmt(S, "~w holds", [S0])
    ).

tpl_put(Arg, I-S0, I1-S) :-
    I1 is I + 1,
    fmt(From, "@(~w)", [I]),
    (   var(Arg) -> AT = "_"
    ;   atomic(Arg) -> format(string(AT), "~w", [Arg])
    ;   term_text(Arg, AT)
    ),
    atomic_list_concat(Parts, From, S0),
    atomic_list_concat(Parts, AT, A),
    atom_string(A, S).

% ---------------------------------------------------------------------
% init
% ---------------------------------------------------------------------

cmd_init(Args, Code) :-
    parse_opts(Args, ['--request'-value, '--request-file'-value, '--uses'-value, '--id'-value], Pos, Opts),
    (   Pos = [Dir0] -> true
    ;   usage_error("Give one directory: orbit-kb init DIR --request TEXT.", [])
    ),
    opt(Opts, '--request', none, RT),
    opt(Opts, '--request-file', none, RF),
    (   RT \== none, RF == none
    ->  Text = RT
    ;   RF \== none, RT == none
    ->  (   exists_file(RF)
        ->  read_file_to_string(RF, S0, [encoding(utf8)]),
            ( sub_string(S0, B, 1, 0, "\n") -> sub_string(S0, 0, B, _, S1) ; S1 = S0 ),
            atom_string(Text, S1)
        ;   die(1, ["The request file " + RF + " does not exist. Check the path."] >> fix_lines)
        )
    ;   usage_error("Give the request with --request TEXT or with --request-file F. Give one of them, not both.", [])
    ),
    opt(Opts, '--id', r1, Id),
    opt(Opts, '--uses', '', UsesA),
    split_string(UsesA, ",", " ", US0),
    exclude(==(""), US0, US),
    maplist(atom_string, Uses, US),
    lib_dir(Lib),
    lib_modules(Lib, Known),
    (   member(M, Uses), \+ memberchk(M, Known)
    ->  atomic_list_concat(Known, ', ', KT),
        die(1, ["The module " + M + " does not exist.", "Known modules: " + KT + ".", "Fix: use a known module name in --uses."] >> fix_lines)
    ;   true
    ),
    Req = request(Id, Text),
    absolute_file_name(Dir0, Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    (   exists_file(KbFile)
    ->  die(1, [KbFile + " already exists. orbit-kb init does not overwrite a KB.", "Fix: choose a new directory, or use the KB that exists."] >> fix_lines)
    ;   true
    ),
    make_directory_path(Dir),
    clause_line(uses(Uses), [], L1),
    clause_line(Req, [], L2),
    setup_call_cleanup(open(KbFile, write, S, [encoding(utf8)]),
                       format(S, "~w~n~w~n", [L1, L2]),
                       close(S)),
    format("~w~n", [KbFile]),
    format(user_error, "Next: add the claims and the checks. Vocabulary: orbit-kb help core.~n", []),
    Code = 0.

% ---------------------------------------------------------------------
% uses: add modules to an existing KB
% ---------------------------------------------------------------------
% It rewrites only the first term of kb.pl, uses([...]). It does not
% load the KB first, because a KB that needs a module is not valid
% until the module is in uses/1. It never removes a module.

cmd_uses(Dir, Args, Code) :-
    parse_opts(Args, [], Pos0, _),
    (   member(A, Pos0), sub_atom(A, 0, 1, _, '-')
    ->  usage_error("uses takes module names only, not ~w.", [A])
    ;   true
    ),
    % "build,discovery" is accepted too, as in init --uses.
    findall(M, ( member(A, Pos0), atomic_list_concat(Ps, ',', A), member(M, Ps), M \== '' ), Pos),
    (   Pos == []
    ->  usage_error("Name one or more modules: orbit-kb uses MODULE ...", [])
    ;   true
    ),
    lib_dir(Lib),
    lib_modules(Lib, Known),
    (   member(M, Pos), \+ memberchk(M, Known)
    ->  atomic_list_concat(Known, ', ', KT),
        die(1, ["The module " + M + " does not exist.", "Known modules: " + KT + ".", "Fix: use a known module name."] >> fix_lines)
    ;   true
    ),
    directory_file_path(Dir, 'kb.pl', KbFile0),
    % Write the file that a symlink points to, as add does, not the link.
    ( catch(read_link(KbFile0, _, KbFile), _, fail) -> true ; KbFile = KbFile0 ),
    catch(( read_file_to_string(KbFile, S, [encoding(utf8)]),
            setup_call_cleanup(open_string(S, In),
                               ( read_term(In, T, [module(orbit_ops), subterm_positions(TPos)]),
                                 arg(1, TPos, Start), arg(2, TPos, End) ),
                               close(In)) ),
          _, fail),
    !,
    (   nonvar(T), T = uses(Old), is_list(Old), maplist(atom, Old)
    ->  true
    ;   die(1, [KbFile0 + " does not start with uses([...]) and a list of module names.", "Fix: run orbit-kb lint and correct E10."] >> fix_lines)
    ),
    findall(M, ( member(M, Pos), \+ memberchk(M, Old) ), New0),
    list_to_set(New0, New),
    (   New == []
    ->  atomic_list_concat(Old, ', ', OT),
        format("The KB already uses ~w. Nothing was written.~n", [OT])
    ;   append(Old, New, Uses),
        % Replace only the text of the term. The text before it and after
        % it (the full stop, a comment, the other clauses) stays as it is.
        sub_string(S, 0, Start, _, Before),
        sub_string(S, End, _, 0, Rest),
        term_text(uses(Uses), UT),
        atomic_list_concat([Before, UT, Rest], Out),
        catch(write_atomic(KbFile, Out), E,
              ( err_text(E, ET),
                die(2, ["Could not write " + KbFile + ": " + ET, "Nothing was changed.", "Fix: check that the KB directory is writable."] >> fix_lines) )),
        format("~w.~n", [UT]),
        format(user_error, "Run orbit-kb lint next. The new module can add lint findings to the KB.~n", []),
        (   memberchk(discovery, New)
        ->  format(user_error, "Next: orbit-kb lint. Recipes for each move: orbit-kb help discovery.~n", [])
        ;   memberchk(build, New)
        ->  format(user_error, "Next: orbit-kb lint. Facts, queries, and burns: orbit-kb help build.~n", [])
        ;   true
        )
    ),
    Code = 0.
cmd_uses(Dir, _, _) :-
    directory_file_path(Dir, 'kb.pl', KbFile),
    die(1, ["Could not read the first term of " + KbFile + ".", "Fix: run orbit-kb lint and correct E1 or E10."] >> fix_lines).

% ---------------------------------------------------------------------
% Writing to kb.pl
% ---------------------------------------------------------------------

append_lines(File, Lines) :-
    (   exists_file(File)
    ->  read_file_to_string(File, S, [encoding(utf8)]),
        ( ( S == "" ; sub_string(S, _, 1, 0, "\n") ) -> Pre = "" ; Pre = "\n" )
    ;   Pre = ""
    ),
    setup_call_cleanup(open(File, append, Out, [encoding(utf8)]),
                       ( format(Out, "~w", [Pre]),
                         forall(member(L, Lines), format(Out, "~w~n", [L])) ),
                       close(Out)).

reject(Lines0) :-
    ( nonvar(Lines0), Lines0 = (L >> _) -> true ; L = Lines0 ),
    die(1, ["Rejected. Nothing was written."|L]).

% Validate new fact terms against the KB. NewItems use Src new, File
% '<arg>', Line = the argument number.
validate_new(KB, NewItems, Problems) :-
    kb_items(KB, Items),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    include(fact_item, Items, Old),
    append(Old, NewItems, All),
    build_env(All, Ds, Env),
    Ctx = fctx(KB, Ds, ATs, Env),
    findall(D, ( member(I, NewItems), fact_diags(Ctx, I, D0), member(D, D0) ), D1),
    e5_diags(All, Ds, D2a),
    include([diag(_, F, _, _)]>>(F == '<arg>'), D2a, D2),
    findall(D, ( member(I, NewItems), e17_diags(I, D0), member(D, D0) ), D3),
    e15_diags(All, D4a),
    include([diag(_, F, _, _)]>>(F == '<arg>'), D4a, D4),
    append([D1, D2, D3, D4], Problems).

problem_lines(Problems, NewItems, Lines) :-
    findall(S, ( member(diag(C, _, L, M), Problems),
                 member(it(_, _, L, T, VN, _), NewItems),
                 term_text(T, VN, TT),
                 fmt(S, "~w in argument ~w (~w): ~w", [C, L, TT, M]) ),
            Lines).

cmd_add(KB, Args, Code) :-
    parse_opts(Args, ['--by'-value], Pos, Opts),
    (   Pos == [] -> usage_error("Give one or more facts in quotes, such as orbit-kb add 'claim(c1, preserve, ''Text'')'.", []) ; true ),
    opt(Opts, '--by', agent, By),
    (   memberchk(By, [human, agent]) -> true
    ;   usage_error("--by takes human or agent. It is ~w.", [By])
    ),
    kb_items(KB, KI), items_atypes(KI, ATs),
    findall(R, ( nth1(I, Pos, A), add_item(ATs, I, A, R) ), Rs),
    findall(M, member(err(M), Rs), Errs),
    (   Errs \== [] -> reject(Errs) ; true ),
    findall(It, member(ok(It), Rs), NewItems),
    % D22: a fact whose name is declared nowhere declares its predicate by
    % its first use. The decl/4 lines take part in the checks of the batch.
    first_use_pis(KB, NewItems, FUs),
    kb_file(KB, KbFile),
    findall(it(kb, KbFile, 0, D, [], 0-0), ( member(N/A, FUs), first_use_decl(N, A, D) ), DeclItems),
    KB = kb(Dir, Lib, Uses, _),
    append(KI, DeclItems, KI2),
    validate_new(kb(Dir, Lib, Uses, KI2), NewItems, Problems),
    (   Problems \== []
    ->  problem_lines(Problems, NewItems, PL),
        reject(PL)
    ;   true
    ),
    utc_now(Now),
    add_lines(NewItems, FUs, By, Now, [], Lines),
    append_lines(KbFile, Lines),
    forall(member(L, Lines), format("~w~n", [L])),
    forall(member(N/A, FUs),
           format(user_error, "NOTE: ~q/~w is a new predicate. Its first use declares it, with the type term for each argument (lint W7 lists it). To give a predicate a doc and types, declare it before its first use: orbit-kb declare.~n", [N, A])),
    Code = 0.

% add_lines(+NewItems, +FirstUsePIs, +By, +Time, +Done, -Lines): the lines
% of the facts in order. Before the first fact of a first-use predicate
% come its decl/4 line and its first_use/3 fact (D22).
add_lines([], _, _, _, _, []).
add_lines([it(_, _, _, T, _, _)|Is], FUs, By, Now, Done, Lines) :-
    (   pos_fact(T), functor(T, N, A), memberchk(N/A, FUs), \+ memberchk(N/A, Done)
    ->  first_use_decl(N, A, D),
        clause_line(D, [], L1),
        clause_line(first_use(N/A, By, Now), [], L2),
        Pre = [L1, L2], Done1 = [N/A|Done]
    ;   Pre = [], Done1 = Done
    ),
    clause_line(T, [], L),
    add_lines(Is, FUs, By, Now, Done1, Rest),
    append(Pre, [L|Rest], Lines).

first_use_decl(N, A, decl(fact, H, 'Declared by its first use. Review it (lint W7).', '')) :-
    length(Ts, A), maplist(=(term), Ts),
    H =.. [N|Ts].

% first_use_pis(+KB, +NewItems, -PIs) (D22): the predicates N/A of the new
% facts whose name N is declared nowhere: not in the core, in no library
% module (also one that the KB does not use), not in kb.pl, at no arity.
% Each name once, at its first fact. A reserved name is never a first use.
first_use_pis(KB, NewItems, PIs) :-
    all_known_items(KB, Known),
    items_decls(Known, KDs),
    findall(N, member(d(N, _, _, _, _, _, _, _, _), KDs), Ns0),
    sort(Ns0, Known1),
    first_use_walk(NewItems, Known1, [], PIs0),
    reverse(PIs0, PIs).

first_use_walk([], _, Acc, Acc).
first_use_walk([it(_, _, _, T, _, _)|Is], Known, Acc, PIs) :-
    (   pos_fact(T), \+ meta_term(T),
        functor(T, N, A),
        atom(N), \+ reserved_name(N),
        \+ ord_memberchk(N, Known),
        \+ memberchk(N/_, Acc)
    ->  Acc1 = [N/A|Acc]
    ;   Acc1 = Acc
    ),
    first_use_walk(Is, Known, Acc1, PIs).

add_item(ATs, I, A, R) :-
    parse_one(A, P),
    (   P = err(M0)
    ->  fmt(M, "Argument ~w does not parse. ~w Check the brackets and quotes. Write text in single quotes.", [I, M0]),
        R = err(M)
    ;   P = ok(T, VN),
        (   nonvar(T), T = decl(_, _, _, _)
        ->  fmt(M, "Argument ~w is a declaration. Use orbit-kb declare instead.", [I]), R = err(M)
        ;   nonvar(T), T = attest_type(_, _, _, _)
        ->  fmt(M, "Argument ~w is an attestation type. orbit-kb add does not declare attestation types. Use a type that orbit-kb help core or a module topic lists.", [I]), R = err(M)
        ;   nonvar(T), T = uses(_)
        ->  fmt(M, "Argument ~w is uses/1. orbit-kb init writes it. To add a module, run orbit-kb uses MODULE.", [I]), R = err(M)
        ;   nonvar(T), T = attest(_, Type, _, _, _, _), atom(Type), script_only_type(ATs, Type)
        ->  script_use(Type, Use),
            fmt(M, "Argument ~w: only ~w writes attestations of type ~q.", [I, Use, Type]), R = err(M)
        ;   R = ok(it(new, '<arg>', I, T, VN, 0-0))
        )
    ).

script_use(lean_proof, "orbit-kb prove CLAIM FILE THEOREM") :- !.
script_use(_, "orbit-kb run CHECK -- CMD").

script_only_type(ATs, Type) :-
    atype_of(ATs, Type, at(_, _, W, _, _, _, _)),
    W == [script].

% ---------------------------------------------------------------------
% declare
% ---------------------------------------------------------------------

reserved_name(N) :-
    memberchk(N, [decl, attest_type, uses, not, true, false, forall, call, is,
                  '=', '\\=', '<', '>', '=<', '>=', ',', ';', '->', ':-', '#', '\\+', '-',
                  '#=', '#<>', '#<', '#>', '#=<', '#>=']).

cmd_declare(KB, Args, Code) :-
    parse_opts(Args, ['--doc'-value, '--kind'-value, '--template'-value], Pos, Opts),
    (   Pos = [HeadText] -> true
    ;   usage_error("Give one head in quotes, such as orbit-kb declare 'risk_owner(ref(risk), text)' --doc TEXT.", [])
    ),
    (   memberchk('--doc'-Doc, Opts) -> true
    ;   usage_error("The option --doc TEXT is required. Write one plain sentence.", [])
    ),
    opt(Opts, '--kind', fact, Kind),
    opt(Opts, '--template', '', Tpl),
    (   memberchk(Kind, [fact, rule]) -> true
    ;   reject(["The kind must be fact or rule. It is " + Kind + "."] >> fix_lines)
    ),
    parse_one(HeadText, P),
    (   P = ok(H, _) -> true
    ;   P = err(M0), reject(["The head does not parse. " + M0 + " Write it like name(type1, type2)."] >> fix_lines)
    ),
    (   ground(H), callable(H), H \= -(_) -> true
    ;   reject(["The head must be a name with types, such as risk_owner(ref(risk), text). It cannot have variables or a minus sign."])
    ),
    H =.. [N|Ts], length(Ts, A),
    (   reserved_name(N) -> reject(["The name " + N + " is reserved. Choose another name."] >> fix_lines) ; true ),
    all_known_items(KB, Known),
    items_decls(Known, KDs),
    (   decl_of(KDs, N, A, d(_, _, _, _, _, _, DSrc, DF, DL))
    ->  src_text(DSrc, ST),
        fmt(M1, "~q/~w is already declared in ~w (~w:~w). Choose another name, or use the declaration that exists.", [N, A, ST, DF, DL]),
        reject([M1])
    ;   true
    ),
    findall(FN, member(d(FN, _, fact, _, _, _, _, _, _), KDs), FN0),
    ( Kind == fact -> FN1 = [N|FN0] ; FN1 = FN0 ),
    sort(FN1, FactNames),
    findall(E, ( member(T, Ts), type_errs(T, FactNames, Es), member(E, Es) ), TErrs),
    (   TErrs \== [] -> reject(TErrs) ; true ),
    template_errs(Tpl, A, PErrs),
    (   PErrs \== [] -> reject(PErrs) ; true ),
    Decl = decl(Kind, H, Doc, Tpl),
    clause_line(Decl, [], Line),
    kb_file(KB, KbFile),
    append_lines(KbFile, [Line]),
    format("~w~n", [Line]),
    Code = 0.


template_errs('', _, []) :- !.
template_errs(Tpl, A, Errs) :-
    atom_codes(Tpl, Cs),
    findall(E, template_err(Cs, A, E), Errs0),
    sort(Errs0, Errs).

template_err(Cs, A, E) :-
    append(_, [0'@, 0'(|Rest], Cs),
    (   append(Ds, [0')|_], Rest), Ds \== [], maplist(is_digit_code, Ds)
    ->  number_codes(I, Ds),
        ( I >= 1, I =< A -> fail ; fmt(E, "The template uses @(~w), but the predicate has ~w argument(s). Use @(1) to @(~w).", [I, A, A]) )
    ;   E = "The template has an @( that is not @(N) with a number N. Use @(1), @(2), and so on."
    ).

% ---------------------------------------------------------------------
% pin (D22)
% ---------------------------------------------------------------------
% orbit-kb pin prints the stamp spec-kb@sha256:HEX of kb.pl and the time.
% The CLI computes the digest; nobody types it. pin --check STAMP compares
% the first word of STAMP with the stamp of kb.pl now. pin writes nothing.

cmd_pin(Dir, Args, Code) :-
    parse_opts(Args, ['--check'-value], Pos, Opts),
    (   Pos == [] -> true
    ;   usage_error("pin takes no arguments other than --check STAMP.", [])
    ),
    directory_file_path(Dir, 'kb.pl', KbFile),
    sha256_file(KbFile, Digest),
    atom_concat('spec-kb@', Digest, Stamp),
    (   memberchk('--check'-Given, Opts)
    ->  atom_string(Given, GS),
        split_string(GS, " \t", " \t", Words0), exclude(==(""), Words0, Words),
        (   Words = [W|_], atom_string(WA, W), pin_stamp_ok(WA)
        ->  true
        ;   usage_error("The stamp must be spec-kb@sha256: and 64 lowercase hex characters, as orbit-kb pin prints it. It is ~w.", [Given])
        ),
        (   WA == Stamp
        ->  format("unchanged: ~w~n", [Stamp]), Code = 0
        ;   format("changed: kb.pl is now ~w. The pin ~w is old.~n", [Stamp, WA]), Code = 1
        )
    ;   utc_now(Now),
        format("~w ~w~n", [Stamp, Now]),
        Code = 0
    ).

pin_stamp_ok(A) :-
    atom_concat('spec-kb@sha256:', Hex, A),
    atom_length(Hex, 64),
    atom_codes(Hex, Cs),
    forall(member(C, Cs), ( between(0'0, 0'9, C) ; between(0'a, 0'f, C) )).

% ---------------------------------------------------------------------
% view questions (D24)
% ---------------------------------------------------------------------
% orbit-kb view questions [--dir KB]... [--ledger FILE] [--out F]: one
% static HTML page of what blocks done in each KB (with its pin stamp)
% and of the owner's asks from a JSON export of the flow ledger. It
% reads only. It takes no lock and writes no KB file.

take_dirs([], [], []).
take_dirs(['--'|As], [], ['--'|As]) :- !.
take_dirs(['--dir', D|As], [D|Ds], Rest) :- !, take_dirs(As, Ds, Rest).
take_dirs(['--dir'], _, _) :- !, usage_error("The option --dir needs a directory.", []).
take_dirs([A|As], Ds, Rest) :-
    sub_atom(A, 0, _, _, '--dir='), !,
    sub_atom(A, 6, _, 0, D),
    Ds = [D|Ds1], take_dirs(As, Ds1, Rest).
take_dirs([A|As], Ds, [A|Rest]) :- take_dirs(As, Ds, Rest).

cmd_view(Dirs0, Args, Code) :-
    parse_opts(Args, ['--ledger'-value, '--out'-value, '--owner'-value], Pos, Opts),
    (   Pos == [] -> usage_error("view needs a view name: orbit-kb view questions [--dir KB]... [--ledger FILE] [--out F].", [])
    ;   Pos == [questions] -> true
    ;   usage_error("view takes the one view name questions.", [])
    ),
    (   memberchk('--ledger'-LF, Opts) -> view_ledger(LF, Rows), view_owner(Opts, Rows, Owner), view_owned(Rows, Owner, Asks), Led = some(Asks) ; Led = none ),
    (   Dirs0 == [] -> resolve_kb(none, D0), Dirs = [D0]
    ;   maplist([D, R]>>resolve_kb(some(D), R), Dirs0, Dirs)
    ),
    lib_dir(Lib),
    maplist(view_kb_section(Lib), Dirs, Secs),
    atomic_list_concat(Secs, '\n', SecsText),
    view_ledger_section(Led, LedText),
    view_css(Css),
    format(string(Page),
"<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Open questions</title>
<style>~w</style>
</head>
<body>
<h1>Open questions</h1>
<p class=\"options-note\">The options of a question come from the KB's defaults (its default answer and an answer that an agent recorded) and from its option facts (each with what it changes). Other means an answer that is not listed. The page adds no option of its own.</p>
~w
~w
</body>
</html>
", [Css, SecsText, LedText]),
    (   memberchk('--out'-Out, Opts)
    ->  absolute_file_name(Out, Abs),
        catch(write_atomic(Abs, Page), E,
              ( err_text(E, M),
                die(2, ["Cannot write the page " + Abs + ": " + M,
                        "Fix: give a path in a directory that exists and that you can write."] >> fix_lines) ))
    ;   set_stream(user_output, encoding(utf8)),
        write(Page)
    ),
    Code = 0.

view_css("body{font-family:sans-serif;max-width:60em;margin:2em auto;padding:0 1em;line-height:1.4}section{border:1px solid #888;border-radius:6px;padding:.5em 1em;margin:1em 0}li.item,li.ask{margin:.8em 0;padding:.4em;border-left:4px solid #888;list-style:none}.ref .kbid{font-family:monospace;color:#555}.default,.age{font-weight:bold}.stamp{font-family:monospace;font-size:.8em;word-break:break-all}").

view_ledger(File, Asks) :-
    (   exists_file(File) -> true
    ;   usage_error("The ledger file ~w does not exist.", [File])
    ),
    catch(setup_call_cleanup(open(File, read, S, [encoding(utf8)]),
                             json_read_dict(S, J, [null(null)]),
                             close(S)),
          E, ( err_text(E, M), usage_error("The ledger file ~w is not valid JSON: ~w", [File, M]) )),
    (   is_list(J) -> true
    ;   usage_error("The ledger file ~w must hold one JSON array of objects.", [File])
    ),
    forall(nth1(I, J, X), view_ledger_row(File, I, X)),
    Asks = J.

% view_owner(+Opts, +Rows, -Owner) (D24 C5): --owner, else the owner key of the first row that has one, else me.
view_owner(Opts, Rows, Owner) :-
    (   memberchk('--owner'-O, Opts) -> atom_string(O, Owner)
    ;   member(X, Rows), get_dict(owner, X, O0), string(O0) -> Owner = O0
    ;   Owner = "me"
    ).

view_owned(Rows, Owner, Asks) :-
    findall(X, ( member(X, Rows), X.kind == "ask", memberchk(X.status, ["open", "waiting"]), X.waits_on == Owner ), Asks).

view_ledger_row(File, I, X) :-
    (   is_dict(X) -> true ; usage_error("Ledger ~w, item ~w: not an object.", [File, I]) ),
    forall(member(K, [id, kind, title, status]),
           (   get_dict(K, X, V), string(V) -> true
           ;   usage_error("Ledger ~w, item ~w: the key ~w is missing or is not a string.", [File, I, K])
           )),
    (   get_dict(waits_on, X, W), ( W == null ; string(W) ) -> true
    ;   usage_error("Ledger ~w, item ~w: waits_on must be a string or null.", [File, I])
    ),
    (   get_dict(age_days, X, Age), integer(Age), Age >= 0 -> true
    ;   usage_error("Ledger ~w, item ~w: age_days must be a whole number, 0 or more.", [File, I])
    ).

view_ledger_section(Led, Text) :- view_ledger_section(static, Led, Text).
view_ledger_section(_, none, "").
view_ledger_section(Mode, some(Asks), Text) :-
    findall(L, ( member(X, Asks), view_ask_html(Mode, X, L) ), Ls),
    (   Ls == [] -> Body = "<p>No ask waits on the owner.</p>"
    ;   atomic_list_concat(Ls, '\n', B0), format(string(Body), "<ul>\n~w\n</ul>", [B0])
    ),
    format(string(Text), "<section class=\"ledger\">\n<h2>Asks that wait on you</h2>\n~w\n</section>", [Body]).

view_ask_html(Mode, X, L) :-
    esc(X.id, Id), esc(X.title, T), esc(X.age_days, Age),
    % D26 S7: the server shows, read-only, the hubflow command that answers the ask.
    (   Mode = serve(_)
    ->  format(string(Cmd), "python3 .claude/scripts/hubflow.py --by human close ~w --reason done --note 'YOUR ANSWER'", [X.id]),
        esc(Cmd, CmdH),
        format(string(Hf), " <p>Answer it in the hub: <code class=\"hubflow\">~w</code></p>", [CmdH])
    ;   Hf = ""
    ),
    format(string(L), "<li class=\"ask\" data-id=\"~w\"><span class=\"title\">~w</span> <span class=\"age\">~w days</span>~w</li>", [Id, T, Age, Hf]).

view_kb_section(Lib, Dir, Html) :- view_kb_section(static, Lib, Dir, Html).
view_kb_section(Mode, Lib, Dir, Html) :-
    load_kb(Dir, Lib, KB),
    answer_gate(KB),
    directory_file_path(Dir, 'kb.pl', KbFile),
    sha256_file(KbFile, Digest),
    atom_concat('spec-kb@', Digest, Stamp),
    esc(Stamp, StampH),
    kb_engine(KB, Eng),
    eng_all(Eng, [X], blocking(X), Xs),
    (   Xs == [] -> Body0 = "<p>Nothing blocks done.</p>"
    ;   maplist(view_item_html(Mode, Dir, Eng), Xs, Is),
        atomic_list_concat(Is, '\n', B0),
        format(string(Body0), "<ul class=\"items\">\n~w\n</ul>", [B0])
    ),
    (   Mode = serve(_) -> view_answered_html(Eng, AnsH) ; AnsH = "" ),
    string_concat(Body0, AnsH, Body),
    (   eng_all(Eng, [RT], request(_, RT), [RT1|_]), txt(RT1, RT2), split_string(RT2, "\n", " \t", [L1|_]), L1 \== "" -> Label = L1
    ;   file_base_name(Dir, Label)
    ),
    esc(Label, LabelH),
    format(string(Html), "<section class=\"kb\" data-stamp=\"~w\">\n<h2><span class=\"kblabel\">~w</span> <span class=\"stamp\">~w</span></h2>\n~w\n</section>", [StampH, LabelH, StampH, Body]).

view_ref(Id, Text, Html) :-
    esc(Id, I), esc(Text, T),
    format(string(Html), "<span class=\"ref\"><span class=\"kbid\">~w</span> <span class=\"kbtext\">~w</span></span>", [I, T]).

% view_xtext(+Eng, +X, -Text): the text of a claim, a question, or a change; of a check, the text of its claim.
view_xtext(Eng, X, T) :-
    (   eng_all(Eng, [T0], claim(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [T0], question(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [C], check(X, C), [C1|_]), eng_all(Eng, [T0], claim(C1, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [T0], change(X, T0), [T1|_]) -> txt(T1, T)
    ;   T = "(no text is recorded)"
    ).

% view_xclaim(+Eng, +X, -C): the claim that item X blocks, when it has one.
view_xclaim(Eng, X, C) :-
    (   eng_all(Eng, [], claim(X, _, _), [_|_]) -> C = X
    ;   eng_all(Eng, [C0], question(X, C0, _), [C1|_]) -> C = C1
    ;   eng_all(Eng, [C0], check(X, C0), [C1|_]) -> C = C1
    ).

view_kind_label(to_ask, "Question to ask").
view_kind_label(supersede_cycle, "Claim that replaces itself").
view_kind_label(past_due, "Past due").
view_kind_label(under, "Claim not fulfilled").
view_kind_label(over, "Change that serves no claim").
view_kind_label(burn_open, "Claim that needs a Lean proof").
view_kind_label(flare_open, "Claim that needs an approved demo").
view_kind_label(no_claim, "No current claim").
view_kind_label(check_failing, "Check that failed").
view_kind_label(check_unrun, "Check that never ran").
view_kind_label(waiver_lapsed, "Waiver that lapsed").
view_kind_label(project_conflict, "Draft that conflicts with the tracker").
view_kind_label(project_kb_unclean, "Project KB that does not load clean").

% view_blocking_sentence(+Eng, +Item, -Text) (T18 c4): the sentence of show blocking for Item,
% the text after "- KIND ID: " (or "- KIND: "). The project kinds (D23 P5, P8) use it.
view_blocking_sentence(Eng, Item, Text) :-
    blocking_line(_, Eng, Item, Line0),
    atom_string(Line0, Line),
    (   sub_string(Line, B, 2, _, ": ") -> S is B + 2, sub_string(Line, S, _, 0, Text)
    ;   Text = Line
    ).

view_item_html(Mode, Dir, Eng, Item, Html) :-
    (   atom(Item) -> Kind = Item, Id = ''
    ;   Item =.. [Kind, Id]
    ),
    (   view_kind_label(Kind, Label) -> true ; Label = "Blocking item" ),
    % the subject: its text, and the claim it blocks
    (   Kind == waiver_lapsed
    ->  (   eng_all(Eng, [X, R], attest(Id, waiver, _, waive(X, _, R), _, _), [[X1, R1]|_])
        ->  txt(R1, T0), ( T0 == '' -> view_xtext(Eng, X1, Text) ; Text = T0 ),
            ( view_xclaim(Eng, X1, Cl) -> true ; true )
        ;   Text = "(a waiver)"
        )
    ;   Kind == no_claim
    ->  Text = "Add a claim; the work is not done without one."
    ;   memberchk(Kind, [project_conflict, project_kb_unclean])
    ->  view_blocking_sentence(Eng, Item, Text)
    ;   view_xtext(Eng, Id, Text),
        ( view_xclaim(Eng, Id, Cl) -> true ; true )
    ),
    (   Id == '' -> Ref = "", Plain = Text
    ;   view_ref(Id, Text, Ref0), format(string(Ref), "~w", [Ref0]), Plain = ""
    ),
    esc(Label, LabelH), esc(Plain, PlainH),
    esc(Kind, KindH), esc(Id, IdH),
    (   nonvar(Cl)
    ->  eng_all(Eng, [CT], claim(Cl, _, CT), [CT1|_]), txt(CT1, CTT),
        view_ref(Cl, CTT, ClRef),
        format(string(Blocks), "<p>Blocks: <span class=\"blocks\">~w</span></p>", [ClRef]),
        eng_all(Eng, [Cite], cites(Cl, Cite), Cites),
        findall(S, ( member(Ci, Cites), esc(Ci, CiH),
                     format(string(S), "<blockquote class=\"cited\">~w</blockquote>", [CiH]) ), CiS),
        atomic_list_concat(CiS, '', CitedH)
    ;   Blocks = "", CitedH = ""
    ),
    (   Kind == to_ask -> view_question_html(Mode, Dir, Eng, Id, QHtml) ; QHtml = "" ),
    format(string(Html), "<li class=\"item\" data-kind=\"~w\" data-id=\"~w\">\n<p>~w: ~w~w</p>\n~w\n~w\n~w\n</li>",
           [KindH, IdH, LabelH, Ref, PlainH, Blocks, CitedH, QHtml]).

% The default and the options of a question (D24 C7): the default, an answer by an agent,
% each option/3 text, and other. Each option has its effect when the KB records one.
view_question_html(Mode, Dir, Eng, Q, Html) :-
    (   eng_all(Eng, [A], assumed(Q, A), [A1|_]) -> plain_text(A1, Def) ; Def = none ),
    ( nonvar(Def), Def \== none -> HasDef = true ; HasDef = false ),
    esc(Def, DefH),
    format(string(DefLine), "<p>Default: <span class=\"default\">~w</span></p>", [DefH]),
    eng_all(Eng, [A2, By], answer(Q, A2, By), Ans),
    findall(AT, ( member([A3, By3], Ans), By3 \== human, plain_text(A3, AT), ( HasDef == false ; AT \== Def ) ), Ats0),
    list_to_set(Ats0, Ats),
    eng_all(Eng, [OT, OE], option(Q, OT, OE), OFs0),
    findall(T-E, ( member([T0, E0], OFs0), plain_text(T0, T), plain_text(E0, E) ), OFs),
    findall(src(default, Def), HasDef == true, DL),
    findall(src(answer, AT), member(AT, Ats), AL),
    findall(T0, ( member(T0-_, OFs), \+ memberchk(src(_, T0), DL), \+ memberchk(src(_, T0), AL) ), Ots0),
    list_to_set(Ots0, Ots),
    findall(src(option, T0), member(T0, Ots), OL),
    append([DL, AL, OL], Srcs),
    findall(L, ( member(src(Src, T), Srcs), view_option(Src, T, OFs, L) ), Ls0),
    view_option(other, other, [], OtherL),
    append(Ls0, [OtherL], Ls),
    atomic_list_concat(Ls, '\n', OsT),
    (   OFs == []
    ->  Note = "<p class=\"no-effects\">No option effects are recorded for this question.</p>"
    ;   Note = ""
    ),
    (   Mode = serve(Token)
    ->  findall(T, member(src(_, T), Srcs), Ts0), list_to_set(Ts0, Ts),
        view_answer_form(Token, Dir, Q, Ts, Form)
    ;   Form = ""
    ),
    format(string(Html), "~w\n<ul class=\"options\">\n~w\n</ul>\n~w~w", [DefLine, OsT, Note, Form]).

% view_answer_form(+Token, +Dir, +Q, +Texts, -Html) (D26 S3): the answer form of a to_ask
% question in the served page: one radio choice per option text (as listed above), then other,
% and a free text. The hidden fields carry the token of this run, the KB, and the question.
view_answer_form(Token, Dir, Q, Texts, Html) :-
    append(Texts, ["other"], All),
    findall(R, ( member(T, All), esc(T, TH),
                 format(string(R), "<label><input type=\"radio\" name=\"choice\" value=\"~w\"> ~w</label>", [TH, TH]) ), Rs),
    atomic_list_concat(Rs, '\n', RsT),
    esc(Token, TokH), esc(Dir, DirH), esc(Q, QH),
    format(string(Html),
"<form class=\"answer\" method=\"post\" action=\"/answer\">
<input type=\"hidden\" name=\"token\" value=\"~w\"><input type=\"hidden\" name=\"kb\" value=\"~w\"><input type=\"hidden\" name=\"q\" value=\"~w\">
~w
<label>Or write the answer (with other): <input type=\"text\" name=\"text\" size=\"60\"></label>
<button type=\"submit\">Record my answer</button>
</form>", [TokH, DirH, QH, RsT]).

% view_answered_html(+Eng, -Html) (D26 S3): the questions that a human answered, each with the
% answer, and its default marked when the answer defeats it.
view_answered_html(Eng, Html) :-
    eng_all(Eng, [Q, A], answer(Q, A, human), QAs0),
    list_to_set(QAs0, QAs),
    findall(L, ( member([Q, A], QAs), view_answered_li(Eng, Q, A, L) ), Ls),
    (   Ls == [] -> Html = ""
    ;   atomic_list_concat(Ls, '\n', LsT),
        format(string(Html), "\n<h3>Answered by a human</h3>\n<ul class=\"answered-list\">\n~w\n</ul>", [LsT])
    ).

view_answered_li(Eng, Q, A, L) :-
    view_xtext(Eng, Q, QT), view_ref(Q, QT, Ref),
    plain_text(A, AT), esc(AT, AH),
    (   eng_true(Eng, defeated(Q)), eng_all(Eng, [D], assumed(Q, D), [D1|_])
    ->  plain_text(D1, DT), esc(DT, DH),
        format(string(Def), " <span class=\"defeated\">The default ~w is defeated.</span>", [DH])
    ;   Def = ""
    ),
    esc(Q, QH),
    format(string(L), "<li class=\"answered\" data-id=\"~w\">~w Answer: <span class=\"answer\">~w</span>~w</li>", [QH, Ref, AH, Def]).

view_option(Src, Text, OFs, L) :-
    esc(Text, T),
    (   Src == other -> Eff = ""
    ;   OFs == [] -> Eff = ""
    ;   memberchk(Text-E, OFs) -> esc(E, EH), format(string(Eff), " <span class=\"effect\">~w</span>", [EH])
    ;   Eff = " <span class=\"effect none\">No effect is recorded.</span>"
    ),
    format(string(L), "<li class=\"option\" data-source=\"~w\"><span class=\"optiontext\">~w</span>~w</li>", [Src, T, Eff]).

% ---------------------------------------------------------------------
% serve questions (D26)
% ---------------------------------------------------------------------
% orbit-kb serve questions [--dir KB]... [--root DIR] [--ledger FILE [--owner KEY]] [--port N]:
% a local server for the page of view questions. Each GET of / reads the KBs and the ledger
% again. A POST of /answer records one human answer through `orbit-kb add --by human`, run as
% a child process, under the writer lock. The server listens on 127.0.0.1 only, refuses a Host
% other than 127.0.0.1 or localhost, and needs the token of this run on a POST. It keeps no
% state of its own and never uses --take. Ctrl-C stops it.

:- dynamic serve_conf/2.

serve_default_port(8737).

cmd_serve(Dirs0, Args, Code) :-
    parse_opts(Args, ['--ledger'-value, '--owner'-value, '--root'-value, '--port'-value], Pos, Opts),
    (   Pos == [] -> usage_error("serve needs a view name: orbit-kb serve questions [--dir KB]... [--root DIR] [--ledger FILE] [--port N].", [])
    ;   Pos == [questions] -> true
    ;   usage_error("serve takes the one view name questions.", [])
    ),
    (   memberchk('--port'-PA, Opts)
    ->  (   atom_number(PA, Port), integer(Port), between(0, 65535, Port) -> true
        ;   usage_error("--port takes a whole number from 0 to 65535. It is ~w.", [PA])
        )
    ;   serve_default_port(Port)
    ),
    (   memberchk('--root'-R0, Opts)
    ->  (   exists_directory(R0) -> absolute_file_name(R0, Root), RootOpt = some(Root)
        ;   usage_error("The --root directory ~w does not exist.", [R0])
        )
    ;   RootOpt = none
    ),
    (   memberchk('--ledger'-LF0, Opts)
    ->  absolute_file_name(LF0, LF), view_ledger(LF, _), LedOpt = some(LF)    % fail early on a bad file
    ;   LedOpt = none
    ),
    (   Dirs0 == [], RootOpt == none -> resolve_kb(none, D0), Dirs = [D0]
    ;   maplist([D, Rd]>>resolve_kb(some(D), Rd), Dirs0, Dirs)
    ),
    (   memberchk('--owner'-Ow, Opts) -> OwnOpt = ['--owner'-Ow] ; OwnOpt = [] ),
    serve_token(Token),
    (   getenv('ORBIT_KB_WRITER', W0), W0 \== '' -> Writer = W0 ; Writer = human ),
    orbit_script(Script),
    retractall(serve_conf(_, _)),
    forall(member(K-V, [dirs-Dirs, root-RootOpt, ledger-LedOpt, owner-OwnOpt, token-Token,
                        writer-Writer, script-Script]),
           assertz(serve_conf(K, V))),
    use_module(library(http/thread_httpd)),
    ( Port == 0 -> true ; BindPort = Port ),     % an unbound port: the system picks a free one
    context_module(Mod),
    catch(thread_httpd:http_server(Mod:serve_request, [port('127.0.0.1':BindPort), workers(1), silent(true)]), E,
          ( err_text(E, M),
            die(2, ["Cannot listen on 127.0.0.1:" + Port + ": " + M,
                    "Fix: give another port with --port N."] >> fix_lines) )),
    format("Serving the questions at http://127.0.0.1:~w/ . Answers are written as ~w. Ctrl-C stops.~n", [BindPort, Writer]),
    flush_output(user_output),
    on_signal(int, _, serve_halt),
    on_signal(term, _, serve_halt),
    repeat, thread_get_message(_), fail,
    Code = 0.

serve_halt(_) :- halt(0).

% serve_token(-Token): 32 hex digits from a random source, new for each run.
serve_token(Token) :-
    (   catch(( use_module(library(crypto)), crypto:crypto_n_random_bytes(16, Bs) ), _, fail)
    ->  true
    ;   catch(setup_call_cleanup(open('/dev/urandom', read, S, [type(binary)]),
                                 ( length(Bs, 16), maplist([B]>>get_byte(S, B), Bs) ),
                                 close(S)), _, fail)
    ->  true
    ;   die(2, ["Cannot make the token of the run: no random source.", "Fix: install the SWI-Prolog ssl package."])
    ),
    maplist([B, H]>>format(atom(H), "~|~`0t~16r~2+", [B]), Bs, Hs),
    atomic_list_concat(Hs, Token).

% serve_route(+Method, +Path, +HostOk, +TokenOk, -Action) (D26 S5, S6): the one place that
% decides what a request does. Only `answer` writes, and only after the checks of serve_answer/2.
serve_route(_, _, false, _, forbidden) :- !.
serve_route(get, '/', true, _, page) :- !.
serve_route(post, '/answer', true, true, answer) :- !.
serve_route(post, '/answer', true, false, forbidden) :- !.
serve_route(_, P, true, _, bad_method) :- memberchk(P, ['/', '/answer']), !.
serve_route(_, _, true, _, not_found).

serve_host_ok(Req, true) :-
    memberchk(host(H), Req), memberchk(H, ['127.0.0.1', localhost]), !.
serve_host_ok(_, false).

serve_request(Req) :-
    catch(serve_request_(Req), E, serve_failed(E)).

serve_request_(Req) :-
    memberchk(method(M), Req), memberchk(path(P), Req),
    serve_host_ok(Req, HostOk),
    (   M == post, P == '/answer', HostOk == true
    ->  serve_form(Req, Form),
        serve_conf(token, Tok),
        ( serve_field(Form, token, T), atom_string(Tok, T) -> TokOk = true ; TokOk = false )
    ;   Form = [], TokOk = false
    ),
    serve_route(M, P, HostOk, TokOk, Action),
    serve_act(Action, Form).

serve_act(page, _) :- serve_page("", Page), serve_reply(200, Page).
serve_act(answer, Form) :- serve_answer(Form, R),
    (   R = ok -> format("Status: 303~nLocation: /~nContent-type: text/html; charset=UTF-8~n~n<p>Recorded. <a href=\"/\">Back to the questions</a></p>~n", [])
    ;   R = refused(St, Msg) -> serve_message_page(St, Msg)
    ).
serve_act(forbidden, _) :- serve_message_page(403, "Forbidden. The server answers only requests to 127.0.0.1 or localhost, and a POST needs the token of the page of this run. Reload the page.").
serve_act(bad_method, _) :- serve_message_page(405, "This method is not allowed here. GET / shows the page; the forms POST to /answer.").
serve_act(not_found, _) :- serve_message_page(404, "There is no such page. GET / shows the questions.").

serve_failed(E) :-
    (   E = orbit_error(_, Lines) -> atomic_list_concat(Lines, ' ', M) ; err_text(E, M) ),
    catch(serve_message_page(500, M), _, true).

serve_form(Req, Form) :-
    (   memberchk(content_length(N), Req), N > 65536
    ->  Form = []
    ;   memberchk(content_type(CT), Req), sub_atom(CT, 0, _, _, 'application/x-www-form-urlencoded'),
        memberchk(content_length(N), Req), memberchk(input(In), Req)
    ->  % read the body here: no HTTP client library (D25 T6; TS14)
        catch(( set_stream(In, encoding(octet)), read_string(In, N, Body),
                uri_query_components(Body, Form0) ), _, Form0 = []),
        ( is_list(Form0) -> Form = Form0 ; Form = [] )
    ;   Form = []
    ).

serve_field(Form, K, V) :- memberchk(K=V0, Form), atom_string(V0, V).

serve_reply(Status, Page) :-
    format("Status: ~w~nContent-type: text/html; charset=UTF-8~nCache-Control: no-store~n~n", [Status]),
    set_stream(current_output, encoding(utf8)),
    write(Page).

serve_message_page(Status, Msg) :-
    esc(Msg, MH),
    format(string(Page), "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Open questions</title>\n</head>\n<body>\n<p class=\"message error\">~w</p>\n<p><a href=\"/\">Back to the questions</a></p>\n</body>\n</html>\n", [MH]),
    serve_reply(Status, Page).

% serve_kbs(-Groups): the KBs to serve now, as group(Label, ProjectDir|none, Dirs). The --dir
% KBs in the order given, then the KBs under --root, sorted by path. A KB that a spec KB names
% with project_kb/1, or that uses the project module and has no project_kb and no claim, is a
% project KB: it names a group and has no section of its own.
serve_kbs(Groups) :-
    serve_conf(dirs, Dirs0), serve_conf(root, RootOpt),
    (   RootOpt = some(Root) -> serve_find_kbs(Root, Found) ; Found = [] ),
    append(Dirs0, Found, All0),
    maplist([D, A]>>absolute_file_name(D, A), All0, All1),
    list_to_set(All1, All),
    findall(D-P, ( member(D, All), serve_kb_project(D, P) ), DPs),
    findall(P, member(_-some(P), DPs), Ps0), list_to_set(Ps0, Ps),
    findall(D, ( member(D, All), ( memberchk(D, Ps) ; serve_is_project_kb(D) ) ), PKs),
    findall(D-P, ( member(D-P, DPs), \+ memberchk(D, PKs) ), Specs),
    findall(P, member(_-some(P), Specs), GPs0), list_to_set(GPs0, GPs),
    findall(L-group(L, some(P), Ds),
            ( member(P, GPs), serve_project_label(P, L),
              findall(D, member(D-some(P), Specs), Ds) ),
            LGs0),
    keysort(LGs0, LGs), pairs_values(LGs, PGroups),
    findall(D, member(D-none, Specs), NDs),
    (   NDs == [] -> Groups = PGroups ; append(PGroups, [group("no project", none, NDs)], Groups) ).

serve_find_kbs(Root, Dirs) :-
    findall(D, serve_walk(Root, 0, D), Ds0), sort(Ds0, Dirs).

serve_walk(Dir, _, Dir) :- directory_file_path(Dir, 'kb.pl', F), exists_file(F).
serve_walk(Dir, Depth, Found) :-
    Depth < 8,
    catch(directory_files(Dir, Es), _, fail),
    member(E, Es), \+ sub_atom(E, 0, _, _, '.'), E \== runs,
    directory_file_path(Dir, E, Sub), exists_directory(Sub),
    D1 is Depth + 1,
    serve_walk(Sub, D1, Found).

serve_kb_items(Dir, Items) :-
    directory_file_path(Dir, 'kb.pl', F),
    catch(read_source_file(kb, F, Items), _, Items = []).

serve_kb_project(Dir, P) :-
    serve_kb_items(Dir, Items),
    (   kb_term(Items, project_kb(P0)), atom(P0)
    ->  ( is_absolute_file_name(P0) -> P1 = P0 ; directory_file_path(Dir, P0, P1) ),
        absolute_file_name(P1, PA), P = some(PA)
    ;   P = none
    ).

serve_is_project_kb(Dir) :-
    serve_kb_items(Dir, Items),
    items_uses(Items, Us), memberchk(project, Us),
    \+ kb_term(Items, project_kb(_)),
    \+ kb_term(Items, claim(_, _, _)).

serve_project_label(P, Label) :-
    serve_kb_items(P, Items),
    (   kb_term(Items, request(_, RT)), txt(RT, RT2), split_string(RT2, "\n", " \t", [L1|_]), L1 \== ""
    ->  Label = L1
    ;   file_base_name(P, B), atom_string(B, Label)
    ).

serve_page(Msg, Page) :-
    serve_conf(token, Token), lib_dir(Lib),
    serve_kbs(Groups),
    findall(G, ( member(group(L, _, Ds), Groups), serve_group_html(Token, Lib, L, Ds, G) ), Gs),
    (   Gs == [] -> GsText = "<p class=\"message\">No KB was found.</p>" ; atomic_list_concat(Gs, '\n', GsText) ),
    serve_conf(ledger, LedOpt), serve_conf(owner, OwnOpt),
    (   LedOpt = some(LF)
    ->  catch(( view_ledger(LF, Rows), view_owner(OwnOpt, Rows, Owner), view_owned(Rows, Owner, Asks),
                view_ledger_section(serve(Token), some(Asks), LedText) ),
              E, ( serve_err_text(E, EM), esc(EM, EMH),
                   format(string(LedText), "<section class=\"ledger\"><h2>Asks that wait on you</h2><p class=\"message error\">~w</p></section>", [EMH]) ))
    ;   LedText = ""
    ),
    view_css(Css),
    (   Msg == "" -> MsgH = "" ; esc(Msg, M0), format(string(MsgH), "<p class=\"message\">~w</p>", [M0]) ),
    format(string(Page),
"<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Open questions</title>
<style>~w section.project{border-width:2px}form.answer{margin:.5em 0;padding:.4em;background:#f4f4f4}form.answer label{display:block}</style>
</head>
<body>
<h1>Open questions</h1>
<p class=\"serve-note\">Live: each reload reads the KBs again. An answer is recorded as a human answer (orbit-kb add --by human), under the writer lock of its KB.</p>
<p class=\"options-note\">The options of a question come from the KB's defaults (its default answer and an answer that an agent recorded) and from its option facts (each with what it changes). Other means an answer that is not listed. The page adds no option of its own.</p>
~w
~w
~w
</body>
</html>
", [Css, MsgH, GsText, LedText]).

serve_group_html(Token, Lib, Label, Dirs, Html) :-
    findall(S, ( member(D, Dirs), serve_kb_html(Token, Lib, D, S) ), Ss),
    atomic_list_concat(Ss, '\n', SsT),
    esc(Label, LH),
    format(string(Html), "<section class=\"project\">\n<h2 class=\"projectlabel\">~w</h2>\n~w\n</section>", [LH, SsT]).

serve_kb_html(Token, Lib, Dir, Html) :-
    catch(view_kb_section(serve(Token), Lib, Dir, Html), E,
          ( serve_err_text(E, M), esc(M, MH), esc(Dir, DH),
            format(string(Html), "<section class=\"kb error\">\n<h2><span class=\"kblabel\">~w</span></h2>\n<p class=\"message error\">~w</p>\n</section>", [DH, MH]) )).

serve_err_text(orbit_error(_, Lines), M) :- !, atomic_list_concat(Lines, ' ', M).
serve_err_text(E, M) :- err_text(E, M).

% serve_answer(+Form, -Result) (D26 S3, S4): ok, or refused(Status, Message). Nothing is
% written unless every check passes; the write is one `orbit-kb add` child process.
serve_answer(Form, R) :-
    serve_kbs(Groups),
    findall(D, ( member(group(_, _, Ds), Groups), member(D, Ds) ), Served),
    (   \+ ( serve_field(Form, kb, KS), atom_string(KA, KS), memberchk(KA, Served) )
    ->  R = refused(400, "The form names a KB that this server does not serve. Reload the page.")
    ;   serve_field(Form, kb, KS), atom_string(Dir, KS),
        (   \+ ( serve_field(Form, q, QS), QS \== "" )
        ->  R = refused(400, "The form names no question. Reload the page.")
        ;   serve_field(Form, q, QS), atom_string(Q, QS),
            lib_dir(Lib), load_kb(Dir, Lib, KB), answer_gate(KB), kb_engine(KB, Eng),
            (   \+ eng_true(Eng, to_ask(Q))
            ->  format(string(M), "The question ~w is not open any more. Reload the page.", [Q]),
                R = refused(409, M)
            ;   serve_answer_text(Form, Text),
                (   Text == ""
                ->  R = refused(400, "Choose an option, or choose other and write the answer.")
                ;   string_length(Text, Len), Len > 2000
                ->  R = refused(400, "The answer is longer than 2000 characters.")
                ;   serve_write(Dir, Q, Text, R)
                )
            )
        )
    ).

serve_answer_text(Form, Text) :-
    ( serve_field(Form, choice, C0) -> true ; C0 = "" ),
    ( serve_field(Form, text, T0) -> true ; T0 = "" ),
    split_string(C0, "", " \t\r\n", [C]), split_string(T0, "", " \t\r\n", [T]),
    (   C \== "", C \== "other" -> Text = C ; Text = T ).

serve_write(Dir, Q, Text, R) :-
    serve_conf(writer, W), serve_conf(script, Script),
    (   kb_uses_project(Dir) -> lock_state(Dir, LS) ; LS = none_needed ),
    (   LS = held(H, Since), H \== W
    ->  format(string(M), "The KB is locked. It is held by ~w since ~w. Nothing was written. The server never takes a lock: ask ~w to run orbit-kb release, then answer again.", [H, Since, H]),
        R = refused(409, M)
    ;   LS = bad(Why)
    ->  format(string(M), "The writer lock of the KB cannot be read: ~w Nothing was written.", [Why]),
        R = refused(409, M)
    ;   atom_string(A, Text),
        format(string(Fact), "~q", [answer(Q, A, human)]),
        serve_child(Script, W, ['--dir', Dir, add, Fact, '--by', human], Exit, Err),
        (   Exit == 0
        ->  ( LS == none -> serve_child(Script, W, ['--dir', Dir, release], _, _) ; true ),
            R = ok
        ;   split_string(Err, "", " \n", [E1]),
            format(string(M), "Nothing was written. orbit-kb said: ~w", [E1]),
            R = refused(409, M)
        )
    ).

serve_child(Script, W, Args, Exit, Err) :-
    process_create(Script, Args,
                   [ environment(['ORBIT_KB_WRITER'=W]), stdin(null),
                     stdout(null), stderr(pipe(E)), process(P) ]),
    read_string(E, _, Err), close(E),
    process_wait(P, St),
    ( St = exit(Exit) -> true ; Exit = 2 ).

% ---------------------------------------------------------------------
% subject
% ---------------------------------------------------------------------

sha256_file(File, Digest) :-
    (   have_crypto,
        catch(crypto:crypto_file_hash(File, Hex, [algorithm(sha256)]), _, fail)
    ->  true
    ;   catch(( process_create(path(sha256sum), [File], [stdout(pipe(O)), stderr(null), process(P)]),
                read_string(O, _, Out), close(O), process_wait(P, exit(0)) ), _, fail),
        split_string(Out, " ", "", [HexS|_]),
        atom_string(Hex, HexS)
    ->  true
    ;   die(2, ["Cannot compute sha256. library(crypto) and sha256sum are both missing.", "Fix: install coreutils or the SWI-Prolog ssl package."])
    ),
    atom_concat('sha256:', Hex, Digest).

subject_abs(KB, Path, Abs) :-
    (   is_absolute_file_name(Path)
    ->  Abs = Path
    ;   kb_dir(KB, Dir), directory_file_path(Dir, Path, Abs)
    ).

stored_path(Dir, Abs, Stored) :-
    atom_concat(Dir, '/', DirS),
    (   atom_concat(DirS, Rel, Abs), Rel \== ''
    ->  Stored = Rel
    ;   Stored = Abs
    ).

% A relative PATH may be relative to the current directory or to the KB
% directory. If both exist and differ, the path is ambiguous.
subject_input_path(KB, Path, Abs) :-
    absolute_file_name(Path, A1),
    (   is_absolute_file_name(Path) -> A2 = A1 ; kb_dir(KB, D), directory_file_path(D, Path, A2) ),
    (   exists_file(A1), exists_file(A2), A1 \== A2
    ->  die(1, [ "The path " + Path + " is ambiguous.",
                 "It exists here (" + A1 + ") and in the KB directory (" + A2 + ").",
                 "Fix: give an absolute path." ] >> fix_lines)
    ;   exists_file(A1) -> Abs = A1
    ;   exists_file(A2) -> Abs = A2
    ;   die(1, ["The file " + Path + " does not exist, here or in the KB directory. Check the path."] >> fix_lines)
    ).

cmd_subject(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos = [Id, Path] -> true
    ;   usage_error("Give an id and a path: orbit-kb subject ID PATH.", [])
    ),
    subject_input_path(KB, Path, Abs),
    sha256_file(Abs, Digest),
    kb_dir(KB, Dir),
    stored_path(Dir, Abs, Stored),
    New = subject(Id, Stored, Digest),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    include(fact_item, Items, Facts),
    exclude([it(_, _, _, T, _, _)]>>(nonvar(T), T = subject(Id, _, _)), Facts, Others),
    build_env(Others, Ds, env(Ids, _, _, _)),
    (   ord_memberchk(Id, Ids)
    ->  reject(["The id " + Id + " is already used by another fact. Choose a new subject id."] >> fix_lines)
    ;   true
    ),
    clause_line(New, [], NewLine),
    term_text(New, NewText),
    kb_file(KB, KbFile),
    (   member(it(kb, _, _, T, _, From-To), Items), nonvar(T), T = subject(Id, _, _)
    ->  read_file_to_string(KbFile, S, [encoding(utf8)]),
        sub_string(S, 0, From, _, Pre),
        sub_string(S, To, _, 0, Post),
        atomic_list_concat([Pre, NewText, Post], S2),
        % D7: a temp file in the KB directory, then rename. A reader
        % sees the old kb.pl or the new one, never a part.
        write_atomic(KbFile, S2)
    ;   append_lines(KbFile, [NewLine])
    ),
    format("~w~n", [Digest]),
    Code = 0.

% ---------------------------------------------------------------------
% attest
% ---------------------------------------------------------------------

utc_now(A) :-
    get_time(T),
    stamp_date_time(T, D, 'UTC'),
    format_time(atom(A), '%Y-%m-%dT%H:%M:%SZ', D).

next_attest_id(Items, Ds, Id) :-
    include(fact_item, Items, Facts),
    build_env(Facts, Ds, env(Ids, FA, _, _)),
    findall(V, member(_-V, FA), Vs),
    append(Ids, Vs, All),
    findall(N, ( member(X, All), atom(X), atom_concat(a, NA, X),
                 atom_number(NA, N), integer(N) ),
            Ns),
    max_list([0|Ns], Max),
    N1 is Max + 1,
    format(atom(Id), "a~w", [N1]).

cmd_attest(KB, Args, Code) :-
    parse_opts(Args, ['--by'-value, '--id'-value], Pos, Opts),
    (   Pos = [Type, Subject, PredText] -> true
    ;   usage_error("Give a type, a subject, and a predicate: orbit-kb attest TYPE SUBJECT 'PREDICATE'.", [])
    ),
    opt(Opts, '--by', agent, By),
    (   By == script
    ->  reject(["Only orbit-kb run and orbit-kb prove write attestations by script."])
    ;   memberchk(By, [human, agent]) -> true
    ;   reject(["--by must be human or agent. It is " + By + "."] >> fix_lines)
    ),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    (   atype_of(ATs, Type, at(_, _, W, _, _, _, _)), W == [script]
    ->  script_use(Type, Use),
        reject(["Only " + Use + " writes attestations of type " + Type + "."] >> fix_lines)
    ;   true
    ),
    parse_one(PredText, P),
    (   P = ok(Pred0, _) -> true
    ;   P = err(M0), reject(["The predicate does not parse. " + M0 + " Check the brackets and quotes."] >> fix_lines)
    ),
    (   Pred0 == digest(current)
    ->  current_digest(KB, Items, Subject, D),
        Pred = digest(D)
    ;   Pred = Pred0
    ),
    (   memberchk('--id'-Id, Opts) -> true ; next_attest_id(Items, Ds, Id) ),
    utc_now(Now),
    T = attest(Id, Type, Subject, Pred, By, Now),
    NewItems = [it(new, '<arg>', 1, T, [], 0-0)],
    validate_new(KB, NewItems, Problems),
    (   Problems \== []
    ->  findall(S, ( member(diag(C, _, _, M), Problems), fmt(S, "~w: ~w", [C, M]) ), PL),
        reject(PL)
    ;   true
    ),
    late_vote_check(Items, Type, By, Pred),
    log_check(KB, Items, Type, Subject, Pred),
    clause_line(T, [], Line),
    kb_file(KB, KbFile),
    append_lines(KbFile, [Line]),
    format("~w~n", [Line]),
    Code = 0.

% log_check(+KB, +Items, +Type, +Subject, +Pred) (D18): a model_result
% verdict or mutation that the solver log clearly contradicts is refused.
% A log that is missing, unreadable, or not clear gives a NOTE and the
% result is accepted. calibration is never checked.
log_check(KB, Items, model_result, Subject, Pred) :-
    nonvar(Pred), log_claim(Pred, Res, Want), !,
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = subject(Subject, Path, _), atom(Path)
    ->  subject_abs(KB, Path, Abs),
        (   catch(read_file_to_string(Abs, Str, []), _, fail)
        ->  split_string(Str, "\n", "\r \t", Lines),
            log_class(Lines, Class),
            (   Class == none
            ->  ( fmt(M1, "the log ~w is not a clear TLC or z3 result", [Subject]), log_note(M1) )
            ;   log_shows(Class, Shows, Text),
                (   Shows \== Want
                ->  log_refuse(Subject, Res, Text)
                ;   true
                )
            )
        ;   ( fmt(M2, "the log file ~w is missing or cannot be read", [Abs]), log_note(M2) )
        )
    ;   ( fmt(M3, "there is no subject ~w with a file path", [Subject]), log_note(M3) )
    ).
log_check(_, _, _, _, _).

% log_claim(+Pred, -Result, -Want): what the result says the log shows.
% case: a violation or sat. nocase: holds or unsat.
log_claim(verdict(_, _, R), R, W) :- log_want(R, W).
log_claim(mutation(_, _, R), R, W) :- memberchk(R-W, [killed-case, survived-nocase]).

log_want(R, case)   :- memberchk(R, [reached, violated, sat]).
log_want(R, nocase) :- memberchk(R, [holds, unsat]).

log_class(Lines, Class) :-
    (   member(L, Lines), sub_string(L, _, _, _, "is violated") -> V = true ; V = false ),
    (   member(L, Lines), sub_string(L, _, _, _, "No error has been found") -> H = true ; H = false ),
    (   V-H == true-false -> Class = tlc_violated
    ;   V-H == false-true -> Class = tlc_holds
    ;   V-H \== false-false -> Class = none
    ;   findall(W, ( member(L, Lines), memberchk(L, ["sat", "unsat", "unknown"]), atom_string(W, L) ), Ws0),
        sort(Ws0, Ws),
        (   Ws = [sat] -> Class = z3_sat
        ;   Ws = [unsat] -> Class = z3_unsat
        ;   Class = none
        )
    ).

log_shows(tlc_violated, case,   "TLC reports a violation").
log_shows(tlc_holds,    nocase, "TLC reports no error").
log_shows(z3_sat,       case,   "the solver printed sat").
log_shows(z3_unsat,     nocase, "the solver printed unsat").

log_note(Msg) :-
    fmt(S, "NOTE: the log was not checked: ~w", [Msg]),
    format(user_error, "~w~n", [S]).

log_refuse(Subject, Res, Text) :-
    reject([ "The log " + Subject + " contradicts the result " + Res + ": " + Text + ".",
             "Fix: attest the result that the log shows, or run the solver again into a new log."
           ] >> fix_lines).

% late_vote_check(+Items, +Type, +By, +Pred) (D14): the agent's vote is
% sealed, so it must come before the human's vote. An agent vote in a
% round in which the human already voted is refused. This guards an
% honest mistake only: the agent can still read the human vote, or edit
% kb.pl by hand.
late_vote_check(Items, vote, agent, vote(R, _)) :-
    member(it(kb, _, _, T, _, _), Items), nonvar(T),
    T = attest(_, vote, _, vote(R1, _), human, _), R1 == R, !,
    reject([ "The human already voted in round " + R + ", so an agent vote in this round cannot be sealed.",
             "Fix: do not vote in this round. Say what you think in the discussion after the reveal.",
             "In the next round, vote before the human: vote(N, CHOICE) with a larger N."
           ] >> fix_lines).
late_vote_check(_, _, _, _).

% digest(current): the recorded digest of the subject. The file on disk
% must still have that digest, so an approval never names a file that
% changed since it was recorded.
current_digest(KB, Items, Subject, D) :-
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = subject(Subject, Path, D0), atom(Path)
    ->  subject_abs(KB, Path, Abs),
        (   exists_file(Abs)
        ->  sha256_file(Abs, Now),
            (   Now == D0
            ->  D = D0
            ;   reject([ "The file of subject " + Subject + " changed since its digest was recorded.",
                         "Fix: run orbit-kb subject " + Subject + " " + Abs + ", then review the file again."
                       ] >> fix_lines)
            )
        ;   reject([ "The file of subject " + Subject + " is missing: " + Abs + ".",
                     "Fix: restore the file, or record a new path with orbit-kb subject."
                   ] >> fix_lines)
        )
    ;   reject([ "There is no subject " + Subject + ", so digest(current) has no value.",
                 "Fix: record it first with orbit-kb subject " + Subject + " PATH."
               ] >> fix_lines)
    ).

% ---------------------------------------------------------------------
% run
% ---------------------------------------------------------------------

% run (D7): the command runs WITHOUT the KB lock, so a long check does
% not stall other writers. Its output goes to a private temp file in
% runs/. When it finishes, run takes the lock, chooses N, writes
% runs/N-CHECK.log with an exclusive create, chooses the attestation
% id, and appends the attestation. Runs are numbered in the order they
% finish. The time is the time at which the command finished. If run is
% killed before it takes the lock, nothing is recorded; at most its
% runs/.tmp-* file stays.
cmd_run(KB, Args, Code) :-
    (   append(Pre, ['--'|Cmd], Args), Cmd \== []
    ->  true
    ;   usage_error("Give a check and a command: orbit-kb run CHECK -- CMD [ARGS].", [])
    ),
    (   Pre = [Check] -> true
    ;   usage_error("Give one check id before --: orbit-kb run CHECK -- CMD [ARGS].", [])
    ),
    kb_items(KB, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = check(Check, _)
    ->  true
    ;   die(2, [ "There is no check " + Check + " in kb.pl.",
                 "Fix: add it with orbit-kb add 'check(" + Check + ", CLAIM)', or fix the id.",
                 "This is a usage error, not a failed run." ] >> fix_lines)
    ),
    Cmd = [Exe0|CmdArgs],
    (   sub_atom(Exe0, _, _, _, '/')
    ->  absolute_file_name(Exe0, ExeAbs),
        ( exists_file(ExeAbs) -> Exe = ExeAbs ; Exe = none )
    ;   ( absolute_file_name(path(Exe0), ExeP, [access(execute), file_errors(fail)]) -> Exe = ExeP ; Exe = none )
    ),
    (   Exe == none
    ->  die(2, ["The command " + Exe0 + " was not found.", "Fix: check the name and the PATH. Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    kb_dir(KB, Dir),
    directory_file_path(Dir, runs, RunsDir),
    make_directory_path(RunsDir),
    runs_tmp(RunsDir, TmpOut, OS),
    catch(process_create(Exe, CmdArgs, [stdin(null), stdout(stream(OS)), stderr(stream(OS)), process(P)]), E, true),
    close(OS),
    (   nonvar(E)
    ->  err_text(E, ET),
        die(2, ["Could not start the command: " + ET, "Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    run_wait(P, St),
    utc_now(Now),
    (   St = exit(EC) -> true
    ;   St = killed(Sig) -> EC is 128 + Sig
    ;   EC = 255
    ),
    ( EC =:= 0 -> Result = pass ; Result = fail ),
    atomic_list_concat(Cmd, ' ', CmdText0),
    split_string(CmdText0, "\n\r", "", CmdParts),
    atomic_list_concat(CmdParts, ' ', CmdText),
    read_file_to_string(TmpOut, Output, [encoding(utf8)]),
    with_kb_lock(Dir, record_run(KB, Check, Result, EC, Now, CmdText, Output, RunN, Log)),
    format("run ~w ~w ~w (exit ~w) log=~w~n", [RunN, Check, Result, EC, Log]),
    (   Result == fail
    ->  split_string(Output, "\n", "", OL0),
        ( append(OL1, [""], OL0) -> true ; OL1 = OL0 ),
        length(OL1, Len),
        ( Len > 40 -> Skip is Len - 40, length(Drop, Skip), append(Drop, Tail, OL1) ; Tail = OL1 ),
        length(Tail, TN),
        format("Last ~w line(s) of output:~n", [TN]),
        forall(member(TL, Tail), format("~w~n", [TL])),
        Code = 1
    ;   Code = 0
    ).

% run_wait(+P, -Status): wait for the command. SIGINT or SIGTERM to
% orbit-kb stops the command, records nothing, removes the temp file
% (cleanup_tmp/0), and exits 130 or 143.
run_wait(P, St) :-
    catch(setup_call_cleanup(run_signals_on(Old),
                             process_wait(P, St),
                             run_signals_off(Old)),
          orbit_signal(Sig),
          run_interrupted(P, Sig)).

run_signals_on(old(I, T)) :-
    on_signal(int, I, run_signal),
    on_signal(term, T, run_signal).

run_signals_off(old(I, T)) :-
    on_signal(int, _, I),
    on_signal(term, _, T).

run_signal(Sig) :- throw(orbit_signal(Sig)).

run_interrupted(P, Sig) :-
    catch(process_kill(P, term), _, true),
    catch(process_wait(P, _), _, true),
    (   memberchk(Sig, [term, 15]) -> Code = 143, Name = "SIGTERM"
    ;   Code = 130, Name = "SIGINT"
    ),
    die(Code, ["orbit-kb run stopped on " + Name + ". The command was stopped. Nothing was recorded."] >> fix_lines).

% record_run(...): called with the KB lock held. It reads kb.pl again,
% because other writers may have appended while the command ran.
% N is 1 more than the highest run number in a test_result and in a log
% name in runs/ (an orphan log from a killed run is never overwritten).
% Files that start with a dot (the runs/.tmp-* files) do not count.
record_run(KB, Check, Result, EC, Now, CmdText, Output, RunN, Log) :-
    kb_dir(KB, Dir),
    kb_lib(KB, Lib),
    load_kb(Dir, Lib, KB2),
    kb_items(KB2, Items),
    items_decls(Items, Ds),
    findall(N, ( member(it(kb, _, _, A, _, _), Items), nonvar(A),
                 A = attest(_, test_result, _, result(_, N, _), _, _), integer(N) ),
            Ns),
    directory_file_path(Dir, runs, RunsDir),
    directory_files(RunsDir, Fs),
    findall(N, ( member(F, Fs), \+ sub_atom(F, 0, 1, _, '.'),
                 file_name_extension(Base, log, F),
                 atomic_list_concat([NA|_], '-', Base),
                 atom_number(NA, N), integer(N) ),
            LNs),
    append(Ns, LNs, AllNs),
    max_list([0|AllNs], Max),
    RunN is Max + 1,
    run_log_path(KB2, Check, RunN, Log),
    format(string(LogText), "% orbit-kb run ~w check=~w result=~w exit=~w time=~w cmd=~w~n~w",
           [RunN, Check, Result, EC, Now, CmdText, Output]),
    create_exclusive(Log, LogText),
    next_attest_id(Items, Ds, Id),
    Att = attest(Id, test_result, Check, result(Check, RunN, Result), script, Now),
    clause_line(Att, [], Line),
    kb_file(KB2, KbFile),
    append_lines(KbFile, [Line]).

% runs_tmp(+RunsDir, -Path, -Stream): a new private file
% runs/.tmp-<pid>-<random>. The process id makes the name unique among
% running processes; the random part makes it hard to guess. It is
% removed at exit.
runs_tmp(RunsDir, Path, S) :-
    current_prolog_flag(pid, Pid),
    repeat,
    random_between(0, 1000000000000, R),
    format(atom(Path), "~w/.tmp-~w-~w", [RunsDir, Pid, R]),
    \+ exists_file(Path),
    !,
    open(Path, write, S, [encoding(utf8)]),
    assertz(orbit_tmp(Path)).

% create_exclusive(+File, +Text) (D7): create File with Text, and fail
% loudly if File exists. The text goes to a temp file in the same
% directory first. link(2) then gives it the final name; link(2) never
% replaces a file that exists, so this is an exclusive create.
create_exclusive(File, Text) :-
    file_directory_name(File, D),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w/.tmp-~w-~w", [D, Pid, R]),
    setup_call_cleanup(open(Tmp, write, S, [encoding(utf8)]),
                       write(S, Text),
                       close(S)),
    catch(link_file(Tmp, File, hard), E, true),
    (   var(E)
    ->  catch(delete_file(Tmp), _, true)
    ;   exists_file(File)
    ->  catch(delete_file(Tmp), _, true),
        die(2, ["The log " + File + " already exists. Another run wrote it.", "Fix: move the old log away, then run again."] >> fix_lines)
    ;   % The file system has no hard links. The KB lock still keeps
        % other orbit-kb processes out, so a rename is safe here.
        rename_file(Tmp, File)
    ).

% ---------------------------------------------------------------------
% prove (D10)
% ---------------------------------------------------------------------

% prove CLAIM FILE THEOREM [--module M]: build the Lake project of FILE,
% then check THEOREM. orbit-kb records a lean_proof only when all of
% these are true:
%   - THEOREM is a theorem, and the module of FILE declares it;
%   - it depends on no axiom other than propext, Classical.choice, and
%     Quot.sound. So it has no sorry, no native_decide, and no local
%     axiom;
%   - leanchecker replays every module of the project that the module
%     imports, under the project root and outside .lake/. This finds a
%     declaration that skipped the kernel;
%   - the built files are still up to date when the digest is taken.
% The log runs/proof-ID.log holds the digest of each file of the proof,
% and the configuration files that do not exist. The digest also covers
% the claim, theorem, module, and statement lines (proof_digest/7). When
% a file changes, or an absent configuration file appears, the proof
% stops counting (proof_changed/1).
% prove checks the proof of an honest agent that can make mistakes. It
% does not resist an agent that cheats on purpose (README section 15).
% As run does, prove works without the KB lock and takes the lock only
% to record.

proof_axiom_ok(propext).
proof_axiom_ok('Classical.choice').
proof_axiom_ok('Quot.sound').

% Files at the project root that also change what a proof means.
lake_config_file('lean-toolchain').
lake_config_file('lake-manifest.json').
lake_config_file('lakefile.toml').
lake_config_file('lakefile.lean').

cmd_prove(KB, Args, Code) :-
    parse_opts(Args, ['--module'-value], Pos, Opts),
    (   Pos = [Claim, File, Thm] -> true
    ;   usage_error("Give a claim, a Lean file, and a theorem: orbit-kb prove CLAIM FILE THEOREM [--module M].", [])
    ),
    (   has_build(KB) -> true
    ;   die(2, ["prove needs the build module. Add build to uses/1 in kb.pl."])
    ),
    kb_items(KB, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = claim(Claim, _, _)
    ->  true
    ;   die(2, ["There is no claim " + Claim + " in kb.pl.", "Fix: check the claim id. Nothing was recorded."] >> fix_lines)
    ),
    absolute_file_name(File, FileAbs0),
    (   exists_file(FileAbs0) -> real_file(FileAbs0, FileAbs)
    ;   die(2, ["The file " + File + " does not exist. Nothing was recorded."] >> fix_lines)
    ),
    lake_root(FileAbs, Root),
    (   memberchk('--module'-Mod, Opts) -> true ; file_module(Root, FileAbs, Mod) ),
    (   absolute_file_name(path(lake), Lake, [access(execute), file_errors(fail)]) -> true
    ;   die(2, ["lake is not on PATH. Install Lean with elan. Nothing was recorded."])
    ),
    kb_lib(KB, Lib),
    directory_file_path(Lib, 'lean/probe.lean', Probe),
    ( exists_file(Probe) -> true ; die(2, ["The library has no lean/probe.lean: " + Probe] >> fix_lines) ),
    kb_dir(KB, Dir),
    directory_file_path(Dir, runs, RunsDir),
    make_directory_path(RunsDir),
    % 1. Build the module.
    prove_exec(Lake, [build, Mod], Root, RunsDir, EC1, Out1),
    (   EC1 =:= 0 -> true
    ;   prove_reject(["lake build " + Mod + " failed (exit " + EC1 + ").",
                      "Fix the Lean file, or give the module with --module if the name is wrong."], Out1)
    ),
    % 2. Read the facts about the theorem.
    prove_exec(Lake, [env, lean, '--run', Probe, Mod, Thm, Root], Root, RunsDir, EC2, Out2),
    (   EC2 =:= 0 -> true
    ;   prove_reject(["The probe failed (exit " + EC2 + ")."], Out2)
    ),
    probe_facts(Out2, PF),
    prove_judge(PF, Mod, Thm, FileAbs, Root, Out2),
    % 3. Replay the project modules in the kernel.
    findall(M, member(file(M, _), PF), PMods),
    prove_exec(Lake, [env, leanchecker|PMods], Root, RunsDir, EC3, Out3),
    (   EC3 =:= 0 -> true
    ;   prove_reject(["leanchecker found a problem, or it is missing (exit " + EC3 + ").",
                      "A declaration that skips the kernel check is not a proof."], Out3)
    ),
    % 4. Take the digest, then check that the build is still up to date.
    proof_files(Root, PF, Files, Absent),
    memberchk(statement(St0), PF),
    proof_digest(Claim, Thm, Mod, St0, Files, Absent, Digest),
    prove_exec(Lake, [build, '--no-build', Mod], Root, RunsDir, EC4, Out4),
    (   EC4 =:= 0 -> true
    ;   prove_reject(["A file of the proof changed while orbit-kb checked it. Run orbit-kb prove again."], Out4)
    ),
    utc_now(Now),
    stored_path(Dir, Root, StoredRoot),
    relative_file_name(FileAbs, Root, RelFile),
    proof_log_text(Claim, Digest, Thm, Mod, RelFile, StoredRoot, PF, Files, Absent, Now, Out1, LogText),
    with_kb_lock(Dir, record_proof(KB, Claim, Digest, Now, LogText, Id, Log)),
    member(statement(St), PF),
    format("proof ~w of claim ~w: theorem ~w (~w)~n", [Id, Claim, Thm, Mod]),
    format("Statement: ~w~n", [St]),
    format("Log: ~w~n", [Log]),
    format("Check that the statement says what claim ~w says. orbit-kb cannot check that.~n", [Claim]),
    Code = 0.

% prove_exec(+Exe, +Args, +Cwd, +RunsDir, -ExitCode, -Output): run a
% command in Cwd, with its output in a private temp file.
prove_exec(Exe, Args, Cwd, RunsDir, EC, Output) :-
    runs_tmp(RunsDir, Tmp, OS),
    catch(process_create(Exe, Args, [cwd(Cwd), stdin(null), stdout(stream(OS)), stderr(stream(OS)), process(P)]), E, true),
    close(OS),
    (   nonvar(E)
    ->  err_text(E, ET),
        die(2, ["Could not start " + Exe + ": " + ET, "Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    run_wait(P, St),
    (   St = exit(EC) -> true
    ;   St = killed(Sig) -> EC is 128 + Sig
    ;   EC = 255
    ),
    read_file_to_string(Tmp, Output, [encoding(utf8)]).

% prove_reject(+Lines, +Output): nothing is recorded. Exit 1, with the
% last 40 lines of the output.
prove_reject(Lines0, Output) :-
    die_fix_lines(Lines0, Lines),
    split_string(Output, "\n", "", OL0),
    ( append(OL1, [""], OL0) -> true ; OL1 = OL0 ),
    length(OL1, Len),
    ( Len > 40 -> Skip is Len - 40, length(Drop, Skip), append(Drop, Tail, OL1) ; Tail = OL1 ),
    (   Tail == [] -> TailLines = []
    ;   length(Tail, TN), fmt(H, "Last ~w line(s) of output:", [TN]), TailLines = [H|Tail]
    ),
    append([["Not proved. Nothing was recorded."], Lines, TailLines], All),
    throw(orbit_error(1, All)).

% lake_root(+File, -Root): the nearest directory, from the directory of
% File upward, with a lakefile.
lake_root(File, Root) :-
    file_directory_name(File, D),
    (   lake_root_(D, Root) -> true
    ;   die(2, ["No Lake project holds " + File + ". There is no lakefile.toml or lakefile.lean in its directory or above."] >> fix_lines)
    ).
lake_root_(D, D) :-
    ( directory_file_path(D, 'lakefile.toml', F) ; directory_file_path(D, 'lakefile.lean', F) ),
    exists_file(F), !.
lake_root_(D, Root) :-
    file_directory_name(D, P), P \== D,
    lake_root_(P, Root).

% file_module(+Root, +File, -Module): Foo/Bar.lean under Root is the
% module Foo.Bar. A library with another srcDir needs --module.
file_module(Root, File, Mod) :-
    relative_file_name(File, Root, Rel),
    (   file_name_extension(Base, lean, Rel), \+ sub_atom(Base, 0, _, _, '..')
    ->  atomic_list_concat(Ps, '/', Base),
        atomic_list_concat(Ps, '.', Mod)
    ;   die(2, ["The file " + File + " is not a .lean file inside its Lake project."] >> fix_lines)
    ).

% probe_facts(+Output, -Facts): the ORBIT-PROVE lines of lean/probe.lean.
probe_facts(Output, Facts) :-
    split_string(Output, "\n", "", Ls),
    findall(F, ( member(L, Ls), string_concat("ORBIT-PROVE ", R, L), probe_fact(R, F) ), Facts).

probe_fact(R, F) :-
    (   sub_string(R, B, 1, A, " ") -> sub_string(R, 0, B, _, K), sub_string(R, _, A, 0, V)
    ;   K = R, V = ""
    ),
    !,
    probe_fact(K, V, F).
probe_fact("lean", V, lean(V)).
probe_fact("kind", V, kind(K)) :- atom_string(K, V).
probe_fact("module", V, module(M)) :- atom_string(M, V).
probe_fact("axiom", V, axiom(X)) :- atom_string(X, V).
probe_fact("statement", V, statement(V)).
probe_fact("uses", V, uses(C, M)) :- two_words(V, C, M).
probe_fact("file", V, file(M, P)) :- two_words(V, M, P).

% two_words(+S, -A, -B): A is the first word of S, B the rest (atoms).
two_words(S, A, B) :-
    (   sub_string(S, X, 1, Y, " ")
    ->  sub_string(S, 0, X, _, SA), sub_string(S, _, Y, 0, SB)
    ;   SA = S, SB = ""
    ),
    !,
    atom_string(A, SA), atom_string(B, SB).

% prove_judge(+Facts, +Module, +Theorem, +File, +Root, +Output): reject
% unless the probe facts show a proof.
prove_judge(PF, Mod, Thm, FileAbs, Root, Out) :-
    (   memberchk(kind(K), PF) -> true ; K = missing ),
    (   K == theorem -> true
    ;   K == missing
    ->  prove_reject(["There is no declaration " + Thm + " in module " + Mod + " or its imports.",
                      "Give the full name, with its namespace."], Out)
    ;   prove_reject(["The declaration " + Thm + " is a " + K + ", not a theorem."], Out)
    ),
    (   memberchk(module(DM), PF), DM == Mod -> true
    ;   ( memberchk(module(DM), PF) -> true ; DM = unknown ),
        prove_reject(["The theorem " + Thm + " is declared in module " + DM + ", not in " + Mod + ".",
                      "Prove the claim with a theorem in the file that you give."], Out)
    ),
    findall(X, ( member(axiom(X), PF), \+ proof_axiom_ok(X) ), Bad),
    (   Bad == [] -> true
    ;   memberchk(sorryAx, Bad)
    ->  prove_reject(["The proof of " + Thm + " uses sorry (the axiom sorryAx). A statement with sorry is not a proof."], Out)
    ;   atomic_list_concat(Bad, ', ', BT),
        prove_reject(["The proof of " + Thm + " depends on axioms that orbit-kb does not accept: " + BT + ".",
                      "Only propext, Classical.choice, and Quot.sound are accepted. native_decide adds an axiom."], Out)
    ),
    relative_file_name(FileAbs, Root, Rel),
    (   member(file(Mod, P), PF), P == Rel -> true
    ;   prove_reject(["The module " + Mod + " is not the file " + Rel + ". Give the module with --module."], Out)
    ).

% proof_files(+Root, +Facts, -Files, -Absent): f(Sha, RelPath) for each
% project source file of the proof and each Lake configuration file,
% sorted; Absent is the sorted list of the configuration files that do
% not exist (D10 follow-up, F7: a file that appears later changes what
% the proof means, so it reopens the burn).
proof_files(Root, PF, Files, Absent) :-
    findall(P, member(file(_, P), PF), Ps1),
    findall(C, ( lake_config_file(C), directory_file_path(Root, C, F), exists_file(F) ), Ps2),
    findall(C, ( lake_config_file(C), directory_file_path(Root, C, F), \+ exists_file(F) ), Ab0),
    sort(Ab0, Absent),
    append(Ps1, Ps2, Ps0),
    sort(Ps0, Ps),
    findall(f(Sha, P), ( member(P, Ps), directory_file_path(Root, P, F), sha256_file(F, Sha) ), Files).

% proof_digest(+Claim, +Theorem, +Module, +Statement, +Files, +Absent,
% ?Digest) (D10 follow-up, F6): the sha256 of these lines, each ended by
% a newline: "claim C", "theorem T", "module M", "statement S", then
% "SHA PATH" for each file, then "absent PATH" for each absent
% configuration file. So the digest binds the claim, the theorem, and
% the statement of the log to its files.
proof_digest(C, T, M, St, Files, Absent, Digest) :-
    fmt(H, "claim ~w~ntheorem ~w~nmodule ~w~nstatement ~w~n", [C, T, M, St]),
    findall(L, ( member(f(Sha, P), Files), fmt(L, "~w ~w~n", [Sha, P]) ), Ls),
    findall(L, ( member(P, Absent), fmt(L, "absent ~w~n", [P]) ), As),
    append([[H], Ls, As], All),
    atomic_list_concat(All, Text),
    sha256_text(Text, Digest).

sha256_text(Text, Digest) :-
    (   catch(( use_module(library(sha)),
                sha:sha_hash(Text, H, [algorithm(sha256), encoding(utf8)]),
                sha:hash_atom(H, Hex) ), _, fail)
    ->  atom_concat('sha256:', Hex, Digest0)
    ;   tmp_stream(txt, F, S),
        call_cleanup(write(S, Text), close(S)),
        sha256_file(F, Digest0)
    ),
    Digest = Digest0.

proof_log_text(Claim, Digest, Thm, Mod, RelFile, StoredRoot, PF, Files, Absent, Now, BuildOut, Text) :-
    ( memberchk(lean(V), PF) -> true ; V = unknown ),
    memberchk(statement(St), PF),
    findall(L, ( member(axiom(X), PF), fmt(L, "axiom ~w", [X]) ), AxLs),
    findall(M, member(file(M, _), PF), PMods),
    findall(L, ( member(uses(C, M), PF), memberchk(M, PMods), fmt(L, "uses ~w ~w", [C, M]) ), UsLs),
    findall(L, ( member(f(Sha, P), Files), fmt(L, "file ~w ~w", [Sha, P]) ), FLs),
    findall(L, ( member(P, Absent), fmt(L, "absent ~w", [P]) ), ALs),
    fmt(H, "% orbit-kb prove claim=~w digest=~w", [Claim, Digest]),
    fmt(L1, "theorem ~w", [Thm]),
    fmt(L2, "module ~w", [Mod]),
    fmt(L3, "source ~w", [RelFile]),
    fmt(L4, "statement ~w", [St]),
    fmt(L5, "lean ~w", [V]),
    fmt(L6, "time ~w", [Now]),
    fmt(L7, "root ~w", [StoredRoot]),
    append([[H, L1, L2, L3, L4, L5, L6], AxLs, UsLs, [L7], FLs, ALs, ["--- lake build output"]], Ls),
    atomic_list_concat(Ls, '\n', Head),
    atomic_list_concat([Head, '\n', BuildOut], Text).

% record_proof(...): called with the KB lock held. It reads kb.pl again,
% as record_run does.
record_proof(KB, Claim, Digest, Now, LogText, Id, Log) :-
    kb_dir(KB, Dir),
    kb_lib(KB, Lib),
    load_kb(Dir, Lib, KB2),
    kb_items(KB2, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = claim(Claim, _, _) -> true
    ;   die(2, ["Claim " + Claim + " is no longer in kb.pl. Nothing was recorded."] >> fix_lines)
    ),
    items_decls(Items, Ds),
    next_attest_id(Items, Ds, Id),
    proof_log_path(Dir, Id, Log),
    create_exclusive(Log, LogText),
    Att = attest(Id, lean_proof, Claim, proof(Claim, Digest), script, Now),
    clause_line(Att, [], Line),
    kb_file(KB2, KbFile),
    append_lines(KbFile, [Line]).

proof_log_path(Dir, Id, P) :-
    format(atom(Rel), "runs/proof-~w.log", [Id]),
    directory_file_path(Dir, Rel, P).

% proof_log(+Dir, +Id, -Log): Log = plog(Claim, Digest, RootAbs, Files,
% Absent, Info) from runs/proof-ID.log. Info holds theorem(T), module(M),
% source(F), statement(S), lean(V), time(T), axiom(A), uses(C, M).
proof_log(Dir, Id, plog(C, D, RootAbs, Files, Absent, Info)) :-
    proof_log_path(Dir, Id, P),
    exists_file(P),
    read_file_to_string(P, S, [encoding(utf8)]),
    split_string(S, "\n", "", [H|Ls0]),
    split_string(H, " ", "", ["%", "orbit-kb", "prove", CS, DS]),
    string_concat("claim=", CT, CS), atom_string(C, CT),
    string_concat("digest=", DT, DS), atom_string(D, DT),
    ( append(Ls, ["--- lake build output"|_], Ls0) -> true ; Ls = Ls0 ),
    findall(X, ( member(L, Ls), proof_log_line(L, X) ), Xs),
    memberchk(root(R), Xs),
    (   is_absolute_file_name(R) -> RootAbs = R ; directory_file_path(Dir, R, RootAbs) ),
    findall(f(Sha, Pa), member(file(Sha, Pa), Xs), Files),
    findall(Pa, member(absent(Pa), Xs), Absent),
    exclude([X]>>( X = root(_) ; X = file(_, _) ; X = absent(_) ), Xs, Info).

proof_log_line(L, X) :-
    two_words(L, K, V),
    (   memberchk(K, [theorem, module, source, root, axiom, lean, time, absent]) -> X =.. [K, V]
    ;   K == statement -> sub_string(L, 10, _, 0, VS), X = statement(VS)
    ;   K == uses -> two_words(V, A, B), X = uses(A, B)
    ;   K == file -> two_words(V, A, B), X = file(A, B)
    ).

% proof_log_consistent(+Log, +Claim, +Digest) (D10 follow-up, F6): the
% header names Claim and Digest, and the digest of the claim, theorem,
% module, statement, file, and absent lines of the log is Digest. So a
% log copied for another claim, or an edited line, does not match.
proof_log_consistent(plog(C0, D0, _, Files, Absent, Info), C, D) :-
    C0 == C, D0 == D, Files \== [],
    memberchk(theorem(T), Info), memberchk(module(M), Info), memberchk(statement(St), Info),
    proof_digest(C, T, M, St, Files, Absent, D).

% proof_state(+Dir, +Id, +Pred, -State): ok when the log matches the
% attestation (proof_log_consistent/3), every file of the proof still
% has its digest, and every absent configuration file is still absent.
% Else changed.
proof_state(Dir, Id, P, State) :-
    (   catch(( nonvar(P), P = proof(C, D),
                proof_log(Dir, Id, Log),
                proof_log_consistent(Log, C, D),
                Log = plog(_, _, Root, Files, Absent, _),
                forall(member(f(Sha, Pa), Files),
                       ( directory_file_path(Root, Pa, F), exists_file(F), sha256_file(F, Sha) )),
                forall(member(Pa, Absent),
                       ( directory_file_path(Root, Pa, F), \+ exists_file(F) )) ),
              _, fail)
    ->  State = ok
    ;   State = changed
    ).

% proof_log_matches(+Dir, +Id, +Pred): the log exists, its header names
% the claim and the digest of the attestation, and its lines give that
% digest (lint E9).
proof_log_matches(Dir, Id, proof(C, D)) :-
    catch(( proof_log(Dir, Id, Log), proof_log_consistent(Log, C, D) ), _, fail).

% ---------------------------------------------------------------------
% lint
% ---------------------------------------------------------------------

cmd_lint(KB, Args, Code) :-
    parse_opts(Args, ['--strict'-flag], Pos, Opts),
    ( Pos == [] -> true ; usage_error("lint takes no arguments other than --strict.", []) ),
    opt(Opts, '--strict', false, Strict),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    lint_diags(KB, Diags, IssueLines, IssueErrors),
    include([diag(C, _, _, _)]>>sub_atom(C, 0, 1, _, 'E'), Diags, Errs),
    exclude([diag(C, _, _, _)]>>sub_atom(C, 0, 1, _, 'E'), Diags, Warns),
    forall(member(D, Errs), print_diag(D)),
    forall(member(D, Warns), print_diag(D)),
    forall(member(L, IssueLines), format("~w~n", [L])),
    length(Errs, NE0), length(Warns, NW0),
    length(IssueLines, NI),
    NE is NE0 + IssueErrors,
    NW is NW0 + NI - IssueErrors,
    format("Summary: ~w error(s), ~w warning(s).~n", [NE, NW]),
    (   NE > 0 -> Code = 1
    ;   Strict == true, NW > 0 -> Code = 1
    ;   Code = 0
    ).

print_diag(diag(C, F, L, M)) :-
    (   F == ''
    ->  format("~w ~w~n", [C, M])
    ;   show_loc(F, L, LT),
        format("~w ~w: ~w~n", [C, LT, M])
    ).

lint_diags(KB, Diags, IssueLines, IssueErrors) :-
    kb_items(KB, Items),
    kb_dir(KB, Dir),
    kb_lib(KB, Lib),
    directory_file_path(Dir, 'kb.pl', KbFile),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    % E1
    findall(diag('E1', F, L, M), member(synerr(_, F, L, M), Items), D1),
    % E10
    e10_diags(Items, Lib, KbFile, D10),
    % declarations
    decl_diags(Items, Ds, DD),
    atype_diags(Items, Ds, ATs, DA),
    % facts
    include(fact_item, Items, Facts),
    build_env(Facts, Ds, Env),
    Ctx = fctx(KB, Ds, ATs, Env),
    findall(D, ( member(I, Facts), fact_diags(Ctx, I, D0), member(D, D0) ), DF),
    e5_diags(Facts, Ds, D5),
    e15_diags(Facts, D15),
    % rules in core, modules, rules.pl
    findall(D, ( member(I, Items), I = it(Src, _, _, _, _, _), Src \== kb,
                 rule_item_diags(Ds, I, D0), member(D, D0) ),
            DR),
    % E17
    findall(D, ( member(I, Items), e17_diags(I, D0), member(D, D0) ), D17),
    % E18
    e18_diags(Items, Ds, D18),
    % E11
    e11_diags(Items, Ds, D11, Eng),
    % warnings
    w_diags(KB, Items, Ds, Facts, DW),
    append([D1, D10, DD, DA, DF, D5, D15, DR, D17, D18, D11, DW], Diags0),
    % keep errors in a stable order; drop exact repeats
    list_to_set(Diags0, Diags),
    lint_issues(Eng, Ds, IssueLines, IssueErrors).


e10_diags(Items, Lib, KbFile, Diags) :-
    findall(I, ( member(I, Items), item_src(I, kb) ), KbItems),
    (   KbItems = [First|_], First = it(_, _, _, T, _, _), nonvar(T), T = uses(_)
    ->  D0 = []
    ;   member(it(kb, F, L, T, _, _), KbItems), nonvar(T), T = uses(_)
    ->  D0 = [diag('E10', F, L, "uses/1 is not the first term of kb.pl. Move it to the top.")]
    ;   D0 = [diag('E10', KbFile, 1, "kb.pl has no uses/1. Add uses([]). or uses([build]). as the first line.")]
    ),
    findall(diag('E10', F, L, M),
            ( nth1(K, KbItems, it(_, F, L, T, _, _)), K > 1, nonvar(T), T = uses(_),
              KbItems = [it(_, _, _, T1, _, _)|_], nonvar(T1), T1 = uses(_),
              M = "kb.pl has more than one uses/1. Keep only the first." ),
            D1),
    findall(diag('E10', F, L, M),
            ( member(it(kb, F, L, T, _, _), KbItems), nonvar(T), T = uses(Ms),
              (   \+ ( is_list(Ms), maplist(atom, Ms) )
              ->  M = "uses/1 needs a list of module names, such as uses([build])."
              ;   lib_modules(Lib, Known),
                  member(Mo, Ms), \+ memberchk(Mo, Known),
                  atomic_list_concat(Known, ', ', KT),
                  fmt(M, "The module ~q does not exist. Known modules: ~w.", [Mo, KT])
              ) ),
            D2),
    append([D0, D1, D2], Diags).

item_src(it(S, _, _, _, _, _), S).
item_src(synerr(S, _, _, _), S).

decl_diags(Items, Ds, Diags) :-
    findall(FN, member(d(FN, _, fact, _, _, _, _, _, _), Ds), FN0), sort(FN0, FactNames),
    findall(D, ( member(it(_, F, L, T, _, _), Items), nonvar(T), T = decl(K, H, Doc, Tpl),
                 decl_item_diag(FactNames, F, L, K, H, Doc, Tpl, D) ),
            D1),
    findall((N/A)-(F:L), member(d(N, A, _, _, _, _, _, F, L), Ds), DK),
    findall(diag('E5', F2, L2, M),
            ( later_duplicate(DK, (N/A)-(F1:L1), F2:L2),
              show_loc(F1, L1, LT),
              fmt(M, "~q/~w is declared twice. The first declaration is at ~w. Remove one.", [N, A, LT]) ),
            D2),
    append(D1, D2, Diags).

% later_duplicate(+KeyLocs, -Key-Loc1, -Loc2): Loc2 comes after Loc1 in
% KeyLocs, and both have the same Key. The solutions come in the order
% of the nested loop over KeyLocs (first by Loc1, then by Loc2), but the
% work is near linear: keys are grouped once with a sort.
later_duplicate(KeyLocs, K-Loc1, Loc2) :-
    findall(K0-(I-Loc), nth1(I, KeyLocs, K0-Loc), KIL),
    keysort(KIL, Sorted),
    group_pairs_by_key(Sorted, Groups),
    findall(I1-I2-(K1-L1)-L2,
            ( member(K1-IL, Groups), IL = [_, _|_],
              append(_, [I1-L1|Rest], IL), member(I2-L2, Rest) ),
            Ps0),
    keysort(Ps0, Ps),
    member(_-_-(K-Loc1)-Loc2, Ps).

decl_item_diag(_, F, L, K, _, _, _, diag('E3', F, L, M)) :-
    \+ memberchk(K, [fact, rule]),
    term_text(K, KT),
    fmt(M, "The kind of a declaration must be fact or rule. It is ~w.", [KT]).
decl_item_diag(_, F, L, _, H, _, _, diag('E3', F, L, "The head of a declaration must be a name with types, without a minus sign.")) :-
    ( \+ callable(H) ; H = -(_) ).
decl_item_diag(FNs, F, L, _, H, _, _, diag('E3', F, L, M)) :-
    callable(H), H \= -(_),
    H =.. [N|Ts], length(Ts, A),
    member(T, Ts), type_errs(T, FNs, Es), member(E, Es),
    fmt(M, "Declaration of ~q/~w: ~w", [N, A, E]).
decl_item_diag(_, F, L, _, _, Doc, _, diag('E3', F, L, "The doc of a declaration must be text in single quotes.")) :-
    \+ atom(Doc).
decl_item_diag(_, F, L, _, H, _, Tpl, diag('E3', F, L, M)) :-
    (   \+ atom(Tpl)
    ->  M = "The template of a declaration must be text in single quotes, or ''."
    ;   callable(H), functor(H, _, A),
        template_errs(Tpl, A, Es), member(M, Es)
    ).

atype_diags(Items, Ds, ATs, Diags) :-
    findall(FN, member(d(FN, _, fact, _, _, _, _, _, _), Ds), FN0), sort(FN0, FactNames),
    findall(diag('E3', F, L, M),
            ( member(it(_, F, L, X, _, _), Items), nonvar(X), X = attest_type(T, S, W, Doc),
              (   \+ atom(T), M = "The name of an attestation type must be an atom."
              ;   shape_errs(S, FactNames, Es), member(E, Es),
                  fmt(M, "Attestation type ~q: ~w", [T, E])
              ;   \+ ( is_list(W), W \== [], forall(member(X1, W), memberchk(X1, [human, agent, script])) ),
                  fmt(M, "Attestation type ~q: the writers must be a list of human, agent, and script.", [T])
              ;   \+ atom(Doc),
                  fmt(M, "Attestation type ~q: the doc must be text in single quotes.", [T])
              ) ),
            D1),
    findall(T-(F:L), member(at(T, _, _, _, _, F, L), ATs), AK),
    findall(diag('E5', F2, L2, M),
            ( later_duplicate(AK, T-(F1:L1), F2:L2),
              show_loc(F1, L1, LT),
              fmt(M, "The attestation type ~q is declared twice. The first is at ~w. Remove one.", [T, LT]) ),
            D2),
    append(D1, D2, Diags).

e11_diags(Items, Ds, Diags, Eng) :-
    build_engine(Items, Ds, Eng),
    Eng = eng(_, LoadErrs),
    findall(diag('E11', F, L, M),
            ( member(le(F, L, Msg), LoadErrs),
              fmt(M, "The SWI engine cannot load this clause: ~w", [Msg]) ),
            Diags).

lint_issues(Eng, Ds, Lines, NErr) :-
    (   decl_of(Ds, lint_issue, 3, _)
    ->  swi_raw(Eng, lint_issue(C, I, M), [C, I, M], R),
        (   R = answers(L, _)
        ->  findall(S-IsE, ( member([C1, I1, M1], L),
                             plain_text(C1, CT), plain_text(I1, IT),
                             ( atom(M1) -> MT = M1 ; term_text(M1, MT) ),
                             fmt(S, "~w ~w: ~w", [CT, IT, MT]),
                             ( atom(C1), sub_atom(C1, 0, 1, _, 'E') -> IsE = 1 ; IsE = 0 ) ),
                    Ps),
            pairs_keys_values(Ps, Lines, Es),
            sum_list(Es, NErr)
        ;   R = error(Msg),
            fmt(S, "E11 lint_issue/3 failed in the SWI engine: ~w", [Msg]),
            Lines = [S], NErr = 1
        )
    ;   Lines = [], NErr = 0
    ).

w_diags(KB, Items, Ds, Facts, Diags) :-
    % W1
    findall(diag('W1', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = subject(Id, Path, D0), atom(Path),
              subject_abs(KB, Path, Abs),
              (   \+ exists_file(Abs)
              ->  fmt(M, "The file of subject ~q is missing: ~w. Restore it, or refresh with orbit-kb subject ~w PATH.", [Id, Abs, Id])
              ;   sha256_file(Abs, D1), D1 \== D0,
                  fmt(M, "The file of subject ~q changed since its digest was recorded. Refresh with orbit-kb subject ~w ~w.", [Id, Id, Path])
              ) ),
            W1),
    % D22: the first_use/3 facts of kb.pl
    findall(fu(N, A, By, Tm, F, L),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = first_use(PI, By, Tm),
              nonvar(PI), PI = N/A, atom(N), integer(A) ),
            FUs),
    % W2 (not for a declaration that a first use made: W7 lists it)
    findall(diag('W2', F, L, M),
            ( member(d(N, A, K, _, Doc, _, kb, F, L), Ds),
              \+ memberchk(fu(N, A, _, _, _, _), FUs),
              fmt(M, "Local declaration of ~q/~w (~w): ~w Review it.", [N, A, K, Doc]) ),
            W2a),
    findall(diag('W2', F, L, M),
            ( member(it(kb, F, L, X, _, _), Items), nonvar(X), X = attest_type(T, _, W, _),
              fmt(M, "Local attestation type ~q (writers ~w). Review it.", [T, W]) ),
            W2b),
    % W3. Two terms from different facts can be == only when they are
    % ground, so a set of the ground cited claims is enough.
    findall(C1-t, ( member(it(_, _, _, T2, _, _), Facts), nonvar(T2),
                    T2 = cites(C1, _), ground(C1) ), CP0),
    sort(CP0, CP),
    ord_list_to_assoc(CP, Cited),
    findall(diag('W3', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = claim(C, _, _),
              \+ ( ground(C), get_assoc(C, Cited, _) ),
              fmt(M, "Claim ~q has no cites. Add cites(~q, 'the request text it serves').", [C, C]) ),
            W3),
    % W4
    findall(PI, ( member(it(Src, _, _, T, _, _), Items), Src \== kb, nonvar(T),
                  \+ meta_term(T), T \= #(_),
                  clause_parts(T, _, B), body_goals(B, Gs), member(G, Gs),
                  nonvar(G), callable(G), functor(G, N, A), PI = N/A ),
            Read0),
    sort(Read0, Read),
    findall(diag('W4', F, L, M),
            ( member(d(N, A, fact, _, _, _, kb, F, L), Ds),
              \+ ord_memberchk(N/A, Read),
              fmt(M, "No rule reads the local fact ~q/~w. Add a rule in rules.pl that uses it, or remove it.", [N, A]) ),
            W4),
    % W5 (D15). A check of a superseded claim, while a current claim that
    % replaces it (directly or through a chain) has no check of its own.
    % Check ids are unique (E5) and facts are append-only, so the fix is a
    % new check of the current claim, not a move of the old check.
    supersede_edges(Facts, SEdges),
    supersede_closure(SEdges, SPairs),
    findall(O5, member(_-O5, SEdges), Olds0), sort(Olds0, Olds),
    findall(C5, ( member(it(_, _, _, T5, _, _), Facts), nonvar(T5),
                  T5 = check(_, C5), ground(C5) ), Checked0),
    sort(Checked0, Checked),
    findall(C6, ( member(it(_, _, _, T6, _, _), Facts), nonvar(T6),
                  T6 = claim(C6, _, _), atom(C6) ), Claims0),
    sort(Claims0, Claims),
    findall(diag('W5', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = check(K, C),
              ground(C),
              member(New-C1, SPairs), C1 == C,
              ord_memberchk(New, Claims), \+ ord_memberchk(New, Olds),
              \+ ord_memberchk(New, Checked),
              fmt(M, "Check ~q tests claim ~q, but claim ~q replaces it, and ~q has no check. Add a new check of ~q with a new id: orbit-kb add \"check(NEW_ID, ~q)\". Then run it: orbit-kb run NEW_ID -- CMD.", [K, C, New, New, New, New]) ),
            W5),
    % W7 (D22): each predicate declared by its first use
    findall(diag('W7', F, L, M),
            ( member(fu(N, A, By, Tm, F, L), FUs),
              txt(By, ByT), txt(Tm, TmT),
              fmt(M, "~q/~w was declared by its first use, by ~w at ~w. Review the new predicate: is it needed, and is the name right? Its arguments have the type term.", [N, A, ByT, TmT]) ),
            W7),
    % E19 (D22): the typo guard. A first-use name at most 2 edits from
    % another declared name of the same arity.
    findall(diag('E19', F, L, M),
            ( member(fu(N, A, _, _, F, L), FUs),
              member(d(N2, A, _, _, _, _, _, _, _), Ds), N2 \== N, atom(N2),
              edit_distance_at_most(N, N2, 2, Dist),
              fmt(M, "~q/~w was declared by its first use, and its name is ~w edit(s) from the declared ~q/~w. It may be a typo. If it is: correct the facts in kb.pl to ~q/~w, and delete the decl/4 and first_use/3 lines of ~q/~w. If it is a new predicate: choose a name more than 2 edits away.", [N, A, Dist, N2, A, N2, A, N, A]) ),
            E19a),
    sort(E19a, E19),
    append([W1, W2a, W2b, W3, W4, W5, W7, E19], Diags).

% edit_distance_at_most(+A, +B, +Max, -D) (D22): the Levenshtein distance D
% of the names A and B (over their characters) is at most Max.
edit_distance_at_most(A, B, Max, D) :-
    atom_codes(A, As), atom_codes(B, Bs),
    length(As, LA), length(Bs, LB),
    abs(LA - LB) =< Max,
    levenshtein(As, Bs, D),
    D =< Max.

levenshtein(As, Bs, D) :-
    length(Bs, LB),
    numlist(0, LB, Row0),
    foldl(lev_step(Bs), As, Row0-0, Row-_),
    last(Row, D).

lev_step(Bs, A, Prev-I0, [I|Cur]-I) :-
    I is I0 + 1,
    Prev = [P0|Ps],
    lev_cells(Bs, A, P0, Ps, I, Cur).

lev_cells([], _, _, [], _, []).
lev_cells([B|Bs], A, Diag, [Up|Ups], Left, [C|Cs]) :-
    ( A == B -> Cost = 0 ; Cost = 1 ),
    C is min(min(Up + 1, Left + 1), Diag + Cost),
    lev_cells(Bs, A, Up, Ups, C, Cs).


% group_by_key_in_order(+Pairs, -Assoc): Key -> the values of Key, in
% the order of Pairs.
group_by_key_in_order(Pairs, Assoc) :-
    findall(K-(I-V), nth1(I, Pairs, K-V), KIV),
    keysort(KIV, Sorted),
    group_pairs_by_key(Sorted, Groups),
    findall(K-Vs, ( member(K-IVs, Groups), keysort(IVs, IVs1),
                    pairs_values(IVs1, Vs) ), KVs),
    list_to_assoc(KVs, Assoc).

% ---------------------------------------------------------------------
% show and report
% ---------------------------------------------------------------------

has_build(KB) :- kb_uses(KB, U), memberchk(build, U).
has_discovery(KB) :- kb_uses(KB, U), memberchk(discovery, U).

% vote_section(+Eng) (D14): the Vote: section of report. The agent's vote
% and the formal artifacts' vote are sealed until the human votes in the
% current round. A query can still read them: this is the honest path,
% not a lock.
vote_section(Eng) :-
    rhead('Vote'),
    ( eng_all(Eng, [Rq], request(Rq, _), [Rq1|_]) -> true ; Rq1 = 'REQUEST' ),
    eng_all(Eng, [R], vote_round(R), Rs),
    (   Rs == []
    ->  rsplit(vote, "No vote yet. The agent votes first, and seals the vote: orbit-kb attest vote ~w 'vote(1, CHOICE)'. CHOICE is go, no_go, or hold.", [Rq1])
    ;   Rs = [R1|_],
        eng_all(Eng, [H], human_vote(H), Hs),
        eng_all(Eng, [A], agent_vote(A), As),
        (   Hs == []
        ->  rsplit(vote, "Round ~w. The human has not voted. The other votes stay sealed until the human votes.", [R1]),
            (   As == []
            ->  rsplit(vote, "The agent has not voted. Vote first: orbit-kb attest vote ~w 'vote(~w, CHOICE)'.", [Rq1, R1])
            ;   rsplit(vote, "The agent voted. Its vote is sealed.", [])
            ),
            rsplit(vote, "Record the human vote: orbit-kb attest vote ~w 'vote(~w, CHOICE)' --by human.", [Rq1, R1])
        ;   atomic_list_concat(Hs, ', ', HT),
            ( As == [] -> AT = 'no vote' ; atomic_list_concat(As, ', ', AT) ),
            ( eng_all(Eng, [V], artifact_vote(V), [V1|_]) -> true ; V1 = 'no vote' ),
            rsplit(vote, "Round ~w. Human (0.49): ~w. Agent (0.24): ~w. Formal artifacts (0.24): ~w.", [R1, HT, AT, V1]),
            eng_all(Eng, [G], gate(G), Gs0), sort(Gs0, Gs), atomic_list_concat(Gs, ', ', GT),
            rsplit(vote, "Outcome: ~w.", [GT]),
            (   eng_true(Eng, gate_split)
            ->  rsplit(vote, "The vote is split. The outcome is hold, and another orbit follows. Record the disagreement as a divergence, with a note: orbit-kb attest divergence H 'hypothesis(H)'.", [])
            ;   true
            )
        )
    ).

kb_engine(KB, Eng) :-
    kb_items(KB, Items),
    items_decls(Items, Ds),
    build_engine(Items, Ds, Eng).

eng_true(Eng, G) :- eng_all(Eng, [], G, L), L \== [].

say(Fmt, Args) :- format(Fmt, Args), nl.

txt(T, S) :- ( atom(T) -> S = T ; term_text(T, S) ).
plain_text(T, S) :- ( atomic(T) -> format(string(S), "~w", [T]) ; term_text(T, S) ).

cmd_show(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos == [] -> What = all
    ;   Pos = [What], memberchk(What, [claims, questions, open, blocking, disclosures, extensions, all]) -> true
    ;   usage_error("show takes one of: claims, questions, open, blocking, disclosures, extensions, all.", [])
    ),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    answer_gate(KB),
    kb_engine(KB, Eng),
    (   What == all
    ->  forall(member(W, [claims, questions, open, disclosures, extensions]),
               ( show_section(KB, Eng, W), nl ))
    ;   show_section(KB, Eng, What)
    ),
    Code = 0.

show_section(KB, Eng, claims) :-
    say("Claims:", []),
    eng_all(Eng, [C, L, T], claim(C, L, T), Cs),
    (   Cs == [] -> say("- None.", []) ; true ),
    % One query per relation, then lookups (see eng_set/4).
    eng_set(Eng, X1, current(X1), CurS),
    eng_groups(Eng, C2, N2, supersedes(N2, C2), SupBy),
    (   has_build(KB)
    ->  eng_set(Eng, X3, fulfilled(X3), FulS),
        eng_set(Eng, X4, under(X4), UndS),
        burn_sets(Eng, BSets)
    ;   true
    ),
    eng_groups(Eng, C5, X5, cites(C5, X5), CitesBy),
    eng_groups(Eng, C6, K6, check(K6, C6), ChecksBy),
    check_sets(Eng, KSets),
    forall(member([C, L, T], Cs),
           ( txt(T, TT), say("- ~w (~w): ~w", [C, L, TT]),
             ( eng_member(Eng, CurS, C, current(C)) -> St0 = "current"
             ; eng_lookup(Eng, SupBy, C, N, supersedes(N, C), Ns), atomic_list_concat(Ns, ', ', NT),
               fmt(St0, "superseded by ~w", [NT]) ),
             (   has_build(KB)
             ->  ( eng_member(Eng, FulS, C, fulfilled(C)) -> St1 = ", fulfilled"
                 ; eng_member(Eng, UndS, C, under(C)) -> St1 = ", under"
                 ; eng_true(Eng, check_waived(C)) -> St1 = ", not fulfilled (a human waived a check of it)"
                 ; St1 = "" )
             ;   St1 = ""
             ),
             say("  State: ~w~w.", [St0, St1]),
             (   has_build(KB), burn_text(Eng, BSets, C, BT), BT \== ""
             ->  sub_string(BT, 1, _, 0, BT1), say("  ~w", [BT1])
             ;   true
             ),
             eng_lookup(Eng, CitesBy, C, X, cites(C, X), Xs),
             forall(member(X, Xs), ( txt(X, XT), say("  Cites: ~w", [XT]) )),
             eng_lookup(Eng, ChecksBy, C, K, check(K, C), Ks),
             (   Ks == [] -> say("  Checks: none.", [])
             ;   findall(S, ( member(K, Ks), check_state(Eng, KSets, K, KS), fmt(S, "~w (~w)", [K, KS]) ), Ss),
                 atomic_list_concat(Ss, ', ', SsT),
                 say("  Checks: ~w.", [SsT])
             ) )).
show_section(_, Eng, questions) :-
    say("Questions:", []),
    eng_all(Eng, [Q, C, T], question(Q, C, T), Qs),
    (   Qs == [] -> say("- None.", []) ; true ),
    eng_groups(Eng, Q1, A1, assumed(Q1, A1), AssBy),
    eng_groups(Eng, Q2, [B2, W2], answer(Q2, B2, W2), AnsBy),
    eng_set(Eng, Q3, to_ask(Q3), AskS),
    forall(member([Q, C, T], Qs),
           ( txt(T, TT), say("- ~w (claim ~w): ~w", [Q, C, TT]),
             eng_lookup(Eng, AssBy, Q, A, assumed(Q, A), As),
             forall(member(A, As), ( term_text(A, AT), say("  Default: ~w.", [AT]) )),
             eng_lookup2(Eng, AnsBy, Q, [B, W], answer(Q, B, W), Bs),
             forall(member([B, W], Bs), ( term_text(B, BT), say("  Answer by ~w: ~w.", [W, BT]) )),
             ( eng_member(Eng, AskS, Q, to_ask(Q)) -> say("  Ask it now.", []) ; true ),
             ( eng_true(Eng, question_waived(Q)) -> say("  A human waived it (see the waivers in orbit-kb report).", []) ; true ) )).
show_section(KB, Eng, open) :-
    say("Open:", []),
    eng_all(Eng, [Q], to_ask(Q), Qs),
    eng_all(Eng, [A], stale(A), As),
    eng_all(Eng, [C], contested(C), Cs),
    forall(member(Q, Qs), say("- to_ask ~w: ask question ~w now.", [Q, Q])),
    forall(member(A, As), say("- stale ~w: approval ~w names an old digest.", [A, A])),
    forall(member(C, Cs), say("- contested ~w: a divergence names claim ~w.", [C, C])),
    eng_all(Eng, [Y], supersede_cycle(Y), Ys),
    forall(member(Y, Ys),
           ( ( eng_true(Eng, claim(Y, _, _)) -> YK = claim ; YK = hypothesis ),
             say("- supersede_cycle ~w: ~w ~w replaces itself (lint E15).", [Y, YK, Y]) )),
    (   has_build(KB)
    ->  eng_all(Eng, [U], under(U), Us),
        eng_all(Eng, [O], over(O), Os),
        eng_all(Eng, [B], burn_open(B), Bs0),
        eng_all(Eng, [F], flare_open(F), Fs),
        forall(member(U, Us), say("- under ~w: claim ~w is current but not fulfilled.", [U, U])),
        forall(member(O, Os), say("- over ~w: change ~w serves no claim.", [O, O])),
        forall(member(B, Bs0), say("- burn_open ~w: claim ~w needs a Lean proof.", [B, B])),
        forall(member(F, Fs), say("- flare_open ~w: claim ~w needs a human to approve a demo.", [F, F])),
        append(Bs0, Fs, Bs),
        % D17: done needs a current claim.
        (   eng_true(Eng, any_current_claim) -> Ns = []
        ;   Ns = [no_claim], say("- no_claim: no claim is current. Add a claim. The work is not done without one.", [])
        )
    ;   Us = [], Os = [], Bs = [], Ns = []
    ),
    (   Qs == [], As == [], Cs == [], Ys == [], Us == [], Os == [], Bs == [], Ns == [] -> say("- Nothing is open.", []) ; true ).
% D22: each answer of blocking(X), with the text of its item.
show_section(KB, Eng, blocking) :-
    say("Blocking:", []),
    eng_all(Eng, [X], blocking(X), Xs),
    (   Xs == [] -> say("- Nothing blocks done.", [])
    ;   forall(member(X, Xs), ( blocking_line(KB, Eng, X, S), say("~w", [S]) ))
    ).
show_section(_, Eng, disclosures) :-
    say("Disclosures:", []),
    eng_all(Eng, [I, S, P, B, T], attest(I, disclosure, S, P, B, T), Ds),
    (   Ds == [] -> say("- None.", []) ; true ),
    forall(member([I, S, P, B, T], Ds),
           ( term_text(P, PT), say("- ~w: ~w, about ~w, by ~w at ~w.", [I, PT, S, B, T]) )).
show_section(KB, _, extensions) :-
    say("Extensions:", []),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    findall(S, ( member(d(N, A, K, _, Doc, _, kb, _, _), Ds),
                 fmt(S, "- Local ~w predicate ~q/~w: ~w", [K, N, A, Doc]) ), S1),
    findall(S, ( member(it(kb, _, _, X, _, _), Items), nonvar(X), X = attest_type(T, Sh, W, Doc),
                 term_text(Sh, ShT),
                 fmt(S, "- Local attestation type ~q, shape ~w, writers ~w: ~w", [T, ShT, W, Doc]) ), S2),
    findall(N/A-DSrc, ( member(it(rules, _, _, T, _, _), Items), nonvar(T),
                        item_head_pi(it(rules, _, _, T, _, _), N/A),
                        decl_of(Ds, N, A, d(_, _, _, _, _, _, DSrc, _, _)),
                        ( DSrc == core ; DSrc = module(_) ) ), X0),
    sort(X0, X1),
    findall(S, ( member(N/A-DSrc, X1), src_text(DSrc, ST),
                 fmt(S, "- rules.pl extends ~q/~w from ~w.", [N, A, ST]) ), S3),
    append([S1, S2, S3], All),
    (   All == [] -> say("- None.", []) ; forall(member(S, All), say("~w", [S])) ).

% blocking_line(+KB, +Eng, +Item, -Line) (D22): one line of show blocking.
blocking_line(_, Eng, to_ask(Q), S) :- !,
    item_text(Eng, Q, T), fmt(S, "- to_ask ~w: ask question ~w now: ~w", [Q, Q, T]).
blocking_line(_, Eng, supersede_cycle(C), S) :- !,
    item_text(Eng, C, T), fmt(S, "- supersede_cycle ~w: ~w replaces itself (lint E15): ~w", [C, C, T]).
blocking_line(KB, Eng, past_due(X), S) :- !,
    ( eng_all(Eng, [D], due(X, D), [D1|_]) -> txt(D1, DT) ; DT = '?' ),
    item_text(Eng, X, T0), opt_change_text(KB, Eng, X, T0, T),
    fmt(S, "- past_due ~w: ~w was due at ~w, and it is still open: ~w", [X, X, DT, T]).
blocking_line(_, Eng, under(C), S) :- !,
    item_text(Eng, C, T),
    (   eng_true(Eng, ac(C))   % D29: an unmet acceptance criterion is named as such
    ->  fmt(S, "- under ~w: acceptance criterion ~w is not met (claim ~w is current but not fulfilled): ~w", [C, C, C, T])
    ;   fmt(S, "- under ~w: claim ~w is current but not fulfilled: ~w", [C, C, T])
    ).
blocking_line(KB, Eng, over(X), S) :- !,
    opt_change_text(KB, Eng, X, '', T), fmt(S, "- over ~w: change ~w serves no claim: ~w", [X, X, T]).
blocking_line(_, Eng, burn_open(C), S) :- !,
    item_text(Eng, C, T), fmt(S, "- burn_open ~w: claim ~w needs a Lean proof: ~w", [C, C, T]).
blocking_line(_, Eng, flare_open(C), S) :- !,
    item_text(Eng, C, T), fmt(S, "- flare_open ~w: claim ~w needs a human to approve a demo: ~w", [C, C, T]).
blocking_line(_, _, no_claim, "- no_claim: no claim is current. Add a claim. The work is not done without one.") :- !.
blocking_line(_, Eng, check_failing(K), S) :- !,
    item_text(Eng, K, T), fmt(S, "- check_failing ~w: check ~w did not pass its last run: ~w", [K, K, T]).
blocking_line(_, Eng, check_unrun(K), S) :- !,
    item_text(Eng, K, T), fmt(S, "- check_unrun ~w: check ~w never ran: ~w", [K, K, T]).
blocking_line(_, Eng, waiver_lapsed(W), S) :- !,
    (   eng_all(Eng, [X, D, R], attest(W, waiver, _, waive(X, D, R), _, _), [[X1, D1, R1]|_])
    ->  txt(X1, XT), txt(D1, DT), txt(R1, RT),
        fmt(S, "- waiver_lapsed ~w: waiver ~w of ~w was due at ~w, and ~w still blocks: ~w", [W, W, XT, DT, XT, RT])
    ;   fmt(S, "- waiver_lapsed ~w: waiver ~w is past its due time.", [W, W])
    ).
blocking_line(_, Eng, project_conflict(Dr), S) :- !,
    (   eng_all(Eng, [Dc, Tx], ( project_conflict(Dr, Dc), project_draft_text(Dr, Tx) ), [[Dc1, Tx1]|_])
    ->  txt(Dc1, DcT), txt(Tx1, TxT)
    ;   DcT = '?', TxT = ''
    ),
    fmt(S, "- project_conflict ~w: draft ~w of the project KB conflicts with a change of the tracker, and decision ~w rests on it: ~w", [Dr, Dr, DcT, TxT]).
blocking_line(_, _, project_kb_unclean, "- project_kb_unclean: the project KB does not load clean, so a conflict could hide in it. Run orbit-kb lint on the project KB and fix the errors.") :- !.
blocking_line(_, _, X, S) :-
    term_text(X, XT), fmt(S, "- ~w", [XT]).

% ---------------------------------------------------------------------
% draft (D25): Markdown for a human to paste. Nothing is sent anywhere.
% ---------------------------------------------------------------------
% draft blocking: the stamp of kb.pl and each blocking item (as show blocking).
% It writes nothing and takes no lock.

cmd_draft(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos == [blocking] -> true
    ;   Pos == [outbound] -> true
    ;   usage_error("draft takes one subject and nothing else: draft blocking, or draft outbound.", [])
    ),
    (   Pos == [blocking]
    ->  kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
        answer_gate(KB),
        kb_engine(KB, Eng),
        directory_file_path(Dir, 'kb.pl', KbFile),
        sha256_file(KbFile, Digest),
        say("## Blocking items", []), nl,
        say("Stamp: spec-kb@~w", [Digest]), nl,
        eng_all(Eng, [X], blocking(X), Xs),
        (   Xs == [] -> say("- Nothing blocks done.", [])
        ;   forall(member(X, Xs), ( blocking_line(KB, Eng, X, S),
                                   ( X = project_conflict(_) -> md_say("", S, " Status: decide. A human settles it, never the date.") ; md_say("", S, "") ) ))
        ),
        Code = 0
    ;   kb_uses(KB, Us), memberchk(project, Us)
    ->  kb_engine(KB, Eng),
        say("## Outbound drafts", []), nl,
        eng_all(Eng, [D, P, T, S], draft(D, P, T, S), Ds0),
        findall(r(D, P, T, S), ( member([D, P, T, S], Ds0),
                                 \+ eng_true(Eng, pushed(D, _)),
                                 ( eng_true(Eng, outbound(D)) ; eng_true(Eng, conflict(D)) ) ), Rows),
        (   Rows == [] -> say("- Nothing to push.", [])
        ;   forall(member(Row, Rows), outbound_section(Eng, Row))
        ),
        (   Ds0 == []
        ->  say("- This KB has no draft facts. draft outbound reads only this KB. For the drafts of the project KB, run: orbit-kb --dir PROJECT draft outbound", [])
        ;   true
        ),
        Code = 0
    ;   usage_error("draft outbound needs a KB that uses the project module (D23).", [])
    ).

% Free text is pasted into a tracker that renders Markdown and HTML (D25 T7).
% md_escape/2: & < > become entities; ` | [ ] \ get a backslash. The text has no line break.
% md_say(+Prefix, +Text, +Suffix): the first line of Text stays on the bullet (Prefix, escaped
% line, Suffix); each further line goes under it with the prefix "  > ".
md_break(C) :- memberchk(C, [0'\n, 0'\r, 0'\v, 0'\f, 0x85, 0x2028, 0x2029]).
md_lines(Text, Lines) :-
    plain_text(Text, S), string_codes(S, Cs),
    md_split(Cs, Lines).
md_split(Cs, [L|Ls]) :-
    (   append(Pre, [B|Post], Cs), md_break(B)
    ->  ( B == 0'\r, Post = [0'\n|Post1] -> true ; Post1 = Post ),
        !, string_codes(L, Pre), md_split(Post1, Ls)
    ;   string_codes(L, Cs), Ls = []
    ).
md_escape(In, Out) :-
    plain_text(In, S), string_codes(S, Cs),
    foldl([C, A0, A]>>( md_esc_code(C, Es), append(A0, Es, A) ), Cs, [], Os),
    string_codes(Out, Os).
md_esc_code(0'&, Cs) :- !, string_codes("&amp;", Cs).
md_esc_code(0'<, Cs) :- !, string_codes("&lt;", Cs).
md_esc_code(0'>, Cs) :- !, string_codes("&gt;", Cs).
md_esc_code(C, [0'\\, C]) :- memberchk(C, [0'`, 0'|, 0'[, 0'], 0'\\]), !.
md_esc_code(C, [C]).
md_inline(In, Out) :-
    md_lines(In, Ls), atomic_list_concat(Ls, ' ', J), md_escape(J, Out).
md_say(Prefix, Text, Suffix) :-
    md_lines(Text, [L1|Rest]),
    md_escape(L1, E1),
    say("~w~w~w", [Prefix, E1, Suffix]),
    forall(member(L, Rest), ( md_escape(L, E), say("  > ~w", [E]) )).

outbound_section(Eng, r(D, P, T, S)) :-
    md_inline(D, Dm), say("### ~w", [Dm]), nl,
    (   eng_all(Eng, [Src, C], pin(P, _, Src, _, C), [[Src1, C1]|_]) -> true ; Src1 = '?', C1 = '?' ),
    md_inline(P, Pm), say("- Pin: ~w", [Pm]),
    md_say("- Source: ", Src1, ""),
    md_inline(C1, C1m), say("- ChangedAt: ~w", [C1m]),
    md_inline(S, Sm), say("- Staged: ~w", [Sm]),
    (   eng_true(Eng, conflict(D))
    ->  (   eng_all(Eng, [C2], tracker_changed_after(P, C2), Cs2), Cs2 \== [] -> max_member(C2a, Cs2) ; C2a = '?' ),
        md_inline(C2a, C2m), say("- Tracker changed: ~w", [C2m]),
        say("- Status: decide", []),
        say("- Decide: a human picks one side, the tracker edit or the draft edit. orbit-kb does not pick.", [])
    ;   say("- Status: ready", [])
    ),
    md_say("- Draft: ", T, ""), nl.

% pin-item ID SOURCE --text-file F --changed-at T [--kind tracker|file] (D25 T4):
% records pin(ID, Kind, SOURCE, sha256:HEX, T). The CLI computes the digest of F.
cmd_pin_item(KB, Args, Code) :-
    parse_opts(Args, ['--text-file'-value, '--changed-at'-value, '--kind'-value], Pos, Opts),
    (   Pos = [Id, Src] -> true
    ;   usage_error("pin-item takes an id and a source: orbit-kb pin-item ID SOURCE --text-file F --changed-at T.", [])
    ),
    (   kb_uses(KB, Us), memberchk(project, Us) -> true
    ;   usage_error("pin-item needs a KB that uses the project module.", [])
    ),
    (   memberchk('--text-file'-File, Opts) -> true ; usage_error("pin-item needs --text-file F.", []) ),
    (   memberchk('--changed-at'-At, Opts) -> true ; usage_error("pin-item needs --changed-at T.", []) ),
    opt(Opts, '--kind', tracker, Kind),
    (   memberchk(Kind, [tracker, file]) -> true ; usage_error("--kind takes tracker or file. It is ~w.", [Kind]) ),
    (   atom_string(At, AtS),
        re_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"/'', AtS) -> true
    ;   usage_error("--changed-at takes a UTC time such as 2026-10-01T09:00:00Z. It is ~w.", [At])
    ),
    (   exists_file(File) -> true ; usage_error("The text file ~w does not exist.", [File]) ),
    sha256_file(File, Digest),
    format(atom(Fact), "pin(~q, ~q, ~q, ~q, ~q)", [Id, Kind, Src, Digest, At]),
    cmd_add(KB, [Fact], Code).

% item_text(+Eng, +Id, -Text): the text of a claim or a question, or for a
% check, the check and the text of its claim. '' for another id.
item_text(Eng, X, T) :-
    (   eng_all(Eng, [T0], claim(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [C, T0], question(X, C, T0), [[C1, T1]|_]) -> txt(T1, TT), fmt(T, "~w (a question about claim ~w)", [TT, C1])
    ;   eng_all(Eng, [C], check(X, C), [C1|_])
    ->  ( eng_all(Eng, [T0], claim(C1, _, T0), [T1|_]) -> txt(T1, CT) ; CT = '' ),
        fmt(T, "a check of claim ~w: ~w", [C1, CT])
    ;   T = ''
    ).

% opt_change_text(+KB, +Eng, +Id, +Default, -Text): the text of change Id
% when the build module is in use, else Default.
opt_change_text(KB, Eng, X, D, T) :-
    (   has_build(KB), eng_all(Eng, [T0], change(X, T0), [T1|_]) -> txt(T1, T) ; T = D ).

% The state of a check, from check_sets/2: passed, not passed (it has a
% test result), or never run.
check_sets(Eng, ks(PassS, RunS)) :-
    eng_set(Eng, K1, passed(K1), PassS),
    eng_set(Eng, K2, attest(_, test_result, _, result(K2, _, _), _, _), RunS).

check_state(Eng, ks(PassS, RunS), K, S) :-
    (   eng_member(Eng, PassS, K, passed(K)) -> S = "passed"
    ;   eng_member(Eng, RunS, K, attest(_, test_result, _, result(K, _, _), _, _))
    ->  S = "not passed"
    ;   S = "never run"
    ).

% The burn state of a claim, for show and report: proved, waived (with
% the due time), open, or not a burn. D21: the flare state too: shown
% (with the demo), waived, open, or not a flare.
burn_sets(Eng, bs(BurnS, ProvS, WaivBy, FlareS, ShownS)) :-
    eng_set(Eng, X1, burn(X1), BurnS),
    eng_set(Eng, X2, burn_proved(X2), ProvS),
    eng_groups(Eng, C3, D3, ( attest(W3, waiver, _, waive(C3, D3, _), human, _), not(waiver_lapsed(W3)) ), WaivBy),
    eng_set(Eng, X4, flare(X4), FlareS),
    eng_set(Eng, X5, flare_shown(X5), ShownS).

% esc_parts(+Eng, +BSets, +C, -Parts): the Head-Detail pairs of the burn
% and the flare of claim C, in that order; [] when it has neither.
esc_parts(Eng, BSets, C, Parts) :-
    burn_parts(Eng, BSets, C, BH, BD),
    flare_parts(Eng, BSets, C, FH, FD),
    exclude([H-_]>>(H == ""), [BH-BD, FH-FD], Parts).

flare_parts(Eng, bs(_, _, WaivBy, FlareS, ShownS), C, Head, Detail) :-
    (   \+ eng_member(Eng, FlareS, C, flare(C)) -> Head = "", Detail = ""
    ;   eng_member(Eng, ShownS, C, flare_shown(C))
    ->  Head = "Flare: shown.",
        eng_all(Eng, [S, P], ( demo(S, C), attest(_, approval, S, digest(D), human, _), subject(S, P, D) ), SPs),
        findall(T, ( member([S, P], SPs), fmt(T, "~w (~w)", [S, P]) ), Ts0),
        sort(Ts0, Ts), atomic_list_concat(Ts, ', ', TsT),
        fmt(Detail, "A human approved demo ~w.", [TsT])
    ;   eng_lookup(Eng, WaivBy, C, D, ( attest(W, waiver, _, waive(C, D, _), human, _), not(waiver_lapsed(W)) ), [D1|_])
    ->  Head = "Flare: NOT SHOWN.", fmt(Detail, "A human waived the demo until ~w.", [D1])
    ;   Head = "Flare: NOT SHOWN.", Detail = "A human must approve a demo of it."
    ).

burn_parts(Eng, bs(BurnS, ProvS, WaivBy, _, _), C, Head, Detail) :-
    (   \+ eng_member(Eng, BurnS, C, burn(C)) -> Head = "", Detail = ""
    ;   eng_member(Eng, ProvS, C, burn_proved(C)) -> Head = "Burn: proved in Lean.", Detail = ""
    ;   eng_lookup(Eng, WaivBy, C, D, ( attest(W, waiver, _, waive(C, D, _), human, _), not(waiver_lapsed(W)) ), [D1|_])
    ->  Head = "Burn: NOT PROVED.", fmt(Detail, "A human waived the proof until ~w.", [D1])
    ;   Head = "Burn: NOT PROVED.", Detail = "A Lean proof is required."
    ).

burn_text(Eng, BSets, C, T) :-
    esc_parts(Eng, BSets, C, Parts),
    findall(PT, ( member(Head-Detail, Parts),
                  ( Detail == "" -> fmt(PT, " ~w", [Head]) ; fmt(PT, " ~w ~w", [Head, Detail]) ) ),
            PTs),
    atomic_list_concat(PTs, '', T0), atom_string(T0, T).

% Joins for show and report. A section asks the SWI engine once per
% relation, not once per claim or check, and then looks the answers up.
% eng_set/4 and eng_groups/5 give none when the answers are not
% complete (the answer cap, an error, or answers with variables). Then
% the lookups ask the SWI engine directly, as for one item.
%
% eng_set(+Eng, ?X, +G, -Set): the answers X of G, as an AVL set.
eng_set(Eng, X, G, Set) :-
    swi_raw(Eng, G, [X], R),
    (   R = answers(L0, false), ground(L0)
    ->  findall(V-t, member([V], L0), Ps0),
        sort(Ps0, Ps),
        ord_list_to_assoc(Ps, Set)
    ;   Set = none
    ).

eng_member(Eng, Set, X, G) :-
    (   Set \== none, ground(X)
    ->  get_assoc(X, Set, _)
    ;   eng_true(Eng, G)
    ).

% eng_groups(+Eng, ?K, ?V, +G, -By): Key -> the values V of the answers
% of G with that key K, in answer order.
eng_groups(Eng, K, V, G, By) :-
    swi_raw(Eng, G, [K, V], R),
    (   R = answers(L, false), ground(L)
    ->  findall(K1-V1, member([K1, V1], L), Ps),
        group_by_key_in_order(Ps, By)
    ;   By = none
    ).

% eng_lookup(+Eng, +By, +K, ?V, +G, -Vs): as eng_all(Eng, [V], G, Vs).
eng_lookup(Eng, By, K, V, G, Vs) :-
    (   By \== none, ground(K)
    ->  ( get_assoc(K, By, Vs) -> true ; Vs = [] )
    ;   eng_all(Eng, [V], G, Vs)
    ).

% eng_lookup2: as eng_lookup/6 for a value template that is a list,
% such as [B, W]; the result is as eng_all(Eng, [B, W], G, Vs).
eng_lookup2(Eng, By, K, VT, G, Vs) :-
    (   By \== none, ground(K)
    ->  ( get_assoc(K, By, Vs) -> true ; Vs = [] )
    ;   eng_all(Eng, VT, G, Vs)
    ).

% waiver_kind(+Eng, +X, -Kind) (D13): the kind of the target of a waiver:
% claim, check, question, or "unknown id".
waiver_kind(Eng, X, K) :-
    (   eng_true(Eng, claim(X, _, _)) -> K = claim
    ;   eng_true(Eng, check(X, _)) -> K = check
    ;   eng_true(Eng, question(X, _, _)) -> K = question
    ;   K = 'unknown id'
    ).

% The text of report (D16 c4) is plain Markdown that also reads as raw
% text: "# Section:" headings with a blank line between sections, bullets
% indented by two spaces per level, the label in **bold**, and nesting
% for the detail of an item. It has no colour and no box drawing.
%
% report_line(S): each line that report printed, in order. The digest
% and the "Plain text" part of the page are made from these lines.
% report_rec(Tag, Plain) (D16): the same output as one record per item,
% in order, with the item that it is about and its text as one plain
% sentence. report --html builds the page from these records, so the
% page and the text cannot disagree.
:- dynamic report_rec/2, report_line/1, report_started/0.

rline(S) :- format("~w~n", [S]), assertz(report_line(S)).

% rhead(+Name): the heading of a section, after a blank line (but the first).
rhead(Name) :-
    (   report_started -> rline("") ; assertz(report_started) ),
    format(string(H), "# ~w:", [Name]),
    rline(H),
    format(string(P), "~w:", [Name]),
    assertz(report_rec(head(Name), P)).

% rtree(+Tag, +Plain, +Node): print one item and record it. Node is
% Text-Kids, and each kid is a node. The top bullet has two spaces,
% and each level adds two.
rtree(Tag, Plain, Node) :-
    assertz(report_rec(Tag, Plain)),
    rnode(1, Node).

rnode(Depth, Text-Kids) :-
    Indent is 2 * Depth,
    format(string(Pad), "~*c", [Indent, 0' ]),
    format(string(L), "~w- ~w", [Pad, Text]),
    rline(L),
    D1 is Depth + 1,
    forall(member(K, Kids), rnode(D1, K)).

% rsay(+Tag, +Fmt, +Args): a bullet with no nesting.
rsay(Tag, Fmt, Args) :-
    format(string(S), Fmt, Args),
    rtree(Tag, S, S-[]).

% as_sentence(+Text, -S): Text, with a period when it has no end mark.
% The page shows this form, so that its sentences do not run together.
as_sentence(T, S) :-
    plain_text(T, S0),
    ( T == "" -> S = S0 ; ends_sentence(T) -> S = S0 ; format(string(S), "~w.", [S0]) ).

% ends_sentence(+Text): the text ends in . ? or !
ends_sentence(T) :-
    plain_text(T, S),
    sub_string(S, _, 1, 0, E), sub_atom(".?!", _, 1, _, E).

cmd_report(KB, Args, Code) :-
    parse_opts(Args, ['--html'-value, '--open'-flag], Pos, Opts),
    ( Pos == [] -> true ; usage_error("report takes no arguments.", []) ),
    opt(Opts, '--html', none, Html),
    opt(Opts, '--open', false, Open),
    ( Open == true, Html == none -> usage_error("--open needs --html FILE.", []) ; true ),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    answer_gate(KB),
    kb_engine(KB, Eng),
    retractall(report_rec(_, _)), retractall(report_line(_)), retractall(report_started),
    report_text(KB, Eng),
    (   Html == none
    ->  Code = 0
    ;   report_page(KB, Eng, Html, Open, Code)
    ).

% claim_node(+Build, +C, +L, +TT, +SK, +StHead, +StDetail, +Parts, +KStates, -Node)
% Parts: the Head-Detail pairs of the burn and the flare (esc_parts/4).
% A claim that is fulfilled, with nothing to add, is one line: its checks
% all passed, its burn is proved or absent, it has no flare (D21: the
% demo always shows), and the line, with its
% bullet, fits in 100 columns. Any other claim breaks its status, burn,
% and checks into nested bullets, so that its status never wraps off
% the end of a long line.
claim_node(Build, C, L, TT, SK, StHead, StDetail, Parts, KStates, Node) :-
    format(string(Head), "~w **~w**: ~w", [C, L, TT]),
    (   memberchk(SK, [fulfilled, none]),
        ( Parts == [] ; Parts = ["Burn: proved in Lean."-_] ),
        KStates \== [],
        forall(member(_-KS, KStates), KS == "passed"),
        (   ends_sentence(TT) -> Sep = " " ; Sep = ". " ),
        findall(P, ( call(Build), StHead \== "", P = StHead
                   ; member(P-_, Parts)
                   ; check_line(KStates, P, _) ),
                Ps),
        atomic_list_concat(Ps, ' ', PsT),
        format(string(Line), "~w~w~w", [Head, Sep, PsT]),
        string_length(Line, Len),
        Len + 4 =< 100
    ->  Node = Line-[]
    ;   findall(N, claim_kid(Build, StHead, StDetail, Parts, KStates, N), Kids),
        Node = Head-Kids
    ).

claim_kid(Build, StHead, StDetail, _, _, N) :-
    call(Build), StHead \== "",
    ( StDetail == "" -> N = StHead-[] ; N = StHead-[StDetail-[]] ).
claim_kid(_, _, _, Parts, _, N) :-
    member(BHead-BDetail, Parts),
    ( BDetail == "" -> N = BHead-[] ; N = BHead-[BDetail-[]] ).
claim_kid(_, _, _, _, KStates, N) :-
    check_line(KStates, T, Kids), N = T-Kids.

% check_line(+KStates, -Text, -Kids): "Checks: none.", "Checks: k1 (passed).",
% or "Checks:" with one kid per check.
check_line([], "Checks: none.", []).
check_line([K-KS], T, []) :- format(string(T), "Checks: ~w (~w).", [K, KS]).
check_line([A, B|R], "Checks:", Kids) :-
    findall(N, ( member(K-KS, [A, B|R]), format(string(X), "~w (~w)", [K, KS]), N = X-[] ), Kids).

report_text(KB, Eng) :-
    Build = has_build(KB),
    rhead('Delivered'),
    rsay(placeholder, "(Write what you delivered here.)", []),
    rhead('Claims'),
    eng_all(Eng, [C, L, T], ( claim(C, L, T), current(C) ), Cs),
    (   Cs == [] -> rsay(none, "No current claims.", []) ; true ),
    % One query per relation, then lookups (see eng_set/4).
    ( call(Build) -> eng_set(Eng, X1, fulfilled(X1), FulS), burn_sets(Eng, BSets) ; true ),
    eng_groups(Eng, C2, K2, check(K2, C2), ChecksBy),
    check_sets(Eng, KSets),
    forall(member([C, L, T], Cs),
           ( txt(T, TT),
             (   call(Build)
             ->  (   eng_member(Eng, FulS, C, fulfilled(C)) -> StHead = "Status: fulfilled.", StDetail = "", SK = fulfilled
                 ;   eng_all(Eng, [WK, WD], ( check(WK, C), attest(WW, waiver, _, waive(WK, WD, _), human, _), not(waiver_lapsed(WW)) ), [[WK1, WD1]|_])
                 ->  StHead = "Status: not fulfilled.",
                     fmt(StDetail, "A human waived check ~w until ~w, so the claim does not block done until then.", [WK1, WD1]),
                     SK = waived
                 ;   StHead = "Status: under.", StDetail = "It is not fulfilled yet.", SK = under
                 ),
                 esc_parts(Eng, BSets, C, Parts),
                 join_sentences(StHead, StDetail, S1),
                 string_concat(" ", S1, St0),
                 findall(B1, ( member(BHead-BDetail, Parts), join_sentences(BHead, BDetail, B0),
                               string_concat(" ", B0, B1) ), B1s),
                 atomic_list_concat(B1s, '', BT0), atom_string(BT0, BT),
                 string_concat(St0, BT, St)
             ;   St = "", St0 = "", BT = "", SK = none,
                 StHead = "", StDetail = "", Parts = []
             ),
             eng_lookup(Eng, ChecksBy, C, K, check(K, C), Ks),
             findall(K-KS, ( member(K, Ks), check_state(Eng, KSets, K, KS) ), KStates),
             (   Ks == [] -> KT = " Checks: none."
             ;   findall(S, ( member(K-KS, KStates), fmt(S, "~w (~w)", [K, KS]) ), Ss),
                 atomic_list_concat(Ss, ', ', SsT), fmt(KT, " Checks: ~w.", [SsT])
             ),
             claim_node(Build, C, L, TT, SK, StHead, StDetail, Parts, KStates, Node),
             format(string(Plain), "~w (~w): ~w~w~w", [C, L, TT, St, KT]),
             rtree(claim(C, L, TT, SK, St0, BT, KStates), Plain, Node) )),
    rhead('Guesses'),
    eng_all(Eng, [Q, A], ( assumed(Q, A), not(answered(Q)) ), Gs),
    % D17: say that a human answered only when a question with a default exists.
    (   Gs \== [] -> true
    ;   eng_all(Eng, [Q0], assumed(Q0, _), [_|_])
    ->  rsay(none, "None. A human answered every question with a default.", [])
    ;   rsay(none, "None. No question has a default.", [])
    ),
    eng_groups(Eng, Q5, QT5, question(Q5, _, QT5), QTextBy),
    forall(member([Q, A], Gs),
           ( term_text(A, AT),
             ( eng_lookup(Eng, QTextBy, Q, QT, question(Q, _, QT), [QT1|_]) -> txt(QT1, QTT) ; QTT = "" ),
             as_sentence(QTT, QTS),
             format(string(Plain), "~w: ~w The default is ~w. No human answered it.", [Q, QTS, AT]),
             format(string(Head), "~w: ~w", [Q, QTT]),
             format(string(Kid), "The default is ~w. No human answered it.", [AT]),
             rtree(item(Q), Plain, Head-[Kid-[]]) )),
    rhead('Disclosures'),
    eng_all(Eng, [I, S0, P, B], attest(I, disclosure, S0, P, B, _), Ds),
    (   Ds == [] -> rsay(none, "None.", []) ; true ),
    forall(member([I, S0, P, B], Ds),
           ( term_text(P, PT),
             format(string(Plain), "~w: ~w, about ~w, by ~w.", [I, PT, S0, B]),
             (   compound(P), compound_name_arguments(P, Kind, [Arg])
             ->  plain_text(Arg, ArgT), format(string(Head), "~w **~w**: ~w", [I, Kind, ArgT])
             ;   format(string(Head), "~w: ~w", [I, PT])
             ),
             format(string(Kid), "About ~w, by ~w.", [S0, B]),
             rtree(item(I), Plain, Head-[Kid-[]]) )),
    (   call(Build)
    ->  rhead('Waivers'),
        eng_all(Eng, [W6, X6, D6, B6], attest(W6, waiver, _, waive(X6, D6, _), B6, _), W6s),
        (   W6s == [] -> rsay(none, "None.", []) ; true ),
        forall(member([W6, X6, D6, B6], W6s),
               ( waiver_kind(Eng, X6, Kind6),
                 ( atom(D6) -> DT6 = D6 ; term_text(D6, DT6) ),
                 (   B6 \== human
                 ->  St6 = "it does not count, because a human did not write it (E8)",
                     Lab6 = "ignored", Kid6 = "It does not count, because a human did not write it (E8)."
                 ;   eng_true(Eng, waiver_lapsed(W6))
                 ->  St6 = "lapsed, so the item blocks done again",
                     Lab6 = "lapsed", Kid6 = "The item blocks done again."
                 ;   St6 = "in force", Lab6 = "in force", Kid6 = ""
                 ),
                 format(string(Plain), "~w: ~w ~w, due ~w, ~w.", [W6, Kind6, X6, DT6, St6]),
                 format(string(Head), "~w **~w**: ~w ~w, due ~w", [W6, Lab6, Kind6, X6, DT6]),
                 ( Kid6 == "" -> Kids6 = [] ; Kids6 = [Kid6-[]] ),
                 rtree(item(W6), Plain, Head-Kids6) ))
    ;   true
    ),
    rhead('Not checked'),
    findall([C3, T3], ( member([C3, _, T3], Cs),
                        \+ ( eng_lookup(Eng, ChecksBy, C3, K3, check(K3, C3), [_|_]) ) ),
            NCs),
    (   NCs \== [] -> true
    ;   Cs == [] -> rsay(none, "None. No claim is current.", [])
    ;   rsay(none, "None. Every current claim has a check.", [])
    ),
    forall(member([C3, T3], NCs),
           ( txt(T3, TT3),
             as_sentence(TT3, TTS3),
             format(string(Plain), "~w: ~w It has no check.", [C3, TTS3]),
             format(string(Head), "~w: ~w", [C3, TT3]),
             rtree(item(C3), Plain, Head-["It has no check."-[]]) )),
    rhead('Open'),
    eng_all(Eng, [Q4], to_ask(Q4), Q4s),
    eng_all(Eng, [A4], stale(A4), A4s),
    eng_all(Eng, [Y4], supersede_cycle(Y4), Y4s),
    (   call(Build)
    ->  eng_all(Eng, [O4], over(O4), O4s),
        eng_all(Eng, [B4], burn_open(B4), B4s),
        eng_all(Eng, [F4], flare_open(F4), F4s),
        eng_all(Eng, [W4, C4, D4], ( attest(W4, waiver, _, waive(C4, D4, _), human, _), waiver_lapsed(W4) ), L4s),
        eng_all(Eng, [P4, C5], ( attest(P4, lean_proof, _, proof(C5, _), _, _), proof_changed(P4) ), P4s)
    ;   O4s = [], B4s = [], F4s = [], L4s = [], P4s = []
    ),
    % D17: in a build KB, done needs a current claim.
    ( call(Build), Cs == [] -> N4s = [no_claim] ; N4s = [] ),
    % D19: in a discovery KB, what blocks discovery_ready is open too.
    (   has_discovery(KB)
    ->  eng_all(Eng, [W5], question_waits(W5), W5s0),
        subtract(W5s0, Q4s, W5s),
        eng_all(Eng, [R5], ( refuted(R5), current(R5) ), R5s),
        (   eng_true(Eng, discovery_ready) -> D5s = [] ; D5s = [not_ready] )
    ;   W5s = [], R5s = [], D5s = []
    ),
    forall(member(_, N4s), ropen(open(no_claim, claims, none), "no claim", "No claim is current. Add a claim. The work is not done without one.", [])),
    forall(member(Q4, Q4s), ropen(open(to_ask, Q4, none), "ask", "Ask question ~w now.", [Q4])),
    forall(member(W5, W5s), ropen(open(question_waits, W5, none), "waits", "Question ~w waits for the human's answer.", [W5])),
    forall(member(R5, R5s), ropen(open(refuted, R5, none), "refuted", "Claim ~w is refuted. Record the counterexample as an example, and ask the human. Do not weaken the claim.", [R5])),
    forall(member(_, D5s), ropen(open(discovery_ready, discovery, none), "not ready", "Discovery is not ready. Run orbit-kb whynot 'discovery_ready' and orbit-kb lint for the rest.", [])),
    forall(member(A4, A4s), ropen(open(stale, A4, none), "stale", "Approval ~w is stale. The subject changed after the approval.", [A4])),
    forall(member(Y4, Y4s),
           (   eng_true(Eng, claim(Y4, _, _))
           ->  ropen(open(supersede_cycle, Y4, none), "cycle", "Claim ~w is in a supersede cycle. It replaces itself, so it is not current. Remove a supersedes fact (lint E15).", [Y4])
           ;   ropen(open(supersede_cycle, Y4, none), "cycle", "Hypothesis ~w is in a supersede cycle. It replaces itself. Remove a supersedes fact (lint E15).", [Y4])
           )),
    forall(member(O4, O4s), ropen(open(over, O4, none), "over", "Change ~w serves no claim.", [O4])),
    forall(member(B4, B4s), ropen(open(burn_open, B4, B4), "burn open", "Claim ~w needs a Lean proof. Prove it with orbit-kb prove, or ask a human for a waiver.", [B4])),
    forall(member(F4, F4s), ropen(open(flare_open, F4, F4), "flare open", "Claim ~w needs a human to approve a demo. Record a screenshot or a recording with orbit-kb subject and demo(S, C), show it, and ask the human to approve it or waive it.", [F4])),
    forall(member([W4, C4, D4], L4s),
           ( waiver_kind(Eng, C4, K4),
             Tag4 = open(waiver_lapsed, W4, C4),
             (   K4 == claim
             ->  (   eng_true(Eng, flare(C4)), eng_true(Eng, burn(C4))
                 ->  ropen(Tag4, "waiver lapsed", "Waiver ~w of the proof and the demo of claim ~w was due at ~w. The proof and the demo are due now.", [W4, C4, D4])
                 ;   eng_true(Eng, flare(C4))
                 ->  ropen(Tag4, "waiver lapsed", "Waiver ~w of the demo of claim ~w was due at ~w. The demo is due now.", [W4, C4, D4])
                 ;   ropen(Tag4, "waiver lapsed", "Waiver ~w of the proof of claim ~w was due at ~w. The proof is due now.", [W4, C4, D4])
                 )
             ;   K4 == check -> ropen(Tag4, "waiver lapsed", "Waiver ~w of check ~w was due at ~w. The check must pass now.", [W4, C4, D4])
             ;   K4 == question -> ropen(Tag4, "waiver lapsed", "Waiver ~w of question ~w was due at ~w. Ask the question now, if it is still open.", [W4, C4, D4])
             ;   ropen(Tag4, "waiver lapsed", "Waiver ~w of ~w was due at ~w.", [W4, C4, D4])
             ) )),
    forall(member([P4, C5], P4s), ropen(open(proof_changed, P4, C5), "proof changed", "Proof ~w of claim ~w no longer counts. A file of the proof changed. Run orbit-kb prove again.", [P4, C5])),
    (   Q4s == [], A4s == [], Y4s == [], O4s == [], B4s == [], F4s == [], L4s == [], P4s == [], N4s == [],
        W5s == [], R5s == [], D5s == []
    ->  rsay(none, "Nothing is open.", [])
    ;   true
    ),
    ( has_discovery(KB) -> vote_section(Eng) ; true ),
    rhead('To land'),
    rsay(placeholder, "(Write the steps to land the work here.)", []).

% ropen(+Tag, +Label, +Fmt, +Args): an item of the Open section, with its kind in bold.
ropen(Tag, Label, Fmt, Args) :-
    format(string(S), Fmt, Args),
    split_first(S, First, Rest),
    format(string(Head), "**~w**: ~w", [Label, First]),
    ( Rest == "" -> Kids = [] ; Kids = [Rest-[]] ),
    rtree(Tag, S, Head-Kids).

% rsplit(+Tag, +Fmt, +Args): a bullet of its first sentence, with the
% other sentences as one nested bullet.
rsplit(Tag, Fmt, Args) :-
    format(string(S), Fmt, Args),
    split_first(S, First, Rest),
    ( Rest == "" -> Kids = [] ; Kids = [Rest-[]] ),
    rtree(Tag, S, First-Kids).

% split_first(+S, -First, -Rest): the first sentence of S, without its
% final period, and the rest of S ("" when there is none).
split_first(S, First, Rest) :-
    (   sub_string(S, B, 2, A, ". "), A > 0
    ->  sub_string(S, 0, B, _, First), sub_string(S, _, A, 0, Rest)
    ;   sub_string(S, _, 1, 0, ".")
    ->  sub_string(S, 0, _, 1, First), Rest = ""
    ;   First = S, Rest = ""
    ).

% join_sentences(+A, +B, -S): A, and B after a space when B is not empty.
join_sentences(A, B, S) :-
    (   B == "" -> S = A ; format(string(S), "~w ~w", [A, B]) ).

% ---------------------------------------------------------------------
% report --html (D16): the delivery report as one page
% ---------------------------------------------------------------------
% The page is built from the records of report_text/2 (report_rec/2),
% plus evidence read from facts, and the verdict of done. It derives no
% other status itself. The page cannot write to the KB: review marks stay in
% the browser (localStorage) and leave it as text that the reviewer
% pastes back.

report_page(KB, Eng, Html, Open, Code) :-
    findall(Tag-S, report_rec(Tag, S), Recs),
    findall(S, report_line(S), Lines),
    atomic_list_concat(Lines, '\n', T0), string_concat(T0, "\n", Text),
    sha256_text(Text, Digest),
    (   has_build(KB)
    ->  eng_all(Eng, [], done, DL), ( DL \== [] -> Done = yes ; Done = no )
    ;   Done = none
    ),
    page_assets(Css, Js),
    absolute_file_name(Html, Abs),
    with_output_to(string(Page),
                   page_write(KB, Eng, Recs, Text, Digest, Done, Css, Js)),
    catch(setup_call_cleanup(open(Abs, write, Out, [encoding(utf8)]),
                             write(Out, Page),
                             close(Out)),
          E, ( err_text(E, M),
               die(2, ["Cannot write the page " + Abs + ": " + M,
                       "Fix: give a path in a directory that exists and that you can write."] >> fix_lines) )),
    format(user_error, "HTML written to ~w~n", [Abs]),
    ( Open == true -> open_page(Abs) ; true ),
    Code = 0.

% page_assets(-Css, -Js): the style and the script of the page, from the
% library (report/page.css, report/page.js). They are inlined.
page_assets(Css, Js) :-
    lib_dir(Lib),
    maplist(page_asset(Lib), ['report/page.css', 'report/page.js'], [Css, Js]).

page_asset(Lib, Rel, Text) :-
    directory_file_path(Lib, Rel, F),
    (   exists_file(F)
    ->  read_file_to_string(F, Text, [encoding(utf8)])
    ;   die(2, ["The library has no " + Rel + " (" + F + ").",
                "Fix: check ORBIT_KB_LIB, or run install.py again."] >> fix_lines)
    ).

% open_page(+File): --open. xdg-open, else open. It does not wait.
open_page(File) :-
    (   member(Exe, ['xdg-open', open]),
        absolute_file_name(path(Exe), P, [access(execute), file_errors(fail)])
    ->  catch(( process_create(P, [File], [stdin(null), stdout(null), stderr(null),
                                           detached(true), process(_)]),
                format(user_error, "Opened the page with ~w.~n", [Exe]) ),
              E, ( err_text(E, M), format(user_error, "Could not open the page with ~w: ~w~n", [Exe, M]) ))
    ;   format(user_error, "Could not open the page: no xdg-open or open on PATH. Open ~w in a browser.~n", [File])
    ).

% --- HTML helpers. Every KB string goes through esc/2 or he/1.

esc(X, S) :-
    plain_text(X, T0),
    string_codes(T0, Cs),
    html_esc_codes(Cs, Es),
    string_codes(S, Es).

html_esc_codes([], []).
html_esc_codes([C|Cs], Out) :-
    (   html_esc_code(C, E)
    ->  string_codes(E, ECs), append(ECs, Rest, Out)
    ;   Out = [C|Rest]
    ),
    html_esc_codes(Cs, Rest).

html_esc_code(0'&, "&amp;").
html_esc_code(0'<, "&lt;").
html_esc_code(0'>, "&gt;").
html_esc_code(0'", "&quot;").
html_esc_code(0'', "&#39;").

he(X) :- esc(X, S), write(S).

% file_url(+Path, -Url): a file:// URL, percent-encoded as a URI path.
file_url(Path, Url) :-
    use_module(library(uri)),
    uri_encoded(path, Path, Enc),
    atom_concat('file://', Enc, Url).

strip_dash(S0, S) :- ( sub_string(S0, 0, 2, _, "- ") -> sub_string(S0, 2, _, 0, S) ; S = S0 ).
trim_lead(S0, S) :- ( sub_string(S0, 0, 1, _, " ") -> sub_string(S0, 1, _, 0, S) ; S = S0 ).

status_glyph(fulfilled, "&#10003;").
status_glyph(under, "&#10007;").
status_glyph(waived, "&#9684;").
status_glyph(none, "&#8211;").

% mark_box(+Key): the review marks of one item. Items with the same key
% share one mark.
mark_box(Key) :-
    esc(Key, K),
    format("<div class=\"mark\" role=\"group\" aria-label=\"Review of ~w\" data-key=\"~w\">", [K, K]),
    forall(member(M, [ok, doubt, wrong]),
           format("<button type=\"button\" data-mark=\"~w\" aria-pressed=\"false\">~w</button>", [M, M])),
    format("<input type=\"text\" maxlength=\"300\" placeholder=\"Note (optional)\" aria-label=\"Note on ~w\">", [K]),
    format("</div>~n", []).

% records of one section: the records after head(Name), up to the next head
section_recs(Recs, Name, Out) :-
    (   append(_, [head(Name)-_|After], Recs)
    ->  ( append(Out, [head(_)-_|_], After) -> true ; Out = After )
    ;   Out = []
    ).

page_write(KB, Eng, Recs, Text, Digest, Done, Css, Js) :-
    kb_dir(KB, Dir),
    get_time(Now), format_time(string(When), "%FT%TZ", Now, posix),
    findall(C-SK, member(claim(C, _, _, SK, _, _, _)-_, Recs), CSKs),
    length(CSKs, NC),
    findall(K-N, ( member(K, [fulfilled, under, waived]),
                   aggregate_all(count, member(_-K, CSKs), N), N > 0 ), Counts),
    findall(C, member(C-under, CSKs), Unders),
    section_recs(Recs, 'Open', OpenRecs),
    findall(X, ( member(X-_, OpenRecs), X = open(_, _, _) ), OpenItems),
    length(Unders, NU), length(OpenItems, NO),
    NOpen is NU + NO,
    format("<!doctype html>~n<html lang=\"en\">~n<head>~n<meta charset=\"utf-8\">~n", []),
    format("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">~n", []),
    format("<meta name=\"generator\" content=\"orbit-kb report --html\">~n", []),
    file_base_name(Dir, Base),
    format("<title>Delivery report: ", []), he(Base), format("</title>~n<style>~n~w</style>~n</head>~n", [Css]),
    esc(Dir, DirE), esc(Digest, DigE),
    format("<body data-kb=\"~w\" data-digest=\"~w\">~n<div class=\"wrap\">~n", [DirE, DigE]),
    % header
    format("<header class=\"top\">~n<h1>Delivery report</h1>~n", []),
    eng_all(Eng, [R, RT], request(R, RT), Rqs),
    forall(member([R, RT], Rqs),
           ( format("<p class=\"request\"><span class=\"id\">", []), he(R),
             format("</span> ", []), he(RT), format("</p>~n", []) )),
    format("<p class=\"meta\">KB <code>~w</code><br>Written ~w. Report <code title=\"~w\">", [DirE, When, DigE]),
    sub_string(Digest, 7, 12, _, DShort), he(DShort),
    format("</code></p>~n<ul class=\"chips\" aria-label=\"Summary\">~n", []),
    plural(NC, PC), format("<li class=\"chip\">~w claim~w</li>~n", [NC, PC]),
    forall(member(K-N, Counts),
           ( status_glyph(K, G),
             format("<li class=\"chip st-~w\"><span aria-hidden=\"true\">~w</span> ~w ~w</li>~n", [K, G, N, K]) )),
    (   NOpen =:= 0
    ->  format("<li class=\"chip st-fulfilled\">nothing open</li>~n", [])
    ;   plural(NOpen, PO),
        format("<li class=\"chip st-under\"><a href=\"#open\">~w open item~w</a></li>~n", [NOpen, PO])
    ),
    (   Done \== none
    ->  ( Done == yes -> DoneT = "done: yes", DoneK = fulfilled ; DoneT = "done: no", DoneK = under ),
        format("<li class=\"chip st-~w\">~w</li>~n", [DoneK, DoneT])
    ;   true
    ),
    format("</ul>~n", []),
    format("<p class=\"tools\"><button type=\"button\" id=\"expand-all\">Show all evidence</button></p>~n", []),
    format("</header>~n<main>~n", []),
    % open items first
    format("<section data-section=\"open\" id=\"open\" aria-labelledby=\"h-open\">~n<h2 id=\"h-open\">Open: needs a decision or more work</h2>~n", []),
    (   NOpen =:= 0
    ->  format("<p class=\"empty\">Nothing is open.</p>~n", [])
    ;   format("<ul class=\"open\">~n", []),
        forall(member(claim(C, L, TT, under, St0, BT, _)-_, Recs),
               ( esc(C, CE),
                 format("<li data-open=\"under\" data-ref=\"~w\"><span class=\"badge st-under\">under</span> <a href=\"#claim-~w\">Claim ~w</a> (", [CE, CE, CE]),
                 he(L), format("): ", []), he(TT), format(". ", []),
                 trim_lead(St0, St1), he(St1), he(BT),
                 format("~n", []), mark_box(C), format("</li>~n", []) )),
        forall(member(open(Kind, Ref, Tgt)-S, OpenRecs),
               ( esc(Ref, RE), open_label(Kind, Lab),
                 format("<li data-open=\"~w\" data-ref=\"~w\"><span class=\"badge st-under\">~w</span> ", [Kind, RE, Lab]),
                 strip_dash(S, S1), he(S1),
                 open_link(Eng, Recs, Kind, Ref, Tgt),
                 format("~n", []), mark_box(Ref), format("</li>~n", []) )),
        format("</ul>~n", [])
    ),
    format("</section>~n", []),
    % claims
    format("<section data-section=\"claims\" id=\"claims\" aria-labelledby=\"h-claims\">~n<h2 id=\"h-claims\">Claims</h2>~n", []),
    (   NC =:= 0 -> format("<p class=\"empty\">No current claims.</p>~n", []) ; true ),
    forall(member(claim(C, L, TT, SK, St0, BT, KStates)-_, Recs),
           page_claim(KB, Eng, C, L, TT, SK, St0, BT, KStates)),
    format("</section>~n", []),
    % the other sections, from the text lines
    page_list(Recs, 'Guesses', guesses, "Guesses", "Defaults that no human answered. Say if one is wrong."),
    page_list(Recs, 'Disclosures', disclosures, "Disclosures", ""),
    (   has_build(KB) -> page_list(Recs, 'Waivers', waivers, "Waivers", "") ; true ),
    page_list(Recs, 'Not checked', not_checked, "Not checked", ""),
    (   has_discovery(KB) -> page_list(Recs, 'Vote', vote, "Vote", "") ; true ),
    format("<section data-section=\"text\" id=\"text\">~n<h2>Plain text</h2>~n<details><summary>The text of orbit-kb report</summary>~n<pre class=\"text\">", []),
    he(Text),
    format("</pre>~n</details>~n</section>~n</main>~n</div>~n", []),
    % review bar
    format("<footer class=\"review\" id=\"review\" aria-label=\"Review\">~n<div class=\"inner\">~n", []),
    format("<span id=\"review-count\" aria-live=\"polite\">No marks yet.</span>~n", []),
    format("<button type=\"button\" id=\"review-copy\">Copy review for the agent</button>~n", []),
    format("<button type=\"button\" id=\"review-clear\">Clear marks</button>~n", []),
    format("<span id=\"review-msg\" role=\"status\"></span>~n", []),
    format("<textarea id=\"review-text\" rows=\"5\" spellcheck=\"false\" aria-label=\"Review text to paste to the agent\" hidden></textarea>~n", []),
    format("</div>~n</footer>~n<script>~n~w</script>~n</body>~n</html>~n", [Js]).

plural(N, S) :- ( N =:= 1 -> S = "" ; S = "s" ).

open_label(no_claim, "no claim").
open_label(to_ask, "ask").
open_label(stale, "stale").
open_label(supersede_cycle, "cycle").
open_label(over, "over").
open_label(burn_open, "burn open").
open_label(flare_open, "flare open").
open_label(waiver_lapsed, "waiver lapsed").
open_label(proof_changed, "proof changed").
open_label(question_waits, "waits").
open_label(refuted, "refuted").
open_label(discovery_ready, "not ready").

% open_link: a link to the claim that an open item is about, when the
% claim is on the page.
open_link(Eng, Recs, Kind, Ref, Tgt) :-
    (   Kind == to_ask, eng_all(Eng, [C], question(Ref, C, _), [C1|_]) -> T = C1
    ;   Tgt \== none -> T = Tgt
    ;   T = none
    ),
    (   T \== none, memberchk(claim(T, _, _, _, _, _, _)-_, Recs)
    ->  esc(T, TE), format(" <a href=\"#claim-~w\">See claim ~w.</a>", [TE, TE])
    ;   true
    ).

% page_list: a section of the text report as a list, one item per line,
% with marks on items that have an id.
page_list(Recs, Head, Id, Title, Lead) :-
    section_recs(Recs, Head, Rs),
    format("<section data-section=\"~w\" id=\"~w\" aria-labelledby=\"h-~w\">~n<h2 id=\"h-~w\">~w</h2>~n", [Id, Id, Id, Id, Title]),
    (   Lead \== "", member(item(_)-_, Rs) -> format("<p class=\"lead\">~w</p>~n", [Lead]) ; true ),
    format("<ul class=\"items\">~n", []),
    forall(member(Tag-S, Rs),
           ( strip_dash(S, S1),
             (   Tag = item(X)
             ->  format("<li>", []), he(S1),
                 (   Head == 'Not checked' -> esc(X, XE), format(" <a href=\"#claim-~w\">See claim ~w.</a>", [XE, XE]) ; true ),
                 format("~n", []), mark_box(X), format("</li>~n", [])
             ;   format("<li class=\"plain\">", []), he(S1), format("</li>~n", [])
             ) )),
    format("</ul>~n</section>~n", []).

% page_claim: one claim, its status as the text report says it, and its
% evidence.
page_claim(KB, Eng, C, L, TT, SK, St0, BT, KStates) :-
    esc(C, CE),
    eng_all(Eng, [D, B, Tm], attest(D, divergence, _, claim(C), B, Tm), Dvs),
    % The evidence starts open when the claim needs attention.
    (   SK \== fulfilled -> Det = " open"
    ;   sub_string(BT, _, _, _, "A Lean proof is required") -> Det = " open"
    ;   sub_string(BT, _, _, _, "must approve a demo") -> Det = " open"
    ;   Dvs \== [] -> Det = " open"
    ;   Det = ""
    ),
    format("<article class=\"claim\" id=\"claim-~w\" data-claim=\"~w\" data-status=\"~w\">~n", [CE, CE, SK]),
    status_glyph(SK, G),
    format("<div class=\"chead\"><span class=\"id\">~w</span> <span class=\"label\">", [CE]), he(L),
    format("</span> <span class=\"badge st-~w\"><span aria-hidden=\"true\">~w</span>~w</span>", [SK, G, SK]),
    (   BT == "" ; \+ eng_true(Eng, burn(C)) -> true
    ;   eng_true(Eng, burn_proved(C)) -> format(" <span class=\"badge st-fulfilled\">burn proved</span>", [])
    ;   eng_true(Eng, burn_waived(C)) -> format(" <span class=\"badge st-waived\">burn not proved, waived</span>", [])
    ;   format(" <span class=\"badge st-under\">burn not proved</span>", [])
    ),
    (   BT == "" ; \+ eng_true(Eng, flare(C)) -> true
    ;   eng_true(Eng, flare_shown(C)) -> format(" <span class=\"badge st-fulfilled\">flare shown</span>", [])
    ;   eng_true(Eng, flare_waived(C)) -> format(" <span class=\"badge st-waived\">flare not shown, waived</span>", [])
    ;   format(" <span class=\"badge st-under\">flare not shown</span>", [])
    ),
    format("</div>~n<p class=\"ctext\">", []), he(TT), format("</p>~n", []),
    (   St0 == "" -> true
    ;   trim_lead(St0, S1), format("<p class=\"sentence\">", []), he(S1),
        ( BT == "" -> true ; format(" ", []), trim_lead(BT, B1), he(B1) ),
        format("</p>~n", [])
    ),
    % checks, with the latest run of each
    (   KStates == []
    ->  format("<p class=\"checks\">Checks: none.</p>~n", [])
    ;   format("<ul class=\"checks\" aria-label=\"Checks\">~n", []),
        forall(member(K-KS, KStates), page_check(KB, Eng, K, KS)),
        format("</ul>~n", [])
    ),
    format("<details class=\"evidence\"~w><summary>Evidence</summary>~n<div class=\"ev\">~n", [Det]),
    eng_all(Eng, [X], cites(C, X), Xs),
    ev_list("Cites", Xs, [X1]>>he(X1)),
    eng_all(Eng, [X], example(C, X), Es),
    ev_list("Examples", Es, [X1]>>he(X1)),
    ev_list("Divergences", Dvs, ev_divergence(Eng)),
    eng_all(Eng, [Q, QT], question(Q, C, QT), Qs),
    findall(S0, ( S0 = C ; member([S0, _], Qs) ), Subjs),
    findall([I, P, B, Tm], ( member(S0, Subjs), eng_all(Eng, [I, P, B, Tm], attest(I, disclosure, S0, P, B, Tm), L0), member([I, P, B, Tm], L0) ), Dcs),
    ev_list("Disclosures", Dcs,
            [[I1, P1, B1, Tm1]]>>( format("<span class=\"id\">", []), he(I1), format("</span> ", []), he(P1),
                                   format(", by ", []), he(B1), format(" at ", []), he(Tm1), format(".", []) )),
    (   has_build(KB)
    ->  findall(T0, ( T0 = C ; member(K-_, KStates), T0 = K ), Tgts),
        findall([W, T0, Due, Why, B], ( member(T0, Tgts),
                                        eng_all(Eng, [W, Due, Why, B], attest(W, waiver, _, waive(T0, Due, Why), B, _), L1),
                                        member([W, Due, Why, B], L1) ), Wvs),
        ev_list("Waivers", Wvs, ev_waiver(Eng))
    ;   true
    ),
    ev_list("Questions", Qs, ev_question(Eng)),
    eng_all(Eng, [N], note(C, N), CNs),
    ev_list("Notes", CNs, [X1]>>he(X1)),
    format("</div>~n</details>~n", []),
    mark_box(C),
    format("</article>~n", []).

ev_divergence(Eng, [D, B, Tm]) :-
    format("<span class=\"id\">", []), he(D), format("</span> by ", []), he(B),
    format(" at ", []), he(Tm), format(".", []),
    eng_all(Eng, [N], note(D, N), Ns),
    forall(member(N1, Ns), ( format(" ", []), he(N1) )).

ev_waiver(Eng, [W, T, Due, Why, B]) :-
    format("<span class=\"id\">", []), he(W), format("</span> waives ", []), he(T),
    format(" until ", []), he(Due), format(": ", []), he(Why), format(" (", []),
    (   B \== human -> format("it does not count: a human did not write it", [])
    ;   eng_true(Eng, waiver_lapsed(W)) -> format("<strong>lapsed</strong>", [])
    ;   format("in force", [])
    ),
    format(").", []).

ev_question(Eng, [Q, QT]) :-
    format("<span class=\"id\">", []), he(Q), format("</span> ", []), he(QT),
    plain_text(QT, QTS),
    ( sub_string(QTS, _, 1, 0, E), sub_atom(".?!", _, 1, _, E) -> true ; format(".", []) ),
    eng_all(Eng, [A], assumed(Q, A), As),
    forall(member(A1, As), ( format(" Default: ", []), he(A1), format(".", []) )),
    eng_all(Eng, [A, Wr], answer(Q, A, Wr), Ans),
    forall(member([A2, Wr2], Ans), ( format(" Answer by ", []), he(Wr2), format(": ", []), he(A2), format(".", []) )).

ev_list(_, [], _) :- !.
ev_list(Title, Xs, Goal) :-
    format("<h3>~w</h3>~n<ul>~n", [Title]),
    forall(member(X, Xs), ( format("<li>", []), call(Goal, X), format("</li>~n", []) )),
    format("</ul>~n", []).

% page_check: one check, with its state as the text report says it, and
% its latest run: number, result, time, and log.
page_check(KB, Eng, K, KS) :-
    esc(K, KE),
    eng_all(Eng, [N, R, Tm], attest(_, test_result, _, result(K, N, R), _, Tm), Runs0),
    findall(N-[R, Tm], ( member([N, R, Tm], Runs0), integer(N) ), Runs1),
    keysort(Runs1, Runs),
    length(Runs, NR),
    (   last(Runs, N-[R, Tm])
    ->  format("<li data-check=\"~w\" data-run=\"~w\" data-result=\"~w\">", [KE, N, R]),
        ( R == pass -> RK = fulfilled ; RK = under ),
        format("<span class=\"id\">~w</span> ~w. Latest run ~w: <span class=\"badge st-~w\">~w</span> at ", [KE, KS, N, RK, R]),
        he(Tm),
        ( NR > 1 -> format(" (~w runs)", [NR]) ; true ),
        format(". Log ", []),
        run_log_path(KB, K, N, Abs),
        format(atom(Rel), "runs/~w-~w.log", [N, K]),
        (   exists_file(Abs)
        ->  file_url(Abs, U), esc(U, UE), format("<a href=\"~w\"><code>", [UE]), he(Rel), format("</code></a>.", [])
        ;   format("<code>", []), he(Rel), format("</code> (missing).", [])
        )
    ;   format("<li data-check=\"~w\" data-run=\"none\" data-result=\"none\"><span class=\"id\">~w</span> ~w.", [KE, KE, KS])
    ),
    format("</li>~n", []).

% ---------------------------------------------------------------------
% doctor
% ---------------------------------------------------------------------

% Known-answer programs for the self-tests. Each runs on the SWI engine,
% as a query does.
doctor_neg_helper("under(a).\nany_under :- under(_).\ndone :- not any_under.\n").
doctor_neg_anon("under(a).\ndone :- not under(_).\n").
doctor_arith("attest(r1, test_result, k1, result(k1, 1, pass), script, t).\nattest(r2, test_result, k1, result(k1, 2, fail), script, t).\nattest(r3, test_result, k2, result(k2, 3, fail), script, t).\nattest(r4, test_result, k2, result(k2, 4, pass), script, t).\nattest(r5, test_result, k3, result(k3, 5, pass), script, t).\nattest(r6, test_result, k4, result(k4, 6, pass), script, t).\nattest(r7, test_result, k4, result(k4, 7, fail), script, t).\nattest(r8, test_result, k4, result(k4, 8, pass), script, t).\npassed(K) :- attest(_, test_result, _, result(K, R, pass), _, _), not failed_after(K, R).\nfailed_after(K, R) :- attest(_, test_result, _, result(K, R2, fail), _, _), R2 > R.\n").
doctor_unstratified("p :- not q.\nq :- not p.\n").
doctor_classical("p(a).\n-p(b).\n").

cmd_doctor(Args, Code) :-
    parse_opts(Args, [], Pos, _),
    ( Pos == [] -> true ; usage_error("doctor takes no arguments.", []) ),
    current_prolog_flag(version, V),
    VMaj is V // 10000, VMin is (V // 100) mod 100, VPat is V mod 100,
    current_prolog_flag(executable, SwiExe),
    (   absolute_file_name(path(swipl), SwiPath, [access(execute), file_errors(fail)])
    ->  say("ok    swipl: ~w (SWI-Prolog ~w.~w.~w; running as ~w).", [SwiPath, VMaj, VMin, VPat, SwiExe]), P1 = []
    ;   say("FAIL  swipl: not on PATH. This process runs ~w. Fix: put swipl on PATH.", [SwiExe]), P1 = [swipl]
    ),
    catch(( lib_dir(Lib), LibR = ok(Lib) ), orbit_error(_, Ls), ( atomic_list_concat(Ls, ' ', LT), LibR = bad(LT) )),
    (   LibR = ok(Lib)
    ->  lib_modules(Lib, Ms), atomic_list_concat(Ms, ', ', MT),
        say("ok    library: ~w (modules: ~w).", [Lib, MT]), P2 = []
    ;   LibR = bad(LT2),
        say("FAIL  library: ~w", [LT2]), P2 = [library]
    ),
    doctor_tests(Fails),
    append([P1, P2, Fails], All),
    (   All == []
    ->  say("Result: all checks passed.", []), Code = 0
    ;   length(All, NF), say("Result: ~w problem(s). Fix them before you trust orbit-kb.", [NF]), Code = 2
    ).

doctor_items(Name, Text, Items) :-
    read_source_string(test, Name, Text, Items).

% doctor_answers(+Name, +Text, +GoalText, -Result): ok(Answers) | failed(Message)
doctor_answers(Name, Text, GoalText, R) :-
    catch(( doctor_items(Name, Text, Items),
            parse_one(GoalText, ok(G, VN)),
            query_names(VN, _, Vars),
            build_engine(Items, [], Eng),
            swi_query(Eng, G, Vars, Res),
            (   Res = answers(L, _) -> sort(L, LS), R = ok(LS)
            ;   Res = error(M) -> R = failed(M)
            ) ),
          E, ( err_text(E, M), R = failed(M) )).

doctor_expect(Name, Text, GoalText, Want, What, F) :-
    doctor_answers(Name, Text, GoalText, R),
    sort(Want, WS),
    (   R = ok(WS)
    ->  say("ok    ~w.", [What]), F = []
    ;   R = ok(Got)
    ->  say("FAIL  ~w. Got ~q.", [What, Got]), F = [x]
    ;   R = failed(M),
        say("FAIL  ~w. Error: ~w", [What, M]), F = [x]
    ).

doctor_tests(Fails) :-
    doctor_neg_helper(T1),
    doctor_expect(neg1, T1, "done", [], "not with a helper rule: done must be false", F1),
    doctor_neg_anon(T2),
    doctor_expect(neg2, T2, "done", [], "not under(_) means no under at all: done must be false", F2),
    doctor_arith(T3),
    doctor_expect(arith, T3, "passed(K)", [[k2], [k3], [k4]], "arithmetic under not: passed(K) must be exactly k2, k3, k4", F3),
    doctor_unstratified(T4),
    doctor_items(e18, T4, I4),
    e18_diags(I4, [], D18),
    (   D18 \== []
    ->  say("ok    E18 flags rules that are not stratified (p :- not q, q :- not p).", []), F4 = []
    ;   say("FAIL  E18 does not flag p :- not q, q :- not p.", []), F4 = [e18]
    ),
    doctor_classical(T5),
    doctor_items(e17, T5, I5),
    findall(D, ( member(I, I5), e17_diags(I, D0), member(D, D0) ), D17),
    (   D17 \== []
    ->  say("ok    E17 flags classical negation (-p(b)).", []), F5 = []
    ;   say("FAIL  E17 does not flag -p(b).", []), F5 = [e17]
    ),
    append([F1, F2, F3, F4, F5], Fails).

% ---------------------------------------------------------------------
% help
% ---------------------------------------------------------------------

cmd_help([], 0) :- !,
    help_lines(general, Ls), print_lines(user_output, Ls).
cmd_help([C|_], Code) :-
    (   help_lines(C, Ls)
    ->  print_lines(user_output, Ls), Code = 0
    ;   help_topic_file(C, File)
    ->  read_file_to_string(File, S, [encoding(utf8)]),
        format("~s", [S]), Code = 0
    ;   usage_error("There is no help for ~w. It is not a command or a topic. Topics: ~w.", [C, 'core, build, discovery, project, codes, answers'])
    ).

% A topic is the file help/TOPIC.txt in the library directory.
help_topic_file(Topic, File) :-
    memberchk(Topic, [core, build, discovery, project, codes, answers]),
    lib_dir(Lib),
    atomic_list_concat([Lib, '/help/', Topic, '.txt'], File),
    exists_file(File).

help_lines(general, [
"orbit-kb: write, check, and query Prolog knowledge bases (KBs) with default negation (not p).",
"",
"How to use (read this first; the topics hold the details):",
"  1. orbit-kb init DIR --request 'the human's words' --uses MODULE",
"     MODULE: discovery when the problem is not yet clear (a report, a \"why?\" question,",
"     or you no longer agree with the human on the problem); build when only the change is open",
"  2. orbit-kb add 'claim(...)' 'cites(...)' 'check(k1, c1)'          write facts; never edit kb.pl",
"  3. orbit-kb run k1 -- CMD       run each check; it must fail first for retire and introduce",
"  4. build the change, then orbit-kb run again",
"  5. orbit-kb lint                the fix for each finding is in its message",
"  6. orbit-kb show open           what is left; run it first when you resume a KB",
"  7. orbit-kb report              draft the delivery",
"  Topics:",
"    orbit-kb help core      facts, claim labels, attestation types, and core queries",
"    orbit-kb help build     build-module facts and queries, burns, flares, proofs, waivers",
"    orbit-kb help discovery discovery-module facts, verdicts, queries, and the recipe for each move",
"    orbit-kb help project   project-module facts: decisions, pins, drafts, conflicts, and the writer lock",
"    orbit-kb help codes     each lint code and what to do",
"    orbit-kb help answers   exit codes, SWI ERROR, why and whynot",
"  Never type a digest or a test result: orbit-kb subject and orbit-kb run write them.",
"",
"Phases (each orbit has two phases; each move belongs to one phase):",
"  discovery: research, specify",
"  build: build, verify",
"  research  SIGNAL, SURVEY, FLYBY, TRAJECTORY, DISPROVE (discovery)",
"  specify   SPECTRUM, DECOMPOSE, the vote (GATE)",
"  build     BUILD",
"  verify    FULFILL, DISPROVE, BURN",
"  What blocks done: orbit-kb show blocking. Pin the KB to its ticket: orbit-kb pin.",
"",
"Usage: orbit-kb [--dir DIR] COMMAND [ARGS]",
"",
"Commands:",
