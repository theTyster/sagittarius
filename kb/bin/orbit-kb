% answer_items(+Items, +Decls, -Items2) (D10 follow-up, F8): the items that
% the engines read. A clause that lint rejects and that could close a
% burn does not reach them: a rules.pl clause whose head is a fact
% predicate (E7) or a protected library predicate (E16), and a kb.pl
% fact of a protected library predicate (E7).
answer_items(Items, Ds, Items2) :-
    exclude(ignored_item(Ds), Items, Items2).

ignored_item(Ds, it(Src, _, _, T, _, _)) :-
    ( Src == rules ; Src == kb ),
    nonvar(T), \+ meta_term(T), T \= #(_), T \= (:- _),
    clause_parts(T, H0, _), nonvar(H0),
    ( H0 = -(H), callable(H) -> true ; H = H0 ),
    callable(H),
    functor(H, N, A),
    decl_of(Ds, N, A, d(_, _, Kind, _, _, _, DSrc, _, _)),
    (   protected_pi(N/A), ( DSrc == core ; DSrc = module(_) )
    ->  true
    ;   Src == rules, Kind == fact
    ).

body_goal_diag(_, F, L, HN, G, diag('E2', F, L, M)) :-
    var(G), !,
    fmt(M, "The body of ~w has a variable as a goal. Write a predicate call.", [HN]).
body_goal_diag(_, _, _, _, G, _) :- builtin_goal(G), !, fail.
body_goal_diag(_, _, _, _, G, _) :- hash_constraint(G), !, fail.   % E17
body_goal_diag(_, F, L, HN, G, diag('E2', F, L, M)) :-
    \+ callable(G), !,
    term_text(G, GT),
    fmt(M, "The body of ~w has ~w as a goal. It is not a predicate.", [HN, GT]).
body_goal_diag(Ds, F, L, HN, G, diag('E2', F, L, M)) :-
    functor(G, N, A),
    \+ memberchk(N/A, [decl/4, attest_type/4]),
    \+ decl_of(Ds, N, A, _),
    undeclared_msg(Ds, N, A, M0),
    fmt(M, "The body of ~w calls ~w Declare it, or fix the name.", [HN, M0]).

% The literals of a body, with the not literals still wrapped.
body_lits(G, [G]) :- var(G), !.
body_lits((A, B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits((A ; B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits((A -> B), L) :- !, body_lits(A, LA), body_lits(B, LB), append(LA, LB, L).
body_lits(G, [G]).

var_in(Vs, V) :- member(X, Vs), X == V, !.

% E14 (D7): unsafe negation. A not literal holds a variable that occurs
% in the head but in no positive body literal. Nothing binds that
% variable before the negation runs, so a call with that argument unbound
% gets the wrong answer (floundering).
e14_problem(T, p(G, Bad)) :-
    clause_parts(T, H, B),
    H \== none,
    body_lits(B, Lits),
    include(binding_lit, Lits, Pos),
    term_variables(Pos, PV),
    term_variables(H, HV),
    member(Lit, Lits), nonvar(Lit), Lit = not(G),
    term_variables(G, GV),
    include(unbound_head_var(HV, PV), GV, Bad),
    Bad \== [].

unbound_head_var(HV, PV, V) :- var_in(HV, V), \+ var_in(PV, V).

% A positive literal that can bind a variable. Tests such as X \= Y and
% X < Y do not bind.
binding_lit(L) :- var(L), !, fail.
binding_lit(not(_)) :- !, fail.
binding_lit(\+(_)) :- !, fail.
binding_lit(L) :-
    callable(L), functor(L, N, A),
    \+ memberchk(N/A, ['\\='/2, '<'/2, '>'/2, '=<'/2, '>='/2, true/0, false/0,
                       '=='/2, '\\=='/2, '@<'/2, '@>'/2, '@=<'/2, '@>='/2]).

e14_diags(T, VN, F, L, Diags) :-
    clause_parts(T, H, _),
    head_name(H, HN),
    findall(diag('E14', F, L, M),
            ( e14_problem(T, p(G, Bad)), e14_msg(VN, HN, G, Bad, M) ),
            Diags).

e14_msg(VN, HN, G, Bad, M) :-
    copy_term(VN-t(G, Bad), VN2-t(G2, Bad2)),
    maplist(bind_vn, VN2),
    term_variables(t(G2, Bad2), Rest),
    maplist(=('$VAR'('_')), Rest),
    wtext(not(G2), NotT),
    maplist(wtext, Bad2, BadTs), atomic_list_concat(BadTs, ', ', BadT),
    fmt(M, "In ~w, the literal `~w` uses ~w. It occurs in the head, but no positive literal in the body binds it (unsafe negation). A call with ~w unbound then gives a wrong answer. Fix: before the not literal, add a positive literal that gives ~w its values, for example a fact or a rule that lists them.",
        [HN, NotT, BadT, BadT, BadT]).

% E17: a form that only s(CASP) reads. orbit-kb runs SWI-Prolog only, so
% the engine skips such a clause (load_item/4), and query, why, whynot,
% show, and report give no answer while one is in a source (answer_gate/1).
e17_diags(it(_, F, L, T, _, _), Diags) :- !,
    (   nonvar(T), e17_form(T, M)
    ->  Diags = [diag('E17', F, L, M)]
    ;   Diags = []
    ).
e17_diags(_, []).

e17_form(T, _) :- var(T), !, fail.
e17_form(#(_), "A # line is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Remove the line. A predicate gets its text from the template of its declaration.") :- !.
e17_form((:- _), "A global constraint (:- Body) is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Write a rule whose head names the problem, such as bad(X) :- Body, and query it.") :- !.
e17_form(T, M) :-
    clause_parts(T, H, B),
    (   nonvar(H), H = -(P), callable(P)
    ->  neg_msg(P, M)
    ;   body_lits_deep(B, Ls), member(X, Ls), nonvar(X),
        (   X = -(P), callable(P), \+ number(P)
        ->  neg_msg(P, M)
        ;   callable(X), functor(X, Op, 2),
            memberchk(Op, ['#=', '#<>', '#<', '#>', '#=<', '#>='])
        ->  fmt(M, "The constraint ~w is s(CASP) syntax. orbit-kb runs SWI-Prolog only. Use is/2 and the comparisons =, <, >, =<, >=.", [Op])
        )
    ),
    !.

hash_constraint(G) :-
    callable(G), functor(G, Op, 2),
    memberchk(Op, ['#=', '#<>', '#<', '#>', '#=<', '#>=']).

neg_msg(P, M) :-
    term_text(P, PT),
    fmt(M, "-~w is classical negation, which orbit-kb no longer reads. orbit-kb runs SWI-Prolog only, and a fact that is not recorded is false: not ~w. To record that something is not the case, write it as a positive fact, such as world(door_closed), or as a note.", [PT, PT]).

% E18 (D20): the program must be stratified: no predicate depends on
% itself through a not literal. For such a program, negation as failure
% gives one answer, and the SWI engine computes it. For p :- not q and
% q :- not p, it does not. The core and the modules are stratified, so a
% cycle always goes through a clause of rules.pl. One error for each
% clause that holds a not literal on a cycle.
e18_diags(Items0, Ds, Diags) :-
    answer_items(Items0, Ds, Items),
    findall(e(H, B, S, F, L, Src),
            ( member(it(Src, F, L, T, _, _), Items), nonvar(T),
              \+ meta_term(T), \+ e17_form(T, _),
              T = (Hd :- Body), callable(Hd), functor(Hd, HN, HA), H = HN/HA,
              dep_lits(Body, pos, Deps), member(S-Lit, Deps),
              callable(Lit), \+ builtin_goal(Lit),
              functor(Lit, BN, BA), B = BN/BA ),
            Es),
    findall(X-Y, member(e(X, Y, _, _, _, _), Es), Edges0),
    sort(Edges0, Edges),
    findall(V, ( member(X-Y, Edges), ( V = X ; V = Y ) ), Vs0), sort(Vs0, Vs),
    vertices_edges_to_ugraph(Vs, Edges, G),
    transitive_closure(G, C),
    findall(H-B-F-L,
            ( member(e(H, B, neg, F, L, _), Es),
              ( H == B -> true ; member(B-Rs, C), memberchk(H, Rs) ) ),
            Cycles),
    findall(diag('E18', F, L, M),
            ( member(H-B-F-L, Cycles),
              fmt(M, "~q depends on itself through not ~q (the rules are not stratified). Negation as failure has no single answer for such a program. Fix: break the cycle, for example with a fact that records the case.", [H, B]) ),
            Diags0),
    % A cycle through a not in the library is closed by a clause of
    % rules.pl. Name that clause too: it is the one the user can change.
    findall(diag('E18', F, L, M),
            ( member(H-B-_-_, Cycles),
              member(e(X, Y, pos, F, L, rules), Es),
              on_cycle(X, H, B, C), on_cycle(Y, H, B, C),
              fmt(M, "This clause of ~q closes a cycle through not ~q in ~q (the rules are not stratified). Fix: remove or change this clause.", [X, B, H]) ),
            Diags1),
    append(Diags0, Diags1, Diags2),
    list_to_set(Diags2, Diags).

% on_cycle(X, H, B, C): X lies on a cycle that runs H -> not B -> ... -> H.
on_cycle(X, H, B, C) :-
    ( X == B -> true ; member(B-RB, C), memberchk(X, RB) ),
    ( X == H -> true ; member(X-RX, C), memberchk(H, RX) ).

% dep_lits(+Body, +Sign, -SignLits): each literal of a body with pos or
% neg. A literal under not, or in the condition of forall, is neg.
dep_lits(V, _, []) :- var(V), !.
dep_lits((A, B), S, L) :- !, dep_lits(A, S, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits((A ; B), S, L) :- !, dep_lits(A, S, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits((A -> B), S, L) :- !, dep_lits(A, neg, LA), dep_lits(B, S, LB), append(LA, LB, L).
dep_lits(not(G), _, L) :- !, dep_lits(G, neg, L).
dep_lits(\+(G), _, L) :- !, dep_lits(G, neg, L).
dep_lits(forall(A, B), _, L) :- !, dep_lits(A, neg, LA), dep_lits(B, neg, LB), append(LA, LB, L).
dep_lits(G, S, [S-G]).

% The literals of a body, also inside not, forall, and the parts of ;
% and ->.
body_lits_deep(G, [G]) :- var(G), !.
body_lits_deep((A, B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep((A ; B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep((A -> B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep(not(G), L) :- !, body_lits_deep(G, L).
body_lits_deep(\+(G), L) :- !, body_lits_deep(G, L).
body_lits_deep(forall(A, B), L) :- !, body_lits_deep(A, LA), body_lits_deep(B, LB), append(LA, LB, L).
body_lits_deep(G, [G]).

% ---------------------------------------------------------------------
% SWI engine
% ---------------------------------------------------------------------
% SWI-Prolog is the only engine. Every program is stratified: the core
% and the modules are, and lint keeps rules.pl inside the same fragment
% (E14 unsafe negation, E17 forms of s(CASP), E18 stratification). So negation as
% failure gives the one answer of the program.
%
% eng(Module, LoadErrs)
%   LoadErrs: list of le(File, Line, Message)

build_engine(Items0, Ds, eng(M, LoadErrs)) :-
    answer_items(Items0, Ds, Items),
    gensym(orbit_eng_, M),
    set_module(M:base(system)),
    forall(member(d(N, A, _, _, _, _, _, _, _), Ds), make_dyn(M, N, A)),
    make_dyn(M, decl, 4),
    make_dyn(M, attest_type, 4),
    foldl(load_item(M), Items, [], LE0),
    reverse(LE0, LoadErrs).

make_dyn(M, N, A) :-
    catch(dynamic(M:N/A), _, true).

load_item(_, synerr(_, _, _, _), LE, LE) :- !.
load_item(_, it(kb, _, _, T, _, _), LE, LE) :- nonvar(T), T = uses(_), !.
load_item(_, it(_, F, L, T, _, _), LE, [le(F, L, "The clause is a variable.")|LE]) :-
    var(T), !.
load_item(_, it(_, _, _, T, _, _), LE, LE) :- e17_form(T, _), !.   % lint E17 or E7
load_item(M, it(_, F, L, T, _, _), LE, LE1) :-
    swi_clause(T, T2),
    catch(assertz(M:T2), E, true),
    (   var(E)
    ->  LE1 = LE
    ;   err_text(E, ET), LE1 = [le(F, L, ET)|LE]
    ).

swi_clause((H :- B), (H :- B2)) :- !, swi_body(B, B2).
swi_clause(H, H).

% swi_body(+Body, -SwiBody) (D7): in each conjunction, the not literals
% move after all of the other literals. The other literals (builtins
% too) keep their order. In a stratified program this does not change
% the answers, and \+ then never runs on a variable that a positive
% literal binds later (floundering).
swi_body(V, call(V)) :- var(V), !.
swi_body((A, B), Body) :- !,
    conj_list((A, B), Ls),
    partition(neg_body_lit, Ls, Negs, Poss),
    append(Poss, Negs, Ordered),
    maplist(swi_lit, Ordered, Ls2),
    list_conj(Ls2, Body).
swi_body(G, G2) :- swi_lit(G, G2).

swi_lit(V, call(V)) :- var(V), !.
swi_lit((A, B), B2) :- !, swi_body((A, B), B2).
swi_lit((A ; B), (A2 ; B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit((A -> B), (A2 -> B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit(not(G), \+ G2) :- !, swi_body(G, G2).
swi_lit(\+(G), \+ G2) :- !, swi_body(G, G2).
swi_lit(forall(A, B), forall(A2, B2)) :- !, swi_body(A, A2), swi_body(B, B2).
swi_lit(G, G).

neg_body_lit(G) :- nonvar(G), ( G = not(_) ; G = \+(_) ), !.

conj_list(G, [G]) :- var(G), !.
conj_list((A, B), L) :- !, conj_list(A, LA), conj_list(B, LB), append(LA, LB, L).
conj_list(G, [G]).

list_conj([G], G) :- !.
list_conj([G|Gs], (G, C)) :- list_conj(Gs, C).

swi_time_limit(10).
swi_answer_cap(1000).

% swi_query(+Eng, +Goal, +Template, -Result)
% Result: answers(List, Capped) | error(Message)
swi_query(Eng, G, Tpl, Res) :-
    Eng = eng(_, LoadErrs),
    (   LoadErrs = [le(F, L, Msg)|_]
    ->  show_loc(F, L, LT),
        fmt(Res0, "the SWI engine could not load the clause at ~w: ~w Run orbit-kb lint.", [LT, Msg]),
        Res = error(Res0)
    ;   swi_raw(Eng, G, Tpl, Res)
    ).

swi_raw(eng(M, _), G, Tpl, Res) :-
    swi_body(G, G2),
    swi_time_limit(TL),
    swi_answer_cap(Cap),
    catch(call_with_time_limit(TL, once(findnsols(Cap, Tpl, M:G2, L0))), E, true),
    (   var(E)
    ->  list_to_set(L0, L),
        length(L0, Len),
        ( Len >= Cap -> Capped = true ; Capped = false ),
        Res = answers(L, Capped)
    ;   E == time_limit_exceeded
    ->  fmt(Msg, "the SWI engine did not finish in ~w s. The program may loop, or it may not be stratified.", [TL]),
        Res = error(Msg)
    ;   err_text(E, Msg),
        Res = error(Msg)
    ).

% For listings (show, report): answers or exit 2.
eng_all(Eng, Tpl, G, L) :-
    swi_raw(Eng, G, Tpl, R),
    (   R = answers(L0, _)
    ->  ( Tpl = [_] -> maplist([[X], X]>>true, L0, L) ; L = L0 )
    ;   R = error(Msg)
    ->  die(2, ["SWI ERROR: " + Msg] >> fix_lines)
    ).

swi_fail_if_error(error(Msg)) :- !,
    die(2, ["SWI ERROR: " + Msg, "The SWI engine could not evaluate the goal. This is not a false answer."] >> fix_lines).
swi_fail_if_error(_).

item_head_pi(it(_, _, _, T, _, _), PI) :-
    nonvar(T),
    \+ ( T = (:- _) ), \+ ( T = #(_) ),
    clause_parts(T, H, _),
    callable(H), functor(H, N, A), PI = N/A.

% Write a file atomically: a temp file in the same directory, then
% rename. A reader sees the old file or the whole new file.
write_atomic(F, Text) :-
    file_directory_name(F, D),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w/.tmp-~w-~w", [D, Pid, R]),
    catch(( setup_call_cleanup(open(Tmp, write, S, [encoding(utf8)]),
                               write(S, Text),
                               close(S)),
            rename_file(Tmp, F) ),
          E,
          ( catch(delete_file(Tmp), _, true), throw(E) )).

% ---------------------------------------------------------------------
% Goals
% ---------------------------------------------------------------------

query_names(VN, Names, Vars) :-
    exclude([N=_]>>sub_atom(N, 0, 1, _, '_'), VN, VN1),
    findall(N, member(N=_, VN1), Names),
    maplist([_=V, V]>>true, VN1, Vars).

answer_line([], _, "true") :- !.
answer_line(Names, Tuple, Line) :-
    findall(S, ( nth1(I, Names, N), nth1(I, Tuple, V),
                 term_text(V, VT), fmt(S, "~w = ~w", [N, VT]) ),
            Ss),
    atomic_list_concat(Ss, ', ', A),
    atom_string(A, Line).

take_n(0, L, L) :- !.
take_n(N, L, T) :- length(L, Len), ( Len =< N -> T = L ; length(T, N), append(T, _, L) ).

% answer_gate(+KB) (D7, D20): query, why, whynot, show, and report do
% not answer from a broken source. A syntax error (E1) in any source
% drops the clause, an undeclared head or body predicate (E2) in
% rules.pl is hidden by a stub, the engine skips a form of s(CASP)
% (E17), and negation as failure has no single answer for a program that
% is not stratified (E18). Each would give a quiet wrong answer. Exit 2
% instead.
answer_gate(KB) :-
    kb_items(KB, Items),
    findall(D, ( member(synerr(_, F, L, M), Items), D = diag('E1', F, L, M) ), E1s),
    (   E1s == []
    ->  items_decls(Items, Ds),
        findall(D, ( member(I, Items), I = it(rules, _, _, _, _, _),
                     rule_item_diags(Ds, I, D0),
                     member(D, D0), D = diag('E2', _, _, _) ),
                E2s),
        e19_rule_diags(Ds, E19s),
        findall(D, ( member(I, Items), e17_diags(I, D0), member(D, D0) ), E17s),
        e18_diags(Items, Ds, E18s)
    ;   E2s = [], E19s = [], E17s = [], E18s = []
    ),
    append([E1s, E2s, E19s, E17s, E18s], Bad),
    (   Bad == []
    ->  true
    ;   findall(S, ( member(diag(C, F, L, M), Bad), show_loc(F, L, LT),
                     fmt(S, "~w ~w: ~w", [C, LT, M]) ),
                Ls),
        (   E1s \== []
        ->  Why = "A source file has a syntax error. orbit-kb drops a clause that does not parse, so an answer could be wrong."
        ;   E2s \== []
        ->  Why = "rules.pl names a predicate that is not declared. Its clauses cannot take part, so an answer could be wrong."
        ;   E19s \== []
        ->  Why = "A head of rules.pl looks like a typo of a declared predicate. Its clauses may not reach the rule you mean, so an answer could be wrong."
        ;   E17s \== []
        ->  Why = "A source uses a form that orbit-kb does not read. The engine skips that clause, so an answer could be wrong."
        ;   Why = "The rules are not stratified, so negation as failure has no single answer."
        ),
        append([Ls, [Why,
                     "Fix: correct each line above, then run orbit-kb lint.",
                     "orbit-kb gives no answer until then. This is not a false answer."]],
               All),
        die(2, All)
    ).

check_goal(G, Ds) :-
    (   e17_form((goal :- G), M)
    ->  die(2, ["The goal uses a form that orbit-kb does not read. " + M] >> fix_lines)
    ;   true
    ),
    body_goals(G, Gs),
    forall(member(X, Gs), goal_ok(X, Ds)).

goal_ok(X, _) :- var(X), !,
    die(2, ["The goal has a variable where a predicate call must be. Write a predicate call."]).
goal_ok(X, _) :- builtin_goal(X), !.
goal_ok(X, _) :- \+ callable(X), !,
    term_text(X, XT),
    die(2, ["The goal holds " + XT + ", which is not a predicate call."] >> fix_lines).
goal_ok(X, _) :- functor(X, N, A), memberchk(N/A, [decl/4, attest_type/4]), !.
goal_ok(X, Ds) :-
    functor(X, N, A),
    (   decl_of(Ds, N, A, _)
    ->  true
    ;   N == (\+), A =:= 1
    ->  die(2, ["The goal uses \\+. Use not instead, such as not under(c1)."])
    ;   undeclared_msg(Ds, N, A, M),
        die(2, [ "Unknown predicate in the goal. " + M,
                 "Check the spelling. To add a fact kind, use orbit-kb add 'FACT' --doc TEXT.",
                 "This is a usage error, not a false answer." ] >> fix_lines)
    ).

parse_goal(Text, G, VN) :-
    parse_one(Text, R),
    (   R = ok(G, VN)
    ->  true
    ;   R = err(M),
        die(2, [ "The goal does not parse. " + M,
                 "Check the brackets and quotes. Write text in single quotes.",
                 "This is a usage error, not a false answer." ] >> fix_lines)
    ).
% ---------------------------------------------------------------------
% query and why
% ---------------------------------------------------------------------

cmd_query(KB, Args, ForceWhy, Code) :-
    parse_opts(Args, ['-n'-value, '--why'-flag, '--long'-flag, '--short'-flag], Pos, Opts),
    (   Pos = [GoalText]
    ->  true
    ;   usage_error("Give exactly one goal in quotes, such as orbit-kb query 'claim(C, L, T)'.", [])
    ),
    opt(Opts, '-n', '1', NA),
    (   atom_number(NA, N), integer(N), N >= 0
    ->  true
    ;   usage_error("The option -n needs a whole number of 0 or more. 0 means all answers.", [])
    ),
    opt(Opts, '--why', false, Why0),
    ( ForceWhy == true -> Why = true ; Why = Why0 ),
    opt(Opts, '--long', false, Long),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    parse_goal(GoalText, G, VN),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    check_goal(G, Ds),
    answer_gate(KB),
    build_engine(Items, Ds, Eng),
    query_names(VN, Names, Vars),
    swi_query(Eng, G, Vars, Res),
    swi_fail_if_error(Res),
    Res = answers(L, _),
    take_n(N, L, Shown),
    (   Shown == []
    ->  format("false~n", []), Code = 1
    ;   Code = 0,
        forall(member(Tp, Shown),
               ( answer_line(Names, Tp, AL), format("~w~n", [AL]),
                 (   Why == true
                 ->  copy_term(G-Vars, G1-Tp),
                     explain_lines(Eng, Ds, holds, G1, Long, Lines),
                     format("~n", []), print_lines(user_output, Lines)
                 ;   true
                 ) ))
    ).

% ---------------------------------------------------------------------
% whynot
% ---------------------------------------------------------------------

cmd_whynot(KB, Args, Code) :-
    parse_opts(Args, ['--long'-flag, '--short'-flag], Pos, Opts),
    (   Pos = [GoalText] -> true
    ;   usage_error("Give exactly one goal in quotes, such as orbit-kb whynot 'fulfilled(c1)'.", [])
    ),
    opt(Opts, '--long', false, Long),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    parse_goal(GoalText, G, _),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    check_goal(G, Ds),
    answer_gate(KB),
    build_engine(Items, Ds, Eng),
    swi_query(Eng, G, [G], Res),
    swi_fail_if_error(Res),
    Res = answers(L, _),
    (   L = [[G1]|_]
    ->  format("holds~n", []),
        explain_lines(Eng, Ds, holds, G1, Long, Lines)
    ;   format("absent~n", []),
        explain_lines(Eng, Ds, fails, G, Long, Lines)
    ),
    format("~n", []),
    print_lines(user_output, Lines),
    Code = 0.

% ---------------------------------------------------------------------
% Explanations (why, whynot)
% ---------------------------------------------------------------------
% The SWI engine gives every verdict. An explanation reads the same
% clauses again, after the verdict:
%   - a goal that holds: one clause that proves it, and why each of its
%     body literals holds;
%   - a goal that fails: for each rule of the goal, the first body
%     literal that no answer of the literals before it gets past.
% Every program is stratified (lint E18, answer_gate/1), so these trees are
% finite. A depth limit keeps them short: 6 levels, or 30 with --long.
% An explanation never changes a verdict.

expl_depth(Long, D) :- ( Long == true -> D = 30 ; D = 6 ).
expl_time_limit(10).

% explain_lines(+Eng, +Ds, +Mode, +Goal, +Long, -Lines)
% Mode is holds (Goal has an answer; Goal is bound to it) or fails.
explain_lines(eng(M, _), Ds, Mode, G, Long, Lines) :-
    expl_depth(Long, D),
    swi_body(G, G2),
    expl_time_limit(TL),
    catch(call_with_time_limit(TL,
              ( Mode == holds -> ex_true(M, G2, D, T) ; ex_false(M, G2, D, T) )),
          E, true),
    (   var(E), nonvar(T)
    ->  phrase(ex_lines(T, Ds, 0), Lines)
    ;   E == time_limit_exceeded
    ->  fmt(L, "No explanation: it took more than ~w s. The verdict above stands.", [TL]),
        Lines = [L]
    ;   Lines = ["No explanation is available. The verdict above stands."]
    ).

% Trees:
%   fact(G)             G is a fact
%   rule(G, Kids)       G holds by a rule; Kids explain its body
%   builtin(G)          a builtin goal that holds
%   naf(P, Sub)         not P holds; Sub = none, or the tree of P failing
%   more(G)             G holds; the depth limit stops here
%   fails(G, Why)       G has no answer. Why = nothing | builtin | depth
%                       | rules(Stops), Stops = list of stop(Lit, Sub)
%   holds_neg(P, Sub)   (inside a stop) not P fails because P holds

user_pred(M, G) :-
    callable(G),
    \+ builtin_goal(G),
    functor(G, N, A),
    functor(H, N, A),
    predicate_property(M:H, dynamic).

ex_true(M, G, D, T) :-
    (   G = (_, _)
    ->  conj_list(G, Ls),
        maplist([L, K]>>once(ex_true(M, L, D, K)), Ls, Kids),
        T = all(Kids)
    ;   G = (\+ P)
    ->  ( D > 0 -> ex_false(M, P, D, Sub) ; Sub = none ),
        T = naf(P, Sub)
    ;   \+ user_pred(M, G)
    ->  once(call(M:G)), T = builtin(G)
    ;   D =< 0
    ->  once(call(M:G)), T = more(G)
    ;   once(( clause(M:G, B), call(M:B) )),
        (   B == true
        ->  T = fact(G)
        ;   D1 is D - 1,
            conj_list(B, Ls),
            maplist([L, K]>>once(ex_true(M, L, D1, K)), Ls, Kids),
            T = rule(G, Kids)
        )
    ).

ex_false(M, G, D, T) :-
    (   G = (\+ P)
    ->  once(ex_true(M, P, D, PT)), T = neg_fails(P, PT)
    ;   G = (_, _)
    ->  rule_stop(M, '$goal', G, D, S), T = fails('$goal', rules([S]))
    ;   ex_false_lit(M, G, D, T)
    ).

ex_false_lit(M, G, D, fails(G, Why)) :-
    (   \+ user_pred(M, G)
    ->  Why = builtin
    ;   D =< 0
    ->  Why = depth
    ;   findall(G-B, ( clause(M:G, B), B \== true ), Rules),
        (   Rules == []
        ->  Why = nothing
        ;   D1 is D - 1,
            findall(S, ( member(G1-B1, Rules), rule_stop(M, G1, B1, D1, S) ), Stops),
            Why = rules(Stops)
        )
    ).

% rule_stop(+M, +Head, +Body, +D, -Stop): the first body literal that no
% answer of the literals before it gets past. The literal is shown with
% the bindings of the literals before it when they have one answer.
rule_stop(M, H, B, D, stop(H, Lit, Sub)) :-
    conj_list(B, Ls),
    stop_at(M, Ls, [], Lit0, Before),
    findall(Lit0, call(M:Before), Ans0),
    sort(Ans0, Ans),
    (   Ans = [Lit]
    ->  (   Lit = (\+ P)
        ->  once(ex_true(M, P, D, PT)), Sub = holds_neg(P, PT)
        ;   ex_false(M, Lit, D, Sub)
        )
    ;   Ans == []
    ->  Lit = Lit0, Sub = first
    ;   Lit = Lit0, Sub = each
    ).

stop_at(M, [L|Ls], Acc, Lit, Before) :-
    append(Acc, [L], Acc1),
    list_conj_true(Acc1, C),
    (   \+ \+ call(M:C)
    ->  stop_at(M, Ls, Acc1, Lit, Before)
    ;   Lit = L,
        list_conj_true(Acc, Before)
    ).

list_conj_true([], true) :- !.
list_conj_true(Ls, C) :- list_conj(Ls, C).

% --- Text. Each line is indented by three spaces per level.

ex_lines(fact(G), Ds, I) --> ex_line(I, "~w", [tpl(G, Ds)]).
ex_lines(builtin(G), _, I) --> ex_line(I, "~w holds", [lit(G)]).
ex_lines(more(G), Ds, I) --> ex_line(I, "~w (--long shows more)", [tpl(G, Ds)]).
ex_lines(rule(G, Kids), Ds, I) -->
    ex_line(I, "~w, because", [tpl(G, Ds)]),
    { I1 is I + 1 },
    ex_kids(Kids, Ds, I1).
ex_lines(naf(P, none), Ds, I) --> !,
    ex_line(I, "there is no evidence that ~w", [tpl(P, Ds)]).
ex_lines(naf(_, Sub), Ds, I) --> ex_lines(Sub, Ds, I).
ex_lines(all(Kids), Ds, I) --> ex_kids(Kids, Ds, I).
ex_lines(neg_fails(P, PT), Ds, I) -->
    ex_line(I, "not ~w does not hold, because", [lit(P)]),
    { I1 is I + 1 },
    ex_lines(PT, Ds, I1).
ex_lines(fails('$goal', rules(Stops)), Ds, I) --> !,
    ex_stops(Stops, 1, 1, Ds, I).
ex_lines(fails(G, Why), Ds, I) -->
    (   { Why == nothing }
    ->  ex_line(I, "nothing records ~w: no fact or rule matches it", [lit(G)])
    ;   { Why == builtin }
    ->  ex_line(I, "~w does not hold", [lit(G)])
    ;   { Why == depth }
    ->  ex_line(I, "there is no evidence that ~w (--long shows more)", [tpl(G, Ds)])
    ;   { Why = rules(Stops) },
        ex_line(I, "there is no evidence that ~w, because", [tpl(G, Ds)]),
        { I1 is I + 1, length(Stops, NS) },
        ex_stops(Stops, NS, 1, Ds, I1)
    ).

ex_kids([], _, _) --> [].
ex_kids([K|Ks], Ds, I) --> ex_lines(K, Ds, I), ex_kids(Ks, Ds, I).

ex_stops([], _, _, _, _) --> [].
ex_stops([stop(H, Lit, Sub)|Ss], NS, K, Ds, I) -->
    { functor(H, N, A),
      (   H == '$goal'
      ->  Which = "the goal"
      ;   NS =:= 1
      ->  fmt(Which, "the rule for ~q/~w", [N, A])
      ;   fmt(Which, "rule ~w of ~w for ~q/~w", [K, NS, N, A])
      ) },
    (   { Sub == first }
    ->  ex_line(I, "~w stops at its first literal: ~w", [str(Which), lit(Lit)])
    ;   { Sub == each }
    ->  ex_line(I, "~w stops at ~w, for every answer of the literals before it", [str(Which), lit(Lit)])
    ;   ex_line(I, "~w stops at ~w:", [str(Which), lit(Lit)]),
        { I1 is I + 1 },
        (   { Sub = holds_neg(_, PT) }
        ->  ex_lines(PT, Ds, I1)
        ;   ex_lines(Sub, Ds, I1)
        )
    ),
    { K1 is K + 1 },
    ex_stops(Ss, NS, K1, Ds, I).

ex_line(I, Fmt, Args0) -->
    { maplist(ex_arg, Args0, Args),
      format(string(S0), Fmt, Args),
      Pad is I * 3,
      format(string(S), "~*c~w", [Pad, 0' , S0]) },
    [S].

ex_arg(tpl(G, Ds), S) :- !, goal_template_text(G, Ds, S).
ex_arg(lit(G), S) :- !, lit_text(G, S).
ex_arg(str(S), S).

% A literal as source text: \+ prints as not.
lit_text(G, S) :- show_not(G, G2), term_text(G2, S).

show_not(V, V) :- var(V), !.
show_not(\+ G, not(G2)) :- !, show_not(G, G2).
show_not((A, B), (A2, B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not((A ; B), (A2 ; B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not((A -> B), (A2 -> B2)) :- !, show_not(A, A2), show_not(B, B2).
show_not(G, G).

% The template of a declaration with the arguments put in, or the goal
% as text when it has no template.
goal_template_text(G, Ds, S) :-
    (   callable(G), functor(G, N, A),
        decl_of(Ds, N, A, d(_, _, _, _, _, Tpl, _, _, _)),
        atom(Tpl), Tpl \== ''
    ->  atom_string(Tpl, T0),
        G =.. [_|Args],
        foldl(tpl_put, Args, 1-T0, _-S)
    ;   lit_text(G, S0),
        fmt(S, "~w holds", [S0])
    ).

tpl_put(Arg, I-S0, I1-S) :-
    I1 is I + 1,
    fmt(From, "@(~w)", [I]),
    (   var(Arg) -> AT = "_"
    ;   atomic(Arg) -> format(string(AT), "~w", [Arg])
    ;   term_text(Arg, AT)
    ),
    atomic_list_concat(Parts, From, S0),
    atomic_list_concat(Parts, AT, A),
    atom_string(A, S).

% ---------------------------------------------------------------------
% init
% ---------------------------------------------------------------------

cmd_init(Args, Code) :-
    parse_opts(Args, ['--request'-value, '--request-file'-value, '--uses'-value, '--id'-value, '--source'-value], Pos, Opts),
    (   Pos = [Dir0] -> true
    ;   usage_error("Give one directory: orbit-kb init DIR --request TEXT.", [])
    ),
    opt(Opts, '--request', none, RT),
    opt(Opts, '--request-file', none, RF),
    (   RT \== none, RF == none
    ->  Text = RT
    ;   RF \== none, RT == none, memberchk('--source'-_, Opts)
    ->  (   exists_file(RF) -> request_text(RF, Text)
        ;   die(1, ["The request file " + RF + " does not exist. Check the path."] >> fix_lines)
        )
    ;   RF \== none, RT == none
    ->  (   exists_file(RF)
        ->  read_file_to_string(RF, S0, [encoding(utf8)]),
            ( sub_string(S0, B, 1, 0, "\n") -> sub_string(S0, 0, B, _, S1) ; S1 = S0 ),
            atom_string(Text, S1)
        ;   die(1, ["The request file " + RF + " does not exist. Check the path."] >> fix_lines)
        )
    ;   usage_error("Give the request with --request TEXT or with --request-file F. Give one of them, not both.", [])
    ),
    opt(Opts, '--id', r1, Id),
    opt(Opts, '--uses', '', UsesA),
    split_string(UsesA, ",", " ", US0),
    exclude(==(""), US0, US),
    maplist(atom_string, Uses, US),
    lib_dir(Lib),
    lib_modules(Lib, Known),
    (   member(M, Uses), \+ memberchk(M, Known)
    ->  atomic_list_concat(Known, ', ', KT),
        die(1, ["The module " + M + " does not exist.", "Known modules: " + KT + ".", "Fix: use a known module name in --uses."] >> fix_lines)
    ;   true
    ),
    Req = request(Id, Text),
    absolute_file_name(Dir0, Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    (   exists_file(KbFile)
    ->  die(1, [KbFile + " already exists. orbit-kb init does not overwrite a KB.", "Fix: choose a new directory, or use the KB that exists."] >> fix_lines)
    ;   true
    ),
    make_directory_path(Dir),
    clause_line(uses(Uses), [], L1),
    clause_line(Req, [], L2),
    % The version of the tool that made the KB (D34): a comment, so no rule reads it.
    tool_version_text(TV),
    format(atom(LV), "% Made by orbit-kb ~w.", [TV]),
    (   memberchk('--source'-Src, Opts)
    ->  (   Src == '' -> usage_error("--source needs the ref of the tracker item, such as gh:acme/widgets#3.", []) ; true ),
        sha256_text(Text, RD), utc_now(Now),
        clause_line(request_pin(Id, Src, RD, Now), [], L3), Ls = [L1, L2, L3, LV]
    ;   Ls = [L1, L2, LV]
    ),
    setup_call_cleanup(open(KbFile, write, S, [encoding(utf8)]),
                       forall(member(L, Ls), format(S, "~w~n", [L])),
                       close(S)),
    format("~w~n", [KbFile]),
    format(user_error, "Next: add the claims and the checks. Vocabulary: orbit-kb help core.~n", []),
    Code = 0.

% ---------------------------------------------------------------------
% withdraw: remove a kind that a typo declared (D39, 0.3.0 K-J c_k_j_3)
% ---------------------------------------------------------------------
% orbit-kb withdraw NAME/ARITY [--by human|agent] removes from kb.pl the decl/4 line of a kind
% that kb.pl declares (a first use, D22), its first_use/3 fact and every fact of the kind. Each
% removed line stays in kb.pl as a comment "% withdrawn: LINE", and the record
% withdrawn(NAME/ARITY, By, Time, N) (N facts) is appended. A kind that the library declares
% is never withdrawn. The fix for E19 needs no edit of kb.pl by hand.

cmd_withdraw(KB, Args, Code) :-
    parse_opts(Args, ['--by'-value], Pos, Opts),
    (   Pos = [PIA], atomic_list_concat([NA, AA], '/', PIA), NA \== '',
        catch(atom_number(AA, Ar), _, fail), integer(Ar), Ar >= 0
    ->  N = NA
    ;   usage_error("Give one kind as NAME/ARITY: orbit-kb withdraw cited/2.", [])
    ),
    opt(Opts, '--by', agent, By),
    ( memberchk(By, [human, agent]) -> true ; usage_error("--by takes human or agent. It is ~w.", [By]) ),
    KB = kb(_, _, _, Items),
    kb_file(KB, KbFile),
    findall(L-T, ( member(it(kb, _, L, T, _, _), Items), nonvar(T), T = decl(_, H, _, _), nonvar(H), functor(H, N, Ar) ), Decls),
    (   Decls == []
    ->  (   member(it(Src, _, _, decl(_, H2, _, _), _, _), Items), Src \== kb, nonvar(H2), functor(H2, N, Ar)
        ->  fmt(M1, "~w/~w is a kind of the library (~w), not of this KB. withdraw takes only a kind that kb.pl declares (a first use).", [N, Ar, Src]),
            reject([M1])
        ;   fmt(M1, "kb.pl declares no kind ~w/~w. orbit-kb show kinds lists the kinds; lint E19 names a kind that a typo declared.", [N, Ar]),
            reject([M1])
        )
    ;   true
    ),
    findall(L-T, ( member(it(kb, _, L, T, _, _), Items), nonvar(T),
                   ( T = first_use(N/Ar, _, _) ; pos_fact(T), \+ T = decl(_, _, _, _), functor(T, N, Ar) ) ), Others),
    findall(x, ( member(_-T, Others), \+ T = first_use(_, _, _) ), Fs), length(Fs, NF),
    append(Decls, Others, LTs0), sort(LTs0, LTs),
    kb_lines_commented(KbFile, LTs, Out0),
    utc_now(Now),
    clause_line(withdrawn(N/Ar, By, Now, NF), [], Rec),
    (   sub_string(Out0, _, 1, 0, "\n") -> Sep = "" ; Sep = "\n" ),
    atomic_list_concat([Out0, Sep, Rec, "\n"], Out),
    write_kb_text(KbFile, Out),
    format("~w~n", [Rec]),
    format(user_error, "Withdrew ~w/~w: its declaration and ~w fact(s). They stay in kb.pl as comments. Run orbit-kb lint next.~n", [N, Ar, NF]),
    Code = 0.

% kb_lines_commented(+File, +Line-Term pairs, -Out): the text of File with each of these lines
% turned into the comment "% withdrawn: LINE". Each term must be the whole of its line.
kb_lines_commented(File, LTs, Out) :-
    read_file_to_string(File, Str, [encoding(utf8)]),
    split_string(Str, "\n", "", Lines),
    forall(member(L-T, LTs),
           (   nth1(L, Lines, LS),
               catch(term_string(T2, LS, [module(orbit_ops)]), _, fail), T2 =@= T
           ->  true
           ;   die(2, ["withdraw: line " + L + " of kb.pl does not hold exactly one term. Nothing was written.",
                       "Fix: keep one fact per line in kb.pl (orbit-kb add writes them so)."] >> fix_lines)
           )),
    pairs_keys(LTs, Ls),
    findall(O, ( nth1(I, Lines, LS), ( memberchk(I, Ls) -> string_concat("% withdrawn: ", LS, O) ; O = LS ) ), Outs),
    atomic_list_concat(Outs, '\n', Out).

% ---------------------------------------------------------------------
% shift: the step from words to records in one command (D37, 0.3.0 K-H)
% ---------------------------------------------------------------------
% orbit-kb shift DIR (--request-file F | --request T) --hypothesis T [--kind K]
%   (--no-premises | --premise T ...) --claim T [--label L] --example T --check ID --checks-that T
%   [--cites T] [--uses M,...] [--red-log FILE]
% D43 (c_k_h_2b): --red-log FILE, the output of a red run of the check that the agent saw
% before the KB existed, becomes a third child: attest disclosure ID 'seen_red(ID, TEXT)'.
% It is a disclosure, not a test result: the claim stays unfulfilled until the tool shows
% the check red or a human waives the check (Ty, q_k_h_2b).
% It runs orbit-kb init, then one orbit-kb add of every fact (all or nothing), as two
% child processes of this script, so each write has the checks of init and add. When the
% add is refused, it removes what it wrote (kb.pl and the other new files of DIR, and DIR
% itself when it made it), and exits with the code of add. The ids are fixed: h1, p1..pN, c1.

cmd_shift(Args, Code) :-
    parse_opts(Args, ['--request'-value, '--request-file'-value, '--hypothesis'-value, '--kind'-value,
                      '--no-premises'-flag, '--premise'-value, '--claim'-value, '--label'-value,
                      '--example'-value, '--check'-value, '--checks-that'-value, '--cites'-value, '--uses'-value,
                      '--red-log'-value], Pos, Opts),
    (   Pos = [Dir0] -> true
    ;   usage_error("Give one directory: orbit-kb shift DIR --request-file F --hypothesis T ... (orbit-kb help shift).", [])
    ),
    forall(( member(O, ['--request', '--request-file', '--hypothesis', '--kind', '--claim', '--label', '--example', '--check', '--checks-that', '--cites', '--uses', '--red-log']),
             aggregate_all(count, member(O-_, Opts), N), N > 1 ),
           usage_error("Give ~w once.", [O])),
    forall(member(O-What, ['--hypothesis'-"the hypothesis", '--claim'-"the claim", '--example'-"its example", '--check'-"the id of its check", '--checks-that'-"the words of its check (E20)"]),
           ( memberchk(O-_, Opts) -> true
           ; usage_error("shift needs ~w: ~w TEXT (orbit-kb help shift).", [What, O]) )),
    findall(P, member('--premise'-P, Opts), Prems),
    (   memberchk('--no-premises'-true, Opts)
    ->  ( Prems == [] -> true ; usage_error("Give --no-premises or --premise TEXT, not both.", []) )
    ;   Prems == []
    ->  usage_error("State the premises: --premise TEXT for each one, or --no-premises (\"Premises: none\").", [])
    ;   true
    ),
    opt(Opts, '--request', none, RT), opt(Opts, '--request-file', none, RF),
    (   RT \== none, RF == none -> ReqOpt = ['--request', RT], Text = RT
    ;   RF \== none, RT == none
    ->  (   exists_file(RF)
        ->  read_file_to_string(RF, S0, [encoding(utf8)]),
            ( sub_string(S0, B, 1, 0, "\n") -> sub_string(S0, 0, B, _, Text) ; Text = S0 ),
            ReqOpt = ['--request-file', RF]
        ;   die(1, ["The request file " + RF + " does not exist. Check the path."] >> fix_lines)
        )
    ;   usage_error("Give the request with --request TEXT or with --request-file F. Give one of them, not both.", [])
    ),
    opt(Opts, '--kind', feature, Kind), opt(Opts, '--label', introduce, Label),
    opt(Opts, '--uses', build, Uses),
    shift_red_log(Opts, Label, RedText),
    memberchk('--hypothesis'-HT, Opts), memberchk('--claim'-CT, Opts),
    memberchk('--example'-ET, Opts), memberchk('--check'-KId, Opts), memberchk('--checks-that'-KW, Opts),
    (   memberchk('--cites'-Cites, Opts) -> true
    ;   split_string(Text, "\n", " \t\r", [L1|_]), atom_string(Cites, L1)
    ),
    findall(F, ( F = hypothesis(h1, Kind, HT)
               ; memberchk('--no-premises'-true, Opts), F = no_premises(h1)
               ; nth1(I, Prems, PT), atom_concat(p, I, PId), F = premise(PId, h1, PT)
               ; F = claim(c1, Label, CT)
               ; F = cites(c1, Cites)
               ; F = example(c1, ET)
               ; F = check(KId, c1)
               ; F = checks_that(KId, KW) ), Facts),
    maplist([T, A]>>format(atom(A), "~q", [T]), Facts, FactArgs),
    absolute_file_name(Dir0, Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    (   exists_file(KbFile)
    ->  die(1, [KbFile + " already exists. orbit-kb shift does not overwrite a KB.", "Fix: choose a new directory, or add the facts to the KB that exists (orbit-kb add)."] >> fix_lines)
    ;   true
    ),
    (   exists_directory(Dir) -> directory_files(Dir, Before), Made = false ; Before = [], Made = true ),
    orbit_script(Script0), real_file(Script0, Script),
    append([init, Dir|ReqOpt], ['--uses', Uses], InitArgs),
    shift_child(Script, InitArgs, IExit, IOut),
    (   IExit \== 0
    ->  shift_undo(Dir, Made, Before),
        format(user_error, "~s", [IOut]), Code = IExit
    ;   shift_child(Script, ['--dir', Dir, add|FactArgs], AExit, AOut),
        (   AExit \== 0
        ->  shift_undo(Dir, Made, Before),
            format(user_error, "~s", [AOut]),
            format(user_error, "orbit-kb shift wrote nothing: the add above was refused.~n", []),
            Code = AExit
        ;   RedText == none
        ->  format("~w~n", [KbFile]),
            forall(member(F, Facts), ( term_text(F, FT), format("~w.~n", [FT]) )),
            format(user_error, "Next: orbit-kb --dir ~w run ~w -- CMD (it must fail before the change), then orbit-kb lint. orbit-kb help shift.~n", [Dir, KId]),
            Code = 0
        ;   format(atom(RedPred), "~q", [seen_red(KId, RedText)]),
            shift_child(Script, ['--dir', Dir, attest, disclosure, KId, RedPred], DExit, DOut),
            (   DExit \== 0
            ->  shift_undo(Dir, Made, Before),
                format(user_error, "~s", [DOut]),
                format(user_error, "orbit-kb shift wrote nothing: the disclosure of the red run was refused.~n", []),
                Code = DExit
            ;   format("~w~n", [KbFile]),
                forall(member(F, Facts), ( term_text(F, FT), format("~w.~n", [FT]) )),
                format("disclosure seen_red(~w, ...): the red run that you saw, with its output.~n", [KId]),
                format(user_error, "Next: orbit-kb --dir ~w run ~w -- CMD, then orbit-kb lint. The red run that you saw is a disclosure, not a test result: claim c1 stays unfulfilled until the tool shows ~w red, or a human waives check ~w (report: not shown red by the tool). orbit-kb help shift.~n", [Dir, KId, KId, KId]),
                Code = 0
            )
        )
    ).

% shift_red_log(+Opts, +Label, -Text) (D43): the text of --red-log FILE, or none. Usage errors
% and a missing or empty file stop shift before it writes anything.
shift_red_log(Opts, Label, Text) :-
    (   memberchk('--red-log'-F, Opts)
    ->  (   Label == preserve
        ->  usage_error("--red-log is for an introduce or a retire claim: the check of a preserve claim must pass, not fail first.", [])
        ;   true
        ),
        (   exists_file(F), catch(read_file_to_string(F, S0, [encoding(utf8)]), _, fail)
        ->  true
        ;   die(1, ["The red log " + F + " does not exist or cannot be read. Nothing was written.", "Fix: save the output of the red run to a file, and give its path."] >> fix_lines)
        ),
        split_string(S0, "", " \t\r\n", [S1]),
        (   S1 == ""
        ->  die(1, ["The red log " + F + " is empty. Nothing was written.", "Fix: give the output of the red run that you saw."] >> fix_lines)
        ;   true
        ),
        string_length(S1, N),
        (   N > 4000
        ->  Cut is N - 4000, sub_string(S1, Cut, 4000, 0, Tail),
            format(string(T0), "(cut: the first ~w characters are not kept) ~w", [Cut, Tail])
        ;   T0 = S1
        ),
        atom_string(Text, T0)
    ;   Text = none
    ).

shift_child(Script, Args, Exit, Out) :-
    process_create(Script, Args, [stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(P)]),
    read_string(O, _, O1), close(O), read_string(E, _, E1), close(E),
    process_wait(P, St),
    ( St = exit(Exit) -> true ; Exit = 2 ),
    string_concat(O1, E1, Out).

% shift_undo(+Dir, +Made, +Before): remove what shift wrote. A directory that shift made goes;
% in a directory that existed, only the entries that were not there before go.
shift_undo(Dir, true, _) :- !,
    catch(delete_directory_and_contents(Dir), _, true).
shift_undo(Dir, false, Before) :-
    (   catch(directory_files(Dir, Now), _, fail)
    ->  forall(( member(N, Now), \+ memberchk(N, Before) ),
               ( directory_file_path(Dir, N, P),
                 ( exists_directory(P) -> catch(delete_directory_and_contents(P), _, true)
                 ; catch(delete_file(P), _, true) ) ))
    ;   true
    ).

% ---------------------------------------------------------------------
% uses: add modules to an existing KB
% ---------------------------------------------------------------------
% It rewrites only the first term of kb.pl, uses([...]). It does not
% load the KB first, because a KB that needs a module is not valid
% until the module is in uses/1. It never removes a module.

cmd_uses(Dir, Args, Code) :-
    parse_opts(Args, [], Pos0, _),
    (   member(A, Pos0), sub_atom(A, 0, 1, _, '-')
    ->  usage_error("uses takes module names only, not ~w.", [A])
    ;   true
    ),
    % "build,discovery" is accepted too, as in init --uses.
    findall(M, ( member(A, Pos0), atomic_list_concat(Ps, ',', A), member(M, Ps), M \== '' ), Pos),
    (   Pos == []
    ->  usage_error("Name one or more modules: orbit-kb uses MODULE ...", [])
    ;   true
    ),
    lib_dir(Lib),
    lib_modules(Lib, Known),
    (   member(M, Pos), \+ memberchk(M, Known)
    ->  atomic_list_concat(Known, ', ', KT),
        die(1, ["The module " + M + " does not exist.", "Known modules: " + KT + ".", "Fix: use a known module name."] >> fix_lines)
    ;   true
    ),
    directory_file_path(Dir, 'kb.pl', KbFile0),
    % Write the file that a symlink points to, as add does, not the link.
    ( catch(read_link(KbFile0, _, KbFile), _, fail) -> true ; KbFile = KbFile0 ),
    catch(( read_file_to_string(KbFile, S, [encoding(utf8)]),
            setup_call_cleanup(open_string(S, In),
                               ( read_term(In, T, [module(orbit_ops), subterm_positions(TPos)]),
                                 arg(1, TPos, Start), arg(2, TPos, End) ),
                               close(In)) ),
          _, fail),
    !,
    (   nonvar(T), T = uses(Old), is_list(Old), maplist(atom, Old)
    ->  true
    ;   die(1, [KbFile0 + " does not start with uses([...]) and a list of module names.", "Fix: run orbit-kb lint and correct E10."] >> fix_lines)
    ),
    findall(M, ( member(M, Pos), \+ memberchk(M, Old) ), New0),
    list_to_set(New0, New),
    (   New == []
    ->  atomic_list_concat(Old, ', ', OT),
        format("The KB already uses ~w. Nothing was written.~n", [OT])
    ;   append(Old, New, Uses),
        % Replace only the text of the term. The text before it and after
        % it (the full stop, a comment, the other clauses) stays as it is.
        sub_string(S, 0, Start, _, Before),
        sub_string(S, End, _, 0, Rest),
        term_text(uses(Uses), UT),
        atomic_list_concat([Before, UT, Rest], Out),
        catch(write_atomic(KbFile, Out), E,
              ( err_text(E, ET),
                die(2, ["Could not write " + KbFile + ": " + ET, "Nothing was changed.", "Fix: check that the KB directory is writable."] >> fix_lines) )),
        format("~w.~n", [UT]),
        format(user_error, "Run orbit-kb lint next. The new module can add lint findings to the KB.~n", []),
        (   memberchk(discovery, New)
        ->  format(user_error, "Next: orbit-kb lint. Recipes for each move: orbit-kb help discovery.~n", [])
        ;   memberchk(build, New)
        ->  format(user_error, "Next: orbit-kb lint. Facts, queries, and burns: orbit-kb help build.~n", [])
        ;   true
        )
    ),
    Code = 0.
cmd_uses(Dir, _, _) :-
    directory_file_path(Dir, 'kb.pl', KbFile),
    die(1, ["Could not read the first term of " + KbFile + ".", "Fix: run orbit-kb lint and correct E1 or E10."] >> fix_lines).

% ---------------------------------------------------------------------
% Writing to kb.pl
% ---------------------------------------------------------------------

append_lines(File, Lines) :-
    (   exists_file(File)
    ->  read_file_to_string(File, S, [encoding(utf8)]),
        ( ( S == "" ; sub_string(S, _, 1, 0, "\n") ) -> Pre = "" ; Pre = "\n" )
    ;   Pre = ""
    ),
    setup_call_cleanup(open(File, append, Out, [encoding(utf8)]),
                       ( format(Out, "~w", [Pre]),
                         forall(member(L, Lines), format(Out, "~w~n", [L])) ),
                       close(Out)).

reject(Lines0) :-
    ( nonvar(Lines0), Lines0 = (L >> _) -> true ; L = Lines0 ),
    die(1, ["Rejected. Nothing was written."|L]).

% Validate new fact terms against the KB. NewItems use Src new, File
% '<arg>', Line = the argument number.
validate_new(KB, NewItems, Problems) :-
    kb_items(KB, Items),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    include(fact_item, Items, Old),
    append(Old, NewItems, All),
    build_env(All, Ds, Env),
    Ctx = fctx(KB, Ds, ATs, Env),
    findall(D, ( member(I, NewItems), fact_diags(Ctx, I, D0), member(D, D0) ), D1),
    e5_diags(All, Ds, D2a),
    include([diag(_, F, _, _)]>>(F == '<arg>'), D2a, D2),
    findall(D, ( member(I, NewItems), e17_diags(I, D0), member(D, D0) ), D3),
    e15_diags(All, D4a),
    include([diag(_, F, _, _)]>>(F == '<arg>'), D4a, D4),
    append([D1, D2, D3, D4], Problems).

problem_lines(Problems, NewItems, Lines) :-
    findall(S, ( member(diag(C, _, L, M), Problems),
                 member(it(_, _, L, T, VN, _), NewItems),
                 term_text(T, VN, TT),
                 fmt(S, "~w in argument ~w (~w): ~w", [C, L, TT, M]) ),
            Lines).

cmd_add(KB, Args, Code) :-
    parse_opts(Args, ['--by'-value, '--doc'-value], Pos, Opts),
    (   Pos == [] -> usage_error("Give one or more facts in quotes, such as orbit-kb add 'claim(c1, preserve, ''Text'')'.", []) ; true ),
    opt(Opts, '--by', agent, By),
    (   memberchk(By, [human, agent]) -> true
    ;   usage_error("--by takes human or agent. It is ~w.", [By])
    ),
    kb_items(KB, KI), items_atypes(KI, ATs),
    findall(R, ( nth1(I, Pos, A), add_item(ATs, I, A, R) ), Rs),
    findall(M, member(err(M), Rs), Errs),
    (   Errs \== [] -> reject(Errs) ; true ),
    findall(It, member(ok(It), Rs), NewItems),
    check_words_gate(KI, NewItems),
    % D22: a fact whose name is declared nowhere declares its predicate by
    % its first use. The decl/4 lines take part in the checks of the batch.
    first_use_pis(KB, NewItems, FUs),
    add_doc(KB, NewItems, Opts, FUs, Doc, Redoc),
    kb_file(KB, KbFile),
    findall(it(kb, KbFile, 0, D, [], 0-0), ( member(N/A, FUs), first_use_decl(N, A, Doc, D) ), DeclItems),
    KB = kb(Dir, Lib, Uses, _),
    append(KI, DeclItems, KI2),
    validate_new(kb(Dir, Lib, Uses, KI2), NewItems, Problems),
    (   Problems \== []
    ->  problem_lines(Problems, NewItems, PL),
        reject(PL)
    ;   true
    ),
    utc_now(Now),
    add_lines(NewItems, FUs, Doc, By, Now, [], Lines),
    apply_redoc(KbFile, Redoc),                  % T40 c8
    append_lines(KbFile, Lines),
    forall(member(L, Lines), format("~w~n", [L])),
    ignore(catch(register_spec_kb(Dir, NewItems), _, true)),   % T34 c2
    % kb-migrations c16: a fact of a retired predicate is written, and its cut-fail clause hides it.
    cutfail_pis(KI, CPIs),
    forall(( member(N/A-_, CPIs), once(( member(it(_, _, _, NT, _, _), NewItems), nonvar(NT), callable(NT), functor(NT, N, A) )) ),
           format(user_error, "NOTE: ~q/~w is retired in this KB (its cut-fail clause in kb.pl): the new fact stays in kb.pl, but no rule and no query finds it. lint WM1 names it.~n", [N, A])),
    forall(member(N/A, FUs),
           format(user_error, "NOTE: ~q/~w is a new predicate. Its first use declares it, with the type term for each argument (lint W7 lists it).~n", [N, A])),
    (   Doc == ''
    ->  forall(member(N/A, FUs),
               format(user_error, "NOTE: ~q/~w has no description (lint W9). Describe a new kind in its first add: orbit-kb add 'FACT' --doc TEXT.~n", [N, A]))
    ;   true
    ),
    Code = 0.

% check_words_gate(+KBItems, +NewItems) (E20): a new check(K, C) needs the words of the check:
% checks_that(K, Text) with non-empty Text, in the same add or already in the KB. Else reject.
check_words_gate(KI, NewItems) :-
    findall(K, ( member(it(_, _, _, T, _, _), NewItems), nonvar(T), T = check(K, _), nonvar(K),
                 \+ check_has_words(K, KI, NewItems) ), Ks0),
    sort(Ks0, Ks),
    (   Ks == [] -> true
    ;   Ks = [K1|_],
        findall(S, ( member(K, Ks),
                     fmt(S, "E20: the check ~w has no words. A new check needs checks_that(~w, Text): one line, in plain words, that says what it checks (the Desk shows it to a human).", [K, K]) ), Ms),
        fmt(Fix, "Fix: orbit-kb add 'check(~w, c1)' \"checks_that(~w, 'what it checks, in plain words')\"  Existing checks without words still load; lint W12 warns.", [K1, K1]),
        append(Ms, [Fix], All),
        reject(All)
    ).

check_has_words(K, KI, NewItems) :-
    (   member(it(_, _, _, T, _, _), NewItems)
    ;   member(it(_, _, _, T, _, _), KI)
    ),
    nonvar(T), T = checks_that(K2, W), K2 == K, nonvar(W), atomic(W),
    atom_string(W, WS), split_string(WS, "", " \t\r\n", [Tr]), Tr \== "", !.

% add_doc(+KB, +NewItems, +Opts, +FirstUsePIs, -Doc, -Redoc) (T26): the one-line --doc TEXT is
% the description of the one new kind of this add. Without --doc, Doc is ''. T40 c8: when no fact
% of the add is the first of a new kind, --doc describes the one kind of kb.pl that the facts
% have, if its description is empty or the old W7 placeholder: Redoc = redoc(Old, New), its
% decl/4 line with the new doc. A kind that has a description is refused. Else Redoc = none.
add_doc(KB, NewItems, Opts, FUs, Doc, Redoc) :-
    findall(D0, member('--doc'-D0, Opts), Docs),
    (   Docs = [_, _|_]
    ->  reject(["--doc is given more than once. A kind has one description.",       % T40 c9
                "Fix: give --doc once."] >> fix_lines)
    ;   true
    ),
    (   memberchk('--doc'-DocOpt, Opts)
    ->  (   FUs = [_] -> Redoc = none
        ;   FUs == []
        ->  redoc_target(KB, NewItems, Redoc0)
        ;   reject(["--doc describes one new kind, and this add has more than one.",
                    "Fix: add the first fact of each new kind in its own command, each with its --doc."] >> fix_lines)
        ),
        atom_string(DocOpt, DocS0),
        (   sub_string(DocS0, _, _, _, "\n")
        ->  reject(["The --doc text must be one line. It has a line break.",
                    "Fix: write one plain sentence."] >> fix_lines)
        ;   true
        ),
        split_string(DocS0, "", " \t", [DocS]),
        (   DocS == ""
        ->  reject(["The --doc text is empty.", "Fix: write one plain sentence, or leave out --doc."] >> fix_lines)
        ;   true
        ),
        atom_string(Doc, DocS),
        (   FUs == [] -> Redoc0 = redoc(F, L, decl(K, H, OD, Tpl)), Redoc = redoc(F, L, decl(K, H, OD, Tpl), decl(K, H, Doc, Tpl))
        ;   true
        )
    ;   Doc = '', Redoc = none
    ).

% redoc_target(+KB, +NewItems, -redoc(File, Line, Decl)) (T40 c8): the decl/4 line in kb.pl of the
% one kind of the new facts, when its description is empty or the W7 placeholder.
redoc_target(KB, NewItems, redoc(F, L, D)) :-
    findall(N/A, ( member(it(_, _, _, T, _, _), NewItems), pos_fact(T), functor(T, N, A) ), PIs0),
    sort(PIs0, PIs),
    kb_items(KB, Items),
    (   PIs = [N/A]
    ->  true
    ;   reject(["--doc describes one kind, and this add has facts of more than one kind.",
                "Fix: add one fact of the kind with --doc in its own command."] >> fix_lines)
    ),
    (   member(it(kb, F, L, D, _, _), Items), nonvar(D), D = decl(_, H, OD, _),
        callable(H), functor(H, N, A)
    ->  (   no_description(OD) -> true
        ;   fmt(M1, "--doc describes a kind with no description, and ~q/~w has one: ~w", [N, A, OD]),
            reject([M1, "Fix: leave out --doc. A description is not rewritten."] >> fix_lines)
        )
    ;   fmt(M2, "--doc describes a new kind, or a kind of kb.pl with no description, and ~q/~w is neither.", [N, A]),
        reject([M2, "Fix: leave out --doc. A kind gets its description in its first add, or in a later add while it has none."] >> fix_lines)
    ).

% apply_redoc(+KbFile, +Redoc) (T40 c8): write the new doc into the decl/4 line in place. The line
% must hold exactly the old decl/4 term; else nothing is written (exit 1).
apply_redoc(_, none) :- !.
apply_redoc(KbFile, redoc(_, L, Old, New)) :-
    read_file_to_string(KbFile, S, [encoding(utf8)]),
    split_string(S, "\n", "", Lines),
    (   nth1(L, Lines, Line),
        catch(term_string(T, Line), _, fail), T =@= Old
    ->  clause_line(New, [], NewLine),
        nth1(L, Lines, _, Rest), nth1(L, Lines2, NewLine, Rest),
        atomic_list_concat(Lines2, '\n', Out),
        write_kb_text(KbFile, Out)
    ;   reject(["The decl/4 line of the kind is not one line of its own in kb.pl, so --doc cannot set its description.",
                "Fix: put the decl/4 term on one line, then run the add again."] >> fix_lines)
    ).

% add_lines(+NewItems, +FirstUsePIs, +Doc, +By, +Time, +Done, -Lines): the lines
% of the facts in order. Before the first fact of a first-use predicate
% come its decl/4 line and its first_use/3 fact (D22).
add_lines([], _, _, _, _, _, []).
add_lines([it(_, _, _, T, _, _)|Is], FUs, Doc, By, Now, Done, Lines) :-
    (   pos_fact(T), functor(T, N, A), memberchk(N/A, FUs), \+ memberchk(N/A, Done)
    ->  first_use_decl(N, A, Doc, D),
        clause_line(D, [], L1),
        clause_line(first_use(N/A, By, Now), [], L2),
        Pre = [L1, L2], Done1 = [N/A|Done]
    ;   Pre = [], Done1 = Done
    ),
    clause_line(T, [], L),
    record_lines(T, Now, Post0),
    relation_lines(T, By, Now, Post1), append(Post0, Post1, Post),
    add_lines(Is, FUs, Doc, By, Now, Done1, Rest),
    append(Post, Rest, Rest1),
    append(Pre, [L|Rest1], Lines).

% record_lines(+Fact, +Time, -Lines) (D28): after an attestation, its
% actor; after a change, its actor and its change time.
record_lines(T, _, [A]) :-
    nonvar(T), T = attest(Id, _, _, _, _, _), !,
    actor_line(Id, A).
record_lines(T, Now, [A, C]) :-
    nonvar(T), T = change(Id, _), !,
    actor_line(Id, A),
    clause_line(change_at(Id, Now), [], C).
record_lines(_, _, []).

% relation_lines(+Fact, +By, +Time, -Lines) (D38): after a relation of the project module, who
% wrote it and when.
relation_lines(T, By, Now, [L]) :-
    nonvar(T), ( T = excludes(_, _) ; T = depends_on(_, _) ), !,
    clause_line(relation_by(T, By, Now), [], L).
relation_lines(_, _, _, []).

first_use_decl(N, A, Doc, decl(fact, H, Doc, '')) :-
    length(Ts, A), maplist(=(term), Ts),
    H =.. [N|Ts].

% first_use_pis(+KB, +NewItems, -PIs) (D22): the predicates N/A of the new
% facts whose name N is declared nowhere: not in the core, in no library
% module (also one that the KB does not use), not in kb.pl, at no arity.
% Each name once, at its first fact. A reserved name is never a first use.
first_use_pis(KB, NewItems, PIs) :-
    all_known_items(KB, Known),
    items_decls(Known, KDs),
    findall(N, member(d(N, _, _, _, _, _, _, _, _), KDs), Ns0),
    sort(Ns0, Known1),
    first_use_walk(NewItems, Known1, [], PIs0),
    reverse(PIs0, PIs).

first_use_walk([], _, Acc, Acc).
first_use_walk([it(_, _, _, T, _, _)|Is], Known, Acc, PIs) :-
    (   pos_fact(T), \+ meta_term(T),
        functor(T, N, A),
        atom(N), \+ reserved_name(N),
        \+ ord_memberchk(N, Known),
        \+ memberchk(N/_, Acc)
    ->  Acc1 = [N/A|Acc]
    ;   Acc1 = Acc
    ),
    first_use_walk(Is, Known, Acc1, PIs).

add_item(ATs, I, A, R) :-
    parse_one(A, P),
    (   P = err(M0)
    ->  fmt(M, "Argument ~w does not parse. ~w Check the brackets and quotes. Write text in single quotes.", [I, M0]),
        R = err(M)
    ;   P = ok(T, VN),
        (   nonvar(T), T = decl(rule, _, _, _)
        ->  fmt(M, "Argument ~w is a declaration of a rule predicate. add takes no declaration. Write the rule in rules.pl: its first clause declares the head. Put its description in a line above that clause: %% doc: TEXT.", [I]), R = err(M)
        ;   nonvar(T), T = decl(_, _, _, _)
        ->  fmt(M, "Argument ~w is a declaration of a fact kind. add takes no declaration. Add a fact of the new kind instead, with its description: orbit-kb add 'FACT' --doc TEXT.", [I]), R = err(M)
        ;   nonvar(T), T = attest_type(_, _, _, _)
        ->  fmt(M, "Argument ~w is an attestation type. orbit-kb add does not declare attestation types. Use a type that orbit-kb help core or a module topic lists.", [I]), R = err(M)
        ;   nonvar(T), T = uses(_)
        ->  fmt(M, "Argument ~w is uses/1. orbit-kb init writes it. To add a module, run orbit-kb uses MODULE.", [I]), R = err(M)
        ;   nonvar(T), T = discovery_end(_)
        ->  fmt(M, "Argument ~w: orbit-kb attest approval writes discovery_end/1 itself (D30), when the human approves the ticket while gate(go) holds. add refuses it.", [I]), R = err(M)
        ;   nonvar(T), functor(T, RN, RA), memberchk(RN/RA, [actor/3, change_at/2, review_saw/3])
        ->  fmt(M, "Argument ~w: orbit-kb writes ~w/~w itself (D28): with each attestation and change, or with orbit-kb review start. add refuses it.", [I, RN, RA]), R = err(M)
        ;   nonvar(T), T = relation_by(_, _, _)
        ->  fmt(M, "Argument ~w: orbit-kb writes relation_by/3 itself (D38), after each excludes and depends_on fact, with the --by of the add. To ratify an agent's relation, add the same relation with --by human. add refuses it.", [I]), R = err(M)
        ;   nonvar(T), T = attest(_, Type, _, _, _, _), atom(Type), script_only_type(ATs, Type)
        ->  script_use(Type, Use),
            fmt(M, "Argument ~w: only ~w writes attestations of type ~q.", [I, Use, Type]), R = err(M)
        ;   R = ok(it(new, '<arg>', I, T, VN, 0-0))
        )
    ).

script_use(lean_proof, "orbit-kb prove CLAIM FILE THEOREM") :- !.
script_use(_, "orbit-kb run CHECK -- CMD").

script_only_type(ATs, Type) :-
    atype_of(ATs, Type, at(_, _, W, _, _, _, _)),
    W == [script].

% ---------------------------------------------------------------------
% Reserved names
% ---------------------------------------------------------------------

reserved_name(N) :-
    memberchk(N, [decl, attest_type, uses, not, true, false, forall, call, is,
                  '=', '\\=', '<', '>', '=<', '>=', ',', ';', '->', ':-', '#', '\\+', '-',
                  '#=', '#<>', '#<', '#>', '#=<', '#>=']).

template_errs('', _, []) :- !.
template_errs(Tpl, A, Errs) :-
    atom_codes(Tpl, Cs),
    findall(E, template_err(Cs, A, E), Errs0),
    sort(Errs0, Errs).

template_err(Cs, A, E) :-
    append(_, [0'@, 0'(|Rest], Cs),
    (   append(Ds, [0')|_], Rest), Ds \== [], maplist(is_digit_code, Ds)
    ->  number_codes(I, Ds),
        ( I >= 1, I =< A -> fail ; fmt(E, "The template uses @(~w), but the predicate has ~w argument(s). Use @(1) to @(~w).", [I, A, A]) )
    ;   E = "The template has an @( that is not @(N) with a number N. Use @(1), @(2), and so on."
    ).

% ---------------------------------------------------------------------
% pin (D22)
% ---------------------------------------------------------------------
% orbit-kb pin prints the stamp spec-kb@sha256:HEX of kb.pl and the time.
% The CLI computes the digest; nobody types it. pin --check STAMP compares
% the first word of STAMP with the stamp of kb.pl now. pin writes nothing.

cmd_pin(Dir, Args, Code) :-
    parse_opts(Args, ['--check'-value], Pos, Opts),
    (   Pos == [] -> true
    ;   usage_error("pin takes no arguments other than --check STAMP.", [])
    ),
    directory_file_path(Dir, 'kb.pl', KbFile),
    sha256_file(KbFile, Digest),
    atom_concat('spec-kb@', Digest, Stamp),
    (   memberchk('--check'-Given, Opts)
    ->  atom_string(Given, GS),
        split_string(GS, " \t", " \t", Words0), exclude(==(""), Words0, Words),
        (   Words = [W|_], atom_string(WA, W), pin_stamp_ok(WA)
        ->  true
        ;   usage_error("The stamp must be spec-kb@sha256: and 64 lowercase hex characters, as orbit-kb pin prints it. It is ~w.", [Given])
        ),
        (   WA == Stamp
        ->  format("unchanged: ~w~n", [Stamp]), Code = 0
        ;   format("changed: kb.pl is now ~w. The pin ~w is old.~n", [Stamp, WA]), Code = 1
        )
    ;   utc_now(Now),
        format("~w ~w~n", [Stamp, Now]),
        Code = 0
    ).

pin_stamp_ok(A) :-
    atom_concat('spec-kb@sha256:', Hex, A),
    atom_length(Hex, 64),
    atom_codes(Hex, Cs),
    forall(member(C, Cs), ( between(0'0, 0'9, C) ; between(0'a, 0'f, C) )).

% ---------------------------------------------------------------------
% view questions (D24)
% ---------------------------------------------------------------------
% orbit-kb view questions [--dir KB]... [--ledger FILE] [--out F]: one
% static HTML page of what blocks done in each KB (with its pin stamp)
% and of the owner's asks from a JSON export of the flow ledger. It
% reads only. It takes no lock and writes no KB file.

take_dirs([], [], []).
take_dirs(['--'|As], [], ['--'|As]) :- !.
take_dirs(['--dir', D|As], [D|Ds], Rest) :- !, take_dirs(As, Ds, Rest).
take_dirs(['--dir'], _, _) :- !, usage_error("The option --dir needs a directory.", []).
take_dirs([A|As], Ds, Rest) :-
    sub_atom(A, 0, _, _, '--dir='), !,
    sub_atom(A, 6, _, 0, D),
    Ds = [D|Ds1], take_dirs(As, Ds1, Rest).
take_dirs([A|As], Ds, [A|Rest]) :- take_dirs(As, Ds, Rest).

cmd_view(Dirs0, Args, Code) :-
    parse_opts(Args, ['--ledger'-value, '--out'-value, '--owner'-value], Pos, Opts),
    (   Pos == [] -> usage_error("view needs a view name: orbit-kb view questions [--dir KB]... [--ledger FILE] [--out F].", [])
    ;   Pos == [questions] -> true
    ;   usage_error("view takes the one view name questions.", [])
    ),
    (   memberchk('--ledger'-LF, Opts) -> view_ledger(LF, Rows), view_owner(Opts, Rows, Owner), view_owned(Rows, Owner, Asks), Led = some(Asks) ; Led = none ),
    (   Dirs0 == [] -> resolve_kb(none, D0), Dirs = [D0]
    ;   maplist([D, R]>>resolve_kb(some(D), R), Dirs0, Dirs)
    ),
    lib_dir(Lib),
    maplist(view_kb_section(Lib), Dirs, Secs),
    atomic_list_concat(Secs, '\n', SecsText),
    view_ledger_section(Led, LedText),
    view_css(Css),
    format(string(Page),
"<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Open questions</title>
<style>~w</style>
</head>
<body>
<h1>Open questions</h1>
<p class=\"options-note\">The options of a question come from the KB's defaults (its default answer and an answer that an agent recorded) and from its option facts (each with what it changes). Other means an answer that is not listed. The page adds no option of its own.</p>
~w
~w
</body>
</html>
", [Css, SecsText, LedText]),
    (   memberchk('--out'-Out, Opts)
    ->  absolute_file_name(Out, Abs),
        catch(write_atomic(Abs, Page), E,
              ( err_text(E, M),
                die(2, ["Cannot write the page " + Abs + ": " + M,
                        "Fix: give a path in a directory that exists and that you can write."] >> fix_lines) ))
    ;   set_stream(user_output, encoding(utf8)),
        write(Page)
    ),
    Code = 0.

% view_css(-Css) (hub spec questions-server, c1 and q4): the page reuses the dark palette of
% report --html (report/page.css, dark at every load), then its own rules on those tokens.
view_css(Css) :-
    lib_dir(Lib), page_asset(Lib, 'report/page.css', Base),
    string_concat(Base, "body{max-width:60em;margin:2em auto;padding:0 1em;line-height:1.4}section{border:1px solid var(--line);border-radius:6px;padding:.5em 1em;margin:1em 0;background:var(--card)}section section{background:var(--bg)}li.item,li.ask{margin:.8em 0;padding:.4em;border-left:4px solid var(--line);list-style:none}.ref .kbid{font-family:var(--mono);color:var(--muted)}.default,.age{font-weight:bold}.stamp{font-family:var(--mono);font-size:.8em;word-break:break-all;color:var(--muted)}details>summary{cursor:pointer}details>summary>h2{display:inline}details:not([open])>summary{color:var(--muted)}p.reserved{color:var(--warn)}input,textarea,select,button{background:var(--bg);color:var(--fg);border:1px solid var(--line)}textarea{display:block;width:100%;min-height:4.5em;font:inherit;margin-top:.3em}fieldset.intent{border:1px solid var(--line);border-radius:4px;margin:.4em 0}button[type=submit]{padding:.2em 1.2em;cursor:pointer}.missing{color:var(--warn)}.loud{color:var(--bad);background:var(--bad-bg);padding:.1em .4em;border-radius:4px;font-weight:600}.muted,.hubpath,.counts,.draftstate,.by{color:var(--muted);font-size:.9em}.chip{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:0 .5em;margin:0 .15em;font-size:.85em}.chip.applied{color:var(--ok)}.chip.sent,.chip.queued{color:var(--warn)}.chip.failed{color:var(--bad)}li.letter,li.session,li.orphan,li.closedask,li.kbref,li.inbox{list-style:none;margin:.35em 0}li.kbaction{list-style:none;margin:.8em 0;padding:.4em;border-left:4px solid var(--warn)}.where{border-bottom:1px solid var(--line);margin-bottom:.5em}", Css).

view_ledger(File, Asks) :-
    (   exists_file(File) -> true
    ;   usage_error("The ledger file ~w does not exist.", [File])
    ),
    catch(setup_call_cleanup(open(File, read, S, [encoding(utf8)]),
                             json_read_dict(S, J, [null(null)]),
                             close(S)),
          E, ( err_text(E, M), usage_error("The ledger file ~w is not valid JSON: ~w", [File, M]) )),
    (   is_list(J) -> true
    ;   usage_error("The ledger file ~w must hold one JSON array of objects.", [File])
    ),
    forall(nth1(I, J, X), view_ledger_row(File, I, X)),
    Asks = J.

% view_owner(+Opts, +Rows, -Owner) (D24 C5): --owner, else the owner key of the first row that has one, else me.
view_owner(Opts, Rows, Owner) :-
    (   memberchk('--owner'-O, Opts) -> atom_string(O, Owner)
    ;   member(X, Rows), get_dict(owner, X, O0), string(O0) -> Owner = O0
    ;   Owner = "me"
    ).

view_owned(Rows, Owner, Asks) :-
    findall(X, ( member(X, Rows), X.kind == "ask", memberchk(X.status, ["open", "waiting"]), X.waits_on == Owner ), Asks).

view_ledger_row(File, I, X) :-
    (   is_dict(X) -> true ; usage_error("Ledger ~w, item ~w: not an object.", [File, I]) ),
    forall(member(K, [id, kind, title, status]),
           (   get_dict(K, X, V), string(V) -> true
           ;   usage_error("Ledger ~w, item ~w: the key ~w is missing or is not a string.", [File, I, K])
           )),
    (   get_dict(waits_on, X, W), ( W == null ; string(W) ) -> true
    ;   usage_error("Ledger ~w, item ~w: waits_on must be a string or null.", [File, I])
    ),
    (   get_dict(age_days, X, Age), integer(Age), Age >= 0 -> true
    ;   usage_error("Ledger ~w, item ~w: age_days must be a whole number, 0 or more.", [File, I])
    ).

view_ledger_section(Led, Text) :- view_ledger_section(static, Led, Text).
view_ledger_section(_, none, "").
view_ledger_section(Mode, some(Asks), Text) :- view_ledger_section(Mode, some(Asks), [], none, Text).

% view_ledger_section(+Mode, +Asks, +KBActs, +DeskStatus, -Text) (the Desk): Human action needed
% lists the reserved asks and the standing-rule actions of the hub's spec KBs (q3); Questions for
% you lists the other asks, and the asks answered in the last 7 days (c9).
view_ledger_section(Mode, some(Asks), Acts, St, Text) :-
    partition(view_ask_reserved, Asks, Res, Plain),
    view_ledger_lane(Mode, "Human action needed", "reserved", Res, Acts, "", "No action that you reserved waits on you.", T1),
    desk_closed_html(St, ClosedH),
    view_ledger_lane(Mode, "Questions for you", "plain", Plain, [], ClosedH, "No question waits on you.", T2),
    format(string(Text), "~w\n~w", [T1, T2]).

% view_ask_reserved(+Ask) (hub spec questions-server, c3): the owner reserved the action
% (hubflow add ask --reserved SOURCE, or a reserved key in a --ledger file).
view_ask_reserved(X) :- get_dict(reserved, X, R), string(R), R \== "".

view_ledger_lane(Mode, Head, Kind, Asks, Extra, Tail, Empty, Text) :-
    findall(L, ( member(X, Asks), view_ask_html(Mode, X, L) ), Ls0),
    append(Ls0, Extra, Ls),
    (   Ls == [] -> format(string(Body0), "<p>~w</p>", [Empty]), Op = ""
    ;   atomic_list_concat(Ls, '\n', B0), format(string(Body0), "<ul>\n~w\n</ul>", [B0]), Op = " open"
    ),
    string_concat(Body0, Tail, Body),
    format(string(Text), "<section class=\"ledger ~w\">\n<details~w><summary><h2>~w</h2></summary>\n~w\n</details>\n</section>", [Kind, Op, Head, Body]).

view_ask_html(Mode, X, L) :-
    esc(X.id, Id), esc(X.title, T), esc(X.age_days, Age),
    % D26 S7: the server shows the hubflow command that answers the ask, shell-quoted (T27 c7).
    % With --hub (Mode serve_hub), the ask also has a form: the server runs that command.
    (   ( Mode = serve(_) ; Mode = serve_hub(_, _) )
    ->  sh_quote(X.id, IdQ),
        (   Mode = serve_hub(_, Hub) -> sh_quote(Hub, HubQ), format(string(Cd), "cd ~w && ", [HubQ]) ; Cd = "" ),
        format(string(Cmd), "~wpython3 .claude/scripts/hubflow.py --by human close ~w --reason done --note 'YOUR ANSWER' --session human", [Cd, IdQ]),
        esc(Cmd, CmdH),
        (   Mode = serve_hub(Token, Hub2)
        ->  desk_ask_context(Hub2, X, CtxH),
            format(string(Key), "ask:~w", [X.id]),
            desk_form_html(Token, Hub2, Key, [ask-X.id], "", true, FormH),
            desk_item_letters(Hub2, ask(X.id), LetH),
            format(string(Hf), "~w~w <p>The server runs, in the hub: <code class=\"hubflow\">~w</code></p>~w", [CtxH, LetH, CmdH, FormH])
        ;   format(string(Hf), " <p>Answer it in the hub: <code class=\"hubflow\">~w</code></p>", [CmdH])
        )
    ;   Hf = ""
    ),
    (   view_ask_reserved(X) -> esc(X.reserved, RH), format(string(RsH), " <p class=\"reserved\">Reserved: ~w</p>", [RH]) ; RsH = "" ),
    format(string(L), "<li class=\"ask\" data-id=\"~w\"><span class=\"title\">~w</span> <span class=\"age\">~w days</span>~w~w</li>", [Id, T, Age, RsH, Hf]).

% sh_quote(+Text, -Quoted) (T27 c7): Text as one shell word: bare when it is made of plain
% characters, else in single quotes.
sh_quote(T0, Q) :-
    atom_string(T0, T),
    string_codes(T, Cs),
    (   Cs \== [], forall(member(C, Cs), ( code_type(C, alnum) ; memberchk(C, `_-.,:/@%+=`) ))
    ->  Q = T
    ;   split_string(T, "'", "", Parts), atomic_list_concat(Parts, '\'\\\'\'', J),
        format(string(Q), "'~w'", [J])
    ).

view_kb_section(Lib, Dir, Html) :- view_kb_section(static, Lib, Dir, Html).
view_kb_section(Mode, Lib, Dir, Html) :-
    load_kb(Dir, Lib, KB),
    answer_gate(KB),
    directory_file_path(Dir, 'kb.pl', KbFile),
    sha256_file(KbFile, Digest),
    atom_concat('spec-kb@', Digest, Stamp),
    esc(Stamp, StampH),
    kb_engine(KB, Eng),
    eng_all(Eng, [X], blocking(X), Xs),
    (   Xs == [] -> Body0 = "<p>Nothing blocks done.</p>"
    ;   maplist(view_item_html(Mode, Dir, Eng), Xs, Is),
        atomic_list_concat(Is, '\n', B0),
        format(string(Body0), "<ul class=\"items\">\n~w\n</ul>", [B0])
    ),
    (   Mode = serve(_) -> view_answered_html(Eng, AnsH) ; AnsH = "" ),
    view_pending_html(Dir, PendH),
    atomic_list_concat([Body0, AnsH, PendH], Body),
    (   eng_all(Eng, [RT], request(_, RT), [RT1|_]), txt(RT1, RT2), split_string(RT2, "\n", " \t", [L1|_]), L1 \== "" -> Label = L1
    ;   file_base_name(Dir, Label)
    ),
    esc(Label, LabelH),
    (   Mode = serve(_)
    ->  desk_kb_where(Dir, Eng, Xs, WhereH),
        desk_kb_actions(Mode, Dir, Eng, Label, ActsH, HasActs)
    ;   WhereH = "", ActsH = "", HasActs = false
    ),
    desk_note_kb(Dir, Label, Xs),
    ( ( view_kb_for_human(Eng, Dir) ; HasActs == true ) -> Op = " open" ; Op = "" ),
    desk_anchor(Dir, Anchor),
    format(string(Html), "<section class=\"kb\" id=\"~w\" data-stamp=\"~w\">\n<details class=\"kbfold\"~w><summary><h2><span class=\"kblabel\">~w</span> <span class=\"stamp\">~w</span></h2></summary>\n~w~w~w\n</details>\n</section>", [Anchor, StampH, Op, LabelH, StampH, WhereH, ActsH, Body]).

% view_kb_for_human(+Eng, +Dir) (hub spec questions-server, c2): the KB holds an item that waits
% on the human: a question to ask, or a queued answer that was refused (to answer again).
view_kb_for_human(Eng, _) :- eng_true(Eng, to_ask(_)), !.
view_kb_for_human(_, Dir) :-
    pending_entries(Dir, Es), applied_results(Dir, Rs),
    member(pending(_, D, _), Es), memberchk(D-refused, Rs), !.

% view_pending_html(+Dir, -Html) (T27 c4): the answers that wait in answers.pending.
view_pending_html(Dir, Html) :-
    pending_open(Dir, Ps),
    findall(L, ( member(pending(T, _, Fs), Ps), pending_questions(Fs, QAs), member(Q-A, QAs),
                 plain_text(A, AT), esc(AT, AH), esc(Q, QH), esc(T, TH),
                 format(string(L), "<li class=\"pending\" data-id=\"~w\">Question <span class=\"kbid\">~w</span>: the answer <span class=\"answer\">~w</span> is pending (queued ~w). The next write to the KB applies it.</li>", [QH, QH, AH, TH]) ), Ls),
    (   Ls == [] -> Html0 = ""
    ;   atomic_list_concat(Ls, '\n', LsT),
        format(string(Html0), "\n<h3>Answers that wait to be applied</h3>\n<ul class=\"pending-list\">\n~w\n</ul>", [LsT])
    ),
    view_refused_html(Dir, Html1),
    string_concat(Html0, Html1, Html).

% view_refused_html(+Dir, -Html) (T37 c5): the queued answers that the KB refused when a write applied them.
view_refused_html(Dir, Html) :-
    pending_entries(Dir, Es), applied_results(Dir, Rs),
    findall(L, ( member(pending(T, D, Fs), Es), memberchk(D-refused, Rs), pending_questions(Fs, QAs), member(Q-A, QAs),
                 plain_text(A, AT), esc(AT, AH), esc(Q, QH), esc(T, TH),
                 format(string(L), "<li class=\"refused\" data-id=\"~w\">Question <span class=\"kbid\">~w</span>: the answer <span class=\"answer\">~w</span> (queued ~w) was refused and is not applied. Answer the question again.</li>", [QH, QH, AH, TH]) ), Ls),
    (   Ls == [] -> Html = ""
    ;   atomic_list_concat(Ls, '\n', LsT),
        format(string(Html), "\n<h3>Queued answers that were refused</h3>\n<ul class=\"refused-list\">\n~w\n</ul>", [LsT])
    ).

view_ref(Id, Text, Html) :-
    esc(Id, I), esc(Text, T),
    format(string(Html), "<span class=\"ref\"><span class=\"kbid\">~w</span> <span class=\"kbtext\">~w</span></span>", [I, T]).

% view_xtext(+Eng, +X, -Text): the text of a claim, a question, or a change; of a check, the text of its claim.
view_xtext(Eng, X, T) :-
    (   eng_all(Eng, [T0], claim(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [T0], question(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [C], check(X, C), [C1|_]), eng_all(Eng, [T0], claim(C1, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [T0], change(X, T0), [T1|_]) -> txt(T1, T)
    ;   T = "(no text is recorded)"
    ).

% view_xclaim(+Eng, +X, -C): the claim that item X blocks, when it has one.
view_xclaim(Eng, X, C) :-
    (   eng_all(Eng, [], claim(X, _, _), [_|_]) -> C = X
    ;   eng_all(Eng, [C0], question(X, C0, _), [C1|_]) -> C = C1
    ;   eng_all(Eng, [C0], check(X, C0), [C1|_]) -> C = C1
    ).

view_kind_label(to_ask, "Question to ask").
view_kind_label(supersede_cycle, "Claim that replaces itself").
view_kind_label(past_due, "Past due").
view_kind_label(under, "Claim not fulfilled").
view_kind_label(over, "Change that serves no claim").
view_kind_label(burn_open, "Claim that needs a proof or a formal statement").
view_kind_label(flare_open, "Claim that needs an approved demo").
view_kind_label(no_claim, "No current claim").
view_kind_label(check_failing, "Check that failed").
view_kind_label(check_unrun, "Check that never ran").
view_kind_label(waiver_lapsed, "Waiver that lapsed").
view_kind_label(project_kb_unclean, "Project KB that does not load clean").
view_kind_label(project_contradiction, "Pinned fact in a contradiction").

% view_blocking_sentence(+Eng, +Item, -Text) (T18 c4): the sentence of show blocking for Item,
% the text after "- KIND ID: " (or "- KIND: "). The project kinds (D23 P5, P8) use it.
view_blocking_sentence(Eng, Item, Text) :-
    blocking_line(_, Eng, Item, Line0),
    atom_string(Line0, Line),
    (   sub_string(Line, B, 2, _, ": ") -> S is B + 2, sub_string(Line, S, _, 0, Text)
    ;   Text = Line
    ).

view_item_html(Mode, Dir, Eng, Item, Html) :-
    (   atom(Item) -> Kind = Item, Id = ''
    ;   Item =.. [Kind, Id]
    ),
    (   view_kind_label(Kind, Label) -> true ; Label = "Blocking item" ),
    % the subject: its text, and the claim it blocks
    (   Kind == waiver_lapsed
    ->  (   eng_all(Eng, [X, R], attest(Id, waiver, _, waive(X, _, R), _, _), [[X1, R1]|_])
        ->  txt(R1, T0), ( T0 == '' -> view_xtext(Eng, X1, Text) ; Text = T0 ),
            ( view_xclaim(Eng, X1, Cl) -> true ; true )
        ;   Text = "(a waiver)"
        )
    ;   Kind == no_claim
    ->  Text = "Add a claim; the work is not done without one."
    ;   memberchk(Kind, [project_kb_unclean, project_contradiction])
    ->  view_blocking_sentence(Eng, Item, Text)
    ;   view_xtext(Eng, Id, Text),
        ( view_xclaim(Eng, Id, Cl) -> true ; true )
    ),
    (   Id == '' -> Ref = "", Plain = Text
    ;   view_ref(Id, Text, Ref0), format(string(Ref), "~w", [Ref0]), Plain = ""
    ),
    esc(Label, LabelH), esc(Plain, PlainH),
    esc(Kind, KindH), esc(Id, IdH),
    (   nonvar(Cl)
    ->  eng_all(Eng, [CT], claim(Cl, _, CT), [CT1|_]), txt(CT1, CTT),
        view_ref(Cl, CTT, ClRef),
        format(string(Blocks), "<p>Blocks: <span class=\"blocks\">~w</span></p>", [ClRef]),
        eng_all(Eng, [Cite], cites(Cl, Cite), Cites),
        findall(S, ( member(Ci, Cites), esc(Ci, CiH),
                     format(string(S), "<blockquote class=\"cited\">~w</blockquote>", [CiH]) ), CiS),
        atomic_list_concat(CiS, '', CitedH)
    ;   Blocks = "", CitedH = ""
    ),
    (   Kind == to_ask -> view_question_html(Mode, Dir, Eng, Id, QHtml) ; QHtml = "" ),
    format(string(Html), "<li class=\"item\" data-kind=\"~w\" data-id=\"~w\">\n<p>~w: ~w~w</p>\n~w\n~w\n~w\n</li>",
           [KindH, IdH, LabelH, Ref, PlainH, Blocks, CitedH, QHtml]).

% The default and the options of a question (D24 C7): the default, an answer by an agent,
% each option/3 text, and other. Each option has its effect when the KB records one.
view_question_html(Mode, Dir, Eng, Q, Html) :-
    (   eng_all(Eng, [A], assumed(Q, A), [A1|_]) -> plain_text(A1, Def) ; Def = none ),
    ( nonvar(Def), Def \== none -> HasDef = true ; HasDef = false ),
    esc(Def, DefH),
    format(string(DefLine), "<p>Default: <span class=\"default\">~w</span></p>", [DefH]),
    eng_all(Eng, [A2, By], answer(Q, A2, By), Ans),
    findall(AT, ( member([A3, By3], Ans), By3 \== human, By3 \= human:_, plain_text(A3, AT), ( HasDef == false ; AT \== Def ) ), Ats0),
    list_to_set(Ats0, Ats),
    eng_all(Eng, [OT, OE], option(Q, OT, OE), OFs0),
    findall(T-E, ( member([T0, E0], OFs0), plain_text(T0, T), plain_text(E0, E) ), OFs),
    findall(src(default, Def), HasDef == true, DL),
    findall(src(answer, AT), member(AT, Ats), AL),
    findall(T0, ( member(T0-_, OFs), \+ memberchk(src(_, T0), DL), \+ memberchk(src(_, T0), AL) ), Ots0),
    list_to_set(Ots0, Ots),
    findall(src(option, T0), member(T0, Ots), OL),
    append([DL, AL, OL], Srcs),
    findall(L, ( member(src(Src, T), Srcs), view_option(Src, T, OFs, L) ), Ls0),
    view_option(other, other, [], OtherL),
    append(Ls0, [OtherL], Ls),
    atomic_list_concat(Ls, '\n', OsT),
    (   OFs == []
    ->  Note = "<p class=\"no-effects\">No option effects are recorded for this question.</p>"
    ;   Note = ""
    ),
    (   Mode = serve(Token)
    ->  findall(T, member(src(_, T), Srcs), Ts0), list_to_set(Ts0, Ts),
        view_form_or_owner(Eng, Token, Dir, Q, Ts, Form)
    ;   Form = ""
    ),
    view_context_html(Eng, Q, Ctx),
    (   Mode = serve(_) -> desk_question_extras(Dir, Eng, Q, Def, OFs, ExH) ; ExH = "" ),
    format(string(Html), "~w~w\n<ul class=\"options\">\n~w\n</ul>\n~w~w~w", [Ctx, DefLine, OsT, Note, ExH, Form]).

% view_context_html(+Eng, +Q, -Html) (T27 c6): the context a human needs to decide: the notes
% of the question, the notes of its claim (the divergence), the examples of the claim, and the
% due date of the question.
view_context_html(Eng, Q, Html) :-
    (   eng_all(Eng, [C0], question(Q, C0, _), [C|_]) -> true ; C = '$none' ),
    eng_all(Eng, [N1], note(Q, N1), N1s),
    eng_all(Eng, [N2], note(C, N2), N2s),
    eng_all(Eng, [E1], example(C, E1), Es),
    eng_all(Eng, [D1], due(Q, D1), Ds),
    findall(P, ( member(X, N1s), txt(X, XT), esc(XT, XH), format(string(P), "<p class=\"qnote\">Note: ~w</p>", [XH]) ), P1),
    findall(P, ( member(X, N2s), txt(X, XT), esc(XT, XH), format(string(P), "<p class=\"claimnote\">Note on the claim: ~w</p>", [XH]) ), P2),
    findall(P, ( member(X, Es), txt(X, XT), esc(XT, XH), format(string(P), "<p class=\"example\">Example: ~w</p>", [XH]) ), P3),
    findall(P, ( member(X, Ds), txt(X, XT), esc(XT, XH), format(string(P), "<p class=\"due\">Due: ~w</p>", [XH]) ), P4),
    append([P1, P2, P3, P4], Ps),
    (   Ps == [] -> Html = ""
    ;   atomic_list_concat(Ps, '\n', PT), format(string(Html), "<div class=\"context\">\n~w\n</div>\n", [PT])
    ).

% view_form_or_owner(+Eng, +Token, +Dir, +Q, +Texts, -Html) (T37 c5): no form while an answer to Q waits
% in answers.pending (the pending list shows it), and none for a question that a tracker item owns
% (the page shows the item; a POST would only get 409), or that a ledger ask owns (T38 c10: the
% page names the ask).
view_form_or_owner(Eng, Token, Dir, Q, Texts, Html) :-
    (   pending_for_question(Dir, Q)
    ->  Html = "<p class=\"waiting\">An answer to this question waits to be applied (see below). The form is back when it is applied.</p>"
    ;   eng_all(Eng, [K, Ref], question_pin(Q, K, Ref, _, _), Pins), last(Pins, [Kind, Ref1])
    ->  plain_text(Ref1, RT), esc(RT, RH),
        (   Kind == ledger      % T38 c10: the ask owns it; its answer closes the ask and reaches this KB
        ->  format(string(Html), "<p class=\"owner\">This question is owned by the ledger ask <span class=\"ref\">~w</span>. Answer the ask (in the hub, or in the asks of this page when the server reads the hub); the answer closes the ask and reaches this KB.</p>", [RH])
        ;   format(string(Html), "<p class=\"owner\">This question is owned by the tracker item <span class=\"ref\">~w</span>. Answer it there; the answer is pinned with orbit-kb pin-answer.</p>", [RH])
        )
    ;   view_answer_form(Token, Dir, Q, Texts, Html)
    ).

% pending_for_question(+Dir, +Q): an open line of answers.pending answers Q.
pending_for_question(Dir, Q) :-
    pending_open(Dir, Ps),
    member(pending(_, _, Fs), Ps), member(answer(Q0, _, _), Fs), Q0 == Q, !.

% view_answer_form(+Token, +Dir, +Q, +Texts, -Html) (D26 S3): the answer form of a to_ask
% question in the served page: one radio choice per option text (as listed above), then other,
% and a free text. The hidden fields carry the token of this run, the KB, and the question.
view_answer_form(Token, Dir, Q, Texts, Html) :-
    append(Texts, ["other"], All),
    (   desk_hub_dir(Dir, Hub) -> desk_slug(Hub, Dir, _), desk_rel(Hub, Dir, Rel),
        format(string(Key), "q:~w#~w", [Rel, Q]), desk_draft(Hub, Key, Dr)
    ;   Hub = none, format(string(Key), "q:~w#~w", [Dir, Q]), Dr = _{}
    ),
    ( get_dict(choice, Dr, DC), string(DC) -> true ; DC = "" ),
    findall(R, ( member(T, All), esc(T, TH), ( T == DC -> Ck = " checked" ; Ck = "" ),
                 format(string(R), "<label><input type=\"radio\" name=\"choice\" value=\"~w\"~w> ~w</label>", [TH, Ck, TH]) ), Rs),
    atomic_list_concat(Rs, '\n', RsT),
    desk_form_html(Token, Hub, Key, [kb-Dir, q-Q], RsT, true, Html).

% view_answered_html(+Eng, -Html) (D26 S3): the questions that a human answered, each with the
% answer, and its default marked when the answer defeats it.
view_answered_html(Eng, Html) :-
    eng_all(Eng, [Q, A, By], answer(Q, A, By), QAs1),
    findall([Q, A], ( member([Q, A, By], QAs1), ( By == human ; By = human:_ ) ), QAs0),
    list_to_set(QAs0, QAs),
    findall(L, ( member([Q, A], QAs), view_answered_li(Eng, Q, A, L) ), Ls),
    (   Ls == [] -> Html = ""
    ;   atomic_list_concat(Ls, '\n', LsT),
        format(string(Html), "\n<h3>Answered by a human</h3>\n<ul class=\"answered-list\">\n~w\n</ul>", [LsT])
    ).

view_answered_li(Eng, Q, A, L) :-
    view_xtext(Eng, Q, QT), view_ref(Q, QT, Ref),
    plain_text(A, AT), esc(AT, AH),
    (   eng_true(Eng, defeated(Q)), eng_all(Eng, [D], assumed(Q, D), [D1|_])
    ->  plain_text(D1, DT), esc(DT, DH),
        format(string(Def), " <span class=\"defeated\">The default ~w is defeated.</span>", [DH])
    ;   Def = ""
    ),
    esc(Q, QH),
    format(string(L), "<li class=\"answered\" data-id=\"~w\">~w Answer: <span class=\"answer\">~w</span>~w</li>", [QH, Ref, AH, Def]).

view_option(Src, Text, OFs, L) :-
    esc(Text, T),
    (   Src == other -> Eff = ""
    ;   OFs == [] -> Eff = ""
    ;   memberchk(Text-E, OFs) -> esc(E, EH), format(string(Eff), " <span class=\"effect\">~w</span>", [EH])
    ;   Eff = " <span class=\"effect none\">No effect is recorded.</span>"
    ),
    format(string(L), "<li class=\"option\" data-source=\"~w\"><span class=\"optiontext\">~w</span>~w</li>", [Src, T, Eff]).

% ---------------------------------------------------------------------
% serve questions (D26)
% ---------------------------------------------------------------------
% orbit-kb serve questions [--dir KB]... [--root DIR] [--ledger FILE [--owner KEY]] [--port N]:
% a local server for the page of view questions. Each GET of / reads the KBs and the ledger
% again. A POST of /answer records one human answer through `orbit-kb add --by human`, run as
% a child process, under the writer lock. The server listens on 127.0.0.1 only, refuses a Host
% other than 127.0.0.1 or localhost, and needs the token of this run on a POST. It keeps no
% state of its own and never uses --take. Ctrl-C stops it.

:- dynamic serve_conf/2.

serve_default_port(8737).

cmd_serve(Dirs0, Args, Code) :-
    parse_opts(Args, ['--ledger'-value, '--owner'-value, '--root'-value, '--port'-value, '--hub'-value], Pos, Opts),
    (   Pos == [] -> usage_error("serve needs a view name: orbit-kb serve questions [--dir KB]... [--root DIR] [--ledger FILE] [--hub DIR]... [--port N], or orbit-kb serve desk [--hub DIR]... [--port N].", [])
    ;   Pos == [questions] -> DeskMode = false
    ;   Pos == [desk] -> DeskMode = true
    ;   usage_error("serve takes the view name questions or desk.", [])
    ),
    (   memberchk('--port'-PA, Opts)
    ->  (   atom_number(PA, Port), integer(Port), between(0, 65535, Port) -> true
        ;   usage_error("--port takes a whole number from 0 to 65535. It is ~w.", [PA])
        )
    ;   serve_default_port(Port)
    ),
    (   memberchk('--root'-R0, Opts)
    ->  (   exists_directory(R0) -> absolute_file_name(R0, Root), RootOpt = some(Root)
        ;   usage_error("The --root directory ~w does not exist.", [R0])
        )
    ;   RootOpt = none
    ),
    (   memberchk('--ledger'-LF0, Opts)
    ->  absolute_file_name(LF0, LF), view_ledger(LF, _), LedOpt = some(LF)    % fail early on a bad file
    ;   LedOpt = none
    ),
    % The Desk (hub spec KB questions-server): --hub repeats; each hub is a section of the page.
    findall(H, ( member('--hub'-H0, Opts), hub_root(H0, H1), hub_asks(H1, _, _), serve_norm(H1, H) ), Hubs0),
    list_to_set(Hubs0, Hubs),
    (   Dirs0 == [], RootOpt == none, ( Hubs \== [] ; DeskMode == true ) -> Dirs = []
    ;   Dirs0 == [], RootOpt == none -> resolve_kb(none, D0), Dirs = [D0]
    ;   maplist([D, Rd]>>resolve_kb(some(D), Rd), Dirs0, Dirs)
    ),
    (   memberchk('--owner'-Ow, Opts) -> OwnOpt = ['--owner'-Ow] ; OwnOpt = [] ),
    (   Hubs = [Hub|_] -> HubOpt = some(Hub) ; HubOpt = none ),
    serve_token(Token),
    (   getenv('ORBIT_KB_WRITER', W0), W0 \== '' -> Writer = W0 ; Writer = human ),
    orbit_script(Script),
    retractall(serve_conf(_, _)),
    forall(member(K-V, [dirs-Dirs, root-RootOpt, ledger-LedOpt, owner-OwnOpt, token-Token,
                        writer-Writer, script-Script, hub-HubOpt, hubs-Hubs, desk-DeskMode]),
           assertz(serve_conf(K, V))),
    use_module(library(http/thread_httpd)),
    ( Port == 0 -> true ; BindPort = Port ),     % an unbound port: the system picks a free one
    context_module(Mod),
    catch(thread_httpd:http_server(Mod:serve_request, [port('127.0.0.1':BindPort), workers(1), silent(true)]), E,
          ( err_text(E, M),
            die(2, ["Cannot listen on 127.0.0.1:" + Port + ": " + M,
                    "Fix: give another port with --port N."] >> fix_lines) )),
    (   desk_mode
    ->  format("Serving the Desk at http://127.0.0.1:~w/ . Answers are written as ~w. Ctrl-C stops.~n", [BindPort, Writer])
    ;   format("Serving the questions at http://127.0.0.1:~w/ . Answers are written as ~w. Ctrl-C stops.~n", [BindPort, Writer])
    ),
    flush_output(user_output),
    on_signal(int, _, serve_halt),
    on_signal(term, _, serve_halt),
    repeat, thread_get_message(_), fail,
    Code = 0.

serve_halt(_) :- halt(0).

% serve_token(-Token): 32 hex digits from a random source, new for each run.
serve_token(Token) :-
    (   catch(( use_module(library(crypto)), crypto:crypto_n_random_bytes(16, Bs) ), _, fail)
    ->  true
    ;   catch(setup_call_cleanup(open('/dev/urandom', read, S, [type(binary)]),
                                 ( length(Bs, 16), maplist([B]>>get_byte(S, B), Bs) ),
                                 close(S)), _, fail)
    ->  true
    ;   die(2, ["Cannot make the token of the run: no random source.", "Fix: install the SWI-Prolog ssl package."])
    ),
    maplist([B, H]>>format(atom(H), "~|~`0t~16r~2+", [B]), Bs, Hs),
    atomic_list_concat(Hs, Token).

% serve_route(+Method, +Path, +HostOk, +TokenOk, -Action) (D26 S5, S6): the one place that
% decides what a request does. Only `answer` writes, and only after the checks of serve_answer/2.
serve_route(_, _, false, _, forbidden) :- !.
serve_route(get, '/', true, _, page) :- !.
serve_route(post, '/answer', true, true, answer) :- !.
serve_route(post, '/answer', true, false, forbidden) :- !.
serve_route(post, '/draft', true, true, draft) :- !.
serve_route(post, '/draft', true, false, forbidden) :- !.
serve_route(post, '/review', true, true, review) :- !.
serve_route(post, '/review', true, false, forbidden) :- !.
serve_route(post, '/send', true, true, send) :- !.
serve_route(post, '/send', true, false, forbidden) :- !.
serve_route(get, '/demo', true, true, demo) :- !.      % H-0043: a demo image that the Desk shows
serve_route(get, '/demo', true, false, forbidden) :- !.
serve_route(_, P, true, _, bad_method) :- memberchk(P, ['/', '/answer', '/draft', '/review', '/send', '/demo']), !.
serve_route(_, _, true, _, not_found).

serve_host_ok(Req, true) :-
    memberchk(host(H), Req), memberchk(H, ['127.0.0.1', localhost]), !.
serve_host_ok(_, false).

serve_request(Req) :-
    catch(serve_request_(Req), E, serve_failed(E)).

serve_request_(Req) :-
    memberchk(method(M), Req), memberchk(path(P), Req),
    serve_host_ok(Req, HostOk),
    (   M == post, memberchk(P, ['/answer', '/draft', '/review', '/send']), HostOk == true
    ->  serve_form(Req, Form0),
        ( memberchk(x_desk_fragment(_), Req) -> Form = [desk_fragment='1'|Form0] ; Form = Form0 ),
        serve_conf(token, Tok),
        ( serve_field(Form, token, T), atom_string(Tok, T) -> TokOk = true ; TokOk = false )
    ;   M == get, P == '/', HostOk == true, desk_mode
    ->  ( memberchk(search(Form), Req), is_list(Form) -> true ; Form = [] ), TokOk = false
    ;   M == get, P == '/demo', HostOk == true
    ->  ( memberchk(search(Form0), Req), is_list(Form0) -> Form = Form0 ; Form = [] ),
        serve_conf(token, Tok),
        ( serve_field(Form, token, T), atom_string(Tok, T) -> TokOk = true ; TokOk = false )
    ;   Form = [], TokOk = false
    ),
    serve_route(M, P, HostOk, TokOk, Action),
    serve_act(Action, Form).

serve_act(page, Form) :-
    (   desk_mode -> ( serve_field(Form, mh, Tab) -> true ; Tab = "" ), desk_page("", Tab, Page)
    ;   serve_page("", Page)
    ),
    serve_reply(200, Page).
% c20: on the Desk every response goes through the review; /answer takes none.
serve_act(answer, _) :- desk_mode, !,
    serve_message_page(409, "On the Desk every response goes through the review: press Review and send on the page. Nothing was written.").
serve_act(review, Form) :-
    (   \+ desk_mode -> serve_message_page(404, "There is no such page. GET / shows the questions.")
    ;   catch(( desk_plan(Form, Plan), ( serve_field(Form, desk_fragment, _) -> Frag = true ; Frag = false ),
                desk_review_html(Plan, Frag, Html), serve_reply(200, Html) ),
              E,
              (   E = desk_refused(St, Msg) -> serve_message_page(St, Msg)
              ;   E = desk_sent(HD, Sent, _, Back) -> ( serve_field(Form, desk_fragment, _) -> Frag = true ; Frag = false ),
                  desk_sent_html(HD, Sent, Back, Frag, Html), serve_reply(200, Html)
              ;   throw(E)
              ))
    ).
serve_act(send, Form) :-
    (   \+ desk_mode -> serve_message_page(404, "There is no such page. GET / shows the questions.")
    ;   desk_send_form(Form, R),
        (   R = ok(Anchor) -> serve_frame_headers(FH),
            ( serve_field(Form, tab, Tb), Tb \== "" -> uri_encoded(query_value, Tb, TbE), format(string(Back), "/?mh=~w", [TbE]) ; Back = "/" ),
            format("Status: 303~nLocation: ~w#~w~n~wContent-type: text/html; charset=UTF-8~n~n<p>Sent. <a href=\"/\">Back to the Desk</a></p>~n", [Back, Anchor, FH])
        ;   R = refused(St, Msg) -> serve_message_page(St, Msg)
        )
    ).
serve_act(answer, Form) :- serve_answer(Form, R),
    (   R = ok -> serve_frame_headers(FH), format("Status: 303~nLocation: /~n~wContent-type: text/html; charset=UTF-8~n~n<p>Recorded. <a href=\"/\">Back to the questions</a></p>~n", [FH])
    ;   R = refused(St, Msg) -> serve_message_page(St, Msg)
    ).
serve_act(draft, Form) :- ( desk_mode -> desk_save_draft2(Form, R) ; desk_save_draft(Form, R) ),
    (   R == ok -> serve_frame_headers(FH), format("Status: 204~n~wCache-Control: no-store~n~n", [FH])
    ;   R = refused(St, Msg) -> serve_message_page(St, Msg)
    ).
serve_act(demo, Form) :-
    (   desk_mode, desk_demo_file(Form, Abs, Type)
    ->  serve_frame_headers(FH),
        % a demo file is what an agent wrote: it runs nothing, loads nothing, and cannot read the page
        format("Status: 200~n~wContent-type: ~w~nCache-Control: no-store~nX-Content-Type-Options: nosniff~nContent-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox~n~n", [FH, Type]),
        set_stream(current_output, encoding(octet)),
        setup_call_cleanup(open(Abs, read, In, [type(binary)]), copy_stream_data(In, current_output), close(In))
    ;   serve_message_page(404, "There is no such demo on the Desk. Reload the Desk: it serves only the demo images that its page shows.")
    ).
serve_act(forbidden, _) :- serve_message_page(403, "Forbidden. The server answers only requests to 127.0.0.1 or localhost, and a POST needs the token of the page of this run. Reload the page.").
serve_act(bad_method, _) :- serve_message_page(405, "This method is not allowed here. GET / shows the page; the forms POST to /answer.").
serve_act(not_found, _) :- serve_message_page(404, "There is no such page. GET / shows the questions.").

serve_failed(E) :-
    (   E = orbit_error(_, Lines) -> atomic_list_concat(Lines, ' ', M) ; err_text(E, M) ),
    catch(serve_message_page(500, M), _, true).

serve_form(Req, Form) :-
    (   memberchk(content_length(N), Req), N > 65536
    ->  Form = []
    ;   memberchk(content_type(CT), Req), sub_atom(CT, 0, _, _, 'application/x-www-form-urlencoded'),
        memberchk(content_length(N), Req), memberchk(input(In), Req)
    ->  % read the body here: no HTTP client library (D25 T6; TS14)
        catch(( set_stream(In, encoding(octet)), read_string(In, N, Body),
                uri_query_components(Body, Form0) ), _, Form0 = []),
        ( is_list(Form0) -> Form = Form0 ; Form = [] )
    ;   Form = []
    ).

serve_field(Form, K, V) :- memberchk(K=V0, Form), atom_string(V0, V).

% T27 c9: no other site may frame the page (and its token).
serve_frame_headers("X-Frame-Options: DENY\nContent-Security-Policy: frame-ancestors 'none'\n").

serve_reply(Status, Page) :-
    serve_frame_headers(FH),
    format("Status: ~w~n~wContent-type: text/html; charset=UTF-8~nCache-Control: no-store~n~n", [Status, FH]),
    set_stream(current_output, encoding(utf8)),
    write(Page).

serve_message_page(Status, Msg) :-
    esc(Msg, MH),
    % c1: dark at every load, a message page too
    format(string(Page), "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Open questions</title>\n<style>:root{color-scheme:dark}body{background:#121722;color:#ece8df;font:15px/1.55 system-ui,sans-serif;margin:2em auto;max-width:60em;padding:0 16px}a{color:#9cbcf0}</style>\n</head>\n<body>\n<p class=\"message error\">~w</p>\n<p><a href=\"/\">Back to the questions</a></p>\n</body>\n</html>\n", [MH]),
    serve_reply(Status, Page).

% serve_kbs(-Groups): the KBs to serve now, as group(Label, ProjectDir|none, Dirs). The --dir
% KBs in the order given, then the KBs under --root, sorted by path. A KB that a spec KB names
% with project_kb/1, or that uses the project module and has no project_kb and no claim, is a
% project KB: it names a group and has no section of its own.
serve_kbs(Groups) :- serve_all_dirs(All), serve_groups(All, Groups).

% serve_all_dirs(-All): the --dir KBs, the KBs under --root, and the KBs under each --hub.
serve_all_dirs(All) :-
    serve_conf(dirs, Dirs0), serve_conf(root, RootOpt),
    (   RootOpt = some(Root) -> serve_find_kbs(Root, Found0) ; Found0 = [] ),
    ( serve_conf(hubs, Hubs) -> true ; Hubs = [] ),
    findall(D, ( member(H, Hubs), serve_find_kbs(H, HDs), member(D, HDs) ), HubFound),
    append([Dirs0, Found0, HubFound], All0),
    maplist(serve_norm, All0, All1),
    list_to_set(All1, All).

serve_groups(All, Groups) :-
    findall(D-P, ( member(D, All), serve_kb_project(D, P) ), DPs),
    findall(P, member(_-some(P), DPs), Ps0), list_to_set(Ps0, Ps),
    findall(D, ( member(D, All), ( memberchk(D, Ps) ; serve_is_project_kb(D) ) ), PKs),
    findall(D-P, ( member(D-P, DPs), \+ memberchk(D, PKs) ), Specs),
    findall(P, member(_-some(P), Specs), GPs0), list_to_set(GPs0, GPs),
    % T27 c8: a project KB with its own questions to ask has its section, first in its group.
    findall(L-group(L, some(P), Ds),
            ( member(P, GPs), serve_project_label(P, L),
              findall(D, member(D-some(P), Specs), Ds1),
              ( serve_has_to_ask(P) -> Ds = [P|Ds1] ; Ds = Ds1 ) ),
            LGs0),
    keysort(LGs0, LGs), pairs_values(LGs, PGroups),
    findall(D, member(D-none, Specs), NDs),
    (   NDs == [] -> Groups = PGroups ; append(PGroups, [group("no project", none, NDs)], Groups) ).

serve_has_to_ask(Dir) :-
    catch(( lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng), eng_true(Eng, to_ask(_)) ), _, fail).

% serve_norm(+Path, -Norm) (T27 c9): an absolute path with no trailing slash.
serve_norm(P0, P) :-
    absolute_file_name(P0, P1),
    (   atom_concat(P2, '/', P1), P2 \== '' -> serve_norm(P2, P) ; P = P1 ).

serve_find_kbs(Root, Dirs) :-
    findall(D, serve_walk(Root, 0, D), Ds0), sort(Ds0, Dirs).

serve_walk(Dir, _, Dir) :- directory_file_path(Dir, 'kb.pl', F), exists_file(F).
serve_walk(Dir, Depth, Found) :-
    Depth < 8,
    catch(directory_files(Dir, Es), _, fail),
    member(E, Es), \+ sub_atom(E, 0, _, _, '.'), E \== runs,
    directory_file_path(Dir, E, Sub), exists_directory(Sub),
    D1 is Depth + 1,
    serve_walk(Sub, D1, Found).

serve_kb_items(Dir, Items) :-
    directory_file_path(Dir, 'kb.pl', F),
    catch(read_source_file(kb, F, Items), _, Items = []).

serve_kb_project(Dir, P) :-
    serve_kb_items(Dir, Items),
    (   kb_term(Items, project_kb(P0)), atom(P0)
    ->  project_kb_dir(Dir, P0, P1),
        serve_norm(P1, PA), P = some(PA)
    ;   P = none
    ).

serve_is_project_kb(Dir) :-
    serve_kb_items(Dir, Items),
    items_uses(Items, Us), memberchk(project, Us),
    \+ kb_term(Items, project_kb(_)),
    \+ kb_term(Items, claim(_, _, _)).

serve_project_label(P, Label) :-
    serve_kb_items(P, Items),
    (   kb_term(Items, request(_, RT)), txt(RT, RT2), split_string(RT2, "\n", " \t", [L1|_]), L1 \== ""
    ->  Label = L1
    ;   file_base_name(P, B), atom_string(B, Label)
    ).

serve_page(Msg, Page) :-
    serve_conf(token, Token), lib_dir(Lib),
    ( serve_conf(hubs, Hubs) -> true ; Hubs = [] ),
    desk_ctx_set(Hubs),
    serve_all_dirs(All),
    findall(HH, ( member(H, Hubs), include([D]>>desk_under(D, H), All, HDs), desk_hub_html(Token, Lib, H, HDs, HH) ), HHs),
    exclude([D]>>( member(H, Hubs), desk_under(D, H) ), All, ODs),
    serve_groups(ODs, Groups),
    findall(G, ( member(group(L, _, Ds), Groups), serve_group_html(Token, Lib, L, Ds, G) ), Gs),
    (   Gs == [], HHs == [] -> GsText = "<p class=\"message\">No KB was found.</p>" ; atomic_list_concat(Gs, '\n', GsText) ),
    atomic_list_concat(HHs, '\n', HubsText),
    serve_conf(ledger, LedOpt), serve_conf(owner, OwnOpt),
    (   LedOpt = some(LF)
    ->  catch(( view_ledger(LF, Rows), view_owner(OwnOpt, Rows, Owner), view_owned(Rows, Owner, Asks),
                view_ledger_section(serve(Token), some(Asks), LedText) ),
              E, ( serve_err_text(E, EM), esc(EM, EMH),
                   format(string(LedText), "<section class=\"ledger\"><h2>Questions for you</h2><p class=\"message error\">~w</p></section>", [EMH]) ))
    ;   LedText = ""
    ),
    view_css(Css), desk_js(Js), esc(Token, TokH),
    (   Msg == "" -> MsgH = "" ; esc(Msg, M0), format(string(MsgH), "<p class=\"message\">~w</p>", [M0]) ),
    format(string(Page),
"<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>The Desk</title>
<style>~w section.project{border-width:2px}form.answer{margin:.5em 0;padding:.4em;background:var(--bg)}form.answer label{display:block}</style>
</head>
<body data-token=\"~w\">
<h1>The Desk</h1>
<p class=\"serve-note\">Live: each reload reads the KBs and the ledgers again. What you send is stored at once and goes to the session that owns the item, at that session's next stop or prompt. Write freely: a draft stays here until you press Send.</p>
<p class=\"options-note\">The options of a question come from the KB's defaults (its default answer and an answer that an agent recorded) and from its option facts (each with what it changes). Other means an answer that is not listed. The page adds no option of its own.</p>
~w
~w
~w
~w
<script>~w</script>
</body>
</html>
", [Css, TokH, MsgH, HubsText, GsText, LedText, Js]).

serve_group_html(Token, Lib, Label, Dirs, Html) :-
    findall(S, ( member(D, Dirs), serve_kb_html(Token, Lib, D, S) ), Ss),
    atomic_list_concat(Ss, '\n', SsT),
    esc(Label, LH),
    ( sub_string(SsT, _, _, _, "<details class=\"kbfold\" open>") -> Op = " open" ; Op = "" ),
    format(string(Html), "<section class=\"project\">\n<details class=\"groupfold\"~w><summary><h2 class=\"projectlabel\">~w</h2></summary>\n~w\n</details>\n</section>", [Op, LH, SsT]).

serve_kb_html(Token, Lib, Dir, Html) :-
    catch(view_kb_section(serve(Token), Lib, Dir, Html), E,
          ( serve_err_text(E, M), esc(M, MH), esc(Dir, DH),
            format(string(Html), "<section class=\"kb error\">\n<h2><span class=\"kblabel\">~w</span></h2>\n<p class=\"message error\">~w</p>\n</section>", [DH, MH]) )).

serve_err_text(orbit_error(_, Lines), M) :- !, atomic_list_concat(Lines, ' ', M).
serve_err_text(E, M) :- err_text(E, M).

% serve_answer(+Form, -Result) (D26 S3, S4): ok, or refused(Status, Message). Nothing is
% written unless every check passes; the write is one `orbit-kb add` child process.
serve_answer(Form, R) :-
    (   serve_field(Form, intent, I0), memberchk(I0, ["answer", "diverge", "requirement"]) -> atom_string(Intent, I0)
    ;   Intent = answer
    ),
    (   serve_field(Form, ask, AskS), AskS \== ""
    ->  ( Intent == answer -> serve_answer_ask(AskS, Form, R) ; desk_ask_other(Intent, AskS, Form, R) )
    ;   serve_field(Form, action, ActS), ActS \== ""
    ->  desk_action_respond(Intent, ActS, Form, R)
    ;   Intent == answer -> serve_answer_kb(Form, R)
    ;   desk_kb_other(Intent, Form, R)
    ),
    (   R == ok, serve_field(Form, draft, Key), Key \== "", serve_field(Form, hub, HS), HS \== "",
        serve_form_hub(Form, Hub)
    ->  desk_cmd(Hub, [draft, Key, '--clear'], _, _)
    ;   true
    ).

serve_answer_kb(Form, R) :-
    serve_kbs(Groups),
    findall(D, ( member(group(_, _, Ds), Groups), member(D, Ds) ), Served),
    (   \+ ( serve_field(Form, kb, KS), atom_string(KA0, KS), serve_norm(KA0, KA), memberchk(KA, Served) )
    ->  R = refused(400, "The form names a KB that this server does not serve. Reload the page.")
    ;   serve_field(Form, kb, KS), atom_string(Dir0, KS), serve_norm(Dir0, Dir),
        (   \+ ( serve_field(Form, q, QS), QS \== "" )
        ->  R = refused(400, "The form names no question. Reload the page.")
        ;   serve_field(Form, q, QS), atom_string(Q, QS),
            lib_dir(Lib), load_kb(Dir, Lib, KB), answer_gate(KB), kb_engine(KB, Eng),
            (   \+ eng_true(Eng, to_ask(Q))
            ->  format(string(M), "The question ~w is not open any more. Reload the page.", [Q]),
                R = refused(409, M)
            ;   pending_for_question(Dir, Q)
            ->  format(string(M), "An answer to question ~w waits to be applied. Reload the page.", [Q]),
                R = refused(409, M)
            ;   serve_answer_text(Form, Text, Note),
                (   Text == ""
                ->  R = refused(400, "Choose an option, or choose other and write the answer.")
                ;   string_length(Text, Len), Len > 2000
                ->  R = refused(400, "The answer is longer than 2000 characters.")
                ;   string_length(Note, NLen), NLen > 2000
                ->  R = refused(400, "The text is longer than 2000 characters.")
                ;   serve_answer_term(Eng, Q, Text, A),
                    ( Note == "" -> NFs = [] ; atom_string(NA, Note), NFs = [note(Q, NA)] ),
                    ( serve_field(Form, choice, C1), C1 \== "", C1 \== "other" -> LC = Text, LT = Note ; LC = "", LT = Text ),
                    desk_kb_letter(Dir, answer, question, Q, LT, LC, Hub, L),
                    serve_owned(Eng, Q, Dir, A, Text, NFs, R0),
                    ( R0 == ok, pending_for_question(Dir, Q) -> R1 = queued ; R1 = R0 ),
                    desk_finish(Hub, L, R1, R)
                )
            )
        )
    ).

% serve_answer_text(+Form, -Text, -Note) (T27 c9): the picked option (or, with other or no
% option, the typed text) is the answer. Typed text next to a picked option is kept as a note.
serve_answer_text(Form, Text, Note) :-
    ( serve_field(Form, choice, C0) -> true ; C0 = "" ),
    ( serve_field(Form, text, T0) -> true ; T0 = "" ),
    split_string(C0, "", " \t\r\n", [C]), split_string(T0, "", " \t\r\n", [T]),
    (   C \== "", C \== "other" -> Text = C, Note = T ; Text = T, Note = "" ).

% serve_answer_term(+Eng, +Q, +Text, -A) (T27 c9): the default, or an answer of an agent, when
% Text is its text, as the same term (so accepting a default 3 is not a defeat); else an atom.
serve_answer_term(Eng, Q, Text, A) :-
    (   eng_all(Eng, [D], assumed(Q, D), Ds), member(D1, Ds), plain_text(D1, DT), DT == Text -> A = D1
    ;   eng_all(Eng, [B, By], answer(Q, B, By), Bs), member([B1, agent], Bs), plain_text(B1, BT), BT == Text -> A = B1
    ;   answer_text_term(Text, A)
    ).

% answer_text_term(+Text, -A) (T38 c12): a plain integer or decimal that prints back as the same
% text is that number (5, -2.5); any other text is an atom (007, 1e3, 0x1F, 1.50).
answer_text_term(Text0, A) :-
    atom_string(Text0, Text),
    (   re_match("^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"/'', Text),
        catch(number_string(N, Text), _, fail),
        format(string(Back), "~w", [N]), Back == Text
    ->  A = N
    ;   atom_string(A, Text)
    ).

% serve_owned(+Eng, +Q, +Dir, +A, +Text, +NoteFacts, -R) (T27 c5): the owner of the question
% gets the answer first. A question of the ledger: the ask is closed in the hub, then the pinned
% answer is queued for the spec KB. A question of the tracker is answered in the tracker. Any
% other question belongs to the spec KB (as before T27).
serve_owned(Eng, Q, Dir, A, Text, NFs, R) :-
    (   eng_all(Eng, [K, Ref], question_pin(Q, K, Ref, _, _), Pins), last(Pins, [Kind, Ref1])
    ->  (   Kind == tracker
        ->  format(string(M), "Question ~w is owned by the tracker item ~w: answer it there. Then the answer is pinned with orbit-kb pin-answer ~w ~w --text-file F --by NAME. Nothing was written.", [Q, Ref1, Q, Ref1]),
            R = refused(409, M)
        ;   serve_conf(hub, some(Hub))
        ->  hub_close(Hub, Ref1, Text, R0),
            (   R0 == ok
            ->  hub_asks(Hub, Owner, _), atom_string(OA, Owner),
                sha256_text(Text, D), utc_now(Now),
                append([answer(Q, A, human:OA), answer_pin(Q, Ref1, D, Now)], NFs, Facts),
                serve_write(Dir, Facts, R)
            ;   R = R0
            )
        ;   format(string(M), "Question ~w is owned by the ledger ask ~w. Start the server with --hub DIR to answer it here, or answer the ask in the hub. Nothing was written.", [Q, Ref1]),
            R = refused(409, M)
        )
    ;   serve_write(Dir, [answer(Q, A, human)|NFs], R)
    ).

% serve_answer_ask(+Id, +Form, -R) (T27 c7): an answer to a ledger ask that waits on the owner.
% hubflow closes the ask (as a human); each served spec KB whose question is pinned to the ask
% gets the pinned answer through its queue (c5).
serve_answer_ask(IdS, Form, R) :-
    (   serve_form_hub(Form, Hub)
    ->  hub_asks(Hub, Owner, Rows),
        (   \+ ( member(X, Rows), X.id == IdS, X.waits_on == Owner )
        ->  format(string(M), "The ask ~w does not wait on you now. Reload the page.", [IdS]),
            R = refused(409, M)
        ;   ( serve_field(Form, text, T0) -> true ; T0 = "" ),
            split_string(T0, "", " \t\r\n", [Text]),
            (   Text == "" -> R = refused(400, "Write the answer.")
            ;   string_length(Text, Len), Len > 2000 -> R = refused(400, "The answer is longer than 2000 characters.")
            ;   atom_string(Id, IdS),
                desk_send(Hub, answer, _{type:"ask", id:IdS}, Text, "", L),
                hub_close(Hub, Id, Text, R0),
                (   R0 == ok
                ->  atom_string(OA, Owner), sha256_text(Text, D), utc_now(Now),
                    serve_kbs(Groups),
                    forall(( member(group(_, _, Ds), Groups), member(Dir, Ds),
                             serve_kb_pins_ask(Dir, Id, Qs), member(Q, Qs) ),
                           ( serve_text_term(Dir, Q, Text, A),
                             serve_write(Dir, [answer(Q, A, human:OA), answer_pin(Q, Id, D, Now)], _) )),
                    R1 = ok
                ;   R1 = R0
                ),
                desk_finish(Hub, L, R1, R)
            )
        )
    ;   R = refused(400, "This server reads no hub. Start it with --hub DIR to answer asks.")
    ).

% serve_text_term(+Dir, +Q, +Text, -A) (T37 c5): the answer term of Q for Text: as serve_answer_term/4
% (the default, or an agent's answer, when Text is its text, so a number stays a number); else an atom.
serve_text_term(Dir, Q, Text, A) :-
    (   catch(( lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng), serve_answer_term(Eng, Q, Text, A0) ), _, fail)
    ->  A = A0
    ;   answer_text_term(Text, A)
    ).

serve_kb_pins_ask(Dir, Id, Qs) :-
    catch(( lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng),
            eng_all(Eng, [Q0], question_pin(Q0, ledger, Id, _, _), Q0s),
            findall(Q, ( member(Q, Q0s), \+ eng_true(Eng, answered(Q)) ), Qs0),
            sort(Qs0, Qs) ), _, Qs = []).

% serve_write(+Dir, +Facts, -R) (T27 c4, D26 S4 amended): the answer never waits on an agent. It
% goes at once to answers.pending. When no other writer holds the lock, the server applies it
% now (orbit-kb apply-pending as its writer) and gives a lock that was free back; else the
% holder, or the next writer, applies it with its next write.
serve_write(Dir, Facts, R) :-
    serve_conf(writer, W), serve_conf(script, Script),
    queue_pending(Dir, Facts),
    lock_state(Dir, LS),
    (   ( LS == none ; LS = held(W, _) )
    ->  serve_child(Script, W, ['--dir', Dir, 'apply-pending'], Exit, Err),
        ( LS == none -> serve_child(Script, W, ['--dir', Dir, release], _, _) ; true ),
        (   Exit == 0
        ->  R = ok
        ;   split_string(Err, "", " \n", [E1]),
            format(string(M), "Nothing was written. orbit-kb said: ~w", [E1]),
            R = refused(409, M)
        )
    ;   R = ok
    ).

serve_child(Script, W, Args, Exit, Err) :-
    process_create(Script, Args,
                   [ environment(['ORBIT_KB_WRITER'=W]), stdin(null),
                     stdout(null), stderr(pipe(E)), process(P) ]),
    read_string(E, _, Err), close(E),
    process_wait(P, St),
    ( St = exit(Exit) -> true ; Exit = 2 ).

% ---------------------------------------------------------------------
% The Desk (hub spec KB questions-server, 2026-11-17)
% ---------------------------------------------------------------------
% With --hub (it repeats), each hub is a section of the page: what waits on the human (Human
% action needed, Questions for you), its spec KBs, the responses sent from the page (letters)
% with where each one is, its sessions with their inboxes, and its orphaned items. The hub's
% .claude/scripts/desk.py keeps the letters, their receipts and the drafts (flow/desk/), and a
% hook of each session delivers a letter to the session that owns its item, at its next stop
% or prompt (c6). A response is stored as a letter before it is written anywhere else (c8).
% Without desk.py the page works as before, and says that no response is recorded.

% desk_ctx_set(+Hubs): the status of each hub's desk.py, read once per page.
desk_ctx_set(Hubs) :-
    findall(H-St, ( member(H, Hubs), desk_status(H, St) ), Ctx),
    nb_setval(desk_ctx, Ctx),
    nb_setval(desk_acts, []), nb_setval(desk_kbs, []).

desk_ctx(Ctx) :- ( nb_current(desk_ctx, C) -> Ctx = C ; Ctx = [] ).

% desk_hub_dir(+Dir, -Hub): the served hub that holds the KB directory Dir.
desk_hub_dir(Dir, Hub) :-
    serve_conf(hubs, Hs), member(Hub, Hs), desk_under(Dir, Hub), !.

% desk_hub_st(+Hub, -St): the desk status of a hub on this page (a dict), or error(Message).
desk_hub_st(Hub, St) :-
    (   desk_ctx(Ctx), memberchk(Hub-St0, Ctx) -> St = St0 ; desk_status(Hub, St) ).

desk_under(Dir, Hub) :- atom_concat(Hub, '/', HP), sub_atom(Dir, 0, _, _, HP).

desk_rel(Hub, Dir, Rel) :- atom_concat(Hub, '/', HP), atom_concat(HP, Rel, Dir).

% desk_slug(+Hub, +Dir, -Slug): the slug that kb: refs of the ledger use for the spec KB Dir.
desk_slug(Hub, Dir, Slug) :-
    desk_rel(Hub, Dir, Rel), atomic_list_concat(Ps, '/', Rel),
    (   Ps = [specs, S] -> Slug = S
    ;   append(_, [S, kb], Ps) -> Slug = S
    ;   last(Ps, Slug)
    ).

desk_anchor(Dir, A) :-
    (   desk_hub_dir(Dir, Hub), desk_slug(Hub, Dir, S) -> true ; file_base_name(Dir, S) ),
    atom_codes(S, Cs), maplist([C, D]>>( code_type(C, alnum) -> D = C ; D = 0'- ), Cs, Ds),
    atom_codes(S2, Ds), atom_concat('kb-', S2, A).

desk_hub_label(Hub, Label) :-
    directory_file_path(Hub, 'CLAUDE.md', F),
    (   exists_file(F),
        catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]), read_line_to_string(S, L1), close(S)), _, fail),
        string(L1), sub_string(L1, B, _, A, "CLAUDE.md: "), B >= 0, A > 0,
        sub_string(L1, _, A, 0, Label0), split_string(Label0, "", " ", [Label]), Label \== ""
    ->  true
    ;   file_base_name(Hub, B0), atom_string(B0, Label)
    ).

% desk_py(+Hub, -Exe, -Py): python3 and the hub's desk.py, when both exist.
desk_py(Hub, Exe, Py) :-
    directory_file_path(Hub, '.claude/scripts/desk.py', Py), exists_file(Py),
    absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]).

% desk_cmd(+Hub, +Args, -Out, -R): run desk.py in the hub; R is ok or error(Message).
desk_cmd(Hub, Args, Out, R) :-
    (   desk_py(Hub, Exe, Py)
    ->  catch(( process_create(Exe, ['-I', Py, '--hub', Hub|Args],
                               [cwd(Hub), stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(P)]),
                set_stream(O, encoding(utf8)), set_stream(E, encoding(utf8)),
                read_string(O, _, Out), read_string(E, _, Err), close(O), close(E),
                process_wait(P, St) ), X, ( err_text(X, Err), St = exit(2), Out = "" )),
        (   St == exit(0) -> R = ok
        ;   split_string(Err, "\n", " \t\r", Ls), exclude(==(""), Ls, Ls1),
            ( Ls1 = [E1|_] -> true ; E1 = "desk.py failed" ), R = error(E1)
        )
    ;   Out = "", R = error("The hub has no .claude/scripts/desk.py (or python3 is missing)")
    ).

% desk_status(+Hub, -St): sessions, inboxes, orphans, kb refs, answered asks, letters and drafts.
desk_status(Hub, St) :-
    use_module(library(http/json)),          % atom_json_dict/3: the first page of a run may come before hub_read
    desk_cmd(Hub, [status, '--json'], Out, R),
    (   R == ok, catch(atom_json_dict(Out, St0, []), _, fail) -> St = St0
    ;   R = error(M) -> St = error(M)
    ;   St = error("desk.py status printed no JSON")
    ).

% q10: drafts live in the Desk's own store ($DESK_STATE), outside every mindhole (desk.py drafts).
desk_draft(Hub, Key, Dr) :-
    (   desk_cmd(Hub, [drafts, '--json'], Out, ok), catch(atom_json_dict(Out, J, [value_string_as(string)]), _, fail),
        is_dict(J), ( get_dict(drafts, J, Ds) -> true ; Ds = J ), is_dict(Ds),
        atom_string(KA, Key), get_dict(KA, Ds, Dr0), is_dict(Dr0) -> Dr = Dr0
    ;   Dr = _{}
    ).

% desk_send(+Hub, +Kind, +Item, +Text, +Choice, -L): store a letter first (c8). L: ok(Lid),
% none (the hub has no desk.py), or error(Message).
desk_send(Hub, Kind, Item, Text, Choice, L) :-
    (   \+ desk_py(Hub, _, _) -> L = none
    ;   atom_json_dict(IJ, Item, [width(0)]),
        tmp_file_stream(utf8, TF, TS), write(TS, Text), close(TS),
        ( Choice == "" -> CA = [] ; CA = ['--choice', Choice] ),
        append([send, '--kind', Kind, '--item-json', IJ, '--text-file', TF], CA, Args),
        desk_cmd(Hub, Args, Out, R0),
        catch(delete_file(TF), _, true),
        (   R0 == ok, catch(atom_json_dict(Out, D, []), _, fail), get_dict(id, D, Lid) -> L = ok(Lid)
        ;   R0 = error(M) -> L = error(M)
        ;   L = error("desk.py send printed no letter id")
        )
    ).

% desk_kb_letter(+Dir, +Kind, +Type, +Ref, +Text, +Choice, -Hub, -L): the letter of a response
% about a KB question (Type question, Ref the question) or a KB action (Type kb, Ref its id).
desk_kb_letter(Dir, Kind, Type, Ref, Text, Choice, Hub, L) :-
    (   desk_hub_dir(Dir, Hub)
    ->  desk_slug(Hub, Dir, Slug), desk_rel(Hub, Dir, Rel),
        atom_string(Slug, SS), atom_string(Rel, RS), atom_string(Ref, RefS),
        (   Type == question -> Item = _{type:"question", slug:SS, kb:RS, q:RefS}
        ;   Item = _{type:"kb", slug:SS, kb:RS, ref:RefS}
        ),
        desk_send(Hub, Kind, Item, Text, Choice, L)
    ;   Hub = none, L = none
    ).

% desk_finish(+Hub, +L, +R0, -R): record where the letter is after its write. R0: ok, ok(Detail)
% (applied), queued (stored; the holder's next write applies it), or refused(Status, Message):
% the letter is kept (c8), and the page says that it is not applied.
desk_finish(_, none, R0, R) :- !, desk_plain(R0, R).
desk_finish(_, error(_), R0, R) :- !, desk_plain(R0, R).
desk_finish(Hub, ok(Lid), R0, R) :-
    (   R0 = ok(D) -> desk_cmd(Hub, [event, Lid, applied, '--detail', D], _, _), R = ok
    ;   R0 == ok -> desk_cmd(Hub, [event, Lid, applied], _, _), R = ok
    ;   R0 == queued -> R = ok
    ;   R0 = refused(S, M)
    ->  desk_cmd(Hub, [event, Lid, apply_failed, '--detail', M], _, _),
        format(string(M2), "Your response is stored as ~w, so it is not lost, but it is not applied: ~w", [Lid, M]),
        R = refused(S, M2)
    ;   R = R0
    ).
desk_plain(ok(_), ok) :- !.
desk_plain(queued, ok) :- !.
desk_plain(R, R).

% serve_form_hub(+Form, -Hub): the hub that a form names, else the first hub of the server.
serve_form_hub(Form, Hub) :-
    ( serve_conf(hubs, Hubs) -> true ; Hubs = [] ),
    (   serve_field(Form, hub, HS), HS \== ""
    ->  atom_string(H0, HS), serve_norm(H0, Hub), memberchk(Hub, Hubs)
    ;   Hubs = [Hub|_]
    ).

desk_form_text(Form, Text, R) :-
    ( serve_field(Form, text, T0) -> true ; T0 = "" ),
    split_string(T0, "", " \t\r\n", [Text]),
    (   Text == "" -> R = refused(400, "Write what you want to say.")
    ;   string_length(Text, Len), Len > 4000 -> R = refused(400, "The text is longer than 4000 characters.")
    ;   R = ok
    ).

% hub_run(+Hub, +Args, -Out, -R): run hubflow as the human (--session human --by human).
hub_run(Hub, Args, Out, R) :-
    directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf),
    (   absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]), exists_file(Hf)
    ->  catch(( process_create(Exe, [Hf, '--hub', Hub, '--session', human, '--by', human|Args],
                               [cwd(Hub), stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(P)]),
                set_stream(O, encoding(utf8)), set_stream(E, encoding(utf8)),
                read_string(O, _, Out0), read_string(E, _, Err), close(O), close(E), process_wait(P, St) ),
              X, ( err_text(X, Err), St = exit(2), Out0 = "" )),
        split_string(Out0, "", " \t\r\n", [Out]),
        (   St == exit(0) -> R = ok(Out)
        ;   split_string(Err, "", " \t\r\n", [E1]),
            format(string(M), "The ledger did not take it, and nothing was written there. hubflow said: ~w", [E1]),
            R = refused(409, M)
        )
    ;   Out = "", R = refused(409, "The hub has no .claude/scripts/hubflow.py (or python3 is missing).")
    ).

% desk_intake(+Hub, +Text, +From, -R): a new requirement goes to intake: a thread of the review
% session (c5), with the KB or the ask it came from. With no review session the thread has no
% owner, so the Orphaned list shows it.
desk_intake(Hub, Text, From, R) :-
    desk_status(Hub, St),
    (   is_dict(St), member(S, St.sessions), S.name == "review", S.status == "active" -> Owner = review ; Owner = none ),
    (   sub_string(Text, 0, 100, _, T1) -> string_concat(T1, "...", T2) ; T2 = Text ),
    split_string(T2, "\n", " \t\r", Ws), atomic_list_concat(Ws, ' ', T3),
    format(string(Title), "Ty's new requirement: ~w", [T3]),
    ( From = kb(Slug) -> format(atom(RefA), "kb:~w", [Slug]), Refs = ['--ref', RefA] ; Refs = [] ),
    append([add, thread, '--title', Title, '--owner', Owner, '--note', Text], Refs, Args),
    hub_run(Hub, Args, Out, R0),
    (   R0 = ok(_)
    ->  ( From = ask(AskId) -> hub_run(Hub, [link, Out, AskId, relates, '--note', "From the Desk: a new requirement from this ask"], _, _) ; true ),
        (   Owner == none
        ->  format(string(D), "intake: ~w (no review session: it is orphaned until a session takes it)", [Out])
        ;   format(string(D), "intake: ~w, owned by ~w", [Out, Owner])
        ),
        R = ok(D)
    ;   R = R0
    ).

% desk_ask_other(+Intent, +Id, +Form, -R) (c5): a divergence on an ask is a note in Ty's words
% (the ask stays open); a new requirement goes to intake.
desk_ask_other(Intent, IdS, Form, R) :-
    (   \+ serve_form_hub(Form, _)
    ->  R = refused(400, "This server reads no hub. Start it with --hub DIR to answer asks.")
    ;   serve_form_hub(Form, Hub), hub_asks(Hub, _, Rows),
        desk_form_text(Form, Text, RT),
        (   \+ ( member(X, Rows), X.id == IdS )
        ->  format(string(M), "The ask ~w is not open now. Reload the page.", [IdS]), R = refused(409, M)
        ;   RT \== ok -> R = RT
        ;   desk_send(Hub, Intent, _{type:"ask", id:IdS}, Text, "", L),
            (   Intent == diverge
            ->  format(string(N), "Ty diverges (from the Desk): ~w", [Text]),
                hub_run(Hub, [note, IdS, N], _, R0)
            ;   desk_intake(Hub, Text, ask(IdS), R0)
            ),
            desk_finish(Hub, L, R0, R)
        )
    ).

% desk_kb_other(+Intent, +Form, -R) (c5): a divergence on a KB question is a human signal and a
% note on its claim, in Ty's words; the question stays open. A new requirement goes to intake.
desk_kb_other(Intent, Form, R) :-
    serve_kbs(Groups), findall(D, ( member(group(_, _, Ds), Groups), member(D, Ds) ), Served),
    (   \+ ( serve_field(Form, kb, KS), atom_string(KA0, KS), serve_norm(KA0, KA), memberchk(KA, Served) )
    ->  R = refused(400, "The form names a KB that this server does not serve. Reload the page.")
    ;   serve_field(Form, kb, KS), atom_string(Dir0, KS), serve_norm(Dir0, Dir),
        ( serve_field(Form, q, QS) -> true ; QS = "" ), atom_string(Q, QS),
        lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng),
        desk_form_text(Form, Text, RT),
        (   \+ eng_all(Eng, [C0], question(Q, C0, _), [_|_])
        ->  R = refused(400, "The form names no question of this KB. Reload the page.")
        ;   RT \== ok -> R = RT
        ;   eng_all(Eng, [C0], question(Q, C0, _), [C|_]),
            desk_respond_kb(Intent, Dir, question, Q, C, Text, R)
        )
    ).

% desk_respond_kb(+Intent, +Dir, +Type, +Ref, +Claim, +Text, -R): a response about a KB item.
desk_respond_kb(Intent, Dir, Type, Ref, C, Text, R) :-
    (   Intent == requirement, \+ desk_hub_dir(Dir, _)
    ->  R = refused(400, "A new requirement goes to intake in a hub; this KB is in no hub that this server reads.")
    ;   desk_kb_letter(Dir, Intent, Type, Ref, Text, "", Hub, L),
        (   Intent == diverge
        ->  desk_diverge_facts(Ref, C, Text, Facts, Sig),
            serve_write(Dir, Facts, R0),
            ( R0 == ok, desk_still_pending(Dir, Sig) -> R1 = queued ; R1 = R0 ),
            desk_finish(Hub, L, R1, R)
        ;   Intent == requirement
        ->  desk_slug(Hub, Dir, Slug), desk_intake(Hub, Text, kb(Slug), R0), desk_finish(Hub, L, R0, R)
        ;   % an answer to a KB action (a vote, a demo): the letter goes to the owning session, which acts on it
            desk_finish(Hub, L, queued, R)
        )
    ).

desk_diverge_facts(Ref, C, Text, Facts, Sig) :-
    utc_now(Now), get_time(F), I is floor(F), N is random(65536),
    format(atom(Sig), "sd~w~16r", [I, N]),
    format(atom(T), "Ty, from the Desk, ~w, on ~w: ~w", [Now, Ref, Text]),
    (   C == none -> Facts = [signal(Sig, divergence, human, T)]
    ;   Facts = [signal(Sig, divergence, human, T), note(C, T)]
    ).

desk_still_pending(Dir, Sig) :-
    pending_open(Dir, Ps), member(pending(_, _, Fs), Ps), member(signal(S, _, _, _), Fs), S == Sig, !.

% desk_action_respond(+Intent, +Ref, +Form, -R): a response on a KB action card (vote, demo, waiver).
desk_action_respond(Intent, RefS, Form, R) :-
    serve_kbs(Groups), findall(D, ( member(group(_, _, Ds), Groups), member(D, Ds) ), Served),
    desk_form_text(Form, Text, RT),
    (   \+ ( serve_field(Form, kb, KS), atom_string(KA0, KS), serve_norm(KA0, KA), memberchk(KA, Served) )
    ->  R = refused(400, "The form names a KB that this server does not serve. Reload the page.")
    ;   RT \== ok -> R = RT
    ;   serve_field(Form, kb, KS), atom_string(Dir0, KS), serve_norm(Dir0, Dir),
        lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng),
        desk_action_claim(Eng, RefS, C),
        atom_string(Ref, RefS),
        desk_respond_kb(Intent, Dir, kb, Ref, C, Text, R)
    ).

desk_action_claim(Eng, RefS, C) :-
    (   split_string(RefS, ":", "", ["flare", CS]) -> atom_string(C, CS)
    ;   catch(eng_all(Eng, [H], ( hypothesis(H, _, _), \+ supersedes(_, H) ), [C|_]), _, fail) -> true
    ;   C = none
    ).

% desk_save_draft(+Form, -R) (q2): a draft stays on the server until Send; it reaches no session.
desk_save_draft(Form, R) :-
    (   \+ ( serve_field(Form, hub, HS), HS \== "", serve_form_hub(Form, _) )
    ->  R = refused(400, "The draft names no hub that this server reads. Reload the page.")
    ;   \+ ( serve_field(Form, key, K), K \== "" )
    ->  R = refused(400, "The draft has no key. Reload the page.")
    ;   serve_form_hub(Form, Hub), serve_field(Form, key, Key),
        ( serve_field(Form, text, T) -> true ; T = "" ),
        ( serve_field(Form, choice, C) -> true ; C = "" ),
        ( serve_field(Form, intent, I) -> true ; I = "answer" ),
        tmp_file_stream(utf8, TF, TS), write(TS, T), close(TS),
        desk_cmd(Hub, [draft, Key, '--text-file', TF, '--choice', C, '--intent', I], _, R0),
        catch(delete_file(TF), _, true),
        (   R0 == ok -> R = ok
        ;   R0 = error(M), format(string(M2), "The draft was not saved: ~w", [M]), R = refused(409, M2)
        )
    ).

% ---- rendering

% desk_form_html(+Token, +Hub, +Key, +Target, +Choices, +Intents, -Html): the response form of a
% card (c5): its options, the intent (answer, diverge, new requirement), a free text, and Send.
% The text is a draft (saved on the server as Ty types, q2) until Send.
desk_form_html(Token, Hub, Key, Target, Choices, _, Html) :-
    esc(Token, TokH), esc(Key, KeyH),
    findall(F, ( member(N-V, Target), esc(V, VH), format(string(F), "<input type=\"hidden\" name=\"~w\" value=\"~w\">", [N, VH]) ), Fs),
    atomic_list_concat(Fs, '', TargetH),
    (   Hub \== none, desk_py(Hub, _, _)
    ->  esc(Hub, HubH), Desk = "1", desk_draft(Hub, Key, Dr),
        format(string(HubF), "<input type=\"hidden\" name=\"hub\" value=\"~w\"><input type=\"hidden\" name=\"draft\" value=\"~w\">", [HubH, KeyH]),
        Ints = [answer-"Answer", diverge-"That is not what I meant (diverge: the item stays open)", requirement-"New requirement (goes to intake)"]
    ;   HubH = "", Desk = "0", Dr = _{}, HubF = "",
        Ints = [answer-"Answer", diverge-"That is not what I meant (diverge: the item stays open)"]
    ),
    ( get_dict(intent, Dr, DI), string(DI) -> true ; DI = "answer" ),
    ( get_dict(text, Dr, DT), string(DT) -> true ; DT = "" ),
    findall(I, ( member(V-Lb, Ints), atom_string(V, VS), ( VS == DI -> Ck = " checked" ; Ck = "" ),
                 format(string(I), "<label><input type=\"radio\" name=\"intent\" value=\"~w\"~w> ~w</label>", [V, Ck, Lb]) ), Is),
    atomic_list_concat(Is, '\n', IsH),
    esc(DT, DTH),
    (   get_dict(at, Dr, DA), string(DA) -> esc(DA, DAH), format(string(DS), "Draft saved ~w", [DAH]) ; DS = "" ),
    format(string(Html),
"<form class=\"answer respond\" method=\"post\" action=\"/answer\" data-draft-key=\"~w\" data-desk=\"~w\" data-hub=\"~w\">
<input type=\"hidden\" name=\"token\" value=\"~w\">~w~w
~w
<fieldset class=\"intent\"><legend>Send as</legend>
~w
</fieldset>
<label>Your words (with other, a divergence or a requirement): <textarea name=\"text\" rows=\"3\">~w</textarea></label>
<button type=\"submit\">Send</button> <span class=\"draftstate\">~w</span>
</form>", [KeyH, Desk, HubH, TokH, TargetH, HubF, Choices, IsH, DTH, DS]).

% desk_owners(+Hub, +Item, -Owners, -Live): the sessions that hold an item, and the live ones.
% Item: ask(Id) (its owner session) or kb(Slug) (the owners of open ledger items with kb:Slug).
desk_owners(Hub, Item, Owners, Live) :-
    desk_hub_st(Hub, St),
    (   is_dict(St)
    ->  findall(N, ( member(S, St.sessions), S.status == "active", atom_string(N, S.name) ), Act),
        (   Item = ask(Id) -> ( desk_ask_owner(Hub, Id, O) -> Owners = [O] ; Owners = [] )
        ;   Item = kb(Slug), get_dict(Slug, St.kb_refs, Rs)
        ->  findall(O, ( member(X, Rs), get_dict(owner_session, X, O0), string(O0), atom_string(O, O0) ), Os0), sort(Os0, Owners)
        ;   Owners = []
        ),
        include([O]>>memberchk(O, Act), Owners, Live)
    ;   Owners = unknown, Live = unknown
    ).

desk_ask_owner(Hub, Id, O) :-
    catch(hub_asks(Hub, _, Rows), _, fail),
    atom_string(Id, IdS), member(X, Rows), X.id == IdS, string(X.owner_session), atom_string(O, X.owner_session), !.

% desk_holders_html(+Owners, +Live, -Html) (c7): who holds the item; loud when no live session does.
desk_holders_html(unknown, _, "<p class=\"holders muted\">The Desk cannot tell which session holds this item (the hub has no desk.py).</p>") :- !.
desk_holders_html(_, [], "<p class=\"holders loud\">No live session holds this item: a response is stored, but no session will be told until one takes the item.</p>") :- !.
desk_holders_html(Owners, Live, Html) :-
    findall(T, ( member(O, Owners), ( memberchk(O, Live) -> format(string(T), "~w", [O]) ; format(string(T), "~w (retired)", [O]) ) ), Ts),
    atomic_list_concat(Ts, ', ', TT), esc(TT, TH),
    format(string(Html), "<p class=\"holders\">Held by: ~w. A response goes to it at its next stop or prompt.</p>", [TH]).

% desk_ask_context(+Hub, +Ask, -Html) (c4): who holds the ask, its notes (the case, the options
% and the default, as the asker wrote them), its refs and links; and what is missing.
desk_ask_context(Hub, X, Html) :-
    atom_string(Id, X.id), desk_owners(Hub, ask(Id), Os, Lv), desk_holders_html(Os, Lv, HoH),
    ( get_dict(notes, X, Ns), is_list(Ns) -> true ; Ns = [] ),
    findall(P, ( member(N, Ns), esc(N.note, NH), esc(N.by_session, BH), esc(N.at, AH),
                 format(string(P), "<li class=\"asknote\">~w <span class=\"by\">(~w, ~w)</span></li>", [NH, BH, AH]) ), Ps),
    (   Ps == []
    ->  NotesH = "<p class=\"missing\">Missing context: only the title of this ask is recorded. No case, options or default; ask the session that holds it to add a note.</p>"
    ;   atomic_list_concat(Ps, '\n', PsT), format(string(NotesH), "<ul class=\"asknotes\">\n~w\n</ul>", [PsT])
    ),
    ( get_dict(refs, X, Rs), is_list(Rs), Rs \== [] -> atomic_list_concat(Rs, ' ', RsT), esc(RsT, RsH), format(string(RefH), "<p class=\"refs\">Refs: ~w</p>", [RsH]) ; RefH = "" ),
    (   get_dict(links, X, Lk), is_list(Lk), Lk \== []
    ->  findall(T, ( member(K, Lk), format(string(T), "~w ~w ~w", [K.src, K.kind, K.dst]) ), Ts),
        atomic_list_concat(Ts, '; ', TsT), esc(TsT, TsH), format(string(LinkH), "<p class=\"links\">What waits on it: ~w</p>", [TsH])
    ;   LinkH = ""
    ),
    ( get_dict(status, X, Sx) -> esc(Sx, SxH) ; SxH = "open" ),
    format(string(Html), "<div class=\"context\">~w<p class=\"stands\">Where it stands: ~w, ~w days old.</p>~w~w~w</div>", [HoH, SxH, X.age_days, NotesH, RefH, LinkH]).

% desk_question_extras(+Dir, +Eng, +Q, +Def, +Options, -Html) (c4): why the question is asked
% now, what waits on it, who holds it (c7), what context is missing, and its letters.
desk_question_extras(Dir, Eng, Q, Def, OFs, Html) :-
    ( catch(eng_all(Eng, [F], raised_by(Q, F), Fs0), _, fail) -> true ; Fs0 = [] ), sort(Fs0, Fs),
    findall(P, ( member(F, Fs), desk_finding_text(Eng, F, FT), esc(FT, FH), esc(F, FIH),
                 format(string(P), "<p class=\"why\">Why now: ~w (finding ~w).</p>", [FH, FIH]) ), Ws),
    atomic_list_concat(Ws, '', WhyH),
    (   eng_all(Eng, [C0], question(Q, C0, _), [C|_]) -> true ; C = none ),
    (   desk_hub_dir(Dir, Hub)
    ->  desk_slug(Hub, Dir, Slug), desk_owners(Hub, kb(Slug), Os, Lv), desk_holders_html(Os, Lv, HoH),
        desk_hub_st(Hub, St),
        (   is_dict(St), get_dict(Slug, St.kb_refs, Rs)
        ->  findall(T, ( member(X, Rs), format(string(T), "~w ~w (~w)", [X.id, X.title, X.owner_session]) ), Ts)
        ;   Ts = []
        ),
        desk_item_letters(Hub, question(Slug, Q), LetH)
    ;   HoH = "", Ts = [], LetH = ""
    ),
    format(string(T0), "the answer unblocks done of this KB, and claim ~w", [C]),
    atomic_list_concat([T0|Ts], '; ', WT), esc(WT, WTH),
    format(string(WaitH), "<p class=\"waits\">What waits on it: ~w.</p>", [WTH]),
    findall(M, desk_missing(Eng, Q, C, Def, OFs, Fs, M), Ms),
    (   Ms == [] -> MissH = ""
    ;   atomic_list_concat(Ms, '; ', MT), esc(MT, MTH),
        format(string(MissH), "<p class=\"missing\">Missing context: ~w. Ask the session that holds this KB to record it.</p>", [MTH])
    ),
    format(string(Html), "<div class=\"context desk\">~w~w~w~w~w</div>", [WhyH, WaitH, HoH, MissH, LetH]).

desk_missing(Eng, _, C, _, _, _, "no concrete case (no example on its claim)") :- \+ eng_all(Eng, [E], example(C, E), [_|_]).
desk_missing(_, _, _, none, _, _, "no default").
desk_missing(_, _, _, _, OFs, _, "fewer than two options with what each changes") :- length(OFs, N), N < 2.
desk_missing(_, _, _, _, _, [], "no finding says why it is asked now (raised_by)").

desk_finding_text(Eng, F, T) :-
    (   catch(eng_all(Eng, [X], finding(F, X, _), [X1|_]), _, fail)
    ->  ( compound(X1), X1 =.. [_, A] -> plain_text(A, T) ; plain_text(X1, T) )
    ;   T = "(the finding has no text)"
    ).

% desk_item_letters(+Hub, +Item, -Html) (c7): the letters about one item, each with where it is.
desk_item_letters(Hub, Item, Html) :-
    desk_hub_st(Hub, St),
    (   is_dict(St)
    ->  findall(L, ( member(L, St.letters), desk_letter_is(L, Item) ), Ls),
        findall(H, ( member(L, Ls), desk_letter_html(Hub, L, false, H) ), Hs)
    ;   Hs = []
    ),
    (   Hs == [] -> Html = ""
    ;   atomic_list_concat(Hs, '\n', HT), format(string(Html), "<ul class=\"letters\">\n~w\n</ul>", [HT])
    ).

desk_letter_is(L, ask(Id)) :- L.item.type == "ask", atom_string(Id, L.item.id).
desk_letter_is(L, question(Slug, Q)) :- L.item.type == "question", atom_string(Slug, L.item.slug), atom_string(Q, L.item.q).
desk_letter_is(L, kb(Slug, Ref)) :- L.item.type == "kb", atom_string(Slug, L.item.slug), atom_string(Ref, L.item.ref).

desk_letter_name(L, N) :-
    I = L.item,
    (   I.type == "ask" -> format(string(N), "~w", [I.id])
    ;   I.type == "question" -> format(string(N), "~w ~w", [I.kb, I.q])
    ;   format(string(N), "~w ~w", [I.kb, I.ref])
    ).

desk_kind_label("answer", "Answer").
desk_kind_label("diverge", "Divergence").
desk_kind_label("requirement", "New requirement").

% desk_letter_html(+Hub, +L, +Named, -Html) (c7): sent, seen by each session, woken, applied or
% not; loud when no live session holds the item.
desk_letter_html(Hub, L, Named, Html) :-
    ( desk_kind_label(L.kind, KL) -> true ; KL = L.kind ),
    ( Named == true -> desk_letter_name(L, N0), esc(N0, NH), format(string(NameH), "<span class=\"lname\">~w</span> ", [NH]) ; NameH = "" ),
    ( string(L.choice), L.choice \== "" -> format(string(T0), "~w: ~w", [L.choice, L.text]) ; T0 = L.text ),
    ( sub_string(T0, 0, 300, _, T1) -> string_concat(T1, "...", T2) ; T2 = T0 ),
    esc(T2, TH), esc(L.id, IdH), esc(L.at, AtH),
    format(string(Sent), "<span class=\"chip sent\">Sent ~w</span>", [AtH]),
    findall(C, ( member(S, L.seen), esc(S.session, SH), esc(S.at, SA), format(string(C), "<span class=\"chip seen\">Seen by ~w ~w</span>", [SH, SA]) ), Seen),
    findall(C, ( member(S, L.woken), esc(S.session, SH), format(string(C), "<span class=\"chip woken\">Woke ~w</span>", [SH]) ), Woken),
    desk_letter_outcome(Hub, L, OutH),
    (   L.no_live_owner == true
    ->  Loud = "<span class=\"loud\">No live session holds this item: no session will be told until one takes it.</span>"
    ;   Loud = ""
    ),
    append([[Sent], Seen, Woken, [OutH, Loud]], Parts), atomic_list_concat(Parts, ' ', PartsH),
    format(string(Html), "<li class=\"letter\" data-letter=\"~w\">~w<span class=\"lkind\">~w</span> &#8220;~w&#8221; ~w</li>", [IdH, NameH, KL, TH, PartsH]).

desk_letter_outcome(Hub, L, H) :-
    (   is_dict(L.applied) -> desk_detail(L.applied, D), format(string(H), "<span class=\"chip applied\">Applied~w</span>", [D])
    ;   L.item.type == "ask", L.item_closed == true -> H = "<span class=\"chip applied\">Answered: the ask is closed</span>"
    ;   L.item.type == "question", desk_letter_kb(Hub, L, Dir, Q), desk_kb_answered(Dir, Q) -> H = "<span class=\"chip applied\">Applied: the KB holds the answer</span>"
    ;   L.item.type == "question", desk_letter_kb(Hub, L, Dir, Q), pending_for_question(Dir, Q) -> H = "<span class=\"chip queued\">Queued: the next write of the KB's holder applies it</span>"
    ;   is_dict(L.apply_failed) -> desk_detail(L.apply_failed, D), format(string(H), "<span class=\"chip failed loud\">Not applied~w</span>", [D])
    ;   H = ""
    ).

desk_detail(E, D) :- ( get_dict(detail, E, X), string(X), X \== "" -> esc(X, XH), format(string(D), ": ~w", [XH]) ; D = "" ).

desk_letter_kb(Hub, L, Dir, Q) :-
    atom_string(Rel, L.item.kb), directory_file_path(Hub, Rel, Dir0), serve_norm(Dir0, Dir),
    atom_string(Q, L.item.q).

desk_kb_answered(Dir, Q) :-
    catch(( lib_dir(Lib), load_kb(Dir, Lib, KB), kb_engine(KB, Eng), eng_true(Eng, answered(Q)) ), _, fail).

% desk_kb_where(+Dir, +Eng, +Blocking, -Html) (c4): where the work of a KB stands.
desk_kb_where(Dir, Eng, Xs, Html) :-
    (   catch(eng_all(Eng, [T], ( hypothesis(H, _, T), \+ supersedes(_, H) ), [T1|_]), _, fail) -> txt(T1, HT) ; HT = "(no hypothesis is recorded)" ),
    (   catch(eng_true(Eng, done), _, fail) -> Ph = "done"
    ;   catch(eng_true(Eng, discovery_closed), _, fail) -> Ph = "build (discovery closed)"
    ;   catch(eng_true(Eng, discovery_open), _, fail) -> Ph = "discovery"
    ;   Ph = "build"
    ),
    length(Xs, NX),
    (   eng_all(Eng, [K, N, Rz, Tm], attest(_, test_result, _, result(K, N, Rz), _, Tm), Runs), Runs \== []
    ->  msort(Runs, Rs1), last(Rs1, [K1, N1, R1, T1r]), format(string(RunH), "run ~w of ~w: ~w (~w)", [N1, K1, R1, T1r])
    ;   RunH = "no check has run"
    ),
    directory_file_path(Dir, 'kb.pl', KF),
    (   catch(time_file(KF, MT), _, fail) -> stamp_date_time(MT, DT, local), format_time(string(MTS), '%Y-%m-%d %H:%M', DT) ; MTS = "?" ),
    (   desk_hub_dir(Dir, Hub)
    ->  desk_slug(Hub, Dir, Slug), desk_owners(Hub, kb(Slug), Os, Lv),
        (   Os == unknown -> HoldT = "unknown (no desk.py)"
        ;   Os == [] -> HoldT = "no session (no open ledger item points to this KB)"
        ;   findall(S, ( member(O, Os), ( memberchk(O, Lv) -> S = O ; format(atom(S), "~w (retired)", [O]) ) ), Ss), atomic_list_concat(Ss, ', ', HoldT)
        )
    ;   HoldT = "not known (the KB is in no hub that this server reads)"
    ),
    maplist(esc, [HT, Ph, HoldT, RunH, MTS], [HTH, PhH, HoH, RunHH, MTH]),
    format(string(Html), "<div class=\"where\"><p><strong>Where the work stands:</strong> ~w</p><p class=\"stands\">Phase: ~w. Held by: ~w. Open items: ~w. Last check: ~w. Last change: ~w.</p></div>\n",
           [HTH, PhH, HoH, NX, RunHH, MTH]).

% desk_kb_actions(+Mode, +Dir, +Eng, +Label, -Html, -Has) (c3, q3): the actions that only the
% human may take in this KB by a standing rule: the vote at the end of discovery, the approval of
% a demo, and a lapsed waiver. Each is a card with its context and a response form.
desk_kb_actions(Mode, Dir, Eng, Label, Html, Has) :-
    findall(A, desk_kb_action(Eng, A), As),
    (   As == [] -> Html = "", Has = false
    ;   Has = true,
        findall(C, ( member(A, As), desk_action_card(Mode, Dir, Eng, A, C) ), Cs),
        atomic_list_concat(Cs, '\n', CsT),
        format(string(Html), "<h3>Human action needed</h3>\n<ul class=\"kbactions\">\n~w\n</ul>\n", [CsT]),
        desk_anchor(Dir, Anchor), esc(Label, LH),
        forall(member(A, As),
               ( desk_action_summary(A, S), esc(S, SH),
                 format(string(Li), "<li class=\"kbref\"><a href=\"#~w\">~w</a>: ~w</li>", [Anchor, LH, SH]),
                 ( nb_current(desk_acts, A0) -> nb_setval(desk_acts, [Li|A0]) ; true ) ))
    ).

desk_kb_action(Eng, vote) :-
    catch(eng_true(Eng, ( discovery_open, discovery_ready, \+ human_vote(_) )), _, fail).
desk_kb_action(Eng, demo(C, S, P)) :-
    catch(eng_all(Eng, [C, S, P], ( flare_open(C), demo(S, C), subject(S, P, _) ), L), _, fail),
    member([C, S, P], L).
desk_kb_action(Eng, waiver(W)) :-
    catch(eng_all(Eng, [W], blocking(waiver_lapsed(W)), L), _, fail), sort(L, L1), member(W, L1).

desk_action_ref(vote, "vote").
desk_action_ref(demo(C, _, _), R) :- format(string(R), "flare:~w", [C]).
desk_action_ref(waiver(W), R) :- format(string(R), "waiver:~w", [W]).

desk_action_summary(vote, "Vote GO, NO-GO or HOLD: discovery is ready").
desk_action_summary(demo(C, _, P), S) :- format(string(S), "Approve the demo ~w of claim ~w", [P, C]).
desk_action_summary(waiver(W), S) :- format(string(S), "The waiver ~w lapsed: renew it with a due date, or let the work come back", [W]).

desk_action_card(Mode, Dir, Eng, A, Html) :-
    desk_action_ref(A, Ref), desk_action_summary(A, Sum), esc(Sum, SumH), esc(Ref, RefH),
    (   A == vote
    ->  ( catch(eng_all(Eng, [T], ( hypothesis(H, _, T), \+ supersedes(_, H) ), [T1|_]), _, fail) -> txt(T1, HT) ; HT = "(no hypothesis)" ),
        esc(HT, HTH),
        format(string(Ctx), "<p class=\"case\">The hypothesis: ~w</p><p class=\"why\">Why now: discovery is ready, and only you vote (a standing rule of the prompt). The agent's vote stays sealed until you vote.</p><p class=\"options\">Options: GO (build the claims), NO-GO (drop the ticket), HOLD (say what it waits for).</p>", [HTH])
    ;   A = demo(C, S, P)
    ->  ( eng_all(Eng, [CT], claim(C, _, CT), [CT1|_]) -> txt(CT1, CTT) ; CTT = "" ),
        maplist(esc, [CTT, P, S], [CTH, PH, SH]),
        format(string(Ctx), "<p class=\"case\">Claim ~w: ~w</p><p class=\"why\">Why now: the claim is visual, so only your approval of a demo fulfills it (a standing rule of the prompt). The demo is <code>~w</code> in the KB folder.</p><p class=\"options\">Options: approve it (<code>orbit-kb attest approval ~w 'digest(current)' --by human</code>), or diverge and say what is wrong.</p>", [C, CTH, PH, SH])
    ;   A = waiver(W),
        ( eng_all(Eng, [X, Rz], attest(W, waiver, _, waive(X, _, Rz), _, _), [[X1, R1]|_]) -> plain_text(X1, XT), plain_text(R1, RT) ; XT = "?", RT = "" ),
        maplist(esc, [XT, RT], [XH, RH]),
        format(string(Ctx), "<p class=\"case\">The waiver ~w of ~w lapsed (~w).</p><p class=\"why\">Why now: only you waive (a standing rule of the prompt), and its due time has passed, so the work blocks again.</p><p class=\"options\">Options: renew the waiver with a new due date, or let the work come back.</p>", [W, XH, RH])
    ),
    (   desk_hub_dir(Dir, Hub)
    ->  desk_slug(Hub, Dir, Slug), desk_owners(Hub, kb(Slug), Os, Lv), desk_holders_html(Os, Lv, HoH),
        atom_string(RefA, Ref), desk_item_letters(Hub, kb(Slug, RefA), LetH),
        (   Mode = serve(Token), desk_py(Hub, _, _)
        ->  desk_rel(Hub, Dir, Rel), format(string(Key), "kb:~w#~w", [Rel, Ref]),
            desk_form_html(Token, Hub, Key, [kb-Dir, action-Ref], "", true, FormH)
        ;   FormH = ""
        )
    ;   HoH = "", LetH = "", FormH = ""
    ),
    format(string(Html), "<li class=\"kbaction\" data-id=\"~w\"><p class=\"title\">~w</p>\n<div class=\"context\">~w~w</div>~w~w</li>", [RefH, SumH, Ctx, HoH, LetH, FormH]).

% desk_note_kb(+Dir, +Label, +Blocking): remember each KB of the hub for the Orphaned list.
desk_note_kb(Dir, Label, Xs) :-
    (   nb_current(desk_kbs, K0)
    ->  ( Xs == [] -> B = false ; B = true ), nb_setval(desk_kbs, [kb(Dir, Label, B)|K0])
    ;   true
    ).

% desk_hub_html(+Token, +Lib, +Hub, +Dirs, -Html): the section of one hub.
desk_hub_html(Token, Lib, Hub, Dirs, Html) :-
    desk_hub_st(Hub, St),
    nb_setval(desk_acts, []), nb_setval(desk_kbs, []),
    serve_groups(Dirs, Groups),
    findall(G, ( member(group(L, _, Ds), Groups), serve_group_html(Token, Lib, L, Ds, G) ), Gs),
    atomic_list_concat(Gs, '\n', GsT),
    nb_getval(desk_acts, Acts0), reverse(Acts0, Acts),
    nb_getval(desk_kbs, KBs0), reverse(KBs0, KBs),
    catch(( hub_asks(Hub, HOwner, HRows), view_owned(HRows, HOwner, HAsks),
            view_ledger_section(serve_hub(Token, Hub), some(HAsks), Acts, St, LedT) ),
          E, ( serve_err_text(E, EM), esc(EM, EMH),
               format(string(LedT), "<section class=\"ledger\"><h2>Questions for you</h2><p class=\"message error\">~w</p></section>", [EMH]) )),
    desk_letters_html(Hub, St, LetT, LetOpen),
    desk_sessions_html(St, SesT),
    desk_orphans_html(Hub, St, Groups, KBs, OrphT, NOrph),
    desk_hub_label(Hub, Label), esc(Label, LH), esc(Hub, HH),
    (   St = error(DM)
    ->  esc(DM, DMH),
        format(string(Warn), "<p class=\"message error loud\">This hub has no working desk.py, so the page records no response as a letter, delivers nothing to a session, and shows no sessions and no orphans: ~w</p>", [DMH])
    ;   Warn = ""
    ),
    (   ( sub_string(LedT, _, _, _, "<details open>") ; sub_string(GsT, _, _, _, " open>") ; LetOpen == true ) -> Op = " open" ; Op = "" ),
    format(string(Html), "<section class=\"hub\" data-hub=\"~w\">\n<details class=\"hubfold\"~w><summary><h2 class=\"hublabel\">~w</h2> <span class=\"hubpath\">~w</span> <span class=\"counts\">~w orphaned</span></summary>\n~w\n~w\n~w\n~w\n~w\n~w\n</details>\n</section>",
           [HH, Op, LH, HH, NOrph, Warn, LedT, GsT, LetT, SesT, OrphT]).

% desk_closed_html(+St, -Html) (c9): the asks answered in the last 7 days, and where.
desk_closed_html(St, Html) :-
    (   is_dict(St), get_dict(closed_recent, St, Cs), Cs \== []
    ->  findall(L, ( member(C, Cs),
                     (   C.by_session == "human" -> W = "on the Desk" ; format(string(W), "in the session ~w", [C.by_session]) ),
                     ( string(C.note) -> N = C.note ; N = "" ),
                     maplist(esc, [C.id, C.title, W, C.closed_at, N], [IH, TH, WH, AH, NH]),
                     format(string(L), "<li class=\"closedask\" data-closed=\"~w\">~w ~w: answered ~w, ~w: &#8220;~w&#8221;</li>", [IH, IH, TH, WH, AH, NH]) ), Ls),
        atomic_list_concat(Ls, '\n', LT),
        format(string(Html), "\n<h3>Answered in the last 7 days</h3>\n<ul class=\"closedasks\">\n~w\n</ul>", [LT])
    ;   Html = ""
    ).

% desk_letters_html(+Hub, +St, -Html, -Open) (c7): every response sent from the page, newest
% first, with where it is. Open on load when one is not applied or no live session holds it.
desk_letters_html(_, St, "", false) :- \+ is_dict(St), !.
desk_letters_html(Hub, St, Html, Open) :-
    Ls = St.letters,
    (   Ls == [] -> Body = "<p>No response has been sent from this page.</p>", Open = false
    ;   length(Ls, N), ( N > 50 -> length(L50, 50), append(L50, _, Ls) ; L50 = Ls ),
        findall(H, ( member(L, L50), desk_letter_html(Hub, L, true, H) ), Hs),
        atomic_list_concat(Hs, '\n', HT), format(string(Body), "<ul class=\"letters\">\n~w\n</ul>", [HT]),
        (   member(L, Ls), ( L.no_live_owner == true ; ( is_dict(L.apply_failed), \+ is_dict(L.applied) ) ) -> Open = true ; Open = false )
    ),
    ( Open == true -> Op = " open" ; Op = "" ),
    format(string(Html), "<section class=\"responses\">\n<details~w><summary><h2>Responses</h2></summary>\n~w\n</details>\n</section>", [Op, Body]).

% desk_sessions_html(+St, -Html) (c11): each session of the hub with what is in its inbox.
desk_sessions_html(St, "") :- \+ is_dict(St), !.
desk_sessions_html(St, Html) :-
    findall(L, ( member(S, St.sessions), desk_session_li(S, L) ), Ls),
    atomic_list_concat(Ls, '\n', LT),
    length(St.sessions, N),
    format(string(Html), "<section class=\"sessions\">\n<details><summary><h2>Sessions</h2> <span class=\"counts\">~w</span></summary>\n<ul class=\"sessionlist\">\n~w\n</ul>\n</details>\n</section>", [N, LT]).

desk_session_li(S, L) :-
    (   string(S.state) -> format(string(StT), "~w since ~w", [S.state, S.state_at]) ; StT = "no hook state yet" ),
    findall(I, ( member(X, S.inbox),
                 ( X.unaccepted == true -> U = " <span class=\"loud\">not accepted</span>" ; U = "" ),
                 maplist(esc, [X.id, X.kind, X.title], [IH, KH, TH]),
                 format(string(I), "<li class=\"inbox\" data-id=\"~w\">~w (~w) ~w, idle ~w days~w</li>", [IH, IH, KH, TH, X.idle_days, U]) ), Is),
    (   Is == [] -> InH = "<p class=\"muted\">Its inbox is empty.</p>"
    ;   atomic_list_concat(Is, '\n', IT), format(string(InH), "<ul class=\"inboxlist\">\n~w\n</ul>", [IT])
    ),
    maplist(esc, [S.name, S.role, S.status, StT], [NH, RH, SH, StH]),
    format(string(L), "<li class=\"session\" data-session=\"~w\"><strong>~w</strong> (~w, ~w; ~w)\n~w</li>", [NH, NH, RH, SH, StH, InH]).

% desk_orphans_html(+Hub, +St, +Groups, +KBs, -Html, -N) (c11): every orphaned item of the hub: a
% spec KB that names no project KB, an open item that no live named session owns, a handoff that
% nobody accepted, a spec KB that blocks while no open ledger item points to it.
desk_orphans_html(Hub, St, Groups, KBs, Html, N) :-
    findall(Ds, member(group(_, none, Ds), Groups), Ds0), append(Ds0, NoProj),
    ( is_dict(St) -> dict_keys_list(St.kb_refs, RefSlugs) ; RefSlugs = unknown ),
    findall(D-Why, ( member(kb(D, _, B), KBs),
                     findall(W, ( ( memberchk(D, NoProj), W = "names no project KB" )
                                ; ( B == true, RefSlugs \== unknown, desk_slug(Hub, D, Sl), \+ memberchk(Sl, RefSlugs),
                                    W = "blocks, and no open ledger item points to it" ) ), Ws),
                     Ws \== [], atomic_list_concat(Ws, '; ', Why) ), KOs),
    findall(L, ( member(D-Why, KOs), desk_rel(Hub, D, Rel), maplist(esc, [Rel, Why], [RH, WH]),
                 format(string(L), "<li class=\"orphan kb\">~w: ~w</li>", [RH, WH]) ), L1),
    (   is_dict(St)
    ->  findall(L, ( member(X, St.orphans.unowned),
                     ( string(X.owner_session) -> format(string(OW), "its owner ~w is not a live session", [X.owner_session]) ; OW = "it has no owner" ),
                     maplist(esc, [X.id, X.kind, X.title, OW], [IH, KH, TH, OH]),
                     format(string(L), "<li class=\"orphan item\" data-id=\"~w\">~w (~w) ~w: no live session owns it (~w)</li>", [IH, IH, KH, TH, OH]) ), L2),
        findall(L, ( member(X, St.orphans.unaccepted),
                     maplist(esc, [X.id, X.title, X.from, X.to], [IH, TH, FH, ToH]),
                     format(string(L), "<li class=\"orphan handoff\" data-id=\"~w\">~w ~w: nobody accepted it (from ~w to ~w, ~w days)</li>", [IH, IH, TH, FH, ToH, X.age_days]) ), L3)
    ;   L2 = [], L3 = []
    ),
    append([L1, L2, L3], Ls), length(Ls, N),
    (   Ls == [] -> Body = "<p>Nothing is orphaned.</p>"
    ;   atomic_list_concat(Ls, '\n', LT), format(string(Body), "<ul class=\"orphans\">\n~w\n</ul>", [LT])
    ),
    format(string(Html), "<section class=\"orphaned\">\n<details><summary><h2>Orphaned</h2> <span class=\"counts\">~w</span></summary>\n~w\n</details>\n</section>", [N, Body]).

dict_keys_list(D, Ks) :- ( is_dict(D) -> dict_pairs(D, _, Ps), pairs_keys(Ps, Ks) ; Ks = [] ).

% desk_js(-Js) (q2): drafts are saved as Ty types: on the server (desk.py) when the hub has one,
% else in this browser. Nothing reaches a session before Send.
desk_js("(function(){var tok=document.body.getAttribute('data-token');function val(f,n){var e=f.querySelector('[name='+n+']:checked')||f.querySelector('textarea[name='+n+']');return e?e.value:'';}function save(f){var key=f.getAttribute('data-draft-key');if(!key)return;var st=f.querySelector('.draftstate');var d={text:val(f,'text'),choice:val(f,'choice'),intent:val(f,'intent')||'answer'};if(f.getAttribute('data-desk')==='1'){var b=new URLSearchParams();b.set('token',tok);b.set('hub',f.getAttribute('data-hub'));b.set('key',key);b.set('text',d.text);b.set('choice',d.choice);b.set('intent',d.intent);fetch('/draft',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:b.toString()}).then(function(r){if(st)st.textContent=r.ok?'Draft saved':'Draft NOT saved (HTTP '+r.status+')';}).catch(function(){if(st)st.textContent='Draft NOT saved: the Desk server does not answer';});}else{try{localStorage.setItem('desk-draft:'+key,JSON.stringify(d));if(st)st.textContent='Draft kept in this browser';}catch(e){}}}document.querySelectorAll('form[data-draft-key]').forEach(function(f){var t;f.addEventListener('input',function(){clearTimeout(t);t=setTimeout(function(){save(f);},500);});f.addEventListener('change',function(){clearTimeout(t);t=setTimeout(function(){save(f);},200);});if(f.getAttribute('data-desk')!=='1'){try{var d=JSON.parse(localStorage.getItem('desk-draft:'+f.getAttribute('data-draft-key'))||'null');var ta=f.querySelector('textarea[name=text]');if(d&&ta&&!ta.value){ta.value=d.text;}}catch(e){}f.addEventListener('submit',function(){try{localStorage.removeItem('desk-draft:'+f.getAttribute('data-draft-key'));}catch(e){}});}});})();").

% =====================================================================
% The Desk, round 2 (hub spec KB questions-server: hypothesis h3, claims c12 to c21)
% =====================================================================
% One Desk for every mindhole (c16): `orbit-kb serve desk` reads, at each page, the mindholes
% that joined it (desk.py join writes $DESK_STATE/mindholes.json), and each --hub. The page lists
% what waits on Ty in every mindhole, in lanes (Your action, Questions, Running on a guess,
% Project KB, Orphaned, Answered, KBs). Each item says where it comes from (c21), shows its owner
% session as a badge (c19) and its due date (c13, q6), names the source of a reservation (c12),
% and leads to what it rests on: the KB, its hypothesis and premises, the claims it touches and
% their checks in words with the last run (c13, c18). Every send opens a review that shows each
% receiving session and the exact text it gets, editable (c20). Only POST /send writes, and it
% builds the plan again from the item before it writes.

dk_f(Fmt, Args, S) :- format(string(S), Fmt, Args).
dk_cat(Xs, S) :- atomic_list_concat(Xs, A), atom_string(A, S).
dk_join(Xs, Sep, S) :- atomic_list_concat(Xs, Sep, A), atom_string(A, S).
dk_str(X, S) :- ( string(X) -> S = X ; X == null -> S = "" ; plain_text(X, S) ).
dk_e(X, H) :- dk_str(X, S), esc(S, H).

% desk_mode: the server shows the Desk (serve desk). serve questions --hub keeps the page of T27 and of
% round 1 of the Desk, so the claims of those tickets keep their checks.
desk_mode :- serve_conf(desk, true).

% desk_state_dir(-Dir) (c16, q10): the Desk's own store, outside every mindhole.
desk_state_dir(D) :-
    (   getenv('DESK_STATE', D0), D0 \== '' -> D = D0
    ;   getenv('XDG_STATE_HOME', X), X \== '' -> directory_file_path(X, desk, D)
    ;   getenv('HOME', H), H \== '' -> directory_file_path(H, '.local/state/desk', D)
    ;   D = '/tmp/desk-state'
    ).

% desk_registry(-Pairs): Name-Path of each mindhole that joined the Desk (desk.py join).
desk_registry(Ps) :-
    use_module(library(http/json)),
    desk_state_dir(D), directory_file_path(D, 'mindholes.json', F),
    (   exists_file(F),
        catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]),
                                 json_read_dict(S, J, [value_string_as(string)]), close(S)), _, fail),
        is_dict(J), get_dict(mindholes, J, Ms), is_list(Ms)
    ->  findall(N-P, ( member(M, Ms), is_dict(M), get_dict(name, M, N0), get_dict(path, M, P0),
                       string(N0), string(P0), atom_string(P1, P0), serve_norm(P1, P), atom_string(N, N0) ), Ps)
    ;   Ps = []
    ).

% desk_hubs(-Hubs, -Missing): hub(Name, Path) for each mindhole of the Desk (the joined ones,
% then each --hub), and Name-Path of each joined one that has no ledger now.
desk_hubs(Hs, Missing) :-
    desk_registry(R),
    findall(hub(N, P), ( member(N-P, R), hub_db(P, Db), exists_file(Db) ), Hs1),
    findall(N-P, ( member(N-P, R), \+ ( hub_db(P, Db), exists_file(Db) ) ), Missing),
    ( serve_conf(hubs, H0) -> true ; H0 = [] ),
    findall(hub(N, P), ( member(P, H0), \+ memberchk(hub(_, P), Hs1),
                         desk_hub_label(P, N0), atom_string(N, N0) ), Hs2),
    append(Hs1, Hs2, Hs).

% ---- the engines of the KBs: one per KB, built again when the KB or its queue changes, or
% after a minute (a digest of a subject file can change too). An old engine's clauses are
% dropped, so a Desk that runs for days does not grow.
:- dynamic desk_eng_cache/4.

desk_kb_stamp(Dir, B-Fs) :-
    findall(N-T-S, ( member(N, ['kb.pl', 'answers.pending', 'answers.applied']),
                     directory_file_path(Dir, N, F), exists_file(F), time_file(F, T), size_file(F, S) ), Fs),
    get_time(Now), B is floor(Now / 60).

desk_engine(Dir, KB, Eng) :-
    desk_kb_stamp(Dir, St),
    (   desk_eng_cache(Dir, St, KB, Eng) -> true
    ;   forall(retract(desk_eng_cache(Dir, _, _, eng(M, _))), desk_wipe(M)),
        lib_dir(Lib), load_kb(Dir, Lib, KB), answer_gate(KB), kb_engine(KB, Eng),
        assertz(desk_eng_cache(Dir, St, KB, Eng))
    ).

desk_wipe(M) :-
    forall(( current_predicate(M:N/A), functor(H, N, A), \+ predicate_property(M:H, imported_from(_)) ),
           catch(abolish(M:N/A), _, true)).

desk_eng(Dir, Eng) :- catch(desk_engine(Dir, _, Eng), _, fail).

dk_all(Eng, T, G, L) :- catch(eng_all(Eng, T, G, L), _, L = []).
dk_true(Eng, G) :- catch(eng_true(Eng, G), _, fail).

% ---- the mindholes and their KBs

% desk_st_parks(+St0, +Parks, -St) (c36, c37, review H-0063): the ledger, not the mindhole's desk.py,
% says which inbox item is parked: an older desk.py gives no parked field, and its parked
% handoffs looked open. Each inbox row gets parked and parked_until from Parks (id: until).
desk_st_parks(St0, Parks, St) :-
    (   is_dict(St0), get_dict(sessions, St0, Ss0), is_list(Ss0)
    ->  maplist(desk_sess_parks(Parks), Ss0, Ss), St = St0.put(sessions, Ss)
    ;   St = St0
    ).
desk_sess_parks(Parks, S0, S) :-
    (   get_dict(inbox, S0, Ib0), is_list(Ib0) -> maplist(desk_item_park(Parks), Ib0, Ib), S = S0.put(inbox, Ib) ; S = S0 ).
desk_item_park(Parks, I0, I) :-
    (   get_dict(id, I0, Id0), dk_str(Id0, Id), atom_string(K, Id), get_dict(K, Parks, V), get_dict(until, V, U)
    ->  ( get_dict(due, V, D), string(D) -> true ; D = "" ), I = I0.put(_{parked:true, parked_until:U, pdue:D})
    ;   I = I0.put(_{parked:false, parked_until:null})
    ).

% desk_load(-HDs): the data of each mindhole on the page, read once per request.
desk_load(HDs, Missing) :-
    desk_hubs(Hs, Missing),
    findall(HD, ( member(hub(N, P), Hs), desk_hub_load(N, P, HD) ), HDs).

desk_hub_load(Name, Path, HD) :-
    desk_status(Path, St0),
    catch(( hub_read(Path, [asks], J), ( J.owner == null -> Owner = "me" ; Owner = J.owner ), Asks = J.asks,
            ( get_dict(parks, J, Parks) -> true ; Parks = _{} ), Err = none ), E,
          ( serve_err_text(E, M), Owner = "me", Asks = [], Parks = _{}, Err = some(M) )),
    desk_st_parks(St0, Parks, St),
    desk_hub_kbs(Path, Asks, St, KBs),
    HD = hd{name:Name, path:Path, st:St, owner:Owner, asks:Asks, kbs:KBs, err:Err}.

% desk_hub_kbs(+Hub, +Asks, +St, -KBs): the KBs of a hub: its spec KBs, its project KB, and each KB
% outside the hub that a kb ref of the ledger names (q5: kb:/path or kb:~/path).
desk_hub_kbs(Hub, Asks, St, KBs) :-
    serve_find_kbs(Hub, Ds0), maplist(serve_norm, Ds0, Ds),
    findall(P, ( member(D, Ds), serve_kb_project(D, some(P)) ), Ps0),
    findall(D, ( member(D, Ds), ( memberchk(D, Ps0) ; serve_is_project_kb(D) ) ), PKs0), sort(PKs0, PKs),
    findall(K, ( member(D, Ds), \+ memberchk(D, PKs), desk_slug(Hub, D, Sl), atom_string(Sl, Ref),
                 desk_kb_rec(Hub, D, Ref, spec, K) ), Specs),
    findall(K, ( member(D, PKs), desk_slug(Hub, D, Sl), atom_string(Sl, Ref), desk_kb_rec(Hub, D, Ref, project, K) ), Projs),
    findall(R, ( member(X, Asks), member(RS, X.refs), string_concat("kb:", R, RS), desk_outside_ref(R) ), R1),
    (   is_dict(St), get_dict(kb_refs, St, KR), is_dict(KR)
    ->  dict_keys(KR, Ks), findall(R, ( member(KA, Ks), atom_string(KA, R), desk_outside_ref(R) ), R2)
    ;   R2 = []
    ),
    append(R1, R2, R3), sort(R3, Rs),
    findall(K, ( member(R, Rs), desk_ref_dir(R, D), \+ memberchk(D, Ds), desk_kb_rec(Hub, D, R, outside, K) ), Outs0),
    desk_dedup_dirs(Outs0, Outs),
    append([Specs, Projs, Outs], KBs).

dict_keys(D, Ks) :- dict_pairs(D, _, Ps), pairs_keys(Ps, Ks).

desk_dedup_dirs([], []).
desk_dedup_dirs([K|Ks], [K|Rs]) :- get_dict(dir, K, KD), exclude([X]>>get_dict(dir, X, KD), Ks, Ks1), desk_dedup_dirs(Ks1, Rs).

desk_outside_ref(R) :- ( sub_string(R, 0, 1, _, "/") ; sub_string(R, 0, 2, _, "~/") ), !.

% desk_ref_dir(+Ref, -Dir): the directory of a kb ref to a KB outside the hub, when it holds kb.pl.
desk_ref_dir(R, D) :-
    (   sub_string(R, 0, 2, _, "~/") -> getenv('HOME', H), sub_string(R, 2, _, 0, Rest), directory_file_path(H, Rest, D0)
    ;   atom_string(D0, R)
    ),
    exists_directory(D0), serve_norm(D0, D),
    directory_file_path(D, 'kb.pl', F), exists_file(F).

desk_kb_rec(Hub, Dir, Ref, Kind, K) :-
    (   Kind == outside -> file_base_name(Dir, B0), atom_string(B0, B1),
        ( string_concat("kb-", B2, B1) -> Label = B2 ; Label = B1 )
    ;   Kind == project -> ( file_base_name(Dir, B0), atom_string(B0, Label) )
    ;   atom_string(Ref, Label)
    ),
    atom_codes(Label, Cs), maplist([C, D]>>( code_type(C, alnum) -> D = C ; D = 0'- ), Cs, Ds),
    atom_codes(A0, Ds), file_base_name(Hub, HB), atom_codes(HB, HCs),
    maplist([C, D]>>( code_type(C, alnum) -> D = C ; D = 0'- ), HCs, HDs), atom_codes(HA, HDs),
    format(atom(Anchor), "kb-~w-~w", [HA, A0]),
    K = kb{dir:Dir, hub:Hub, ref:Ref, label:Label, kind:Kind, anchor:Anchor}.

% desk_kb_by_ref(+HD, +Ref, -K): the KB that a kb ref of the ledger names.
desk_kb_by_ref(HD, Ref, K) :-
    member(K, HD.kbs), ( K.ref == Ref -> true ; desk_outside_ref(Ref), desk_ref_dir(Ref, D), K.dir == D ), !.

% desk_hd_of(+HDs, +Path, -HD)
desk_hd_of(HDs, Path, HD) :- member(HD, HDs), HD.path == Path, !.

% desk_kb_of_dir(+HDs, +Dir, -HD, -K)
desk_kb_of_dir(HDs, Dir, HD, K) :- member(HD, HDs), member(K, HD.kbs), K.dir == Dir, !.

% ---- sessions, holders, owners

% desk_sessions(+HD, -Ss): name-Status of each session of the hub.
desk_sessions(HD, Ss) :-
    (   is_dict(HD.st) -> findall(N-S, ( member(X, HD.st.sessions), atom_string(N, X.name), atom_string(S, X.status) ), Ss)
    ;   Ss = []
    ).

desk_live(HD, S) :- S \== none, desk_sessions(HD, Ss), memberchk(S-active, Ss).

desk_session_of(St, W, S) :-
    is_dict(St), atom_string(W, WS), member(X, St.sessions),
    ( get_dict(session_id, X, WS) ; X.name == WS ), !, atom_string(S, X.name).

% desk_holder(+HD, +K, -Holder, -How) (q7: the writer holds a KB): the session that holds the KB's
% writer lock now; else the receiver of the newest accepted handoff on the KB; else none.
desk_holder(HD, K, Holder, How) :-
    St = HD.st,
    (   catch(lock_state(K.dir, held(W, _)), _, fail), desk_session_of(St, W, S) -> Holder = S, How = lock
    ;   desk_kb_handoffs(HD, K, Hs), include([X]>>( get_dict(accepted_at, X, AA), AA \== null ), Hs, Acc), Acc \== [],
        last(Acc, L), atom_string(S, L.to) -> Holder = S, How = handoff
    ;   Holder = none, How = none
    ).

% desk_kb_handoffs(+HD, +K, -Hs): the open handoffs with a kb ref to the KB, oldest first.
desk_kb_handoffs(HD, K, Hs) :-
    St = HD.st,
    (   is_dict(St), get_dict(kb_handoffs, St, KH), is_dict(KH)
    ->  dict_pairs(KH, _, Ps),
        findall(X, ( member(RA-L, Ps), atom_string(RA, R), desk_ref_is(HD, K, R), member(X, L) ), Xs0),
        list_to_set(Xs0, Xs1),
        predsort(desk_cmp_opened, Xs1, Hs)
    ;   Hs = []
    ).

desk_cmp_opened(O, A, B) :-
    compare(O0, A.opened_at-A.id, B.opened_at-B.id), ( O0 == (=) -> O = (<) ; O = O0 ).

desk_ref_is(_, K, R) :- K.ref == R, !.
desk_ref_is(_, K, R) :- desk_outside_ref(R), desk_ref_dir(R, D), D == K.dir, !.
desk_ref_is(HD, K, R) :- K.kind == spec, atom_string(RA, R), desk_slug(HD.path, K.dir, RA), !.

% desk_stale_handoffs(+HD, +K, -Old, -Newest) (q7): the open handoffs on a KB that a newer one replaces.
desk_stale_handoffs(HD, K, Old, Newest) :-
    desk_kb_handoffs(HD, K, Hs), Hs = [_, _|_], last(Hs, Newest), exclude(==(Newest), Hs, Old).

% desk_keeper(+HD, -S): the live session that takes a letter about the hub itself: process when it
% is live, else the first live session, else none.
desk_keeper(HD, S) :-
    desk_sessions(HD, Ss),
    (   memberchk(process-active, Ss) -> S = process
    ;   member(S-active, Ss) -> true
    ;   S = none
    ).

desk_live_sessions(HD, Ls) :- desk_sessions(HD, Ss), findall(S, member(S-active, Ss), Ls).

% ---- asks

desk_ask(HD, Id, X) :- member(X, HD.asks), X.id == Id, !.

desk_ask_for_me(HD, X) :- member(X, HD.asks), X.waits_on == HD.owner.

desk_ask_kbrefs(X, Rs) :- findall(R, ( member(RS, X.refs), string_concat("kb:", R, RS) ), Rs).

% desk_ask_kb_state(+X, -S): kb (it names a KB), none (its asker said that it rests on no KB, q5),
% or unknown (an old ask: nobody recorded either).
desk_ask_kb_state(X, S) :-
    (   desk_ask_kbrefs(X, [_|_]) -> S = kb
    ;   get_dict(no_kb, X, true) -> S = none
    ;   S = unknown
    ).

desk_ask_reserved(X) :- get_dict(reserved, X, R), string(R), R \== "".

% desk_reserve_source(+Text, -Source) (c12): policy(Name, Rule), words(Who, Date, Words), or unnamed.
desk_reserve_source(T, Src) :-
    (   re_matchsub("^(?<name>[A-Z][A-Za-z0-9]*(?: [A-Z][A-Za-z0-9]*)* Policy): (?<rule>.+)$"/s, T, D, [])
    ->  Src = policy(D.name, D.rule)
    ;   re_matchsub("^(?<who>[^,\n]+), (?<date>[0-9]{4}-[0-9]{2}-[0-9]{2}): (?<words>.+)$"/s, T, D, [])
    ->  Src = words(D.who, D.date, D.words)
    ;   Src = unnamed(T)
    ).

% desk_policy(+Action, -Name, -Rule, -From) (c12): the standing rules that keep a KB action for Ty.
desk_policy(vote, "Sagittarius Policy", "Discovery ends with the human's vote. No vote wins without it.", "the prompt, \"The vote\"").
desk_policy(demo, "Sagittarius Policy", "Only the human judges a demo of a visual claim. The claim stays open until the human approves it.", "the prompt, \"Who judges what\"").
desk_policy(waiver, "Sagittarius Policy", "Only the human may skip work. A skip is a waiver with a due time; after it, the work comes back.", "the prompt, \"Delivery\"").

% ---- dates (q6)

dk_month(1, "Jan"). dk_month(2, "Feb"). dk_month(3, "Mar"). dk_month(4, "Apr"). dk_month(5, "May"). dk_month(6, "Jun").
dk_month(7, "Jul"). dk_month(8, "Aug"). dk_month(9, "Sep"). dk_month(10, "Oct"). dk_month(11, "Nov"). dk_month(12, "Dec").

% dk_day(+Iso, -Text): "11 Dec" (with the year when it is not this year).
dk_day(Iso0, Text) :-
    dk_str(Iso0, Iso),
    (   sub_string(Iso, 0, 10, _, D10), split_string(D10, "-", "", [YS, MS, DS]),
        number_string(Y, YS), number_string(M, MS), number_string(D, DS), dk_month(M, MN)
    ->  get_time(Now), stamp_date_time(Now, date(Y0, _, _, _, _, _, _, _, _), 'UTC'),
        ( Y == Y0 -> dk_f("~w ~w", [D, MN], Text) ; dk_f("~w ~w ~w", [D, MN, Y], Text) )
    ;   Text = Iso
    ).

dk_day_time(Iso0, Text) :-
    dk_str(Iso0, Iso), dk_day(Iso, D),
    ( sub_string(Iso, 11, 5, _, HM) -> dk_f("~w, ~w", [D, HM], Text) ; Text = D ).

% desk_ask_due(+X, -Due, -How): the asker's due date, else the triage date (q6).
desk_ask_due(X, Due, How) :-
    (   get_dict(due, X, D), string(D), D \== "" -> Due = D, How = asker
    ;   get_dict(triage_due, X, D), string(D), D \== "" -> Due = D, How = triage
    ;   Due = "", How = none
    ).

% ---- checks (c18, q8): the words of a check (a checks_that fact, else the docstring of its own
% script, else none), how it runs (the command of its last run), and its last run.

desk_check(Dir, Eng, K, Ck) :-
    dk_all(Eng, [N, R, T], attest(_, test_result, _, result(K, N, R), _, T), Runs),
    (   Runs \== [] -> msort(Runs, Rs1), last(Rs1, [N1, R1, T1]), Last = run(N1, R1, T1),
        desk_run_cmd(Dir, N1, K, Cmd)
    ;   Last = none, Cmd = ""
    ),
    (   dk_all(Eng, [W], checks_that(K, W), [W1|_]) -> dk_str(W1, Words), Src = fact
    ;   Cmd \== "", desk_cmd_doc(Dir, Cmd, Doc) -> Words = Doc, Src = script
    ;   Words = "", Src = none
    ),
    Ck = ck{id:K, words:Words, src:Src, cmd:Cmd, last:Last}.

% desk_run_cmd(+Dir, +N, +K, -Cmd): the cmd= of the first line of runs/N-K.log.
desk_run_cmd(Dir, N, K, Cmd) :-
    format(atom(Rel), "runs/~w-~w.log", [N, K]), directory_file_path(Dir, Rel, F),
    (   exists_file(F),
        catch(setup_call_cleanup(open(F, read, S, [encoding(utf8)]), read_line_to_string(S, L1), close(S)), _, fail),
        string(L1), sub_string(L1, B, _, _, " cmd="), B2 is B + 5, sub_string(L1, B2, _, 0, C)
    ->  Cmd = C
    ;   Cmd = ""
    ).

% desk_cmd_doc(+Dir, +Cmd, -Doc): the first line of the docstring of the check's own script: only
% when the command is the script alone (an interpreter and one script, no other argument), so the
% words of a whole suite never stand for one check.
desk_cmd_doc(Dir, Cmd, Doc) :-
    split_string(Cmd, " ", " ", Ws0), exclude(==(""), Ws0, Ws),
    (   Ws = [P] -> true
    ;   Ws = [I, P], memberchk(I, ["python3", "python", "bash", "sh", "swipl", "env"])
    ),
    member(Ext, [".py", ".sh"]), string_concat(_, Ext, P), !,
    atom_string(PA, P),
    (   is_absolute_file_name(PA) -> F = PA ; directory_file_path(Dir, PA, F) ),
    exists_file(F),
    catch(read_file_to_string(F, Src, [encoding(utf8)]), _, fail),
    desk_doc_line(Ext, Src, Doc).

desk_doc_line(".py", Src, Doc) :-
    re_matchsub("^(?:#[^\n]*\n|\\s)*(?:[rRuU])?(\"\"\"|''')\\s*(?<l>[^\n]+)"/s, Src, D, []),
    split_string(D.l, "", " \t\"'", [Doc0]), Doc0 \== "", !, Doc = Doc0.
desk_doc_line(".sh", Src, Doc) :-
    split_string(Src, "\n", "", Ls), member(L, Ls), \+ sub_string(L, 0, 2, _, "#!"),
    string_concat("#", R, L), split_string(R, "", " \t", [Doc]), Doc \== "", !.

% ---- claims and what blocks (c13: each blocker once)

desk_hypothesis(Eng, H) :-
    (   dk_all(Eng, [I, T], ( hypothesis(I, _, T), \+ supersedes(_, I) ), [[I1, T1]|_])
    ->  txt(T1, TT), dk_all(Eng, [P, PT], premise(P, I1, PT), Ps0),
        findall(p(P, PS, Chk), ( member([P, PT0], Ps0), txt(PT0, PS),
                                 ( dk_true(Eng, premise_checked(P, _)) -> Chk = checked ; Chk = unchecked ) ), Ps),
        ( dk_true(Eng, no_premises(I1)) -> None = true ; None = false ),
        H = hyp{id:I1, text:TT, premises:Ps, none:None}
    ;   H = none
    ).

desk_current_claims(Eng, Cs) :-
    dk_all(Eng, [C], ( claim(C, _, _), \+ supersedes(_, C) ), Cs0), sort(Cs0, Cs).

desk_claim_text(Eng, C, T) :- ( dk_all(Eng, [T0], claim(C, _, T0), [T1|_]) -> txt(T1, T) ; T = "" ).

% desk_claim_state(+Eng, +C, -Tags): what holds the claim open, each once.
desk_claim_state(Eng, C, Tags) :-
    findall(T, ( member(G-T, [under(C)-under, contested(C)-contested, burn_open(C)-proof,
                               flare_open(C)-demo]), dk_true(Eng, G) ), Tags0),
    ( Tags0 == [] -> Tags = [fulfilled] ; Tags = Tags0 ).

desk_tag_badge(fulfilled, "fulfilled", "b-pass").
desk_tag_badge(under, "not fulfilled", "b-warn").
desk_tag_badge(contested, "contested", "b-burn").
desk_tag_badge(proof, "proof owed", "b-burn").
desk_tag_badge(demo, "demo owed", "b-warn").

% desk_kb_blockers(+KB, +Eng, -Lines): what blocks the KB that no claim and no card of the page
% shows already (c13: each blocker once).
desk_kb_blockers(KB, Eng, Lines) :-
    dk_all(Eng, [X], blocking(X), Xs),
    exclude([X]>>( X =.. [F|_], memberchk(F, [to_ask, under, burn_open, flare_open, check_failing, check_unrun]) ), Xs, Ys),
    findall(S, ( member(Y, Ys), catch(blocking_line(KB, Eng, Y, S0), _, fail), dk_str(S0, S1),
                 ( string_concat("- ", S, S1) -> true ; S = S1 ) ), Lines).

% ---- rendering: small parts

% desk_badge(+Session, -Html) (c19): one label per session, one size, the text centered.
desk_badge(none, Html) :- !, Html = "<span class=\"badge b-none\" title=\"No session holds it\">nobody</span>".
desk_badge(S, Html) :-
    atom_string(S, SS), esc(SS, SH),
    (   memberchk(SS, ["discovery", "build", "review", "process"]) -> dk_f("b-~w", [SS], Cl)
    ;   SS == "you" -> Cl = "b-you"
    ;   string_codes(SS, Cs), sum_list(Cs, Sum), I is Sum mod 4 + 1, dk_f("b-s~w", [I], Cl)
    ),
    dk_f("<span class=\"badge ~w\" title=\"Your response goes to this session\">~w</span>", [Cl, SH], Html).

desk_status_badge(Text, Class, Html) :- esc(Text, TH), dk_f("<span class=\"badge status ~w\">~w</span>", [Class, TH], Html).

desk_due_html(Due, How, Opened, Html) :-
    (   Opened \== "" -> dk_day(Opened, OD), dk_f("<span>Opened ~w</span>", [OD], OH) ; OH = "" ),
    (   Due == "" -> dk_f("<div class=\"due none\"><strong>No due date</strong>~w</div>", [OH], Html)
    ;   dk_day(Due, DD),
        ( How == triage -> Tt = " title=\"The day it comes due for triage: 28 days with no change\"" ; How == asker -> Tt = " title=\"The due date that the asker set\"" ; Tt = "" ),
        dk_f("<div class=\"due\"~w><strong>Due ~w</strong>~w</div>", [Tt, DD, OH], Html)
    ).

% desk_hidden(+Pairs, -Html)
desk_hidden(Ps, Html) :-
    findall(F, ( member(N-V, Ps), dk_e(V, VH), dk_f("<input type=\"hidden\" name=\"~w\" value=\"~w\">", [N, VH], F) ), Fs),
    dk_cat(Fs, Html).

% desk_fix_button(+Hub, +Item, +Label, -Html): a small form that opens the review of a fix (c14, c20).
desk_fix_button(Hub, Item, Label, Html) :-
    serve_conf(token, Tok), desk_hidden([token-Tok, hub-Hub, item-Item], HH), esc(Label, LH),
    dk_f("<form class=\"inline\" method=\"post\" action=\"/review\" data-review>~w<button class=\"btn fix\" type=\"submit\">~w</button></form>", [HH, LH], Html).

desk_fix_link(Hub, Item, Label, Html) :-
    serve_conf(token, Tok), desk_hidden([token-Tok, hub-Hub, item-Item], HH), esc(Label, LH),
    dk_f("<form class=\"inline\" method=\"post\" action=\"/review\" data-review>~w<button class=\"linkb\" type=\"submit\">~w</button></form>", [HH, LH], Html).

% ---- what an item rests on (c13, c18)

% desk_rests_html(+HD, +K, +Claims, -Html): the KB, its hypothesis and premises, the claims, their checks.
desk_rests_html(HD, K, Claims, Html) :-
    (   desk_eng(K.dir, Eng)
    ->  desk_holder(HD, K, Hold, _),
        esc(K.label, LH),
        (   Hold == none -> HoldH = " <span class=\"gapnote\">No session holds it.</span>"
        ;   dk_f(" <span class=\"quiet\">Held by ~w.</span>", [Hold], HoldH)
        ),
        dk_f("<p><a class=\"kblink\" href=\"#~w\">The KB ~w</a>~w</p>", [K.anchor, LH, HoldH], KbH),
        desk_hyp_html(Eng, HypH),
        findall(C, ( member(C, Claims), dk_true(Eng, claim(C, _, _)) ), Cs),
        findall(CH, ( member(C, Cs), desk_claim_html(HD, K, Eng, C, CH) ), CHs), dk_cat(CHs, CsH),
        dk_cat([KbH, HypH, CsH], Html)
    ;   esc(K.label, LH),
        dk_f("<p class=\"loud\">The Desk cannot read the KB ~w (~w).</p>", [LH, K.dir], Html)
    ).

desk_hyp_html(Eng, Html) :-
    desk_hypothesis(Eng, H),
    (   H == none -> Html = "<p class=\"gapnote\">No hypothesis is recorded.</p>"
    ;   esc(H.text, TH),
        (   H.premises \== []
        ->  findall(P, ( member(p(Id, PT, Chk), H.premises), esc(PT, PTH),
                         ( Chk == checked -> CkT = "checked on the system" ; CkT = "a guess: nobody checked it" ),
                         dk_f("<li><span class=\"ref\">~w</span>~w <span class=\"quiet\">(~w)</span></li>", [Id, PTH, CkT], P) ), Ps),
            dk_cat(Ps, PsH), dk_f("<h4>Premises</h4><ul>~w</ul>", [PsH], PrH)
        ;   H.none == true -> PrH = "<p class=\"quiet\">Premises: none.</p>"
        ;   PrH = "<p class=\"gapnote\">No premises are recorded.</p>"
        ),
        dk_f("<p><span class=\"ref\">~w</span>~w</p>~w", [H.id, TH, PrH], Html)
    ).

desk_claim_html(HD, K, Eng, C, Html) :-
    desk_claim_text(Eng, C, T), esc(T, TH),
    desk_claim_state(Eng, C, Tags),
    findall(B, ( member(Tg, Tags), desk_tag_badge(Tg, BT, BC), desk_status_badge(BT, BC, B) ), Bs), dk_cat(Bs, BsH),
    desk_checks_html(HD, K, Eng, C, Tags, ChH),
    dk_f("<div class=\"claimrow\"><p><span class=\"ref\">~w</span>~w</p>~w</div>~w", [C, TH, BsH, ChH], Html).

desk_checks_html(HD, K, Eng, C, Tags, Html) :-
    dk_all(Eng, [Kc], check(Kc, C), Ks0), sort(Ks0, Ks),
    (   Ks == [] -> Html = "<p class=\"gapnote small\">This claim has no check.</p>"
    ;   findall(Ck, ( member(Kc, Ks), desk_check(K.dir, Eng, Kc, Ck) ), Cks),
        length(Ks, N),
        findall(x, ( member(X, Cks), get_dict(last, X, run(_, pass, _)) ), L1), length(L1, NP),
        findall(x, ( member(X, Cks), get_dict(last, X, run(_, Rz, _)), Rz \== pass ), L2), length(L2, NF),
        findall(x, ( member(X, Cks), get_dict(last, X, none) ), L3), length(L3, NU),
        findall(B, ( member(Cnt-Txt-Cl, [NP-"pass"-"b-pass", NF-"fail"-"b-burn", NU-"never ran"-"b-warn"]), Cnt > 0,
                     dk_f("~w ~w", [Cnt, Txt], BT), desk_status_badge(BT, Cl, B) ), Bs), dk_cat(Bs, BsH),
        findall(R, ( member(Ck, Cks), desk_check_row(Ck, R) ), Rs), dk_cat(Rs, RsH),
        (   member(X, Cks), X.src == none, \+ desk_kb_frozen(HD, K)
        ->  desk_holder(HD, K, Hold, _),
            ( Hold == none -> Who = "a session" ; atom_string(Hold, Who) ),
            dk_f("fix:words:~w", [K.dir], It), dk_f("Ask ~w to say what these checks do", [Who], FL),
            desk_fix_link(HD.path, It, FL, FB), dk_f("<div class=\"chk\"><span></span><span class=\"small\">~w</span></div>", [FB], FixH)
        ;   FixH = ""
        ),
        ( Tags == [fulfilled] -> Op = "" ; Op = " open" ),
        ( N == 1 -> Ct = "check" ; Ct = "checks" ),
        dk_f("<details class=\"checks\"~w><summary><span class=\"lbl\">~w ~w of ~w</span>~w</summary>~w~w</details>", [Op, N, Ct, C, BsH, RsH, FixH], Html)
    ).

desk_check_row(Ck, Html) :-
    (   Ck.words == "" -> WH = "<span class=\"gapnote\">Nobody recorded what this check does.</span>"
    ;   esc(Ck.words, W0), ( Ck.src == script -> dk_f("~w <span class=\"quiet small\">(from its script)</span>", [W0], W1) ; W1 = W0 ),
        dk_f("<span>~w</span>", [W1], WH)
    ),
    (   Ck.last = run(N, R, T) -> dk_day_time(T, DT), ( R == pass -> Cl = "b-pass" ; Cl = "b-burn" ), desk_status_badge(R, Cl, B),
        dk_f("Last run ~w (run ~w).", [DT, N], LastT)
    ;   desk_status_badge("never ran", "b-warn", B), LastT = "It never ran."
    ),
    (   Ck.cmd \== "" -> desk_cmd_short(Ck.cmd, Short), esc(Short, SH), esc(Ck.cmd, CH),
        dk_f("Runs <code title=\"~w\">~w</code>. ", [CH, SH], HowT)
    ;   HowT = "No run records its command. "
    ),
    esc(LastT, LH),
    dk_f("<div class=\"chk\"><span class=\"ref\">~w</span>~w~w<span class=\"how\">~w~w</span></div>", [Ck.id, WH, B, HowT, LH], Html).

% desk_cmd_short(+Cmd, -Short): the command with each path cut to its file name.
desk_cmd_short(Cmd, Short) :-
    split_string(Cmd, " ", "", Ws),
    maplist([W, S]>>( sub_string(W, _, _, _, "/"), \+ sub_string(W, 0, _, _, "^")
                      -> split_string(W, "/", "", Ps), last(Ps, S) ; S = W ), Ws, Ss),
    dk_join(Ss, " ", Short).

% desk_ask_claims(+Eng, +X, -Cs): the claims an ask touches: the claim ids that its title and
% notes name; else each claim that something holds open.
desk_ask_claims(Eng, X, Cs) :-
    findall(N, ( member(Nd, X.notes), N = Nd.note ), Ns), dk_join([X.title|Ns], " ", T),
    split_string(T, " ,.;:()[]\"'\n\t", "", Ws),
    findall(C, ( member(W, Ws), re_match("^c[0-9]+$", W), atom_string(C, W), dk_true(Eng, claim(C, _, _)) ), Cs0),
    sort(Cs0, Cs1),
    (   Cs1 \== [] -> Cs = Cs1
    ;   desk_current_claims(Eng, All), include([C]>>( desk_claim_state(Eng, C, Tg), Tg \== [fulfilled] ), All, Cs)
    ).

% ---- the cards: each item that waits on Ty

% desk_item_json(+HD, +K, +Type, +Ref, -J): the item of a letter about a KB question or action.
desk_item_json(HD, K, Type, Ref, J) :-
    (   desk_rel(HD.path, K.dir, Rel) -> atom_string(Rel, KS) ; atom_string(K.dir, KS) ),
    file_base_name(K.dir, B), ( K.kind == spec -> atom_string(K.ref, Sl) ; atom_string(B, Sl) ),
    atom_string(Ref, RS),
    (   Type == question -> J = _{type:"question", slug:Sl, kb:KS, q:RS}
    ;   J = _{type:"kb", slug:Sl, kb:KS, ref:RS}
    ).

% desk_item_letters2(+HD, +Match, -Ls): the letters of the hub about an item.
desk_item_letters2(HD, Match, Ls) :-
    (   is_dict(HD.st), get_dict(letters, HD.st, All) -> include(desk_letter_match(Match), All, Ls) ; Ls = [] ).

desk_letter_match(ask(Id), L) :- get_dict(item, L, I), is_dict(I), get_dict(type, I, "ask"), get_dict(id, I, Id).
desk_letter_match(kbitem(J), L) :- get_dict(item, L, I), is_dict(I),
    get_dict(type, I, T), get_dict(type, J, T), get_dict(kb, I, Kb), get_dict(kb, J, Kb),
    ( T == "question" -> get_dict(q, I, Q), get_dict(q, J, Q) ; get_dict(ref, I, R), get_dict(ref, J, R) ).

% desk_draft_of(+Key, -Dr): Ty's draft for a card, from the Desk's own store (q10).
desk_draft_of(Key, Dr) :-
    (   nb_current(desk_drafts, Ds), is_dict(Ds), atom_string(KA, Key), get_dict(KA, Ds, D0), is_dict(D0) -> Dr = D0 ; Dr = _{} ).

desk_drafts_load(HDs) :-
    (   HDs = [HD|_], desk_cmd(HD.path, [drafts, '--json'], Out, ok),
        catch(atom_json_dict(Out, J, [value_string_as(string)]), _, fail), is_dict(J)
    ->  ( get_dict(drafts, J, Ds) -> true ; Ds = J )
    ;   Ds = _{}
    ),
    nb_setval(desk_drafts, Ds).

% desk_track_html(+HD, +Owner, +Ls, +Dr, -Track, -Warn) (c7, q9): Draft and Sent; a warning when
% no live session holds the item, when a sent letter is not seen after a day, or when the Desk
% could not apply a response.
desk_track_html(HD, Owner, Ls, Dr, Track, Warn) :-
    ( get_dict(text, Dr, DT), DT \== "" -> DOn = " on", DS = "Draft saved" ; DOn = "", DS = "" ),
    ( Ls \== [] -> SOn = " on" ; SOn = "" ),
    dk_f("<span class=\"track\"><i class=\"draftdot~w\"></i><span>Draft</span><i class=\"sentdot~w\"></i><span>Sent</span><span class=\"draftstate\">~w</span></span>", [DOn, SOn, DS], Track),
    findall(W, ( member(L, Ls), get_dict(late_unseen, L, true), dk_str(L.get(to, "the owner"), To), dk_day_time(L.at, At),
                 dk_f("<p class=\"warn lamp\">You sent this on ~w, and ~w has not seen it after a day.</p>", [At, To], W) ), W1),
    findall(W, ( member(L, Ls), get_dict(state, L, "apply_failed"), dk_str(L.apply_failed.detail, D), esc(D, DH),
                 dk_f("<p class=\"warn\">Your response ~w is stored, so it is not lost, but the Desk could not apply it: ~w</p>", [L.id, DH], W) ), W2),
    (   desk_live(HD, Owner), desk_hooks_missing(HD, Ms), Ms \== []
    ->  desk_hooks_warning(HD, Owner, Ms, HW), W3 = [HW]
    ;   \+ desk_live(HD, Owner)
    ->  W3 = ["<p class=\"warn loud\">No live session holds this item. What you send is stored, but no session is told until one takes it.</p>"]
    ;   W3 = []
    ),
    findall(S, ( member(L, Ls), dk_day_time(L.at, At), dk_str(L.get(to, ""), To0), ( To0 == "" -> To = "the owner" ; To = To0 ),
                 dk_str(L.kind, Kd), dk_f("<li>~w: sent to ~w on ~w</li>", [Kd, To, At], S) ), Ss),
    ( Ss == [] -> SL = "" ; dk_cat(Ss, SsT), dk_f("<ul class=\"sentlist\">~w</ul>", [SsT], SL) ),
    append([W1, W2, W3, [SL]], Ws), dk_cat(Ws, Warn).

% desk_form_html(+HD, +Item, +Key, +Owner, +Ls, +OptsH, +Intents, -Html) (c5, c20): the response
% of a card. Each send goes through the review.
desk_form_html(HD, Item, Key, Owner, Ls, OptsH, Intents, Html) :-
    serve_conf(token, Tok), desk_draft_of(Key, Dr),
    desk_hidden([token-Tok, hub-HD.path, item-Item, key-Key], HH),
    ( get_dict(intent, Dr, DI), string(DI) -> true ; DI = "answer" ),
    ( get_dict(text, Dr, DT0), string(DT0) -> DT = DT0 ; DT = "" ),
    findall(I, ( member(V-Lb, Intents), ( V == DI -> Ck = " checked" ; Ck = "" ),
                 dk_f("<label><input type=\"radio\" name=\"intent\" value=\"~w\"~w>~w</label>", [V, Ck, Lb], I) ), Is),
    dk_cat(Is, IsH), esc(DT, DTH),
    desk_track_html(HD, Owner, Ls, Dr, Track, Warn),
    dk_f("<form class=\"respond\" method=\"post\" action=\"/review\" data-review data-draft-key=\"~w\">~w~w<fieldset class=\"intent\"><legend class=\"small quiet\">What this is</legend>~w</fieldset><textarea name=\"text\" aria-label=\"Your words\" placeholder=\"Your words. Saved as you type; nothing is sent before you review it.\">~w</textarea><div class=\"foot\"><button class=\"btn go\" type=\"submit\">Review and send</button>~w</div>~w</form>",
         [Key, HH, OptsH, IsH, DTH, Track, Warn], Html).

desk_intents([answer-"Answer", diverge-"That is not what I meant", requirement-"New requirement"]).

% desk_opts_html(+Choices, +Dr, -Html): the options of a card as radio cards. Choices: Text-Effect-Tag.
desk_opts_html([], _, "") :- !.
desk_opts_html(Cs, Key, Html) :-
    desk_draft_of(Key, Dr), ( get_dict(choice, Dr, DC) -> true ; DC = "" ),
    findall(O, ( member(T-E-Tag, Cs), esc(T, TH), ( T == DC -> Ck = " checked" ; Ck = "" ),
                 ( E == "" -> EH = "" ; esc(E, E0), dk_f("<small>~w</small>", [E0], EH) ),
                 ( Tag == "" -> TgH = "" ; esc(Tag, Tg0), dk_f("<span class=\"tag\">~w</span>", [Tg0], TgH) ),
                 dk_f("<label class=\"opt\"><input type=\"radio\" name=\"choice\" value=\"~w\"~w> <b>~w</b>~w~w</label>", [TH, Ck, TH, TgH, EH], O) ), Os),
    dk_cat(Os, OsH), dk_f("<fieldset class=\"opts\"><legend class=\"small quiet\">Options</legend>~w</fieldset>", [OsH], Html).

% desk_sheet(+Mode, +Anchor, +Reserved, +Head, +Policy, +Ctx, +Form, -Html): a card as an open
% sheet (Your action) or a row that opens (the other lanes, c2).
desk_sheet(Mode, Anchor, Res, Head, Pol, Ctx, Form, Html) :-
    ( Res == true -> Cl = "sheet reserved" ; Cl = "sheet" ),
    % c22: every card collapses (Your action too) and loads closed; desk_page opens the first one
    Mode = Mode,
    dk_f("<details class=\"~w\" id=\"~w\"><summary>~w</summary>~w~w<div class=\"answer\">~w</div></details>", [Cl, Anchor, Head, Pol, Ctx, Form], Html).

desk_head(TitleH, SrcH, Owner, DueH, Html) :-
    desk_badge(Owner, BH),
    dk_f("<div class=\"head\"><div class=\"t\"><h3 class=\"title\">~w</h3><div class=\"src\">~w</div></div>~w~w</div>", [TitleH, SrcH, BH, DueH], Html).

desk_ctx_html(Rests, Why, Html) :-
    dk_f("<div class=\"ctx\"><section><h3>What it rests on</h3>~w</section><section><h3>Why you, why now</h3>~w</section></div>", [Rests, Why], Html).

desk_hub_suffix(HDs, HD, S) :- ( HDs = [_, _|_] -> esc(HD.name, NH), dk_f(" <span class=\"quiet\">(~w)</span>", [NH], S) ; S = "" ).

% desk_ask_card(+HDs, +HD, +X, -Card) (c12, c13, c19, c21; c32: in the Ledger lane, with the ledger's actions)
desk_ask_card(HDs, HD, X, card{lane:Lane, due:Due, html:Html, kbs:KDs, hub:HD.path, anchor:Anchor, title:X.title, id:X.id, reserved:Res, until:PU, pdue:PDue}) :-
    ( get_dict(due, X, PDue0), string(PDue0) -> PDue = PDue0 ; PDue = "" ),
    ( desk_ask_reserved(X) -> Res = true, Mode = open ; Res = false, Mode = row ),
    desk_parked(X, Lane, ledger, PU),
    esc(X.title, TH), dk_str(X.asked_by, AB0), ( AB0 == "" -> AB = "an unknown session" ; AB = AB0 ),
    desk_ask_kb_state(X, KS), desk_ask_kbrefs(X, Refs),
    findall(K, ( member(R, Refs), desk_kb_by_ref(HD, R, K) ), Ks), findall(KD, ( member(K, Ks), get_dict(dir, K, KD) ), KDs),
    findall(R, ( member(R, Refs), \+ desk_kb_by_ref(HD, R, _) ), Lost),
    desk_hub_suffix(HDs, HD, HS),
    (   KS == kb, Ks \== [] -> findall(L, ( member(K, Ks), esc(K.label, L) ), Ls), dk_join(Ls, ", ", LsT),
        dk_f("<span>Ledger ask ~w from ~w, about the KB ~w~w</span>", [X.id, AB, LsT, HS], Src0)
    ;   KS == kb -> dk_f("<span>Ledger ask ~w from ~w~w</span>", [X.id, AB, HS], Src0)
    ;   KS == none -> dk_f("<span>Ledger ask ~w from ~w, no KB behind it~w</span>", [X.id, AB, HS], Src0)
    ;   dk_f("<span>Ledger ask ~w from ~w~w</span><span class=\"gapnote\">No KB behind it (not recorded)</span>", [X.id, AB, HS], Src0)
    ),
    findall(G, ( member(R, Lost), esc(R, RH), dk_f("<span class=\"gapnote\">The KB ~w cannot be read</span>", [RH], G) ), Gs),
    dk_cat([Src0|Gs], SrcH),
    ( string(X.owner_session) -> atom_string(Owner, X.owner_session) ; Owner = none ),
    desk_ask_due(X, Due, How), desk_due_html(Due, How, X.opened_at, DueH0), desk_park_html(PU, X.opened_at, DueH0, DueH),
    desk_head(TH, SrcH, Owner, DueH, Head),
    (   Res == true -> desk_reserve_source(X.reserved, Src), desk_policy_html(HD, X, Src, PolH) ; PolH = "" ),
    (   Ks == [] -> Rests = "<p class=\"quiet\">No KB: this ask rests on what its notes say.</p>"
    ;   findall(RH, ( member(K, Ks), ( desk_eng(K.dir, Eng) -> desk_ask_claims(Eng, X, Cs) ; Cs = [] ),
                      desk_rests_html(HD, K, Cs, RH) ), RHs), dk_cat(RHs, Rests)
    ),
    desk_ask_why(HD, X, Owner, Why),
    desk_ctx_html(Rests, Why, Ctx),
    format(string(Item), "ask:~w", [X.id]), dk_f("~w|~w", [HD.name, Item], Key),
    desk_item_letters2(HD, ask(X.id), LLs),
    desk_led_intents(ask, Ints), desk_until_html(UntilH),
    desk_form_html(HD, Item, Key, Owner, LLs, UntilH, Ints, Form),
    desk_anchor_of(HD, Item, Anchor),
    desk_sheet(Mode, Anchor, Res, Head, PolH, Ctx, Form, Html).

% ---- the Ledger lane (c32, Ty, 2026-11-18: ledger items get their own lane, with buttons that match
% the ledger): the asks for Ty (above), and each open item in a session's inbox.

% desk_led_intents(+What, -Intents): an ask for Ty is answered; every ledger item can be closed,
% parked until a date, or get a note to the session that holds it.
desk_led_intents(ask, [answer-"Answer", close-"Close it", park-"Park it until the date", note-"Note to the session"]).
desk_led_intents(item, [close-"Close it", park-"Park it until the date", note-"Note to the session"]).

desk_until_html(Html) :-
    dk_f("<label class=\"until\"><span class=\"small quiet\">Park until</span> <input type=\"date\" name=\"until\" aria-label=\"Park until this date\"></label>", [], Html).

% desk_led_kind(+Kind, -Label): Ledger handoff, Ledger thread, ...
desk_led_kind(K0, L) :- dk_str(K0, K), dk_f("Ledger ~w", [K], L).

% desk_inbox_items(+HD, -Items): S-I for each open item I in the inbox of session S that is not an ask
% for Ty (those have their own card), each item once.
desk_inbox_items(HD, Items) :-
    (   is_dict(HD.st)
    ->  findall(I, ( member(X, HD.st.sessions), get_dict(inbox, X, Ib), member(I0, Ib), I = X.name-I0 ), Is0),
        findall(Id, ( desk_ask_for_me(HD, A), Id = A.id ), Mine),
        desk_inbox_dedup(Is0, Mine, [], Items)
    ;   Items = []
    ).

desk_inbox_dedup([], _, _, []).
desk_inbox_dedup([S-I|T], Mine, Seen, Out) :-
    get_dict(id, I, Id),
    (   ( memberchk(Id, Seen) ; memberchk(Id, Mine) ) -> Out = Out1 ; Out = [S-I|Out1] ),
    desk_inbox_dedup(T, Mine, [Id|Seen], Out1).

desk_inbox_cards(HDs, HD, Cards) :-
    desk_inbox_items(HD, Items),
    findall(C, ( member(S-I, Items), catch(desk_inbox_card(HDs, HD, S, I, C), E, desk_card_error(HD, I.id, E, C)) ), Cards).

desk_led_anchor(HD, Id, A) :-
    (   desk_ask_for_me(HD, X), X.id == Id -> dk_f("ask:~w", [Id], It) ; dk_f("led:~w", [Id], It) ),
    desk_anchor_of(HD, It, A).

desk_inbox_card(HDs, HD, S, I, card{lane:Lane, due:"", html:Html, kbs:KDs, hub:HD.path, until:PU, pdue:PDue}) :-
    ( get_dict(pdue, I, PDue0), string(PDue0) -> PDue = PDue0 ; PDue = "" ),
    desk_parked(I, Lane, inbox, PU),
    esc(I.title, TH), desk_led_kind(I.kind, KL), esc(KL, KLH), esc(I.id, IH), esc(S, SH),
    ( dk_str(I.get(from, ""), Fr), Fr \== "" -> esc(Fr, FrH), dk_f(", from ~w", [FrH], FromH) ; FromH = "" ),
    ( get_dict(kbs, I, Refs0), is_list(Refs0) -> Refs = Refs0 ; Refs = [] ),
    findall(K, ( member(R, Refs), dk_str(R, RS), desk_kb_by_ref(HD, RS, K) ), Ks), findall(KD, ( member(K, Ks), get_dict(dir, K, KD) ), KDs),
    desk_hub_suffix(HDs, HD, HS),
    ( get_dict(unaccepted, I, true) -> AccH = "<span class=\"gapnote\">Not accepted yet</span>" ; AccH = "" ),
    dk_f("<span>~w ~w, held by ~w~w~w</span>~w", [KLH, IH, SH, FromH, HS, AccH], SrcH),
    atom_string(Owner, S),
    dk_str(I.get(opened_at, ""), Op), desk_due_html("", none, Op, DueH0), desk_park_html(PU, Op, DueH0, DueH),
    desk_head(TH, SrcH, Owner, DueH, Head),
    (   Ks == [] -> Rests = "<p class=\"quiet\">No KB: this item rests on what its notes say.</p>"
    ;   findall(L, ( member(K, Ks), esc(K.label, LH), dk_f("<p><a class=\"kblink\" href=\"#~w\">The KB ~w</a></p>", [K.anchor, LH], L) ), Ls), dk_cat(Ls, Rests)
    ),
    (   dk_str(I.get(note, ""), N), N \== "" -> esc(N, NH), dk_f("<p class=\"note\">~w</p>", [NH], NoteH) ; NoteH = "<p class=\"quiet\">No note.</p>" ),
    dk_str(I.get(age_days, ""), Age), dk_str(I.get(idle_days, ""), Idle),
    dk_f("~w<p class=\"small quiet\">Open ~w days, idle ~w days. Close and Park change the ledger at once, as you; Note sends ~w a letter.</p>", [NoteH, Age, Idle, SH], Why),
    desk_ctx_html(Rests, Why, Ctx),
    dk_f("led:~w", [I.id], Item), dk_f("~w|~w", [HD.name, Item], Key),
    desk_item_letters2(HD, ask(I.id), LLs),
    desk_led_intents(item, Ints), desk_until_html(UntilH),
    desk_form_html(HD, Item, Key, Owner, LLs, UntilH, Ints, Form),
    desk_anchor_of(HD, Item, Anchor),
    desk_sheet(row, Anchor, false, Head, "", Ctx, Form, Html).

% desk_parked(+X, -Lane, +Lane0, -Until) (c36, c37, Ty, 2026-11-18: "Parked groups, not counted"): an
% item whose park has not ended goes to the lane parked (no count, no Your action), with the end of
% its park; once the park ends, the reader says parked false and the item is back in Lane0 by itself.
desk_parked(X, Lane, Lane0, PU) :-
    (   get_dict(parked, X, true), get_dict(parked_until, X, PU0), dk_str(PU0, PU), PU \== "" -> Lane = parked
    ;   Lane = Lane0, PU = ""
    ).

% desk_park_html(+Until, +Opened, +DueH0, -DueH): a parked card says Parked until DATE in place of its due date.
desk_park_html("", _, DueH, DueH) :- !.
desk_park_html(PU, Opened, _, Html) :-
    dk_day(PU, PD), esc(PU, PUH), dk_str(Opened, Op),
    (   Op \== "" -> dk_day(Op, OD), dk_f("<span>Opened ~w</span>", [OD], OH) ; OH = "" ),
    dk_f("<div class=\"due parked\" data-until=\"~w\" title=\"Parked in the ledger: out of the counts until this day ends\"><strong>Parked until ~w</strong>~w</div>", [PUH, PD, OH], Html).

% desk_by_until(-O, +A, +B) (c36, c41; Ty, 2026-11-18: "Park end, then due"): the soonest end of park first;
% among parks that end the same day, the soonest --due date (the asker's, never the computed triage
% date), and an item with no --due date last; then the page order.
desk_park_day(C, D) :- get_dict(until, C, U), ( sub_string(U, 0, 10, _, D0) -> D = D0 ; D = U ).
desk_by_until(O, A, B) :-
    desk_park_day(A, UA), desk_park_day(B, UB),
    ( A.pdue == "" -> DA = "9999" ; DA = A.pdue ), ( B.pdue == "" -> DB = "9999" ; DB = B.pdue ),
    compare(O0, UA-DA, UB-DB),
    ( O0 == (=) -> compare(O1, A.html, B.html), ( O1 == (=) -> O = (<) ; O = O1 ) ; O = O0 ).

desk_anchor_of(HD, Item, A) :-
    dk_f("~w ~w", [HD.name, Item], S), string_codes(S, Cs),
    maplist([C, D]>>( code_type(C, alnum) -> D = C ; D = 0'- ), Cs, Ds), atom_codes(A0, Ds), atom_concat('item-', A0, A).

desk_policy_html(_, _, policy(N, R), Html) :- !, esc(N, NH), esc(R, RH),
    dk_f("<div class=\"policy\"><strong>~w:</strong> ~w</div>", [NH, RH], Html).
desk_policy_html(_, _, words(W, D, T), Html) :- !, esc(W, WH), dk_day(D, DD), esc(T, TH),
    dk_f("<div class=\"policy\"><strong>~w, ~w:</strong> “~w”</div>", [WH, DD, TH], Html).
desk_policy_html(HD, X, unnamed(T), Html) :-
    esc(T, TH), dk_f("fix:source:~w", [X.id], It),
    desk_fix_link(HD.path, It, "Ask its owner to name the source", FB),
    dk_f("<div class=\"policy unnamed\"><strong>Source not named:</strong> ~w ~w</div>", [TH, FB], Html).

% desk_ask_why(+HD, +X, +Owner, -Html): the notes of the ask (the case, the options, the default, as
% the asker wrote them), and its other refs. With no note: say so, with a fix.
desk_ask_why(HD, X, Owner, Html) :-
    findall(P, ( member(N, X.notes), esc(N.note, NH), dk_str(N.by_session, BS0), ( BS0 == "" -> dk_str(N.by, BS) ; BS = BS0 ),
                 dk_day(N.at, AD), esc(BS, BH),
                 dk_f("<p class=\"note\">~w<span class=\"by\">~w, ~w</span></p>", [NH, BH, AD], P) ), Ps),
    findall(R, ( member(RS, X.refs), \+ string_concat("kb:", _, RS), esc(RS, RH),
                 ( string_concat("url:", U, RS) -> esc(U, UH), dk_f("<li><a href=\"~w\" rel=\"noreferrer\">~w</a></li>", [UH, UH], R)
                 ; dk_f("<li>~w</li>", [RH], R) ) ), Rs),
    ( Rs == [] -> RsH = "" ; dk_cat(Rs, R0), dk_f("<h4>It points to</h4><ul>~w</ul>", [R0], RsH) ),
    (   Ps == []
    ->  dk_f("fix:context:~w", [X.id], It),
        ( Owner == none -> Who = "its owner" ; atom_string(Owner, Who) ),
        dk_f("Ask ~w for the context", [Who], FL), desk_fix_link(HD.path, It, FL, FB),
        dk_f("<p class=\"gapnote\">The asker recorded only the title: no case, no options, no default. ~w</p>", [FB], NoteH)
    ;   dk_cat(Ps, NoteH)
    ),
    dk_cat([NoteH, RsH], Html).

% desk_open_questions(+Eng, -Qs): each question that waits on Ty: no human answered it, nobody waived
% it, and its claim or hypothesis is current. One with a default runs on a guess; one with none
% blocks the work that needs it (to_ask of the core is the narrower set of a contested claim).
desk_open_questions(Eng, Qs) :-
    dk_all(Eng, [Q, C], question(Q, C, _), QCs),
    findall(Q, ( member([Q, C], QCs), \+ dk_true(Eng, answered(Q)), \+ dk_true(Eng, question_waived(Q)),
                 \+ dk_true(Eng, supersedes(_, C)) ), Qs0), sort(Qs0, Qs).

% desk_question_cards(+HDs, +HD, +K, -Cards) (c13, c21): each question of the KB to ask now. A
% question that a ledger ask owns is the ask's card; one that a tracker item owns says so.
desk_question_cards(HDs, HD, K, Cards) :-
    (   desk_eng(K.dir, Eng)
    ->  desk_open_questions(Eng, Qs),
        findall(C, ( member(Q, Qs), \+ dk_true(Eng, question_pin(Q, ledger, _, _, _)),
                     desk_question_card(HDs, HD, K, Eng, Q, C) ), Cards)
    ;   Cards = []
    ).

desk_question_card(HDs, HD, K, Eng, Q, card{lane:Lane, due:Due, html:Html, kbs:[K.dir], hub:HD.path}) :-
    dk_all(Eng, [C0, T0], question(Q, C0, T0), [[C, T]|_]), txt(T, TT), esc(TT, TH),
    ( dk_all(Eng, [A], assumed(Q, A), [A1|_]) -> plain_text(A1, Def), Lane = guess ; Def = none, Lane = questions ),
    esc(K.label, LH), desk_hub_suffix(HDs, HD, HS),
    (   Def == none -> DefH = "" ; esc(Def, DfH), dk_f("<span class=\"default\">Default: <b>~w</b></span>", [DfH], DefH) ),
    dk_f("<span>Question ~w in the KB ~w~w</span>~w", [Q, LH, HS, DefH], SrcH),
    desk_holder(HD, K, Owner, _),
    ( dk_all(Eng, [D], due(Q, D), [D1|_]) -> dk_str(D1, Due), How = asker ; Due = "", How = none ),
    desk_due_html(Due, How, "", DueH),
    desk_head(TH, SrcH, Owner, DueH, Head),
    ( dk_true(Eng, claim(C, _, _)) -> Cs = [C] ; Cs = [] ),
    desk_rests_html(HD, K, Cs, Rests),
    desk_question_why(Eng, Q, C, Def, Why),
    desk_ctx_html(Rests, Why, Ctx),
    dk_f("q:~w#~w", [K.dir, Q], Item), dk_f("~w|~w", [HD.name, Item], Key),
    desk_item_json(HD, K, question, Q, J), desk_item_letters2(HD, kbitem(J), LLs),
    (   pending_for_question(K.dir, Q)
    ->  Form = "<p class=\"quiet\">Your answer waits in the KB's answers.pending: the holder's next write applies it.</p>"
    ;   dk_all(Eng, [Kd, Rf], question_pin(Q, Kd, Rf, _, _), Pins), last(Pins, [tracker, Rf1])
    ->  plain_text(Rf1, RfT), esc(RfT, RfH),
        dk_f("<p class=\"quiet\">The tracker item ~w owns this question: answer it there.</p>", [RfH], Form)
    ;   desk_question_choices(Eng, Q, Def, Chs), desk_opts_html(Chs, Key, OptsH),
        desk_intents(Ints), desk_form_html(HD, Item, Key, Owner, LLs, OptsH, Ints, Form)
    ),
    desk_anchor_of(HD, Item, Anchor),
    desk_sheet(row, Anchor, false, Head, "", Ctx, Form, Html).

% desk_question_choices(+Eng, +Q, +Def, -Cs): the default, an agent's answer, each option with its
% effect, then other (D24 C7: the page adds no option of its own).
desk_question_choices(Eng, Q, Def, Cs) :-
    dk_all(Eng, [OT, OE], option(Q, OT, OE), OFs0),
    findall(T-E, ( member([T0, E0], OFs0), plain_text(T0, T), plain_text(E0, E) ), OFs),
    findall(AT, ( dk_all(Eng, [A2, By], answer(Q, A2, By), Ans), member([A3, By3], Ans), By3 \== human, By3 \= human:_,
                  plain_text(A3, AT), AT \== Def ), Ats0), list_to_set(Ats0, Ats),
    findall(Def-E-"the default", ( Def \== none, ( memberchk(Def-E, OFs) -> true ; E = "" ) ), DL),
    findall(T-E-"an agent's answer", ( member(T, Ats), ( memberchk(T-E, OFs) -> true ; E = "" ) ), AL),
    findall(T-E-"", ( member(T-E, OFs), T \== Def, \+ memberchk(T, Ats) ), OL),
    append([DL, AL, OL, ["other"-"Write your own answer below."-""]], Cs).

desk_question_why(Eng, Q, C, Def, Html) :-
    findall(P, ( dk_all(Eng, [N], note(Q, N), Ns), member(N1, Ns), txt(N1, NT), esc(NT, NH), dk_f("<p class=\"note\">~w</p>", [NH], P) ), P1),
    findall(P, ( dk_all(Eng, [X], cites(C, X), Xs), member(X1, Xs), txt(X1, XT), esc(XT, XH), dk_f("<p class=\"note\">The request: “~w”</p>", [XH], P) ), P2),
    findall(P, ( dk_all(Eng, [E], example(C, E), Es), member(E1, Es), txt(E1, ET), esc(ET, EH), dk_f("<p class=\"note\"><span class=\"by\">Example of ~w</span>~w</p>", [C, EH], P) ), P3),
    (   Def == none -> P4 = ["<p class=\"gapnote\">No default: the work that needs this answer waits for you.</p>"]
    ;   esc(Def, DH), dk_f("<p>The work goes on with the default, <b>~w</b>, until you answer.</p>", [DH], P4a), P4 = [P4a]
    ),
    append([P1, P2, P3, P4], Ps), dk_cat(Ps, Html).

% ---- H-0043 (Ty, 2026-11-18: "For flares when there is an image included, we need to render it on
% this website."): the card of a demo shows the image. The Desk serves a demo file only when its
% page showed it in this run (desk_demo_shown/2), only an image, and only with the token of the page.
:- dynamic desk_demo_shown/2.

desk_demo_type(P, Type) :-
    file_name_extension(_, E0, P), downcase_atom(E0, E),
    memberchk(E-Type, [png-'image/png', jpg-'image/jpeg', jpeg-'image/jpeg', gif-'image/gif',
                       webp-'image/webp', avif-'image/avif', svg-'image/svg+xml']).

desk_demo_abs(Dir, P, Abs) :- ( is_absolute_file_name(P) -> Abs = P ; directory_file_path(Dir, P, Abs) ).

% desk_demo_html(+Dir, +Eng, +C, +S, +P, -Html): the demo on its card: the image when it is one, else its name.
desk_demo_html(Dir, Eng, C, S, P, Html) :-
    esc(P, PH),
    (   dk_true(Eng, demo_changed(S))
    ->  dk_f(" <span class=\"loud\">~w changed since the KB recorded its digest: this is not the file that the demo names. Ask for a new demo before you approve.</span>", [PH], ChH)
    ;   ChH = ""
    ),
    (   desk_demo_type(P, _), desk_demo_abs(Dir, P, Abs), exists_file(Abs), serve_conf(token, Tok)
    ->  ( desk_demo_shown(Dir, S) -> true ; assertz(desk_demo_shown(Dir, S)) ),
        maplist([X, Y]>>uri_encoded(query_value, X, Y), [Tok, Dir, S], [TE, DE, SE]),
        dk_f("/demo?token=~w&kb=~w&s=~w", [TE, DE, SE], Url), esc(Url, UH),
        dk_f("The demo ~w of claim ~w: ~w", [S, C, P], Alt), esc(Alt, AltH),
        dk_f("<figure class=\"demo\"><a href=\"~w\" target=\"_blank\" rel=\"noopener\" title=\"Open the image at full size\"><img src=\"~w\" alt=\"~w\" loading=\"lazy\"></a><figcaption class=\"small quiet\">The demo: <code>~w</code> in the KB folder. Click the image for full size.~w</figcaption></figure>", [UH, UH, AltH, PH, ChH], Html)
    ;   dk_f("<p>The demo: <code>~w</code> in the KB folder.~w</p>", [PH, ChH], Html)
    ).

% desk_demo_file(+Form, -Abs, -Type): the file of GET /demo, when the page showed it and it is an image.
desk_demo_file(Form, Abs, Type) :-
    serve_field(Form, kb, DirS), serve_field(Form, s, SS),
    atom_string(Dir, DirS), atom_string(S, SS),
    desk_demo_shown(Dir, S),
    desk_eng(Dir, Eng),
    dk_all(Eng, [P], ( demo(S, _), subject(S, P, _) ), [P|_]), atom(P),
    desk_demo_type(P, Type),
    desk_demo_abs(Dir, P, Abs), exists_file(Abs).

% desk_action_cards(+HDs, +HD, +K, -Cards) (c12): the KB actions that a policy keeps for Ty.
desk_action_cards(HDs, HD, K, Cards) :-
    (   desk_eng(K.dir, Eng)
    ->  findall(A, desk_kb_action(Eng, A), As),
        findall(C, ( member(A, As), desk_action_card(HDs, HD, K, Eng, A, C) ), Cards)
    ;   Cards = []
    ).

desk_action_card(HDs, HD, K, Eng, A, card{lane:action, due:"", html:Html, kbs:[K.dir], hub:HD.path}) :-
    desk_action_ref(A, RefS), esc(K.label, LH), desk_hub_suffix(HDs, HD, HS),
    (   A == vote -> PolK = vote, dk_f("Vote on the hypothesis of the KB ~w", [K.label], T0),
        dk_f("<span>The vote that ends discovery, in the KB ~w~w</span>", [LH, HS], SrcH),
        desk_current_claims(Eng, Cs),
        Chs = ["GO"-"Build goes on from this hypothesis and its claims."-"", "NO-GO"-"Nothing is built; the ticket ends."-"", "HOLD"-"Discovery goes on; say what it waits for."-""]
    ;   A = demo(C, S, P) -> PolK = demo, dk_f("Approve the demo of claim ~w, or say what is not right", [C], T0),
        esc(P, PH), dk_f("<span>Demo ~w of claim ~w in the KB ~w~w</span><span>~w</span>", [S, C, LH, HS, PH], SrcH),
        Cs = [C], Chs = ["Approve the demo"-"The claim closes for its demo."-""]
    ;   A = waiver(W) -> PolK = waiver, dk_f("The waiver ~w lapsed: renew it, or let the work come back", [W], T0),
        dk_f("<span>Waiver ~w in the KB ~w~w</span>", [W, LH, HS], SrcH),
        ( dk_all(Eng, [X], attest(W, waiver, _, waive(X, _, _), _, _), [X1|_]), dk_true(Eng, claim(X1, _, _)) -> Cs = [X1] ; Cs = [] ),
        Chs = ["Renew the waiver"-"Say until when in your words: the skip needs a due time."-"", "Let the work come back"-"The waived item blocks again."-""]
    ),
    esc(T0, TH),
    desk_holder(HD, K, Owner, _),
    desk_due_html("", none, "", DueH),
    desk_head(TH, SrcH, Owner, DueH, Head),
    desk_policy(PolK, PN, PR, PF), esc(PN, PNH), esc(PR, PRH), esc(PF, PFH),
    dk_f("<div class=\"policy\"><strong>~w:</strong> ~w <span class=\"quiet\">From ~w.</span></div>", [PNH, PRH, PFH], PolH),
    desk_rests_html(HD, K, Cs, Rests0),
    desk_policy_why(PolK, Why0),
    % c26 (Ty, 2026-11-18: "Lets put the images in the right side of the card to save on vertical
    % space."): the demo sits in the right column, under Why you, why now.
    (   A = demo(C2, S2, P2) -> desk_demo_html(K.dir, Eng, C2, S2, P2, DemoH), dk_f("~w~w", [Why0, DemoH], Why) ; Why = Why0 ),
    desk_ctx_html(Rests0, Why, Ctx),
    dk_f("act:~w#~w", [K.dir, RefS], Item), dk_f("~w|~w", [HD.name, Item], Key),
    desk_item_json(HD, K, kb, RefS, J), desk_item_letters2(HD, kbitem(J), LLs),
    desk_opts_html(Chs, Key, OptsH), desk_intents(Ints),
    desk_form_html(HD, Item, Key, Owner, LLs, OptsH, Ints, Form),
    desk_anchor_of(HD, Item, Anchor),
    desk_sheet(open, Anchor, true, Head, PolH, Ctx, Form, Html).

desk_policy_why(vote, "<p>Discovery is ready: the system was checked for the hypothesis, each claim has its example and the result that would show it false, and nothing else waits for you.</p>").
desk_policy_why(demo, "<p>The claim is visual: no test can say that it looks and works as you want. Open the demo, then approve it, or say what is not right.</p>").
desk_policy_why(waiver, "<p>You skipped this work with a waiver, and its due time passed. Until you renew it, the work is back.</p>").

% ---- the page

desk_page(Msg, Page) :- desk_page(Msg, "", Page).

% desk_page(+Msg, +Tab, -Page) (c28, Ty, 2026-11-18: "use tabs for each mindhole instead of a
% dropdown"): with two or more mindholes, one tab per mindhole and a last tab All. A tab shows
% only its mindhole: counts, lanes and rail. The first mindhole's tab opens when none is named.
desk_page(Msg0, Tab0, Page) :-
    serve_conf(token, Token), lib_dir(Lib),
    page_asset(Lib, 'desk/desk.css', Css), page_asset(Lib, 'desk/desk.js', Js),
    desk_load(HDs0, Missing),
    desk_drafts_load(HDs0),
    desk_tab_pick(HDs0, Tab0, HDs, Tab, Msg0, Msg),
    desk_tabs_html(HDs0, Tab, TabsH),
    findall(C, ( member(HD, HDs), desk_hub_cards(HDs, HD, Cs), member(C, Cs) ), Cards),
    include([C]>>get_dict(lane, C, action), Cards, Act),
    include([C]>>get_dict(lane, C, questions), Cards, Qs0), predsort(desk_by_due, Qs0, Qs),
    include([C]>>get_dict(lane, C, guess), Cards, Gs),
    % c32: the Ledger lane: the asks for Ty (reserved first, then soonest due), then each session's open items
    include([C]>>get_dict(lane, C, ledger), Cards, LA0), partition([C]>>( get_dict(html, C, CH), sub_string(CH, _, _, _, "sheet reserved") ), LA0, LAr, LAo0),
    predsort(desk_by_due, LAo0, LAo), append(LAr, LAo, LAs), include([C]>>get_dict(lane, C, inbox), Cards, LIs),
    length(LAs, NL), length(LIs, NLI), NLed is NL + NLI,
    % c36 (Ty, 2026-11-18: "Parked groups, not counted ... at the bottom by nearest due date ascending")
    include([C]>>get_dict(lane, C, parked), Cards, LP0), predsort(desk_by_until, LP0, LPs),
    desk_parked_group(LPs, LPG),
    % c35 (Ty, 2026-11-18: "Both: Your action too"): Your action also lists each reserved ledger ask, as a link to its card
    findall(card{html:LH}, ( member(C, LAr), esc(C.title, LT), esc(C.id, LI),
                             dk_f("<a class=\"actlink\" href=\"#~w\"><span class=\"t\">~w</span><span class=\"small quiet\">Ledger ask ~w, reserved for you. Its card is in the Ledger lane.</span></a>", [C.anchor, LT, LI], LH) ), ActLinks),
    length(ActLinks, NAL),
    length(Act, NA), length(Qs, NQ), length(Gs, NG),
    ( HDs = [_, _|_] -> nb_setval(desk_multi, true) ; nb_setval(desk_multi, false) ),
    findall(HD-R, ( member(HD, HDs), desk_orphan_rows(HD, Rs), member(R, Rs) ), ORows), length(ORows, NO),
    findall(P, ( member(HD, HDs), desk_project_items(HD, Ps), member(P, Ps) ), PItems), length(PItems, NP),
    findall(A, ( member(HD, HDs), desk_answered(HD, As), member(A, As) ), Answered), length(Answered, NAns),
    findall(K-HD, ( member(HD, HDs), member(K, HD.kbs) ), AllKBs), length(AllKBs, NK),
    % the header (c13: the first due date, not an age)
    NW is NA + NQ + NL, NAct is NA + NAL,
    findall(Du, ( member(C, Cards), \+ get_dict(lane, C, parked), Du = C.due, Du \== "" ), Ds), ( Ds == [] -> FirstH = "" ; min_member(D1, Ds), dk_day(D1, DD), dk_f(" The first is due on ~w.", [DD], FirstH) ),
    ( NW == 1 -> WT = "thing waits" ; WT = "things wait" ),
    dk_f("<p><strong>~w ~w on you,</strong> and ~w run on a guess.~w</p>", [NW, WT, NG, FirstH], SumH),
    findall(L, ( member(Id-Lb-N, [lane-action-"Your action"-NAct, lane-ledger-"Ledger"-NLed, lane-questions-"Questions"-NQ, lane-guesses-"Running on a guess"-NG,
                                  lane-project-"Project KB"-NP, lane-orphans-"Orphaned"-NO, lane-answered-"Answered"-NAns, lane-kbs-"KBs"-NK]),
                 Id = lane-Nm, dk_f("<a href=\"#lane-~w\">~w<b>~w</b></a>", [Nm, Lb, N], L) ), Ls),
    dk_cat(Ls, LanesH),
    % the lanes (c2: open on load only with an item for Ty)
    % c22: one thing open on load: the first card of the first lane that holds one, and that lane
    (   Act = [_|_] -> Act1 = Act, Qs1 = Qs, Gs1 = Gs, LAs1 = LAs, OA = true, OL = false, OQ = false, OG = false
    ;   LAs = [_|_] -> Act1 = Act, Qs1 = Qs, Gs1 = Gs, desk_open_first(LAs, LAs1), OA = false, OL = true, OQ = false, OG = false
    ;   Qs = [_|_] -> Act1 = Act, desk_open_first(Qs, Qs1), Gs1 = Gs, LAs1 = LAs, OA = false, OL = false, OQ = true, OG = false
    ;   Act1 = Act, Qs1 = Qs, LAs1 = LAs, desk_open_first(Gs, Gs1), OA = false, OL = false, OQ = false, OG = true
    ),
    append([LAs1, LIs, LPG], Led),
    ( OA == true -> desk_open_first(Act, Act2) ; Act2 = Act1 ),
    append(Act2, ActLinks, ActAll),
    desk_lane("action", "Your action", "Only what a policy or your own words keep for you", ActAll, "Nothing waits for an action that only you may take.", OA, ActH),
    desk_lane("ledger", "Ledger", "The asks that wait on you, then the open items each session holds; these buttons act on the ledger", Led, "Nothing in the ledger waits on you, and no session holds an open item.", OL, LedH),
    desk_lane("questions", "Questions", "KB questions with no default, soonest due first", Qs1, "No KB question waits on you.", OQ, QsH),
    desk_lane("guesses", "Running on a guess", "KB questions with a default: the work goes on with it until you answer", Gs1, "No work runs on a guess.", OG, GsH),
    desk_project_lane(HDs, PItems, PrH),
    desk_orphan_lane(ORows, OrH),
    desk_answered_lane(Answered, AnH),
    desk_kbs_lane(HDs, AllKBs, KbH),
    ( HDs = [_] -> Unwrap = true ; Unwrap = false ),
    desk_rail(HDs, Cards, Missing, Unwrap, RailH),
    (   Msg == "" -> MsgH = "" ; esc(Msg, M0), dk_f("<p class=\"banner\">~w</p>", [M0], MsgH) ),
    findall(E, ( member(HD, HDs), ( HD.err = some(M) ; \+ is_dict(HD.st), HD.st = error(M) ), esc(HD.name, NH), esc(M, MH),
                 dk_f("<p class=\"banner error\">~w: ~w</p>", [NH, MH], E) ), Es),
    dk_cat(Es, ErrH),
    ( HDs == [] -> NoneH = "<p class=\"banner\">No mindhole has joined the Desk. In a mindhole, run: python3 .claude/scripts/desk.py join</p>" ; NoneH = "" ),
    esc(Token, TokH), esc(Tab, TabAH),
    format(string(Page),
"<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">
<title>The Desk</title>
<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
<link href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap\" rel=\"stylesheet\">
<style>~w</style>
</head>
<body data-token=\"~w\" data-tab=\"~w\">
<header class=\"top\"><h1>The Desk</h1>~w<nav class=\"lanes\" aria-label=\"Lanes\">~w</nav><div class=\"folds\"><button type=\"button\" class=\"btn small\" data-folds=\"open\">Expand all</button><button type=\"button\" class=\"btn small\" data-folds=\"close\">Collapse all</button></div></header>
~w
~w~w~w
<div class=\"layout\">
<aside class=\"rails\" aria-label=\"Where things live\">~w</aside>
<main>
~w
~w
~w
~w
~w
~w
~w
~w
<p class=\"foottext\">Live: each reload reads the ledgers and the KBs again. What you type is a draft in the Desk's own store, outside every mindhole; no agent reads it. Each send opens a review first, and a session gets only its own letter, at its next stop or prompt.</p>
</main>
</div>
<dialog id=\"review\" aria-label=\"Review before sending\"><div class=\"dlgbody\"></div></dialog>
<script>~w</script>
</body>
</html>
", [Css, TokH, TabAH, SumH, LanesH, TabsH, MsgH, ErrH, NoneH, RailH, ActH, LedH, QsH, GsH, PrH, OrH, AnH, KbH, Js]).

desk_by_due(O, A, B) :-
    ( A.due == "" -> KA = "9999" ; KA = A.due ), ( B.due == "" -> KB = "9999" ; KB = B.due ),
    compare(O0, KA, KB), ( O0 == (=) -> compare(O1, A.html, B.html), ( O1 == (=) -> O = (<) ; O = O1 ) ; O = O0 ).

desk_hub_cards(HDs, HD, Cards) :-
    findall(C, ( desk_ask_for_me(HD, X), catch(desk_ask_card(HDs, HD, X, C), E, desk_card_error(HD, X.id, E, C)) ), C1),
    findall(C, ( member(K, HD.kbs), K.kind \== project,
                 catch(desk_action_cards(HDs, HD, K, Cs), E, ( desk_card_error(HD, K.label, E, CE), Cs = [CE] )), member(C, Cs) ), C2),
    findall(C, ( member(K, HD.kbs),
                 catch(desk_question_cards(HDs, HD, K, Cs), E, ( desk_card_error(HD, K.label, E, CE), Cs = [CE] )), member(C, Cs) ), C3),
    desk_inbox_cards(HDs, HD, C4),
    append([C1, C2, C3, C4], Cards).

% desk_waits(+Card): the card waits on Ty (the count of the header, the tabs and the rail, c28).
desk_waits(C) :- get_dict(lane, C, L), memberchk(L, [action, questions, ledger]).

desk_card_error(HD, What, E, card{lane:questions, due:"", html:Html, kbs:[], hub:HD.path}) :-
    serve_err_text(E, M), esc(M, MH), esc(What, WH),
    dk_f("<div class=\"sheet\"><div class=\"head\"><p class=\"loud\">The Desk could not show ~w: ~w</p></div></div>", [WH, MH], Html).

% desk_hooks_missing(+HD, -Events) (c24): the hook events that no settings file of the mindhole gives
% to desk.py hook. While one is missing, no letter reaches a session of that mindhole.
desk_hooks_missing(HD, Ms) :-
    (   is_dict(HD.st), get_dict(hooks_missing, HD.st, Ms0), is_list(Ms0) -> Ms = Ms0 ; Ms = [] ).

desk_hooks_warning(HD, To, Ms, Html) :-
    dk_join(Ms, ", ", MJ), esc(HD.name, NH),
    dk_f("<p class=\"warn loud\">~w will not be told: the desk hooks are not installed in ~w (no hook for ~w). What you send is stored, and it reaches ~w once the hooks are in its settings (desk.py hooks prints them).</p>", [To, NH, MJ, To], Html).

desk_open_first([], []).
desk_open_first([C|Cs], [C1|Cs]) :-
    (   sub_string(C.html, B, _, A, "<details class=\"sheet") -> sub_string(C.html, 0, B, _, Pre), sub_string(C.html, _, A, 0, Post),
        dk_cat([Pre, "<details open class=\"sheet", Post], H1), C1 = C.put(html, H1)
    ;   C1 = C
    ).

desk_lane(Id, Head, Sub, Cards, Empty, OpenIfAny, Html) :-
    (   Cards == [] -> dk_f("<p class=\"empty\">~w</p>", [Empty], Body), Op = ""
    ;   findall(H, ( member(C, Cards), H = C.html ), Hs),
        dk_cat(Hs, Body), ( OpenIfAny == true -> Op = " open" ; Op = "" )
    ),
    dk_f("<details class=\"lane\" id=\"lane-~w\"~w><summary><h2>~w</h2><span class=\"quiet\">~w</span></summary><div class=\"lanebody\">~w</div></details>", [Id, Op, Head, Sub, Body], Html).

% ---- the rail (c14): where things live, and the sessions

% desk_parked_group(+Cards, -Group): [] with no parked item, else one pseudo card: a closed group
% Parked N that holds the parked cards (c36).
desk_parked_group([], []) :- !.
desk_parked_group(LPs, [card{html:H}]) :-
    length(LPs, N), findall(CH, ( member(C, LPs), get_dict(html, C, CH) ), CHs), dk_cat(CHs, Body),
    dk_f("<details class=\"parked\" id=\"lane-ledger-parked\"><summary><span class=\"pname\">Parked</span> <b>~w</b> <span class=\"small quiet\">Not counted. Each comes back by itself when its park ends, soonest first.</span></summary>~w</details>", [N, Body], H).

% desk_tab_pick(+HDs0, +Tab0, -HDs, -Tab, +Msg0, -Msg) (c28): the mindholes of the tab. Tab is the
% name of a mindhole, "all", or "" (one mindhole, or no mindhole).
desk_tab_pick(HDs0, Tab0, HDs, Tab, Msg0, Msg) :-
    (   HDs0 = [_, _|_]
    ->  (   Tab0 == "all" -> HDs = HDs0, Tab = "all", Msg = Msg0
        ;   member(HD, HDs0), dk_str(HD.name, N), N == Tab0 -> HDs = [HD], Tab = N, Msg = Msg0
        ;   HDs0 = [HD|_], HDs = [HD], dk_str(HD.name, Tab),
            ( Tab0 == "" -> Msg = Msg0 ; dk_f("No mindhole is named ~w on this Desk. It shows ~w.", [Tab0, Tab], Msg) )
        )
    ;   HDs = HDs0, Tab = "", Msg = Msg0
    ).

% desk_tabs_html(+HDs0, +Tab, -Html) (c28): one tab per mindhole with what waits on Ty there, then All.
desk_tabs_html(HDs0, Tab, Html) :-
    (   HDs0 = [_, _|_]
    ->  findall(N-W, ( member(HD, HDs0), dk_str(HD.name, N), desk_hub_cards([HD], HD, Cs),
                       include(desk_waits, Cs, Ws), length(Ws, W) ), NWs),
        foldl([_-W, A0, A1]>>( A1 is A0 + W ), NWs, 0, Total),
        append(NWs, ["All"-Total], Ts),
        findall(A, ( member(N-W, Ts), ( N == "All" -> Key = "all" ; Key = N ),
                     ( Key == Tab -> Cur = " aria-current=\"page\" class=\"on\"" ; Cur = "" ),
                     uri_encoded(query_value, Key, KE), esc(N, NH), ( W > 0 -> Hot = " hot" ; Hot = "" ),
                     dk_f("<a href=\"/?mh=~w\"~w><span>~w</span><b class=\"num~w\">~w</b></a>", [KE, Cur, NH, Hot, W], A) ), As),
        dk_cat(As, AsH),
        dk_f("<nav class=\"mhtabs\" aria-label=\"Mindholes\">~w</nav>", [AsH], Html)
    ;   Html = ""
    ).

desk_rail(HDs, Cards, Missing, Html) :- desk_rail(HDs, Cards, Missing, false, Html).

% desk_rail(+HDs, +Cards, +Missing, +Unwrap, -Html): with Unwrap (one mindhole on the page, c28), the
% mindhole's KBs and asks sit at the top of the rail, with no collapsible group around them.
desk_rail(HDs, Cards, Missing, Unwrap, Html) :-
    findall(H, ( member(HD, HDs), desk_rail_hub(HD, Cards, Unwrap, H) ), Hs), dk_cat(Hs, HsH),
    findall(M, ( member(N-P, Missing), esc(N, NH), esc(P, PH),
                 dk_f("<div class=\"hint\">~w joined the Desk, but ~w has no ledger now.</div>", [NH, PH], M) ), Ms), dk_cat(Ms, MsH),
    findall(S, ( member(HD, HDs), desk_rail_sessions(HDs, HD, Unwrap, S) ), Ss), dk_cat(Ss, SsH),
    dk_f("<nav class=\"rail\" aria-label=\"Mindholes\">~w~w</nav><nav class=\"rail\" aria-label=\"Sessions\"><details><summary><span class=\"name\">Sessions</span></summary>~w</details></nav>", [HsH, MsH, SsH], Html).

desk_count_kb(Cards, Dir, N) :- findall(x, ( member(C, Cards), get_dict(kbs, C, Ks), memberchk(Dir, Ks) ), L), length(L, N).
desk_num(N, Html) :- ( N > 0 -> dk_f("<span class=\"num hot\">~w</span>", [N], Html) ; dk_f("<span class=\"num\">~w</span>", [N], Html) ).

desk_rail_hub(HD, Cards, Html) :- desk_rail_hub(HD, Cards, false, Html).
desk_rail_hub(HD, Cards, Unwrap, Html) :-
    HP = HD.path, HK = HD.kbs,
    include([C]>>( get_dict(hub, C, HP), desk_waits(C) ), Cards, HCs),   % c28: what waits, as the tab
    length(HCs, NH), desk_num(NH, NumH),
    include([K]>>get_dict(kind, K, project), HK, PKs),
    include([K]>>get_dict(kind, K, spec), HK, SKs),
    include([K]>>get_dict(kind, K, outside), HK, OKs),
    partition([K]>>( get_dict(dir, K, KD), serve_kb_project(KD, some(_)) ), SKs, Linked, Unlinked),
    findall(H, ( member(K, PKs), desk_rail_project(HD, K, Linked, H) ), PHs), dk_cat(PHs, PH),
    ( PKs == [] -> PH1 = "<div class=\"hint\">This mindhole has no project KB.</div>" ; PH1 = PH ),
    desk_rail_group("Spec KBs, linked to the project KB", Linked, Cards, false, G1),
    desk_rail_group("Spec KBs, not linked", Unlinked, Cards, true, G2),
    desk_rail_group("KBs outside the mindhole", OKs, Cards, false, G3),
    include([X]>>( desk_ask_for_me(HD, X), \+ get_dict(parked, X, true) ), HD.asks, Mine), length(Mine, NMine),
    include([X]>>desk_ask_kb_state(X, unknown), HD.asks, NoKb), length(NoKb, NNo),
    desk_num(NMine, AskNum),
    dk_f("<details~w><summary><span class=\"name\">Ledger asks</span>~w</summary><a class=\"leaf\" href=\"#lane-ledger\"><span class=\"name\">Asks for you</span>~w</a><a class=\"leaf\" href=\"#lane-orphans\"><span class=\"name quiet\">Asks with no KB recorded</span><span class=\"num\">~w</span></a></details>",
         ["", AskNum, AskNum, NNo], AsksH),
    esc(HD.name, NameH), esc(HD.path, PathH),
    Op = "",                                          % c22: the rail loads collapsed
    (   Unwrap == true
    ->  dk_f("<div class=\"kids top\" title=\"~w\">~w~w~w~w~w</div>", [PathH, PH1, G1, G2, G3, AsksH], Html)
    ;   dk_f("<details~w><summary title=\"~w\"><span class=\"name\">~w</span>~w</summary><div class=\"kids\">~w~w~w~w~w</div></details>",
             [Op, PathH, NameH, NumH, PH1, G1, G2, G3, AsksH], Html)
    ).

desk_rail_project(HD, K, Linked, Html) :-
    ( desk_eng(K.dir, Eng) -> dk_all(Eng, [N0], repo(N0, _), Rs0), sort(Rs0, Rs) ; Rs = [] ),
    length(Rs, NR),
    desk_project_items(HD, PIs), KD = K.dir, include([P]>>get_dict(dir, P, KD), PIs, Mine), length(Mine, NP), desk_num(NP, NumH),
    findall(L, ( member(R, Rs), esc(R, RH), dk_f("<a class=\"leaf\" href=\"#~w\"><span class=\"name quiet\">~w</span></a>", [K.anchor, RH], L) ), RLs), dk_cat(RLs, RLH),
    length(Linked, NL),
    ( NL == 0 -> Hint = "<div class=\"hint\">No spec KB is linked to it yet.</div>" ; dk_f("<a class=\"leaf\" href=\"#~w\"><span class=\"name quiet\">~w spec KBs link to it</span></a>", [K.anchor, NL], Hint) ),
    esc(K.label, LH),
    dk_f("<details><summary><span class=\"name\">Project KB ~w</span>~w</summary><a class=\"leaf\" href=\"#~w\"><span class=\"name\">What it holds</span></a><details><summary><span class=\"name quiet\">~w repos</span></summary>~w</details>~w</details>",
         [LH, NumH, K.anchor, NR, RLH, Hint], Html).

desk_rail_group(_, [], _, _, "") :- !.
desk_rail_group(Title, Ks, Cards, _, Html) :-
    length(Ks, N),
    findall(L, ( member(K, Ks), desk_count_kb(Cards, K.dir, C), desk_num(C, NumH), esc(K.label, LH), esc(K.dir, DH),
                 dk_f("<a class=\"leaf\" href=\"#~w\" title=\"~w\"><span class=\"name\">~w</span>~w</a>", [K.anchor, DH, LH, NumH], L) ), Ls),
    dk_cat(Ls, LsH), findall(C, ( member(K, Ks), get_dict(dir, K, KD), desk_count_kb(Cards, KD, C) ), CsN), sum_list(CsN, Tot),
    Tot = Tot, Op = "", esc(Title, TH),
    dk_f("<details~w><summary><span class=\"name\">~w</span><span class=\"num\">~w</span></summary>~w</details>", [Op, TH, N, LsH], Html).

% desk_rail_sessions(+HDs, +HD, -Html) (c14): for each session, the KBs it holds and its items.
desk_rail_sessions(HDs, HD, Html) :- desk_rail_sessions(HDs, HD, false, Html).
desk_rail_sessions(HDs, HD, Unwrap, Html) :-
    (   is_dict(HD.st)
    ->  findall(S, ( member(X, HD.st.sessions), desk_rail_session(HD, X, S) ), Ss), dk_cat(Ss, SsH),
        length(Ss, NS), esc(HD.name, NH), HDs = HDs,
        % c23: the sessions roll up by mindhole; c28 (review H-0051): on a mindhole tab there is no group
        (   Unwrap == true -> Html = SsH
        ;   dk_f("<details class=\"sessgroup\"><summary><span class=\"name\">~w</span><span class=\"num\">~w</span></summary>~w</details>", [NH, NS, SsH], Html)
        )
    ;   Html = ""
    ).

desk_rail_session(HD, X, Html) :-
    atom_string(S, X.name),
    findall(Lb-An, ( member(K, HD.kbs), desk_holder(HD, K, S, _), get_dict(label, K, Lb), get_dict(anchor, K, An) ), Held),
    ( get_dict(inbox, X, Inbox) -> true ; Inbox = [] ),
    % c37: a parked item is not counted as open; the line names it apart
    include([I]>>get_dict(parked, I, true), Inbox, PkI), length(PkI, NPk), length(Inbox, NI0), NI is NI0 - NPk,
    ( NPk == 0 -> PkT = "" ; dk_f(" ~w parked.", [NPk], PkT) ),
    % c23: one short line; the KB names are inside when the session opens
    length(Held, NHeld),
    (   NHeld == 0 -> HeldT = "Holds no KB.", KbsH = ""
    ;   maplist([L-An, E-An]>>esc(L, E), Held, HeldE),
        ( NHeld == 1 -> HeldE = [H1-_], dk_f("Writes <b>~w</b>.", [H1], HeldT) ; dk_f("Writes <b>~w KBs</b>.", [NHeld], HeldT) ),
        findall(KL, ( member(E-An, HeldE), dk_f("<a class=\"leaf\" href=\"#~w\"><span class=\"name\">Writes the KB ~w</span></a>", [An, E], KL) ), KLs), dk_cat(KLs, KbsH)
    ),
    (   X.status == "active" -> St = "" ; dk_f(" <span class=\"gapnote\">(~w)</span>", [X.status], St) ),
    (   get_dict(state, X, Sta), string(Sta) -> dk_f(" Now ~w.", [Sta], StaT) ; StaT = "" ),
    findall(L, ( member(I, Inbox), esc(I.title, TH), desk_led_kind(I.kind, KL), dk_f("~w ~w: ~w", [KL, I.id, I.title], Tip0), esc(Tip0, TipH),
                 desk_led_anchor(HD, I.id, An),
                 dk_f("<a class=\"leaf\" href=\"#~w\" title=\"~w\"><span class=\"name\">~w</span></a>", [An, TipH, TH], L) ), Ls),
    dk_cat(Ls, LsH), desk_badge(S, BH),
    dk_f("<details><summary class=\"sess\">~w<span class=\"what\">~w ~w open items.~w~w~w</span></summary>~w~w</details>", [BH, HeldT, NI, PkT, StaT, St, KbsH, LsH], Html).

% ---- Orphaned (c14, q5, q7): each row with the step that fixes it, which Ty sends after a review

% desk_orphan_rows(+HD, -Rows): row(What, Why, To, FixItem, Ids)
desk_orphan_rows(HD, Rows) :-
    findall(R, desk_orphan_row(HD, R), Rows).

desk_orphan_row(HD, row(What, "Linked to no project KB. Its claims cannot pin the rules and decisions they rest on.", Tos, Item, Labels)) :-
    findall(K, ( member(K, HD.kbs), memberchk(K.kind, [spec, outside]), \+ serve_kb_project(K.dir, some(_)) ), Ks), Ks \== [],
    length(Ks, N), dk_f("~w spec KBs", [N], What),
    findall(L, ( member(K, Ks), L = K.label ), Labels),
    findall(T, ( member(K, Ks), desk_kb_recipient(HD, K, T) ), Tos0), sort(Tos0, Tos),
    dk_f("fix:link:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "No KB behind them is recorded: the page cannot lead to what they rest on.", Tos, Item, Ids)) :-
    findall(X, ( member(X, HD.asks), desk_ask_kb_state(X, unknown) ), Xs), Xs \== [],
    length(Xs, N), dk_f("~w ledger asks", [N], What), findall(I, ( member(X, Xs), I = X.id ), Ids),
    findall(T, ( member(X, Xs), desk_ask_recipient(HD, X, T) ), Tos0), sort(Tos0, Tos),
    dk_f("fix:nokb:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "Reserved for you, but the source of the reservation is not named.", Tos, Item, Ids)) :-
    findall(X, ( member(X, HD.asks), desk_ask_reserved(X), desk_reserve_source(X.reserved, unnamed(_)) ), Xs), Xs \== [],
    length(Xs, N), dk_f("~w reserved asks", [N], What), findall(I, ( member(X, Xs), I = X.id ), Ids),
    findall(T, ( member(X, Xs), desk_ask_recipient(HD, X, T) ), Tos0), sort(Tos0, Tos),
    dk_f("fix:source:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "A newer handoff holds the same KB. Their KBs block, so only you can close them.", [you], Item, Ids)) :-
    findall(I, ( member(K, HD.kbs), desk_stale_handoffs(HD, K, Old, _), member(H, Old), I = H.id ), Ids0), sort(Ids0, Ids), Ids \== [],
    length(Ids, N), dk_f("~w old handoffs", [N], What),
    dk_f("fix:stale:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "Handed off, and nobody accepted them.", Tos, Item, Ids)) :-
    is_dict(HD.st), Us = HD.st.orphans.unaccepted, Us \== [],
    length(Us, N), dk_f("~w handoffs", [N], What), findall(I, ( member(U, Us), I = U.id ), Ids),
    findall(T, ( member(U, Us), atom_string(T0, U.to), ( desk_live(HD, T0) -> T = T0 ; desk_keeper(HD, T) ) ), Tos0), sort(Tos0, Tos),
    dk_f("fix:unaccepted:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "No live session holds them.", [T], Item, Ids)) :-
    is_dict(HD.st), Us = HD.st.orphans.unowned, Us \== [],
    length(Us, N), dk_f("~w open items", [N], What), findall(I, ( member(U, Us), I = U.id ), Ids),
    desk_keeper(HD, T),
    dk_f("fix:unowned:~w", [HD.path], Item).
desk_orphan_row(HD, row(What, "These checks do not say in words what they check.", Tos, Item, Ids)) :-
    findall(K-Kc, ( member(K, HD.kbs), K.kind \== project, \+ desk_kb_frozen(HD, K),
                    desk_eng(K.dir, Eng), desk_current_claims(Eng, Cs),
                    member(C, Cs), dk_all(Eng, [Kc0], check(Kc0, C), Kcs), member(Kc, Kcs),
                    \+ dk_true(Eng, checks_that(Kc, _)) ), KKs0), sort(KKs0, KKs), KKs \== [],
    length(KKs, N), dk_f("~w checks", [N], What),
    findall(I, ( member(K-Kc, KKs), dk_f("~w ~w", [K.label, Kc], I) ), Ids),
    findall(T, ( member(K-_, KKs), desk_kb_recipient(HD, K, T) ), Tos0), sort(Tos0, Tos),
    dk_f("fix:words:~w", [HD.path], Item).

% desk_kb_frozen(+HD, +K) (kb-migrations c9): a spec KB whose ticket is closed (each ledger item that
% names it is closed: kb_closed of desk.py) is frozen at the version that closed it. The Desk shows no
% migration step for it (the words of its checks), so nobody must migrate a closed KB.
desk_kb_frozen(HD, K) :-
    K.kind == spec, is_dict(HD.st), get_dict(kb_closed, HD.st, L), is_list(L),
    atom_string(K.ref, R), memberchk(R, L).

% desk_kb_recipient(+HD, +K, -S): who gets a letter about a KB: its holder, else the keeper.
desk_kb_recipient(HD, K, S) :-
    desk_holder(HD, K, H, _), ( H \== none, desk_live(HD, H) -> S = H ; desk_keeper(HD, S) ).

desk_ask_recipient(HD, X, S) :-
    ( string(X.owner_session), atom_string(O, X.owner_session), desk_live(HD, O) -> S = O ; desk_keeper(HD, S) ).

desk_orphan_lane(Rows, Html) :-
    (   Rows == [] -> Body = "<p class=\"empty\">Nothing is orphaned.</p>"
    ;   findall(T, ( member(HD-row(What, Why, Tos, Item, Ids), Rows), desk_orphan_tr(HD, What, Why, Tos, Item, Ids, T) ), Ts),
        dk_cat(Ts, TsH),
        dk_f("<div class=\"sheet tablewrap\"><table><tr><th>What</th><th>Why</th><th>Goes to</th><th></th></tr>~w</table></div>", [TsH], Body)
    ),
    dk_f("<details class=\"lane\" id=\"lane-orphans\"><summary><h2>Orphaned</h2><span class=\"quiet\">Each fix opens the letter for you to read and change first</span></summary><div class=\"lanebody\">~w</div></details>", [Body], Html).

desk_orphan_tr(HD, What, Why, Tos, Item, Ids, Html) :-
    esc(What, WH), esc(Why, YH),
    findall(I, ( member(I0, Ids), dk_str(I0, I) ), IdS), dk_join(IdS, ", ", IdT), esc(IdT, IdH),
    findall(B, ( member(T, Tos), desk_badge(T, B) ), Bs), dk_cat(Bs, BsH),
    desk_fix_button(HD.path, Item, "Fix", FB),
    ( nb_current(desk_multi, true) -> esc(HD.name, NH), dk_f(" <span class=\"quiet\">(~w)</span>", [NH], HS) ; HS = "" ),
    dk_f("<tr><td>~w~w<div class=\"what\">~w</div></td><td>~w</td><td><div class=\"badges\">~w</div></td><td>~w</td></tr>", [WH, HS, IdH, YH, BsH, FB], Html).

% ---- Project KB (c15): what waits on Ty in each project KB

desk_project_items(HD, Items) :-
    findall(P, ( member(K, HD.kbs), K.kind == project, desk_eng(K.dir, Eng), desk_project_item(K, Eng, P) ), Items).

desk_project_item(K, Eng, pi{dir:K.dir, label:K.label, kind:proposed, id:X, text:T, hub:K.hub}) :-
    dk_all(Eng, [X], proposed(X), Xs), member(X, Xs), desk_pfact_text(Eng, X, T).
desk_project_item(K, Eng, pi{dir:K.dir, label:K.label, kind:draft, id:D, text:T, hub:K.hub}) :-
    dk_all(Eng, [D], outbound(D), Ds), member(D, Ds),
    ( dk_all(Eng, [T0], draft(D, _, T0, _), [T1|_]) -> txt(T1, T) ; T = "" ).
desk_project_item(K, Eng, pi{dir:K.dir, label:K.label, kind:pin, id:P, text:T, hub:K.hub}) :-
    dk_all(Eng, [P], stale_pin(P), Ps), member(P, Ps),
    ( catch(stale_pin_text(Eng, P, T0), _, fail) -> dk_str(T0, T) ; T = "" ).

desk_pfact_text(Eng, X, T) :-
    (   member(G-T0, [decision(X, T0)-T0, definition(X, T0)-T0, rule(X, T0)-T0]), dk_all(Eng, [T0], G, [T1|_]) -> txt(T1, T)
    ;   term_text(X, T)
    ).

desk_project_lane(_, Items, Html) :-
    (   Items == [] -> Body = "<p class=\"empty\">Nothing waits on you in a project KB.</p>", Op = ""
    ;   findall(R, ( member(P, Items), desk_project_row(P, R) ), Rs), dk_cat(Rs, RsH),
        dk_f("<div class=\"sheet tablewrap\"><table><tr><th>Waits on you</th><th>What</th><th></th></tr>~w</table></div>", [RsH], Body), Op = ""
    ),
    dk_f("<details class=\"lane\" id=\"lane-project\"~w><summary><h2>Project KB</h2><span class=\"quiet\">Proposed facts to ratify, drafts to push, stale pins</span></summary><div class=\"lanebody\">~w</div></details>", [Op, Body], Html).

desk_project_row(P, Html) :-
    ( P.kind == proposed -> Kd = "A fact that an agent proposed", BL = "Ratify"
    ; P.kind == draft -> Kd = "A draft to push to the tracker", BL = "I pushed it"
    ; Kd = "A stale pin", BL = "Ask for a new pin" ),
    esc(P.text, TH), esc(P.label, LH),
    dk_f("proj:~w:~w#~w", [P.kind, P.dir, P.id], Item), desk_fix_button(P.hub, Item, BL, FB),
    dk_f("<tr><td>~w<div class=\"what\">~w in ~w</div></td><td>~w</td><td>~w</td></tr>", [Kd, P.id, LH, TH, FB], Html).

% ---- Answered (c9): asks answered in the last 7 days

desk_answered(HD, As) :-
    (   is_dict(HD.st), get_dict(closed_recent, HD.st, Cs) -> findall(HD-C, member(C, Cs), As) ; As = [] ).

desk_answered_lane(As, Html) :-
    (   As == [] -> Body = "<p class=\"empty\">Nothing was answered in the last 7 days.</p>"
    ;   findall(L, ( member(HD-C, As), esc(C.id, IH), esc(C.title, TH), dk_str(C.get(note, ""), N0), esc(N0, NH),
                     dk_str(C.get(by_session, ""), BS), esc(BS, BH), dk_day(C.closed_at, CD), atom_string(HD.name, _),
                     dk_f("<li><span class=\"ref\">~w</span>~w <span class=\"quiet\">closed ~w by ~w</span><br><span class=\"small\">~w</span></li>", [IH, TH, CD, BH, NH], L) ), Ls),
        dk_cat(Ls, LsH), dk_f("<div class=\"sheet\"><div class=\"head\"><ul class=\"answered\">~w</ul></div></div>", [LsH], Body)
    ),
    dk_f("<details class=\"lane\" id=\"lane-answered\"><summary><h2>Answered</h2><span class=\"quiet\">In the last 7 days, here or in a session</span></summary><div class=\"lanebody\">~w</div></details>", [Body], Html).

% ---- KBs (c13, c14): every KB, folded, with what it holds

desk_kbs_lane(HDs, KHs, Html) :-
    findall(S, ( member(K-HD, KHs), catch(desk_kb_section(HDs, HD, K, S), E, ( serve_err_text(E, M), esc(M, MH), esc(K.label, LH),
                 dk_f("<div class=\"sheet\"><div class=\"head\"><p class=\"loud\">The KB ~w cannot be read: ~w</p></div></div>", [LH, MH], S) )) ), Ss),
    ( Ss == [] -> Body = "<p class=\"empty\">No KB.</p>" ; dk_cat(Ss, Body) ),
    dk_f("<details class=\"lane\" id=\"lane-kbs\"><summary><h2>KBs</h2><span class=\"quiet\">Each KB with its hypothesis, claims and checks</span></summary><div class=\"lanebody\">~w</div></details>", [Body], Html).

desk_kb_section(HDs, HD, K, Html) :-
    desk_engine(K.dir, KB, Eng),
    desk_holder(HD, K, Hold, How), desk_badge(Hold, BH),
    (   How == lock -> HowT = "holds the writer lock" ; How == handoff -> HowT = "took the newest handoff" ; HowT = "No session holds it" ),
    esc(K.label, LH), esc(K.dir, DH), desk_hub_suffix(HDs, HD, HS),
    (   K.kind == project -> KindT = "Project KB"
    ;   K.kind == outside -> KindT = "Spec KB outside the mindhole"
    ;   KindT = "Spec KB"
    ),
    (   K.kind == project -> LinkH = ""
    ;   serve_kb_project(K.dir, some(P)) -> file_base_name(P, PB), dk_f("<p>Linked to the project KB ~w.</p>", [PB], LinkH)
    ;   LinkH = "<p class=\"gapnote\">Linked to no project KB.</p>"
    ),
    (   K.kind == project
    ->  dk_all(Eng, [R], repo(R, _), Rs0), sort(Rs0, Rs), length(Rs, NR),
        maplist([R, E]>>esc(R, E), Rs, RsE), dk_join(RsE, ", ", RsJ),
        dk_all(Eng, [X], current_fact(X), Fs), length(Fs, NF),
        dk_f("<p>~w current decisions, definitions and rules. ~w repos: ~w.</p>", [NF, NR, RsJ], BodyMain)
    ;   desk_hyp_html(Eng, HypH), desk_current_claims(Eng, Cs),
        findall(CH, ( member(C, Cs), desk_claim_html(HD, K, Eng, C, CH) ), CHs), dk_cat(CHs, CsH),
        ( Cs == [] -> CsH2 = "<p class=\"gapnote\">No claim is current.</p>" ; CsH2 = CsH ),
        desk_kb_blockers(KB, Eng, Bl),
        ( Bl == [] -> BlH = "" ; findall(L, ( member(B, Bl), esc(B, BH0), dk_f("<li>~w</li>", [BH0], L) ), BLs), dk_cat(BLs, BLT),
                                  dk_f("<h3>Also open</h3><ul>~w</ul>", [BLT], BlH) ),
        desk_open_questions(Eng, Qs),
        ( Qs == [] -> QsH = "" ; length(Qs, NQ), dk_f("<p>~w questions wait on you: their cards are in Questions and Running on a guess.</p>", [NQ], QsH) ),
        catch(view_pending_html(K.dir, PendH), _, PendH = ""),
        catch(view_answered_html(Eng, AnsH), _, AnsH = ""),
        dk_cat(["<h3>Hypothesis</h3>", HypH, "<h3>Claims</h3>", CsH2, BlH, QsH, PendH, AnsH], BodyMain)
    ),
    findall(I, ( desk_stale_handoffs(HD, K, Old, New), member(H, Old), I = H.id ), OldIds),
    (   OldIds == [] -> OldH = ""
    ;   desk_stale_handoffs(HD, K, _, New), dk_join(OldIds, ", ", OJ),
        dk_f("<p class=\"gapnote\">Older open handoffs on this KB: ~w (the newest is ~w). See Orphaned.</p>", [OJ, New.id], OldH)
    ),
    Op = "",                                          % c22: one thing open on load, and it is a card
    dk_f("<details class=\"sheet kbsec\" id=\"~w\"~w><summary><div class=\"t\"><h3 class=\"title\">~w</h3><div class=\"src\"><span>~w~w</span><span title=\"~w\">~w</span><span>~w</span></div></div>~w</summary><div class=\"body\">~w~w~w</div></details>",
         [K.anchor, Op, LH, KindT, HS, DH, DH, HowT, BH, LinkH, OldH, BodyMain], Html).

% desk_save_draft2(+Form, -R) (q2, q9, q10): a draft is saved in the Desk's own store as Ty types.
desk_save_draft2(Form, R) :-
    desk_hubs(Hs, _),
    (   \+ ( serve_field(Form, key, K), K \== "" ) -> R = refused(400, "The draft has no key. Reload the page.")
    ;   Hs == [] -> R = refused(409, "No mindhole has joined the Desk, so the Desk has no desk.py to keep the draft.")
    ;   Hs = [hub(_, Hub)|_], serve_field(Form, key, Key),
        ( serve_field(Form, text, T) -> true ; T = "" ),
        ( serve_field(Form, choice, C) -> true ; C = "" ),
        ( serve_field(Form, intent, I) -> true ; I = "answer" ),
        tmp_file_stream(utf8, TF, TS), write(TS, T), close(TS),
        desk_cmd(Hub, [draft, Key, '--text-file', TF, '--choice', C, '--intent', I], _, R0),
        catch(delete_file(TF), _, true),
        (   R0 == ok -> R = ok
        ;   R0 = error(M), format(string(M2), "The draft was not saved: ~w", [M]), R = refused(409, M2)
        )
    ).

% ---- the review and the send (c20): a plan, built from the item the same way twice

% desk_plan(+Form, -Plan) or throws desk_refused(Status, Message).
desk_plan(Form, P) :-
    desk_load(HDs, _),
    nb_setval(desk_multi, false),
    (   serve_field(Form, hub, HS), HS \== "", atom_string(H0, HS), serve_norm(H0, Hub), desk_hd_of(HDs, Hub, HD) -> true
    ;   throw(desk_refused(400, "The form names no mindhole of this Desk. Reload the page."))
    ),
    ( serve_field(Form, item, It) -> true ; It = "" ),
    ( serve_field(Form, intent, I0), memberchk(I0, ["answer", "diverge", "requirement", "close", "park", "note"]) -> atom_string(Intent, I0) ; Intent = answer ),
    ( serve_field(Form, text, T0) -> split_string(T0, "", " \t\r\n", [Text]) ; Text = "" ),
    ( serve_field(Form, until, U0) -> split_string(U0, "", " \t\r\n", [Until]) ; Until = "" ),
    ( serve_field(Form, choice, Ch0) -> split_string(Ch0, "", " \t\r\n", [Choice]) ; Choice = "" ),
    string_length(Text, TL), ( TL > 4000 -> throw(desk_refused(400, "The text is longer than 4000 characters.")) ; true ),
    % c27 (Ty, 2026-11-18): Review and send with nothing new on an item he already wrote to shows what he sent.
    (   Text == "", Choice == "", desk_form_letters(HDs, HD, It, Sent), Sent \== []
    ->  ( serve_field(Form, key, K0) -> true ; K0 = "" ), desk_anchor_of(HD, It, A0),
        throw(desk_sent(HD, Sent, K0, A0))
    ;   true
    ),
    (   string_concat("ask:", Id, It), memberchk(Intent, [close, park, note]) -> desk_plan_ask_led(HD, Id, Intent, Text, Until, P0)
    ;   string_concat("ask:", Id, It) -> desk_plan_ask(HD, Id, Intent, Text, P0)
    ;   string_concat("led:", Id, It) -> desk_plan_led(HD, Id, Intent, Text, Until, P0)
    ;   string_concat("q:", R, It), split_string(R, "#", "", [DS, QS]) -> desk_plan_dir(HDs, DS, K, HD), atom_string(Q, QS), desk_plan_q(HD, K, Q, Intent, Choice, Text, P0)
    ;   string_concat("act:", R, It), sub_string(R, B, 1, _, "#"), sub_string(R, 0, B, _, DS), B1 is B + 1, sub_string(R, B1, _, 0, Ref)
        -> desk_plan_dir(HDs, DS, K, HD), desk_plan_act(HD, K, Ref, Intent, Choice, Text, P0)
    ;   string_concat("fix:", R, It) -> desk_plan_fix(HDs, HD, R, Text, P0)
    ;   string_concat("proj:", R, It) -> desk_plan_proj(HDs, HD, R, Text, P0)
    ;   throw(desk_refused(400, "The form names no item. Reload the page."))
    ),
    ( serve_field(Form, key, Key) -> true ; Key = "" ),
    desk_anchor_of(HD, It, Anchor),
    ( serve_field(Form, tab, Tb) -> true ; Tb = "" ),
    P = P0.put(_{hub:HD.path, hd:HD, item:It, key:Key, back:Anchor, intent:Intent, choice:Choice, text:Text, tab:Tb, until:Until}).

% desk_form_letters(+HDs, +HD, +Item, -Ls): the letters already sent about the item of a form, newest first.
desk_form_letters(HDs, HD, It, Ls) :-
    (   string_concat("ask:", Id, It) -> desk_item_letters2(HD, ask(Id), Ls)
    ;   string_concat("led:", Id, It) -> desk_item_letters2(HD, ask(Id), Ls)
    ;   string_concat("q:", R, It), split_string(R, "#", "", [DS, QS]), catch(desk_plan_dir(HDs, DS, K, HD), _, fail)
        -> desk_item_json(HD, K, question, QS, J), desk_item_letters2(HD, kbitem(J), Ls)
    ;   string_concat("act:", R, It), sub_string(R, B, 1, _, "#"), sub_string(R, 0, B, _, DS), B1 is B + 1, sub_string(R, B1, _, 0, Ref),
        catch(desk_plan_dir(HDs, DS, K, HD), _, fail)
        -> desk_item_json(HD, K, kb, Ref, J), desk_item_letters2(HD, kbitem(J), Ls)
    ;   Ls = []
    ).

% desk_sent_html(+HD, +Ls, +Back, +Frag, -Html) (c27): the review of an item with nothing new written:
% each letter that Ty already sent, with its words, its session, its time and its state. Nothing to send.
desk_sent_html(_HD, Ls, Back, Frag, Html) :-
    findall(LH, ( member(L, Ls),
                  dk_str(L.get(to, ""), To0), ( To0 == "" -> To = "the owner" ; To = To0 ),
                  dk_day_time(L.at, At), dk_str(L.get(state, "sent"), St), dk_str(L.get(text, ""), Tx),
                  desk_badge(To, BH), esc(Tx, TxH), esc(St, StH),
                  dk_f("<div class=\"letter\"><div class=\"lh\">To ~w <span class=\"small quiet\">on ~w: ~w</span></div><pre class=\"sent\">~w</pre></div>", [BH, At, StH, TxH], LH) ), LHs),
    dk_cat(LHs, LsH), length(Ls, N), ( N == 1 -> NT = "one letter" ; dk_f("~w letters", [N], NT) ),
    dk_f("<div class=\"review\"><div class=\"dh\"><h2>You already sent ~w about this</h2><p>Nothing new is written, so nothing is sent. To add to it, write your words on the card, then Review and send.</p></div><div class=\"db\">~w</div><div class=\"df\"><a class=\"btn\" href=\"/#~w\" data-cancel>Close</a></div></div>", [NT, LsH, Back], Inner),
    (   Frag == true -> Html = Inner
    ;   lib_dir(Lib), page_asset(Lib, 'desk/desk.css', Css),
        dk_f("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>What you already sent</title>\n<style>~w</style>\n</head>\n<body>\n<div class=\"reviewpage\">~w</div>\n</body>\n</html>\n", [Css, Inner], Html)
    ).

desk_plan_dir(HDs, DS, K, HD) :-
    atom_string(D0, DS), serve_norm(D0, D),
    (   desk_kb_of_dir(HDs, D, HD1, K) -> ( HD1.path == HD.path -> true ; true )
    ;   throw(desk_refused(400, "The form names a KB that this Desk does not read. Reload the page."))
    ).

desk_need_text(Text, What) :-
    ( Text == "" -> dk_f("Write ~w.", [What], M), throw(desk_refused(400, M)) ; true ).

desk_lt(To, Kind, About, Item, Text, L) :- L = lt{to:To, choices:[], kind:Kind, about:About, item:Item, text:Text}.

% ---- a ledger ask
desk_plan_ask(HD, Id, Intent, Text, P) :-
    (   desk_ask(HD, Id, X), X.waits_on == HD.owner -> true
    ;   dk_f("The ask ~w does not wait on you now. Reload the page.", [Id], M), throw(desk_refused(409, M))
    ),
    ( string(X.owner_session), atom_string(O0, X.owner_session) -> Owner = O0 ; Owner = none ),
    dk_f("the ledger ask ~w (~w)", [Id, X.title], About),
    Item = _{type:"ask", id:Id},
    (   Intent == answer
    ->  desk_need_text(Text, "the answer"),
        findall(L, ( member(K, HD.kbs), serve_kb_pins_ask(K.dir, Id, Qs), member(Q, Qs),
                     dk_f("~w in the KB ~w", [Q, K.label], L) ), Pins),
        ( Pins == [] -> PinT = "" ; dk_join(Pins, ", ", PJ), dk_f("\nThe answer also went to the question pinned to this ask: ~w.", [PJ], PinT) ),
        desk_ask_kbrefs(X, KRs), findall(Kl, ( member(KR, KRs), desk_kb_by_ref(HD, KR, KK), dk_f("~w (~w)", [KK.label, KK.dir], Kl) ), Kls),
        ( Kls == [] -> KbT = "" ; dk_join(Kls, ", ", KlJ), dk_f("\nIt rests on the KB ~w: record there, as his words, what this answer decides.", [KlJ], KbT) ),
        dk_f("Ty answers ~w: ~w\n\n~w\n\nThe Desk closed ~w as done, with this answer as its note.~w~w", [Id, X.title, Text, Id, PinT, KbT], LT),
        dk_f("The ledger: ~w is closed as done, by you, with your answer as its note.", [Id], R1),
        findall(R, ( member(Pn, Pins), dk_f("The KB: your answer is recorded for ~w (pinned to ~w).", [Pn, Id], R) ), Rs),
        desk_lt(Owner, answer, About, Item, LT, L1),
        P = plan{title:"Your answer", sub:About, letters:[L1], records:[R1|Rs], effects:[close_ask(HD.path, Id, Text)]}
    ;   Intent == diverge
    ->  desk_need_text(Text, "what you mean"),
        dk_f("Ty diverges on ~w (~w): that is not what he meant.\n\n~w\n\nThe ask stays open. The Desk added his words to it as a note.", [Id, X.title, Text], LT),
        dk_f("The ledger: a note on ~w in your words. The ask stays open.", [Id], R1),
        dk_f("Ty diverges (from the Desk): ~w", [Text], Note),
        desk_lt(Owner, diverge, About, Item, LT, L1),
        P = plan{title:"That is not what you meant", sub:About, letters:[L1], records:[R1], effects:[ask_note(HD.path, Id, Note)]}
    ;   desk_plan_requirement(HD, ask(Id), About, Item, Text, P)
    ).

% ---- a ledger item (c32): Close and Park write the ledger as Ty, with his words; Note is a letter
% to the session that holds the item, and a note in the ledger.
desk_plan_ask_led(HD, Id, Intent, Text, Until, P) :-
    (   desk_ask(HD, Id, X), X.waits_on == HD.owner -> true
    ;   dk_f("The ask ~w does not wait on you now. Reload the page.", [Id], M), throw(desk_refused(409, M))
    ),
    ( string(X.owner_session), atom_string(O0, X.owner_session) -> Owner = O0 ; Owner = none ),
    % c40 (Ty, 2026-11-18: "Refuse both ways"): a park may not end after the ask's --due date; the review
    % says so before Ty confirms (hubflow and the ledger refuse it too)
    (   Intent == park, get_dict(due, X, Due), string(Due), Due \== ""
    ->  desk_need_date(Until),
        (   Until @> Due
        ->  dk_f("Park until ~w is after the due date ~w of ~w: a park must end on or before the due date. Park until ~w or earlier.", [Until, Due, Id, Due], M),
            throw(desk_refused(400, M))
        ;   true
        )
    ;   true
    ),
    desk_plan_ledger(HD, Id, "ask", X.title, Owner, Intent, Text, Until, P).

desk_plan_led(HD, Id, Intent, Text, Until, P) :-
    (   desk_inbox_items(HD, Items), member(S-I, Items), I.id == Id -> true
    ;   dk_f("The ledger item ~w is not open in a session's inbox now. Reload the page.", [Id], M), throw(desk_refused(409, M))
    ),
    (   Intent == answer -> throw(desk_refused(400, "Only an ask that waits on you has an answer. Choose Close, Park or Note."))
    ;   memberchk(Intent, [close, park, note]) -> true
    ;   throw(desk_refused(400, "A ledger item takes Close, Park or Note."))
    ),
    atom_string(Owner, S), dk_str(I.kind, Kind),
    desk_plan_ledger(HD, Id, Kind, I.title, Owner, Intent, Text, Until, P).

desk_plan_ledger(HD, Id, Kind, Title, Owner, Intent, Text, Until, P) :-
    dk_f("the ledger ~w ~w (~w)", [Kind, Id, Title], About),
    Item = _{type:"ask", id:Id},
    (   Intent == close
    ->  desk_need_text(Text, "why you close it (the ledger keeps your words)"),
        dk_f("The ledger: ~w is closed as dropped, by you, with your words as its note. No letter goes out.", [Id], R1),
        dk_f("About ~w", [About], Sub), P = plan{title:"Close this ledger item", sub:Sub, letters:[], records:[R1], effects:[led_close(HD.path, Id, Text)]}
    ;   Intent == park
    ->  desk_need_date(Until),
        desk_need_text(Text, "why you park it (the ledger keeps your words)"),
        dk_f("The ledger: ~w is parked until ~w, by you, with your words as its note. No letter goes out.", [Id, Until], R1),
        dk_f("About ~w", [About], Sub), dk_f("Park this ledger item until ~w", [Until], PT), P = plan{title:PT, sub:Sub, letters:[], records:[R1], effects:[led_park(HD.path, Id, Until, Text)]}
    ;   desk_need_text(Text, "your note"),
        dk_f("Ty sends a note about ~w (~w):\n\n~w\n\nThe Desk also added his words to the item as a note.", [Id, Title, Text], LT),
        dk_f("The ledger: a note on ~w in your words.", [Id], R1),
        dk_f("Ty (from the Desk): ~w", [Text], Note),
        desk_lt(Owner, note, About, Item, LT, L1),
        dk_f("About ~w", [About], Sub), P = plan{title:"A note to the session that holds it", sub:Sub, letters:[L1], records:[R1], effects:[ask_note(HD.path, Id, Note)]}
    ).

% desk_need_date(+D): D is a real date YYYY-MM-DD (hubflow park --until takes it).
desk_need_date(D) :-
    (   split_string(D, "-", "", [Y, M, Dd]), string_length(Y, 4), string_length(M, 2), string_length(Dd, 2),
        maplist([S, N]>>( number_string(N, S), integer(N) ), [Y, M, Dd], [YN, MN, DN]),
        MN >= 1, MN =< 12, DN >= 1,
        date_time_stamp(date(YN, MN, DN, 0, 0, 0, 0, -, -), St), stamp_date_time(St, date(YN, MN, DN, _, _, _, _, _, _), 0)
    ->  true
    ;   dk_f("Park needs a date as YYYY-MM-DD, such as 2026-12-01; ~w is not one. Nothing changed.", [D], Msg), throw(desk_refused(400, Msg))
    ).

desk_plan_requirement(HD, From, About, Item, Text, P) :-
    desk_need_text(Text, "the new requirement"),
    ( desk_live(HD, review) -> To = review ; To = none ),
    dk_f("Ty adds a new requirement, from ~w:\n\n~w\n\nThe Desk opened an intake thread for it, owned by review. Judge it: a regression or a gap, and route it.", [About, Text], LT),
    ( To == none -> R1 = "The ledger: a new intake thread with your words. No review session is live, so it has no owner and shows under Orphaned." ; R1 = "The ledger: a new intake thread with your words, owned by review." ),
    desk_lt(To, requirement, About, Item, LT, L1),
    P = plan{title:"A new requirement", sub:About, letters:[L1], records:[R1], effects:[intake(HD.path, Text, From)]}.

% ---- a question of a KB
desk_plan_q(HD, K, Q, Intent, Choice, Text, P) :-
    desk_engine(K.dir, _, Eng),
    (   desk_open_questions(Eng, Qs), memberchk(Q, Qs) -> true ; dk_f("The question ~w is not open any more. Reload the page.", [Q], M), throw(desk_refused(409, M)) ),
    (   pending_for_question(K.dir, Q) -> dk_f("An answer to question ~w waits to be applied. Reload the page.", [Q], M2), throw(desk_refused(409, M2)) ; true ),
    dk_all(Eng, [C0, T0], question(Q, C0, T0), [[C, QT0]|_]), txt(QT0, QT),
    desk_holder(HD, K, H0, _), ( H0 \== none, desk_live(HD, H0) -> To = H0 ; To = none ),
    dk_f("question ~w in the KB ~w", [Q, K.label], About),
    desk_item_json(HD, K, question, Q, Item),
    (   Intent == answer
    ->  ( Choice \== "", Choice \== "other" -> Ans = Choice, Note = Text ; Ans = Text, Note = "" ),
        desk_need_text(Ans, "the answer, or choose an option"),
        serve_answer_term(Eng, Q, Ans, A), term_text(A, AT),
        ( Note == "" -> NoteT = "", NFs = [] ; dk_f("\n\nHis words: ~w", [Note], NoteT), atom_string(NA, Note), NFs = [note(Q, NA)] ),
        dk_f("Ty answers question ~w in the KB ~w (~w): ~w~w\n\nThe question: ~w\nThe Desk recorded answer(~w, ~w, human) in the KB, or in its answers.pending, which your next write applies.",
             [Q, K.label, K.dir, Ans, NoteT, QT, Q, AT], LT),
        ( Note == "" -> NoteR = "" ; NoteR = ", and your words as a note on the question" ),
        dk_f("The KB ~w: answer(~w, ~w, human)~w.", [K.label, Q, AT, NoteR], R1),
        desk_lt(To, answer, About, Item, LT, L1),
        P = plan{title:"Your answer", sub:About, letters:[L1], records:[R1], effects:[kb_answer(K.dir, Q, Ans, A, NFs)]}
    ;   Intent == diverge
    ->  desk_need_text(Text, "what you mean"),
        desk_diverge_facts(Q, C, Text, Facts, _),
        dk_f("Ty diverges on question ~w (claim ~w) in the KB ~w: that is not what he meant.\n\n~w\n\nThe KB records his words: a human divergence signal, and a note on ~w. The question stays open.", [Q, C, K.label, Text, C], LT),
        dk_f("The KB ~w: a divergence signal by you, and your words as a note on ~w. The question stays open.", [K.label, C], R1),
        desk_lt(To, diverge, About, Item, LT, L1),
        P = plan{title:"That is not what you meant", sub:About, letters:[L1], records:[R1], effects:[kb_write(K.dir, Facts)]}
    ;   desk_plan_requirement(HD, kb(K.ref), About, Item, Text, P)
    ).

% ---- a KB action that a policy keeps for Ty (vote, demo, waiver)
desk_plan_act(HD, K, Ref, Intent, Choice, Text, P) :-
    desk_engine(K.dir, _, Eng),
    (   desk_kb_action(Eng, A), desk_action_ref(A, Ref) -> true
    ;   dk_f("This action is not open any more in the KB ~w. Reload the page.", [K.label], M), throw(desk_refused(409, M))
    ),
    desk_holder(HD, K, H0, _), ( H0 \== none, desk_live(HD, H0) -> To = H0 ; To = none ),
    desk_action_summary(A, Sum), dk_f("~w, in the KB ~w", [Sum, K.label], About),
    desk_item_json(HD, K, kb, Ref, Item),
    (   Intent == answer
    ->  ( Choice \== "" -> true ; Text \== "" -> true ; throw(desk_refused(400, "Choose an option, or write what you decide.")) ),
        ( Text == "" -> WT = "" ; dk_f("\n\nHis words: ~w", [Text], WT) ),
        ( Choice == "" -> CT = "(see his words)" ; CT = Choice ),
        desk_act_instr(A, Instr),
        dk_f("Ty decides on ~w in the KB ~w (~w): ~w.~w\n\n~w", [Sum, K.label, K.dir, CT, WT, Instr], LT),
        ( To == none -> Rec = "the next session that takes the KB" ; Rec = To ),
        dk_f("Nothing is written by the Desk: ~w records it in the KB as your own word.", [Rec], R1),
        desk_lt(To, answer, About, Item, LT, L1),
        P = plan{title:"Your decision", sub:About, letters:[L1], records:[R1], effects:[none]}
    ;   Intent == diverge
    ->  desk_need_text(Text, "what you mean"),
        desk_action_claim(Eng, Ref, C), desk_diverge_facts(Ref, C, Text, Facts, _),
        ( C == none -> ClaimT = "" ; ClaimT = ", and a note on the claim" ),
        dk_f("Ty diverges on ~w in the KB ~w: that is not what he meant.\n\n~w\n\nThe KB records his words as a human divergence signal~w.", [Sum, K.label, Text, ClaimT], LT),
        dk_f("The KB ~w: a divergence signal by you, with your words.", [K.label], R1),
        desk_lt(To, diverge, About, Item, LT, L1),
        P = plan{title:"That is not what you meant", sub:About, letters:[L1], records:[R1], effects:[kb_write(K.dir, Facts)]}
    ;   desk_plan_requirement(HD, kb(K.ref), About, Item, Text, P)
    ).

desk_act_instr(vote, "Record his vote in the KB as his own word (a human vote), then go on as the vote says.").
desk_act_instr(demo(C, S, _), I) :- dk_f("If he approves: record his approval of ~w for claim ~w in the KB as his own word. If he says what is not right: record it as a divergence on ~w, and fix the build.", [S, C, C], I).
desk_act_instr(waiver(W), I) :- dk_f("If he renews the waiver ~w: record the new waiver as his own word, with the due time he gave. If not: the waived work is back; plan it.", [W], I).

% ---- a fix (c14, q5, q7): letters to the sessions that own the gap; for old handoffs, Ty's close
desk_plan_fix(HDs, HD, R, _Text, P) :-
    (   sub_string(R, B, 1, _, ":") -> sub_string(R, 0, B, _, W), B1 is B + 1, sub_string(R, B1, _, 0, Arg) ; W = R, Arg = "" ),
    (   W == "link" -> desk_fix_link_plan(HD, P)
    ;   W == "nokb" -> desk_fix_asks_plan(HD, nokb, P)
    ;   W == "source" -> desk_fix_asks_plan(HD, source(Arg), P)
    ;   W == "context" -> desk_fix_context_plan(HD, Arg, P)
    ;   W == "stale" -> desk_fix_stale_plan(HD, P)
    ;   W == "unaccepted" -> desk_fix_unaccepted_plan(HD, P)
    ;   W == "unowned" -> desk_fix_unowned_plan(HD, P)
    ;   W == "words" -> desk_fix_words_plan(HDs, HD, Arg, P)
    ;   throw(desk_refused(400, "The form names no fix that the Desk knows. Reload the page."))
    ).

desk_fix_item(What, Ids, J) :- findall(S, ( member(I, Ids), dk_str(I, S) ), Ss), J = _{type:"fix", what:What, ids:Ss}.

desk_group(Pairs, Groups) :- msort(Pairs, S), group_pairs_by_key(S, Groups).

desk_project_dir(HD, Dir) :- member(K, HD.kbs), K.kind == project, !, Dir = K.dir.

desk_fix_link_plan(HD, P) :-
    findall(T-K, ( member(K, HD.kbs), memberchk(K.kind, [spec, outside]), \+ serve_kb_project(K.dir, some(_)), desk_kb_recipient(HD, K, T) ), Ps),
    ( Ps == [] -> throw(desk_refused(409, "Every spec KB is linked now. Reload the page.")) ; true ),
    desk_group(Ps, Gs),
    (   desk_project_dir(HD, PD) -> esc(PD, _), PT = PD ; PT = none ),
    findall(L, ( member(T-Ks, Gs), findall(Lb, ( member(K, Ks), Lb = K.label ), Lbs), dk_join(Lbs, ", ", LJ),
                 (   PT == none
                 ->  dk_f("Ty asks you to link these spec KBs to a project KB: ~w.\nThis mindhole has no project KB yet. Say what it would take to make one, or which project KB they belong to.", [LJ], Tx)
                 ;   findall(Ln, ( member(K, Ks), desk_relpath(K.dir, PT, RP), dk_f("- ~w: add project_kb('~w') and use the project module.", [K.label, RP], Ln) ), Lns),
                     dk_join(Lns, "\n", LnJ),
                     file_base_name(PT, PTB), dk_f("Ty asks you to link these spec KBs to the project KB ~w:\n~w\nThen pin each decision or rule of the project KB that a claim rests on. Report what you pinned, or why a KB needs no link.", [PTB, LnJ], Tx)
                 ),
                 desk_fix_item("link", Lbs, J), desk_lt(T, fix, "spec KBs that are linked to no project KB", J, Tx, L) ), Ls),
    P = plan{title:"Link the spec KBs to the project KB", sub:"Each session gets the KBs it holds.", letters:Ls, records:["Nothing is written by the Desk: each session links its own KBs."], effects:[none]}.

% desk_relpath(+From, +To, -Rel): To relative to the directory From.
desk_relpath(From, To, Rel) :-
    atomic_list_concat(F0, '/', From), atomic_list_concat(T0, '/', To),
    exclude(==(''), F0, F), exclude(==(''), T0, T),
    desk_common(F, T, F1, T1), length(F1, N), length(Ups, N), maplist(=('..'), Ups),
    append(Ups, T1, Ps), atomic_list_concat(Ps, '/', Rel).
desk_common([X|F], [X|T], F1, T1) :- !, desk_common(F, T, F1, T1).
desk_common(F, T, F, T).

desk_fix_asks_plan(HD, What, P) :-
    (   What == nokb
    ->  findall(T-X, ( member(X, HD.asks), desk_ask_kb_state(X, unknown), desk_ask_recipient(HD, X, T) ), Ps), Wd = "nokb"
    ;   What = source(Id),
        findall(T-X, ( member(X, HD.asks), desk_ask_reserved(X), desk_reserve_source(X.reserved, unnamed(_)),
                       ( Id == "" -> true ; X.id == Id ), desk_ask_recipient(HD, X, T) ), Ps), Wd = "source"
    ),
    ( Ps == [] -> throw(desk_refused(409, "Nothing is left to fix here. Reload the page.")) ; true ),
    desk_group(Ps, Gs),
    findall(L, ( member(T-Xs, Gs), findall(I, ( member(X, Xs), I = X.id ), Ids), findall(Ln, ( member(X, Xs), dk_f("- ~w: ~w", [X.id, X.title], Ln) ), Lns),
                 dk_join(Lns, "\n", LnJ),
                 (   Wd == "nokb"
                 ->  dk_f("These asks of yours name no KB, and nobody recorded that they rest on none:\n~w\nFor each: add a kb ref to the KB it rests on (a KB outside the mindhole too, by its path), or record that it rests on no KB. Then the Desk leads Ty to what it rests on.", [LnJ], Tx),
                     About = "asks with no KB recorded"
                 ;   dk_f("These asks keep an action for Ty, but do not name the source of the reservation:\n~w\nName it: a policy by its name and its rule (for example: Sagittarius Policy: Only the human may waive a proof.), or Ty's own words with their date.", [LnJ], Tx),
                     About = "reservations with no named source"
                 ),
                 desk_fix_item(Wd, Ids, J), desk_lt(T, fix, About, J, Tx, L) ), Ls),
    P = plan{title:"Fix the asks", sub:"Each session gets its own asks.", letters:Ls, records:["Nothing is written by the Desk: each session fixes its own asks."], effects:[none]}.

desk_fix_context_plan(HD, Id, P) :-
    ( desk_ask(HD, Id, X) -> true ; throw(desk_refused(409, "The ask is not open now. Reload the page.")) ),
    desk_ask_recipient(HD, X, T),
    dk_f("Ty cannot answer ~w (~w) from the Desk: it holds only a title.\nAdd notes to it: the concrete case, the options with what each changes, your default, and the date you need the answer.", [Id, X.title], Tx),
    desk_fix_item("context", [Id], J), dk_f("the context of ~w", [Id], About), desk_lt(T, fix, About, J, Tx, L),
    P = plan{title:"Ask for the context", sub:About, letters:[L], records:["Nothing is written by the Desk."], effects:[none]}.

desk_fix_unaccepted_plan(HD, P) :-
    ( is_dict(HD.st) -> Us = HD.st.orphans.unaccepted ; Us = [] ),
    ( Us == [] -> throw(desk_refused(409, "Every handoff is accepted now. Reload the page.")) ; true ),
    findall(T-U, ( member(U, Us), atom_string(T0, U.to), ( desk_live(HD, T0) -> T = T0 ; desk_keeper(HD, T) ) ), Ps), desk_group(Ps, Gs),
    findall(L, ( member(T-Xs, Gs), findall(I, ( member(X, Xs), I = X.id ), Ids),
                 findall(Ln, ( member(X, Xs), dk_f("- ~w from ~w: ~w", [X.id, X.from, X.title], Ln) ), Lns), dk_join(Lns, "\n", LnJ),
                 dk_f("These handoffs wait for a session to accept them:\n~w\nAccept each one that is yours and start it, or say why not.", [LnJ], Tx),
                 desk_fix_item("unaccepted", Ids, J), desk_lt(T, fix, "handoffs that nobody accepted", J, Tx, L) ), Ls),
    P = plan{title:"Handoffs that nobody accepted", sub:"Each session gets the handoffs to it.", letters:Ls, records:["Nothing is written by the Desk."], effects:[none]}.

desk_fix_unowned_plan(HD, P) :-
    ( is_dict(HD.st) -> Us = HD.st.orphans.unowned ; Us = [] ),
    ( Us == [] -> throw(desk_refused(409, "Every item has a live owner now. Reload the page.")) ; true ),
    desk_keeper(HD, T), desk_live_sessions(HD, Live),
    findall(I, ( member(U, Us), I = U.id ), Ids),
    findall(Ln, ( member(X, Us), dk_str(X.get(owner_session, ""), O), ( O == "" -> OT = "no owner" ; dk_f("owner ~w, not live", [O], OT) ), dk_f("- ~w (~w): ~w", [X.id, OT, X.title], Ln) ), Lns), dk_join(Lns, "\n", LnJ),
    dk_f("No live session holds these items:\n~w\nTake each one that you can, give it to the session that should own it, or close it with the reason. Report what you did.", [LnJ], Tx),
    desk_fix_item("unowned", Ids, J),
    L0 = lt{to:T, choices:Live, kind:fix, about:"items that no live session holds", item:J, text:Tx},
    P = plan{title:"Items that no live session holds", sub:"Choose the session that sorts them out.", letters:[L0], records:["Nothing is written by the Desk."], effects:[none]}.

desk_fix_stale_plan(HD, P) :-
    findall(H-New, ( member(K, HD.kbs), desk_stale_handoffs(HD, K, Old, New), member(H, Old) ), Ps0),
    ( Ps0 == [] -> throw(desk_refused(409, "No old handoff is open now. Reload the page.")) ; true ),
    findall(I, ( member(H-_, Ps0), I = H.id ), Ids0), sort(Ids0, Ids),
    findall(T-(H-New), ( member(H-New, Ps0), atom_string(T, H.to) ), TPs), desk_group(TPs, Gs),
    findall(L, ( member(T-HNs, Gs), findall(Ln, ( member(H-New, HNs), dk_f("- ~w, from ~w (the newer handoff on its KB is ~w)", [H.id, H.from, New.id], Ln) ), Lns),
                 dk_join(Lns, "\n", LnJ), findall(I, ( member(H-_, HNs), I = H.id ), TIds),
                 dk_f("Ty closed these old handoffs of yours: a newer handoff holds the same KB.\n~w\nThe KB stays with the newer handoff. Nothing for you to do unless one of them still holds work: then say so.", [LnJ], Tx),
                 desk_fix_item("stale", TIds, J), desk_lt(T, notice, "old handoffs that Ty closed", J, Tx, L) ), Ls),
    dk_join(Ids, ", ", IJ),
    dk_f("The ledger: you close ~w as dropped, with the note: Superseded by a newer handoff on the same KB (closed by Ty from the Desk).", [IJ], R1),
    P = plan{title:"Close the old handoffs", sub:"Their KBs block, so only you can close them. The owners get a notice.", letters:Ls, records:[R1], effects:[close_items(HD.path, Ids, "Superseded by a newer handoff on the same KB (closed by Ty from the Desk).")]}.

desk_fix_words_plan(_HDs, HD, Arg, P) :-
    findall(T-(K-Kc), ( member(K, HD.kbs), K.kind \== project, \+ desk_kb_frozen(HD, K), ( Arg == "" ; atom_string(K.dir, Arg) ; atom_string(HD.path, Arg) ),
                        desk_eng(K.dir, Eng), desk_current_claims(Eng, Cs), member(C, Cs), dk_all(Eng, [Kc0], check(Kc0, C), Kcs), member(Kc, Kcs),
                        \+ dk_true(Eng, checks_that(Kc, _)), desk_kb_recipient(HD, K, T) ), Ps0), sort(Ps0, Ps),
    ( Ps == [] -> throw(desk_refused(409, "Every check says what it checks now. Reload the page.")) ; true ),
    desk_group(Ps, Gs),
    findall(L, ( member(T-KKs, Gs), findall(Lb-Kc, ( member(K-Kc, KKs), get_dict(label, K, Lb) ), LKs), desk_group(LKs, KGs),
                 findall(Ln, ( member(Lb-Kcs, KGs), dk_join(Kcs, ", ", KJ), dk_f("- the KB ~w: ~w", [Lb, KJ], Ln) ), Lns), dk_join(Lns, "\n", LnJ),
                 findall(I, ( member(Lb-Kcs, KGs), member(Kc, Kcs), dk_f("~w ~w", [Lb, Kc], I) ), Ids),
                 dk_f("Ty cannot tell what these checks do:\n~w\nFor each, record one line that a human reads: checks_that(K, 'what it checks'). Use plain words, not the test name.", [LnJ], Tx),
                 desk_fix_item("words", Ids, J), desk_lt(T, fix, "checks that say nothing in words", J, Tx, L) ), Ls),
    P = plan{title:"Say what the checks do", sub:"Each session gets the checks of the KBs it holds.", letters:Ls, records:["Nothing is written by the Desk."], effects:[none]}.

% ---- a project KB item (c15)
desk_plan_proj(_HDs, HD, R, Text, P) :-
    (   split_string(R, ":", "", [KS|_]), string_concat(KS, Rest, R), string_concat(":", R1, Rest),
        sub_string(R1, B, 1, _, "#"), sub_string(R1, 0, B, _, DS), B1 is B + 1, sub_string(R1, B1, _, 0, IdS) -> true
    ;   throw(desk_refused(400, "The form names no project KB item. Reload the page."))
    ),
    atom_string(D0, DS), serve_norm(D0, Dir), atom_string(Id, IdS),
    ( member(K, HD.kbs), K.dir == Dir, K.kind == project -> true ; throw(desk_refused(400, "The form names a project KB that this Desk does not read.")) ),
    desk_project_items(HD, PIs), atom_string(KA, KS),
    ( member(PI, PIs), PI.dir == Dir, PI.kind == KA, PI.id == Id -> true ; throw(desk_refused(409, "This item of the project KB is not open any more. Reload the page.")) ),
    desk_kb_recipient(HD, K, T),
    desk_fix_item("project", [IdS], J),
    ( Text == "" -> WT = "" ; dk_f("\n\nHis words: ~w", [Text], WT) ),
    (   KA == proposed
    ->  atom_string(Who, HD.owner), utc_now(Now),
        dk_f("Ty ratified ~w in the project KB ~w: ~w~w\n\nThe Desk recorded ratified_by(~w, ~w, ~w).", [Id, K.label, PI.text, WT, Id, Who, Now], Tx),
        dk_f("The project KB ~w: ratified_by(~w, ~w, ~w).", [K.label, Id, Who, Now], R0),
        Effs = [kb_write(Dir, [ratified_by(Id, Who, Now)])], Kd = notice
    ;   KA == draft
    ->  utc_now(Now), dk_f("Ty pushed the draft ~w of the project KB ~w to the tracker (he says so on the Desk at ~w).~w\n\nRecord pushed(~w, TIME) with the time he gave, or this time.", [Id, K.label, Now, WT, Id], Tx),
        R0 = "Nothing is written by the Desk: the session records the push.", Effs = [none], Kd = fix
    ;   dk_f("The pin ~w of the project KB ~w is stale: ~w~w\n\nPin the source again, and check what rests on it.", [Id, K.label, PI.text, WT], Tx),
        R0 = "Nothing is written by the Desk.", Effs = [none], Kd = fix
    ),
    dk_f("~w in the project KB ~w", [Id, K.label], About), desk_lt(T, Kd, About, J, Tx, L),
    P = plan{title:"The project KB", sub:About, letters:[L], records:[R0], effects:Effs}.

% ---- the review page (c20): each receiving session and the exact text it will get

desk_review_html(Plan, Frag, Html) :-
    serve_conf(token, Tok),
    findall(N-V, ( member(N-V0, [hub-Plan.hub, item-Plan.item, key-Plan.key, intent-Plan.intent, choice-Plan.choice, text-Plan.text, tab-Plan.get(tab, ""), until-Plan.get(until, "")]), dk_str(V0, V) ), Hs0),
    desk_hidden([token-Tok|Hs0], HH),
    findall(LH, ( nth0(I, Plan.letters, L), desk_review_letter(Plan.hd, I, L, LH) ), LHs), dk_cat(LHs, LsH),
    include([L]>>( get_dict(to, L, To), To \== none ), Plan.letters, Sendable), length(Sendable, NS),
    ( NS > 1 -> EveryH = "<div class=\"letter\"><div class=\"lh\">Add a line to every letter (optional)</div><textarea name=\"every\" aria-label=\"A line for every letter\" style=\"min-height:48px\"></textarea></div>" ; EveryH = "" ),
    findall(R, ( member(R0, Plan.records), esc(R0, RH), dk_f("<li>~w</li>", [RH], R) ), Rs), dk_cat(Rs, RsH),
    ( Rs == [] -> RecH = "" ; dk_f("<h3 class=\"small quiet\">What the Desk records</h3><ul class=\"records\">~w</ul>", [RsH], RecH) ),
    ( NS == 0 -> SendT = "Record it" ; NS == 1 -> SendT = "Send" ; dk_f("Send ~w letters", [NS], SendT) ),
    esc(Plan.title, TH), esc(Plan.sub, SH),
    dk_f("<div class=\"review\"><div class=\"dh\"><h2>Review before sending: ~w</h2><p>~w</p></div><form method=\"post\" action=\"/send\">~w<div class=\"db\">~w~w~w</div><div class=\"df\"><small>Each session gets only its own letter, at its next stop or prompt, never in the middle of a turn. You can change every word; a letter you empty is not sent.</small><a class=\"btn\" href=\"/#~w\" data-cancel>Cancel</a><button class=\"btn go\" type=\"submit\">~w</button></div></form></div>",
         [TH, SH, HH, LsH, EveryH, RecH, Plan.back, SendT], Inner),
    (   Frag == true -> Html = Inner
    ;   lib_dir(Lib), page_asset(Lib, 'desk/desk.css', Css),
        dk_f("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Review before sending</title>\n<style>~w</style>\n</head>\n<body>\n<div class=\"reviewpage\">~w</div>\n</body>\n</html>\n", [Css, Inner], Html)
    ).

desk_review_letter(HD, I, L, Html) :-
    (   L.to == none
    ->  esc(L.about, AH),
        dk_f("<div class=\"letter\"><div class=\"lh\"><span class=\"loud\">No live session holds this item: no letter goes out.</span></div><p class=\"small quiet\">About ~w. What the Desk records below still happens, and the next session that takes the item finds it.</p></div>", [AH], Html)
    ;   (   L.choices \== []
        ->  findall(O, ( member(S, L.choices), ( S == L.to -> Sel = " selected" ; Sel = "" ), dk_f("<option value=\"~w\"~w>~w</option>", [S, Sel, S], O) ), Os), dk_cat(Os, OsH),
            dk_f("To <select name=\"to_~w\" aria-label=\"The receiving session\">~w</select>", [I, OsH], ToH)
        ;   desk_badge(L.to, BH), dk_f("To ~w<input type=\"hidden\" name=\"to_~w\" value=\"~w\">", [BH, I, L.to], ToH)
        ),
        desk_letter_head(L.about, Head), esc(Head, HeadH), esc(L.text, TxH),
        desk_wake_line(L.about, Wake), esc(Wake, WakeH),
        ( desk_hooks_missing(HD, Ms), Ms \== [] -> desk_hooks_warning(HD, L.to, Ms, HookW) ; HookW = "" ),
        dk_f("<div class=\"letter\"><div class=\"lh\">~w</div><p class=\"fixed\">~w</p><textarea name=\"letter_~w\" aria-label=\"The letter to ~w\">~w</textarea><p class=\"small quiet\">If ~w is idle and waits on this item, the Desk also types this one line into its pane: <span class=\"wake\">~w</span></p>~w</div>", [ToH, HeadH, I, L.to, TxH, L.to, WakeH, HookW], Html)
    ).

% desk_wake_line(+About, -Line): the one line that desk.py wake types into an idle pane (desk.py wake-text).
desk_wake_line(About, Line) :- dk_f("Desk: Ty sent a letter about ~w. It is stored; read the Desk notice of this prompt.", [About], Line).

% desk_letter_head(+About, -Head): the line that desk.py puts before the text of a letter. The
% session gets this line and then the text, and nothing else (desk.py delivered_text).
desk_letter_head(About, Head) :- dk_f("Letter from Ty (the Desk), about ~w:", [About], Head).

% ---- the send

desk_send_form(Form, R) :-
    catch(( desk_plan(Form, Plan), desk_execute(Form, Plan, R) ),
          desk_refused(S, M), R = refused(S, M)).

desk_execute(Form, Plan, R) :-
    HD = Plan.hd,
    ( serve_field(Form, every, Ev0) -> split_string(Ev0, "", " \t\r\n", [Every]) ; Every = "" ),
    % each letter: Ty's text from the review, the receiving session (one of its choices)
    findall(I-L-Text, ( nth0(I, Plan.letters, L), L.to \== none,
                        format(atom(F), "letter_~w", [I]), ( serve_field(Form, F, T0) -> true ; T0 = "" ),
                        split_string(T0, "", " \t\r\n", [T1]), T1 \== "",
                        ( Every == "" -> Text = T1 ; dk_f("~w\n\n~w", [T1, Every], Text) ) ), ToSend0),
    forall(( nth0(I, Plan.letters, L), L.to == none, format(atom(F), "to_~w", [I]), serve_field(Form, F, Was), Was \== "" ),
           ( dk_f("The session that gets this letter changed since your review (it was ~w, now no live session holds the item). Nothing was sent. Review it again.", [Was], M),
             throw(desk_refused(409, M)) )),
    findall(I-L1-Text, ( member(I-L-Text, ToSend0), desk_pick_to(Form, I, L, To), L1 = L.put(to, To) ), ToSend),
    % c8: the letters are stored first
    findall(Lr, ( member(_-L-Text, ToSend), desk_store_letter(HD, L, Text, Lr) ), Stored),
    ( member(error(EM), Stored) -> dk_f("A letter was not stored, so nothing else was done: ~w", [EM], M0), R = refused(409, M0)
    ;   desk_effects(Plan.effects, R0),
        forall(member(Lr, Stored), desk_finish(HD.path, Lr, R0, _)),
        desk_plain(R0, R1),
        (   R1 == ok
        ->  ( Plan.key \== "" -> desk_cmd(HD.path, [draft, Plan.key, '--clear'], _, _) ; true ), R = ok(Plan.back)
        ;   R1 = refused(S, M), Stored \== [] -> dk_f("Your letters are stored, but the Desk could not do the rest: ~w", [M], M2), R = refused(S, M2)
        ;   R = R1
        )
    ).

% c20 (review finding, H-0039): /send builds the plan again; a letter goes only to the session that
% the review showed. When the holder changed since the review, nothing is sent: review it again.
desk_pick_to(Form, I, L, To) :-
    format(atom(F0), "to_~w", [I]),
    (   L.choices == []
    ->  (   serve_field(Form, F0, TS0), atom_string(L.to, TS0) -> To = L.to
        ;   ( serve_field(Form, F0, Was) -> true ; Was = "no session" ),
            dk_f("The session that gets this letter changed since your review (it was ~w, now ~w). Nothing was sent. Review it again.", [Was, L.to], M),
            throw(desk_refused(409, M))
        )
    ;   format(atom(F), "to_~w", [I]), serve_field(Form, F, TS), atom_string(TA, TS), memberchk(TA, L.choices) -> To = TA
    ;   throw(desk_refused(400, "The review names a session that may not get this letter. Reload the page."))
    ).

% desk_store_letter(+HD, +L, +Text, -Lr): ok(Lid), none (the hub has no desk.py), or error(M).
desk_store_letter(HD, L, Text, Lr) :-
    (   \+ desk_py(HD.path, _, _) -> Lr = none
    ;   atom_json_dict(IJ, L.item, [width(0)]),
        tmp_file_stream(utf8, TF, TS), write(TS, Text), close(TS),
        dk_str(L.to, To), dk_str(L.about, About), dk_str(L.kind, Kind),
        desk_cmd(HD.path, [send, '--kind', Kind, '--to', To, '--about', About, '--item-json', IJ, '--text-file', TF], Out, R0),
        catch(delete_file(TF), _, true),
        (   R0 == ok, catch(atom_json_dict(Out, D, []), _, fail), get_dict(id, D, Lid) -> Lr = ok(Lid)
        ;   R0 = error(M) -> Lr = error(M)
        ;   Lr = error("desk.py send printed no letter id")
        )
    ).

% desk_effects(+Effects, -R): what the Desk records, in order; the first refusal stops the rest.
desk_effects([], ok).
desk_effects([E|Es], R) :-
    desk_effect(E, R0),
    (   R0 = refused(_, _) -> R = R0
    ;   desk_effects(Es, R1),
        ( R1 == ok -> R = R0 ; R = R1 )
    ).

desk_effect(none, ok).
desk_effect(close_ask(Hub, Id, Text), R) :-
    hub_asks(Hub, Owner, _), atom_string(IdA, Id),
    hub_close(Hub, IdA, Text, R0),
    (   R0 == ok
    ->  atom_string(OA, Owner), sha256_text(Text, D), utc_now(Now),
        forall(( desk_load(HDs, _), member(HD, HDs), member(K, HD.kbs), serve_kb_pins_ask(K.dir, IdA, Qs), member(Q, Qs) ),
               ( serve_text_term(K.dir, Q, Text, A), serve_write(K.dir, [answer(Q, A, human:OA), answer_pin(Q, IdA, D, Now)], _) )),
        R = ok
    ;   R = R0
    ).
desk_effect(kb_answer(Dir, Q, Text, A, NFs), R) :-
    desk_engine(Dir, _, Eng),
    serve_owned(Eng, Q, Dir, A, Text, NFs, R0),
    ( R0 == ok, pending_for_question(Dir, Q) -> R = queued ; R = R0 ).
desk_effect(kb_write(Dir, Facts), R) :-
    serve_write(Dir, Facts, R0),
    (   R0 == ok, member(signal(S, _, _, _), Facts), desk_still_pending(Dir, S) -> R = queued
    ;   R0 == ok, pending_open(Dir, Ps), Ps \== [], member(pending(_, _, Fs), Ps), member(F, Facts), memberchk(F, Fs) -> R = queued
    ;   R = R0
    ).
desk_effect(led_close(Hub, Id, Text), R) :- hub_run(Hub, [close, Id, '--reason', dropped, '--note', Text], _, R0), ( R0 = ok(_) -> R = ok ; R = R0 ).
desk_effect(led_park(Hub, Id, Until, Text), R) :- hub_run(Hub, [park, Id, '--until', Until, '--note', Text], _, R0), ( R0 = ok(_) -> R = ok ; R = R0 ).
desk_effect(ask_note(Hub, Id, Note), R) :- hub_run(Hub, [note, Id, Note], _, R0), ( R0 = ok(_) -> R = ok ; R = R0 ).
desk_effect(intake(Hub, Text, From), R) :- desk_intake(Hub, Text, From, R).
desk_effect(close_items(Hub, Ids, Note), R) :-
    foldl([Id, R0, R1]>>( R0 == ok -> ( hub_run(Hub, [close, Id, '--reason', dropped, '--note', Note], _, X), ( X = ok(_) -> R1 = ok ; R1 = X ) ) ; R1 = R0 ), Ids, ok, R).

% ---------------------------------------------------------------------
% subject
% ---------------------------------------------------------------------

% T38 c1: the sha256 of the bytes of the file (encoding(octet)), so a digest equals sha256sum
% also for non-ASCII and binary files. Before T38 the file was read as UTF-8 text.
sha256_file(File, Digest) :-
    (   have_crypto,
        catch(crypto:crypto_file_hash(File, Hex, [algorithm(sha256), encoding(octet)]), _, fail)
    ->  true
    ;   catch(( process_create(path(sha256sum), [File], [stdout(pipe(O)), stderr(null), process(P)]),
                read_string(O, _, Out), close(O), process_wait(P, exit(0)) ), _, fail),
        split_string(Out, " ", "", [HexS|_]),
        atom_string(Hex, HexS)
    ->  true
    ;   die(2, ["Cannot compute sha256. library(crypto) and sha256sum are both missing.", "Fix: install coreutils or the SWI-Prolog ssl package."])
    ),
    atom_concat('sha256:', Hex, Digest).

% legacy_text_digest(+File, -Digest) (T40 c2): the digest rule before T38: the file read as UTF-8
% text (crypto_file_hash with its default encoding). Fails without library(crypto).
legacy_text_digest(File, Digest) :-
    have_crypto,
    catch(crypto:crypto_file_hash(File, Hex, [algorithm(sha256)]), _, fail),
    atom_concat('sha256:', Hex, Digest).

subject_abs(KB, Path, Abs) :-
    (   is_absolute_file_name(Path)
    ->  Abs = Path
    ;   kb_dir(KB, Dir), directory_file_path(Dir, Path, Abs)
    ).

stored_path(Dir, Abs, Stored) :-
    atom_concat(Dir, '/', DirS),
    (   atom_concat(DirS, Rel, Abs), Rel \== ''
    ->  Stored = Rel
    ;   Stored = Abs
    ).

% A relative PATH may be relative to the current directory or to the KB
% directory. If both exist and differ, the path is ambiguous.
subject_input_path(KB, Path, Abs) :-
    absolute_file_name(Path, A1),
    (   is_absolute_file_name(Path) -> A2 = A1 ; kb_dir(KB, D), directory_file_path(D, Path, A2) ),
    (   exists_file(A1), exists_file(A2), A1 \== A2
    ->  die(1, [ "The path " + Path + " is ambiguous.",
                 "It exists here (" + A1 + ") and in the KB directory (" + A2 + ").",
                 "Fix: give an absolute path." ] >> fix_lines)
    ;   exists_file(A1) -> Abs = A1
    ;   exists_file(A2) -> Abs = A2
    ;   die(1, ["The file " + Path + " does not exist, here or in the KB directory. Check the path."] >> fix_lines)
    ).

cmd_subject(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos = [Id, Path] -> true
    ;   usage_error("Give an id and a path: orbit-kb subject ID PATH.", [])
    ),
    subject_input_path(KB, Path, Abs),
    sha256_file(Abs, Digest),
    kb_dir(KB, Dir),
    stored_path(Dir, Abs, Stored),
    New = subject(Id, Stored, Digest),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    include(fact_item, Items, Facts),
    exclude([it(_, _, _, T, _, _)]>>(nonvar(T), T = subject(Id, _, _)), Facts, Others),
    build_env(Others, Ds, env(Ids, _, _, _)),
    (   ord_memberchk(Id, Ids)
    ->  reject(["The id " + Id + " is already used by another fact. Choose a new subject id."] >> fix_lines)
    ;   true
    ),
    clause_line(New, [], NewLine),
    term_text(New, NewText),
    kb_file(KB, KbFile),
    (   member(it(kb, _, _, T, _, From-To), Items), nonvar(T), T = subject(Id, _, _)
    ->  read_file_to_string(KbFile, S, [encoding(utf8)]),
        sub_string(S, 0, From, _, Pre),
        sub_string(S, To, _, 0, Post),
        atomic_list_concat([Pre, NewText, Post], S2),
        % D7: a temp file in the KB directory, then rename. A reader
        % sees the old kb.pl or the new one, never a part.
        write_atomic(KbFile, S2)
    ;   append_lines(KbFile, [NewLine])
    ),
    format("~w~n", [Digest]),
    Code = 0.

% ---------------------------------------------------------------------
% attest
% ---------------------------------------------------------------------

utc_now(A) :-
    get_time(T),
    stamp_date_time(T, D, 'UTC'),
    format_time(atom(A), '%Y-%m-%dT%H:%M:%SZ', D).

next_attest_id(Items, Ds, Id) :-
    include(fact_item, Items, Facts),
    build_env(Facts, Ds, env(Ids, FA, _, _)),
    findall(V, member(_-V, FA), Vs),
    append(Ids, Vs, All),
    findall(N, ( member(X, All), atom(X), atom_concat(a, NA, X),
                 atom_number(NA, N), integer(N) ),
            Ns),
    max_list([0|Ns], Max),
    N1 is Max + 1,
    format(atom(Id), "a~w", [N1]).

cmd_attest(KB, Args, Code) :-
    parse_opts(Args, ['--by'-value, '--id'-value, '--rests-on'-value], Pos, Opts),
    (   Pos = [Type, Subject, PredText] -> true
    ;   usage_error("Give a type, a subject, and a predicate: orbit-kb attest TYPE SUBJECT 'PREDICATE'.", [])
    ),
    opt(Opts, '--by', agent, By),
    (   By == script
    ->  reject(["Only orbit-kb run and orbit-kb prove write attestations by script."])
    ;   memberchk(By, [human, agent]) -> true
    ;   reject(["--by must be human or agent. It is " + By + "."] >> fix_lines)
    ),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    (   atype_of(ATs, Type, at(_, _, W, _, _, _, _)), W == [script]
    ->  script_use(Type, Use),
        reject(["Only " + Use + " writes attestations of type " + Type + "."] >> fix_lines)
    ;   true
    ),
    parse_one(PredText, P),
    (   P = ok(Pred0, _) -> true
    ;   P = err(M0), reject(["The predicate does not parse. " + M0 + " Check the brackets and quotes."] >> fix_lines)
    ),
    (   Pred0 == digest(current)
    ->  current_digest(KB, Items, Subject, D),
        Pred = digest(D)
    ;   Pred = Pred0
    ),
    (   memberchk('--id'-Id, Opts) -> true ; next_attest_id(Items, Ds, Id) ),
    utc_now(Now),
    T = attest(Id, Type, Subject, Pred, By, Now),
    NewItems = [it(new, '<arg>', 1, T, [], 0-0)],
    validate_new(KB, NewItems, Problems),
    (   Problems \== []
    ->  findall(S, ( member(diag(C, _, _, M), Problems), fmt(S, "~w: ~w", [C, M]) ), PL),
        reject(PL)
    ;   true
    ),
    late_vote_check(Items, Type, By, Pred),
    go_vote_check(KB, Type, By, Pred),
    back_check(KB, Items, Type, Subject),
    log_check(KB, Items, Type, Subject, Pred),
    rests_on_lines(Opts, Items, Type, Id, RLines0),
    end_lines(KB, Items, Type, Subject, By, Id, Pred, ELines),
    append(RLines0, ELines, RLines),
    clause_line(T, [], Line),
    actor_line(Id, ALine),
    kb_file(KB, KbFile),
    append_lines(KbFile, [Line, ALine|RLines]),
    forall(member(L, [Line, ALine|RLines]), format("~w~n", [L])),
    Code = 0.

% end_lines(+KB, +Items, +Type, +Subject, +By, +Id, +Pred, -Lines) (D30 H4, H6, H7): a human approval of the
% ticket (ticket(Subject)) in a KB that uses discovery ends the discovery orbit when the orbit
% is open and gate(go) holds before the approval: one line discovery_end(Id). With no GO, the
% approval is written as always (a human act is never refused), and a NOTE says that the orbit
% stays open.
end_lines(KB, Items, approval, Subject, human, Id, Pred, Lines) :-
    has_discovery(KB),
    kb_term(Items, ticket(S)), S == Subject, !,
    kb_engine(KB, Eng),
    findall(D, ( kb_term(Items, subject(S2, _, D)), S2 == Subject ), Ds),
    (   \+ eng_true(Eng, discovery_open)
    ->  Lines = []
    ;   Pred = digest(D0), member(D1, Ds), D1 \== D0
    ->  % D30 H7 (review of K-A, finding 3): a stale approval does not end the orbit.
        format(user_error, "NOTE: the discovery orbit stays open. This approval names a digest that is not the current digest of the ticket (stale), so it does not end the orbit. Approve the ticket as it is now: orbit-kb attest approval ~w 'digest(current)' --by human.~n", [Subject]),
        Lines = []
    ;   eng_true(Eng, gate(go)), eng_true(Eng, artifact_vote(go))
    ->  clause_line(discovery_end(Id), [], L), Lines = [L]
    ;   format(user_error, "NOTE: the discovery orbit stays open. gate(go) and the artifacts' go (discovery_ready with a current claim) do not both hold in the current round, so this approval of the ticket does not end it. Run orbit-kb query 'gate(V)', orbit-kb show open, and orbit-kb report (Vote).~n", []),
        Lines = []
    ).
end_lines(_, _, _, _, _, _, _, []).

% rests_on_lines(+Opts, +Items, +Type, +Id, -Lines) (D28): --rests-on A1,A2
% names the runs that a disproof verdict rests on. Each must be a
% test_result attestation in kb.pl. One rests_on_run(Id, A) line per run.
rests_on_lines(Opts, Items, Type, Id, Lines) :-
    (   memberchk('--rests-on'-RA, Opts)
    ->  (   Type == disproof -> true
        ;   reject(["--rests-on is only for a disproof verdict. The type is " + Type + "."] >> fix_lines)
        ),
        atomic_list_concat(Rs0, ',', RA),
        findall(R, ( member(R1, Rs0), normalize_space(atom(R), R1), R \== '' ), Rs),
        (   Rs == [] -> reject(["--rests-on needs one or more run ids, such as --rests-on a7,a9."] >> fix_lines) ; true ),
        forall(member(R, Rs),
               (   member(it(kb, _, _, A, _, _), Items), nonvar(A),
                   A = attest(R, test_result, _, _, _, _)
               ->  true
               ;   reject(["--rests-on " + R + ": there is no test_result attestation " + R + " in kb.pl.",
                           "Fix: name a run that orbit-kb run recorded (orbit-kb query 'attest(A, test_result, K, R, B, T)' -n 0)."] >> fix_lines)
               )),
        findall(L, ( member(R, Rs), clause_line(rests_on_run(Id, R), [], L) ), Lines)
    ;   Lines = []
    ).

% ---------------------------------------------------------------------
% review start (D28, T25)
% ---------------------------------------------------------------------
% review start --as R --ticket F --diff A..B records what the reviewer
% saw: review_saw(R, ticket, D) for the bytes of F, review_saw(R, kb, D)
% for the spec-kb stamp of kb.pl before these facts, and
% review_saw(R, diff, D) for the stdout of git diff A..B, run in the
% current directory. A missing option, file, or a failed git diff is
% exit 2, and nothing is written.
cmd_review(KB, [start|Args], Code) :- !,
    parse_opts(Args, ['--ticket'-value, '--diff'-value], Pos, Opts),
    (   Pos == [] -> true ; usage_error("review start takes only options: review start --as ROLE --ticket F --diff A..B.", []) ),
    (   ( nb_current(orbit_role, R), atom(R) ; getenv('ORBIT_KB_ROLE', R), R \== '' ) -> true
    ;   usage_error("review start needs the role of the reviewer: --as ROLE (or ORBIT_KB_ROLE), such as --as review.", [])
    ),
    (   memberchk('--ticket'-F, Opts) -> true ; usage_error("review start needs --ticket F, the ticket file that the reviewer reads.", []) ),
    (   memberchk('--diff'-Range, Opts) -> true ; usage_error("review start needs --diff A..B, the commits that the reviewer reads.", []) ),
    absolute_file_name(F, FAbs),
    (   exists_file(FAbs) -> true
    ;   die(2, ["The ticket file " + F + " does not exist. Nothing was written.", "Fix: give the path of the ticket file."] >> fix_lines)
    ),
    sha256_file(FAbs, DT),
    git_diff_digest(Range, DD),
    kb_file(KB, KbFile),
    sha256_file(KbFile, DK),
    findall(L, ( member(K-D, [ticket-DT, kb-DK, diff-DD]), clause_line(review_saw(R, K, D), [], L) ), Lines),
    append_lines(KbFile, Lines),
    forall(member(L, Lines), format("~w~n", [L])),
    Code = 0.
cmd_review(_, _, _) :-
    usage_error("Usage: orbit-kb review start --as ROLE --ticket F --diff A..B.", []).

% git_diff_digest(+Range, -Digest): the sha256 of the stdout of git diff RANGE.
git_diff_digest(Range, Digest) :-
    (   absolute_file_name(path(git), Git, [access(execute), file_errors(fail)]) -> true
    ;   die(2, ["git was not found. review start needs git for --diff. Nothing was written."] >> fix_lines)
    ),
    tmp_file_stream(binary, Tmp, S),
    catch(process_create(Git, [diff, Range], [stdin(null), stdout(stream(S)), stderr(null), process(P)]), E, true),
    close(S),
    (   var(E), process_wait(P, exit(0))
    ->  sha256_file(Tmp, Digest), catch(delete_file(Tmp), _, true)
    ;   catch(delete_file(Tmp), _, true),
        die(2, ["git diff " + Range + " failed. Nothing was written.",
                "Fix: run review start in the repository, with a range such as main..HEAD."] >> fix_lines)
    ).

% log_check(+KB, +Items, +Type, +Subject, +Pred) (D18): a model_result
% verdict or mutation that the solver log clearly contradicts is refused.
% A log that is missing, unreadable, or not clear gives a NOTE and the
% result is accepted. calibration is never checked.
log_check(KB, Items, model_result, Subject, Pred) :-
    nonvar(Pred), log_claim(Pred, Res, Want), !,
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = subject(Subject, Path, _), atom(Path)
    ->  subject_abs(KB, Path, Abs),
        (   catch(read_file_to_string(Abs, Str, []), _, fail)
        ->  split_string(Str, "\n", "\r \t", Lines),
            log_class(Lines, Class),
            (   Class == none
            ->  ( fmt(M1, "the log ~w is not a clear TLC or z3 result", [Subject]), log_note(M1) )
            ;   log_shows(Class, Shows, Text),
                (   Shows \== Want
                ->  log_refuse(Subject, Res, Text)
                ;   true
                )
            )
        ;   ( fmt(M2, "the log file ~w is missing or cannot be read", [Abs]), log_note(M2) )
        )
    ;   ( fmt(M3, "there is no subject ~w with a file path", [Subject]), log_note(M3) )
    ).
log_check(_, _, _, _, _).

% log_claim(+Pred, -Result, -Want): what the result says the log shows.
% case: a violation or sat. nocase: holds or unsat.
log_claim(verdict(_, _, R), R, W) :- log_want(R, W).
log_claim(mutation(_, _, R), R, W) :- memberchk(R-W, [killed-case, survived-nocase]).

log_want(R, case)   :- memberchk(R, [reached, violated, sat]).
log_want(R, nocase) :- memberchk(R, [holds, unsat]).

log_class(Lines, Class) :-
    (   member(L, Lines), sub_string(L, _, _, _, "is violated") -> V = true ; V = false ),
    (   member(L, Lines), sub_string(L, _, _, _, "No error has been found") -> H = true ; H = false ),
    (   V-H == true-false -> Class = tlc_violated
    ;   V-H == false-true -> Class = tlc_holds
    ;   V-H \== false-false -> Class = none
    ;   findall(W, ( member(L, Lines), memberchk(L, ["sat", "unsat", "unknown"]), atom_string(W, L) ), Ws0),
        sort(Ws0, Ws),
        (   Ws = [sat] -> Class = z3_sat
        ;   Ws = [unsat] -> Class = z3_unsat
        ;   Class = none
        )
    ).

log_shows(tlc_violated, case,   "TLC reports a violation").
log_shows(tlc_holds,    nocase, "TLC reports no error").
log_shows(z3_sat,       case,   "the solver printed sat").
log_shows(z3_unsat,     nocase, "the solver printed unsat").

log_note(Msg) :-
    fmt(S, "NOTE: the log was not checked: ~w", [Msg]),
    format(user_error, "~w~n", [S]).

log_refuse(Subject, Res, Text) :-
    reject([ "The log " + Subject + " contradicts the result " + Res + ": " + Text + ".",
             "Fix: attest the result that the log shows, or run the solver again into a new log."
           ] >> fix_lines).

% late_vote_check(+Items, +Type, +By, +Pred) (D14): the agent's vote is
% sealed, so it must come before the human's vote. An agent vote in a
% round in which the human already voted is refused. This guards an
% honest mistake only: the agent can still read the human vote, or edit
% kb.pl by hand.
late_vote_check(Items, vote, agent, vote(R, _)) :-
    member(it(kb, _, _, T, _, _), Items), nonvar(T),
    T = attest(V1, vote, _, vote(R1, _), human, _), R1 == R,
    \+ ( vote_void_derived(Items, Vs), memberchk(vote_void(V1), Vs) ), !,
    reject([ "The human already voted in round " + R + ", so an agent vote in this round cannot be sealed.",
             "Fix: do not vote in this round. Say what you think in the discussion after the reveal.",
             "In the next round, vote before the human: vote(N, CHOICE) with a larger N."
           ] >> fix_lines).
late_vote_check(_, _, _, _).

% go_vote_check(+KB, +Type, +By, +Pred) (D33 R5, c_k_d_1b): while the discovery orbit is open,
% an agent's GO vote is refused when discovery is not ready, and the refusal names each thing
% that blocks readiness (ready_blocker, as show open names it). A vote of no_go or hold, and
% every vote of the human, are never refused.
% D30 H8 (review of K-A, finding 6): after the discovery orbit closed, an agent vote is refused,
% and a vote of the human is written with a NOTE: it does not count (vote_void) until a back.
go_vote_check(KB, vote, By, _) :-
    has_discovery(KB),
    kb_engine(KB, Eng), eng_true(Eng, discovery_closed), !,
    (   By == agent
    ->  reject([ "The discovery orbit is closed: the human approved the ticket after a GO. A vote now does not count.",
                 "Fix: to return to discovery, record it: orbit-kb attest back H 'back(TEXT)'. Then vote in a new round."
               ] >> fix_lines)
    ;   format(user_error, "NOTE: the discovery orbit is closed (the human approved the ticket after a GO). This vote is written, but it does not change the outcome. To return to discovery: orbit-kb attest back H 'back(TEXT)'.~n", [])
    ).
go_vote_check(KB, vote, agent, vote(_, C)) :-
    C == go, has_discovery(KB),
    kb_engine(KB, Eng),
    eng_true(Eng, discovery_open), \+ eng_true(Eng, discovery_ready), !,
    eng_all(Eng, [X], ready_blocker(X), Xs0),
    ( Xs0 == [] -> Xs = [unknown] ; Xs = Xs0 ),
    findall(L, ( member(X, Xs), ready_line(Eng, X, KI, S), fmt(L, "- ~w: ~w", [KI, S]) ), Ls),
    append([ ["Discovery is not ready, so an agent's GO vote is refused (GO cannot win the gate while discovery is not ready). What blocks readiness:"],
             Ls,
             ["Fix: clear what blocks readiness (orbit-kb show open), then vote. A vote of no_go or hold is accepted now. The human's vote is never refused."] ], Msg),
    reject(Msg).
go_vote_check(_, _, _, _).

% back_check(+KB, +Items, +Type, +Subject) (D30 H9, review of K-A finding 12): a back names a
% hypothesis, and returns from a closed discovery orbit. Else it is refused.
back_check(KB, Items, back, Subject) :- !,
    (   kb_term(Items, hypothesis(H, _, _)), H == Subject -> true
    ;   reject([ "A back names the hypothesis that the build cannot restate. " + Subject + " is no hypothesis.",
                 "Fix: orbit-kb attest back H 'back(TEXT)' with H a hypothesis (orbit-kb show hypothesis)."
               ] >> fix_lines)
    ),
    kb_engine(KB, Eng),
    (   has_discovery(KB), eng_true(Eng, discovery_closed) -> true
    ;   reject([ "The discovery orbit is open: there is nothing to return from. A back follows the human's approval of the ticket after a GO.",
                 "Fix: stay in discovery. After a HOLD, vote in the next round."
               ] >> fix_lines)
    ).
back_check(_, _, _, _).

% digest(current): the recorded digest of the subject. The file on disk
% must still have that digest, so an approval never names a file that
% changed since it was recorded.
current_digest(KB, Items, Subject, D) :-
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = subject(Subject, Path, D0), atom(Path)
    ->  subject_abs(KB, Path, Abs),
        (   exists_file(Abs)
        ->  sha256_file(Abs, Now),
            (   Now == D0
            ->  D = D0
            ;   reject([ "The file of subject " + Subject + " changed since its digest was recorded.",
                         "Fix: run orbit-kb subject " + Subject + " " + Abs + ", then review the file again."
                       ] >> fix_lines)
            )
        ;   reject([ "The file of subject " + Subject + " is missing: " + Abs + ".",
                     "Fix: restore the file, or record a new path with orbit-kb subject."
                   ] >> fix_lines)
        )
    ;   reject([ "There is no subject " + Subject + ", so digest(current) has no value.",
                 "Fix: record it first with orbit-kb subject " + Subject + " PATH."
               ] >> fix_lines)
    ).

% ---------------------------------------------------------------------
% run
% ---------------------------------------------------------------------

% run (D7): the command runs WITHOUT the KB lock, so a long check does
% not stall other writers. Its output goes to a private temp file in
% runs/. When it finishes, run takes the lock, chooses N, writes
% runs/N-CHECK.log with an exclusive create, chooses the attestation
% id, and appends the attestation. Runs are numbered in the order they
% finish. The time is the time at which the command finished. If run is
% killed before it takes the lock, nothing is recorded; at most its
% runs/.tmp-* file stays.
cmd_run(KB, Args, Code) :-
    (   append(Pre, ['--'|Cmd], Args), Cmd \== []
    ->  true
    ;   usage_error("Give a check and a command: orbit-kb run CHECK -- CMD [ARGS].", [])
    ),
    (   Pre = [Check] -> true
    ;   usage_error("Give one check id before --: orbit-kb run CHECK -- CMD [ARGS].", [])
    ),
    kb_items(KB, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = check(Check, _)
    ->  true
    ;   die(2, [ "There is no check " + Check + " in kb.pl.",
                 "Fix: add it with orbit-kb add 'check(" + Check + ", CLAIM)' \"checks_that(" + Check + ", 'what it checks, in plain words')\", or fix the id.",
                 "This is a usage error, not a failed run." ] >> fix_lines)
    ),
    Cmd = [Exe0|CmdArgs],
    (   sub_atom(Exe0, _, _, _, '/')
    ->  absolute_file_name(Exe0, ExeAbs),
        ( exists_file(ExeAbs) -> Exe = ExeAbs ; Exe = none )
    ;   ( absolute_file_name(path(Exe0), ExeP, [access(execute), file_errors(fail)]) -> Exe = ExeP ; Exe = none )
    ),
    (   Exe == none
    ->  die(2, ["The command " + Exe0 + " was not found.", "Fix: check the name and the PATH. Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    kb_dir(KB, Dir),
    directory_file_path(Dir, runs, RunsDir),
    make_directory_path(RunsDir),
    runs_tmp(RunsDir, TmpOut, OS),
    catch(process_create(Exe, CmdArgs, [stdin(null), stdout(stream(OS)), stderr(stream(OS)), process(P)]), E, true),
    close(OS),
    (   nonvar(E)
    ->  err_text(E, ET),
        die(2, ["Could not start the command: " + ET, "Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    run_wait(P, St),
    utc_now(Now),
    (   St = exit(EC) -> true
    ;   St = killed(Sig) -> EC is 128 + Sig
    ;   EC = 255
    ),
    ( EC =:= 0 -> Result = pass ; Result = fail ),
    atomic_list_concat(Cmd, ' ', CmdText0),
    split_string(CmdText0, "\n\r", "", CmdParts),
    atomic_list_concat(CmdParts, ' ', CmdText),
    read_file_to_string(TmpOut, Output, [encoding(utf8)]),
    with_kb_lock(Dir, record_run(KB, Check, Result, EC, Now, CmdText, Output, RunN, Log)),
    format("run ~w ~w ~w (exit ~w) log=~w~n", [RunN, Check, Result, EC, Log]),
    (   Result == fail
    ->  split_string(Output, "\n", "", OL0),
        ( append(OL1, [""], OL0) -> true ; OL1 = OL0 ),
        length(OL1, Len),
        ( Len > 40 -> Skip is Len - 40, length(Drop, Skip), append(Drop, Tail, OL1) ; Tail = OL1 ),
        length(Tail, TN),
        format("Last ~w line(s) of output:~n", [TN]),
        forall(member(TL, Tail), format("~w~n", [TL])),
        Code = 1
    ;   Code = 0
    ).

% run_wait(+P, -Status): wait for the command. SIGINT or SIGTERM to
% orbit-kb stops the command, records nothing, removes the temp file
% (cleanup_tmp/0), and exits 130 or 143.
run_wait(P, St) :-
    catch(setup_call_cleanup(run_signals_on(Old),
                             process_wait(P, St),
                             run_signals_off(Old)),
          orbit_signal(Sig),
          run_interrupted(P, Sig)).

run_signals_on(old(I, T)) :-
    on_signal(int, I, run_signal),
    on_signal(term, T, run_signal).

run_signals_off(old(I, T)) :-
    on_signal(int, _, I),
    on_signal(term, _, T).

run_signal(Sig) :- throw(orbit_signal(Sig)).

run_interrupted(P, Sig) :-
    catch(process_kill(P, term), _, true),
    catch(process_wait(P, _), _, true),
    (   memberchk(Sig, [term, 15]) -> Code = 143, Name = "SIGTERM"
    ;   Code = 130, Name = "SIGINT"
    ),
    die(Code, ["orbit-kb run stopped on " + Name + ". The command was stopped. Nothing was recorded."] >> fix_lines).

% record_run(...): called with the KB lock held. It reads kb.pl again,
% because other writers may have appended while the command ran.
% N is 1 more than the highest run number in a test_result and in a log
% name in runs/ (an orphan log from a killed run is never overwritten).
% Files that start with a dot (the runs/.tmp-* files) do not count.
record_run(KB, Check, Result, EC, Now, CmdText, Output, RunN, Log) :-
    kb_dir(KB, Dir),
    recheck_writer(Dir),
    kb_lib(KB, Lib),
    load_kb(Dir, Lib, KB2),
    kb_items(KB2, Items),
    items_decls(Items, Ds),
    findall(N, ( member(it(kb, _, _, A, _, _), Items), nonvar(A),
                 A = attest(_, test_result, _, result(_, N, _), _, _), integer(N) ),
            Ns),
    directory_file_path(Dir, runs, RunsDir),
    directory_files(RunsDir, Fs),
    findall(N, ( member(F, Fs), \+ sub_atom(F, 0, 1, _, '.'),
                 file_name_extension(Base, log, F),
                 atomic_list_concat([NA|_], '-', Base),
                 atom_number(NA, N), integer(N) ),
            LNs),
    append(Ns, LNs, AllNs),
    max_list([0|AllNs], Max),
    RunN is Max + 1,
    run_log_path(KB2, Check, RunN, Log),
    format(string(LogText), "% orbit-kb run ~w check=~w result=~w exit=~w time=~w cmd=~w~n~w",
           [RunN, Check, Result, EC, Now, CmdText, Output]),
    create_exclusive(Log, LogText),
    next_attest_id(Items, Ds, Id),
    Att = attest(Id, test_result, Check, result(Check, RunN, Result), script, Now),
    clause_line(Att, [], Line),
    actor_line(Id, ALine),
    kb_file(KB2, KbFile),
    append_lines(KbFile, [Line, ALine]).

% runs_tmp(+RunsDir, -Path, -Stream): a new private file
% runs/.tmp-<pid>-<random>. The process id makes the name unique among
% running processes; the random part makes it hard to guess. It is
% removed at exit.
runs_tmp(RunsDir, Path, S) :-
    current_prolog_flag(pid, Pid),
    repeat,
    random_between(0, 1000000000000, R),
    format(atom(Path), "~w/.tmp-~w-~w", [RunsDir, Pid, R]),
    \+ exists_file(Path),
    !,
    open(Path, write, S, [encoding(utf8)]),
    assertz(orbit_tmp(Path)).

% create_exclusive(+File, +Text) (D7): create File with Text, and fail
% loudly if File exists. The text goes to a temp file in the same
% directory first. link(2) then gives it the final name; link(2) never
% replaces a file that exists, so this is an exclusive create.
create_exclusive(File, Text) :-
    file_directory_name(File, D),
    current_prolog_flag(pid, Pid),
    random_between(0, 1000000000, R),
    format(atom(Tmp), "~w/.tmp-~w-~w", [D, Pid, R]),
    setup_call_cleanup(open(Tmp, write, S, [encoding(utf8)]),
                       write(S, Text),
                       close(S)),
    catch(link_file(Tmp, File, hard), E, true),
    (   var(E)
    ->  catch(delete_file(Tmp), _, true)
    ;   exists_file(File)
    ->  catch(delete_file(Tmp), _, true),
        die(2, ["The log " + File + " already exists. Another run wrote it.", "Fix: move the old log away, then run again."] >> fix_lines)
    ;   % The file system has no hard links. The KB lock still keeps
        % other orbit-kb processes out, so a rename is safe here.
        rename_file(Tmp, File)
    ).

% ---------------------------------------------------------------------
% prove (D10)
% ---------------------------------------------------------------------

% prove CLAIM FILE THEOREM [--module M]: build the Lake project of FILE,
% then check THEOREM. orbit-kb records a lean_proof only when all of
% these are true:
%   - THEOREM is a theorem, and the module of FILE declares it;
%   - it depends on no axiom other than propext, Classical.choice, and
%     Quot.sound. So it has no sorry, no native_decide, and no local
%     axiom;
%   - leanchecker replays every module of the project that the module
%     imports, under the project root and outside .lake/. This finds a
%     declaration that skipped the kernel;
%   - the built files are still up to date when the digest is taken.
% The log runs/proof-ID.log holds the digest of each file of the proof,
% and the configuration files that do not exist. The digest also covers
% the claim, theorem, module, and statement lines (proof_digest/7). When
% a file changes, or an absent configuration file appears, the proof
% stops counting (proof_changed/1).
% prove checks the proof of an honest agent that can make mistakes. It
% does not resist an agent that cheats on purpose (README section 15).
% As run does, prove works without the KB lock and takes the lock only
% to record.

proof_axiom_ok(propext).
proof_axiom_ok('Classical.choice').
proof_axiom_ok('Quot.sound').

% Files at the project root that also change what a proof means.
lake_config_file('lean-toolchain').
lake_config_file('lake-manifest.json').
lake_config_file('lakefile.toml').
lake_config_file('lakefile.lean').

cmd_prove(KB, Args, Code) :-
    parse_opts(Args, ['--module'-value], Pos, Opts),
    (   Pos = [Claim, File, Thm] -> true
    ;   usage_error("Give a claim, a Lean file, and a theorem: orbit-kb prove CLAIM FILE THEOREM [--module M].", [])
    ),
    (   has_build(KB) -> true
    ;   die(2, ["prove needs the build module. Add build to uses/1 in kb.pl."])
    ),
    kb_items(KB, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = claim(Claim, _, _)
    ->  true
    ;   die(2, ["There is no claim " + Claim + " in kb.pl.", "Fix: check the claim id. Nothing was recorded."] >> fix_lines)
    ),
    absolute_file_name(File, FileAbs0),
    (   exists_file(FileAbs0) -> real_file(FileAbs0, FileAbs)
    ;   die(2, ["The file " + File + " does not exist. Nothing was recorded."] >> fix_lines)
    ),
    lake_root(FileAbs, Root),
    (   memberchk('--module'-Mod, Opts) -> true ; file_module(Root, FileAbs, Mod) ),
    (   absolute_file_name(path(lake), Lake, [access(execute), file_errors(fail)]) -> true
    ;   die(2, ["lake is not on PATH. Install Lean with elan. Nothing was recorded."])
    ),
    kb_lib(KB, Lib),
    directory_file_path(Lib, 'lean/probe.lean', Probe),
    ( exists_file(Probe) -> true ; die(2, ["The library has no lean/probe.lean: " + Probe] >> fix_lines) ),
    kb_dir(KB, Dir),
    directory_file_path(Dir, runs, RunsDir),
    make_directory_path(RunsDir),
    % 1. Build the module.
    prove_exec(Lake, [build, Mod], Root, RunsDir, EC1, Out1),
    (   EC1 =:= 0 -> true
    ;   prove_reject(["lake build " + Mod + " failed (exit " + EC1 + ").",
                      "Fix the Lean file, or give the module with --module if the name is wrong."], Out1)
    ),
    % 2. Read the facts about the theorem.
    prove_exec(Lake, [env, lean, '--run', Probe, Mod, Thm, Root], Root, RunsDir, EC2, Out2),
    (   EC2 =:= 0 -> true
    ;   prove_reject(["The probe failed (exit " + EC2 + ")."], Out2)
    ),
    probe_facts(Out2, PF),
    prove_judge(PF, Mod, Thm, FileAbs, Root, Out2),
    % 3. Replay the project modules in the kernel.
    findall(M, member(file(M, _), PF), PMods),
    prove_exec(Lake, [env, leanchecker|PMods], Root, RunsDir, EC3, Out3),
    (   EC3 =:= 0 -> true
    ;   prove_reject(["leanchecker found a problem, or it is missing (exit " + EC3 + ").",
                      "A declaration that skips the kernel check is not a proof."], Out3)
    ),
    % 4. Take the digest, then check that the build is still up to date.
    proof_files(Root, PF, Files, Absent),
    memberchk(statement(St0), PF),
    proof_digest(Claim, Thm, Mod, St0, Files, Absent, Digest),
    prove_exec(Lake, [build, '--no-build', Mod], Root, RunsDir, EC4, Out4),
    (   EC4 =:= 0 -> true
    ;   prove_reject(["A file of the proof changed while orbit-kb checked it. Run orbit-kb prove again."], Out4)
    ),
    utc_now(Now),
    stored_path(Dir, Root, StoredRoot),
    relative_file_name(FileAbs, Root, RelFile),
    proof_log_text(Claim, Digest, Thm, Mod, RelFile, StoredRoot, PF, Files, Absent, Now, Out1, LogText),
    with_kb_lock(Dir, record_proof(KB, Claim, Digest, Now, LogText, Id, Log)),
    member(statement(St), PF),
    format("proof ~w of claim ~w: theorem ~w (~w)~n", [Id, Claim, Thm, Mod]),
    format("Statement: ~w~n", [St]),
    format("Log: ~w~n", [Log]),
    format("Check that the statement says what claim ~w says. orbit-kb cannot check that.~n", [Claim]),
    Code = 0.

% prove_exec(+Exe, +Args, +Cwd, +RunsDir, -ExitCode, -Output): run a
% command in Cwd, with its output in a private temp file.
prove_exec(Exe, Args, Cwd, RunsDir, EC, Output) :-
    runs_tmp(RunsDir, Tmp, OS),
    catch(process_create(Exe, Args, [cwd(Cwd), stdin(null), stdout(stream(OS)), stderr(stream(OS)), process(P)]), E, true),
    close(OS),
    (   nonvar(E)
    ->  err_text(E, ET),
        die(2, ["Could not start " + Exe + ": " + ET, "Nothing was recorded."] >> fix_lines)
    ;   true
    ),
    run_wait(P, St),
    (   St = exit(EC) -> true
    ;   St = killed(Sig) -> EC is 128 + Sig
    ;   EC = 255
    ),
    read_file_to_string(Tmp, Output, [encoding(utf8)]).

% prove_reject(+Lines, +Output): nothing is recorded. Exit 1, with the
% last 40 lines of the output.
prove_reject(Lines0, Output) :-
    die_fix_lines(Lines0, Lines),
    split_string(Output, "\n", "", OL0),
    ( append(OL1, [""], OL0) -> true ; OL1 = OL0 ),
    length(OL1, Len),
    ( Len > 40 -> Skip is Len - 40, length(Drop, Skip), append(Drop, Tail, OL1) ; Tail = OL1 ),
    (   Tail == [] -> TailLines = []
    ;   length(Tail, TN), fmt(H, "Last ~w line(s) of output:", [TN]), TailLines = [H|Tail]
    ),
    append([["Not proved. Nothing was recorded."], Lines, TailLines], All),
    throw(orbit_error(1, All)).

% lake_root(+File, -Root): the nearest directory, from the directory of
% File upward, with a lakefile.
lake_root(File, Root) :-
    file_directory_name(File, D),
    (   lake_root_(D, Root) -> true
    ;   die(2, ["No Lake project holds " + File + ". There is no lakefile.toml or lakefile.lean in its directory or above."] >> fix_lines)
    ).
lake_root_(D, D) :-
    ( directory_file_path(D, 'lakefile.toml', F) ; directory_file_path(D, 'lakefile.lean', F) ),
    exists_file(F), !.
lake_root_(D, Root) :-
    file_directory_name(D, P), P \== D,
    lake_root_(P, Root).

% file_module(+Root, +File, -Module): Foo/Bar.lean under Root is the
% module Foo.Bar. A library with another srcDir needs --module.
file_module(Root, File, Mod) :-
    relative_file_name(File, Root, Rel),
    (   file_name_extension(Base, lean, Rel), \+ sub_atom(Base, 0, _, _, '..')
    ->  atomic_list_concat(Ps, '/', Base),
        atomic_list_concat(Ps, '.', Mod)
    ;   die(2, ["The file " + File + " is not a .lean file inside its Lake project."] >> fix_lines)
    ).

% probe_facts(+Output, -Facts): the ORBIT-PROVE lines of lean/probe.lean.
probe_facts(Output, Facts) :-
    split_string(Output, "\n", "", Ls),
    findall(F, ( member(L, Ls), string_concat("ORBIT-PROVE ", R, L), probe_fact(R, F) ), Facts).

probe_fact(R, F) :-
    (   sub_string(R, B, 1, A, " ") -> sub_string(R, 0, B, _, K), sub_string(R, _, A, 0, V)
    ;   K = R, V = ""
    ),
    !,
    probe_fact(K, V, F).
probe_fact("lean", V, lean(V)).
probe_fact("kind", V, kind(K)) :- atom_string(K, V).
probe_fact("module", V, module(M)) :- atom_string(M, V).
probe_fact("axiom", V, axiom(X)) :- atom_string(X, V).
probe_fact("statement", V, statement(V)).
probe_fact("uses", V, uses(C, M)) :- two_words(V, C, M).
probe_fact("file", V, file(M, P)) :- two_words(V, M, P).

% two_words(+S, -A, -B): A is the first word of S, B the rest (atoms).
two_words(S, A, B) :-
    (   sub_string(S, X, 1, Y, " ")
    ->  sub_string(S, 0, X, _, SA), sub_string(S, _, Y, 0, SB)
    ;   SA = S, SB = ""
    ),
    !,
    atom_string(A, SA), atom_string(B, SB).

% prove_judge(+Facts, +Module, +Theorem, +File, +Root, +Output): reject
% unless the probe facts show a proof.
prove_judge(PF, Mod, Thm, FileAbs, Root, Out) :-
    (   memberchk(kind(K), PF) -> true ; K = missing ),
    (   K == theorem -> true
    ;   K == missing
    ->  prove_reject(["There is no declaration " + Thm + " in module " + Mod + " or its imports.",
                      "Give the full name, with its namespace."], Out)
    ;   prove_reject(["The declaration " + Thm + " is a " + K + ", not a theorem."], Out)
    ),
    (   memberchk(module(DM), PF), DM == Mod -> true
    ;   ( memberchk(module(DM), PF) -> true ; DM = unknown ),
        prove_reject(["The theorem " + Thm + " is declared in module " + DM + ", not in " + Mod + ".",
                      "Prove the claim with a theorem in the file that you give."], Out)
    ),
    findall(X, ( member(axiom(X), PF), \+ proof_axiom_ok(X) ), Bad),
    (   Bad == [] -> true
    ;   memberchk(sorryAx, Bad)
    ->  prove_reject(["The proof of " + Thm + " uses sorry (the axiom sorryAx). A statement with sorry is not a proof."], Out)
    ;   atomic_list_concat(Bad, ', ', BT),
        prove_reject(["The proof of " + Thm + " depends on axioms that orbit-kb does not accept: " + BT + ".",
                      "Only propext, Classical.choice, and Quot.sound are accepted. native_decide adds an axiom."], Out)
    ),
    relative_file_name(FileAbs, Root, Rel),
    (   member(file(Mod, P), PF), P == Rel -> true
    ;   prove_reject(["The module " + Mod + " is not the file " + Rel + ". Give the module with --module."], Out)
    ).

% proof_files(+Root, +Facts, -Files, -Absent): f(Sha, RelPath) for each
% project source file of the proof and each Lake configuration file,
% sorted; Absent is the sorted list of the configuration files that do
% not exist (D10 follow-up, F7: a file that appears later changes what
% the proof means, so it reopens the burn).
proof_files(Root, PF, Files, Absent) :-
    findall(P, member(file(_, P), PF), Ps1),
    findall(C, ( lake_config_file(C), directory_file_path(Root, C, F), exists_file(F) ), Ps2),
    findall(C, ( lake_config_file(C), directory_file_path(Root, C, F), \+ exists_file(F) ), Ab0),
    sort(Ab0, Absent),
    append(Ps1, Ps2, Ps0),
    sort(Ps0, Ps),
    findall(f(Sha, P), ( member(P, Ps), directory_file_path(Root, P, F), sha256_file(F, Sha) ), Files).

% proof_digest(+Claim, +Theorem, +Module, +Statement, +Files, +Absent,
% ?Digest) (D10 follow-up, F6): the sha256 of these lines, each ended by
% a newline: "claim C", "theorem T", "module M", "statement S", then
% "SHA PATH" for each file, then "absent PATH" for each absent
% configuration file. So the digest binds the claim, the theorem, and
% the statement of the log to its files.
proof_digest(C, T, M, St, Files, Absent, Digest) :-
    fmt(H, "claim ~w~ntheorem ~w~nmodule ~w~nstatement ~w~n", [C, T, M, St]),
    findall(L, ( member(f(Sha, P), Files), fmt(L, "~w ~w~n", [Sha, P]) ), Ls),
    findall(L, ( member(P, Absent), fmt(L, "absent ~w~n", [P]) ), As),
    append([[H], Ls, As], All),
    atomic_list_concat(All, Text),
    sha256_text(Text, Digest).

sha256_text(Text, Digest) :-
    (   catch(( use_module(library(sha)),
                sha:sha_hash(Text, H, [algorithm(sha256), encoding(utf8)]),
                sha:hash_atom(H, Hex) ), _, fail)
    ->  atom_concat('sha256:', Hex, Digest0)
    ;   tmp_stream(txt, F, S),
        call_cleanup(write(S, Text), close(S)),
        sha256_file(F, Digest0)
    ),
    Digest = Digest0.

proof_log_text(Claim, Digest, Thm, Mod, RelFile, StoredRoot, PF, Files, Absent, Now, BuildOut, Text) :-
    ( memberchk(lean(V), PF) -> true ; V = unknown ),
    memberchk(statement(St), PF),
    findall(L, ( member(axiom(X), PF), fmt(L, "axiom ~w", [X]) ), AxLs),
    findall(M, member(file(M, _), PF), PMods),
    findall(L, ( member(uses(C, M), PF), memberchk(M, PMods), fmt(L, "uses ~w ~w", [C, M]) ), UsLs),
    findall(L, ( member(f(Sha, P), Files), fmt(L, "file ~w ~w", [Sha, P]) ), FLs),
    findall(L, ( member(P, Absent), fmt(L, "absent ~w", [P]) ), ALs),
    fmt(H, "% orbit-kb prove claim=~w digest=~w", [Claim, Digest]),
    fmt(L1, "theorem ~w", [Thm]),
    fmt(L2, "module ~w", [Mod]),
    fmt(L3, "source ~w", [RelFile]),
    fmt(L4, "statement ~w", [St]),
    fmt(L5, "lean ~w", [V]),
    fmt(L6, "time ~w", [Now]),
    fmt(L7, "root ~w", [StoredRoot]),
    append([[H, L1, L2, L3, L4, L5, L6], AxLs, UsLs, [L7], FLs, ALs, ["--- lake build output"]], Ls),
    atomic_list_concat(Ls, '\n', Head),
    atomic_list_concat([Head, '\n', BuildOut], Text).

% record_proof(...): called with the KB lock held. It reads kb.pl again,
% as record_run does.
record_proof(KB, Claim, Digest, Now, LogText, Id, Log) :-
    kb_dir(KB, Dir),
    recheck_writer(Dir),
    kb_lib(KB, Lib),
    load_kb(Dir, Lib, KB2),
    kb_items(KB2, Items),
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = claim(Claim, _, _) -> true
    ;   die(2, ["Claim " + Claim + " is no longer in kb.pl. Nothing was recorded."] >> fix_lines)
    ),
    items_decls(Items, Ds),
    next_attest_id(Items, Ds, Id),
    proof_log_path(Dir, Id, Log),
    create_exclusive(Log, LogText),
    Att = attest(Id, lean_proof, Claim, proof(Claim, Digest), script, Now),
    clause_line(Att, [], Line),
    actor_line(Id, ALine),
    kb_file(KB2, KbFile),
    append_lines(KbFile, [Line, ALine]).

proof_log_path(Dir, Id, P) :-
    format(atom(Rel), "runs/proof-~w.log", [Id]),
    directory_file_path(Dir, Rel, P).

% proof_log(+Dir, +Id, -Log): Log = plog(Claim, Digest, RootAbs, Files,
% Absent, Info) from runs/proof-ID.log. Info holds theorem(T), module(M),
% source(F), statement(S), lean(V), time(T), axiom(A), uses(C, M).
proof_log(Dir, Id, plog(C, D, RootAbs, Files, Absent, Info)) :-
    proof_log_path(Dir, Id, P),
    exists_file(P),
    read_file_to_string(P, S, [encoding(utf8)]),
    split_string(S, "\n", "", [H|Ls0]),
    split_string(H, " ", "", ["%", "orbit-kb", "prove", CS, DS]),
    string_concat("claim=", CT, CS), atom_string(C, CT),
    string_concat("digest=", DT, DS), atom_string(D, DT),
    ( append(Ls, ["--- lake build output"|_], Ls0) -> true ; Ls = Ls0 ),
    findall(X, ( member(L, Ls), proof_log_line(L, X) ), Xs),
    memberchk(root(R), Xs),
    (   is_absolute_file_name(R) -> RootAbs = R ; directory_file_path(Dir, R, RootAbs) ),
    findall(f(Sha, Pa), member(file(Sha, Pa), Xs), Files),
    findall(Pa, member(absent(Pa), Xs), Absent),
    exclude([X]>>( X = root(_) ; X = file(_, _) ; X = absent(_) ), Xs, Info).

proof_log_line(L, X) :-
    two_words(L, K, V),
    (   memberchk(K, [theorem, module, source, root, axiom, lean, time, absent]) -> X =.. [K, V]
    ;   K == statement -> sub_string(L, 10, _, 0, VS), X = statement(VS)
    ;   K == uses -> two_words(V, A, B), X = uses(A, B)
    ;   K == file -> two_words(V, A, B), X = file(A, B)
    ).

% proof_log_consistent(+Log, +Claim, +Digest) (D10 follow-up, F6): the
% header names Claim and Digest, and the digest of the claim, theorem,
% module, statement, file, and absent lines of the log is Digest. So a
% log copied for another claim, or an edited line, does not match.
proof_log_consistent(plog(C0, D0, _, Files, Absent, Info), C, D) :-
    C0 == C, D0 == D, Files \== [],
    memberchk(theorem(T), Info), memberchk(module(M), Info), memberchk(statement(St), Info),
    proof_digest(C, T, M, St, Files, Absent, D).

% proof_state(+Dir, +Id, +Pred, -State): ok when the log matches the
% attestation (proof_log_consistent/3), every file of the proof still
% has its digest, and every absent configuration file is still absent.
% Else changed.
proof_state(Dir, Id, P, State) :-
    (   catch(( nonvar(P), P = proof(C, D),
                proof_log(Dir, Id, Log),
                proof_log_consistent(Log, C, D),
                Log = plog(_, _, Root, Files, Absent, _),
                forall(member(f(Sha, Pa), Files),
                       ( directory_file_path(Root, Pa, F), exists_file(F), sha256_file(F, Sha) )),
                forall(member(Pa, Absent),
                       ( directory_file_path(Root, Pa, F), \+ exists_file(F) )) ),
              _, fail)
    ->  State = ok
    ;   State = changed
    ).

% proof_log_matches(+Dir, +Id, +Pred): the log exists, its header names
% the claim and the digest of the attestation, and its lines give that
% digest (lint E9).
proof_log_matches(Dir, Id, proof(C, D)) :-
    catch(( proof_log(Dir, Id, Log), proof_log_consistent(Log, C, D) ), _, fail).

% ---------------------------------------------------------------------
% lint
% ---------------------------------------------------------------------

% ---------------------------------------------------------------------
% Retired predicates (kb-migrations c14, c16, c17)
% ---------------------------------------------------------------------
% A version that retires a predicate N/A writes into kb.pl, before the first clause of N/A, the
% clause N(_, ..., _) :- !, fail. and beside it retired(N/A, Version, What). The facts of N/A stay
% in kb.pl as written; the clause takes them out of the model, also a fact added later. lint
% accepts this one rule form in kb.pl, and only as the first clause of its predicate (else E7),
% and only for a predicate that no rule of the engine has as its head (premise p5). WM1 names the
% predicate, its facts and their reach. It is a warning with no due time: it never blocks done.

% cutfail_clause(+Head, +Body): Head :- !, fail. with distinct variables as the arguments.
cutfail_clause(H, B) :-
    nonvar(B), B = (C, F), C == !, F == fail,
    callable(H), H \= -(_), H \= (_ :- _),
    H =.. [_|As], maplist(var, As),
    term_variables(As, Vs), length(As, N), length(Vs, N).

% cutfail_problem(+Items, +Line, +Head, -Msg): why a cut-fail clause on line Line of kb.pl is
% not accepted; fails when it is.
cutfail_problem(Items, L, H, M) :-
    functor(H, N, A),
    (   member(it(kb, _, L2, T, _, _), Items), L2 < L, nonvar(T), \+ meta_term(T),
        clause_parts(T, H2, _), callable(H2), H2 \= -(_), functor(H2, N, A)
    ->  fmt(M, "This cut-fail clause of ~q/~w comes after a clause of ~q/~w (kb.pl line ~w). It must be the first clause of its predicate in kb.pl, or it hides nothing before it. Move it above line ~w; rules belong in rules.pl.", [N, A, N, A, L2, L2])
    ;   member(it(Src, _, _, T, _, _), Items), Src \== kb, Src \== derived, nonvar(T), \+ meta_term(T),
        T = (H3 :- _), callable(H3), functor(H3, N, A)
    ->  fmt(M, "~q/~w has a rule in the engine or rules.pl. lint accepts a cut-fail clause in kb.pl only for a retired fact predicate (kb-migrations p5). Rules belong in rules.pl, not in kb.pl.", [N, A])
    ;   fail
    ).

% cutfail_pis(+Items, -PIs): N/A-Line for each accepted cut-fail clause of kb.pl.
cutfail_pis(Items, PIs) :-
    findall(N/A-L, ( member(it(kb, _, L, T, _, _), Items), nonvar(T), T = (H :- B),
                     cutfail_clause(H, B), \+ cutfail_problem(Items, L, H, _), functor(H, N, A) ), PIs0),
    sort(PIs0, PIs).

% retired_fact_lines(+Items, +N/A, +CutLine, -Lines): the lines of kb.pl with a fact of N/A after
% its cut-fail clause.
retired_fact_lines(Items, N/A, CL, Lines) :-
    findall(L, ( member(it(kb, _, L, T, _, _), Items), L > CL, nonvar(T), T \= (_ :- _),
                 callable(T), T \= -(_), functor(T, N, A) ), Lines).

% reach_of(+Items, +Ds, +Seeds, -Reach) (c14): the least set that holds Seeds and each head of a
% rule (core, modules, rules.pl) with a body literal in the set, positive or under not. A head
% lint_issue(Code, _, _) with an atomic Code is the node lint(Code); each lint node reaches
% lint_issue/3 too. Reach is sorted; it holds the Seeds.
reach_of(Items0, Ds, Seeds, Reach) :-
    answer_items(Items0, Ds, Items),
    findall(BN-HN, ( member(it(Src, _, _, T, _, _), Items), Src \== kb, nonvar(T),
                     \+ meta_term(T), \+ e17_form(T, _),
                     T = (Hd :- Body), callable(Hd), reach_node(Hd, HN),
                     dep_lits(Body, pos, Deps), member(_-Lit, Deps),
                     callable(Lit), \+ builtin_goal(Lit), reach_node(Lit, BN) ), Es0),
    findall(lint(C)-(lint_issue/3), member(_-lint(C), Es0), Es1),
    append(Es0, Es1, Es2), sort(Es2, Es),
    sort(Seeds, S0),
    reach_fix(Es, S0, Reach).

reach_node(H, lint(C)) :- functor(H, lint_issue, 3), arg(1, H, C), atomic(C), !.
reach_node(H, N/A) :- functor(H, N, A).

reach_fix(Es, R0, R) :-
    findall(H, ( member(B-H, Es), ord_memberchk(B, R0), \+ ord_memberchk(H, R0) ), New0),
    sort(New0, New),
    (   New == [] -> R = R0 ; ord_union(R0, New, R1), reach_fix(Es, R1, R) ).

reach_text(Reach, Seeds, T) :-
    subtract(Reach, Seeds, Rest),
    (   Rest == [] -> T = "none"
    ;   findall(S, ( member(X, Rest), ( X = lint(C) -> fmt(S, "lint ~w", [C]) ; fmt(S, "~q", [X]) ) ), Ss),
        atomic_list_concat(Ss, ', ', A), atom_string(A, T)
    ).

% wm_diags(+Items, +Ds, -Diags): WM1 for each predicate with an accepted cut-fail clause.
wm_diags(Items, Ds, Diags) :-
    cutfail_pis(Items, PIs),
    findall(diag('WM1', F, CL, M),
            ( member(N/A-CL, PIs),
              once(( member(it(kb, F, CL, _, _, _), Items) )),
              retired_fact_lines(Items, N/A, CL, Ls), length(Ls, NF),
              (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T = retired(PI, V, R), PI == N/A
              ->  fmt(RT, "~q/~w was retired in orbit-kb ~w, replaced by ~q.", [N, A, V, R])
              ;   fmt(RT, "~q/~w has a cut-fail clause, and no retired(~q/~w, Version, What) fact names the version that retired it and what replaces it.", [N, A, N, A])
              ),
              reach_of(Items, Ds, [N/A], Reach), reach_text(Reach, [N/A], RchT),
              (   NF =:= 0
              ->  fmt(M, "~w No fact of it is left in kb.pl; the clause hides any fact added later. Reach: ~w.", [RT, RchT])
              ;   atomic_list_concat(Ls, ', ', LT),
                  fmt(M, "~w Its ~w fact(s) stay in kb.pl (line ~w) but are out of the model: no rule and no query finds them. The meaning of what reads them may have changed; analyze the reach: ~w. This warning has no due time and never blocks done.", [RT, NF, LT, RchT])
              ) ),
            Diags).

% ---------------------------------------------------------------------
% The signature of this version (kb-migrations c17)
% ---------------------------------------------------------------------
% The signature is the name/arity of each predicate that core.pl and the modules of this version
% declare, and nothing else: the tool carries no list of retired predicates (what a KB retired is
% written in that KB, with retired/3). share/orbit-kb/signature.pl holds it, one signature(N/A)
% per line; orbit-kb signature --write makes it, and --check compares it with the declarations.

lib_signature(Lib, PIs) :-
    directory_file_path(Lib, 'core.pl', CoreFile),
    read_source_file(core, CoreFile, CI),
    lib_modules(Lib, Ms),
    findall(I, ( member(M, Ms), module_file(Lib, M, MF), read_source_file(module(M), MF, MIs), member(I, MIs) ), MI),
    append(CI, MI, Items),
    findall(N/A, ( member(it(_, _, _, T, _, _), Items), nonvar(T), T = decl(_, H, _, _),
                   callable(H), functor(H, N, A) ), PIs0),
    sort(PIs0, PIs).

signature_file(Lib, F) :- directory_file_path(Lib, 'signature.pl', F).

signature_text(Lib, Text) :-
    lib_signature(Lib, PIs), tool_version_text(V),
    findall(L, ( member(PI, PIs), format(string(L), "~q.", [signature(PI)]) ), Ls),
    format(string(H), "% The signature of orbit-kb ~w: each predicate that core.pl and the modules declare.~n% Made by orbit-kb signature --write. Do not edit it by hand; lint reads no list of retired predicates.", [V]),
    atomic_list_concat([H|Ls], '\n', T0), string_concat(T0, "\n", Text).

file_signature(Lib, PIs) :-
    signature_file(Lib, F), exists_file(F),
    setup_call_cleanup(open(F, read, S, [encoding(utf8)]), mig_read_all(S, Ts), close(S)),
    findall(PI, member(signature(PI), Ts), PIs0), sort(PIs0, PIs).

cmd_signature(Args, Code) :-
    lib_dir(Lib),
    (   Args == []
    ->  signature_text(Lib, T), format("~s", [T]), Code = 0
    ;   Args == ['--write']
    ->  signature_text(Lib, T), signature_file(Lib, F), write_atomic(F, T),
        format("~w~n", [F]), Code = 0
    ;   Args == ['--check']
    ->  lib_signature(Lib, Want),
        (   file_signature(Lib, Have) -> true ; Have = missing ),
        (   Have == Want
        ->  format("The signature file matches the declarations of core.pl and the modules.~n", []), Code = 0
        ;   Have == missing
        ->  format("The signature file is missing. Run orbit-kb signature --write.~n", []), Code = 1
        ;   subtract(Want, Have, Miss), subtract(Have, Want, Extra),
            format("The signature file differs from the declarations. Not in the file: ~q. Not declared: ~q. Run orbit-kb signature --write.~n", [Miss, Extra]),
            Code = 1
        )
    ;   usage_error("signature takes no argument, --write or --check.", [])
    ).

% ---------------------------------------------------------------------
% Migrations (kb-migrations c2, c3, c5, c9, c10, c12, c14, c15)
% ---------------------------------------------------------------------
% A migration is a file in share/orbit-kb/migrations/ with these terms:
%   migration(Id, Version, Doc).        the version of orbit-kb that brings it
%   changes(Id, [N/A, lint(Code), ...]). S: the predicates whose rules or facts it changes
%   step(Id, Step, Owner, Doc).         Owner: tool, agent or human
%   pending(Id, Step, Item, Goal).      each answer Item of Goal (on the KB) is one thing to do
%   writes(Id, Step, Item, Facts).      a tool step: the facts to add for one Item
%   asks(Id, Step, Item, Text).         a human step: the question for one Item
%   retires(Id, N/A, What).             a tool step: the cut-fail clause and retired/3 (c16)
% A step is to do exactly when its pending query has an answer: no marker counts (c5, c12). The
% tool does its own steps in one atomic write (c3), gives an agent the work list of an agent
% step, and raises a question for a human step (c10). It never edits or deletes a line, and it
% writes no fact that only a human may make (c2). A KB whose ticket is closed is frozen (c9).

mig_dir(Lib, D) :- directory_file_path(Lib, migrations, D).

mig_read_all(S, Ts) :-
    read_term(S, T, [module(orbit_ops)]),
    ( T == end_of_file -> Ts = [] ; Ts = [T|R], mig_read_all(S, R) ).

load_migrations(Lib, Ms) :-
    mig_dir(Lib, MD),
    (   exists_directory(MD)
    ->  directory_files(MD, Fs0),
        include([F]>>file_name_extension(_, pl, F), Fs0, Fs1), msort(Fs1, Fs)
    ;   Fs = []
    ),
    findall(T, ( member(F, Fs), directory_file_path(MD, F, P),
                 catch(setup_call_cleanup(open(P, read, S, [encoding(utf8)]), mig_read_all(S, Ts), close(S)), E,
                       ( err_text(E, ET), die(2, ["The migration file " + P + " does not read: " + ET] >> fix_lines) )),
                 member(T, Ts) ), Terms),
    findall(Id, member(migration(Id, _, _), Terms), Ids),
    maplist(mig_build(Terms), Ids, Ms).

mig_build(Terms, Id, mig(Id, V, Doc, S, Steps)) :-
    memberchk(migration(Id, V, Doc), Terms),
    findall(PI, ( member(changes(I, L), Terms), I == Id, is_list(L), member(PI, L) ), S0),
    findall(N/A, ( member(retires(I, N/A, _), Terms), I == Id ), SR),
    ( SR \== [] -> RL = [lint('E2'), lint('E7'), lint('WM1')] ; RL = [] ),
    append([S0, SR, RL], S1), sort(S1, S),
    findall(st(retire(N/A), tool, D, retire(N/A, W)),
            ( member(retires(I, N/A, W), Terms), I == Id,
              fmt(D, "retire ~q/~w: write its cut-fail clause and retired/3 into kb.pl", [N, A]) ), St1),
    findall(st(St, Ow, D, query(Item, Goal, Act)),
            ( member(step(I, St, Ow, D), Terms), I == Id,
              (   member(pending(I2, St2, Item, Goal), Terms), I2 == Id, St2 == St -> true
              ;   die(2, ["The migration " + Id + " has no pending query for its step " + St + "."] >> fix_lines)
              ),
              (   Ow == tool
              ->  ( member(writes(I3, St3, WI, WF), Terms), I3 == Id, St3 == St -> Act = writes(WI, WF)
                  ; die(2, ["The tool step " + St + " of migration " + Id + " has no writes/4."] >> fix_lines) )
              ;   Ow == human
              ->  ( member(asks(I3, St3, AI, AT), Terms), I3 == Id, St3 == St -> Act = asks(AI, AT)
                  ; die(2, ["The human step " + St + " of migration " + Id + " has no asks/4."] >> fix_lines) )
              ;   Ow == agent -> Act = work
              ;   die(2, ["The step " + St + " of migration " + Id + " has the owner " + Ow + ": use tool, agent or human."] >> fix_lines)
              ) ),
            St2s),
    append(St1, St2s, Steps).

% mig_made_by(+KbFile, -V): the newest version that a "% Made by orbit-kb V." line names, or none.
mig_made_by(KbFile, V) :-
    read_file_to_string(KbFile, S, [encoding(utf8)]),
    split_string(S, "\n", "", Ls),
    findall(P-V0, ( member(L, Ls), split_string(L, "", " \t\r", [L1]),
                    string_concat("% Made by orbit-kb ", R0, L1), string_concat(R1, ".", R0),
                    atom_string(V0, R1), version_parts(V0, P) ), Ps),
    (   Ps == [] -> V = none ; msort(Ps, Sorted), last(Sorted, _-V) ).

version_parts(V, [A, B, C]) :-
    atom(V), atomic_list_concat([SA, SB, SC], '.', V),
    atom_number(SA, A), atom_number(SB, B), atom_number(SC, C), integer(A), integer(B), integer(C).

% mig_step_items(+Eng, +Items, +Step, -Res): ok(ThingsToDo) or err(Msg).
mig_step_items(_, Items, st(_, _, _, retire(N/A, _)), ok(Things)) :- !,
    (   member(it(kb, _, _, T, _, _), Items), nonvar(T), T \= (_ :- _), callable(T), T \= -(_), functor(T, N, A),
        \+ ( member(it(kb, _, _, T2, _, _), Items), nonvar(T2), T2 = (H2 :- B2), cutfail_clause(H2, B2), functor(H2, N, A) )
    ->  Things = [N/A]
    ;   Things = []
    ).
mig_step_items(Eng, _, st(_, _, _, query(Item, Goal, _)), Res) :-
    copy_term(Item-Goal, I-G),
    swi_raw(Eng, G, [I], R),
    (   R = answers(L0, _) -> findall(X, member([X], L0), Xs0), sort(Xs0, Xs), Res = ok(Xs)
    ;   R = error(M) -> Res = err(M)
    ).

% mig_status(+KB, +Ms, -Rows): one row per step of each migration:
% row(MigId, Version, Step, Owner, Doc, Things) or rowerr(MigId, Step, Msg).
mig_status(KB, Ms, Rows) :-
    kb_items(KB, Items), kb_engine(KB, Eng),
    findall(Row, ( member(mig(Id, V, _, _, Steps), Ms), member(St, Steps), St = st(SId, Ow, D, _),
                   mig_step_items(Eng, Items, St, Res),
                   ( Res = ok(Th) -> Row = row(Id, V, SId, Ow, D, Th) ; Res = err(Msg), Row = rowerr(Id, SId, Msg) ) ),
            Rows).

required_owner(tool).
required_owner(agent).

% human_only_fact(+ATs, +F): a fact that only the human may make (c2).
human_only_fact(_, F) :- nonvar(F), F = attest(_, _, _, _, By, _), By == human, !.
human_only_fact(ATs, F) :- nonvar(F), F = attest(_, Ty, _, _, _, _), atom(Ty),
    member(at(Ty, _, Ws, _), ATs), Ws == [human], !.
human_only_fact(_, F) :- nonvar(F), F = answer(_, _, By), ( By == human ; nonvar(By), By = human:_ ), !.
human_only_fact(_, F) :- nonvar(F), functor(F, N, A),
    memberchk(N/A, [discovery_end/1, request_accepted/3, ratified_by/3, decided_by/3, waiver/4, decision/2]), !.

% mig_plan_writes(+KB, +Rows, +Ms, -Plan): plan(Inserts, Adds, Errs) for the tool and human
% steps that are to do. Inserts: ins(Line, N/A, What, MigId). Adds: F-MigId.
mig_plan_writes(KB, Rows, Plan) :-
    kb_items(KB, Items), kb_engine(KB, Eng), items_atypes(Items, ATs),
    load_migrations_kb(KB, Ms),
    findall(ins(L, N/A, W, Id, MV),
            ( member(row(Id, MV, retire(N/A), tool, _, [_|_]), Rows),
              member(mig(Id, _, _, _, Steps), Ms), memberchk(st(retire(N/A), tool, _, retire(N/A, W)), Steps),
              once(( member(it(kb, _, L, T, _, _), Items), nonvar(T), T \= (_ :- _), callable(T), T \= -(_), functor(T, N, A) )) ),
            Ins),
    findall(F-Id,
            ( member(row(Id, _, SId, tool, _, Things), Rows), SId \= retire(_),
              member(mig(Id, _, _, _, Steps), Ms), member(st(SId0, tool, _, query(_, _, writes(WI, WF))), Steps), SId0 == SId,
              member(X, Things), copy_term(WI-WF, X-Fs), ( is_list(Fs) -> member(F, Fs) ; F = Fs ) ),
            Adds0),
    mig_questions(Items, Eng, Rows, Ms, Adds0, QAdds, QErrs),
    append(Adds0, QAdds, Adds),
    findall(M, ( member(F-Id, Adds), human_only_fact(ATs, F),
                 fmt(M, "migration ~w would write ~q, a record that only a human may make. Nothing was written: a migration raises a question for such a step instead (c2).", [Id, F]) ),
            HErrs),
    findall(M, ( member(rowerr(Id, SId, Msg), Rows), fmt(M, "the pending query of step ~w of migration ~w failed: ~w", [SId, Id, Msg]) ), RErrs),
    append([HErrs, QErrs, RErrs], Errs),
    Plan = plan(Ins, Adds, Errs).

load_migrations_kb(KB, Ms) :- kb_lib(KB, Lib), load_migrations(Lib, Ms).

% mig_questions: one question for each thing to do of a human step that no question of the same
% migration and text already asks. The question hangs on the newest current hypothesis, else on
% the first current claim.
mig_questions(Items, Eng, Rows, Ms, _, QAdds, QErrs) :-
    findall(Id-Text,
            ( member(row(Id, _, SId, human, _, Things), Rows),
              member(mig(Id, _, _, _, Steps), Ms), member(st(SId0, human, _, query(_, _, asks(AI, AT))), Steps), SId0 == SId,
              member(X, Things), copy_term(AI-AT, X-T0), mig_text(T0, X, Text),
              \+ ( member(it(kb, _, _, MA, _, _), Items), nonvar(MA), MA = migration_added(Id2, _, question(_, _, T2)),
                   Id2 == Id, T2 == Text ) ),
            Qs0),
    list_to_set(Qs0, Qs),
    (   Qs == [] -> QAdds = [], QErrs = []
    ;   (   eng_all(Eng, [H], ( hypothesis(H, _, _), \+ superseded(H) ), Hs), last(Hs, Tgt) -> true
        ;   eng_all(Eng, [C], current(C), [Tgt|_]) -> true
        ;   Tgt = none
        ),
        (   Tgt == none
        ->  QAdds = [],
            findall(M, ( member(Id-_, Qs), fmt(M, "migration ~w must ask the human, but the KB has no current hypothesis or claim to hang the question on. Add one, then apply again.", [Id]) ), QErrs)
        ;   findall(N, ( member(it(kb, _, _, T, _, _), Items), nonvar(T), T = question(Q, _, _), atom(Q),
                         atom_concat(q, NA, Q), atom_number(NA, N), integer(N) ), Ns),
            max_list([0|Ns], Max),
            findall(question(Q, Tgt, Text)-Id, ( nth1(K, Qs, Id-Text), N is Max + K, atom_concat(q, N, Q) ), QAdds),
            QErrs = []
        )
    ).

mig_text(T0, X, Text) :-
    (   atom(T0), sub_atom(T0, _, _, _, '~') -> format(atom(Text), T0, [X])
    ;   atom(T0) -> Text = T0
    ;   format(atom(Text), "~w", [T0])
    ).

% mig_new_text(+KbFile, +Plan, +Version, +Now, -Text): kb.pl with the writes of the plan. Each old
% line stays as it is; a retire inserts its clause and facts above the first clause of its
% predicate; the other facts are appended, each with migration_added/3 after it.
mig_new_text(KbFile, plan(Ins, Adds, _), V, Now, Text) :-
    read_file_to_string(KbFile, S, [encoding(utf8)]),
    split_string(S, "\n", "", Ls0),
    ( append(Ls1, [""], Ls0) -> true ; Ls1 = Ls0 ),
    findall(L-Block,
            ( member(ins(L, N/A, W, Id, MV), Ins),
              cutfail_text(N, A, C1),
              R = retired(N/A, MV, W),
              clause_line(R, [], C2), clause_line(migration_added(Id, V, R), [], C3),
              Block = [C1, C2, C3] ),
            Blocks),
    mig_insert(Ls1, 1, Blocks, Ls2),
    (   Adds == [] -> Tail = []
    ;   findall(Id, member(_-Id, Adds), Ids0), sort(Ids0, Ids), atomic_list_concat(Ids, ', ', IdT),
        format(string(Hd), "% orbit-kb migrate apply: ~w, by orbit-kb ~w at ~w.", [IdT, V, Now]),
        findall(X, ( member(F-Id, Adds), ( clause_line(F, [], X) ; clause_line(migration_added(Id, V, F), [], X) ) ), Xs),
        Tail = [Hd|Xs]
    ),
    append(Ls2, Tail, Ls3),
    atomic_list_concat(Ls3, '\n', T0), string_concat(T0, "\n", Text).

% cutfail_text(+N, +A, -Text): N(_, ..., _) :- !, fail.
cutfail_text(N, A, T) :-
    length(Us, A), maplist(=("_"), Us), atomic_list_concat(Us, ', ', UT),
    format(atom(NQ), "~q", [N]),
    (   A =:= 0 -> format(string(T), "~w :- !, fail.", [NQ]) ; format(string(T), "~w(~w) :- !, fail.", [NQ, UT]) ).

mig_insert([], _, _, []).
mig_insert([L|Ls], N, Blocks, Out) :-
    findall(X, ( member(N-B, Blocks), member(X, B) ), Pre),
    N1 is N + 1,
    mig_insert(Ls, N1, Blocks, Rest),
    append(Pre, [L|Rest], Out).

% mig_validate(+KB, +Plan, -Problems): the facts of the plan pass the checks of add.
mig_validate(KB, plan(Ins, Adds, _), Problems) :-
    kb_file(KB, KbFile),
    tool_version_text(V),
    findall(it(kb, KbFile, 0, F, [], 0-0), member(F-_, Adds), I1),
    findall(it(kb, KbFile, 0, migration_added(Id, V, F), [], 0-0), member(F-Id, Adds), I2),
    findall(it(kb, KbFile, 0, retired(N/A, MV, W), [], 0-0), member(ins(_, N/A, W, _, MV), Ins), I3),
    append([I1, I2, I3], New),
    validate_new(KB, New, Ps),
    findall(M, ( member(diag(C, _, _, M0), Ps), fmt(M, "~w ~w", [C, M0]) ), Problems).

% ---- the verdicts of a KB, read by running an engine (c15) ----
mig_child(Exe, Args, Env, Exit, Out) :-
    catch(( process_create(Exe, Args, [stdin(null), stdout(pipe(O)), stderr(null), process(P)|Env]),
            read_string(O, _, Out), close(O), process_wait(P, St) ), _, ( Out = "", St = exit(2) )),
    ( St = exit(Exit) -> true ; Exit = 2 ).

mig_verdict_goals(['done', 'discovery_ready', 'gate(X)', 'blocking(X)', 'burn_open(X)', 'flare_open(X)', 'stale(X)']).

% mig_verdicts(+Exe, +Env, +Dir, -Vs): V-Answers for each verdict, show open and each lint code.
mig_verdicts(Exe, Env, Dir, Vs) :-
    mig_verdict_goals(Gs),
    findall(G-A, ( member(G, Gs),
                   mig_child(Exe, ['--dir', Dir, query, G, '-n', '0'], Env, X, Out),
                   ( X == 0 -> split_string(Out, "\n", " ", L0), exclude(==(""), L0, L1), msort(L1, A)
                   ; X == 1 -> A = []
                   ; A = [undefined] ) ),
            V1),
    mig_child(Exe, ['--dir', Dir, show, open], Env, SX, SO),
    (   SX == 2 -> SL = [undefined]
    ;   split_string(SO, "\n", " ", SL0), exclude(==(""), SL0, SL1), msort(SL1, SL)
    ),
    mig_child(Exe, ['--dir', Dir, lint], Env, _, LO),
    split_string(LO, "\n", "", LL),
    findall(C, ( member(L, LL), split_string(L, " ", "", [CS|_]), atom_string(C, CS),
                 atom_codes(C, [U|Ds]), code_type(U, upper), Ds \== [], last(Ds, LD), code_type(LD, digit) ), Cs0),
    msort(Cs0, Cs), clumped_pairs(Cs, CPs),
    findall(lint(C)-[N], member(C-N, CPs), V3),
    append([V1, ['show open'-SL], V3], Vs).

clumped_pairs(Cs, Ps) :- findall(C-1, member(C, Cs), Ones), clumped_sum(Ones, Ps).
clumped_sum([], []).
clumped_sum([C-N|Rest], Out) :-
    (   Rest = [C-M|R2] -> N2 is N + M, clumped_sum([C-N2|R2], Out)
    ;   Out = [C-N|O2], clumped_sum(Rest, O2)
    ).

verdict_node('done', done/0).
verdict_node('discovery_ready', discovery_ready/0).
verdict_node('gate(X)', gate/1).
verdict_node('blocking(X)', blocking/1).
verdict_node('burn_open(X)', burn_open/1).
verdict_node('flare_open(X)', flare_open/1).
verdict_node('stale(X)', stale/1).
verdict_node(lint(C), lint(C)).

% verdict_in_reach(+V, +Reach): show open is in the reach when blocking/1 or done/0 is.
verdict_in_reach('show open', R) :- !, ( ord_memberchk(blocking/1, R) ; ord_memberchk(done/0, R) ), !.
verdict_in_reach(V, R) :- verdict_node(V, N), ord_memberchk(N, R).

% mig_diffs(+Old, +New, -Diffs): d(V, OldAnswers, NewAnswers) for each verdict that differs.
mig_diffs(Old, New, Diffs) :-
    findall(V, ( member(V-_, Old) ; member(V-_, New) ), Vs0), sort(Vs0, Vs),
    findall(d(V, A, B), ( member(V, Vs),
                          ( memberchk(V-A, Old) -> true ; A = [] ),
                          ( memberchk(V-B, New) -> true ; B = [] ),
                          A \== B ),
            Diffs).

verdict_text(lint(C), T) :- !, fmt(T, "lint ~w (count)", [C]).
verdict_text(V, T) :- fmt(T, "~w", [V]).

answers_text([], "none") :- !.
answers_text(L, T) :- atomic_list_concat(L, '; ', A), atom_string(A, T).

% mig_shadow(+Dir, +Text, -Tmp): a temporary KB directory with kb.pl = Text and a link to each
% other entry of Dir, so the paths of subjects and logs resolve as in Dir.
% Review a128: the shadow is a sibling of Dir (.NAME.orbit-mig-PID-R in the same parent), so a relative
% path in kb.pl, such as project_kb('../../project-kb'), resolves as it does in Dir. mig_rm_shadow/1
% removes it: links are unlinked, never followed.
mig_shadow(Dir, Text, Tmp) :-
    absolute_file_name(Dir, ADir), file_directory_name(ADir, Parent), file_base_name(ADir, Base),
    current_prolog_flag(pid, Pid), random_between(0, 1000000000, R),
    format(atom(Name), ".~w.orbit-mig-~w-~w", [Base, Pid, R]),
    directory_file_path(Parent, Name, Tmp),
    make_directory(Tmp),
    directory_files(Dir, Es),
    forall(( member(E, Es), \+ memberchk(E, ['.', '..', 'kb.pl', 'kb.lock', 'writer.lock']) ),
           ( directory_file_path(Dir, E, Src), directory_file_path(Tmp, E, Dst),
             catch(link_file(Src, Dst, symbolic), _, true) )),
    directory_file_path(Tmp, 'kb.pl', F),
    setup_call_cleanup(open(F, write, S, [encoding(utf8)]), write(S, Text), close(S)).

mig_rm_shadow(D) :-
    (   catch(directory_files(D, Es), _, fail)
    ->  forall(( member(E, Es), \+ memberchk(E, ['.', '..']) ),
               ( directory_file_path(D, E, P),
                 (   catch(read_link(P, _, _), _, fail) -> catch(delete_file(P), _, true)
                 ;   exists_directory(P) -> mig_rm_shadow(P)
                 ;   catch(delete_file(P), _, true)
                 ) )),
        catch(delete_directory(D), _, true)
    ;   true
    ).

% mig_plan(+KB, +OldExe, -Report): the whole plan of the KB: rows, writes, reach, differences.
mig_plan(KB, Old, rep(Ms, Rows, Plan, Text, Reach, Diffs, Outside, Problems)) :-
    load_migrations_kb(KB, Ms),
    mig_status(KB, Ms, Rows),
    mig_plan_writes(KB, Rows, Plan),
    kb_dir(KB, Dir), kb_file(KB, KbFile),
    tool_version_text(V), utc_now(Now),
    mig_new_text(KbFile, Plan, V, Now, Text),
    ( Plan = plan([], [], _) -> Problems = [] ; mig_validate(KB, Plan, Problems) ),
    findall(S, ( member(mig(Id, _, _, S0, _), Ms), mig_touched(Id, Rows), member(S, S0) ), Ss0), sort(Ss0, Ss),
    kb_items(KB, Items), items_decls(Items, Ds),
    reach_of(Items, Ds, Ss, Reach),
    orbit_script(Script0), real_file(Script0, Self),
    (   Old = some(OldExe) -> OldEnv = [env(Env0)], findall(K=Val, ( member(K, ['PATH', 'HOME', 'XDG_CACHE_HOME', 'TMPDIR', 'LANG']), getenv(K, Val) ), Env0)
    ;   OldExe = Self, OldEnv = []
    ),
    (   Plan = plan([], [], _), Old == none
    ->  Diffs = [], Outside = []
    ;   mig_verdicts(OldExe, OldEnv, Dir, VOld),
        setup_call_cleanup(mig_shadow(Dir, Text, Tmp),
                           mig_verdicts(Self, [], Tmp, VNew),
                           mig_rm_shadow(Tmp)),
        mig_diffs(VOld, VNew, Diffs),
        include([d(Vd, A, _)]>>( A \== [undefined], \+ verdict_in_reach(Vd, Reach) ), Diffs, Outside)
    ).

mig_touched(Id, Rows) :- member(row(Id, _, _, _, _, [_|_]), Rows), !.
% kb-migrations c20: a migration with no steps declares a change that the engine itself brings
% (it writes nothing); its S is always in the reach.
mig_touched(Id, Rows) :- \+ member(row(Id, _, _, _, _, _), Rows), \+ member(rowerr(Id, _, _), Rows).

mig_digest(KB, Report, Digest) :-
    Report = rep(_, Rows, plan(Ins, Adds, Errs), _, Reach, Diffs, Outside, Problems),
    kb_file(KB, KbFile), read_file_to_string(KbFile, S, [encoding(utf8)]),
    tool_version_text(V),
    format(string(X), "~q", [v(V, S, Rows, Ins, Adds, Errs, Reach, Diffs, Outside, Problems)]),
    sha256_text(X, Digest).

% cmd_migrate(+DirOpt, +Args, -Code)
cmd_migrate(DirOpt, Args, Code) :-
    (   Args = [Sub|Rest] -> true ; Sub = check, Rest = [] ),
    resolve_kb(DirOpt, Dir),
    (   Sub == check -> mig_cmd_check(Dir, Rest, Code)
    ;   Sub == plan  -> mig_cmd_plan(Dir, Rest, Code)
    ;   Sub == apply -> mig_cmd_apply(Dir, Rest, Code)
    ;   usage_error("migrate takes check, plan or apply: orbit-kb migrate check|plan [--old ENGINE]|apply --seen DIGEST.", [])
    ).

mig_load(Dir, KB) :- lib_dir(Lib), load_kb(Dir, Lib, KB).

% check (c5, c12): one line per step with something to do. Exit 1 when a tool or agent step is to
% do (a required step), else 0. A human step and a retired predicate never make it 1.
mig_cmd_check(Dir, Args, Code) :-
    ( Args == [] -> true ; usage_error("migrate check takes no arguments.", []) ),
    mig_load(Dir, KB), load_migrations_kb(KB, Ms), mig_status(KB, Ms, Rows),
    forall(member(rowerr(Id, SId, Msg), Rows), format("error ~w ~w: the pending query failed: ~w~n", [Id, SId, Msg])),
    forall(( member(row(Id, _, SId, Ow, D, Th), Rows), Th = [_|_] ),
           ( length(Th, NT), ( required_owner(Ow) -> K = todo ; K = migrating ),
             findall(T, ( member(X, Th), fmt(T, "~q", [X]) ), Ts), atomic_list_concat(Ts, ' ', TT),
             format("~w ~w ~q ~w ~w: ~w. ~w~n", [K, Id, SId, Ow, NT, D, TT]) )),
    kb_items(KB, Items), cutfail_pis(Items, PIs),
    forall(member(N/A-CL, PIs),
           ( retired_fact_lines(Items, N/A, CL, Ls), length(Ls, NF),
             format("retired ~q/~w ~w fact(s): lint WM1 warns; it never fails this check.~n", [N, A, NF]) )),
    (   member(rowerr(_, _, _), Rows) -> Code = 2
    ;   member(row(_, _, _, Ow, _, [_|_]), Rows), required_owner(Ow) -> Code = 1
    ;   Code = 0
    ).

mig_cmd_plan(Dir, Args, Code) :-
    parse_opts(Args, ['--old'-value], Pos, Opts),
    ( Pos == [] -> true ; usage_error("migrate plan takes only --old ENGINE.", []) ),
    ( memberchk('--old'-OE, Opts) -> mig_old_exe(OE, OX), Old = some(OX) ; Old = none ),
    mig_load(Dir, KB),
    mig_plan(KB, Old, Rep),
    mig_print_plan(KB, Old, Rep),
    mig_digest(KB, Rep, D),
    Rep = rep(_, _, plan(Ins, Adds, Errs), _, _, _, Outside, Problems),
    (   ( Errs \== [] ; Outside \== [] ; Problems \== [] )
    ->  format("apply refuses this plan (see above).~n", []), Code = 1
    ;   Ins == [], Adds == []
    ->  format("Nothing to write.~n", []), Code = 0
    ;   format("Seen: ~w~nShow this plan to the human. To land it: orbit-kb migrate apply --seen ~w~n", [D, D]), Code = 0
    ).

mig_old_exe(OE, OX) :-
    (   exists_file(OE), access_file(OE, execute) -> absolute_file_name(OE, OX)
    ;   die(2, ["--old must name an orbit-kb that runs: " + OE] >> fix_lines)
    ).

mig_print_plan(KB, Old, rep(Ms, Rows, plan(Ins, Adds, Errs), _, Reach, Diffs, Outside, Problems)) :-
    kb_dir(KB, Dir), kb_file(KB, KbFile), mig_made_by(KbFile, MB), tool_version_text(V),
    format("Migration plan for ~w (made by orbit-kb ~w; this is orbit-kb ~w).~n", [Dir, MB, V]),
    (   Old = some(OX) -> format("Old side: ~w on kb.pl as it is. New side: this orbit-kb on the migrated kb.pl.~n", [OX])
    ;   format("Old side: this orbit-kb on kb.pl as it is (no --old ENGINE: a change that the engine itself brings is not shown). New side: this orbit-kb on the migrated kb.pl.~n", [])
    ),
    forall(( member(mig(Id, MV, MD, S, _), Ms), mig_touched(Id, Rows) ),
           ( findall(T, ( member(X, S), ( X = lint(C) -> fmt(T, "lint ~w", [C]) ; fmt(T, "~q", [X]) ) ), STs),
             atomic_list_concat(STs, ', ', ST),
             format("~nMigration ~w (orbit-kb ~w): ~w~n  Declared change S: ~w~n", [Id, MV, MD, ST]),
             forall(( member(row(Id, _, SId, Ow, D, Th), Rows), Th = [_|_] ),
                    ( length(Th, NT), findall(T2, ( member(Y, Th), fmt(T2, "~q", [Y]) ), T2s), atomic_list_concat(T2s, ' ', TT),
                      format("  step ~q (~w): ~w to do: ~w. ~w~n", [SId, Ow, NT, TT, D]) )) )),
    reach_text(Reach, [], RT),
    format("~nReach of S (c14): ~w~n", [RT]),
    length(Ins, NI), length(Adds, NA),
    format("~nWrites: ~w insertion(s) above a first clause, ~w fact(s) appended, each with migration_added/3. No line of kb.pl changes or goes.~n", [NI, NA]),
    forall(member(ins(L, N/A, W, Id, MV), Ins),
           ( cutfail_text(N, A, CT), format("  + above line ~w: ~w  and retired(~q/~w, ~q, ~q)   (~w)~n", [L, CT, N, A, MV, W, Id]) )),
    forall(member(F-Id, Adds), ( clause_line(F, [], FL), format("  + ~w   (~w)~n", [FL, Id]) )),
    forall(member(E, Errs), format("REFUSED: ~w~n", [E])),
    forall(member(P, Problems), format("REFUSED: a fact of the plan fails a check of add: ~w~n", [P])),
    (   Diffs == [] -> format("~nVerdicts: none differs.~n", [])
    ;   format("~nVerdicts that differ (old -> new):~n", []),
        forall(member(d(Vd, A, B), Diffs),
               ( verdict_text(Vd, VT), answers_text(A, AT), answers_text(B, BT),
                 (   verdict_in_reach(Vd, Reach) -> Where = "in the reach"
                 ;   A == [undefined] -> Where = "not compared: the old side gives no answer on kb.pl as it is; --old ENGINE of the version that wrote it compares it"
                 ;   Where = "OUTSIDE the reach: an undeclared change; apply refuses"
                 ),
                 format("  ~w: ~w -> ~w (~w)~n", [VT, AT, BT, Where]) ))
    ),
    ( Outside == [] -> true ; format("~nThe declared change S of a migration misses a verdict that it changes. Fix the migration, not the KB.~n", []) ).

% apply (c2, c3, c9): the writes of the plan in one atomic rename, under the KB lock, only when
% the digest of the plan is the one that was shown (--seen). A KB that a newer orbit-kb made, a
% KB whose ticket is closed (frozen), and a plan with an error are refused with no write.
mig_cmd_apply(Dir, Args, Code) :-
    parse_opts(Args, ['--seen'-value, '--old'-value, '--take'-flag, '--as'-value], Pos, Opts),
    ( Pos == [] -> true ; usage_error("migrate apply takes --seen DIGEST (and --old ENGINE when the plan had it).", []) ),
    ( memberchk('--old'-OE, Opts) -> mig_old_exe(OE, OX), Old = some(OX) ; Old = none ),
    mig_frozen_gate(Dir),
    directory_file_path(Dir, 'kb.pl', KbFile),
    mig_made_by(KbFile, MB), tool_version_text(V),
    (   MB \== none, version_parts(MB, PB), version_parts(V, PV), PB @> PV
    ->  die(1, ["Refused: orbit-kb " + MB + " made this KB, and it is newer than this orbit-kb (" + V + "). Nothing was written.",
                "Fix: run the newer orbit-kb."] >> fix_lines)
    ;   true
    ),
    take_role(Args, ArgsR), writer_gate(Dir, ArgsR, _),
    with_kb_lock(Dir, mig_apply_locked(Dir, Old, Opts, Code)).

mig_apply_locked(Dir, Old, Opts, Code) :-
    mig_load(Dir, KB),
    kb_items(KB, Items),
    (   member(synerr(_, F, L, M), Items)
    ->  die(1, ["Refused: kb.pl does not read (" + F + ":" + L + ": " + M + "). Nothing was written.", "Fix: lint E1 first."] >> fix_lines)
    ;   true
    ),
    mig_plan(KB, Old, Rep),
    Rep = rep(_, _, Plan, Text, _, _, Outside, Problems),
    Plan = plan(Ins, Adds, Errs),
    (   Ins == [], Adds == []
    ->  forall(member(E, Errs), format(user_error, "~w~n", [E])),
        format("Nothing to write: no tool step and no new question is to do. orbit-kb migrate check lists the work of an agent.~n", []),
        ( Errs == [] -> Code = 0 ; Code = 1 )
    ;   ( Errs \== [] ; Problems \== [] ; Outside \== [] )
    ->  mig_print_plan(KB, Old, Rep),
        format(user_error, "Refused: the plan has an error (above). Nothing was written.~n", []), Code = 1
    ;   mig_digest(KB, Rep, D),
        (   memberchk('--seen'-D, Opts) -> true
        ;   memberchk('--seen'-D0, Opts)
        ->  die(1, ["Refused: the plan changed since it was shown (--seen " + D0 + "; it is now " + D + "). Nothing was written.",
                    "Fix: run orbit-kb migrate plan again and show it to the human."] >> fix_lines)
        ;   die(1, ["Refused: no --seen DIGEST. Nothing was written. The human sees each change before it lands (c15).",
                    "Fix: run orbit-kb migrate plan, show it to the human, then orbit-kb migrate apply --seen DIGEST."] >> fix_lines)
        ),
        kb_file(KB, KbFile),
        write_atomic(KbFile, Text),
        length(Ins, NI), length(Adds, NA),
        format("Migrated ~w: ~w insertion(s), ~w fact(s) added. No line changed or went.~n", [KbFile, NI, NA]),
        Code = 0
    ).

% mig_frozen_gate(+Dir) (c9): in a hub, a spec KB whose ticket is closed is frozen.
mig_frozen_gate(Dir) :-
    (   mig_hub_slug(Dir, Hub, Slug),
        directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf), exists_file(Hf),
        absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)])
    ->  mig_child(Exe, [Hf, '--hub', Hub, 'kb-state', Slug], [cwd(Hub)], X, Out),
        split_string(Out, "", " \n", [St]),
        (   X == 0, St == "open"
        ->  true
        ;   X == 0, St == "closed"
        ->  die(1, ["Refused: the ticket of kb:" + Slug + " is closed, so its KB is frozen at the version that closed it (c9). Nothing was written."] >> fix_lines)
        ;   % review a93: fail closed. A KB of a hub whose state the ledger cannot give may be frozen.
            die(1, ["Refused: hubflow kb-state " + Slug + " did not answer open or closed, so this KB may be frozen (c9). Nothing was written.",
                    "Fix: make python3 .claude/scripts/hubflow.py kb-state " + Slug + " work in the hub (an older hubflow lacks it: upgrade the kit)."] >> fix_lines)
        )
    ;   true
    ).

mig_hub_slug(Dir, Hub, Slug) :-
    absolute_file_name(Dir, A), file_base_name(A, Slug), file_directory_name(A, P),
    file_base_name(P, specs), file_directory_name(P, Hub), !.
% review a166: a KB of the form before 0.3.0, HUB/W<n>/analyses/<slug>/..., has the slug <slug>.
mig_hub_slug(Dir, Hub, Slug) :-
    absolute_file_name(Dir, A), kb_hub_root(A, Hub),
    atom_concat(Hub, '/', HP), atom_concat(HP, Rel, A),
    atomic_list_concat([W, analyses, Slug|_], '/', Rel),
    atom_concat('W', N, W), atom_number(N, _), Slug \== ''.

cmd_lint(KB, Args, Code) :-
    parse_opts(Args, ['--strict'-flag], Pos, Opts),
    ( Pos == [] -> true ; usage_error("lint takes no arguments other than --strict.", []) ),
    opt(Opts, '--strict', false, Strict),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    lint_diags(KB, Diags, IssueLines, IssueErrors),
    include([diag(C, _, _, _)]>>sub_atom(C, 0, 1, _, 'E'), Diags, Errs),
    exclude([diag(C, _, _, _)]>>sub_atom(C, 0, 1, _, 'E'), Diags, Warns),
    forall(member(D, Errs), print_diag(D)),
    forall(member(D, Warns), print_diag(D)),
    forall(member(L, IssueLines), format("~w~n", [L])),
    length(Errs, NE0), length(Warns, NW0),
    length(IssueLines, NI),
    NE is NE0 + IssueErrors,
    NW is NW0 + NI - IssueErrors,
    format("Summary: ~w error(s), ~w warning(s).~n", [NE, NW]),
    (   NE > 0 -> Code = 1
    ;   Strict == true, NW > 0 -> Code = 1
    ;   Code = 0
    ).

print_diag(diag(C, F, L, M)) :-
    (   F == ''
    ->  format("~w ~w~n", [C, M])
    ;   show_loc(F, L, LT),
        format("~w ~w: ~w~n", [C, LT, M])
    ).

lint_diags(KB, Diags, IssueLines, IssueErrors) :-
    kb_items(KB, Items),
    kb_dir(KB, Dir),
    kb_lib(KB, Lib),
    directory_file_path(Dir, 'kb.pl', KbFile),
    items_decls(Items, Ds),
    items_atypes(Items, ATs),
    % E1
    findall(diag('E1', F, L, M), member(synerr(_, F, L, M), Items), D1),
    % E10
    e10_diags(Items, Lib, KbFile, D10),
    % declarations
    decl_diags(Items, Ds, DD),
    atype_diags(Items, Ds, ATs, DA),
    % facts
    include(fact_item, Items, Facts),
    build_env(Facts, Ds, Env),
    Ctx = fctx(KB, Ds, ATs, Env),
    findall(D, ( member(I, Facts), fact_diags(Ctx, I, D0), member(D, D0) ), DF),
    e5_diags(Facts, Ds, D5),
    e15_diags(Facts, D15),
    % rules in core, modules, rules.pl
    findall(D, ( member(I, Items), I = it(Src, _, _, _, _, _), Src \== kb,
                 rule_item_diags(Ds, I, D0), member(D, D0) ),
            DR),
    % E17
    findall(D, ( member(I, Items), e17_diags(I, D0), member(D, D0) ), D17),
    % E18
    e18_diags(Items, Ds, D18),
    % E11
    e11_diags(Items, Ds, D11, Eng),
    % warnings
    w_diags(KB, Items, Ds, Facts, DW),
    % ED12 (review of K-C/K-D, item 2): a discovery_end that no GO earned
    discovery_end_diags(KB, Items, KbFile, D12),
    % WM1 (kb-migrations c16, c17): retired predicates, their facts and their reach
    wm_diags(Items, Ds, DM),
    append([D1, D10, DD, DA, DF, D5, D15, DR, D17, D18, D11, DW, D12, DM], Diags0),
    % keep errors in a stable order; drop exact repeats
    list_to_set(Diags0, Diags),
    lint_issues(Eng, Ds, IssueLines, IssueErrors).


% discovery_end_diags(+KB, +Items, +KbFile, -Diags) (D41, review of K-C/K-D, item 2): lint error
% ED12 for a discovery_end(A) whose approval A is a human approval, but where, in the KB as it
% was just before A (the lines of kb.pl above A, with the library and rules.pl), the orbit was
% not open, gate(go) did not hold, or the artifacts did not vote go: what attest approval
% checks before it writes discovery_end (D30 H6). So a hand-written discovery_end on an approval
% that came with no GO is named. A limit: the KB before A is read with the files as they are now
% (a subject digest, a log), and a stale approval (H7) is not checked here.
discovery_end_diags(KB, Items, KbFile, Diags) :-
    kb_uses(KB, Uses), memberchk(discovery, Uses), !,
    kb_dir(KB, Dir),
    findall(I, ( member(I, Items), I = it(kb, _, _, _, _, _) ), KbItems),
    findall(I, ( member(I, Items), I = it(S, _, _, _, _, _), \+ memberchk(S, [kb, derived]) ), LibItems),
    findall(diag('ED12', KbFile, L, M),
            ( member(it(kb, _, L, T, _, _), KbItems), nonvar(T), T = discovery_end(A), atom(A),
              once(( member(it(kb, _, LA, TA, _, _), KbItems), nonvar(TA), TA = attest(A, approval, _, _, human, _) )),
              findall(P, ( member(P, KbItems), P = it(kb, _, LP, _, _, _), LP < LA ), Pre),
              \+ go_before(Dir, LibItems, Pre),
              fmt(M, "This discovery_end names approval ~w, but no GO came before that approval: in the KB before it, the discovery orbit was not open, or gate(go) or the artifacts' go did not hold. orbit-kb attest approval writes discovery_end only after a GO. Remove the line, or vote and approve again.", [A]) ),
            Diags).
discovery_end_diags(_, _, _, []).

go_before(Dir, LibItems, Pre) :-
    catch(( derived_items(Dir, Pre, Der),
            append([LibItems, Pre, Der], All),
            items_decls(All, Ds),
            build_engine(All, Ds, Eng),
            eng_true(Eng, discovery_open),
            eng_true(Eng, gate(go)),
            eng_true(Eng, artifact_vote(go)) ), _, fail).

e10_diags(Items, Lib, KbFile, Diags) :-
    findall(I, ( member(I, Items), item_src(I, kb) ), KbItems),
    (   KbItems = [First|_], First = it(_, _, _, T, _, _), nonvar(T), T = uses(_)
    ->  D0 = []
    ;   member(it(kb, F, L, T, _, _), KbItems), nonvar(T), T = uses(_)
    ->  D0 = [diag('E10', F, L, "uses/1 is not the first term of kb.pl. Move it to the top.")]
    ;   D0 = [diag('E10', KbFile, 1, "kb.pl has no uses/1. Add uses([]). or uses([build]). as the first line.")]
    ),
    findall(diag('E10', F, L, M),
            ( nth1(K, KbItems, it(_, F, L, T, _, _)), K > 1, nonvar(T), T = uses(_),
              KbItems = [it(_, _, _, T1, _, _)|_], nonvar(T1), T1 = uses(_),
              M = "kb.pl has more than one uses/1. Keep only the first." ),
            D1),
    findall(diag('E10', F, L, M),
            ( member(it(kb, F, L, T, _, _), KbItems), nonvar(T), T = uses(Ms),
              (   \+ ( is_list(Ms), maplist(atom, Ms) )
              ->  M = "uses/1 needs a list of module names, such as uses([build])."
              ;   lib_modules(Lib, Known),
                  member(Mo, Ms), \+ memberchk(Mo, Known),
                  atomic_list_concat(Known, ', ', KT),
                  fmt(M, "The module ~q does not exist. Known modules: ~w.", [Mo, KT])
              ) ),
            D2),
    append([D0, D1, D2], Diags).

item_src(it(S, _, _, _, _, _), S).
item_src(synerr(S, _, _, _), S).

decl_diags(Items, Ds, Diags) :-
    findall(FN, member(d(FN, _, fact, _, _, _, _, _, _), Ds), FN0), sort(FN0, FactNames),
    findall(D, ( member(it(_, F, L, T, _, _), Items), nonvar(T), T = decl(K, H, Doc, Tpl),
                 decl_item_diag(FactNames, F, L, K, H, Doc, Tpl, D) ),
            D1),
    findall((N/A)-(F:L), member(d(N, A, _, _, _, _, _, F, L), Ds), DK),
    findall(diag('E5', F2, L2, M),
            ( later_duplicate(DK, (N/A)-(F1:L1), F2:L2),
              show_loc(F1, L1, LT),
              fmt(M, "~q/~w is declared twice. The first declaration is at ~w. Remove one.", [N, A, LT]) ),
            D2),
    append(D1, D2, Diags).

% later_duplicate(+KeyLocs, -Key-Loc1, -Loc2): Loc2 comes after Loc1 in
% KeyLocs, and both have the same Key. The solutions come in the order
% of the nested loop over KeyLocs (first by Loc1, then by Loc2), but the
% work is near linear: keys are grouped once with a sort.
later_duplicate(KeyLocs, K-Loc1, Loc2) :-
    findall(K0-(I-Loc), nth1(I, KeyLocs, K0-Loc), KIL),
    keysort(KIL, Sorted),
    group_pairs_by_key(Sorted, Groups),
    findall(I1-I2-(K1-L1)-L2,
            ( member(K1-IL, Groups), IL = [_, _|_],
              append(_, [I1-L1|Rest], IL), member(I2-L2, Rest) ),
            Ps0),
    keysort(Ps0, Ps),
    member(_-_-(K-Loc1)-Loc2, Ps).

decl_item_diag(_, F, L, K, _, _, _, diag('E3', F, L, M)) :-
    \+ memberchk(K, [fact, rule]),
    term_text(K, KT),
    fmt(M, "The kind of a declaration must be fact or rule. It is ~w.", [KT]).
decl_item_diag(_, F, L, _, H, _, _, diag('E3', F, L, "The head of a declaration must be a name with types, without a minus sign.")) :-
    ( \+ callable(H) ; H = -(_) ).
decl_item_diag(FNs, F, L, _, H, _, _, diag('E3', F, L, M)) :-
    callable(H), H \= -(_),
    H =.. [N|Ts], length(Ts, A),
    member(T, Ts), type_errs(T, FNs, Es), member(E, Es),
    fmt(M, "Declaration of ~q/~w: ~w", [N, A, E]).
decl_item_diag(_, F, L, _, _, Doc, _, diag('E3', F, L, "The doc of a declaration must be text in single quotes.")) :-
    \+ atom(Doc).
decl_item_diag(_, F, L, _, H, _, Tpl, diag('E3', F, L, M)) :-
    (   \+ atom(Tpl)
    ->  M = "The template of a declaration must be text in single quotes, or ''."
    ;   callable(H), functor(H, _, A),
        template_errs(Tpl, A, Es), member(M, Es)
    ).

atype_diags(Items, Ds, ATs, Diags) :-
    findall(FN, member(d(FN, _, fact, _, _, _, _, _, _), Ds), FN0), sort(FN0, FactNames),
    findall(diag('E3', F, L, M),
            ( member(it(_, F, L, X, _, _), Items), nonvar(X), X = attest_type(T, S, W, Doc),
              (   \+ atom(T), M = "The name of an attestation type must be an atom."
              ;   shape_errs(S, FactNames, Es), member(E, Es),
                  fmt(M, "Attestation type ~q: ~w", [T, E])
              ;   \+ ( is_list(W), W \== [], forall(member(X1, W), memberchk(X1, [human, agent, script])) ),
                  fmt(M, "Attestation type ~q: the writers must be a list of human, agent, and script.", [T])
              ;   \+ atom(Doc),
                  fmt(M, "Attestation type ~q: the doc must be text in single quotes.", [T])
              ) ),
            D1),
    findall(T-(F:L), member(at(T, _, _, _, _, F, L), ATs), AK),
    findall(diag('E5', F2, L2, M),
            ( later_duplicate(AK, T-(F1:L1), F2:L2),
              show_loc(F1, L1, LT),
              fmt(M, "The attestation type ~q is declared twice. The first is at ~w. Remove one.", [T, LT]) ),
            D2),
    append(D1, D2, Diags).

e11_diags(Items, Ds, Diags, Eng) :-
    build_engine(Items, Ds, Eng),
    Eng = eng(_, LoadErrs),
    findall(diag('E11', F, L, M),
            ( member(le(F, L, Msg), LoadErrs),
              fmt(M, "The SWI engine cannot load this clause: ~w", [Msg]) ),
            Diags).

lint_issues(Eng, Ds, Lines, NErr) :-
    (   decl_of(Ds, lint_issue, 3, _)
    ->  swi_raw(Eng, lint_issue(C, I, M), [C, I, M], R),
        (   R = answers(L, _)
        ->  findall(S-IsE, ( member([C1, I1, M1], L),
                             plain_text(C1, CT), plain_text(I1, IT),
                             ( atom(M1) -> MT = M1 ; term_text(M1, MT) ),
                             fmt(S, "~w ~w: ~w", [CT, IT, MT]),
                             ( atom(C1), sub_atom(C1, 0, 1, _, 'E') -> IsE = 1 ; IsE = 0 ) ),
                    Ps),
            pairs_keys_values(Ps, Lines, Es),
            sum_list(Es, NErr)
        ;   R = error(Msg),
            fmt(S, "E11 lint_issue/3 failed in the SWI engine: ~w", [Msg]),
            Lines = [S], NErr = 1
        )
    ;   Lines = [], NErr = 0
    ).

w_diags(KB, Items, Ds, Facts, Diags) :-
    % W1
    findall(diag('W1', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = subject(Id, Path, D0), atom(Path),
              subject_abs(KB, Path, Abs),
              (   \+ exists_file(Abs)
              ->  fmt(M, "The file of subject ~q is missing: ~w. Restore it, or refresh with orbit-kb subject ~w PATH.", [Id, Abs, Id])
              ;   sha256_file(Abs, D1), D1 \== D0,
                  fmt(M, "The file of subject ~q changed since its digest was recorded. Refresh with orbit-kb subject ~w ~w.", [Id, Id, Path])
              ) ),
            W1),
    % D22: the first_use/3 facts of kb.pl
    findall(fu(N, A, By, Tm, F, L),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = first_use(PI, By, Tm),
              nonvar(PI), PI = N/A, atom(N), integer(A) ),
            FUs),
    % W2 (not for a declaration that a first use made: W7 lists it)
    findall(diag('W2', F, L, M),
            ( member(d(N, A, K, _, Doc, _, kb, F, L), Ds),
              \+ memberchk(fu(N, A, _, _, _, _), FUs),
              fmt(M, "Local declaration of ~q/~w (~w): ~w Review it.", [N, A, K, Doc]) ),
            W2a),
    findall(diag('W2', F, L, M),
            ( member(it(kb, F, L, X, _, _), Items), nonvar(X), X = attest_type(T, _, W, _),
              fmt(M, "Local attestation type ~q (writers ~w). Review it.", [T, W]) ),
            W2b),
    % W3. Two terms from different facts can be == only when they are
    % ground, so a set of the ground cited claims is enough.
    findall(C1-t, ( member(it(_, _, _, T2, _, _), Facts), nonvar(T2),
                    T2 = cites(C1, _), ground(C1) ), CP0),
    sort(CP0, CP),
    ord_list_to_assoc(CP, Cited),
    findall(diag('W3', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = claim(C, _, _),
              \+ ( ground(C), get_assoc(C, Cited, _) ),
              fmt(M, "Claim ~q has no cites. Add cites(~q, 'the request text it serves').", [C, C]) ),
            W3),
    % W4
    findall(PI, ( member(it(Src, _, _, T, _, _), Items), Src \== kb, nonvar(T),
                  \+ meta_term(T), T \= #(_),
                  clause_parts(T, _, B), body_goals(B, Gs), member(G, Gs),
                  nonvar(G), callable(G), functor(G, N, A), PI = N/A ),
            Read0),
    sort(Read0, Read),
    findall(diag('W4', F, L, M),
            ( member(d(N, A, fact, _, _, _, kb, F, L), Ds),
              \+ ord_memberchk(N/A, Read),
              fmt(M, "No rule reads the local fact ~q/~w. Add a rule in rules.pl that uses it, or remove it.", [N, A]) ),
            W4),
    % W5 (D15). A check of a superseded claim, while a current claim that
    % replaces it (directly or through a chain) has no check of its own.
    % Check ids are unique (E5) and facts are append-only, so the fix is a
    % new check of the current claim, not a move of the old check.
    supersede_edges(Facts, SEdges),
    supersede_closure(SEdges, SPairs),
    findall(O5, member(_-O5, SEdges), Olds0), sort(Olds0, Olds),
    findall(C5, ( member(it(_, _, _, T5, _, _), Facts), nonvar(T5),
                  T5 = check(_, C5), ground(C5) ), Checked0),
    sort(Checked0, Checked),
    findall(C6, ( member(it(_, _, _, T6, _, _), Facts), nonvar(T6),
                  T6 = claim(C6, _, _), atom(C6) ), Claims0),
    sort(Claims0, Claims),
    findall(diag('W5', F, L, M),
            ( member(it(_, F, L, T, _, _), Facts), nonvar(T), T = check(K, C),
              ground(C),
              member(New-C1, SPairs), C1 == C,
              ord_memberchk(New, Claims), \+ ord_memberchk(New, Olds),
              \+ ord_memberchk(New, Checked),
              fmt(M, "Check ~q tests claim ~q, but claim ~q replaces it, and ~q has no check. Add a new check of ~q with a new id: orbit-kb add \"check(NEW_ID, ~q)\" \"checks_that(NEW_ID, 'what it checks, in plain words')\". Then run it: orbit-kb run NEW_ID -- CMD.", [K, C, New, New, New, New]) ),
            W5),
    % W7 (D22): each predicate declared by its first use
    findall(diag('W7', F, L, M),
            ( member(fu(N, A, By, Tm, F, L), FUs),
              txt(By, ByT), txt(Tm, TmT),
              fmt(M, "~q/~w was declared by its first use, by ~w at ~w. Review the new predicate: is it needed, and is the name right? Its arguments have the type term.", [N, A, ByT, TmT]) ),
            W7),
    % E19 (D22): the typo guard. A first-use name at most 2 edits from
    % another declared name of the same arity.
    findall(diag('E19', F, L, M),
            ( member(fu(N, A, _, _, F, L), FUs),
              member(d(N2, A, _, _, _, _, _, _, _), Ds), N2 \== N, atom(N2),
              edit_distance_at_most(N, N2, 2, Dist),
              fmt(M, "~q/~w was declared by its first use, and its name is ~w edit(s) from the declared ~q/~w. It may be a typo. If it is: run orbit-kb withdraw ~q/~w (it removes the kind and its facts, with a record), and add the facts again as ~q/~w. If it is a new predicate: choose a name more than 2 edits away.", [N, A, Dist, N2, A, N, A, N2, A]) ),
            E19a),
    sort(E19a, E19b),
    e19_rule_diags(Ds, E19r),
    append(E19b, E19r, E19),
    % W8 (T27 c10): a request whose tracker item has a new text that no human accepted
    findall(diag('W8', '', 0, M),
            ( member(it(derived, _, _, T8, _, _), Items), nonvar(T8), T8 = request_stale(R8),
              fmt(M, "~w: the request text changed at its source (the latest request_pin has another digest). Read the item. If the new text is right, a human accepts it: orbit-kb pin-request --request-file F --accept --by human. It blocks done until then.", [R8]) ),
            W8),
    % W9 (T26): a fact kind of kb.pl with no description
    findall(diag('W9', F, L, M),
            ( member(d(N, A, fact, _, Doc, _, kb, F, L), Ds), no_description(Doc),
              fmt(M, "The kind ~q/~w has no description. Describe it in any later add of one of its facts: orbit-kb add 'FACT' --doc TEXT (a new kind: in its first add).", [N, A]) ),
            W9a),
    findall(diag('W9', F, L, M),
            ( member(d(N, A, rule, _, Doc, _, DS, F, L), Ds), ( DS == kb ; DS == rules ), no_description(Doc),
              fmt(M, "The rule ~q/~w has no description. Put a line %% doc: TEXT just above its first clause in rules.pl.", [N, A]) ),
            W9b),
    append(W9a, W9b, W9),
    append([W1, W2a, W2b, W3, W4, W5, W7, W8, W9, E19], Diags).

% no_description(+Doc) (T26): the doc of a kind says nothing. Before T26, a
% first use wrote the second text, which is no description either.
no_description('') :- !.
no_description('Declared by its first use. Review it (lint W7).').

% e19_rule_diags(+Decls, -Diags) (T26): the typo guard for rules.pl. A head
% that its first clause declared, at most 2 edits from a predicate that the
% core, a module, or kb.pl declares with the same arity, is E19. The old
% declare command made a misspelled head an E2; this keeps it an error.
e19_rule_diags(Ds, Diags) :-
    findall(diag('E19', F, L, M),
            ( member(d(N, A, rule, _, _, _, rules, F, L), Ds),
              member(d(N2, A, _, _, _, _, S2, _, _), Ds), S2 \== rules, N2 \== N, atom(N2),
              edit_distance_at_most(N, N2, 2, Dist),
              fmt(M, "The head ~q/~w of rules.pl is declared by its first clause, and its name is ~w edit(s) from the declared ~q/~w. It may be a typo. If it is: correct the name in rules.pl. If it is a new predicate: choose a name more than 2 edits away.", [N, A, Dist, N2, A]) ),
            Ds0),
    sort(Ds0, Diags).

% edit_distance_at_most(+A, +B, +Max, -D) (D22): the Levenshtein distance D
% of the names A and B (over their characters) is at most Max.
edit_distance_at_most(A, B, Max, D) :-
    atom_codes(A, As), atom_codes(B, Bs),
    length(As, LA), length(Bs, LB),
    abs(LA - LB) =< Max,
    levenshtein(As, Bs, D),
    D =< Max.

levenshtein(As, Bs, D) :-
    length(Bs, LB),
    numlist(0, LB, Row0),
    foldl(lev_step(Bs), As, Row0-0, Row-_),
    last(Row, D).

lev_step(Bs, A, Prev-I0, [I|Cur]-I) :-
    I is I0 + 1,
    Prev = [P0|Ps],
    lev_cells(Bs, A, P0, Ps, I, Cur).

lev_cells([], _, _, [], _, []).
lev_cells([B|Bs], A, Diag, [Up|Ups], Left, [C|Cs]) :-
    ( A == B -> Cost = 0 ; Cost = 1 ),
    C is min(min(Up + 1, Left + 1), Diag + Cost),
    lev_cells(Bs, A, Up, Ups, C, Cs).


% group_by_key_in_order(+Pairs, -Assoc): Key -> the values of Key, in
% the order of Pairs.
group_by_key_in_order(Pairs, Assoc) :-
    findall(K-(I-V), nth1(I, Pairs, K-V), KIV),
    keysort(KIV, Sorted),
    group_pairs_by_key(Sorted, Groups),
    findall(K-Vs, ( member(K-IVs, Groups), keysort(IVs, IVs1),
                    pairs_values(IVs1, Vs) ), KVs),
    list_to_assoc(KVs, Assoc).

% ---------------------------------------------------------------------
% show and report
% ---------------------------------------------------------------------

has_build(KB) :- kb_uses(KB, U), memberchk(build, U).
has_discovery(KB) :- kb_uses(KB, U), memberchk(discovery, U).

% vote_section(+Eng) (D14): the Vote: section of report. The agent's vote
% and the formal artifacts' vote are sealed until the human votes in the
% current round. A query can still read them: this is the honest path,
% not a lock.
vote_section(Eng) :-
    rhead('Vote'),
    ( eng_all(Eng, [Rq], request(Rq, _), [Rq1|_]) -> true ; Rq1 = 'REQUEST' ),
    eng_all(Eng, [R], vote_round(R), Rs),
    (   Rs == []
    ->  rsplit(vote, "No vote yet. The agent votes first, and seals the vote: orbit-kb attest vote ~w 'vote(1, CHOICE)'. CHOICE is go, no_go, or hold.", [Rq1])
    ;   Rs = [R1|_],
        eng_all(Eng, [H], human_vote(H), Hs),
        eng_all(Eng, [A], agent_vote(A), As),
        (   Hs == []
        ->  rsplit(vote, "Round ~w. The human has not voted. The other votes stay sealed until the human votes.", [R1]),
            (   As == []
            ->  rsplit(vote, "The agent has not voted. Vote first: orbit-kb attest vote ~w 'vote(~w, CHOICE)'.", [Rq1, R1])
            ;   rsplit(vote, "The agent voted. Its vote is sealed.", [])
            ),
            rsplit(vote, "Record the human vote: orbit-kb attest vote ~w 'vote(~w, CHOICE)' --by human.", [Rq1, R1])
        ;   atomic_list_concat(Hs, ', ', HT),
            ( As == [] -> AT = 'no vote' ; atomic_list_concat(As, ', ', AT) ),
            ( eng_all(Eng, [V], artifact_vote(V), [V1|_]) -> true ; V1 = 'no vote' ),
            rsplit(vote, "Round ~w. Human (0.49): ~w. Agent (0.24): ~w. Formal artifacts (0.24): ~w.", [R1, HT, AT, V1]),
            eng_all(Eng, [G], gate(G), Gs0), sort(Gs0, Gs), atomic_list_concat(Gs, ', ', GT),
            rsplit(vote, "Outcome: ~w.", [GT]),
            (   eng_true(Eng, gate_split)
            ->  rsplit(vote, "The vote is split. The outcome is hold, and another orbit follows. Record the disagreement as a divergence, with a note: orbit-kb attest divergence H 'hypothesis(H)'.", [])
            ;   true
            )
        )
    ),
    % D30 H5, H8: a vote that does not count, and why.
    eng_all(Eng, [VA, VW, VR, VC], ( attest(VA, vote, _, vote(VR, VC), VW, _), vote_void(VA) ), Voids),
    forall(member([VA, VW, VR, VC], Voids),
           rsplit(vote, "Vote ~w of the ~w (round ~w, ~w) does not count. It came after the discovery orbit closed, or before a return to discovery (back).", [VA, VW, VR, VC])),
    % D30 H4: after the human approves the ticket on a GO, the discovery orbit is closed.
    (   eng_all(Eng, [E], ( discovery_end(E), not(discovery_reopened(E)) ), [E1|_])
    ->  rsplit(vote, "The discovery orbit is closed: the human approved the ticket after a GO (~w). Readiness and the vote are not asked again until a return to discovery: orbit-kb attest back H 'back(TEXT)'.", [E1])
    ;   true
    ).

kb_engine(KB, Eng) :-
    kb_items(KB, Items),
    items_decls(Items, Ds),
    build_engine(Items, Ds, Eng).

eng_true(Eng, G) :- eng_all(Eng, [], G, L), L \== [].

say(Fmt, Args) :- format(Fmt, Args), nl.

txt(T, S) :- ( atom(T) -> S = T ; term_text(T, S) ).
plain_text(T, S) :- ( atomic(T) -> format(string(S), "~w", [T]) ; term_text(T, S) ).

cmd_show(KB, Args, Code) :-
    parse_opts(Args, [], [pin|PinArgs], _), !,
    (   PinArgs = [Id0] -> atom_string(Id, Id0) ; usage_error("show pin takes one pin id: orbit-kb show pin ID.", []) ),
    show_pin(KB, Id, Code).
cmd_show(KB, Args, Code) :-
    parse_opts(Args, [], Pos, _),
    (   Pos == [] -> What = all
    ;   Pos = [What], memberchk(What, [hypothesis, claims, questions, open, blocking, disclosures, extensions, kinds, all]) -> true
    ;   usage_error("show takes one of: hypothesis, claims, questions, open, blocking, disclosures, extensions, kinds, all, or pin ID.", [])
    ),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    (   What == kinds
    ->  % T40 c9: show kinds reads only the declarations, so it works while E19 or E2 fires
        % (it is how the clash is found); a syntax error (E1) still stops it.
        kinds_gate(KB), show_section(KB, none, kinds)
    ;   show_parts(KB, What)
    ),
    Code = 0.

show_parts(KB, What) :-
    answer_gate(KB),
    kb_engine(KB, Eng),
    (   What == all
    ->  forall(member(W, [hypothesis, claims, questions, open, disclosures, extensions]),
               ( show_section(KB, Eng, W), nl ))
    ;   show_section(KB, Eng, What)
    ).

% kinds_gate(+KB) (T40 c9): only a syntax error (E1) stops show kinds; it is exit 2 as in answer_gate.
kinds_gate(KB) :-
    kb_items(KB, Items),
    (   memberchk(synerr(_, _, _, _), Items) -> answer_gate(KB) ; true ).

% show pin ID (D27 c8): the pin, then the text that pin-item kept at pins/HEX.txt.
show_pin(KB, Id, Code) :-
    kb_items(KB, Items),
    (   kb_term(Items, pin(Id, Kind, Src, Digest, At)) -> true
    ;   usage_error("~w is not a pin of this KB.", [Id])
    ),
    say("Pin ~w: ~w ~w, digest ~w, changed at ~w", [Id, Kind, Src, Digest, At]),
    kb_dir(KB, Dir),
    (   Kind == file
    ->  say("No text is kept for pin ~w: a file pin keeps only its digest and its path (~w). The file is owned by its week.", [Id, Src]),
        Code = 1
    ;   pin_text_file(Dir, Digest, F), exists_file(F)
    ->  sha256_file(F, Now),
        (   Now == Digest
        ->  say("Text (~w):", [F]),
            read_file_to_string(F, Text, [encoding(utf8)]),
            format("~s", [Text]),
            ( sub_string(Text, _, 1, 0, "\n") -> true ; Text == "" -> true ; nl ),
            Code = 0
        ;   legacy_text_digest(F, Old), Old == Digest
        ->  % T40 c2: an unedited text of a pin taken before T38 (the digest of the text read as UTF-8)
            say("MISMATCH: the kept text ~w does not match the digest of pin ~w under the byte digest (its sha256 is ~w now), but it matches under the digest rule before T38 (the text read as UTF-8). The digest rule changed; the text is not edited. Re-pin it: orbit-kb pin-item NEW_ID ~q --text-file ~w --changed-at ~w, then point each concerns(X, ~w) at NEW_ID (orbit-kb help build, Byte digests).", [F, Id, Now, Src, F, At, Id]),
            Code = 1
        ;   have_crypto
        ->  % T34 c4: the kept text was edited after pin-item kept it.
            say("MISMATCH: the kept text ~w does not match the digest of pin ~w: its sha256 is ~w now. Someone edited it. Restore it from git, or pin the item again with orbit-kb pin-item.", [F, Id, Now]),
            Code = 1
        ;   % T40 c2: without library(crypto) the rule before T38 cannot be checked: name both causes.
            say("MISMATCH: the kept text ~w does not match the digest of pin ~w: its sha256 is ~w now. Someone edited it, or the pin was taken before T38 and the digest rule changed (without library(crypto), orbit-kb cannot tell which). Restore it from git, or pin the item again with orbit-kb pin-item (orbit-kb help build, Byte digests).", [F, Id, Now]),
            Code = 1
        )
    ;   say("No text is kept for pin ~w. Only orbit-kb pin-item keeps the text of a pin (pins/HEX.txt).", [Id]),
        Code = 1
    ).

% D31 B1: the hypothesis of the ticket and its premises, before the claims.
show_section(_, Eng, hypothesis) :-
    say("Hypothesis:", []),
    eng_all(Eng, [H, K, T], hypothesis(H, K, T), Hs),
    (   Hs == [] -> say("- None. Every ticket has one: add hypothesis(H, KIND, TEXT).", []) ; true ),
    forall(member([H, K, T], Hs),
           ( one_line(T, TT), say("- ~w (~w): ~w", [H, K, TT]),
             (   eng_all(Eng, [N], supersedes(N, H), Ns), Ns \== []
             ->  atomic_list_concat(Ns, ', ', NT), say("  State: superseded by ~w.", [NT])
             ;   say("  State: current.", [])
             ),
             premise_lines(Eng, H, PLs),
             forall(member(L, PLs), say("  ~w", [L])) )).
show_section(KB, Eng, claims) :-
    say("Claims:", []),
    eng_all(Eng, [C, L, T], claim(C, L, T), Cs),
    (   Cs == [] -> say("- None.", []) ; true ),
    % One query per relation, then lookups (see eng_set/4).
    eng_set(Eng, X1, current(X1), CurS),
    eng_groups(Eng, C2, N2, supersedes(N2, C2), SupBy),
    (   has_build(KB)
    ->  eng_set(Eng, X3, fulfilled(X3), FulS),
        eng_set(Eng, X4, under(X4), UndS),
        burn_sets(Eng, BSets)
    ;   true
    ),
    eng_groups(Eng, C5, X5, cites(C5, X5), CitesBy),
    eng_groups(Eng, C7, E7, example(C7, E7), ExBy),
    eng_groups(Eng, C6, K6, check(K6, C6), ChecksBy),
    check_sets(Eng, KSets),
    forall(member([C, L, T], Cs),
           ( txt(T, TT), say("- ~w (~w): ~w", [C, L, TT]),
             ( eng_member(Eng, CurS, C, current(C)) -> St0 = "current"
             ; eng_lookup(Eng, SupBy, C, N, supersedes(N, C), Ns), atomic_list_concat(Ns, ', ', NT),
               fmt(St0, "superseded by ~w", [NT]) ),
             (   has_build(KB)
             ->  ( eng_member(Eng, FulS, C, fulfilled(C)) -> St1 = ", fulfilled"
                 ; eng_member(Eng, UndS, C, under(C)) -> St1 = ", under"
                 ; eng_true(Eng, check_waived(C)) -> St1 = ", not fulfilled (a human waived a check of it)"
                 ; St1 = "" )
             ;   St1 = ""
             ),
             say("  State: ~w~w.", [St0, St1]),
             (   has_build(KB), burn_text(Eng, BSets, C, BT), BT \== ""
             ->  sub_string(BT, 1, _, 0, BT1), say("  ~w", [BT1])
             ;   true
             ),
             eng_lookup(Eng, ExBy, C, E, example(C, E), Es),
             forall(member(E, Es), ( txt(E, ET), say("  Example: ~w", [ET]) )),
             eng_lookup(Eng, CitesBy, C, X, cites(C, X), Xs),
             forall(member(X, Xs), ( txt(X, XT), say("  Cites: ~w", [XT]) )),
             eng_lookup(Eng, ChecksBy, C, K, check(K, C), Ks),
             (   Ks == [] -> say("  Checks: none.", [])
             ;   findall(S, ( member(K, Ks), check_state(Eng, KSets, K, KS), fmt(S, "~w (~w)", [K, KS]) ), Ss),
                 atomic_list_concat(Ss, ', ', SsT),
                 say("  Checks: ~w.", [SsT])
             ) )).
show_section(_, Eng, questions) :-
    say("Questions:", []),
    eng_all(Eng, [Q, C, T], question(Q, C, T), Qs),
    (   Qs == [] -> say("- None.", []) ; true ),
    eng_groups(Eng, Q1, A1, assumed(Q1, A1), AssBy),
    eng_groups(Eng, Q2, [B2, W2], answer(Q2, B2, W2), AnsBy),
    eng_set(Eng, Q3, to_ask(Q3), AskS),
    forall(member([Q, C, T], Qs),
           ( txt(T, TT),
             ( eng_true(Eng, hypothesis(C, _, _)) -> CK = hypothesis ; CK = claim ),
             say("- ~w (~w ~w): ~w", [Q, CK, C, TT]),
             eng_lookup(Eng, AssBy, Q, A, assumed(Q, A), As),
             forall(member(A, As), ( term_text(A, AT), say("  Default: ~w.", [AT]) )),
             eng_lookup2(Eng, AnsBy, Q, [B, W], answer(Q, B, W), Bs),
             forall(member([B, W], Bs), ( term_text(B, BT), say("  Answer by ~w: ~w.", [W, BT]) )),
             ( eng_member(Eng, AskS, Q, to_ask(Q)) -> say("  Ask it now.", []) ; true ),
             ( eng_true(Eng, question_waived(Q)) -> say("  A human waived it (see the waivers in orbit-kb report).", []) ; true ) )).
show_section(KB, Eng, open) :-
    say("Open:", []),
    eng_all(Eng, [Q], to_ask(Q), Qs),
    eng_all(Eng, [A], stale(A), As),
    eng_all(Eng, [C], contested(C), Cs),
    forall(member(Q, Qs), say("- to_ask ~w: ask question ~w now.", [Q, Q])),
    forall(member(A, As), say("- stale ~w: approval ~w names an old digest.", [A, A])),
    forall(member(C, Cs), say("- contested ~w: a divergence names claim ~w.", [C, C])),
    eng_all(Eng, [Y], supersede_cycle(Y), Ys),
    forall(member(Y, Ys),
           ( ( eng_true(Eng, claim(Y, _, _)) -> YK = claim ; YK = hypothesis ),
             say("- supersede_cycle ~w: ~w ~w replaces itself (lint E15).", [Y, YK, Y]) )),
    (   has_build(KB)
    ->  eng_all(Eng, [U], under(U), Us),
        eng_all(Eng, [O], over(O), Os),
        eng_all(Eng, [B], burn_open(B), Bs0),
        eng_all(Eng, [F], flare_open(F), Fs),
        forall(member(U, Us), say("- under ~w: claim ~w is current but not fulfilled.", [U, U])),
        forall(member(O, Os), say("- over ~w: change ~w serves no claim.", [O, O])),
        forall(member(B, Bs0), ( burn_need_words(Eng, B, BW), say("- burn_open ~w: claim ~w ~w.", [B, B, BW]) )),
        forall(member(F, Fs), say("- flare_open ~w: claim ~w needs a human to approve a demo.", [F, F])),
        append(Bs0, Fs, Bs),
        % D17: done needs a current claim.
        (   eng_true(Eng, any_current_claim) -> Ns = []
        ;   Ns = [no_claim], say("- no_claim: no claim is current. Add a claim. The work is not done without one.", [])
        )
    ;   Us = [], Os = [], Bs = [], Ns = []
    ),
    eng_all(Eng, [R], request_stale(R), Rs),
    forall(member(R, Rs), say("- request_stale ~w: the request text changed at its source. A human accepts it with orbit-kb pin-request --accept --by human.", [R])),
    kb_dir(KB, KDir), pending_open(KDir, Ps),
    forall(member(pending(PT, _, PFs), Ps),
           ( pending_questions(PFs, PQs),
             forall(member(Q-A, PQs), ( term_text(A, AT), say("- pending ~w: an answer to question ~w waits in answers.pending (queued ~w): ~w. The next write applies it.", [Q, Q, PT, AT]) )) )),
    % D32 O1, O2, O3: every other answer of blocking(X), what blocks readiness, and stale pins.
    open_more(KB, Eng, [to_ask, supersede_cycle, under, over, burn_open, flare_open, no_claim, request_stale], [], Bl, Rd, Sp),
    forall(member(X, Bl), ( blocking_line(KB, Eng, X, BS), say("~w", [BS]) )),
    forall(member(R, Rd), ( ready_line(Eng, R, RK, RS), say("- not_ready ~w: ~w", [RK, RS]) )),
    forall(member(P, Sp), ( stale_pin_text(Eng, P, PS), say("- stale_pin ~w: ~w", [P, PS]) )),
    (   Qs == [], As == [], Cs == [], Ys == [], Us == [], Os == [], Bs == [], Ns == [], Rs == [], Ps == [],
        Bl == [], Rd == [], Sp == []
    ->  say("- Nothing is open.", [])
    ;   true
    ).

% D22: each answer of blocking(X), with the text of its item.
show_section(KB, Eng, blocking) :-
    say("Blocking:", []),
    eng_all(Eng, [X], blocking(X), Xs),
    (   Xs == [] -> say("- Nothing blocks done.", [])
    ;   forall(member(X, Xs), ( blocking_line(KB, Eng, X, S), say("~w", [S]) ))
    ).
show_section(_, Eng, disclosures) :-
    say("Disclosures:", []),
    eng_all(Eng, [I, S, P, B, T], attest(I, disclosure, S, P, B, T), Ds),
    (   Ds == [] -> say("- None.", []) ; true ),
    forall(member([I, S, P, B, T], Ds),
           ( term_text(P, PT), say("- ~w: ~w, about ~w, by ~w at ~w.", [I, PT, S, B, T]) )).
% show kinds (T26): each fact kind and each rule head of the KB (the core,
% the modules in use, kb.pl, rules.pl) with its description. A rule head is
% marked (rule). One with no description says so.
show_section(KB, _, kinds) :-
    say("Kinds:", []),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    findall(S, ( member(d(N, A, K, _, Doc, _, _, _, _), Ds),
                 (   K == rule -> fmt(KT, "~q/~w (rule)", [N, A]) ; fmt(KT, "~q/~w", [N, A]) ),
                 (   no_description(Doc)
                 ->  fmt(S, "- ~w: (no description)", [KT])
                 ;   fmt(S, "- ~w: ~w", [KT, Doc])
                 ) ),
            Lines),
    (   Lines == [] -> say("- None.", []) ; forall(member(S, Lines), say("~w", [S])) ).
show_section(KB, _, extensions) :-
    say("Extensions:", []),
    kb_items(KB, Items),
    items_decls(Items, Ds),
    findall(S, ( member(d(N, A, K, _, Doc, _, kb, _, _), Ds),
                 fmt(S, "- Local ~w predicate ~q/~w: ~w", [K, N, A, Doc]) ), S1),
    findall(S, ( member(it(kb, _, _, X, _, _), Items), nonvar(X), X = attest_type(T, Sh, W, Doc),
                 term_text(Sh, ShT),
                 fmt(S, "- Local attestation type ~q, shape ~w, writers ~w: ~w", [T, ShT, W, Doc]) ), S2),
    findall(N/A-DSrc, ( member(it(rules, _, _, T, _, _), Items), nonvar(T),
                        item_head_pi(it(rules, _, _, T, _, _), N/A),
                        decl_of(Ds, N, A, d(_, _, _, _, _, _, DSrc, _, _)),
                        ( DSrc == core ; DSrc = module(_) ) ), X0),
    sort(X0, X1),
    findall(S, ( member(N/A-DSrc, X1), src_text(DSrc, ST),
                 fmt(S, "- rules.pl extends ~q/~w from ~w.", [N, A, ST]) ), S3),
    append([S1, S2, S3], All),
    (   All == [] -> say("- None.", []) ; forall(member(S, All), say("~w", [S])) ).

% open_more(+KB, +Eng, +Covered, +SkipReady, -Bl, -Rd, -Sp) (D32): what show open and report
% (Open) add to their own lines, so that "Nothing is open" never hides what blocks.
% Bl: each answer of blocking(X) whose kind is not in Covered (the kinds that the command
% prints itself). Rd: each answer of ready_blocker(X) when the KB uses discovery, the
% discovery orbit is open, and discovery_ready fails; to_ask(Q) is left out (blocking names
% it), and so are the kinds in SkipReady. Sp: each stale_pin_open(P) of a KB that uses project.
open_more(KB, Eng, Covered, SkipReady, Bl, Rd, Sp) :-
    eng_all(Eng, [X], blocking(X), Xs0),
    exclude(open_kind_in(Covered), Xs0, Bl),
    (   has_discovery(KB), eng_true(Eng, discovery_open), \+ eng_true(Eng, discovery_ready)
    ->  eng_all(Eng, [R], ready_blocker(R), Rs0),
        (   Rs0 == []
        ->  Rd = [unknown]     % cannot happen (D32 O2: ready in an open orbit is "no blocker")
        ;   exclude(open_kind_in([to_ask|SkipReady]), Rs0, Rd)
        )
    ;   Rd = []
    ),
    (   kb_uses(KB, Us), memberchk(project, Us)
    ->  eng_all(Eng, [P], stale_pin_open(P), Sp)
    ;   Sp = []
    ).

open_kind_in(Kinds, X) :- functor(X, N, _), memberchk(N, Kinds).

% ready_line(+Eng, +Blocker, -KindId, -Sentence) (D32 O2): the kind and id of a ready_blocker
% answer, and one sentence that says what blocks discovery_ready.
ready_line(_, unknown, "unknown", "discovery_ready fails, and no ready_blocker answers. Run orbit-kb whynot 'discovery_ready'.") :- !.
ready_line(Eng, X, KI, S) :-
    functor(X, N, A),
    (   A =:= 1 -> arg(1, X, Id), fmt(KI, "~w ~w", [N, Id]) ; Id = '', fmt(KI, "~w", [N]) ),
    ready_sentence(Eng, N, Id, S).

ready_sentence(_, no_hypothesis, _, "no current hypothesis. Add hypothesis(H, KIND, TEXT).") :- !.
ready_sentence(_, no_system_result, _, "no evidence from the current system yet: a reproduction on system evidence, or a run of a check tagged discovery_evidence(K, system).") :- !.
ready_sentence(_, no_outcome, _, "no claim is current, and no current hypothesis did not reproduce.") :- !.
ready_sentence(_, untouched, H, S) :- !, fmt(S, "hypothesis ~w has no result from the current system (lint WD7). Reproduce it, or ask the human if it is a separate ticket.", [H]).
ready_sentence(Eng, no_falsifier, C, S) :- !, item_text(Eng, C, T), fmt(S, "claim ~w has no falsifier: no check, and no trusted model that decided it: ~w", [C, T]).
ready_sentence(Eng, no_example, C, S) :- !, item_text(Eng, C, T), fmt(S, "claim ~w has no example (lint WD10): ~w", [C, T]).
ready_sentence(Eng, preserve_failing, K, S) :- !, item_text(Eng, K, T), fmt(S, "check ~w of a preserve claim fails now, so what must stay true is false now: ~w", [K, T]).
ready_sentence(_, question_waits, Q, S) :- !, fmt(S, "question ~w waits for the human's answer.", [Q]).
ready_sentence(_, unasked_finding, F, S) :- !, fmt(S, "finding ~w needs a question for the human (lint WD1).", [F]).
ready_sentence(Eng, refuted, C, S) :- !, item_text(Eng, C, T), fmt(S, "claim ~w is refuted. Record the counterexample as an example, and ask the human: ~w", [C, T]).
ready_sentence(_, weak_rule, R, S) :- !, fmt(S, "rule ~w of a model survived its mutation check, with no reason (lint WD3).", [R]).
ready_sentence(_, model_diverges, M, S) :- !, fmt(S, "model ~w disagrees with the current system (lint ED3).", [M]).
ready_sentence(_, model_vacuous, A, S) :- !, fmt(S, "attestation ~w shows that its claim can never apply (lint ED4).", [A]).
ready_sentence(_, model_unfiled_break, C, S) :- !, fmt(S, "a model breaks claim ~w, and no disproof is filed (lint ED5).", [C]).
ready_sentence(_, model_solvers_disagree, M, S) :- !, fmt(S, "two solver results for one check of model ~w disagree (lint ED6).", [M]).
ready_sentence(_, unratified, C, S) :- !, fmt(S, "claim ~w replaces a disputed claim, and no human answered a question about either (lint ED7).", [C]).
ready_sentence(_, to_ask, Q, S) :- !, fmt(S, "question ~w must be asked now.", [Q]).
ready_sentence(_, N, Id, S) :- fmt(S, "~w ~w blocks discovery_ready.", [N, Id]).

% stale_pin_text(+Eng, +P, -S) (D32 O3): what a stale pin that the KB still rests on is.
stale_pin_text(Eng, P, S) :-
    (   eng_all(Eng, [K, Src], pin(P, K, Src, _, _), [[K1, Src1]|_]) -> true ; K1 = '?', Src1 = '?' ),
    eng_all(Eng, [D], ( concerns(D, P), current_fact(D) ), Ds0), sort(Ds0, Ds),
    (   Ds == []
    ->  fmt(S, "the ~w pin of ~w is stale (lint WP8): it changed after the pin, and the KB rests on it. Read it, then pin it again.", [K1, Src1])
    ;   atomic_list_concat(Ds, ', ', DT),
        fmt(S, "the ~w pin of ~w is stale (lint WP8), and ~w rests on it: it changed after the pin. Read it; if ~w still holds, pin it again and move the concerns facts to the new pin.", [K1, Src1, DT, DT])
    ).
% blocking_line(+KB, +Eng, +Item, -Line) (D22): one line of show blocking.
blocking_line(_, Eng, to_ask(Q), S) :- !,
    item_text(Eng, Q, T), fmt(S, "- to_ask ~w: ask question ~w now: ~w", [Q, Q, T]).
blocking_line(_, Eng, supersede_cycle(C), S) :- !,
    item_text(Eng, C, T), fmt(S, "- supersede_cycle ~w: ~w replaces itself (lint E15): ~w", [C, C, T]).
blocking_line(KB, Eng, past_due(X), S) :- !,
    ( eng_all(Eng, [D], due(X, D), [D1|_]) -> txt(D1, DT) ; DT = '?' ),
    item_text(Eng, X, T0), opt_change_text(KB, Eng, X, T0, T),
    fmt(S, "- past_due ~w: ~w was due at ~w, and it is still open: ~w", [X, X, DT, T]).
blocking_line(_, Eng, under(C), S) :- !,
    item_text(Eng, C, T),
    (   eng_true(Eng, ac(C))   % D29: an unmet acceptance criterion is named as such
    ->  fmt(S, "- under ~w: acceptance criterion ~w is not met (claim ~w is current but not fulfilled): ~w", [C, C, C, T])
    ;   fmt(S, "- under ~w: claim ~w is current but not fulfilled: ~w", [C, C, T])
    ).
blocking_line(KB, Eng, over(X), S) :- !,
    opt_change_text(KB, Eng, X, '', T), fmt(S, "- over ~w: change ~w serves no claim: ~w", [X, X, T]).
blocking_line(_, Eng, burn_open(C), S) :- !,
    item_text(Eng, C, T), burn_need_words(Eng, C, W), fmt(S, "- burn_open ~w: claim ~w ~w: ~w", [C, C, W, T]).
blocking_line(_, Eng, flare_open(C), S) :- !,
    item_text(Eng, C, T), fmt(S, "- flare_open ~w: claim ~w needs a human to approve a demo: ~w", [C, C, T]).
blocking_line(_, _, no_claim, "- no_claim: no claim is current. Add a claim. The work is not done without one.") :- !.
blocking_line(_, Eng, check_failing(K), S) :- !,
    item_text(Eng, K, T), fmt(S, "- check_failing ~w: check ~w did not pass its last run: ~w", [K, K, T]).
blocking_line(_, Eng, check_unrun(K), S) :- !,
    item_text(Eng, K, T), fmt(S, "- check_unrun ~w: check ~w never ran: ~w", [K, K, T]).
blocking_line(_, Eng, waiver_lapsed(W), S) :- !,
    (   eng_all(Eng, [X, D, R], attest(W, waiver, _, waive(X, D, R), _, _), [[X1, D1, R1]|_])
    ->  txt(X1, XT), txt(D1, DT), txt(R1, RT),
        fmt(S, "- waiver_lapsed ~w: waiver ~w of ~w was due at ~w, and ~w still blocks: ~w", [W, W, XT, DT, XT, RT])
    ;   fmt(S, "- waiver_lapsed ~w: waiver ~w is past its due time.", [W, W])
    ).
blocking_line(_, Eng, request_stale(R), S) :- !,
    eng_all(Eng, [Ref], request_pin(R, Ref, _, _), Refs), ( last(Refs, Ref1) -> true ; Ref1 = '?' ),
    fmt(S, "- request_stale ~w: the request text of ~w changed since the KB pinned it. Read the item; a human accepts the new text with orbit-kb pin-request --request-file F --accept --by human.", [R, Ref1]).
blocking_line(_, Eng, project_contradiction(X), S) :- !,
    eng_all(Eng, [Y], project_contradiction(X, Y), Ys0), sort(Ys0, Ys),
    atomic_list_concat(Ys, ', ', YT),
    fmt(S, "- project_contradiction ~w: a claim pins ~w of the project KB, and ~w cannot hold together with ~w there (excludes). Ask a human to supersede one side in the project KB, or change the claim.", [X, X, X, YT]).
blocking_line(_, _, project_kb_unclean, "- project_kb_unclean: the project KB does not load clean, so a conflict could hide in it. Run orbit-kb lint on the project KB and fix the errors.") :- !.
blocking_line(_, _, X, S) :-
    term_text(X, XT), fmt(S, "- ~w", [XT]).

% ---------------------------------------------------------------------
% draft (D25): Markdown for a human to paste. Nothing is sent anywhere.
% ---------------------------------------------------------------------
% draft blocking: the stamp of kb.pl and each blocking item (as show blocking).
% It writes nothing and takes no lock.

cmd_draft(KB, Args, Code) :-
    parse_opts(Args, ['--hub'-value, '--session'-value], Pos, Opts),
    cmd_draft_(KB, Pos, Code),
    ( Code == 0, Pos \== [questions] -> auto_record_drops(KB, Opts) ; true ).   % T45 c1

cmd_draft_(KB, Pos, Code) :-
    (   Pos == [blocking] -> true
    ;   Pos == [outbound] -> true
    ;   Pos == [questions] -> true
    ;   Pos == [attach] -> true
    ;   usage_error("draft takes one subject and nothing else: draft blocking, draft attach, draft outbound, or draft questions.", [])
    ),
    (   Pos == [questions]
    ->  draft_questions(KB), Code = 0
    ;   Pos == [attach]
    ->  % T22 c6 (u93): the file to attach to the tracker item and the line to paste. Nothing is copied or posted.
        kb_dir(KB, Dir),
        directory_file_path(Dir, 'kb.pl', KbFile),
        absolute_file_name(KbFile, Abs),
        sha256_file(KbFile, Digest),
        say("## Attach the spec KB to the tracker item", []), nl,
        say("- File: ~w", [Abs]),
        say("- Stamp: spec-kb@~w", [Digest]),
        say("- Paste: Spec KB attached (kb.pl), stamp spec-kb@~w", [Digest]),
        say("- A human attaches the file to the tracker item and pastes the line. orbit-kb posts nothing.", []),
        Code = 0
    ;   Pos == [blocking]
    ->  kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
        answer_gate(KB),
        kb_engine(KB, Eng),
        directory_file_path(Dir, 'kb.pl', KbFile),
        sha256_file(KbFile, Digest),
        say("## Blocking items", []), nl,
        say("Stamp: spec-kb@~w", [Digest]), nl,
        eng_all(Eng, [X], blocking(X), Xs),
        (   Xs == [] -> say("- Nothing blocks done.", [])
        ;   forall(member(X, Xs), ( blocking_line(KB, Eng, X, S), md_say("", S, "") ))
        ),
        Code = 0
    ;   kb_uses(KB, Us), memberchk(project, Us)
    ->  kb_engine(KB, Eng),
        say("## Outbound drafts", []), nl,
        eng_all(Eng, [D, P, T, S], draft(D, P, T, S), Ds0),
        findall(r(D, P, T, S), ( member([D, P, T, S], Ds0),
                                 \+ eng_true(Eng, pushed(D, _)),
                                 eng_true(Eng, outbound(D)) ), Rows),
        (   Rows == [] -> say("- Nothing to push.", [])
        ;   forall(member(Row, Rows), outbound_section(Eng, Row))
        ),
        (   Ds0 == []
        ->  say("- This KB has no draft facts. draft outbound reads only this KB. For the drafts of the project KB, run: orbit-kb --dir PROJECT draft outbound", [])
        ;   true
        ),
        Code = 0
    ;   usage_error("draft outbound needs a KB that uses the project module (D23).", [])
    ).

% Free text is pasted into a tracker that renders Markdown and HTML (D25 T7).
% md_escape/2: & < > become entities; ` | [ ] \ get a backslash. The text has no line break.
% md_say(+Prefix, +Text, +Suffix): the first line of Text stays on the bullet (Prefix, escaped
% line, Suffix); each further line goes under it with the prefix "  > ".
md_break(C) :- memberchk(C, [0'\n, 0'\r, 0'\v, 0'\f, 0x85, 0x2028, 0x2029]).
md_lines(Text, Lines) :-
    plain_text(Text, S), string_codes(S, Cs),
    md_split(Cs, Lines).
md_split(Cs, [L|Ls]) :-
    (   append(Pre, [B|Post], Cs), md_break(B)
    ->  ( B == 0'\r, Post = [0'\n|Post1] -> true ; Post1 = Post ),
        !, string_codes(L, Pre), md_split(Post1, Ls)
    ;   string_codes(L, Cs), Ls = []
    ).
md_escape(In, Out) :-
    plain_text(In, S), string_codes(S, Cs),
    foldl([C, A0, A]>>( md_esc_code(C, Es), append(A0, Es, A) ), Cs, [], Os),
    string_codes(Out, Os).
md_esc_code(0'&, Cs) :- !, string_codes("&amp;", Cs).
md_esc_code(0'<, Cs) :- !, string_codes("&lt;", Cs).
md_esc_code(0'>, Cs) :- !, string_codes("&gt;", Cs).
md_esc_code(C, [0'\\, C]) :- memberchk(C, [0'`, 0'|, 0'[, 0'], 0'\\]), !.
md_esc_code(C, [C]).
md_inline(In, Out) :-
    md_lines(In, Ls), atomic_list_concat(Ls, ' ', J), md_escape(J, Out).
md_say(Prefix, Text, Suffix) :-
    md_lines(Text, [L1|Rest]),
    md_escape(L1, E1),
    say("~w~w~w", [Prefix, E1, Suffix]),
    forall(member(L, Rest), ( md_escape(L, E), say("  > ~w", [E]) )).

outbound_section(Eng, r(D, P, T, S)) :-
    md_inline(D, Dm), say("### ~w", [Dm]), nl,
    (   eng_all(Eng, [Src, C], pin(P, _, Src, _, C), [[Src1, C1]|_]) -> true ; Src1 = '?', C1 = '?' ),
    md_inline(P, Pm), say("- Pin: ~w", [Pm]),
    md_say("- Source: ", Src1, ""),
    md_inline(C1, C1m), say("- ChangedAt: ~w", [C1m]),
    md_inline(S, Sm), say("- Staged: ~w", [Sm]),
    % T43 c3: both sides changed after the pin, and the draft is listed, so it won (by date or by a
    % human): the time of the tracker change shows what it replaces.
    (   eng_all(Eng, [C2], both_changed(D, C2), [C2a|_])
    ->  md_inline(C2a, C2m), say("- Tracker changed: ~w", [C2m])
    ;   true
    ),
    say("- Status: ready", []),
    md_say("- Draft: ", T, ""), nl.

% pin-item ID SOURCE --text-file F --changed-at T [--kind tracker|file] (D25 T4):
% records pin(ID, Kind, SOURCE, sha256:HEX, T). The CLI computes the digest of F.
% ---------------------------------------------------------------------
% The pinned request (T27 c10)
% ---------------------------------------------------------------------
% request_text(+File, -Text): the request text of a tracker item. A JSON object gives its
% title, its description (body or description) and its acceptance criteria, and nothing else:
% no state, column, label, or time, so a column move does not change the text. Any other
% file gives its whole text (without one final newline).
request_text(File, Text) :-
    read_file_to_string(File, S0, [encoding(utf8)]),
    use_module(library(http/json)),
    (   catch(atom_json_dict(S0, J0, [value_string_as(string)]), _, fail)
    ->  req_unwrap(J0, J, Why)
    ;   J = none, Why = none
    ),
    (   is_dict(J),
        req_title(J, Title)
    ->  ( req_field(J, [[body], [description], [fields, 'System.Description'], [fields, description], [description_html]], B) -> Bs = [B] ; Bs = [] ),
        (   req_field(J, [[acceptance_criteria], [acceptanceCriteria], [acceptance],
                          [fields, 'Microsoft.VSTS.Common.AcceptanceCriteria']], AC)
        ->  string_concat("Acceptance criteria:\n", AC, ACT), ACs = [ACT] ; ACs = [] ),
        append([[Title], Bs, ACs], Parts),
        atomic_list_concat(Parts, '\n\n', Text)
    ;   ( Why \== none -> req_raw_warning(File, Why) ; true ),
        ( sub_string(S0, B0, 1, 0, "\n") -> sub_string(S0, 0, B0, _, S1) ; S1 = S0 ),
        atom_string(Text, S1)
    ).

% req_unwrap(+Json, -Item, -Why) (T38 c11): a list wrapper {count, value:[Item]} (ADO REST) with one
% item gives the item. Why says why JSON may be read raw: a wrapper with N items, or JSON that is
% no object; else none (the title decides). T40 c4: only a top level with no title of its own is a
% wrapper; a titled top level is the item, whatever its value field holds.
req_unwrap(J0, J, Why) :-
    (   is_dict(J0), get_dict(value, J0, L), is_list(L), \+ req_title(J0, _)
    ->  (   L = [J1], is_dict(J1) -> J = J1, Why = no_title
        ;   length(L, N), J = J0, Why = wrapper(N)
        )
    ;   is_dict(J0) -> J = J0, Why = no_title
    ;   J = none, Why = not_object
    ).

% req_title(+Dict, -Title): the title of a tracker item (title, fields.System.Title, fields.summary, name).
req_title(J, Title) :-
    req_field(J, [[title], [fields, 'System.Title'], [fields, summary], [name]], Title).

req_raw_warning(File, Why) :-
    (   Why = wrapper(N) -> format(string(R), "it is a list wrapper {count, value} with ~w items, not one", [N])
    ;   Why == not_object -> R = "it is JSON, but not an object"
    ;   R = "no title was found (title, fields.System.Title, fields.summary, or name)"
    ),
    format(user_error, "Warning: the request text of ~w is its raw text: ~w. A change of any field (a state or a column) then changes the request. Give the JSON of one item.~n", [File, R]).

% req_field(+Dict, +Paths, -String) (T37 c3): the first path (a list of keys, nested) that holds a
% non-empty string. Paths cover the trackers in use: a plain item (title, body), ADO
% (fields.System.Title, System.Description, Microsoft.VSTS.Common.AcceptanceCriteria), Jira
% (fields.summary, fields.description), Plane (name, description_html). Nothing else is read:
% a State or BoardColumn move changes no text.
req_field(J, Paths, V) :-
    member(Path, Paths),
    req_path(J, Path, V1), req_value_text(V1, V0), string(V0), V0 \== "",
    !, V = V0.

% req_value_text(+Value, -String) (T38 c11): a string is itself; an Atlassian Document Format doc
% (Jira Cloud REST v3: {type: doc, content: [...]}) is its text, one line per block.
req_value_text(V, V) :- string(V), !.
req_value_text(D, S) :- is_dict(D), get_dict(type, D, "doc"), !, adf_text(D, S0), split_string(S0, "", "\n ", [S]).

adf_text(N, S) :-
    (   is_dict(N), get_dict(type, N, "text"), get_dict(text, N, T), string(T) -> S = T
    ;   is_dict(N), get_dict(type, N, "hardBreak") -> S = "\n"
    ;   is_dict(N), get_dict(attrs, N, A), is_dict(A), get_dict(text, A, T), string(T) -> S = T
    ;   is_dict(N), get_dict(content, N, Ks), is_list(Ks)
    ->  maplist(adf_text, Ks, Ss),
        (   forall(member(K, Ks), adf_inline(K)) -> atomic_list_concat(Ss, '', A0)
        ;   atomic_list_concat(Ss, '\n', A0)
        ),
        atom_string(A0, S)
    ;   S = ""
    ).

adf_inline(K) :- is_dict(K), get_dict(type, K, T), memberchk(T, ["text", "hardBreak", "mention", "emoji", "inlineCard", "date", "status"]).


req_path(V, [], V).
req_path(D, [K|Ks], V) :- is_dict(D), get_dict(K, D, V1), req_path(V1, Ks, V).

cmd_pin_request(KB, Args, Code) :-
    parse_opts(Args, ['--request-file'-value, '--accept'-flag, '--by'-value], Pos, Opts),
    (   Pos == [] -> true ; usage_error("pin-request takes options only: pin-request --request-file F [--accept --by human].", []) ),
    (   memberchk('--request-file'-F, Opts) -> true
    ;   usage_error("pin-request needs --request-file F: the text of the tracker item as you read it now.", [])
    ),
    opt(Opts, '--accept', false, Accept), opt(Opts, '--by', agent, By),
    (   Accept == true, By \== human
    ->  usage_error("--accept records that a human accepted the new request text: add --by human. Only a human accepts it.", [])
    ;   true
    ),
    (   exists_file(F) -> true ; die(2, ["The request file " + F + " does not exist."] >> fix_lines) ),
    kb_items(KB, Items),
    (   findall(R-Ref-D, ( member(it(kb, _, _, T, _, _), Items), nonvar(T), T = request_pin(R, Ref, D, _) ), Pins),
        last(Pins, R-Ref-LastD)
    ->  true
    ;   die(1, ["The request has no pin: the KB owns its request (init without --source). Nothing was written.",
                "Fix: nothing to do. To pin a request, start the KB with orbit-kb init DIR --request-file F --source REF."] >> fix_lines)
    ),
    request_text(F, Text), sha256_text(Text, D), utc_now(Now),
    (   D == LastD -> L1 = [] ; clause_line(request_pin(R, Ref, D, Now), [], P1), L1 = [P1] ),
    (   Accept == true
    ->  (   member(it(kb, _, _, T2, _, _), Items), nonvar(T2), T2 = request(R, OldText), atomic(OldText), sha256_text(OldText, D)
        ->  L2 = []
        ;   member(it(kb, _, _, T3, _, _), Items), nonvar(T3), T3 = request_accepted(R, D, _)
        ->  L2 = []
        ;   clause_line(request_accepted(R, D, Text), [], P2), L2 = [P2]
        )
    ;   L2 = []
    ),
    append(L1, L2, Lines),
    (   Lines == []
    ->  format("The request text of ~w is unchanged (~w). Nothing was written.~n", [Ref, D])
    ;   kb_file(KB, KbFile), append_lines(KbFile, Lines),
        forall(member(L, Lines), format("~w~n", [L])),
        (   L1 \== [], L2 == []
        ->  format(user_error, "The request text changed at ~w. The request is stale (lint W8) until a human accepts the new text: orbit-kb pin-request --request-file F --accept --by human.~n", [Ref])
        ;   true
        )
    ),
    Code = 0.

cmd_pin_item(KB, Args, Code) :-
    parse_opts(Args, ['--text-file'-value, '--changed-at'-value, '--kind'-value, '--hub'-value, '--session'-value], Pos, Opts),
    (   Pos = [Id, Src] -> true
    ;   usage_error("pin-item takes an id and a source: orbit-kb pin-item ID SOURCE --text-file F --changed-at T.", [])
    ),
    (   kb_uses(KB, Us), memberchk(project, Us) -> true
    ;   usage_error("pin-item needs a KB that uses the project module.", [])
    ),
    (   memberchk('--changed-at'-At, Opts) -> true ; usage_error("pin-item needs --changed-at T.", []) ),
    opt(Opts, '--kind', tracker, Kind),
    (   memberchk(Kind, [tracker, file]) -> true ; usage_error("--kind takes tracker or file. It is ~w.", [Kind]) ),
    (   Kind == file
    ->  pin_file_path(KB, Src, Opts, File)       % T38 c9: the digest is of the pinned file
    ;   memberchk('--text-file'-File, Opts) -> true
    ;   usage_error("pin-item needs --text-file F.", [])
    ),
    (   atom_string(At, AtS),
        re_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"/'', AtS) -> true
    ;   usage_error("--changed-at takes a UTC time such as 2026-10-01T09:00:00Z. It is ~w.", [At])
    ),
    (   exists_file(File) -> true ; usage_error("The text file ~w does not exist.", [File]) ),
    sha256_file(File, Digest),
    format(atom(Fact), "pin(~q, ~q, ~q, ~q, ~q)", [Id, Kind, Src, Digest, At]),
    cmd_add(KB, [Fact], Code),
    % T34 c4 (u114): a file pin keeps only its digest and its path, never a copy.
    (   Code == 0, Kind == tracker -> kb_dir(KB, Dir), keep_pin_text(Dir, Digest, File) ; true ),
    ( Code == 0 -> auto_record_drops(KB, Opts) ; true ).   % T45 c1

% pin_file_path(+KB, +Src, +Opts, -File) (T38 c9): the pinned file of a file pin: the file of
% subject Src when Src is a subject of the KB, else the path Src. A --text-file must name the
% same file; else exit 2 and nothing is written.
pin_file_path(KB, Src, Opts, File) :-
    kb_items(KB, Items),
    (   kb_term(Items, subject(S, P, _)), S == Src, atom(P) -> subject_abs(KB, P, File0)
    ;   File0 = Src
    ),
    (   exists_file(File0) -> File = File0
    ;   usage_error("The pinned file ~w does not exist. SOURCE of a file pin is a path or a subject id.", [File0])
    ),
    (   memberchk('--text-file'-TF, Opts)
    ->  (   exists_file(TF), same_file(TF, File) -> true
        ;   usage_error("--text-file ~w is not the pinned file ~w. A file pin digests the pinned file: leave out --text-file, or name the same file.", [TF, File])
        )
    ;   true
    ).

% keep_pin_text(+Dir, +Digest, +File) (D27 c8): the pinned text is kept as
% pins/HEX.txt in the project KB, HEX of the digest sha256:HEX. Content-addressed:
% the same text is kept once. Written only after the pin is recorded.
keep_pin_text(Dir, Digest, File) :-
    pin_text_file(Dir, Digest, Target),
    (   exists_file(Target) -> true
    ;   directory_file_path(Dir, pins, PD), make_directory_path(PD),
        current_prolog_flag(pid, Pid), format(atom(Tmp), "~w.tmp-~w", [Target, Pid]),
        copy_file(File, Tmp), rename_file(Tmp, Target)
    ).

pin_text_file(Dir, Digest, Target) :-
    atom(Digest), atom_concat('sha256:', Hex, Digest),
    format(atom(Rel), "pins/~w.txt", [Hex]),
    directory_file_path(Dir, Rel, Target).

% ---------------------------------------------------------------------
% project impact X, project archive --superseded-before DATE (D27)
% ---------------------------------------------------------------------

project_item_kind(Items, X, K) :-
    member(K, [decision, definition, rule]), G =.. [K, X, _], kb_term(Items, G), !.

cmd_project(DirOpt, [impact|Args], Code) :- !,
    parse_opts(Args, ['--root'-value], Pos, Opts),
    (   Pos = [X0] -> atom_string(X, X0) ; usage_error("project impact takes one id: orbit-kb project impact X.", []) ),
    resolve_kb(DirOpt, Dir), lib_dir(Lib), load_kb(Dir, Lib, KB),
    project_kb_check(KB),
    kb_items(KB, Items),
    (   project_item_kind(Items, X, Kind) -> true
    ;   usage_error("~w is not a decision, a definition or a rule of this project KB.", [X])
    ),
    ( memberchk('--root'-R, Opts) -> RootOpt = some(R) ; RootOpt = none ),
    spec_pins_of(Dir, RootOpt, Ts),
    kb_engine(KB, Eng),
    eng_all(Eng, [Z], rests_on(Z, X), Zs),
    findall(L, ( member(t(S, C, Y), Ts),
                 (   Y == X -> fmt(L, "- ~w: claim ~w pins ~w", [S, C, X])
                 ;   memberchk(Y, Zs) -> fmt(L, "- ~w: claim ~w pins ~w, which rests on ~w", [S, C, Y, X])
                 ) ),
            Ls),
    (   Ls == []
    ->  say("No spec KB pins ~w ~w or a fact that rests on it.", [Kind, X])
    ;   say("Spec KBs that a change of ~w ~w touches:", [Kind, X]),
        forall(member(L, Ls), say("~w", [L]))
    ),
    Code = 0.
cmd_project(DirOpt, [archive|Args0], Code) :- !,
    resolve_kb(DirOpt, Dir),
    writer_gate(Dir, Args0, Args),
    apply_pending(Dir),                          % T27 c4: a write applies the waiting answers first
    parse_opts(Args, ['--superseded-before'-value, '--root'-value], Pos, Opts),
    (   Pos == [] -> true ; usage_error("project archive takes no positional argument.", []) ),
    (   memberchk('--superseded-before'-D0, Opts) -> true
    ;   usage_error("project archive needs --superseded-before DATE (such as 2026-10-01 or 2026-10-01T00:00:00Z).", [])
    ),
    archive_date(D0, Date),
    ( memberchk('--root'-R, Opts) -> RootOpt = some(R) ; RootOpt = none ),
    with_kb_lock(Dir, project_archive(Dir, Date, RootOpt, Code)).
cmd_project(DirOpt, [dropped|Args], Code) :- !,
    parse_opts(Args, ['--hub'-value, '--session'-value], Pos, Opts),
    (   Pos == [] -> true ; usage_error("project dropped takes no positional argument: orbit-kb project dropped [--hub DIR].", []) ),
    resolve_kb(DirOpt, Dir), lib_dir(Lib), load_kb(Dir, Lib, KB),
    project_kb_check(KB),
    absolute_file_name(Dir, ADir),
    (   drop_hub(ADir, Opts, Hub) -> true
    ;   usage_error("project dropped needs the hub of the ledger: --hub DIR (the default is the parent of the project KB, when it has flow/flow.db).", [])
    ),
    (   drop_rel(Hub, ADir, Rel)
    ->  true
    ;   usage_error("The project KB ~w is not inside the hub ~w, so the ledger item cannot refer to it (kb:PATH).", [ADir, Hub])
    ),
    ( memberchk('--session'-Ss, Opts) -> SessArgs = ['--session', Ss] ; SessArgs = [] ),
    kb_engine(KB, Eng),
    eng_all(Eng, [D, Side], lost_by_date(D, Side), L0), sort(L0, L),
    eng_all(Eng, [D, P], pushed_over(D, P), Ov0), sort(Ov0, Ov),   % T46 c1
    (   L == [], Ov == []
    ->  say("- Nothing was dropped by date.", [])
    ;   hub_read(Hub, [titles], J),
        forall(member([D, Side], L),
               (   drop_in_ledger(Eng, D, Side, Rel, J, Id0)
               ->  say("- ~w: the ~w edit lost by date; already in the ledger as ~w", [D, Side, Id0])
               ;   drop_record(Eng, Hub, SessArgs, D, Side, Rel, Id),
                   say("- ~w: the ~w edit lost by date; recorded in the ledger as ~w", [D, Side, Id])
               )),
        forall(member([D, P], Ov),
               ( overwrite_handle(Eng, Hub, SessArgs, Rel, J, D, P, R),
                 overwrite_line(Eng, D, P, R, Line), say("~w", [Line]) ))
    ),
    Code = 0.
cmd_project(_, _, _) :-
    usage_error("project takes impact X, archive --superseded-before DATE, or dropped [--hub DIR].", []).

% T43 c3: the ledger item of an edit that lost by date names the draft, the pin, both times and
% the side that lost. T45 c1: the key of a drop is the draft, its pin, the side and the kb ref
% (the title up to the times): a later tracker change of a recorded drop adds no item.
dropped_item_key(Eng, D, Side, Key) :-
    eng_all(Eng, [P], draft(D, P, _, _), [P1|_]),
    format(atom(Key), "Project KB: draft ~w of pin ~w: the ~w edit lost by date (", [D, P1, Side]).
dropped_item_title(Eng, D, Side, Title) :-
    dropped_item_key(Eng, D, Side, Key),
    eng_all(Eng, [P, S], draft(D, P, _, S), [[P1, S1]|_]),
    eng_all(Eng, [T], tracker_latest(P1, T), [T1|_]),
    format(atom(Title), "~wtracker changed ~w, draft staged ~w)", [Key, T1, S1]).
dropped_item_note(Eng, D, Side, Rel, Note) :-
    eng_all(Eng, [P, S], draft(D, P, _, S), [[P1, S1]|_]),
    (   eng_all(Eng, [Src, C], pin(P1, _, Src, _, C), [[Src1, C1]|_]) -> true ; Src1 = '?', C1 = '?' ),
    (   eng_true(Eng, both_changed(D, _))
    ->  format(atom(How), "The tracker item ~w (pin ~w at ~w) and draft ~w both changed after the pin. The later edit won (on equal times the tracker)",
               [Src1, P1, C1, D])
    ;   format(atom(How), "Draft ~w was staged at ~w, no later than pin ~w of the tracker item ~w (at ~w), and the tracker changed after the pin. The tracker won",
               [D, S1, P1, Src1, C1])
    ),
    format(atom(Note), "~w; the ~w edit lost and stays in the project KB (~w) as dropped(~w, ~w). A dropped edit: only a human closes this item, on purpose (T45).",
           [How, Side, Rel, D, Side]).

% drop_hub(+ADir, +Opts, -Hub) (T45 c1): the hub of the ledger: --hub DIR, else the parent of the
% KB when it has flow/flow.db. Fails when there is none.
drop_hub(ADir, Opts, Hub) :-
    (   memberchk('--hub'-H0, Opts) -> hub_root(H0, Hub)
    ;   file_directory_name(ADir, H1), hub_db(H1, Db1), exists_file(Db1) -> Hub = H1
    ).
drop_rel(Hub, ADir, Rel) :-
    atom_concat(Hub, '/', HubS), atom_concat(HubS, Rel, ADir), Rel \== ''.

% drop_in_ledger(+Eng, +D, +Side, +Rel, +Items, -Id): an item of the ledger (any status) has the
% key of the drop in its title and the kb ref of this KB (an item from before T45 has no other kb ref).
drop_in_ledger(Eng, D, Side, Rel, Items, Id) :-
    dropped_item_key(Eng, D, Side, Key), atom_string(Key, KeyS), atom_string(Rel, RelS),
    member(It, Items), sub_string(It.title, 0, _, _, KeyS),
    (   get_dict(kb, It, Kbs) -> memberchk(RelS, Kbs) ; true ),
    !, Id = It.id.

% drop_record(+Eng, +Hub, +SessArgs, +D, +Side, +Rel, -Id): one open thread for the drop, escalated
% to the human at once (T45 c2): only a human closes it, on purpose.
drop_record(Eng, Hub, SessArgs, D, Side, Rel, Id) :-
    dropped_item_title(Eng, D, Side, Title),
    dropped_item_note(Eng, D, Side, Rel, Note),
    atom_concat('kb:', Rel, Ref),
    hub_add_thread(Hub, SessArgs, Title, Ref, Note, Id),
    format(atom(EscNote), "a dropped edit of the project KB (~w): only a human closes it, on purpose, with hubflow close ~w --reason done --by human --session human --note \"<their words>\"", [Ref, Id]),
    hub_escalate(Hub, SessArgs, Id, EscNote).

% T46 c1 (review default): pushed_over(D, P) holds when the push of draft D overwrote the newer tracker
% edit of pin P. The record is one note on the open ledger item of the drop of D (status open or
% waiting, the same kb ref), else one new escalated item. The key of the record (in a title or a note
% of any item with the kb ref, any status) names the draft and the pin, so a second run adds none.
overwrite_key(D, P, Key) :-
    format(atom(Key), "Project KB: draft ~w overwrote the tracker edit of pin ~w when it was pushed (", [D, P]).
overwrite_texts(Eng, D, P, Rel, Title, Note) :-
    overwrite_key(D, P, Key),
    eng_all(Eng, [Tp], pushed(D, Tp), [Tp1|_]),
    eng_all(Eng, [Src, C2], pin(P, _, Src, _, C2), [[Src1, C21]|_]),
    format(atom(Title), "~wpushed ~w, tracker changed ~w)", [Key, Tp1, C21]),
    format(atom(Note), "~w: the draft was pushed at ~w and overwrote the tracker edit of ~w (pin ~w of the tracker item ~w). The tracker edit stays in the project KB (~w) as pin ~w and dropped(~w, tracker). A dropped edit: only a human closes this item, on purpose (T46).",
           [Title, Tp1, C21, P, Src1, Rel, P, D]).
overwrite_in_ledger(D, P, Rel, Items, Id) :-
    overwrite_key(D, P, Key), atom_string(Key, KeyS), atom_string(Rel, RelS),
    member(It, Items),
    (   get_dict(kb, It, Kbs) -> memberchk(RelS, Kbs) ; true ),
    (   sub_string(It.title, _, _, _, KeyS) -> true
    ;   get_dict(notes, It, Ns), member(N, Ns), string(N), sub_string(N, _, _, _, KeyS) -> true
    ),
    !, Id = It.id.
drop_open_item(Eng, D, Rel, Items, Id) :-
    dropped_item_key(Eng, D, draft, Key), atom_string(Key, KeyS), atom_string(Rel, RelS),
    member(It, Items), sub_string(It.title, 0, _, _, KeyS),
    get_dict(status, It, St), memberchk(St, ["open", "waiting"]),
    (   get_dict(kb, It, Kbs) -> memberchk(RelS, Kbs) ; true ),
    !, Id = It.id.
% overwrite_handle(+Eng, +Hub, +SessArgs, +Rel, +Items, +D, +P, -R): R is already(Id), noted(Id) or
% recorded(Id). Throws orbit_error when the ledger refuses it.
overwrite_handle(Eng, Hub, SessArgs, Rel, Items, D, P, R) :-
    (   overwrite_in_ledger(D, P, Rel, Items, Id0)
    ->  R = already(Id0)
    ;   overwrite_texts(Eng, D, P, Rel, Title, Note),
        (   drop_open_item(Eng, D, Rel, Items, Id1)
        ->  hub_note(Hub, SessArgs, Id1, Note), R = noted(Id1)
        ;   atom_concat('kb:', Rel, Ref),
            hub_add_thread(Hub, SessArgs, Title, Ref, Note, Id2),
            format(atom(EscNote), "a dropped edit of the project KB (~w): only a human closes it, on purpose, with hubflow close ~w --reason done --by human --session human --note \"<their words>\"", [Ref, Id2]),
            hub_escalate(Hub, SessArgs, Id2, EscNote),
            R = recorded(Id2)
        )
    ).
overwrite_line(Eng, D, P, R, Line) :-
    eng_all(Eng, [Tp], pushed(D, Tp), [Tp1|_]),
    format(atom(What), "- ~w: the push at ~w overwrote the tracker edit of pin ~w", [D, Tp1, P]),
    (   R = already(Id) -> format(atom(Line), "~w; already in the ledger (~w)", [What, Id])
    ;   R = noted(Id) -> format(atom(Line), "~w; noted on the ledger item ~w of the drop (only a human closes it)", [What, Id])
    ;   R = recorded(Id), format(atom(Line), "~w; recorded in the ledger as ~w (only a human closes it)", [What, Id])
    ).

% hub_note(+Hub, +SessArgs, +Id, +Note) (T46 c1): hubflow note ID TEXT --by script.
hub_note(Hub, SessArgs, Id, Note) :-
    directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf),
    (   absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]), exists_file(Hf) -> true
    ;   die(2, ["The hub " + Hub + " has no .claude/scripts/hubflow.py (or python3 is missing). Nothing was written."])
    ),
    append([[Hf, '--hub', Hub], SessArgs, ['--by', script, note, Id, Note]], Argv),
    catch(( process_create(Exe, Argv, [cwd(Hub), stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(Pr)]),
            read_string(O, _, _), read_string(E, _, Err), close(O), close(E), process_wait(Pr, St) ),
          X, ( err_text(X, Err), St = exit(2) )),
    (   St == exit(0) -> true
    ;   split_string(Err, "", " \n", [E1]),
        die(2, ["The ledger did not take the note on " + Id + ". hubflow said: " + E1,
                "Fix: set HUB_SESSION to a session of the hub, or pass --session S."])
    ).

% auto_record_drops(+KB, +Opts) (T45 c1): pin-item and draft record each new lost_by_date drop of
% the KB in the hub ledger themselves (once per drop), and print the item id on stderr. With no
% hub, or when the ledger does not take it, one line names the drop and the command to run. It
% never changes the exit code of the command, and writes nothing to the KB.
auto_record_drops(KB, Opts) :-
    (   kb_uses(KB, Us), memberchk(project, Us)
    ->  catch(auto_record_drops_(KB, Opts), E,
              ( (E = orbit_error(_, Ls) -> atomic_list_concat(Ls, ' ', M) ; err_text(E, M)),
                format(user_error, "Warning: the dropped edits were not recorded in the hub ledger: ~w~n", [M]) ))
    ;   true
    ).
auto_record_drops_(KB, Opts) :-
    kb_dir(KB, Dir), lib_dir(Lib), load_kb(Dir, Lib, KB1),     % read the KB again: the command may have written it
    kb_engine(KB1, Eng),
    eng_all(Eng, [D, Side], lost_by_date(D, Side), L0), sort(L0, L),
    eng_all(Eng, [D, P], pushed_over(D, P), Ov0), sort(Ov0, Ov),   % T46 c1
    (   L == [], Ov == [] -> true
    ;   absolute_file_name(Dir, ADir),
        ( memberchk('--session'-Ss, Opts) -> SessArgs = ['--session', Ss] ; SessArgs = [] ),
        (   drop_hub(ADir, Opts, Hub), drop_rel(Hub, ADir, Rel)
        ->  hub_read(Hub, [titles], J),
            forall(member([D, Side], L),
                   (   drop_in_ledger(Eng, D, Side, Rel, J, _) -> true
                   ;   catch(( drop_record(Eng, Hub, SessArgs, D, Side, Rel, Id),
                               format(user_error, "- ~w: the ~w edit lost by date; recorded in the hub ledger as ~w (only a human closes it)~n", [D, Side, Id]) ),
                             orbit_error(_, Ls),
                             ( atomic_list_concat(Ls, ' ', M),
                               format(user_error, "- ~w: the ~w edit lost by date; the hub ledger did not take it (~w). Run: orbit-kb --dir ~w project dropped --hub ~w --session S~n", [D, Side, M, ADir, Hub]) ))
                   )),
            forall(member([D, P], Ov),
                   catch(( overwrite_handle(Eng, Hub, SessArgs, Rel, J, D, P, R),
                           (   R = already(_) -> true
                           ;   overwrite_line(Eng, D, P, R, Line), format(user_error, "~w~n", [Line])
                           ) ),
                         orbit_error(_, Ls),
                         ( atomic_list_concat(Ls, ' ', M),
                           format(user_error, "- ~w: the push overwrote the tracker edit of pin ~w; the hub ledger did not take it (~w). Run: orbit-kb --dir ~w project dropped --hub ~w --session S~n", [D, P, M, ADir, Hub]) )))
        ;   forall(member([D, Side], L),
                   format(user_error, "- ~w: the ~w edit lost by date; no hub ledger was found to record it. Run: orbit-kb --dir ~w project dropped --hub DIR~n", [D, Side, ADir])),
            forall(member([D, P], Ov),
                   format(user_error, "- ~w: the push overwrote the tracker edit of pin ~w; no hub ledger was found to record it. Run: orbit-kb --dir ~w project dropped --hub DIR~n", [D, P, ADir]))
        )
    ).

% hub_add_thread(+Hub, +SessArgs, +Title, +Ref, +Note, -Id): one open thread in the ledger, written by
% hubflow itself (run from the hub root, --by script). The session is --session S, else HUB_SESSION.
hub_add_thread(Hub, SessArgs, Title, Ref, Note, Id) :-
    directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf),
    (   absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]), exists_file(Hf) -> true
    ;   die(2, ["The hub " + Hub + " has no .claude/scripts/hubflow.py (or python3 is missing). Nothing was written."])
    ),
    append([[Hf, '--hub', Hub], SessArgs, ['--by', script, add, thread, '--title', Title, '--ref', Ref, '--note', Note]], Argv),
    catch(( process_create(Exe, Argv, [cwd(Hub), stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(Pr)]),
            read_string(O, _, Out), read_string(E, _, Err), close(O), close(E), process_wait(Pr, St) ),
          X, ( err_text(X, Err), St = exit(2), Out = "" )),
    (   St == exit(0), split_string(Out, "", " \n", [Id0]), Id0 \== ""
    ->  atom_string(Id, Id0)
    ;   split_string(Err, "", " \n", [E1]),
        die(2, ["The ledger did not take the item for " + Title + ". hubflow said: " + E1,
                "Fix: set HUB_SESSION to a session of the hub, or pass --session S."])
    ).

% hub_escalate(+Hub, +SessArgs, +Id, +Note) (T45 c2): hubflow triage ID escalate --by script. An
% agent then cannot close the item; the refusal names the note.
hub_escalate(Hub, SessArgs, Id, Note) :-
    directory_file_path(Hub, '.claude/scripts/hubflow.py', Hf),
    absolute_file_name(path(python3), Exe, [access(execute), file_errors(fail)]),
    append([[Hf, '--hub', Hub], SessArgs, ['--by', script, triage, Id, escalate, '--note', Note]], Argv),
    catch(( process_create(Exe, Argv, [cwd(Hub), stdin(null), stdout(pipe(O)), stderr(pipe(E)), process(Pr)]),
            read_string(O, _, _), read_string(E, _, Err), close(O), close(E), process_wait(Pr, St) ),
          X, ( err_text(X, Err), St = exit(2) )),
    (   St == exit(0) -> true
    ;   split_string(Err, "", " \n", [E1]),
        die(2, ["The ledger took " + Id + " but did not escalate it. hubflow said: " + E1,
                "Fix: escalate it by hand: hubflow triage " + Id + " escalate --note 'a dropped edit: only a human closes it'."])
    ).

project_kb_check(KB) :-
    (   kb_uses(KB, Us), memberchk(project, Us) -> true
    ;   usage_error("project needs a KB that uses the project module.", [])
    ).

% T34 c3: only a real date or time (is_time/1: a month 01-12, a day of that month, and so on).
archive_date(D0, Date) :-
    atom_string(D0, S), atom_string(DA, S),
    (   re_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"/'', S) -> atom_concat(DA, 'T00:00:00Z', Date1)
    ;   Date1 = DA
    ),
    (   is_time(Date1) -> Date = Date1
    ;   usage_error("--superseded-before takes a real date such as 2026-10-01 or a UTC time such as 2026-10-01T00:00:00Z (month 01-12, a day of that month, hour 00-23, minute and second 00-59). It is ~w.", [D0])
    ).

% project_archive(+Dir, +Date, +RootOpt, -Code): remove what archive_set/5 gives.
project_archive(Dir, Date, RootOpt, Code) :-
    lib_dir(Lib), load_kb(Dir, Lib, KB), project_kb_check(KB),
    prune_spec_registry(Dir),                    % T38 c8: under the KB lock of the project KB
    kb_items(KB, All),
    include([I]>>( I = it(kb, _, _, _, _, _) ), All, Items),
    findall(X, ( member(it(_, _, _, T, _, _), Items), nonvar(T),
                 member(K, [decision, definition, rule]), functor(T, K, 2), arg(1, T, X), atom(X) ), Ids0),
    sort(Ids0, Ids),
    findall(X, ( member(X, Ids), kb_term(Items, supersedes(N, X)),
                 kb_term(Items, decided_by(N, _, W)), atom(W), W @< Date ), C0),
    sort(C0, Cand0),
    spec_pins_of(Dir, RootOpt, Ts),
    findall(S, ( member(t(S, _, X), Ts), memberchk(X, Cand0) ), Ss0), sort(Ss0, Ss),
    include(spec_kb_open(Lib), Ss, Open),
    findall(X, ( member(t(S, _, X), Ts), memberchk(S, Open) ), Pinned0), sort(Pinned0, Pinned),
    findall(Y-X, ( kb_term(Items, depends_on(Y, X)), ground(Y-X) ), Deps),
    archive_set(Cand0, Pinned, Deps, Arch),
    (   Arch == []
    ->  say("Nothing to archive: no superseded decision, definition or rule before ~w that nothing keeps.", [Date])
    ;   items_decls(All, Ds),
        archive_removed(Items, Ds, Arch, LTs),
        kb_file(KB, KbFile),
        kb_lines_without(KbFile, LTs, Out),
        archive_lint_guard(KB, KbFile, Out, Arch),     % T34 c1: refuse a result with a new lint error
        write_kb_text(KbFile, Out),
        length(LTs, NF),
        atomic_list_concat(Arch, ', ', AT),
        say("Archived (removed from kb.pl; git keeps them): ~w", [AT]),
        say("~w facts removed.", [NF]),
        archive_unseen_warning(Dir, RootOpt)
    ),
    Code = 0.

% archive_unseen_warning(+Dir, +RootOpt) (T38 c6): archive sees the spec KBs under the root and
% those of spec_kbs.txt. A spec KB outside the root with no line (one that named this project KB
% before T34) is not seen, so its pins keep nothing. Without --root, say so on stderr.
% T40 c5: with --root, say so too when a spec KB of spec_kbs.txt lies outside that root: the
% spec KBs near it are not walked. With every registered spec KB under the root, no warning.
archive_unseen_warning(Dir, some(Root0)) :- !,
    absolute_file_name(Dir, PA), absolute_file_name(Root0, Root),
    spec_registry_dirs(PA, RDs0), sort(RDs0, RDs),
    exclude(under_dir(Root), RDs, Out),
    (   Out == [] -> true
    ;   atomic_list_concat(Out, ', ', OT), length(RDs, N),
        format(user_error,
               "Warning: archive saw the spec KBs under ~w and the ~w in spec_kbs.txt. These spec KBs of spec_kbs.txt lie outside ~w: ~w. A spec KB near them with no line in spec_kbs.txt (one that recorded project_kb before T34) is not seen, and its pins keep nothing. If one may exist, restore the removed facts from git and run archive again with --root DIR, a directory that holds every spec KB of this project.~n",
               [Root, N, Root, OT])
    ).
archive_unseen_warning(Dir, none) :-
    absolute_file_name(Dir, PA), file_directory_name(PA, Root),
    spec_registry_dirs(PA, RDs), length(RDs, N),
    format(user_error,
           "Warning: archive saw the spec KBs under ~w and the ~w in spec_kbs.txt. A spec KB outside ~w with no line in spec_kbs.txt (one that recorded project_kb before T34) is not seen, and its pins keep nothing. If one may exist, restore the removed facts from git and run archive again with --root DIR, a directory that holds every spec KB of this project.~n",
           [Root, N, Root]).

% under_dir(+Root, +Dir): Dir is Root or lies below it (absolute paths).
under_dir(Root, Dir) :-
    absolute_file_name(Dir, D),
    (   D == Root -> true
    ;   ( sub_atom(Root, _, 1, 0, '/') -> R = Root ; atom_concat(Root, '/', R) ),
        sub_atom(D, 0, _, _, R)
    ).

% prune_spec_registry(+Dir) (T38 c8): spec_kbs.txt keeps one line per spec KB that still has a
% kb.pl, in its order; repeated lines go. Called under the KB lock, the lock under which add
% registers a spec KB (T40 c3), so no line is lost between the read and the rename.
% T40 c3: a KB that is briefly missing is not pruned on one look. The first archive that finds
% its kb.pl missing keeps the line and writes it to spec_kbs.missing; the next archive prunes it
% if it is still missing. A KB that is back at the next archive leaves spec_kbs.missing.
prune_spec_registry(Dir) :-
    absolute_file_name(Dir, PA), spec_registry_file(PA, F),
    directory_file_path(PA, 'spec_kbs.missing', MF),
    (   exists_file(F)
    ->  registry_lines(F, Ls0),
        list_to_set(Ls0, Ls),
        ( exists_file(MF) -> registry_lines(MF, Prev) ; Prev = [] ),
        partition([L]>>( atom_string(D, L), directory_file_path(D, 'kb.pl', KF), exists_file(KF) ),
                  Ls, _Present, Missing),
        exclude([L]>>memberchk(L, Prev), Missing, NewMissing),
        exclude([L]>>( memberchk(L, Missing), memberchk(L, Prev) ), Ls, Keep),
        (   Keep == Ls0 -> true
        ;   write_registry_lines(F, Keep)
        ),
        (   NewMissing == [] -> ( exists_file(MF) -> delete_file(MF) ; true )
        ;   NewMissing == Prev -> true
        ;   write_registry_lines(MF, NewMissing)
        )
    ;   true
    ).

registry_lines(F, Ls) :-
    read_file_to_string(F, S, [encoding(utf8)]),
    split_string(S, "\n", " \t\r", Ls0),
    exclude(==(""), Ls0, Ls).

write_registry_lines(F, Ls) :-
    current_prolog_flag(pid, Pid), format(atom(Tmp), "~w.tmp-~w", [F, Pid]),
    setup_call_cleanup(open(Tmp, write, O, [encoding(utf8)]),
                       forall(member(L, Ls), format(O, "~s~n", [L])), close(O)),
    rename_file(Tmp, F).

% archive_set(+Cand, +Pinned, +Deps, -Arch) (D27 c9; Lean model kb/proofs/project_archive):
% start from the candidates that no open spec KB pins, and drop each one that a
% fact outside the set depends on, until nothing changes. So no fact that stays
% in kb.pl depends on (or, by induction, rests on) a removed fact.
archive_set(Cand, Pinned, Deps, Arch) :-
    exclude([X]>>memberchk(X, Pinned), Cand, A0),
    archive_fix(A0, Deps, Arch).

archive_fix(A0, Deps, A) :-
    exclude([X]>>( member(Y-X, Deps), \+ memberchk(Y, A0) ), A0, A1),
    (   A1 == A0 -> A = A0 ; archive_fix(A1, Deps, A) ).

% archive_names(+Fact, +Arch): the fact names an archived id where the fact
% takes a decision, a definition or a rule.
archive_names(T, Arch) :-
    member(F/A-Ps, [decision/2-[1], definition/2-[1], rule/2-[1], decided_by/3-[1], ratified_by/3-[1],
                    reason/2-[1], analysis/2-[1], concerns/2-[1], depends_on/2-[1, 2],
                    supersedes/2-[1, 2], excludes/2-[1, 2]]),
    functor(T, F, A), member(P, Ps), arg(P, T, X), atom(X), memberchk(X, Arch), !.

% archive_removed(+Items, +Ds, +Arch, -LTs) (T34 c1, divergence a21): the Line-Fact pairs to
% remove. A fact goes when it names an id of the removed set; the set starts as Arch, and the
% id of each fact that goes joins it (an attestation about d1, then the facts that name the
% attestation, such as its actor record). Repeat until nothing changes. Lean model:
% archive_no_dangling in kb/proofs/project_archive.
archive_removed(Items, Ds, R0, LTs) :-
    findall(L-T, ( member(it(_, _, L, T, _, _), Items), nonvar(T),
                   ( archive_names(T, R0) -> true ; archive_ref_names(Ds, T, R0) ) ), LTs0),
    findall(V, ( member(_-T, LTs0), id_value(T, Ds, V) ), Vs),
    append(R0, Vs, R10), sort(R10, R1), sort(R0, R0s),
    (   R1 == R0s -> LTs = LTs0 ; archive_removed(Items, Ds, R1, LTs) ).

% archive_ref_names(+Ds, +Fact, +Arch) (T34 c1): a fact of any kind (core, a module, or a
% local declaration) has an argument of a ref type that names an archived id: note/2,
% attest/6 (its subject), and every other fact that lint would report as E4 once the id is gone.
archive_ref_names(Ds, T, Arch) :-
    compound(T), functor(T, N, A),
    decl_of(Ds, N, A, d(_, _, fact, Ts, _, _, _, _, _)),
    nth1(I, Ts, Ty), ( Ty == ref ; Ty = ref(_) ),
    arg(I, T, X), atom(X), memberchk(X, Arch), !.

% archive_lint_guard(+KB, +KbFile, +NewText, +Arch) (T34 c1): lint the KB as it would be after
% the archive. An error that the KB does not have now (a fact that still names an archived id
% in a way no ref type shows) refuses the archive, names it, and writes nothing.
archive_lint_guard(KB, KbFile, Out, Arch) :-
    KB = kb(Dir, Lib, Uses, Items0),
    read_source_string(kb, KbFile, Out, NewKbI),
    derived_items(Dir, NewKbI, Der),
    include([I]>>( I = it(S, _, _, _, _, _), S \== kb, S \== rules, S \== derived ), Items0, Pre),
    include([I]>>( I = it(rules, _, _, _, _, _) ), Items0, RulesI),
    append([Pre, NewKbI, RulesI, Der], Items1),
    lint_error_keys(KB, Old),
    lint_error_keys(kb(Dir, Lib, Uses, Items1), New),
    subtract(New, Old, Added),
    (   Added == [] -> true
    ;   atomic_list_concat(Arch, ', ', AT),
        findall(S, ( member(K, Added), fmt(S, "  ~w", [K]) ), Ls),
        append([["project archive: removing " + AT + " would leave these lint errors in the KB. Nothing was written."], Ls,
                ["Fix: remove or change the facts that name an archived id, then run project archive again."]], DLs),
        die(1, DLs >> fix_lines)
    ).

% lint_error_keys(+KB, -Keys): the lint errors of the KB, as sorted texts without line numbers.
lint_error_keys(KB, Keys) :-
    lint_diags(KB, Diags, IssueLines, _),
    findall(K, ( member(diag(C, _, _, M), Diags), sub_atom(C, 0, 1, _, 'E'), fmt(K, "~w ~w", [C, M]) ), K1),
    findall(K, ( member(K, IssueLines), sub_atom(K, 0, 1, _, 'E') ), K2),
    append(K1, K2, K0), sort(K0, Keys).

% spec_kb_open(+Lib, +SpecDir): done does not hold in the spec KB (or it cannot be read).
spec_kb_open(Lib, S) :-
    \+ catch(( load_kb(S, Lib, SKB), has_build(SKB), kb_engine(SKB, Eng), eng_true(Eng, done) ), _, fail).

% kb_lines_without(+File, +Line-Term pairs, -Out): the text of File without the lines of the
% facts. Each fact is on one line of its own (orbit-kb add writes it so). A line that does
% not hold exactly its fact stops the command, and nothing is written.
kb_lines_without(File, LTs, Out) :-
    read_file_to_string(File, Str, [encoding(utf8)]),
    split_string(Str, "\n", "", Lines),
    forall(member(L-T, LTs),
           (   nth1(L, Lines, LS),
               catch(term_string(T2, LS, [module(orbit_ops)]), _, fail), T2 =@= T
           ->  true
           ;   die(2, ["project archive: line " + L + " of kb.pl does not hold exactly one fact. Nothing was written.",
                       "Fix: keep one fact per line in kb.pl (orbit-kb add writes them so)."] >> fix_lines)
           )),
    pairs_keys(LTs, Ls),
    findall(LS, ( nth1(I, Lines, LS), \+ memberchk(I, Ls) ), Keep),
    atomic_list_concat(Keep, '\n', Out).

write_kb_text(File, Out) :-
    current_prolog_flag(pid, Pid), format(atom(Tmp), "~w.tmp-~w", [File, Pid]),
    setup_call_cleanup(open(Tmp, write, S, [encoding(utf8)]), write(S, Out), close(S)),
    rename_file(Tmp, File).

% item_text(+Eng, +Id, -Text): the text of a claim or a question, or for a
% check, the check and the text of its claim. '' for another id.
item_text(Eng, X, T) :-
    (   eng_all(Eng, [T0], claim(X, _, T0), [T1|_]) -> txt(T1, T)
    ;   eng_all(Eng, [C, T0], question(X, C, T0), [[C1, T1]|_]) -> txt(T1, TT), fmt(T, "~w (a question about claim ~w)", [TT, C1])
    ;   eng_all(Eng, [C], check(X, C), [C1|_])
    ->  ( eng_all(Eng, [T0], claim(C1, _, T0), [T1|_]) -> txt(T1, CT) ; CT = '' ),
        fmt(T, "a check of claim ~w: ~w", [C1, CT])
    ;   T = ''
    ).

% opt_change_text(+KB, +Eng, +Id, +Default, -Text): the text of change Id
% when the build module is in use, else Default.
opt_change_text(KB, Eng, X, D, T) :-
    (   has_build(KB), eng_all(Eng, [T0], change(X, T0), [T1|_]) -> txt(T1, T) ; T = D ).

% The state of a check, from check_sets/2: passed, not passed (it has a
% test result), or never run.
check_sets(Eng, ks(PassS, RunS)) :-
    eng_set(Eng, K1, passed(K1), PassS),
    eng_set(Eng, K2, attest(_, test_result, _, result(K2, _, _), _, _), RunS).

check_state(Eng, ks(PassS, RunS), K, S) :-
    (   eng_member(Eng, PassS, K, passed(K)) -> S = "passed"
    ;   eng_member(Eng, RunS, K, attest(_, test_result, _, result(K, _, _), _, _))
    ->  S = "not passed"
    ;   S = "never run"
    ).

% The burn state of a claim, for show and report: proved, waived (with
% the due time), open, or not a burn. D21: the flare state too: shown
% (with the demo), waived, open, or not a flare.
burn_sets(Eng, bs(BurnS, ProvS, WaivBy, FlareS, ShownS)) :-
    eng_set(Eng, X1, burn(X1), BurnS),
    eng_set(Eng, X2, burn_proved(X2), ProvS),
    eng_groups(Eng, C3, D3, ( attest(W3, waiver, _, waive(C3, D3, _), human, _), not(waiver_lapsed(W3)) ), WaivBy),
    eng_set(Eng, X4, flare(X4), FlareS),
    eng_set(Eng, X5, flare_shown(X5), ShownS).

% esc_parts(+Eng, +BSets, +C, -Parts): the Head-Detail pairs of the burn
% and the flare of claim C, in that order; [] when it has neither.
esc_parts(Eng, BSets, C, Parts) :-
    burn_parts(Eng, BSets, C, BH, BD),
    flare_parts(Eng, BSets, C, FH, FD),
    exclude([H-_]>>(H == ""), [BH-BD, FH-FD], Parts).

flare_parts(Eng, bs(_, _, WaivBy, FlareS, ShownS), C, Head, Detail) :-
    (   \+ eng_member(Eng, FlareS, C, flare(C)) -> Head = "", Detail = ""
    ;   eng_member(Eng, ShownS, C, flare_shown(C))
    ->  Head = "Flare: shown.",
        eng_all(Eng, [S, P], ( demo(S, C), attest(_, approval, S, digest(D), human, _), subject(S, P, D) ), SPs),
        findall(T, ( member([S, P], SPs), fmt(T, "~w (~w)", [S, P]) ), Ts0),
        sort(Ts0, Ts), atomic_list_concat(Ts, ', ', TsT),
        fmt(Detail, "A human approved demo ~w.", [TsT])
    ;   eng_lookup(Eng, WaivBy, C, D, ( attest(W, waiver, _, waive(C, D, _), human, _), not(waiver_lapsed(W)) ), [D1|_])
    ->  Head = "Flare: NOT SHOWN.", fmt(Detail, "A human waived the demo until ~w.", [D1])
    ;   Head = "Flare: NOT SHOWN.", Detail = "A human must approve a demo of it."
    ).

burn_parts(Eng, bs(BurnS, ProvS, WaivBy, _, _), C, Head, Detail) :-
    (   \+ eng_member(Eng, BurnS, C, burn(C)) -> Head = "", Detail = ""
    ;   eng_member(Eng, ProvS, C, burn_proved(C))
    ->  (   proof_statement(Eng, C, _, Thm, _)
        ->  format(string(Head), "Burn: proved in Lean: theorem ~w.", [Thm])
        ;   Head = "Burn: proved in Lean."
        ),
        conformance_sentence(Eng, C, CS),
        format(string(Detail), "The proof is about the Lean definitions, not the code. ~w", [CS])
    ;   eng_true(Eng, burn_model_closed(C))   % D42 K6: the model, its result, and its bounds
    ->  model_closure(Eng, C, Head, Detail)
    ;   eng_lookup(Eng, WaivBy, C, D, ( attest(W, waiver, _, waive(C, D, _), human, _), not(waiver_lapsed(W)) ), [D1|_])
    ->  Head = "Burn: NOT PROVED.", fmt(Detail, "A human waived the proof until ~w.", [D1])
    ;   eng_true(Eng, burn_needs_lean(C))
    ->  Head = "Burn: NOT PROVED.", Detail = "A Lean proof is required."
    ;   Head = "Burn: NOT PROVED.",
        Detail = "The claim was contested twice: it owes a formal statement in the language that fits it. A Lean proof closes it, or a decided result of a trusted solver or model-checker model that encodes it."
    ).

% burn_need_words(+Eng, +C, -Words) (D42 K5): what an open burn of claim C needs.
burn_need_words(Eng, C, W) :-
    (   eng_true(Eng, burn_needs_lean(C))
    ->  W = "needs a Lean proof"
    ;   W = "owes a formal statement in the language that fits it (a Lean proof, or a decided result of a trusted solver or model-checker model that encodes it)"
    ).

% model_closure(+Eng, +C, -Head, -Detail) (D42 K6): the counted result of a trusted model that
% closes the burn of claim C, and the bounds of its run (run_bounds/2).
model_closure(Eng, C, Head, Detail) :-
    eng_all(Eng, [M, Tool, K, R, L],
            ( encodes(M, C), model_trusted(M), model(M, Tool), model_verdict(A, M, K, R),
              model_decided_result(R), attest(A, model_result, L, _, _, _) ), Rs0),
    findall([M, Tool, K, R, L], ( member([M, Tool, K, R, L], Rs0), ( K = preserve(C) ; K = applies(C) ) ), Rs1),
    sort(Rs1, Rs),
    (   Rs = [[M, Tool, K, R, L]|_]
    ->  term_text(K, KT),
        format(string(Head), "Burn: closed by a model: model ~w (~w), ~w on ~w (log ~w).", [M, Tool, R, KT, L]),
        eng_all(Eng, [BT], run_bounds(L, BT), BTs),
        (   BTs == []
        ->  format(string(Detail), "No bounds are recorded for log ~w: add run_bounds(~w, 'TEXT').", [L, L])
        ;   findall(BS, ( member(B0, BTs), one_line(B0, B1), format(string(BS), "The result holds only within its bounds: ~w.", [B1]) ), BSs),
            atomic_list_concat(BSs, ' ', D0), atom_string(D0, Detail)
        )
    ;   Head = "Burn: closed by a model.", Detail = ""
    ).

% proof_statement(+Eng, +C, -A, -Theorem, -Statement) (D31 B4): the theorem and its statement
% from the log runs/proof-A.log of the last lean_proof A of claim C that still counts.
proof_statement(Eng, C, A, Thm, St) :-
    show_base(Dir),
    eng_all(Eng, [A0], ( attest(A0, lean_proof, _, proof(C, _), script, _), not(proof_changed(A0)) ), As),
    last(As, A),
    catch(proof_log(Dir, A, plog(_, _, _, _, _, Info)), _, fail),
    memberchk(theorem(Thm), Info), memberchk(statement(St), Info).

% conformance_sentence(+Eng, +C, -S) (D31 B4): whether a check carries the examples of the Lean
% definitions to the code (conformance/1, conforms/1 of the build module).
conformance_sentence(Eng, C, S) :-
    eng_all(Eng, [K], ( check(K, C), conformance(K) ), Ks),
    (   Ks == []
    ->  S = "No conformance check carries the examples of the definitions to the code."
    ;   atomic_list_concat(Ks, ', ', KT),
        (   eng_true(Eng, conforms(C))
        ->  format(string(S), "Conformance check ~w carries the examples of the Lean definitions to the code, and it passed.", [KT])
        ;   format(string(S), "Conformance check ~w carries the examples of the Lean definitions to the code, but it has not passed.", [KT])
        )
    ).

burn_text(Eng, BSets, C, T) :-
    esc_parts(Eng, BSets, C, Parts),
    findall(PT, ( member(Head-Detail, Parts),
                  ( Detail == "" -> fmt(PT, " ~w", [Head]) ; fmt(PT, " ~w ~w", [Head, Detail]) ) ),
            PTs),
    atomic_list_concat(PTs, '', T0), atom_string(T0, T).

% Joins for show and report. A section asks the SWI engine once per
% relation, not once per claim or check, and then looks the answers up.
% eng_set/4 and eng_groups/5 give none when the answers are not
% complete (the answer cap, an error, or answers with variables). Then
% the lookups ask the SWI engine directly, as for one item.
%
% eng_set(+Eng, ?X, +G, -Set): the answers X of G, as an AVL set.
eng_set(Eng, X, G, Set) :-
    swi_raw(Eng, G, [X], R),
    (   R = answers(L0, false), ground(L0)
    ->  findall(V-t, member([V], L0), Ps0),
        sort(Ps0, Ps),
        ord_list_to_assoc(Ps, Set)
    ;   Set = none
    ).

eng_member(Eng, Set, X, G) :-
    (   Set \== none, ground(X)
    ->  get_assoc(X, Set, _)
    ;   eng_true(Eng, G)
    ).

% eng_groups(+Eng, ?K, ?V, +G, -By): Key -> the values V of the answers
% of G with that key K, in answer order.
eng_groups(Eng, K, V, G, By) :-
    swi_raw(Eng, G, [K, V], R),
    (   R = answers(L, false), ground(L)
    ->  findall(K1-V1, member([K1, V1], L), Ps),
        group_by_key_in_order(Ps, By)
    ;   By = none
    ).

% eng_lookup(+Eng, +By, +K, ?V, +G, -Vs): as eng_all(Eng, [V], G, Vs).
eng_lookup(Eng, By, K, V, G, Vs) :-
    (   By \== none, ground(K)
    ->  ( get_assoc(K, By, Vs) -> true ; Vs = [] )
    ;   eng_all(Eng, [V], G, Vs)
    ).

% eng_lookup2: as eng_lookup/6 for a value template that is a list,
% such as [B, W]; the result is as eng_all(Eng, [B, W], G, Vs).
eng_lookup2(Eng, By, K, VT, G, Vs) :-
    (   By \== none, ground(K)
    ->  ( get_assoc(K, By, Vs) -> true ; Vs = [] )
    ;   eng_all(Eng, VT, G, Vs)
    ).

% waiver_kind(+Eng, +X, -Kind) (D13): the kind of the target of a waiver:
% claim, check, question, or "unknown id".
waiver_kind(Eng, X, K) :-
    (   eng_true(Eng, claim(X, _, _)) -> K = claim
    ;   eng_true(Eng, check(X, _)) -> K = check
    ;   eng_true(Eng, question(X, _, _)) -> K = question
    ;   K = 'unknown id'
    ).

% The text of report (D16 c4) is plain Markdown that also reads as raw
% text: "# Section:" headings with a blank line between sections, bullets
% indented by two spaces per level, the label in **bold**, and nesting
% for the detail of an item. It has no colour and no box drawing.
%
% report_line(S): each line that report printed, in order. The digest
% and the "Plain text" part of the page are made from these lines.
% report_rec(Tag, Plain) (D16): the same output as one record per item,
% in order, with the item that it is about and its text as one plain
% sentence. report --html builds the page from these records, so the
% page and the text cannot disagree.
:- dynamic report_rec/2, report_line/1, report_started/0.

rline(S) :- format("~w~n", [S]), assertz(report_line(S)).

% rhead(+Name): the heading of a section, after a blank line (but the first).
rhead(Name) :-
    (   report_started -> rline("") ; assertz(report_started) ),
    format(string(H), "# ~w:", [Name]),
    rline(H),
    format(string(P), "~w:", [Name]),
    assertz(report_rec(head(Name), P)).

% rtree(+Tag, +Plain, +Node): print one item and record it. Node is
% Text-Kids, and each kid is a node. The top bullet has two spaces,
% and each level adds two.
rtree(Tag, Plain, Node) :-
    assertz(report_rec(Tag, Plain)),
    rnode(1, Node).

rnode(Depth, Text-Kids) :-
    Indent is 2 * Depth,
    format(string(Pad), "~*c", [Indent, 0' ]),
    format(string(L), "~w- ~w", [Pad, Text]),
    rline(L),
    D1 is Depth + 1,
    forall(member(K, Kids), rnode(D1, K)).

% rsay(+Tag, +Fmt, +Args): a bullet with no nesting.
rsay(Tag, Fmt, Args) :-
    format(string(S), Fmt, Args),
    rtree(Tag, S, S-[]).

% as_sentence(+Text, -S): Text, with a period when it has no end mark.
% The page shows this form, so that its sentences do not run together.
as_sentence(T, S) :-
    plain_text(T, S0),
    ( T == "" -> S = S0 ; ends_sentence(T) -> S = S0 ; format(string(S), "~w.", [S0]) ).

% ends_sentence(+Text): the text ends in . ? or !
ends_sentence(T) :-
    plain_text(T, S),
    sub_string(S, _, 1, 0, E), sub_atom(".?!", _, 1, _, E).

cmd_report(KB, Args, Code) :-
    parse_opts(Args, ['--html'-value, '--open'-flag], Pos, Opts),
    ( Pos == [] -> true ; usage_error("report takes no arguments.", []) ),
    opt(Opts, '--html', none, Html),
    opt(Opts, '--open', false, Open),
    ( Open == true, Html == none -> usage_error("--open needs --html FILE.", []) ; true ),
    kb_dir(KB, Dir), retractall(show_base(_)), assertz(show_base(Dir)),
    answer_gate(KB),
    kb_engine(KB, Eng),
    retractall(report_rec(_, _)), retractall(report_line(_)), retractall(report_started),
    report_text(KB, Eng),
    (   Html == none
    ->  Code = 0
    ;   report_page(KB, Eng, Html, Open, Code)
    ).

% claim_node(+Build, +C, +L, +TT, +SK, +StHead, +StDetail, +Exs, +Parts, +KStates, -Node)
% Parts: the Head-Detail pairs of the burn and the flare (esc_parts/4).
% A claim that is fulfilled, with nothing to add, is one line: its checks
% all passed, its burn is proved or absent, it has no flare (D21: the
% demo always shows), and the line, with its
% bullet, fits in 100 columns. Any other claim breaks its status, burn,
% and checks into nested bullets, so that its status never wraps off
% the end of a long line.
% D31 B2: Exs are the "Example: X." lines of the claim. They come after the status. A claim
% with more than one example is never one line.
claim_node(Build, C, L, TT, SK, StHead, StDetail, Exs, Parts, KStates, Node) :-
    format(string(Head), "~w **~w**: ~w", [C, L, TT]),
    (   memberchk(SK, [fulfilled, none]),
        Parts == [],
        KStates \== [],
        forall(member(_-KS, KStates), KS == "passed"),
        ( Exs = [] ; Exs = [_] ),
        (   ends_sentence(TT) -> Sep = " " ; Sep = ". " ),
        findall(P, ( call(Build), StHead \== "", P = StHead
                   ; member(P, Exs)
                   ; member(P-_, Parts)
                   ; check_line(KStates, P, _) ),
                Ps),
        atomic_list_concat(Ps, ' ', PsT),
        format(string(Line), "~w~w~w", [Head, Sep, PsT]),
        string_length(Line, Len),
        Len + 4 =< 100
    ->  Node = Line-[]
    ;   findall(N, claim_kid(Build, StHead, StDetail, Exs, Parts, KStates, N), Kids),
        Node = Head-Kids
    ).

claim_kid(Build, StHead, StDetail, _, _, _, N) :-
    call(Build), StHead \== "",
    ( StDetail == "" -> N = StHead-[] ; N = StHead-[StDetail-[]] ).
claim_kid(_, _, _, Exs, _, _, E-[]) :-
    member(E, Exs).
claim_kid(_, _, _, _, Parts, _, N) :-
    member(BHead-BDetail, Parts),
    ( BDetail == "" -> N = BHead-[] ; N = BHead-[BDetail-[]] ).
claim_kid(_, _, _, _, _, KStates, N) :-
    check_line(KStates, T, Kids), N = T-Kids.

% check_line(+KStates, -Text, -Kids): "Checks: none.", "Checks: k1 (passed).",
% or "Checks:" with one kid per check.
check_line([], "Checks: none.", []).
check_line([K-KS], T, []) :- format(string(T), "Checks: ~w (~w).", [K, KS]).
check_line([A, B|R], "Checks:", Kids) :-
    findall(N, ( member(K-KS, [A, B|R]), format(string(X), "~w (~w)", [K, KS]), N = X-[] ), Kids).

report_text(KB, Eng) :-
    Build = has_build(KB),
    rhead('Delivered'),
    rsay(placeholder, "(Write what you delivered here.)", []),
    % D31 B3: the fields of the delivery block of the prompt, in its order.
    rhead('KB'),
    kb_dir(KB, KDir0),
    rsay(kb_dir, "~w", [KDir0]),
    % D35 R1 (c_k_g_3): each request, word for word: the first one, and each decision that the
    % human gave during the ticket (a further request fact, in the human's words).
    eng_all(Eng, [RI, RT], request(RI, RT), Reqs),
    forall(member([RI, RT], Reqs),
           ( one_line(RT, RTT), rsay(item(RI), "Request ~w, word for word: ~w", [RI, RTT]) )),
    signals_section(KB, Eng),
    hypothesis_section(Eng),
    ( has_discovery(KB) -> system_section(Eng), findings_section(Eng) ; true ),
    rhead('Claims'),
    eng_all(Eng, [C, L, T], ( claim(C, L, T), current(C) ), Cs),
    (   Cs == [] -> rsay(none, "No current claims.", []) ; true ),
    % One query per relation, then lookups (see eng_set/4).
    ( call(Build) -> eng_set(Eng, X1, fulfilled(X1), FulS), burn_sets(Eng, BSets) ; true ),
    eng_groups(Eng, C2, K2, check(K2, C2), ChecksBy),
    eng_groups(Eng, C7, E7, example(C7, E7), ExBy),
    check_sets(Eng, KSets),
    forall(member([C, L, T], Cs),
           ( txt(T, TT),
             eng_lookup(Eng, ExBy, C, E, example(C, E), Es),
             findall(EL, ( member(E, Es), txt(E, ET), as_sentence(ET, ES), format(string(EL), "Example: ~w", [ES]) ), Exs),
             (   call(Build)
             ->  (   eng_member(Eng, FulS, C, fulfilled(C)) -> StHead = "Status: fulfilled.", StDetail0 = "", SK = fulfilled
                 ;   eng_all(Eng, [WK, WD], ( check(WK, C), attest(WW, waiver, _, waive(WK, WD, _), human, _), not(waiver_lapsed(WW)) ), [[WK1, WD1]|_])
                 ->  StHead = "Status: not fulfilled.",
                     fmt(StDetail0, "A human waived check ~w until ~w, so the claim does not block done until then.", [WK1, WD1]),
                     SK = waived
                 ;   StHead = "Status: under.", StDetail0 = "It is not fulfilled yet.", SK = under
                 ),
                 % D43 (c_k_h_2b): a red run that only the agent saw is not shown red by the tool.
                 eng_all(Eng, [RK, RA], ( check(RK, C), attest(RA, disclosure, _, seen_red(RK, _), _, _), not(was_red(RK)) ), RKAs),
                 findall(RS, ( member([RK, RA], RKAs),
                               (   SK == under
                               ->  format(string(RS), "Check ~w was not shown red by the tool: the agent saw it fail before the KB existed (disclosure ~w). The claim stays unfulfilled until a human waives check ~w.", [RK, RA, RK])
                               ;   format(string(RS), "Check ~w was not shown red by the tool (disclosure ~w).", [RK, RA])
                               ) ), RSs),
                 atomic_list_concat([StDetail0|RSs], ' ', StD2), normalize_space(string(StDetail), StD2),
                 esc_parts(Eng, BSets, C, Parts),
                 join_sentences(StHead, StDetail, S1),
                 string_concat(" ", S1, St0),
                 findall(B1, ( member(BHead-BDetail, Parts), join_sentences(BHead, BDetail, B0),
                               string_concat(" ", B0, B1) ), B1s),
                 atomic_list_concat(B1s, '', BT0), atom_string(BT0, BT),
                 string_concat(St0, BT, St)
             ;   St = "", St0 = "", BT = "", SK = none,
                 StHead = "", StDetail = "", Parts = []
             ),
             eng_lookup(Eng, ChecksBy, C, K, check(K, C), Ks),
             findall(K-KS, ( member(K, Ks), check_state(Eng, KSets, K, KS) ), KStates),
             (   Ks == [] -> KT = " Checks: none."
             ;   findall(S, ( member(K-KS, KStates), fmt(S, "~w (~w)", [K, KS]) ), Ss),
                 atomic_list_concat(Ss, ', ', SsT), fmt(KT, " Checks: ~w.", [SsT])
             ),
             claim_node(Build, C, L, TT, SK, StHead, StDetail, Exs, Parts, KStates, Node),
             format(string(Plain), "~w (~w): ~w~w~w", [C, L, TT, St, KT]),
             rtree(claim(C, L, TT, SK, St0, BT, KStates), Plain, Node) )),
    % D28: who verified each claim, in a KB that records actors or a review.
    (   call(Build), eng_true(Eng, verification_recorded)
    ->  review_section(Eng, Cs)
    ;   true
    ),
    formal_section(KB, Eng, Cs),
    scope_sections(KB, Eng),
    rhead('Guesses'),
    eng_all(Eng, [Q, A], ( assumed(Q, A), not(answered(Q)) ), Gs),
    % D30 H3: each premise that nobody checked is a guess about the system.
    eng_all(Eng, [P7, H7, PT7], ( premise(P7, H7, PT7), premise_unchecked(P7) ), Ps7),
    % D17: say that a human answered only when a question with a default exists.
    % D30 H3: say that each premise is checked only when a premise of a current hypothesis exists.
    (   ( Gs \== [] ; Ps7 \== [] ) -> true
    ;   (   eng_all(Eng, [P8], ( premise(P8, H8, _), not(superseded(H8)) ), [_|_])
        ->  PremT = "Each premise is checked, and " ; PremT = "" ),
        (   eng_all(Eng, [Q0], assumed(Q0, _), [_|_])
        ->  AskT = "a human answered every question with a default.", AskU = "A human answered every question with a default."
        ;   AskT = "no question has a default.", AskU = "No question has a default."
        ),
        (   PremT == "" -> format(string(NoneT), "None. ~w", [AskU])
        ;   format(string(NoneT), "None. ~w~w", [PremT, AskT])
        ),
        rsay(none, "~w", [NoneT])
    ),
    eng_groups(Eng, Q5, QT5, question(Q5, _, QT5), QTextBy),
    forall(member([Q, A], Gs),
           ( term_text(A, AT),
             ( eng_lookup(Eng, QTextBy, Q, QT, question(Q, _, QT), [QT1|_]) -> txt(QT1, QTT) ; QTT = "" ),
             as_sentence(QTT, QTS),
             format(string(Plain), "~w: ~w The default is ~w. No human answered it.", [Q, QTS, AT]),
             format(string(Head), "~w: ~w", [Q, QTT]),
             format(string(Kid), "The default is ~w. No human answered it.", [AT]),
             rtree(item(Q), Plain, Head-[Kid-[]]) )),
    forall(member([P7, H7, PT7], Ps7),
           ( txt(PT7, PTT7), as_sentence(PTT7, PTS7),
             format(string(Kid7), "A premise of hypothesis ~w. Nobody checked it on the system.", [H7]),
             format(string(Plain7), "~w: ~w ~w", [P7, PTS7, Kid7]),
             format(string(Head7), "~w: ~w", [P7, PTT7]),
             rtree(item(P7), Plain7, Head7-[Kid7-[]]) )),
    rhead('Disclosures'),
    eng_all(Eng, [I, S0, P, B], attest(I, disclosure, S0, P, B, _), Ds),
    (   Ds == [] -> rsay(none, "None.", []) ; true ),
    forall(member([I, S0, P, B], Ds),
           ( term_text(P, PT),
             format(string(Plain), "~w: ~w, about ~w, by ~w.", [I, PT, S0, B]),
             (   P = seen_red(RK, ROut)   % D43: a red run that only the agent saw
             ->  one_line(ROut, ROutT),
                 format(string(Head), "~w **seen_red**: check ~w failed in a run that only the agent saw, before the KB existed: not shown red by the tool. The output: ~w", [I, RK, ROutT])
             ;   compound(P), compound_name_arguments(P, Kind, [Arg])
             ->  plain_text(Arg, ArgT), format(string(Head), "~w **~w**: ~w", [I, Kind, ArgT])
             ;   format(string(Head), "~w: ~w", [I, PT])
             ),
             format(string(Kid), "About ~w, by ~w.", [S0, B]),
             rtree(item(I), Plain, Head-[Kid-[]]) )),
    (   call(Build)
    ->  rhead('Waivers'),
        eng_all(Eng, [W6, X6, D6, B6], attest(W6, waiver, _, waive(X6, D6, _), B6, _), W6s),
        (   W6s == [] -> rsay(none, "None.", []) ; true ),
        forall(member([W6, X6, D6, B6], W6s),
               ( waiver_kind(Eng, X6, Kind6),
                 ( atom(D6) -> DT6 = D6 ; term_text(D6, DT6) ),
                 (   B6 \== human
                 ->  St6 = "it does not count, because a human did not write it (E8)",
                     Lab6 = "ignored", Kid6 = "It does not count, because a human did not write it (E8)."
                 ;   eng_true(Eng, waiver_lapsed(W6))
                 ->  St6 = "lapsed, so the item blocks done again",
                     Lab6 = "lapsed", Kid6 = "The item blocks done again."
                 ;   St6 = "in force", Lab6 = "in force", Kid6 = ""
                 ),
                 format(string(Plain), "~w: ~w ~w, due ~w, ~w.", [W6, Kind6, X6, DT6, St6]),
                 format(string(Head), "~w **~w**: ~w ~w, due ~w", [W6, Lab6, Kind6, X6, DT6]),
                 ( Kid6 == "" -> Kids6 = [] ; Kids6 = [Kid6-[]] ),
                 rtree(item(W6), Plain, Head-Kids6) ))
    ;   true
    ),
    rhead('Not checked'),
    findall([C3, T3], ( member([C3, _, T3], Cs),
                        \+ ( eng_lookup(Eng, ChecksBy, C3, K3, check(K3, C3), [_|_]) ) ),
            NCs),
    (   NCs \== [] -> true
    ;   Cs == [] -> rsay(none, "None. No claim is current.", [])
    ;   rsay(none, "None. Every current claim has a check.", [])
    ),
    forall(member([C3, T3], NCs),
           ( txt(T3, TT3),
             as_sentence(TT3, TTS3),
             format(string(Plain), "~w: ~w It has no check.", [C3, TTS3]),
             format(string(Head), "~w: ~w", [C3, TT3]),
             rtree(item(C3), Plain, Head-["It has no check."-[]]) )),
    rhead('Open'),
    eng_all(Eng, [Q4], to_ask(Q4), Q4s),
    eng_all(Eng, [A4], stale(A4), A4s),
    eng_all(Eng, [Y4], supersede_cycle(Y4), Y4s),
    (   call(Build)
    ->  eng_all(Eng, [O4], over(O4), O4s),
        eng_all(Eng, [B4], burn_open(B4), B4s),
        eng_all(Eng, [F4], flare_open(F4), F4s),
        eng_all(Eng, [W4, C4, D4], ( attest(W4, waiver, _, waive(C4, D4, _), human, _), waiver_lapsed(W4) ), L4s),
        eng_all(Eng, [P4, C5], ( attest(P4, lean_proof, _, proof(C5, _), _, _), proof_changed(P4) ), P4s)
    ;   O4s = [], B4s = [], F4s = [], L4s = [], P4s = []
    ),
    % D17: in a build KB, done needs a current claim.
    ( call(Build), Cs == [] -> N4s = [no_claim] ; N4s = [] ),
    % D19: in a discovery KB, what blocks discovery_ready is open too. D32 O2: each thing that
    % blocks it is one item (ready_blocker), while the discovery orbit is open.
    (   has_discovery(KB)
    ->  eng_all(Eng, [W5], question_waits(W5), W5s0),
        subtract(W5s0, Q4s, W5s),
        eng_all(Eng, [R5], ( refuted(R5), current(R5) ), R5s)
    ;   W5s = [], R5s = []
    ),
    % D32 O1, O3: every other answer of blocking(X), and each stale pin that the KB rests on.
    open_more(KB, Eng, [to_ask, supersede_cycle, over, burn_open, flare_open, no_claim, waiver_lapsed],
              [question_waits, refuted], Bl6s, D5s, Sp6s),
    forall(member(_, N4s), ropen(open(no_claim, claims, none), "no claim", "No claim is current. Add a claim. The work is not done without one.", [])),
    forall(member(Q4, Q4s), ropen(open(to_ask, Q4, none), "ask", "Ask question ~w now.", [Q4])),
    forall(member(W5, W5s), ropen(open(question_waits, W5, none), "waits", "Question ~w waits for the human's answer.", [W5])),
    forall(member(R5, R5s), ropen(open(refuted, R5, none), "refuted", "Claim ~w is refuted. Record the counterexample as an example, and ask the human. Do not weaken the claim.", [R5])),
    forall(member(X6, Bl6s), report_blocking_item(KB, Eng, X6)),
    forall(member(D5, D5s),
           ( ready_line(Eng, D5, DK5, DS5), ( D5 = unknown -> DRef = discovery ; functor(D5, _, DA), ( DA =:= 1 -> arg(1, D5, DRef) ; functor(D5, DRef, _) ) ),
             ( eng_true(Eng, claim(DRef, _, _)) -> DTgt = DRef ; DTgt = none ),
             ropen(open(discovery_ready, DRef, DTgt), "not ready", "Discovery is not ready, ~w: ~w", [DK5, DS5]) )),
    % D41 (review of K-C/K-D, item 9): the pointer of D19 to the explanation comes back, once.
    (   D5s \== []
    ->  rsay(why_not_ready, "Why: orbit-kb whynot 'discovery_ready' explains what blocks readiness, and orbit-kb lint gives the fix of each finding.", [])
    ;   true
    ),
    forall(member(P6, Sp6s), ( stale_pin_text(Eng, P6, PS6), ropen(open(stale_pin, P6, none), "stale pin", "Pin ~w: ~w", [P6, PS6]) )),
    forall(member(A4, A4s), ropen(open(stale, A4, none), "stale", "Approval ~w is stale. The subject changed after the approval.", [A4])),
    forall(member(Y4, Y4s),
           (   eng_true(Eng, claim(Y4, _, _))
           ->  ropen(open(supersede_cycle, Y4, none), "cycle", "Claim ~w is in a supersede cycle. It replaces itself, so it is not current. Remove a supersedes fact (lint E15).", [Y4])
           ;   ropen(open(supersede_cycle, Y4, none), "cycle", "Hypothesis ~w is in a supersede cycle. It replaces itself. Remove a supersedes fact (lint E15).", [Y4])
           )),
    forall(member(O4, O4s), ropen(open(over, O4, none), "over", "Change ~w serves no claim.", [O4])),
    forall(member(B4, B4s),
           (   eng_true(Eng, burn_needs_lean(B4))
           ->  ropen(open(burn_open, B4, B4), "burn open", "Claim ~w needs a Lean proof. Prove it with orbit-kb prove, or ask a human for a waiver.", [B4])
           ;   ropen(open(burn_open, B4, B4), "burn open", "Claim ~w owes a formal statement in the language that fits it. Prove it with orbit-kb prove, record a trusted solver or model-checker model that encodes it with a decided result (orbit-kb help build, BURN), or ask a human for a waiver.", [B4])
           )),
    forall(member(F4, F4s), ropen(open(flare_open, F4, F4), "flare open", "Claim ~w needs a human to approve a demo. Record a screenshot or a recording with orbit-kb subject and demo(S, C), show it, and ask the human to approve it or waive it.", [F4])),
    forall(member([W4, C4, D4], L4s),
           ( waiver_kind(Eng, C4, K4),
             Tag4 = open(waiver_lapsed, W4, C4),
             (   K4 == claim
             ->  (   eng_true(Eng, flare(C4)), eng_true(Eng, burn(C4))
                 ->  ropen(Tag4, "waiver lapsed", "Waiver ~w of the proof and the demo of claim ~w was due at ~w. The proof and the demo are due now.", [W4, C4, D4])
                 ;   eng_true(Eng, flare(C4))
                 ->  ropen(Tag4, "waiver lapsed", "Waiver ~w of the demo of claim ~w was due at ~w. The demo is due now.", [W4, C4, D4])
                 ;   ropen(Tag4, "waiver lapsed", "Waiver ~w of the proof of claim ~w was due at ~w. The proof is due now.", [W4, C4, D4])
                 )
             ;   K4 == check -> ropen(Tag4, "waiver lapsed", "Waiver ~w of check ~w was due at ~w. The check must pass now.", [W4, C4, D4])
             ;   K4 == question -> ropen(Tag4, "waiver lapsed", "Waiver ~w of question ~w was due at ~w. Ask the question now, if it is still open.", [W4, C4, D4])
             ;   ropen(Tag4, "waiver lapsed", "Waiver ~w of ~w was due at ~w.", [W4, C4, D4])
             ) )),
    forall(member([P4, C5], P4s), ropen(open(proof_changed, P4, C5), "proof changed", "Proof ~w of claim ~w no longer counts. A file of the proof changed. Run orbit-kb prove again.", [P4, C5])),
    (   Q4s == [], A4s == [], Y4s == [], O4s == [], B4s == [], F4s == [], L4s == [], P4s == [], N4s == [],
        W5s == [], R5s == [], D5s == [], Bl6s == [], Sp6s == []
    ->  rsay(none, "Nothing is open.", [])
    ;   true
    ),
    ( has_discovery(KB) -> vote_section(Eng) ; true ),
    rhead('To land'),
    rsay(placeholder, "(Write the steps to land the work here.)", []).

% report_blocking_item(+KB, +Eng, +X) (D32 O1): an answer of blocking(X) that the Open section
% has no item of its own for, with the sentence of show blocking. Its label is the kind.
report_blocking_item(KB, Eng, X) :-
    functor(X, N, A),
    (   A =:= 1 -> arg(1, X, Ref) ; Ref = N ),
    blocking_line(KB, Eng, X, Line),
    (   sub_string(Line, B, 2, _, ": ") -> B2 is B + 2, sub_string(Line, B2, _, 0, Sen0) ; Sen0 = Line ),
    (   sub_string(Sen0, 0, 1, _, F0) -> string_upper(F0, F1), sub_string(Sen0, 1, _, 0, R0), string_concat(F1, R0, Sen1) ; Sen1 = Sen0 ),
    ( ends_sentence(Sen1) -> Sen2 = Sen1 ; string_concat(Sen1, ".", Sen2) ),
    % the id is always in the text (a request_stale sentence names its tracker item instead)
    (   A =:= 1, term_string(Ref, RefS), \+ sub_string(Sen2, _, _, _, RefS) -> fmt(Sen, "~w: ~w", [Ref, Sen2]) ; Sen = Sen2 ),
    (   eng_true(Eng, claim(Ref, _, _)) -> Tgt = Ref
    ;   eng_all(Eng, [C], check(Ref, C), [C1|_]) -> Tgt = C1
    ;   Tgt = none
    ),
    atomic_list_concat(Ws, '_', N), atomic_list_concat(Ws, ' ', Label),
    ropen(open(N, Ref, Tgt), Label, "~w", [Sen]).

% system_section(+Eng) (D31 B6): what the current system showed: each reproduction on system
% evidence, and the last failed run of each check that is tagged as system evidence.
system_section(Eng) :-
    rhead('System'),
    eng_all(Eng, [A, S, P, B], ( attest(A, reproduction, S, P, B, _), discovery_system_evidence(S) ), Rs),
    eng_all(Eng, [K, N], ( attest(_, test_result, _, result(K, N, fail), _, _), discovery_system_evidence(K) ), Fs0),
    findall(K-N, ( member([K, N], Fs0), \+ ( member([K, N2], Fs0), N2 > N ) ), Fs1), sort(Fs1, Fs),
    (   Rs == [], Fs == []
    ->  rsay(none, "Nothing yet. No result from the current system.", [])
    ;   true
    ),
    forall(member([A, S, P, B], Rs),
           (   P = result(H, R)
           ->  ( R == reproduced -> RT = "reproduced" ; RT = "not reproduced" ),
               rsay(item(H), "~w: ~w, on ~w (~w, by ~w).", [H, RT, S, A, B])
           ;   P = confirms(F)
           ->  rsay(item(F), "Finding ~w: the system confirms it, on ~w (~w, by ~w).", [F, S, A, B])
           ;   term_text(P, PT), rsay(item(A), "~w: ~w, on ~w.", [A, PT, S])
           )),
    % D31 B9 (review of K-A, finding 11): a red run that a later run passed is not "fails now".
    eng_all(Eng, [K, M], ( attest(_, test_result, _, result(K, M, pass), _, _), discovery_system_evidence(K) ), Ps0),
    forall(member(K-N, Fs),
           (   findall(M, ( member([K, M], Ps0), M > N ), Ms), Ms \== []
           ->  max_list(Ms, M1),
               rsay(item(K), "Check ~w failed on the current system in run ~w; a later run passed (run ~w).", [K, N, M1])
           ;   rsay(item(K), "Check ~w failed on the current system (run ~w).", [K, N])
           )).

% findings_section(+Eng) (D31 B6): each finding, marked as from the system or from a model only.
findings_section(Eng) :-
    rhead('Findings'),
    eng_all(Eng, [F, W, From], finding(F, W, From), Fs),
    (   Fs == [] -> rsay(none, "None.", []) ; true ),
    forall(member([F, W, From], Fs),
           ( (   compound(W), compound_name_arguments(W, Kind, [Arg]) -> plain_text(Arg, AT)
             ;   Kind = finding, plain_text(W, AT) ),
             (   From == system -> Mark = "From the system."
             ;   eng_true(Eng, finding_confirmed(F)) -> Mark = "From a model, and the system confirms it."
             ;   Mark = "From a model only. It is a lead until the system confirms it."
             ),
             format(string(Head), "~w **~w**: ~w", [F, Kind, AT]),
             as_sentence(AT, ATS),
             format(string(Plain), "~w (~w): ~w ~w", [F, Kind, ATS, Mark]),
             rtree(item(F), Plain, Head-[Mark-[]]) )).

% scope_sections(+KB, +Eng) (D31 B6): Scope, Risk and Not explored, in a KB that uses discovery
% or that holds such facts.
scope_sections(KB, Eng) :-
    eng_all(Eng, [W, T], scope(W, T), Ss),
    eng_all(Eng, [R, RT], risk(R, RT), Rs),
    eng_all(Eng, [N], not_explored(N), Ns),
    (   ( has_discovery(KB) ; Ss \== [] ; Rs \== [] ; Ns \== [] )
    ->  rhead('Scope'),
        (   Ss == [] -> rsay(none, "None. No scope is recorded.", []) ; true ),
        forall(member(W-_, [in-"In", out-"Out"]),
               forall(member([W, T], Ss),
                      ( memberchk(W-L, [in-"In", out-"Out"]), txt(T, TT), rsay(scope, "~w: ~w", [L, TT]) ))),
        rhead('Risk'),
        (   Rs == [] -> rsay(none, "None. No risk is recorded.", []) ; true ),
        forall(member([R, RT], Rs), ( txt(RT, RTT), rsay(item(R), "~w: ~w", [R, RTT]) )),
        rhead('Not explored'),
        (   Ns == [] -> rsay(none, "None is recorded. Say what you did not explore.", []) ; true ),
        forall(member(N, Ns), ( txt(N, NT), rsay(not_explored, "~w", [NT]) ))
    ;   true
    ).

% signals_section(+KB, +Eng) (D35 S3, c_k_g_4b): the Signals field from every record of a
% signal: the signal/4 facts, the divergence attestations, and the burns (a universal claim, a
% proof that the human asked for, a claim that was contested twice and is not visual). "no" only
% for a kind with no record; "yes" with one nested line for each record, with who noticed it.
% Then each lean back (D35 S2).
signals_section(KB, Eng) :-
    rhead('Signals'),
    eng_all(Eng, [S, Kd, By, Tx], signal(S, Kd, By, Tx), Sigs),
    eng_all(Eng, [A, Tg, AB], attest(A, divergence, _, Tg, AB, _), Dvs),
    burn_records(KB, Eng, Burns),
    forall(member(Kd-Label, [questions-"questions", divergence-"divergence", built_by_other-"someone else built",
                             burn-"burns", handoff-"handoff", effort-"effort"]),
           ( findall(L, signal_record(Kd, Sigs, Dvs, Burns, L), Ls),
             (   Ls == []
             ->  rsay(signal(Kd), "~w: no.", [Label])
             ;   format(string(Head), "~w: yes.", [Label]),
                 findall(L-[], member(L, Ls), Kids),
                 atomic_list_concat(Ls, ' ', LT),
                 format(string(Plain), "~w ~w", [Head, LT]),
                 rtree(signal(Kd), Plain, Head-Kids)
             ) )),
    eng_all(Eng, [LB, LT2], lean_back(LB, LT2), LBs),
    forall(member([LB, LT2], LBs),
           ( one_line(LT2, LTT), rsay(lean_back(LB), "Leaning back (~w): ~w", [LB, LTT]) )).

signal_record(Kd, Sigs, _, _, L) :-
    member([S, Kd, By, Tx], Sigs),
    one_line(Tx, T0), strip_period(T0, T1),
    noticer(By, BW),
    format(string(L), "~w: ~w (noticed by ~w).", [S, T1, BW]).
signal_record(divergence, _, Dvs, _, L) :-
    member([A, Tg, AB], Dvs),
    (   Tg =.. [K, X] -> format(string(On), "~w ~w", [K, X]) ; term_text(Tg, On) ),
    noticer(AB, BW),
    format(string(L), "~w: a divergence on ~w (attested by ~w).", [A, On, BW]).
signal_record(burn, _, _, Burns, L) :-
    member(C-Why, Burns),
    format(string(L), "~w: ~w", [C, Why]).

noticer(agent, "the agent") :- !.
noticer(human, "the human") :- !.
noticer(system1, "System 1") :- !.
noticer(script, "a script") :- !.
noticer(X, X).

strip_period(T, S) :-
    (   sub_string(T, B, 1, 0, ".") -> sub_string(T, 0, B, _, S) ; S = T ).

% burn_records(+KB, +Eng, -Burns): C-Why for each claim with a reason to burn (as burn_reason/1
% of the build module; without build, a contested claim is not checked for visual/1).
burn_records(KB, Eng, Burns) :-
    eng_all(Eng, [C1], universal(C1), Us),
    (   has_build(KB)
    ->  eng_all(Eng, [C2], burn_requested(C2), Rs),
        eng_all(Eng, [C3], ( contested_twice(C3), not(visual(C3)) ), Ts)
    ;   Rs = [], eng_all(Eng, [C3], contested_twice(C3), Ts)
    ),
    findall(C-W, ( member(C, Us), W = "the claim is universal (about every input)."
                 ; member(C, Rs), W = "the human asked for a proof."
                 ; member(C, Ts), W = "the claim was contested twice." ), Burns).

% formal_section(+Eng, +Cs) (D31 B3): the formal statement of each current claim that has one,
% beside its plain sentence; or "None." B4 and B5 add the statements.
formal_section(KB, Eng, Cs) :-
    rhead('Formal'),
    findall(C-Items, ( member([C, _, _], Cs), formal_items(KB, Eng, C, Items), Items \== [] ), CIs),
    (   CIs == []
    ->  rsay(none, "None. No claim has a formal statement.", [])
    ;   forall(member(C-Items, CIs),
               ( memberchk([C, _, T], Cs), txt(T, TT), as_sentence(TT, TS),
                 forall(member(Head, Items),
                        ( format(string(Kid), "Claim ~w: ~w", [C, TS]),
                          format(string(Plain), "~w ~w", [Head, Kid]),
                          rtree(item(C), Plain, Head-[Kid-[]]) )) ))
    ).

% formal_items(+KB, +Eng, +C, -Heads): one line per formal statement of claim C: the theorem of
% its Lean proof with the statement from the proof log (B4), and with the discovery module each
% model that states it, with its property (B5).
formal_items(KB, Eng, C, Heads) :-
    findall(H, formal_item(KB, Eng, C, H), Heads).

formal_item(_, Eng, C, H) :-
    proof_statement(Eng, C, A, Thm, St),
    format(string(H), "~w: theorem ~w (Lean, proof ~w): ~w", [C, Thm, A, St]).
formal_item(KB, Eng, C, H) :-
    has_discovery(KB),
    eng_all(Eng, [M, Tool], ( encodes(M, C), model(M, Tool) ), MTs),
    member([M, Tool], MTs),
    eng_all(Eng, [P], property(M, C, P), Ps),
    (   Ps == []
    ->  format(string(H), "~w: model ~w (~w) states it. No property is recorded: add property(~w, ~w, TEXT).", [C, M, Tool, M, C])
    ;   member(P, Ps), txt(P, PT),
        format(string(H), "~w: model ~w (~w), property: ~w", [C, M, Tool, PT])
    ).

% hypothesis_section(+Eng) (D31 B1): the current hypothesis of the ticket, with its premises
% beside it, or "Premises: none" (D30 H2). A superseded hypothesis is not current.
hypothesis_section(Eng) :-
    rhead('Hypothesis'),
    eng_all(Eng, [H, K, T], ( hypothesis(H, K, T), not(superseded(H)) ), Hs),
    (   Hs == []
    ->  rsay(none, "None. No hypothesis is recorded. Every ticket has one: add hypothesis(H, KIND, TEXT).", [])
    ;   true
    ),
    forall(member([H, K, T], Hs),
           ( one_line(T, TT),
             premise_lines(Eng, H, PLs),
             format(string(Head), "~w **~w**: ~w", [H, K, TT]),
             as_sentence(TT, TS),
             atomic_list_concat(PLs, ' ', PT),
             format(string(Plain), "~w (~w): ~w ~w", [H, K, TS, PT]),
             findall(L-[], member(L, PLs), Kids),
             rtree(item(H), Plain, Head-Kids) )).

% one_line(+Text, -S) (D31 B8, review of K-A finding 12): the text with each run of white space,
% a line break too, as one space, so that a text never breaks the bullets of the report.
one_line(T, S) :- txt(T, T0), normalize_space(string(S), T0).

% premise_lines(+Eng, +H, -Lines) (D30 H2, D31 B1): one sentence per premise of hypothesis H
% with its state, or "Premises: none.", or a pointer to lint W10.
premise_lines(Eng, H, Lines) :-
    eng_all(Eng, [P, PT], premise(P, H, PT), Ps),
    (   Ps \== []
    ->  findall(L, ( member([P, PT], Ps), one_line(PT, PTT), as_sentence(PTT, PTS),
                     (   eng_all(Eng, [W], premise_checked(P, W), [W1|_])
                     ->  one_line(W1, WT), format(string(L), "Premise ~w: ~w Checked on the system at ~w.", [P, PTS, WT])
                     ;   format(string(L), "Premise ~w: ~w Not checked.", [P, PTS])
                     ) ), Lines0),
        % D31 B7 (review of K-A, finding 9): a premise and the record "Premises: none" conflict.
        (   eng_true(Eng, no_premises(H))
        ->  append(Lines0, ["Premises: none is also recorded, and it conflicts with the premises (lint W11)."], Lines)
        ;   Lines = Lines0
        )
    ;   eng_true(Eng, no_premises(H))
    ->  Lines = ["Premises: none."]
    ;   Lines = ["Premises: not stated. Add premise(P, H, TEXT) or no_premises(H) (lint W10)."]
    ).

% review_section(+Eng, +Cs) (D28): for each current claim, its latest
% verdict (the last in kb.pl) with the actor and the runs it rests on;
% then the claims that are not independently verified.
review_section(Eng, Cs) :-
    rhead('Review'),
    eng_all(Eng, [V, C, P], attest(V, disproof, _, verdict(C, P), _, _), Vs),
    (   Cs == [] -> rsay(none, "No current claims.", []) ; true ),
    forall(member([C, _, _], Cs),
           (   findall(V-P, member([V, C, P], Vs), VPs),
               (   VPs == []
               ->  rsay(item(C), "~w: no verdict.", [C])
               ;   last(VPs, V-P),
                   ( eng_all(Eng, [R, S], actor(V, R, S), [[R, S]|_]) -> true ; R = unknown, S = unknown ),
                   (   compound(P), compound_name_arguments(P, Kind, [Arg])
                   ->  plain_text(Arg, AT), as_sentence(AT, ATS),
                       format(string(Head), "~w: reviewer ~w (session ~w), verdict ~w: ~w", [C, R, S, Kind, ATS])
                   ;   format(string(Head), "~w: reviewer ~w (session ~w), verdict ~w.", [C, R, S, P])
                   ),
                   eng_all(Eng, [A, K, N, Res], ( rests_on_run(V, A), attest(A, test_result, _, result(K, N, Res), _, _) ), Rs),
                   (   Rs == [] -> Kid = "Reruns: none."
                   ;   findall(X, ( member([_, K, N, Res], Rs), format(string(X), "run ~w ~w ~w", [N, K, Res]) ), Xs),
                       atomic_list_concat(Xs, ', ', XT), format(string(Kid), "Reruns: ~w.", [XT])
                   ),
                   format(string(Plain), "~w ~w", [Head, Kid]),
                   rtree(item(C), Plain, Head-[Kid-[]])
               ) )),
    eng_all(Eng, [C1], ( current(C1), not(independently_verified(C1)) ), NV0),
    findall(C2, ( member([C2, _, _], Cs), memberchk(C2, NV0) ), NVs),
    (   NVs == []
    ->  ( Cs == [] -> true ; rsay(none, "Every current claim is independently verified.", []) )
    ;   atomic_list_concat(NVs, ', ', NVT),
        rsay(review_open, "Not independently verified: ~w.", [NVT])
    ).

% ropen(+Tag, +Label, +Fmt, +Args): an item of the Open section, with its kind in bold.
ropen(Tag, Label, Fmt, Args) :-
    format(string(S), Fmt, Args),
    split_first(S, First, Rest),
    format(string(Head), "**~w**: ~w", [Label, First]),
    ( Rest == "" -> Kids = [] ; Kids = [Rest-[]] ),
    rtree(Tag, S, Head-Kids).

% rsplit(+Tag, +Fmt, +Args): a bullet of its first sentence, with the
% other sentences as one nested bullet.
rsplit(Tag, Fmt, Args) :-
    format(string(S), Fmt, Args),
    split_first(S, First, Rest),
    ( Rest == "" -> Kids = [] ; Kids = [Rest-[]] ),
    rtree(Tag, S, First-Kids).

% split_first(+S, -First, -Rest): the first sentence of S, without its
% final period, and the rest of S ("" when there is none).
split_first(S, First, Rest) :-
    (   sub_string(S, B, 2, A, ". "), A > 0
    ->  sub_string(S, 0, B, _, First), sub_string(S, _, A, 0, Rest)
    ;   sub_string(S, _, 1, 0, ".")
    ->  sub_string(S, 0, _, 1, First), Rest = ""
    ;   First = S, Rest = ""
    ).

% join_sentences(+A, +B, -S): A, and B after a space when B is not empty.
join_sentences(A, B, S) :-
    (   B == "" -> S = A ; format(string(S), "~w ~w", [A, B]) ).

% ---------------------------------------------------------------------
% report --html (D16): the delivery report as one page
% ---------------------------------------------------------------------
% The page is built from the records of report_text/2 (report_rec/2),
% plus evidence read from facts, and the verdict of done. It derives no
% other status itself. The page cannot write to the KB: review marks stay in
% the browser (localStorage) and leave it as text that the reviewer
% pastes back.

report_page(KB, Eng, Html, Open, Code) :-
    findall(Tag-S, report_rec(Tag, S), Recs),
    findall(S, report_line(S), Lines),
    atomic_list_concat(Lines, '\n', T0), string_concat(T0, "\n", Text),
    sha256_text(Text, Digest),
    (   has_build(KB)
    ->  eng_all(Eng, [], done, DL), ( DL \== [] -> Done = yes ; Done = no )
    ;   Done = none
    ),
    page_assets(Css, Js),
    absolute_file_name(Html, Abs),
    with_output_to(string(Page),
                   page_write(KB, Eng, Recs, Text, Digest, Done, Css, Js)),
    catch(setup_call_cleanup(open(Abs, write, Out, [encoding(utf8)]),
                             write(Out, Page),
                             close(Out)),
          E, ( err_text(E, M),
               die(2, ["Cannot write the page " + Abs + ": " + M,
                       "Fix: give a path in a directory that exists and that you can write."] >> fix_lines) )),
    format(user_error, "HTML written to ~w~n", [Abs]),
    ( Open == true -> open_page(Abs) ; true ),
    Code = 0.

% page_assets(-Css, -Js): the style and the script of the page, from the
% library (report/page.css, report/page.js). They are inlined.
page_assets(Css, Js) :-
    lib_dir(Lib),
    maplist(page_asset(Lib), ['report/page.css', 'report/page.js'], [Css, Js]).

page_asset(Lib, Rel, Text) :-
    directory_file_path(Lib, Rel, F),
    (   exists_file(F)
    ->  read_file_to_string(F, Text, [encoding(utf8)])
    ;   die(2, ["The library has no " + Rel + " (" + F + ").",
                "Fix: check ORBIT_KB_LIB, or run install.py again."] >> fix_lines)
    ).

% open_page(+File): --open. xdg-open, else open. It does not wait.
open_page(File) :-
    (   member(Exe, ['xdg-open', open]),
        absolute_file_name(path(Exe), P, [access(execute), file_errors(fail)])
    ->  catch(( process_create(P, [File], [stdin(null), stdout(null), stderr(null),
                                           detached(true), process(_)]),
                format(user_error, "Opened the page with ~w.~n", [Exe]) ),
              E, ( err_text(E, M), format(user_error, "Could not open the page with ~w: ~w~n", [Exe, M]) ))
    ;   format(user_error, "Could not open the page: no xdg-open or open on PATH. Open ~w in a browser.~n", [File])
    ).

% --- HTML helpers. Every KB string goes through esc/2 or he/1.

esc(X, S) :-
    plain_text(X, T0),
    string_codes(T0, Cs),
    html_esc_codes(Cs, Es),
    string_codes(S, Es).

html_esc_codes([], []).
html_esc_codes([C|Cs], Out) :-
    (   html_esc_code(C, E)
    ->  string_codes(E, ECs), append(ECs, Rest, Out)
    ;   Out = [C|Rest]
    ),
    html_esc_codes(Cs, Rest).

html_esc_code(0'&, "&amp;").
html_esc_code(0'<, "&lt;").
html_esc_code(0'>, "&gt;").
html_esc_code(0'", "&quot;").
html_esc_code(0'', "&#39;").

he(X) :- esc(X, S), write(S).

% file_url(+Path, -Url): a file:// URL, percent-encoded as a URI path.
file_url(Path, Url) :-
    use_module(library(uri)),
    uri_encoded(path, Path, Enc),
    atom_concat('file://', Enc, Url).

strip_dash(S0, S) :- ( sub_string(S0, 0, 2, _, "- ") -> sub_string(S0, 2, _, 0, S) ; S = S0 ).
trim_lead(S0, S) :- ( sub_string(S0, 0, 1, _, " ") -> sub_string(S0, 1, _, 0, S) ; S = S0 ).

status_glyph(fulfilled, "&#10003;").
status_glyph(under, "&#10007;").
status_glyph(waived, "&#9684;").
status_glyph(none, "&#8211;").

% mark_box(+Key): the review marks of one item. Items with the same key
% share one mark.
mark_box(Key) :-
    esc(Key, K),
    format("<div class=\"mark\" role=\"group\" aria-label=\"Review of ~w\" data-key=\"~w\">", [K, K]),
    forall(member(M, [ok, doubt, wrong]),
           format("<button type=\"button\" data-mark=\"~w\" aria-pressed=\"false\">~w</button>", [M, M])),
    format("<input type=\"text\" maxlength=\"300\" placeholder=\"Note (optional)\" aria-label=\"Note on ~w\">", [K]),
    format("</div>~n", []).

% records of one section: the records after head(Name), up to the next head
section_recs(Recs, Name, Out) :-
    (   append(_, [head(Name)-_|After], Recs)
    ->  ( append(Out, [head(_)-_|_], After) -> true ; Out = After )
    ;   Out = []
    ).

page_write(KB, Eng, Recs, Text, Digest, Done, Css, Js) :-
    kb_dir(KB, Dir),
    get_time(Now), format_time(string(When), "%FT%TZ", Now, posix),
    findall(C-SK, member(claim(C, _, _, SK, _, _, _)-_, Recs), CSKs),
    length(CSKs, NC),
    findall(K-N, ( member(K, [fulfilled, under, waived]),
                   aggregate_all(count, member(_-K, CSKs), N), N > 0 ), Counts),
    findall(C, member(C-under, CSKs), Unders),
    section_recs(Recs, 'Open', OpenRecs0),
    % D32 O1: the page lists the under claims from the claims, so it skips their Open items.
    exclude([T-_]>>(T = open(under, _, _)), OpenRecs0, OpenRecs),
    findall(X, ( member(X-_, OpenRecs), X = open(_, _, _) ), OpenItems),
    length(Unders, NU), length(OpenItems, NO),
    NOpen is NU + NO,
    format("<!doctype html>~n<html lang=\"en\">~n<head>~n<meta charset=\"utf-8\">~n", []),
    format("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">~n", []),
    format("<meta name=\"generator\" content=\"orbit-kb report --html\">~n", []),
    file_base_name(Dir, Base),
    format("<title>Delivery report: ", []), he(Base), format("</title>~n<style>~n~w</style>~n</head>~n", [Css]),
    esc(Dir, DirE), esc(Digest, DigE),
    format("<body data-kb=\"~w\" data-digest=\"~w\">~n<div class=\"wrap\">~n", [DirE, DigE]),
    % header
    format("<header class=\"top\">~n<h1>Delivery report</h1>~n", []),
    eng_all(Eng, [R, RT], request(R, RT), Rqs),
    forall(member([R, RT], Rqs),
           ( format("<p class=\"request\"><span class=\"id\">", []), he(R),
             format("</span> ", []), he(RT), format("</p>~n", []) )),
    format("<p class=\"meta\">KB <code>~w</code><br>Written ~w. Report <code title=\"~w\">", [DirE, When, DigE]),
    sub_string(Digest, 7, 12, _, DShort), he(DShort),
    format("</code></p>~n<ul class=\"chips\" aria-label=\"Summary\">~n", []),
    plural(NC, PC), format("<li class=\"chip\">~w claim~w</li>~n", [NC, PC]),
    forall(member(K-N, Counts),
           ( status_glyph(K, G),
             format("<li class=\"chip st-~w\"><span aria-hidden=\"true\">~w</span> ~w ~w</li>~n", [K, G, N, K]) )),
    (   NOpen =:= 0
    ->  format("<li class=\"chip st-fulfilled\">nothing open</li>~n", [])
    ;   plural(NOpen, PO),
        format("<li class=\"chip st-under\"><a href=\"#open\">~w open item~w</a></li>~n", [NOpen, PO])
    ),
    (   Done \== none
    ->  ( Done == yes -> DoneT = "done: yes", DoneK = fulfilled ; DoneT = "done: no", DoneK = under ),
        format("<li class=\"chip st-~w\">~w</li>~n", [DoneK, DoneT])
    ;   true
    ),
    format("</ul>~n", []),
    format("<p class=\"tools\"><button type=\"button\" id=\"expand-all\">Show all evidence</button></p>~n", []),
    format("</header>~n<main>~n", []),
    % open items first
    format("<section data-section=\"open\" id=\"open\" aria-labelledby=\"h-open\">~n<h2 id=\"h-open\">Open: needs a decision or more work</h2>~n", []),
    (   NOpen =:= 0
    ->  format("<p class=\"empty\">Nothing is open.</p>~n", [])
    ;   format("<ul class=\"open\">~n", []),
        forall(member(claim(C, L, TT, under, St0, BT, _)-_, Recs),
               ( esc(C, CE),
                 format("<li data-open=\"under\" data-ref=\"~w\"><span class=\"badge st-under\">under</span> <a href=\"#claim-~w\">Claim ~w</a> (", [CE, CE, CE]),
                 he(L), format("): ", []), he(TT), format(". ", []),
                 trim_lead(St0, St1), he(St1), he(BT),
                 format("~n", []), mark_box(C), format("</li>~n", []) )),
        forall(member(open(Kind, Ref, Tgt)-S, OpenRecs),
               ( esc(Ref, RE), open_label(Kind, Lab),
                 format("<li data-open=\"~w\" data-ref=\"~w\"><span class=\"badge st-under\">~w</span> ", [Kind, RE, Lab]),
                 strip_dash(S, S1), he(S1),
                 open_link(Eng, Recs, Kind, Ref, Tgt),
                 format("~n", []), mark_box(Ref), format("</li>~n", []) )),
        format("</ul>~n", [])
    ),
    format("</section>~n", []),
    % D31 B3: the fields of the delivery block before the claims; B1: the hypothesis
    page_list(Recs, 'KB', kb, "KB", ""),
    page_list(Recs, 'Signals', signals, "Signals", ""),
    page_list(Recs, 'Hypothesis', hypothesis, "Hypothesis", "What must be true when the ticket is done, with its premises. Say if it is wrong."),
    (   has_discovery(KB)
    ->  page_list(Recs, 'System', system, "System", "What the current system showed."),
        page_list(Recs, 'Findings', findings, "Findings", "Each finding, from the system or from a model only.")
    ;   true
    ),
    % claims
    format("<section data-section=\"claims\" id=\"claims\" aria-labelledby=\"h-claims\">~n<h2 id=\"h-claims\">Claims</h2>~n", []),
    (   NC =:= 0 -> format("<p class=\"empty\">No current claims.</p>~n", []) ; true ),
    forall(member(claim(C, L, TT, SK, St0, BT, KStates)-_, Recs),
           page_claim(KB, Eng, C, L, TT, SK, St0, BT, KStates)),
    format("</section>~n", []),
    % the other sections, from the text lines
    page_list(Recs, 'Formal', formal, "Formal", "The formal statement of each claim that has one, beside its plain sentence."),
    forall(member(SN-SI, ['Scope'-scope, 'Risk'-risk, 'Not explored'-not_explored]),
           ( memberchk(head(SN)-_, Recs) -> page_list(Recs, SN, SI, SN, "") ; true )),
    page_list(Recs, 'Guesses', guesses, "Guesses", "Defaults that no human answered, and premises that nobody checked. Say if one is wrong."),
    page_list(Recs, 'Disclosures', disclosures, "Disclosures", ""),
    (   has_build(KB) -> page_list(Recs, 'Waivers', waivers, "Waivers", "") ; true ),
    page_list(Recs, 'Not checked', not_checked, "Not checked", ""),
    (   has_discovery(KB) -> page_list(Recs, 'Vote', vote, "Vote", "") ; true ),
    format("<section data-section=\"text\" id=\"text\">~n<h2>Plain text</h2>~n<details><summary>The text of orbit-kb report</summary>~n<pre class=\"text\">", []),
    he(Text),
    format("</pre>~n</details>~n</section>~n</main>~n</div>~n", []),
    % review bar
    format("<footer class=\"review\" id=\"review\" aria-label=\"Review\">~n<div class=\"inner\">~n", []),
    format("<span id=\"review-count\" aria-live=\"polite\">No marks yet.</span>~n", []),
    format("<button type=\"button\" id=\"review-copy\">Copy review for the agent</button>~n", []),
    format("<button type=\"button\" id=\"review-clear\">Clear marks</button>~n", []),
    format("<span id=\"review-msg\" role=\"status\"></span>~n", []),
    format("<textarea id=\"review-text\" rows=\"5\" spellcheck=\"false\" aria-label=\"Review text to paste to the agent\" hidden></textarea>~n", []),
    format("</div>~n</footer>~n<script>~n~w</script>~n</body>~n</html>~n", [Js]).

plural(N, S) :- ( N =:= 1 -> S = "" ; S = "s" ).

% open_label(+Kind, -Label): the badge of an open item; another kind (D32 O1: any kind of
% blocking/1) gets its name with spaces.
open_label(K, L) :-
    (   open_label0(K, L0) -> L = L0
    ;   atomic_list_concat(Ws, '_', K), atomic_list_concat(Ws, ' ', L)
    ).
open_label0(no_claim, "no claim").
open_label0(to_ask, "ask").
open_label0(stale, "stale").
open_label0(supersede_cycle, "cycle").
open_label0(over, "over").
open_label0(burn_open, "burn open").
open_label0(flare_open, "flare open").
open_label0(waiver_lapsed, "waiver lapsed").
open_label0(proof_changed, "proof changed").
open_label0(question_waits, "waits").
open_label0(refuted, "refuted").
open_label0(discovery_ready, "not ready").
open_label0(stale_pin, "stale pin").

% open_link: a link to the claim that an open item is about, when the
% claim is on the page.
open_link(Eng, Recs, Kind, Ref, Tgt) :-
    (   Kind == to_ask, eng_all(Eng, [C], question(Ref, C, _), [C1|_]) -> T = C1
    ;   Tgt \== none -> T = Tgt
    ;   T = none
    ),
    (   T \== none, memberchk(claim(T, _, _, _, _, _, _)-_, Recs)
    ->  esc(T, TE), format(" <a href=\"#claim-~w\">See claim ~w.</a>", [TE, TE])
    ;   true
    ).

% page_list: a section of the text report as a list, one item per line,
% with marks on items that have an id.
page_list(Recs, Head, Id, Title, Lead) :-
    section_recs(Recs, Head, Rs),
    format("<section data-section=\"~w\" id=\"~w\" aria-labelledby=\"h-~w\">~n<h2 id=\"h-~w\">~w</h2>~n", [Id, Id, Id, Id, Title]),
    (   Lead \== "", member(item(_)-_, Rs) -> format("<p class=\"lead\">~w</p>~n", [Lead]) ; true ),
    format("<ul class=\"items\">~n", []),
    forall(member(Tag-S, Rs),
           ( strip_dash(S, S1),
             (   Tag = item(X)
             ->  format("<li>", []), he(S1),
                 (   Head == 'Not checked' -> esc(X, XE), format(" <a href=\"#claim-~w\">See claim ~w.</a>", [XE, XE]) ; true ),
                 format("~n", []), mark_box(X), format("</li>~n", [])
             ;   format("<li class=\"plain\">", []), he(S1), format("</li>~n", [])
             ) )),
    format("</ul>~n</section>~n", []).

% page_claim: one claim, its status as the text report says it, and its
% evidence.
page_claim(KB, Eng, C, L, TT, SK, St0, BT, KStates) :-
    esc(C, CE),
    eng_all(Eng, [D, B, Tm], attest(D, divergence, _, claim(C), B, Tm), Dvs),
    % The evidence starts open when the claim needs attention.
    (   SK \== fulfilled -> Det = " open"
    ;   sub_string(BT, _, _, _, "A Lean proof is required") -> Det = " open"
    ;   sub_string(BT, _, _, _, "owes a formal statement") -> Det = " open"
    ;   sub_string(BT, _, _, _, "must approve a demo") -> Det = " open"
    ;   Dvs \== [] -> Det = " open"
    ;   Det = ""
    ),
    format("<article class=\"claim\" id=\"claim-~w\" data-claim=\"~w\" data-status=\"~w\">~n", [CE, CE, SK]),
    status_glyph(SK, G),
    format("<div class=\"chead\"><span class=\"id\">~w</span> <span class=\"label\">", [CE]), he(L),
    format("</span> <span class=\"badge st-~w\"><span aria-hidden=\"true\">~w</span>~w</span>", [SK, G, SK]),
    (   BT == "" ; \+ eng_true(Eng, burn(C)) -> true
    ;   eng_true(Eng, burn_proved(C)) -> format(" <span class=\"badge st-fulfilled\">burn proved</span>", [])
    ;   eng_true(Eng, burn_waived(C)) -> format(" <span class=\"badge st-waived\">burn not proved, waived</span>", [])
    ;   format(" <span class=\"badge st-under\">burn not proved</span>", [])
    ),
    (   BT == "" ; \+ eng_true(Eng, flare(C)) -> true
    ;   eng_true(Eng, flare_shown(C)) -> format(" <span class=\"badge st-fulfilled\">flare shown</span>", [])
    ;   eng_true(Eng, flare_waived(C)) -> format(" <span class=\"badge st-waived\">flare not shown, waived</span>", [])
    ;   format(" <span class=\"badge st-under\">flare not shown</span>", [])
    ),
    format("</div>~n<p class=\"ctext\">", []), he(TT), format("</p>~n", []),
    (   St0 == "" -> true
    ;   trim_lead(St0, S1), format("<p class=\"sentence\">", []), he(S1),
        ( BT == "" -> true ; format(" ", []), trim_lead(BT, B1), he(B1) ),
        format("</p>~n", [])
    ),
    % checks, with the latest run of each
    (   KStates == []
    ->  format("<p class=\"checks\">Checks: none.</p>~n", [])
    ;   format("<ul class=\"checks\" aria-label=\"Checks\">~n", []),
        forall(member(K-KS, KStates), page_check(KB, Eng, K, KS)),
        format("</ul>~n", [])
    ),
    format("<details class=\"evidence\"~w><summary>Evidence</summary>~n<div class=\"ev\">~n", [Det]),
    eng_all(Eng, [X], cites(C, X), Xs),
    ev_list("Cites", Xs, [X1]>>he(X1)),
    eng_all(Eng, [X], example(C, X), Es),
    ev_list("Examples", Es, [X1]>>he(X1)),
    ev_list("Divergences", Dvs, ev_divergence(Eng)),
    eng_all(Eng, [Q, QT], question(Q, C, QT), Qs),
    findall(S0, ( S0 = C ; member([S0, _], Qs) ), Subjs),
    findall([I, P, B, Tm], ( member(S0, Subjs), eng_all(Eng, [I, P, B, Tm], attest(I, disclosure, S0, P, B, Tm), L0), member([I, P, B, Tm], L0) ), Dcs),
    ev_list("Disclosures", Dcs,
            [[I1, P1, B1, Tm1]]>>( format("<span class=\"id\">", []), he(I1), format("</span> ", []), he(P1),
                                   format(", by ", []), he(B1), format(" at ", []), he(Tm1), format(".", []) )),
    (   has_build(KB)
    ->  findall(T0, ( T0 = C ; member(K-_, KStates), T0 = K ), Tgts),
        findall([W, T0, Due, Why, B], ( member(T0, Tgts),
                                        eng_all(Eng, [W, Due, Why, B], attest(W, waiver, _, waive(T0, Due, Why), B, _), L1),
                                        member([W, Due, Why, B], L1) ), Wvs),
        ev_list("Waivers", Wvs, ev_waiver(Eng))
    ;   true
    ),
    ev_list("Questions", Qs, ev_question(Eng)),
    eng_all(Eng, [N], note(C, N), CNs),
    ev_list("Notes", CNs, [X1]>>he(X1)),
    format("</div>~n</details>~n", []),
    mark_box(C),
    format("</article>~n", []).

ev_divergence(Eng, [D, B, Tm]) :-
    format("<span class=\"id\">", []), he(D), format("</span> by ", []), he(B),
    format(" at ", []), he(Tm), format(".", []),
    eng_all(Eng, [N], note(D, N), Ns),
    forall(member(N1, Ns), ( format(" ", []), he(N1) )).

ev_waiver(Eng, [W, T, Due, Why, B]) :-
    format("<span class=\"id\">", []), he(W), format("</span> waives ", []), he(T),
    format(" until ", []), he(Due), format(": ", []), he(Why), format(" (", []),
    (   B \== human -> format("it does not count: a human did not write it", [])
    ;   eng_true(Eng, waiver_lapsed(W)) -> format("<strong>lapsed</strong>", [])
    ;   format("in force", [])
    ),
    format(").", []).

ev_question(Eng, [Q, QT]) :-
    format("<span class=\"id\">", []), he(Q), format("</span> ", []), he(QT),
    plain_text(QT, QTS),
    ( sub_string(QTS, _, 1, 0, E), sub_atom(".?!", _, 1, _, E) -> true ; format(".", []) ),
    eng_all(Eng, [A], assumed(Q, A), As),
    forall(member(A1, As), ( format(" Default: ", []), he(A1), format(".", []) )),
    eng_all(Eng, [A, Wr], answer(Q, A, Wr), Ans),
    forall(member([A2, Wr2], Ans), ( format(" Answer by ", []), he(Wr2), format(": ", []), he(A2), format(".", []) )).

ev_list(_, [], _) :- !.
ev_list(Title, Xs, Goal) :-
    format("<h3>~w</h3>~n<ul>~n", [Title]),
    forall(member(X, Xs), ( format("<li>", []), call(Goal, X), format("</li>~n", []) )),
    format("</ul>~n", []).

% page_check: one check, with its state as the text report says it, and
% its latest run: number, result, time, and log.
page_check(KB, Eng, K, KS) :-
    esc(K, KE),
    eng_all(Eng, [N, R, Tm], attest(_, test_result, _, result(K, N, R), _, Tm), Runs0),
    findall(N-[R, Tm], ( member([N, R, Tm], Runs0), integer(N) ), Runs1),
    keysort(Runs1, Runs),
    length(Runs, NR),
    (   last(Runs, N-[R, Tm])
    ->  format("<li data-check=\"~w\" data-run=\"~w\" data-result=\"~w\">", [KE, N, R]),
        ( R == pass -> RK = fulfilled ; RK = under ),
        format("<span class=\"id\">~w</span> ~w. Latest run ~w: <span class=\"badge st-~w\">~w</span> at ", [KE, KS, N, RK, R]),
        he(Tm),
        ( NR > 1 -> format(" (~w runs)", [NR]) ; true ),
        format(". Log ", []),
        run_log_path(KB, K, N, Abs),
        format(atom(Rel), "runs/~w-~w.log", [N, K]),
        (   exists_file(Abs)
        ->  file_url(Abs, U), esc(U, UE), format("<a href=\"~w\"><code>", [UE]), he(Rel), format("</code></a>.", [])
        ;   format("<code>", []), he(Rel), format("</code> (missing).", [])
        )
    ;   format("<li data-check=\"~w\" data-run=\"none\" data-result=\"none\"><span class=\"id\">~w</span> ~w.", [KE, KE, KS])
    ),
    format("</li>~n", []).

% ---------------------------------------------------------------------
% doctor
% ---------------------------------------------------------------------

% Known-answer programs for the self-tests. Each runs on the SWI engine,
% as a query does.
doctor_neg_helper("under(a).\nany_under :- under(_).\ndone :- not any_under.\n").
doctor_neg_anon("under(a).\ndone :- not under(_).\n").
doctor_arith("attest(r1, test_result, k1, result(k1, 1, pass), script, t).\nattest(r2, test_result, k1, result(k1, 2, fail), script, t).\nattest(r3, test_result, k2, result(k2, 3, fail), script, t).\nattest(r4, test_result, k2, result(k2, 4, pass), script, t).\nattest(r5, test_result, k3, result(k3, 5, pass), script, t).\nattest(r6, test_result, k4, result(k4, 6, pass), script, t).\nattest(r7, test_result, k4, result(k4, 7, fail), script, t).\nattest(r8, test_result, k4, result(k4, 8, pass), script, t).\npassed(K) :- attest(_, test_result, _, result(K, R, pass), _, _), not failed_after(K, R).\nfailed_after(K, R) :- attest(_, test_result, _, result(K, R2, fail), _, _), R2 > R.\n").
doctor_unstratified("p :- not q.\nq :- not p.\n").
doctor_classical("p(a).\n-p(b).\n").

cmd_doctor(Args, Code) :-
    parse_opts(Args, [], Pos, _),
    ( Pos == [] -> true ; usage_error("doctor takes no arguments.", []) ),
    current_prolog_flag(version, V),
    VMaj is V // 10000, VMin is (V // 100) mod 100, VPat is V mod 100,
    current_prolog_flag(executable, SwiExe),
    (   absolute_file_name(path(swipl), SwiPath, [access(execute), file_errors(fail)])
    ->  say("ok    swipl: ~w (SWI-Prolog ~w.~w.~w; running as ~w).", [SwiPath, VMaj, VMin, VPat, SwiExe]), P1 = []
    ;   say("FAIL  swipl: not on PATH. This process runs ~w. Fix: put swipl on PATH.", [SwiExe]), P1 = [swipl]
    ),
    catch(( lib_dir(Lib), LibR = ok(Lib) ), orbit_error(_, Ls), ( atomic_list_concat(Ls, ' ', LT), LibR = bad(LT) )),
    (   LibR = ok(Lib)
    ->  lib_modules(Lib, Ms), atomic_list_concat(Ms, ', ', MT),
        say("ok    library: ~w (modules: ~w).", [Lib, MT]), P2 = []
    ;   LibR = bad(LT2),
        say("FAIL  library: ~w", [LT2]), P2 = [library]
    ),
    doctor_tests(Fails),
    append([P1, P2, Fails], All),
    (   All == []
    ->  say("Result: all checks passed.", []), Code = 0
    ;   length(All, NF), say("Result: ~w problem(s). Fix them before you trust orbit-kb.", [NF]), Code = 2
    ).

doctor_items(Name, Text, Items) :-
    read_source_string(test, Name, Text, Items).

% doctor_answers(+Name, +Text, +GoalText, -Result): ok(Answers) | failed(Message)
doctor_answers(Name, Text, GoalText, R) :-
    catch(( doctor_items(Name, Text, Items),
            parse_one(GoalText, ok(G, VN)),
            query_names(VN, _, Vars),
            build_engine(Items, [], Eng),
            swi_query(Eng, G, Vars, Res),
            (   Res = answers(L, _) -> sort(L, LS), R = ok(LS)
            ;   Res = error(M) -> R = failed(M)
            ) ),
          E, ( err_text(E, M), R = failed(M) )).

doctor_expect(Name, Text, GoalText, Want, What, F) :-
    doctor_answers(Name, Text, GoalText, R),
    sort(Want, WS),
    (   R = ok(WS)
    ->  say("ok    ~w.", [What]), F = []
    ;   R = ok(Got)
    ->  say("FAIL  ~w. Got ~q.", [What, Got]), F = [x]
    ;   R = failed(M),
        say("FAIL  ~w. Error: ~w", [What, M]), F = [x]
    ).

doctor_tests(Fails) :-
    doctor_neg_helper(T1),
    doctor_expect(neg1, T1, "done", [], "not with a helper rule: done must be false", F1),
    doctor_neg_anon(T2),
    doctor_expect(neg2, T2, "done", [], "not under(_) means no under at all: done must be false", F2),
    doctor_arith(T3),
    doctor_expect(arith, T3, "passed(K)", [[k2], [k3], [k4]], "arithmetic under not: passed(K) must be exactly k2, k3, k4", F3),
    doctor_unstratified(T4),
    doctor_items(e18, T4, I4),
    e18_diags(I4, [], D18),
    (   D18 \== []
    ->  say("ok    E18 flags rules that are not stratified (p :- not q, q :- not p).", []), F4 = []
    ;   say("FAIL  E18 does not flag p :- not q, q :- not p.", []), F4 = [e18]
    ),
    doctor_classical(T5),
    doctor_items(e17, T5, I5),
    findall(D, ( member(I, I5), e17_diags(I, D0), member(D, D0) ), D17),
    (   D17 \== []
    ->  say("ok    E17 flags classical negation (-p(b)).", []), F5 = []
    ;   say("FAIL  E17 does not flag -p(b).", []), F5 = [e17]
    ),
    append([F1, F2, F3, F4, F5], Fails).

% ---------------------------------------------------------------------
% help
% ---------------------------------------------------------------------

cmd_help([], 0) :- !,
    help_lines(general, Ls), print_lines(user_output, Ls).
cmd_help([C|_], Code) :-
    (   help_lines(C, Ls)
    ->  print_lines(user_output, Ls), Code = 0
    ;   help_topic_file(C, File)
    ->  read_file_to_string(File, S, [encoding(utf8)]),
        format("~s", [S]), Code = 0
    ;   usage_error("There is no help for ~w. It is not a command or a topic. Topics: ~w.", [C, 'core, build, discovery, project, codes, answers, shift'])
    ).

% A topic is the file help/TOPIC.txt in the library directory.
help_topic_file(Topic, File) :-
    memberchk(Topic, [core, build, discovery, project, codes, answers, shift]),
    lib_dir(Lib),
    atomic_list_concat([Lib, '/help/', Topic, '.txt'], File),
    exists_file(File).

help_general([
"orbit-kb: write, check, and query Prolog knowledge bases (KBs) with default negation (not p).",
"",
"How to use (read this first; the topics hold the details):",
"  1. orbit-kb init DIR --request 'the human's words' --uses MODULE",
"     MODULE: discovery when the request is not clear enough to state its hypothesis (a",
"     report); build when you can state it. Every ticket has a hypothesis.",
"  2. orbit-kb add \"hypothesis(h1, feature, 'TEXT')\" 'no_premises(h1)'   the hypothesis first,",
"     with its premises beside it (premise(P, h1, 'TEXT'), or no_premises(h1))",
"  3. orbit-kb add 'claim(...)' 'cites(...)' 'check(k1, c1)' 'checks_that(k1, ...)'   write facts; never edit kb.pl",
"  4. orbit-kb run k1 -- CMD       run each check; it must fail first for retire and introduce",
"  5. build the change, then orbit-kb run again",
"  6. orbit-kb lint                the fix for each finding is in its message",
"  7. orbit-kb show open           what is left; run it first when you resume a KB",
"  8. orbit-kb report              draft the delivery",
"  On the light path, when a signal fires: orbit-kb shift (orbit-kb help shift) does 1 to 3.",
"  Topics:",
"    orbit-kb help shift     the step from words to records: orbit-kb shift, one command, one screen",
"    orbit-kb help core      facts, claim labels, attestation types, and core queries",
"    orbit-kb help build     build-module facts and queries, burns, flares, proofs, waivers",
"    orbit-kb help discovery discovery-module facts, verdicts, queries, and the recipe for each move",
"    orbit-kb help project   project-module facts: decisions, definitions, rules, relations, pins, drafts, the date rule, and the writer lock",
"    orbit-kb help codes     each lint code and what to do",
"    orbit-kb help answers   exit codes, SWI ERROR, why and whynot",
"  Never type a digest or a test result: orbit-kb subject and orbit-kb run write them.",
"",
"Phases (each orbit has two phases; each move belongs to one phase):",
"  discovery: research, specify",
"  build: build, verify",
"  research  RESTATE, SURVEY, FLYBY, TRAJECTORY, DISPROVE (discovery)",
"  specify   SPECTRUM, DECOMPOSE, the vote (GATE)",
"  build     BUILD",
"  verify    FULFILL, DISPROVE, BURN",
"  What blocks done: orbit-kb show blocking. Pin the KB to its ticket: orbit-kb pin.",
"",
"Usage: orbit-kb [--dir DIR] COMMAND [ARGS]",
