kb_command(subject).
kb_command(attest).
kb_command(run).
kb_command(prove).
kb_command(lint).
kb_command(query).
kb_command(why).
kb_command(whynot).
kb_command(show).
kb_command(report).
kb_command(draft).
kb_command('pin-item').
kb_command('pin-question').
