#!/usr/bin/env bash
# s1watch: print each System 1 call of the live log as the System 1 model answered it.
#
#   s1watch [-n N] [--once] [--raw]
#
# Shows the last N calls (default 5), then follows the log. --once prints and stops.
# For each call: a header (local time, session name, routing, latency), the start of the message,
# then the model's answers as returned, pretty-printed by jq. It knows no question name or answer type,
# so a new question shows with no change here.
# A call that asked about the parts of the message (the fan-out: answer ids with "@") is shown as one
# block, on its second log line: the answers for the whole message, then one line for each part with
# its text cut short and only what stands out in it (a picked label, or a number of 0.7 or more).
# The call's own line then shows its header and message only. --raw prints every answer of every line.
# S1_LOG (default ~/.claude/logs/s1.jsonl). S1_SESSIONS (default ~/.claude/sessions) names sessions.
set -u
LOG=${S1_LOG:-$HOME/.claude/logs/s1.jsonl}
SESS=${S1_SESSIONS:-$HOME/.claude/sessions}
N=5; FOLLOW=1; RAW=false
while [ $# -gt 0 ]; do
  case $1 in
    -n) N=$2; shift 2 ;;
    --once) FOLLOW=0; shift ;;
    --raw) RAW=true; shift ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "s1watch: unknown argument $1" >&2; exit 2 ;;
  esac
done
command -v jq >/dev/null || { echo "s1watch: needs jq" >&2; exit 1; }
[ -t 1 ] && COLOR=-C || COLOR=-M

names() { cat "$SESS"/*.json 2>/dev/null | jq -s 'map(select(.sessionId) | {(.sessionId): (.name // "")}) | add // {}' 2>/dev/null || echo '{}'; }

FILTER='
def clean: tostring | gsub("\u001b\\[[0-9;?]*[ -/]*[@-~]"; "") | gsub("[[:cntrl:]]+"; " ");
def when: (try (.time[0:19] + "Z" | fromdateiso8601 | strflocaltime("%H:%M:%S")) catch (.time // "?"));
def who: ($names[.session_id // ""] // "" | select(. != "")) // ((.session_id // "?") | tostring | .[0:8]);
def whole: with_entries(select(.key | contains("@") | not));
def fan: ((.answers // {}) | keys | any(contains("@"))) and ($raw | not);
# What stands out in one answer of a part: a label it picked, or a number of 0.7 or more.
def mark: . as $a | ([$a | to_entries[] | select(.key != "type" and (.value | type) == "string") | .value] | first) as $s
  | ([$a | to_entries[] | select((.value | type) == "number" and .value >= 0.7) | .value] | first) as $n
  | if $s then "=\($s)" elif $n then " \($n * 100 | round / 100)" else null end;
def partlines: . as $r | ($r.part_text // []) | to_entries[] | .key as $k
  | "  [\($k + 1)] " + ([$r.answers | to_entries[] | select(.key | endswith("@\($k)")) | (.key | split("@")[0]) as $q | (.value | mark) as $m | select($m) | $q + $m] | join("  "))
    + "  “" + (.value | clean | .[0:60]) + "”";
fromjson? | select(type == "object") |
"── \(when)  \(who)  \(.routing // "-")" + (if .latency then (.latency * 10 | round) as $t | "  \($t / 10 | floor).\($t % 10)s" else "" end)
  + (if .stage then "  stage \(.stage)" else "" end),
(if .state then "> " + ((.state.message // "") | clean | .[0:160]) else empty end),
(if .answers and fan and (.combined == true) then (.answers | whole), partlines
 elif .answers and fan then "(\(.answers | keys | map(select(contains("@"))) | length) answers about the parts: shown with the next line; --raw prints them)"
 elif .answers then .answers
 elif .skipped then "skipped: \(.skipped | clean)"
 elif .error then "error: \(.error | clean)"
 else empty end),
(if .answers and .error then "error: \(.error | clean)" else empty end)'

show() { while IFS= read -r line; do
  jq -R -r $COLOR --argjson names "$(names)" --argjson raw "$RAW" "$FILTER" <<<"$line"
done; }

if [ "$FOLLOW" = 1 ]; then tail -n "$N" -F "$LOG" 2>/dev/null | show
else tail -n "$N" "$LOG" | show; fi
